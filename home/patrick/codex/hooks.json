{
  "description": "Shared lifecycle guardrails for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v bd >/dev/null 2>&1; then bd prime --hook-json; fi",
            "statusMessage": "Loading beads context",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.codex/hooks/compact-reorient.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.codex/hooks/compact-reorient.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.codex/hooks/git-stash-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
