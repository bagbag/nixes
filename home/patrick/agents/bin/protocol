#!/usr/bin/env python3
"""protocol: the protocol engine for deciding sessions.

Owns each session's protocol state in <state dir>/<session>.protocol/ and tells the model the next step, one call
per step. Protocols: `round`, the decide protocol's Round from Collect to Record
(skills/role/protocols/decide.md#round, skills/shared/asking.md), and `release`, its Release
(decide.md#release), in the same run slot. `next` lists the seed questions of the next round and the model's stored
proposal (`next --set`), and what waits on the user. What a session was told (skill text per check cycle, report formats, the open-item list, Durable owners)
is `state['told']`, cleared by `compacted` (README). The console mod reads `show --json` and `pending`; the state file stays internal. Contract: console-spec 1a plus the lead's contract rulings (version 1).

Approvals (answers, the check cap's "ask now") count only from the person: `answer` takes origin `dialog` (the
console relays the dialog result of the batch out), `chat` (the model maps an answer the user typed, accepted only
when its quote appears in a message the console relayed with `say`), or `model-reported` in a Codex session (no
console: the model records the user's quoted words). A release's approval is an engine-issued question answered the
same ways, or a /release-round the person typed or pressed (`pass --origin composer|bridge|press`). Board writes run through `board`
with the session's actor.
"""
from __future__ import annotations

import argparse
import contextlib
import contextvars
import copy
import fcntl
import itertools
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from collections.abc import Mapping
from datetime import datetime, timedelta, timezone
from pathlib import Path

VERSION = 1  # the show --json contract and the state file schema
BIN = Path(__file__).resolve().parent
REGISTRY = BIN / 'session-lead-mode'
BOARD = BIN / 'board'
CHECK_CAP = 5  # check cycles before the machine asks the user how to go on
BATCH = 4  # AskUserQuestion takes 1-4 questions
HEADER_MAX = 12  # AskUserQuestion's header chip
TITLE_MAX = 60  # question and round titles: one pane row
SUMMARY_MAX = 240  # the round summary: about two pane rows
TEXT_MAX = 160  # a question's text: the dialog question
DESCRIPTION_MAX = 150  # an option's model-written description (the engine's "Unverified: …" prefix is not counted)
OVERLAP_LIMIT = 5  # related hits per new draft
SEEDS = 5  # `protocol next` lists this many seed questions
PROPOSAL_ROUNDS = 3  # rounds in a stored proposal
PRUNE_DAYS = 30  # a session's protocol folder without an open round goes after this much inactivity
CLASSES = ('ruled', 'planning', 'own', 'user')  # decide.md Collect
KINDS = ('decision', 'confirm-own-rulings')
OUTCOMES = ('duplicate', 'extend', 'relate', 'supersedes', 'unrelated')
REVISES, REVISES_RULE = 'tracks', 'board.revises_rule'  # bin/board: the pending-revision link and its partial rule (the validator compares them)
PASSES = ('step-back', 'ground', 'challenge-rulings')
# Origins (contract rulings R-B2, R-B9-R-B11): the console stamps them; the model's tool stamps chat on answer and
# model on every other verb.
PASS_ORIGINS = ('composer', 'bridge', 'press', 'plugin', 'model')
VERB_ORIGINS = {
    'answer': ('dialog', 'chat', 'model-reported'),  # model-reported: Codex sessions only
    'decline': ('dialog', 'model-reported'),
    'pass': PASS_ORIGINS,
    'say': ('composer', 'bridge'),  # the person's own messages, stored for the chat quote check
}
COLLECT_VIEWS = 'decided,questions,ratification,review,user'
LIST_COMMAND = f'board health --items {COLLECT_VIEWS}'  # lists the open items Collect offers, but for the ready milestones and finished epics `board position` lists
# Skill text of step-back and ground passes: 'cycle' gives the full text on the first pass of each kind in a check cycle and a
# reminder (the skill's stance and the named lenses, read from the installed SKILL.md) on the others; 'pass' gives every pass the
# full text. The one value to change to go back (r17-q62).
SKILL_TEXT = 'cycle'
BASE_LENSES = ('consumer', 'root-fix', 'bloat', 'gaps')  # step-back's lenses when its argument names none (skills/step-back: "Default")
# Question fields a pass can change; a change to any of them counts (asking.md Check: premise, ruling, option or
# question set).
CONTENT = ('text', 'title', 'header', 'options', 'multiSelect', 'kind', 'board', 'waitsOn', 'for', 'settles', 'premises',
           'recommendation', 'strength', 'leanBecause', 'strongBecause')
# How a question is shown and backed, not what it asks (asking.md Check counts premise, ruling, option and question
# set): an edit to these alone re-issues the batch without rerunning the check loop.
PRESENTATION = ('title', 'header', 'strength', 'leanBecause', 'strongBecause')  # plus an option's `preview` (see substantive)
CAP_CHOICES = ('Continue', 'Ask now', 'Pause')
STRENGTHS = ('lean', 'strong')
LEAN_CAUSES = ('preference', 'evidence')  # the user's values decide, or an unchecked fact (the lean pass)
# Lens names: skills/step-back/SKILL.md and skills/ground/SKILL.md own them (the console's hooks/words.ts repeats them);
# the validator keeps the three in step. Base (no lens named) covers consumer, root-fix, bloat and gaps.
ALL_LENSES = {  # the owners' lists (the validator compares them); the check sequence runs the path and refine subsets
    'step-back': ('goal', 'decisions', 'foundations', 'consumer', 'root-fix', 'bloat', 'gaps', 'clean', 'overfit', 'mechanics'),
    'ground': ('assumptions', 'board', 'sources', 'probe'),
}
# The check sequence per round (user, r5 q26, r6 q28): the path pass (is the goal and what it builds on right?) before the
# Base loop, the refine pair after it; Base's own lenses (consumer, root-fix, bloat, gaps) are named in neither.
PATH_LENSES = ('goal', 'foundations')
REFINE_LENSES = {'step-back': ('decisions', 'clean', 'overfit', 'mechanics'), 'ground': ('assumptions', 'board', 'sources', 'probe')}
LEAN_LENSES = ('assumptions', 'sources', 'probe')  # the targeted lean pass: every way a lean gets decided (r6 q29)
# skills/shared/decision-protocol.md#recommendation-strength owns these rules; the validator keeps the names in step.
# A strong recommendation is a claim: each criterion "true: <evidence>", or "does-not-apply: <reason>" where allowed.
STRONG_CRITERIA = {
    'noAssumptions': 'every premise checked in current source, a run or an item (name where)',
    'alternativesFail': 'each other realistic option, listed or not, fails a named criterion (cleanliness test, goal, correctness, consumer need); name the strongest unlisted one and why it fails or was added',
    'notPreference': 'the choice does not depend on what the user values',
    'consumerWalk': 'a realistic consumer walk supports it (does-not-apply for internal choices)',
    'rulingsHold': 'released rulings hold, or each revision is raised as its own question',
}
MAY_NOT_APPLY = ('consumerWalk', 'rulingsHold')


def recommended_suffix(q: dict) -> str:
    """The mark on the recommended option's label in the dialog: ` (recommended, lean)`. A release approval has none: the
    engine asks it on every release, so a mark would say nothing about this one (r15 q58)."""
    return f" (recommended, {q['strength']})" if q.get('strength') else ''


class ProtocolError(Exception):
    """A refusal. `formats` is the report format a refused report repeats: printed after the message, not logged."""

    def __init__(self, *args, formats: str = ''):
        super().__init__(*args)
        self.formats = formats


def utcnow() -> str:
    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


class Call:
    """One `run_cli` invocation: everything the engine reads from its process, so calls with different environments
    can share one interpreter. `state_root` is cached per call (the registry derives it from the environment)."""

    def __init__(self, env: Mapping[str, str], cwd: Path, stdin):
        self.env, self.cwd, self.stdin = dict(env), cwd, stdin
        self.stdout: list[str] = []
        self.stderr: list[str] = []
        self.state_root: Path | None = None


_call: contextvars.ContextVar[Call] = contextvars.ContextVar('protocol_call')


def env() -> dict[str, str]:
    return _call.get().env


def state_root() -> Path:
    """The registry's state dir; session-lead-mode owns its location."""
    call = _call.get()
    if call.state_root is None:
        call.state_root = Path(registry('state-dir').strip())
    return call.state_root


# Session and registry: session-lead-mode owns the resolution.

def registry(*args: str) -> str:
    call = _call.get()
    result = subprocess.run(['bash', str(REGISTRY), *args], capture_output=True, text=True, env=call.env, cwd=call.cwd)
    if result.returncode != 0:
        raise ProtocolError((result.stderr or result.stdout).strip() or f'session-lead-mode {args[0]} failed')
    return result.stdout


def resolve_session(flag: str | None) -> tuple[str, dict]:
    """(session id, registry entry): --session, else CODEX_THREAD_ID, else the registered session whose actor
    session-lead-mode derives from the environment."""
    if flag or env().get('CODEX_THREAD_ID'):
        session = flag or env()['CODEX_THREAD_ID']
        entry = json.loads(registry('show', session))
        if not flag and not entry.get('tool'):
            entry['tool'] = 'codex'  # an unregistered Codex thread is still Codex
        return session, entry
    try:
        actor = registry('actor').strip()
    except ProtocolError as error:
        raise ProtocolError(f'no session: pass --session <id> ({error})') from None
    entry = next((json.loads(row) for row in registry('list').splitlines()
                  if row.strip() and json.loads(row).get('actor') == actor.split('/', 1)[0]), None)
    if entry is None:
        raise ProtocolError(f'no registered session for actor {actor}: pass --session <id> or register a role (/role)')
    return entry['session'], entry


# Board access through the board CLI (sibling board; PROTOCOL_BOARD overrides for tests).

def board_root(start: Path) -> Path | None:
    return next((d for d in (start, *start.parents) if (d / '.beads').is_dir()), None)


class Board:
    def __init__(self, repo: str | None, actor: str):
        self.repo, self.actor = repo, actor

    def run(self, *args: str, stdin: str | None = None) -> subprocess.CompletedProcess:
        command = [env()['PROTOCOL_BOARD']] if env().get('PROTOCOL_BOARD') else [sys.executable, str(BOARD)]
        return subprocess.run([*command, *args], input=stdin, capture_output=True, text=True, cwd=self.repo,
                              env={**env(), 'BEADS_ACTOR': self.actor})

    def checked(self, *args: str, stdin: str | None = None) -> str:
        result = self.run(*args, stdin=stdin)
        if result.returncode != 0:
            raise ProtocolError(f"`board {' '.join(args)}` failed: {(result.stderr or result.stdout).strip()}")
        return result.stdout

    def json(self, *args: str, stdin: str | None = None):
        output = self.checked(*args, stdin=stdin)
        try:
            return json.loads(output)
        except ValueError:
            raise ProtocolError(f"`board {' '.join(args)}` printed no JSON: {output[:200]}") from None


def related_hits(board: Board, text: str) -> list[tuple[str, str]]:
    """(id, title) of the board items a new draft's text resembles, rarest shared words first."""
    found = board.json('related', '--like', '-', '--json', '--limit', str(OVERLAP_LIMIT), stdin=text)
    return [(item['id'], item.get('title') or '') for item in found.get('items') or []]


COUNT_KEYS = ('questions', 'decided', 'toPlan', 'inReview', 'forUser')


def held_decided(board: Board, found: dict | None = None) -> list[str]:
    """The decided records this session holds, a worker's holds included (r13 q50): `board health --items decided`
    rows carry their `holder`."""
    found = found if found is not None else board.json('health', '--json', '--items', 'decided')
    me = board.actor.split('/', 1)[0]
    return [row['id'] for row in (found.get('items') or {}).get('decided') or []
            if row.get('holder') and str(row['holder']).split('/', 1)[0] == me]


# State: one JSON file per session, written atomically under a lock; history appends to its own file.

class Store:
    def __init__(self, session: str):
        if not re.fullmatch(r'[A-Za-z0-9._-]{8,}', session):
            raise ProtocolError(f"invalid session id '{session}'")
        self.dir = state_root() / f'{session}.protocol'
        self.session = session
        self.pending: list[dict] = []

    @contextlib.contextmanager
    def locked(self, write: bool):
        if write:
            self.dir.mkdir(parents=True, exist_ok=True, mode=0o700)
        elif not self.dir.is_dir():
            yield
            return
        with open(self.dir / '.lock', 'a+') as handle:
            fcntl.flock(handle, fcntl.LOCK_EX if write else fcntl.LOCK_SH)
            yield

    def load(self) -> dict:
        try:
            state = json.loads((self.dir / 'state.json').read_text(encoding='utf-8'))
        except FileNotFoundError:
            return {'version': VERSION, 'session': self.session, 'seq': {}, 'round': None, 'carried': [],
                    'answers': {}, 'counts': None}
        except ValueError as error:
            raise ProtocolError(f'unreadable protocol state {self.dir / "state.json"}: {error}') from None
        if state.get('version') != VERSION:
            raise ProtocolError(f"protocol state version {state.get('version')} is not {VERSION}: {self.dir}")
        return state

    def save(self, state: dict) -> None:
        handle, temporary = tempfile.mkstemp(dir=self.dir, prefix='.state.')
        with os.fdopen(handle, 'w', encoding='utf-8') as out:
            json.dump(state, out, indent=1, ensure_ascii=False)
            out.flush()
            os.fsync(out.fileno())
        os.replace(temporary, self.dir / 'state.json')

    def log(self, event: dict) -> None:
        """Queues a history event; `flush` writes the queue once the state it describes is saved, so a failed call
        leaves no event behind (refusals are written directly)."""
        self.pending.append({'at': utcnow(), 'session': self.session, **event})

    def flush(self) -> None:
        if self.pending:
            with open(self.dir / 'history.jsonl', 'a', encoding='utf-8') as out:
                out.writelines(json.dumps(event, ensure_ascii=False) + '\n' for event in self.pending)
            self.pending = []


def next_id(state: dict, kind: str, prefix: str) -> str:
    state['seq'][kind] = state['seq'].get(kind, 0) + 1
    return f'{prefix}{state["seq"][kind]}'


# Engine: a protocol is a definition of steps; each step has an entry hook (side effects, may redirect), a
# validator taking the model's report, and the instructions for the model.

class Step:
    def __init__(self, name: str, text, accept=None, enter=None):
        self.name, self.text, self.accept, self.enter = name, text, accept, enter


class Protocol:
    def __init__(self, name: str, steps: list[Step], after_ask: str):
        """`after_ask`: the step Ask hands over to once no question waits (the ask machinery is shared)."""
        self.name, self.steps, self.after_ask = name, {step.name: step for step in steps}, after_ask


class Context:
    def __init__(self, store: Store, state: dict, entry: dict, board: Board | None):
        self.store, self.state, self.entry, self.board = store, state, entry, board
        self.codex = entry.get('tool') == 'codex'
        self.complete = False  # a read the model asked for (`show`): says everything, records nothing as told
        self.formats: dict[str, str] = {}  # report formats the step text offered, by kind (a refused report reprints them)
        self.messages: list[str] = []  # said once, ahead of the step's instructions
        self.applied, self.added, self.rejected = [], [], []  # this call's updates: changed ids, new ids, reasons

    @property
    def round(self) -> dict:
        return self.state['round']

    def go(self, name: str) -> None:
        """Enters a step, following redirects of entry hooks."""
        for _ in range(20):
            self.round['step'] = name
            step = PROTOCOLS[self.round['protocol']].steps[name]
            redirect = step.enter(self) if step.enter else None
            if not redirect or redirect == name:
                return
            name = redirect
        raise ProtocolError(f'step loop at {name}')

    def set_pending(self, command: str | None, args: str = '') -> None:
        self.round['pending'] = {'id': next_id(self.state, 'pending', 'p'), 'command': command, 'args': args} \
            if command else None

    def log(self, event: str, **data) -> None:
        self.store.log({'round': self.round['id'] if self.round else None, 'event': event, **data})


def fail(message: str):
    raise ProtocolError(message)


def questions(ctx: Context, *statuses: str) -> list[dict]:
    return [q for q in ctx.round['questions'] if not statuses or q['status'] in statuses]


def by_id(ctx: Context, qid: str) -> dict:
    found = next((q for q in ctx.round['questions'] if q['id'] == qid), None)
    return found or fail(f'unknown question {qid}')


def answered(ctx: Context, qid: str) -> bool:
    return qid in ctx.state['answers']


def premise_status(ctx: Context, q: dict) -> str:
    return 'held' if any(not answered(ctx, other) for other in q.get('waitsOn') or []) else 'draft'


# Validation of question content (AskUserQuestion's limits).

def question_errors(q: dict, where: str, marks: bool = True) -> list[str]:
    """Every break of AskUserQuestion's limits and, with `marks`, of the recommendation, its strength and its backing
    (a complete question: Stage, a new question, asking; an update checks the marks only when it touches them)."""
    errors = []
    for field in ('text', 'title', 'header'):
        if not isinstance(q.get(field), str) or not q[field].strip():
            errors.append(f'{where}: `{field}` must be a non-empty string')
    for field, limit in (('text', TEXT_MAX), ('title', TITLE_MAX), ('header', HEADER_MAX)):
        if isinstance(q.get(field), str) and len(q[field]) > limit:
            errors.append(f'{where}: {field} {q[field]!r} is longer than {limit} characters')
    if isinstance(q.get('text'), str) and re.match(r'\s*\d+[.)]\s', q['text']):
        errors.append(f'{where}: `text` carries no number (the engine numbers the dialog)')
    options = q.get('options')
    valid = isinstance(options, list) and 2 <= len(options) <= 4 \
        and all(isinstance(o, dict) and isinstance(o.get('label'), str) and o['label'].strip()
                and isinstance(o.get('description', ''), str) and isinstance(o.get('preview', ''), str) for o in options)
    if not valid:
        errors.append(f'{where}: `options` must be 2-4 objects with a label, a description and optionally a preview (text)')
    else:
        if len({o['label'] for o in options}) != len(options):
            errors.append(f'{where}: option labels must be unique')
        errors += [f'{where}: the description of option {o["label"]!r} is longer than {DESCRIPTION_MAX} characters'
                   for o in options if len(o.get('description', '')) > DESCRIPTION_MAX]
        if q.get('multiSelect') is True and any('preview' in o for o in options):
            errors.append(f'{where}: `preview` is for single-select questions: remove it or make the question single-select')
    if not isinstance(q.get('multiSelect', False), bool):
        errors.append(f'{where}: `multiSelect` must be a boolean')
    if q.get('kind', 'decision') not in KINDS:
        errors.append(f"{where}: `kind` must be one of {', '.join(KINDS)}")
    if not isinstance(q.get('waitsOn', []), list) or not all(isinstance(i, str) for i in q.get('waitsOn', [])):
        errors.append(f'{where}: `waitsOn` must be a list of question ids')
    if q.get('board') is not None and not isinstance(q['board'], str):
        errors.append(f'{where}: `board` must be a board id or null')
    if not isinstance(q.get('settles') or [], list) or not all(isinstance(i, str) and i for i in q.get('settles') or []):
        errors.append(f'{where}: `settles` must be a list of selected keys (board ids or pasted point ids)')
    if not marks:
        return errors
    labels = {o['label'] for o in options} if valid else set()
    if (valid and q.get('recommendation') not in labels) or q.get('strength') not in STRENGTHS:
        errors.append(f"{where}: `recommendation` names one option's label and `strength` is lean or strong (the dialog marks both)")
    if q.get('strength') == 'strong':
        claims = q.get('strongBecause') if isinstance(q.get('strongBecause'), dict) else {}
        for name, meaning in STRONG_CRITERIA.items():
            value = claims.get(name)
            allowed = ('true', 'does-not-apply') if name in MAY_NOT_APPLY else ('true',)
            if not (isinstance(value, str) and re.match(rf"({'|'.join(allowed)}): \S", value)):
                errors.append(f"{where}: strong is a claim: `strongBecause.{name}` is \"{' or '.join(f'{a}: …' for a in allowed)}\" "
                              f"({meaning}); if it does not hold, the recommendation is a lean")
    because = q.get('leanBecause')
    if q.get('strength') == 'lean' and not (isinstance(because, dict) and because.get('cause') in LEAN_CAUSES
                                            and isinstance(because.get('detail'), str) and because['detail'].strip()):
        errors.append(f'{where}: a lean names its cause: `leanBecause` {{"cause": "preference" (what the choice depends on) or '
                      '"evidence" (the unchecked fact and how to check it), "detail": "…"}')
    return errors


def refuse_all(errors: list[str]) -> None:
    """One refusal listing every error, so a report is fixed once."""
    if errors:
        fail('; '.join(errors))


def check_question(q: dict, where: str, marks: bool = True) -> None:
    refuse_all(question_errors(q, where, marks))


def new_question(ctx: Context, raw: dict, where: str) -> dict:
    unknown = set(raw) - set(CONTENT) - {'key'}
    errors = [f"{where}: unknown fields {', '.join(sorted(unknown))}"] if unknown else []
    q = {'id': next_id(ctx.state, 'question', 'q'), 'board': None, 'kind': 'decision', 'multiSelect': False,
         'waitsOn': [], 'for': None, 'settles': [], 'premises': None, 'recommendation': None, 'strength': None,
         'leanBecause': None, 'strongBecause': None,
         **{k: v for k, v in raw.items() if k != 'key'},
         'status': 'draft', 'overlaps': [], 'searched': False, 'answer': None, 'round': ctx.round['id']}
    refuse_all(errors + question_errors(q, where))
    q['options'] = [{'label': o['label'], 'description': o.get('description', ''), **({'preview': o['preview']} if 'preview' in o else {})}
                    for o in q['options']]
    return q


def unique_texts(ctx: Context) -> None:
    texts = [q['text'].strip() for q in ctx.round['questions']] + [q['text'].strip() for q in ctx.state['carried']]
    dupes = sorted({t for t in texts if texts.count(t) > 1})
    if dupes:
        fail(f'question texts must be unique (answers are keyed by text): {dupes[0]!r}')


def resolve_waits(ctx: Context, keys: dict[str, str]) -> None:
    known = {q['id'] for q in ctx.round['questions']} | {q['id'] for q in ctx.state['carried']} | set(ctx.state['answers'])
    for q in ctx.round['questions']:
        q['waitsOn'] = [keys.get(ref, ref) for ref in q.get('waitsOn') or []]
        missing = [ref for ref in q['waitsOn'] if ref not in known]
        if missing or q['id'] in q['waitsOn']:
            fail(f"{q['id']}: waitsOn names unknown or own ids: {', '.join(missing) or q['id']}")


POINT = re.compile(r'pt\d+')  # a pasted point's key (next_id 'point'); every other selected key is a board item or a held question


def board_keys(keys) -> list[str]:
    return [key for key in keys or [] if not POINT.fullmatch(key)]


def coverage_errors(ctx: Context) -> list[str]:
    """The rule-question invariants of the round's question set: `settles` names selected keys other than the
    question's own `board`/`for`, no key twice, none on confirm-own-rulings; and every selected key is covered by a
    question's `board`, `for`, id or `settles`. Empty outside Stage and Check (nothing selected)."""
    r = ctx.round
    selected, errors = set(r['selected']), []
    if not selected:
        return errors
    own = {}
    for q in r['questions']:
        for key in (q['board'], q['for']):
            if key:
                own.setdefault(key, q['id'])
    settled = {}
    for q in r['questions']:
        keys = q.get('settles') or []
        if keys and q['kind'] == 'confirm-own-rulings':
            errors.append(f"{q['id']}: `settles` is not for confirm-own-rulings questions")
        for key in dict.fromkeys(keys):
            if key not in selected:
                errors.append(f"{q['id']}: settles {key}, which is not selected")
            elif key in (q['board'], q['for']):
                errors.append(f"{q['id']}: {key} is its own `board`/`for`, not settled by it")
            elif key in own:
                errors.append(f"{q['id']}: settles {key}, which is the `board`/`for` of {own[key]}: remove {own[key]} or drop {key} from `settles`")
            elif settled.setdefault(key, q['id']) != q['id']:
                errors.append(f"{q['id']}: settles {key}, which {settled[key]} settles already")
        if len(set(keys)) != len(keys):
            errors.append(f"{q['id']}: `settles` lists a key twice")
    covered = set(own) | set(settled) | {q['id'] for q in r['questions']}
    missing = [key for key in r['selected'] if key not in covered]
    if missing:
        errors.append(f"no question covers {', '.join(missing)} (board items in `board`, pasted points in `for`, or in a rule "
                      "question's `settles`)")
    return errors


MARK_FIELDS = ('recommendation', 'strength', 'leanBecause', 'strongBecause', 'options')


def apply_updates(ctx: Context, updates) -> int:
    """Applies a pass's per-question updates, each on its own: a valid one applies, an invalid one is set aside with
    its reason (`ctx.rejected`) for the pass to resend. Returns the number of questions added, removed or changed in
    substance (PRESENTATION edits apply but do not count); `ctx.applied` lists the question of each update that applied."""
    if not isinstance(updates, list):
        fail('`updates` must be a list')
    changes, keys = 0, {}
    for index, update in enumerate(updates):
        try:
            changed, qid = apply_update(ctx, update, f'updates[{index}]', keys)
        except ProtocolError as error:
            ctx.rejected.append(str(error))
            continue
        if qid:
            (ctx.applied if 'id' in update else ctx.added).append(qid)
        changes += changed
    resolve_waits(ctx, keys)
    unique_texts(ctx)
    refuse_all(coverage_errors(ctx))  # a merge or split is several updates: the set is checked once, after all of them
    for q in questions(ctx, 'draft', 'held', 'ready'):
        q['status'] = premise_status(ctx, q)
    return changes


def apply_update(ctx: Context, update, where: str, keys: dict) -> tuple[int, str]:
    """One update; returns (1 for a substantive change, else 0; the question's id)."""
    if not isinstance(update, dict):
        fail(f'{where}: must be an object')
    if 'id' not in update:
        q = new_question(ctx, update, where)
        ctx.round['questions'].append(q)
        keys[update.get('key') or q['id']] = q['id']
        q['status'] = 'draft'
        return 1, q['id']
    q = by_id(ctx, update['id'])
    if q['status'] in ('asked', 'answered'):
        fail(f"{where}: {q['id']} is {q['status']}; restart it first (protocol restart {q['id']})")
    if update.get('remove'):
        ctx.round['questions'].remove(q)
        ctx.log('removed', question=q['id'], reason=update.get('reason'))
        return 1, q['id']
    unknown = set(update) - set(CONTENT) - {'id', 'reason'}
    if unknown:
        fail(f"{where}: unknown fields {', '.join(sorted(unknown))}")
    merged = {**q, **{k: v for k, v in update.items() if k in CONTENT}}
    check_question(merged, f"{where} ({q['id']})", marks=any(k in update for k in MARK_FIELDS))
    if not any(merged.get(k) != q.get(k) for k in CONTENT):
        return 0, None
    if merged['board'] is None and (merged['text'] != q['text'] or merged['title'] != q['title']):
        merged['searched'] = False  # search again; known outcomes stay
    plain = lambda options: [{'label': o['label'], 'description': o.get('description', '')} for o in options]  # previews are presentation
    substantive = any((plain(merged[k]) != plain(q[k]) if k == 'options' else merged.get(k) != q.get(k))
                      for k in CONTENT if k not in PRESENTATION)
    q.update(merged)
    return int(substantive), q['id']


# Steps of `round`.

def json_block(value) -> str:
    return json.dumps(value, ensure_ascii=False)


# What a session was told, in one place: `state['told']`, a list of keys, cleared by `protocol compacted` (r17-q62, q63, q67,
# r18-q68..q70). Keys: `format:<step>` (a step's report format), `ask`, `owners`, `items`, and per check cycle
# `cycle:<what>:<round>:<check run>.<cycle>` (the skill text of a pass kind, the question list).

def first_time(ctx: Context, key: str) -> bool:
    """True when this session was not told `key` since its last compaction, and records it. A read the model asked for says
    everything again and records nothing."""
    if ctx.complete:
        return True
    told = ctx.state.setdefault('told', [])
    if key in told:
        return False
    told.append(key)
    return True


def cycle_key(ctx: Context, what: str) -> str:
    r = ctx.round
    return f"cycle:{what}:{r['id']}:{r.get('checkRun', 0)}.{r['check'].get('cycle', 0)}"


def forget_cycles(ctx: Context) -> None:
    """A new run starts: the old runs' cycles go from the record."""
    ctx.state['told'] = [key for key in ctx.state.get('told') or [] if not key.startswith('cycle:')]


def report_format(ctx: Context, kind: str, text: str) -> str:
    """A step's report format: sent the first time per kind since a compaction, empty after. A refused report reprints
    `ctx.formats`, which keeps every format the step text offered."""
    ctx.formats[kind] = text
    return text if first_time(ctx, f'format:{kind}') else ''


def report_hint(ctx: Context, kind: str, example) -> str:
    return report_format(ctx, kind, f'Report with `protocol step` (stdin JSON), e.g. {json_block(example)}')


def lines(*parts: str) -> str:
    """The step text: its parts, those left empty out."""
    return '\n'.join(part for part in parts if part)


VIEW_LABELS = {  # the views Collect offers, in listing order (`collect_enter`): heading, name in the counts
    'decided': ('decided, awaiting release', 'decided'), 'questions': ('open questions', 'open questions'),
    'ratification': ('awaiting ratification', 'awaiting ratification'), 'inReview': ('in review', 'in review'),
    'forUser': ('waiting on the user', 'waiting on the user'), 'readyMilestone': ('ready milestones', 'ready milestones'),
    'finishedEpic': ('finished epics (close one whose acceptance names the user)', 'finished epics'),
}


def item_row(item: dict) -> str:
    return (f"- {item['id']}" + (f" [{item['type']}]" if item.get('type') not in (None, 'decision') else '')
            + (f", held by {item['heldBy']}" if item.get('heldBy') else '') + f": {item['title']}")


def items_text(ctx: Context, items: list[dict], elsewhere: dict[str, list[str]], waiting: list[dict],
               named: list[str] | None = None, bare: bool = False) -> str:
    """The open-item list: whole the first time between compactions, whichever of `protocol next` and a round's Collect
    comes first, its rows grouped under a heading per view and status (r18-q68, q69). Later the named ids, the counts per
    kind and the command that lists them again; a bare round lists before it selects."""
    if not items and not elsewhere and not waiting:
        return ''
    if first_time(ctx, 'items'):
        groups: dict[tuple[str, str], list[dict]] = {}
        for item in items:
            groups.setdefault((item['view'], str(item['status'])), []).append(item)
        out = [f'Open items ({len(items) + len(waiting)}):'] + ([f"Named for this round: {', '.join(named)}."] if named else [])
        for view, (heading, _) in VIEW_LABELS.items():
            for (group_view, status), rows in groups.items():
                if group_view == view:
                    out += [f'{heading} · {status} ({len(rows)}):', *map(item_row, rows)]
        if waiting:
            out += [f'waiting on the user · held by the user, not offered ({len(waiting)}):', *map(item_row, waiting)]
        out += [f"Held by live session {holder}, not offered: {', '.join(ids)}" for holder, ids in elsewhere.items()]
        return '\n'.join(out)
    by_id = {item['id']: item for item in items}
    tally = {view: sum(1 for item in [*items, *waiting] if item['view'] == view) for view in VIEW_LABELS}
    counts = ', '.join(f'{n} {VIEW_LABELS[view][1]}' for view, n in tally.items() if n)
    return lines(
        *(['Named:', *(item_row(by_id[rid]) for rid in named or [] if rid in by_id)] if named else []),
        f'Open items: {counts or "none"} (listed earlier). List them again with `{LIST_COMMAND}`, '
        'and `board position` for the ready milestones and finished epics.' + (' List them before you select.' if bare else ''))


def collect_text(ctx: Context) -> str:
    r = ctx.round
    named = r.get('named') or []
    points = [f"- {point['id']} [pasted]: {point['text']}" for point in r['points']]
    missing = [p['id'] for p in r['points'] if p['id'] not in r['classes']]
    listing = items_text(ctx, r['items'], r.get('heldElsewhere') or {}, r.get('waiting') or [], named, bare=not named)
    return lines(
        f"Round {r['id']} · Collect (decide.md Round 1): classify every pasted point and the board items in this "
        "round's scope (asking.md Scope): ruled (cite its owner), planning (the planning session's call), own (your "
        "ruling), user (the user's decision); unclassified board items stay out of this round. Check pasted points "
        "against the current tree.",
        listing or ('- (no open items' + ('' if ctx.board else ': no board here') + '; add pasted points)' if not points else ''),
        *points,
        f"Unclassified pasted points: {', '.join(missing) or 'none'}.",
        report_hint(ctx, 'collect', {'classes': {'<id>': {'class': 'ruled', 'owner': 'docs/x.md#rule'}, '<id2>': 'user'},
                                     'points': [{'text': '<another point>', 'class': 'user'}]}),
    )


def collect_accept(ctx: Context, report: dict) -> str:
    r = ctx.round
    for raw in report.get('points') or []:
        point = {'text': raw} if isinstance(raw, str) else raw
        if not isinstance(point, dict) or not str(point.get('text') or '').strip():
            fail('points: each needs a text')
        pid = next_id(ctx.state, 'point', 'pt')
        r['points'].append({'id': pid, 'text': point['text']})
        if point.get('class'):
            r['classes'][pid] = {'class': point['class'], 'owner': point.get('owner')}
    classes = report.get('classes') or {}
    if not isinstance(classes, dict):
        fail('`classes` must map ids to a class')
    keys = {i['id'] for i in r['items']} | {p['id'] for p in r['points']}
    for key, value in classes.items():
        if key not in keys:
            fail(f'classes: unknown id {key}')
        value = {'class': value} if isinstance(value, str) else value
        if not isinstance(value, dict) or value.get('class') not in CLASSES:
            fail(f"classes.{key}: class must be one of {', '.join(CLASSES)}")
        if value['class'] == 'ruled' and not str(value.get('owner') or '').strip():
            fail(f'classes.{key}: an already ruled point cites its owner')
        r['classes'][key] = {'class': value['class'], 'owner': value.get('owner')}
    missing = sorted({p['id'] for p in r['points']} - set(r['classes']))
    if missing:
        fail(f"every pasted point needs a class; unclassified: {', '.join(missing)}")
    tally = {}
    for value in r['classes'].values():
        tally[value['class']] = tally.get(value['class'], 0) + 1
    ctx.log('classified', classes=tally)
    return 'select'


def priority_of(c: dict) -> int:
    return c['priority'] if c.get('priority') is not None else 9


def dependency_order(pool: list[dict], rank) -> list[dict]:
    """Prerequisites (`blockedBy` keys inside the pool) before their dependents, otherwise by `rank`, a sort key per
    entry: the one ordering Select's candidates and `protocol next`'s seeds share."""
    keys = {c['key'] for c in pool}
    ordered, seen = [], set()

    def visit(c, path=()):
        if c['key'] in seen or c['key'] in path:
            return
        for blocker in c.get('blockedBy') or []:
            if blocker in keys:
                visit(next(x for x in pool if x['key'] == blocker), (*path, c['key']))
        seen.add(c['key'])
        ordered.append(c)

    for c in sorted(pool, key=rank):
        visit(c)
    return ordered


def candidates(ctx: Context) -> list[dict]:
    """Points for the user (and own rulings to confirm), then held decisions whose premises are answered; prerequisites
    before their dependents, then by priority."""
    r = ctx.round
    def scoped(key: str) -> bool:  # unclassified board items stay out of this round
        return r['classes'].get(key, {}).get('class') in ('user', 'own')

    settled = {key for q in ctx.state['carried'] for key in q.get('settles') or []}  # a held rule question brings its own
    pool = [{**item, 'key': item['id'], 'source': 'board'} for item in r['items'] if scoped(item['id']) and item['id'] not in settled]
    pool += [{'key': p['id'], 'id': p['id'], 'title': p['text'], 'priority': 9, 'blockedBy': [], 'source': 'pasted'}
             for p in r['points'] if scoped(p['id'])]
    pool += [{'key': q['id'], 'id': q['id'], 'title': q['title'], 'priority': 9, 'blockedBy': [], 'source': 'held'}
             for q in ctx.state['carried'] if premise_status(ctx, q) == 'draft']
    return dependency_order(pool, lambda c: (priority_of(c), c['key']))


def select_text(ctx: Context) -> str:
    rows = [f"- {c['key']} p{c.get('priority', '?')} ({ctx.round['classes'].get(c['key'], {}).get('class', 'held')})"
            + (f" waits on {', '.join(c['blockedBy'])}" if c.get('blockedBy') else '') + f": {c['title']}"
            for c in candidates(ctx)]
    return lines(
        f"Round {ctx.round['id']} · Select one round (asking.md Scope): the highest-priority unblocked question and "
        'every ready one sharing its premise, root cause, consumer concept, flow, or the module and sources its grounding reads. '
        'Candidates in order:',
        *(rows or ['- none: report {"select": []} to close the round']),
        'The engine claims the selected board items.',
        report_hint(ctx, 'select', {'select': [c['key'] for c in candidates(ctx)[:2]] or ['<id>']}),
    )


def claim_items(ctx: Context, items: list[str]) -> None:
    """Claims items for the round. A hold the session had before (a decided record awaiting release, `board claim`'s
    "already held" line) stays the session's: the round releases only what it claimed itself."""
    output = ctx.board.checked('claim', *items)
    before = {line.split(':', 1)[0] for line in output.splitlines() if ': already held by ' in line}
    ctx.round['claimed'] = [*ctx.round.get('claimed', []), *(item for item in items if item not in before)]


def select_accept(ctx: Context, report: dict) -> str:
    chosen = report.get('select')
    if not isinstance(chosen, list) or not all(isinstance(i, str) for i in chosen):
        fail('`select` must be a list of candidate ids')
    pool = {c['key']: c for c in candidates(ctx)}
    unknown = [key for key in chosen if key not in pool]
    if unknown:
        fail(f"not a candidate: {', '.join(unknown)}")
    for key in chosen:
        waiting = [b for b in pool[key].get('blockedBy') or [] if b in pool and b not in chosen]
        if waiting:
            fail(f"{key} waits on {', '.join(waiting)}: select its prerequisite too (stage {key} waiting on it) or leave {key}")
    if not chosen:
        return 'closed'
    claims = [key for key in chosen if pool[key]['source'] == 'board']
    taken = [key for key in claims if pool[key].get('heldBy')]  # a gone session's hold: take it over, as the release does
    if taken and ctx.board:
        ctx.board.checked('take', *taken)
        ctx.round['claimed'] = [*ctx.round.get('claimed', []), *taken]
    if claims and ctx.board and [key for key in claims if key not in taken]:
        claim_items(ctx, [key for key in claims if key not in taken])
    ctx.log('selected', selected=chosen, claimed=claims if ctx.board else [])
    selected = list(chosen)
    for key in chosen:
        if pool[key]['source'] == 'held':
            q = next(q for q in ctx.state['carried'] if q['id'] == key)
            ctx.state['carried'].remove(q)
            ctx.round['questions'].append({**q, 'status': 'draft', 'round': ctx.round['id']})
            if q.get('board') and ctx.board:
                claim_items(ctx, [q['board']])
            settles = [one for one in q.get('settles') or [] if one not in selected]
            if settles and board_keys(settles) and ctx.board:
                claim_items(ctx, board_keys(settles))
            selected += settles  # the held rule question still settles them: they are selected with it
    ctx.round['selected'] = selected
    return 'stage'


def stage_text(ctx: Context) -> str:
    r = ctx.round
    staged = [f"- {q['id']} {q['status']}: {q['text']}" for q in r['questions']]
    dropped = {key: (ctx.state.get('dropReasons') or {})[key] for key in r['selected'] if key in (ctx.state.get('dropReasons') or {})}
    return lines(
        f"Round {r['id']} · Stage the questions for {', '.join(r['selected'])} under asking.md Question format, "
        'with a round `title` and `summary`. A board item keeps its id in `board`; a pasted point or new '
        'question is a draft (`board`: null, `for`: the point id)' + (', created on the board at Record' if ctx.board
                                                                        else '') + '. `settles` lists the selected items '
        'one answer settles the same way (a rule question). `waitsOn` names the questions a '
        'decision rests on; kind confirm-own-rulings asks the user to confirm your rulings. Mark each recommendation '
        'under decision-protocol.md Recommendation strength: strong sets `strongBecause` '
        f"{', '.join(STRONG_CRITERIA)} each to \"true: <evidence>\" (\"does-not-apply: <reason>\" for consumerWalk "
        'and rulingsHold); lean sets `leanBecause` with cause preference or evidence. Limits in characters and who '
        f'reads each field: round `summary` {SUMMARY_MAX} (pane header); `title` {TITLE_MAX} (pane row; a question\'s '
        f"is also the board item's title); `text` {TEXT_MAX}, without a number (the engine numbers the dialog; it is the dialog "
        f"question and the board item's Question); `header` "
        f'{HEADER_MAX} (dialog chip); option `label`, `description` {DESCRIPTION_MAX} and optional `preview` (dialog; '
        'single-select questions only).',
        *(['A release dropped or held back these records earlier (the reason says what changed; ask what it leaves open):',
           *(f'- {key}: {reason}' for key, reason in dropped.items())] if dropped else []),
        *(['Already staged (carried held decisions):', *staged] if staged else []),
        report_hint(ctx, 'stage', {'round': {'title': '<what this round decides>', 'summary': '<the topic in plain words>'},
                     'questions': [{'key': 'a', 'board': None, 'for': r['selected'][0] if r['selected'] else None,
                                    'settles': [], 'text': '<question>?',
                                    'title': '<the decision as a short question>', 'header': '<topic noun>',
                                    'kind': 'decision',
                                    'options': [{'label': 'A', 'description': '…', 'preview': '<code example>'},
                                                {'label': 'B', 'description': '…'}],
                                    'premises': '<grounded premises>', 'recommendation': 'A', 'strength': 'lean',
                                    'leanBecause': {'cause': 'evidence', 'detail': '<the unchecked fact and how to check it>'},
                                    'waitsOn': []}]}),
    )


def describe_errors(raw, where: str, required: bool) -> list[str]:
    if raw is None and not required:
        return []
    if not isinstance(raw, dict) or not all(isinstance(raw.get(k), str) and raw[k].strip() for k in ('title', 'summary')):
        return [f'{where}: `round` needs a plain-words "title" and a "summary" of what this round decides']
    return [f'{where}: round {field} at most {limit} characters' for field, limit in
            (('title', TITLE_MAX), ('summary', SUMMARY_MAX)) if len(raw[field]) > limit]


def describe(ctx: Context, raw, where: str, required: bool) -> None:
    """The round's title and summary: the topic in plain words, no ids."""
    refuse_all(describe_errors(raw, where, required))
    if raw is not None:
        ctx.round.update(title=raw['title'].strip(), summary=raw['summary'].strip())


def stage_accept(ctx: Context, report: dict) -> str:
    raw = report.get('questions')
    errors = describe_errors(report.get('round'), 'stage', required=True)
    if not isinstance(raw, list):
        fail('; '.join([*errors, '`questions` must be a list']))
    keys = {}
    for index, item in enumerate(raw):
        try:
            if not isinstance(item, dict):
                fail(f'questions[{index}]: must be an object')
            q = new_question(ctx, item, f'questions[{index}]')
        except ProtocolError as error:
            errors.append(str(error))
            continue
        ctx.round['questions'].append(q)
        keys[item.get('key') or q['id']] = q['id']
    refuse_all(errors)
    describe(ctx, report.get('round'), 'stage', required=True)
    resolve_waits(ctx, keys)
    unique_texts(ctx)
    refuse_all(coverage_errors(ctx))
    if not ctx.round['questions']:
        fail('stage at least one question')
    for q in ctx.round['questions']:
        q['status'] = premise_status(ctx, q)
    ctx.log('staged', questions=[q['id'] for q in ctx.round['questions']])
    return 'related'


def unresolved(ctx: Context) -> list[tuple[dict, dict]]:
    return [(q, hit) for q in ctx.round['questions'] for hit in q['overlaps'] if hit['outcome'] is None]


def related_enter(ctx: Context) -> str | None:
    for q in ctx.round['questions']:
        if q['board'] is None and not q['searched'] and q['status'] != 'answered':
            if ctx.board:
                known = {hit['id'] for hit in q['overlaps']}
                hits = related_hits(ctx.board, f"{q['title']}\n{q['text']}")
                q['overlaps'] += [{'id': hit, 'title': title, 'outcome': None} for hit, title in hits if hit not in known]
                ctx.log('related', question=q['id'], hits=[hit for hit, _ in hits])
            q['searched'] = True
    if unresolved(ctx):
        return None
    return gate_ask(ctx) if ctx.round['check'].get('converged') else 'check'


def related_text(ctx: Context) -> str:
    rows = [f"- {q['id']} ({q['title']}) overlaps {hit['id']}" for q, hit in unresolved(ctx)]
    return lines(
        f"Round {ctx.round['id']} · Related: each new draft's board hits need an outcome before asking: duplicate or "
        'extend (the question takes that item over, in place: the same question answered again), relate (link at Record), '
        'supersedes (a different question, or one replacing several records: Record closes each decided record it '
        'replaces once the answer is recorded, and opens a released one as a revision, replaced at release; a change to '
        'one clause is no replacement), unrelated. Mark `supersedes` on any decided record the question replaces, a hit or '
        'not (name the id under outcomes). Inspect with `board show <id>`; comment on or hand off overlaps '
        'other sessions hold. Also search the exact names of the modules, APIs and sibling cases the options build on '
        f'(`board related <terms>`). A hit that widens the round: list the open items with `{LIST_COMMAND}`.',
        *rows,
        report_hint(ctx, 'related', {'outcomes': {q['id']: {hit['id']: 'unrelated'} for q, hit in unresolved(ctx)[:1]}}),
    )


def split_holds(ctx: Context, holders: dict[str, str]) -> tuple[dict[str, str], dict[str, str]]:
    """(live, gone) among the records another session holds (id -> holder), by the board's mark for the holder."""
    me = ctx.board.actor.split('/', 1)[0]
    foreign = {rid: holder for rid, holder in holders.items() if holder and holder.split('/', 1)[0] != me}
    if not foreign:
        return {}, {}
    return foreign_holds(ctx, [{'id': rid, 'holder': holder} for rid, holder in foreign.items()], ctx.board.json('position', '--json'))


def resolve_replaced(ctx: Context, q: dict) -> None:
    """What the question's `supersedes` hits mean, read from the board: a decided (unreleased) record closes at Record
    (`q['replaces']`); a released one is revised, replaced at its release (`q['revises']`, at most one). Refuses what
    Record could not carry out: a record that is no ruling, a foreign live hold (`board supersede` has no holder
    check), more than one revision to carry onto the new record."""
    hits = [h['id'] for h in q['overlaps'] if h['outcome'] == 'supersedes']
    q['replaces'], q['revises'] = [], None
    if not hits:
        return
    rows = ctx.board.json('show', *hits, '--json', '--field', 'status', '--field', 'issue_type', '--field', 'assignee',
                          '--field', 'dependencies', '--field', 'metadata', '--field', 'title')
    for hit in q['overlaps']:  # the dialog names each record it replaces by its title
        if hit['id'] in hits:
            hit['title'] = (rows.get(hit['id']) or {}).get('title') or hit['title']
    problems = [f"{hit} is {(rows.get(hit) or {}).get('status')} {(rows.get(hit) or {}).get('issue_type')}, not a ruling"
                for hit in hits if (rows.get(hit) or {}).get('issue_type') != 'decision'
                or (rows.get(hit) or {}).get('status') in (None, 'open', 'in_progress')]
    if problems:
        fail(f"{q['id']}: supersedes needs a recorded ruling: " + '; '.join(problems))
    replaces = [hit for hit in hits if rows[hit]['status'] == 'decided']
    released = [hit for hit in hits if hit not in replaces]
    if len(released) > 1:
        fail(f"{q['id']}: a question revises at most one released record ({', '.join(released)}); split the question")
    held = split_holds(ctx, {hit: rows[hit].get('assignee') or '' for hit in replaces})[0]
    if held:
        fail(f"{q['id']}: {', '.join(f'{rid} (held by {holder})' for rid, holder in held.items())} would close at Record, "
             'and another live session holds it; ask that session to hand it off (board unclaim), or choose another outcome')
    # Record moves a closed record's pending revision to the new record, which keeps one revision (target and rule).
    carried = {(dep['depends_on_id'], (rows[hit].get('metadata') or {}).get(REVISES_RULE))
               for hit in replaces for dep in rows[hit].get('dependencies') or []
               if dep['issue_id'] == hit and dep['type'] == REVISES}
    if len({*carried, *((rid, None) for rid in released)}) > 1:
        fail(f"{q['id']}: the new record would revise more than one record or rule "
             f"({', '.join(sorted(f'{t}' + (f' ({r})' if r else '') for t, r in {*carried, *((rid, None) for rid in released)}))}); "
             'a record keeps one revision: split the question')
    q['replaces'], q['revises'] = replaces, released[0] if released else None


def related_accept(ctx: Context, report: dict) -> str:
    outcomes = report.get('outcomes')
    if not isinstance(outcomes, dict):
        fail('`outcomes` must map question ids to {hit id: outcome}')
    for qid, hits in outcomes.items():
        q = by_id(ctx, qid)
        if not isinstance(hits, dict):
            fail(f'outcomes.{qid}: must map hit ids to an outcome')
        for hit_id, outcome in hits.items():
            hit = next((h for h in q['overlaps'] if h['id'] == hit_id), None)
            if hit is None:
                if outcome != 'supersedes':
                    fail(f'outcomes.{qid}: {hit_id} is no hit of {qid} (only `supersedes` may name a decided record the search missed)')
                hit = {'id': hit_id, 'title': '', 'outcome': None}  # resolve_replaced reads its title and refuses what is no ruling
                q['overlaps'].append(hit)
            if outcome not in OUTCOMES:
                fail(f"outcomes.{qid}.{hit_id}: outcome must be one of {', '.join(OUTCOMES)}")
            hit['outcome'] = outcome
        takeover = [h['id'] for h in q['overlaps'] if h['outcome'] in ('duplicate', 'extend')]
        if len(takeover) > 1 or (takeover and any(h['outcome'] == 'supersedes' for h in q['overlaps'])):
            fail(f'{qid}: one question takes over at most one item, and not while it supersedes another')
        resolve_replaced(ctx, q)
    missing = unresolved(ctx)
    if missing:
        fail('outcomes missing: ' + ', '.join(f"{q['id']}→{hit['id']}" for q, hit in missing))
    return gate_ask(ctx) if ctx.round['check'].get('converged') else 'check'


# Check loop: step-back then ground per cycle until a cycle changes nothing; the cap hands over to the user.

def fresh_check(ctx: Context) -> None:
    ctx.round['checkRun'] = ctx.round.get('checkRun', 0) + 1  # a new check run tells its passes the skill text again
    ctx.round['check'] = {'cycle': 1, 'cap': CHECK_CAP, 'expect': 'step-back', 'changes': 0, 'last': {},
                          'converged': False, 'challenged': False, 'focused': False, 'focusing': False, 'pathNow': False,
                          'pathScoped': False, 'refineNow': None, 'refineScoped': False, 'refineChanges': 0, 'askNow': False, 'paused': False}
    for q in questions(ctx, 'ready'):
        q['status'] = 'draft'
    start_base(ctx)


def rescope_ids(ctx: Context) -> list[str]:
    """The restarted questions still in the round: `protocol restart` queues scoped reruns of the path and refine passes
    on them (round['rescope']: ids, pending `path` and `refine` passes, `seen` observed runs); the round's flags stay."""
    scope = ctx.round.get('rescope') or {}
    live = {q['id'] for q in ctx.round['questions']}
    return [qid for qid in scope.get('ids', []) if qid in live]


def rescope_check(ctx: Context, ids: list[str]) -> None:
    """The restarted (or released held) ids get their own path pass and refine pair, accumulating over restarts before the
    loop settles, then a fresh check; the round's once-per-round flags stay."""
    r = ctx.round
    scope = r.get('rescope') or {'ids': [], 'path': True, 'refine': [], 'seen': []}
    r['rescope'] = {'ids': list(dict.fromkeys([*scope['ids'], *ids])), 'path': True, 'refine': list(REFINE_LENSES), 'seen': []}
    fresh_check(ctx)


def rescope_done(ctx: Context) -> None:
    scope = ctx.round.get('rescope')
    if scope and not scope['path'] and not scope['refine']:
        del ctx.round['rescope']


def start_base(ctx: Context) -> None:
    """The next step-back of the Base loop; the round's first one is the path pass (round-wide, once per round: r5 q21,
    flagged on the round so a rebuilt check does not repeat it), and after a restart a path pass on the restarted ids."""
    r, check = ctx.round, ctx.round['check']
    scope = r.get('rescope')
    check['pathNow'] = not r.get('pathRun')
    check['pathScoped'] = bool(not check['pathNow'] and scope and scope['path'] and rescope_ids(ctx))
    if scope and check['pathNow']:
        scope['path'] = False  # the round-wide path pass covers the restarted ids
    elif scope and scope['path'] and not check['pathScoped']:
        scope['path'] = False
    if check['pathScoped']:
        check['pathNow'] = True
        ctx.set_pending('step-back', ' '.join([*PATH_LENSES, *rescope_ids(ctx)]))
    else:
        ctx.set_pending('step-back', ' '.join(PATH_LENSES) if check['pathNow'] else '')
    rescope_done(ctx)


def count_pass_args(ctx: Context, command: str, args: str) -> None:
    """A pass whose argument names every lens of the path set (or of a refine pass) counts as that pass for the round;
    with the restarted ids as well, it counts for the scoped rerun."""
    named = set(args.split())
    r = ctx.round
    if r['protocol'] == 'release':  # the scoped pass counts once its run named the revised records
        pending = r['pending'] or {}
        if r['step'] == 'scoped' and pending.get('command') == command and set(pending.get('args', '').split()) <= named:
            r['scoped']['seen'] = list(dict.fromkeys([*r['scoped']['seen'], command]))
        return
    scope = r.get('rescope')
    scoped = bool(scope) and set(rescope_ids(ctx)) <= named
    if command == 'step-back' and set(PATH_LENSES) <= named:
        r['pathRun'] = True
        if scoped:
            scope['seen'] = list(dict.fromkeys([*scope['seen'], 'path']))
    if command in REFINE_LENSES and set(REFINE_LENSES[command]) <= named:
        r['refineRun'] = list(dict.fromkeys([*r.get('refineRun', []), command]))
        if scoped:
            scope['seen'] = list(dict.fromkeys([*scope['seen'], command]))


def check_enter(ctx: Context) -> str | None:
    if not ctx.round['check'].get('expect'):
        fresh_check(ctx)
    return None


def needs_related(ctx: Context) -> bool:
    return bool(unresolved(ctx)) or any(q['board'] is None and not q['searched'] for q in questions(ctx, 'draft', 'held'))


def needs_challenge(ctx: Context) -> bool:
    """Every round carries own rulings (excluded options, accepted premises, bundling, entailed choices): challenge-rulings
    runs last before a batch, again whenever a pass changed questions since its last run (`challenged` is cleared by
    any pass with changes and set only by a challenge-rulings pass that changed nothing), so unsure rulings become
    questions in it. The cycle cap bounds the repeats."""
    check = ctx.round['check']
    return not check['challenged'] and not (check['askNow'] and check.get('challengeRan')) and bool(questions(ctx, 'draft', 'ready'))


def gate_ask(ctx: Context) -> str:
    """Before asking: every related hit has an outcome; challenge-rulings ran on the converged questions."""
    check = ctx.round['check']
    check['converged'] = True
    if needs_related(ctx):
        return 'related'  # a pass added or reworded drafts: search them first
    if not check['askNow']:
        # The refine pair, once per round after the Base loop converged (r5 q20, q26): step-back, then ground, round-wide
        # (no question ids).
        scope = ctx.round.get('rescope')
        for command, lenses in REFINE_LENSES.items():
            if command not in ctx.round.get('refineRun', []):
                if scope and command in scope['refine']:
                    scope['refine'].remove(command)  # the round-wide pass covers the restarted ids
                check.update(expect=command, refineNow=command, refineScoped=False)
                ctx.set_pending(command, ' '.join(lenses))
                return 'check'
            if scope and command in scope['refine']:
                if not rescope_ids(ctx):
                    scope['refine'].remove(command)
                    continue
                check.update(expect=command, refineNow=command, refineScoped=True)
                ctx.set_pending(command, ' '.join([*lenses, *rescope_ids(ctx)]))
                return 'check'
        rescope_done(ctx)
        if check.get('refineChanges'):  # the pair's changes rerun the Base loop (under the cap); the pair does not run again
            check['refineChanges'] = 0
            return next_cycle(ctx)
    leans = [q['id'] for q in questions(ctx, 'draft', 'ready') if q.get('strength') == 'lean']
    if leans and not check.get('focused') and not check['askNow']:
        # One targeted pass on every lean, evidence or preference: strengthen it with evidence, or name what it rests on.
        check.update(expect='ground', focusing=True)
        ctx.set_pending('ground', ' '.join([*LEAN_LENSES, *leans]))
        return 'check'
    if needs_challenge(ctx):
        check['expect'] = 'challenge-rulings'
        ctx.set_pending('challenge-rulings')
        return 'check'
    ctx.round['pending'] = None
    return 'ask'


def cap_batch(ctx: Context) -> None:
    r = ctx.round
    r['pending'] = None
    r['batchSeq'] += 1
    r['batch'] = {'marker': f"round:{r['id']}:{r['batchSeq']}", 'cap': True, 'ids': [], 'questions': [{
        'question': f"Round {r['id']}: the check loop ran {r['check']['cycle']} cycles and still changes the questions. "
                    'How to go on?',
        'header': 'Check cap', 'multiSelect': False,
        'options': [{'label': 'Continue', 'description': f'{CHECK_CAP} more step-back and ground cycles'},
                    {'label': 'Ask now', 'description': 'Ask the current questions as they stand'},
                    {'label': 'Pause', 'description': 'Stop the loop; protocol resume continues it'}]}]}
    ctx.log('cap', cycle=r['check']['cycle'], marker=r['batch']['marker'])


def next_cycle(ctx: Context) -> str:
    check = ctx.round['check']
    if check['cycle'] >= check['cap']:
        cap_batch(ctx)
        return 'check'
    check.update(cycle=check['cycle'] + 1, changes=0, expect='step-back', converged=False, refineNow=None)
    start_base(ctx)
    return 'check'


def pass_format(command: str) -> str:
    return lines(
        'After the pass, report each change as a per-question update: changed fields, a new question (no id), or '
        '{"id", "remove": true, "reason"}; report an empty list when nothing changed. A pass that would revise a '
        "user's ruling raises it as a new question. Merge questions one answer settles the same way into one rule "
        'question (`settles`: the selected keys it settles); split an item out when the rule\'s application to it is open. '
        f'A question that widens the round\'s scope: list the open items with `{LIST_COMMAND}`.',
        'Report with `protocol step` (stdin JSON), e.g. ' + json_block({
            'pass': command, 'updates': [{'id': 'q1', 'premises': '<revised premise>'}],
            'checked': ['<what you examined, when nothing changed>'],
            'summary': '<one line: what the pass found>'}))


def pass_report_format(ctx: Context, command: str) -> str:
    return report_format(ctx, 'pass', pass_format(command))


def refused_formats(ctx: Context, step: Step, report: dict, before: dict) -> str:
    """The report formats a refused report repeats: the step's text rebuilt on the state before the refused call, which
    keeps every format it offers whether or not it printed them, and a pass report's own."""
    ctx.state, ctx.formats = before, {}
    with contextlib.suppress(Exception):
        step.text(ctx)
    if report.get('pass') in PASSES:
        ctx.formats.setdefault('pass', pass_format(report['pass']))
    return '\n'.join(ctx.formats.values())


def record_pass(ctx: Context, report: dict) -> tuple[str, int, str]:
    command = report.get('pass')
    if command not in PASSES:
        fail(f"`pass` must be one of {', '.join(PASSES)}")
    observed = ctx.round['observed']
    if not ctx.codex and command not in observed:  # Codex has no console to observe its runs
        fail(f'no /{command} ran since its last report: the console runs it as its own turn (end your turn), or the person '
             'types or presses it; a model Skill call counts once it ran')
    origin = observed.get(command, 'model')
    kind, scoped = pass_kind(ctx, command)
    describe(ctx, report.get('round'), 'pass report', required=False)
    checked = report.get('checked')
    if checked is not None and not (isinstance(checked, list) and all(isinstance(c, str) and c.strip() for c in checked)):
        fail('`checked` lists what the pass examined, as strings')
    changes = apply_updates(ctx, report.get('updates') or [])
    if ctx.rejected and not ctx.applied and not ctx.added:
        fail('no update applied: ' + '; '.join(ctx.rejected))
    if ctx.rejected:
        ctx.messages.append('Not applied (fix and resend these in a pass report; the others applied): '
                            + '; '.join(ctx.rejected))
    if not changes and not checked:
        fail(f'a {command} pass that changes nothing names what it checked: `"checked": ["q2: the retry premise in '
             'task-queue.ts", …]`')
    told = ctx.round.get('given', {}).get(command)
    if told is None:  # Codex: nothing observes its runs, the text it was given decides
        told = 'reminder' if pass_reminder(ctx, command) else 'full'
    mark_skill(ctx, command)  # the pass ran: the rest of the cycle's passes of its kind get the reminder
    if not ctx.rejected:
        observed.pop(command, None)  # a run stays open while part of its report was not applied: the resend counts
        ctx.round.get('given', {}).pop(command, None)
    ctx.round['check']['last'][command] = {'changes': changes, 'origin': origin}
    ctx.round['lastPass'] = {'pass': command, 'questions': list(dict.fromkeys([*ctx.applied, *ctx.added]))}  # in or out of sequence
    ctx.log('pass', command=command, changes=changes, questions=list(dict.fromkeys(ctx.applied)), added=ctx.added,
            rejected=len(ctx.rejected), origin=origin, cycle=ctx.round['check']['cycle'], summary=report.get('summary'),
            checked=checked, kind=kind, scoped=scoped, told=told)
    return command, changes, origin


def hold_pass(ctx: Context, command: str, changes: int) -> None:
    """A pass report with a refused update holds the round where it is (the batch does not go out on the old text): the
    applied changes wait in `held` and count with the resend, which comes as a pass report; the run stays open."""
    if changes and command != 'challenge-rulings':
        ctx.round['check']['challenged'] = False
    ctx.round['held'] = {'changes': changes}


def start_challenge(ctx: Context, kind: str, ids: list[str]) -> None:
    """One challenge-rulings pass outside the Base loop: `answers` over the answered set after the last answer, `raised` on
    the questions an edit raised to strong. Its additions wait for their scoped check; nothing reruns the loop."""
    ctx.round['check'].update(expect='challenge-rulings', converged=True, pathNow=False, pathScoped=False, refineNow=None,
                              refineScoped=False, focusing=False, challenge={'kind': kind, 'ids': ids})
    ctx.set_pending('challenge-rulings', ' '.join(ids))


def finish_challenge(ctx: Context, changes: int) -> str:
    """The pass of `start_challenge` reported: new questions it found wait for the scoped check (hand-over), then Ask.
    After the last answer a pass that changed nothing is done (`challenged`), else it runs again at the next hand-over."""
    check = ctx.round['check']
    spec = check.pop('challenge')
    for qid in ctx.added:
        if by_id(ctx, qid)['status'] == 'draft':
            by_id(ctx, qid)['unchecked'] = 'scoped'
    if spec['kind'] == 'answers':
        check.update(challenged=not changes, challengeRan=True)
    ctx.round['pending'] = None
    return 'ask'


def check_accept(ctx: Context, report: dict) -> str:
    check = ctx.round['check']
    if ctx.round['batch']:
        fail(f"waiting on the user's answer to {ctx.round['batch']['marker']}")
    if check['paused']:
        fail('the check loop is paused: protocol resume continues it')
    expected = check['expect']
    command, changes, _ = record_pass(ctx, report)
    changes += (ctx.round.pop('held', None) or {}).get('changes', 0)
    if ctx.rejected:
        hold_pass(ctx, command, changes)
        return 'check'
    if changes and command != 'challenge-rulings':
        check['challenged'] = False  # a change after the last challenge-rulings run re-arms it
    if check.get('challenge') and command == expected == 'challenge-rulings':
        return finish_challenge(ctx, changes)
    # A pending path or refine pass is that pass only once a run naming its lenses was observed (Codex has no observation:
    # it reports the pending pass it was told to run).
    scope = ctx.round.get('rescope') or {}
    path_seen = 'path' in scope.get('seen', []) if check.get('pathScoped') else ctx.round.get('pathRun')
    refine_seen = command in scope.get('seen', []) if check.get('refineScoped') else command in ctx.round.get('refineRun', [])
    path_open = not ctx.codex and check.get('pathNow') and not path_seen
    refine_open = not ctx.codex and check.get('refineNow') == command and not refine_seen
    if command != expected or path_open or refine_open:  # an extra pass between passes (pressed, typed, or asked for in chat)
        if changes:
            check.pop('challenge', None)
            check.update(changes=0, expect='step-back', converged=False, challenged=False, focused=False, focusing=False, refineNow=None)
            if not path_open:
                start_base(ctx)
        return 'check'
    if check.get('refineNow') == command:
        check.update(refineNow=None, refineChanges=check.get('refineChanges', 0) + changes)
        if check.get('refineScoped'):
            scope['refine'].remove(command)
            scope['seen'] = [one for one in scope['seen'] if one != command]
        else:
            ctx.round['refineRun'] = list(dict.fromkeys([*ctx.round.get('refineRun', []), command]))
        check['refineScoped'] = False
        return gate_ask(ctx)
    if command == 'step-back' and check.get('pathNow'):
        # The path pass: its changes flow into the Base loop that runs next; new or reworded drafts are searched first.
        if check.get('pathScoped'):
            scope['path'] = False
            scope['seen'] = [one for one in scope['seen'] if one != 'path']
        else:
            ctx.round['pathRun'] = True
        check.update(changes=0, expect='step-back')
        start_base(ctx)
        return 'related' if changes and needs_related(ctx) else 'check'
    if command == 'step-back':
        check.update(changes=changes, expect='ground')
        ctx.set_pending('ground')
        return 'check'
    if command == 'ground' and check.get('focusing'):
        check.update(focusing=False, focused=True)  # one pass: its changes do not restart the loop
        return gate_ask(ctx)
    if command == 'ground':
        if check['changes'] + changes == 0:
            return gate_ask(ctx)
        return next_cycle(ctx)
    check.update(challenged=not changes, challengeRan=True)  # challenge-rulings: a pass that changed nothing ends it
    if changes and not check['askNow']:
        return next_cycle(ctx)
    return gate_ask(ctx)


# Skill text once per cycle (r17-q62): the first step-back and the first ground of a check cycle get the skill's full text,
# the others a reminder cut from the installed SKILL.md; challenge-rulings, a release's scoped passes, a typed command and
# a model's own Skill call stay full. A new check run or a compaction makes the next pass full again.

LENS_ITEM = re.compile(r'^- \*\*([\w-]+):\*\*')
CUT_PASSES = ('step-back', 'ground')


def skill_blocks(text: str) -> tuple[list[str], dict[str, str], dict[str, str]]:
    """(intro paragraphs, `##` sections, lens items) of a skill's body: the intro is what stands between the title and the
    first `##`, comment lines out; a lens item is a `- **name:**` bullet with its wrapped lines."""
    body = text.split('\n---\n', 1)[1] if text.startswith('---\n') else text
    intro, sections, name, items, item = [], {}, None, {}, None
    for line in body.splitlines():
        if heading := re.match(r'##\s+(.+?)\s*$', line):
            name, item = heading.group(1), None
            sections[name] = []
            continue
        if line.startswith('# ') or line.strip().startswith('<!--'):
            continue
        (sections[name] if name else intro).append(line)
        if bullet := LENS_ITEM.match(line):
            item = bullet.group(1)
            items[item] = [line]
        elif item and line.startswith('  '):
            items[item].append(line)
        else:
            item = None
    paragraphs = [block.strip() for block in re.split(r'\n\s*\n', '\n'.join(intro)) if block.strip()]
    return paragraphs, {key: '\n'.join(rows).strip() for key, rows in sections.items()}, {key: '\n'.join(rows) for key, rows in items.items()}


def skill_reminder(command: str, args: str) -> str | None:
    """The reminder of `command` from its installed SKILL.md, which stays the one copy of the words: step-back's `## Stance`,
    ground's first body paragraph after the argument-handling lines, plus the lens items the argument names (step-back's
    base lenses when it names none). None when the file or a part is missing: the pass is then full."""
    try:
        path = Path(env().get('HOME') or str(Path.home())) / '.agents' / 'skills' / command / 'SKILL.md'
        paragraphs, sections, items = skill_blocks(path.read_text(encoding='utf-8'))
        named = list(itertools.takewhile(items.__contains__, args.split()))
        if command == 'step-back':
            lead = sections.get('Stance')
            chosen = named or list(BASE_LENSES)
        else:
            after = next((i for i, paragraph in enumerate(paragraphs) if paragraph.startswith('Lens names at the start')), None)
            lead = paragraphs[after + 1] if after is not None and after + 1 < len(paragraphs) else None
            chosen = named
        if not lead or any(lens not in items for lens in chosen):
            return None
    except (OSError, ValueError, KeyError):
        return None
    focus = f'Argument: `{args}`.' if args else 'No argument: the current discussion.'
    return lines(f'Reminder for /{command}; its full text went out earlier this cycle. {focus} Run it anew.', lead,
                 *(items[lens] for lens in chosen))


def pass_reminder(ctx: Context, command: str | None = None) -> str | None:
    """The reminder the pending pass gets instead of the skill's full text, or None when it gets the full text. Whether the
    cycle told this kind already is `state['told']`'s word."""
    r = ctx.round
    pending = (r or {}).get('pending')
    if SKILL_TEXT != 'cycle' or not pending or r['protocol'] != 'round' or pending['command'] not in CUT_PASSES \
            or command not in (None, pending['command']) or cycle_key(ctx, pending['command']) not in ctx.state.get('told', []):
        return None
    return skill_reminder(pending['command'], pending['args'])


def mark_skill(ctx: Context, command: str) -> None:
    """A step-back or ground ran with the skill's full text: the rest of the cycle's passes of that kind get the reminder."""
    r = ctx.round
    if command in CUT_PASSES and r['protocol'] == 'round':
        told = ctx.state.setdefault('told', [])
        if cycle_key(ctx, command) not in told:
            told.append(cycle_key(ctx, command))


def pending_view(ctx: Context) -> dict | None:
    """The pending pass for the console: its reminder (null when it gets the full text) beside the engine's own fields."""
    r = ctx.round
    if not r or r['step'] == 'closed' or not r['pending']:
        return None
    return {**r['pending'], 'reminder': pass_reminder(ctx)}


def pass_text(ctx: Context, command: str) -> str:
    args = (ctx.round['pending'] or {}).get('args') or ''
    scope = f'with the argument `{args}` (lenses, then the questions to strengthen)' if args else 'on the whole round'
    if ctx.codex:
        reminder = pass_reminder(ctx)
        if reminder:
            return lines(f'Run the {command} pass now {scope}, then report the pass.', reminder)
        return f'Run the {command} skill now {scope} (read its SKILL.md), then report the pass.'
    return ("Don't run or report the next pass in this turn: the console starts it as its own turn. Finish any other "
            "work for the user, then end the turn without a closing status line.")


HELD_TEXT = ('Held: part of the last pass report was not applied. Fix the refused updates and resend them in a pass report '
             '(the same pass); the questions go out after it.')


def check_text(ctx: Context) -> str:
    r, check = ctx.round, ctx.round['check']
    if r['batch']:
        return ask_text(ctx)
    if check['paused']:
        return f"Round {r['id']} · Check paused by the user at cycle {check['cycle']}. `protocol resume` continues it."
    command = check['expect']
    rows = [f"- {q['id']} {q['status']}{' (' + q['kind'] + ')' if q['kind'] != 'decision' else ''}: {q['text']}"
            + (f" — waits on {', '.join(q['waitsOn'])}" if q['status'] == 'held' else '') for q in r['questions']]
    if not first_time(ctx, cycle_key(ctx, 'questions')):  # the cycle's first pass lists them, the others count them
        rows = [f'{plural(len(rows), "question")} (protocol show lists them)']
    challenge = check.get('challenge') or {}
    return lines(
        f"Round {r['id']} · Check cycle {check['cycle']}/{check['cap']}"
        + (' (after the last answer: challenge the answers and your own rulings in this round; a finding is a new question, '
           'checked before it is asked).'
           if challenge.get('kind') == 'answers' else
           f" (the strong recommendation raised on {' '.join(challenge['ids'])})."
           if challenge.get('kind') == 'raised' else
           ' (last before the batch).'
           if command == 'challenge-rulings' else
           f" (the path pass on the restarted questions {' '.join(rescope_ids(ctx))}: goal and foundations)."
           if check.get('pathScoped') else
           " (the round's path pass: goal and foundations, before the drafts settle)."
           if check.get('pathNow') else
           f" (the refine pass on the restarted questions {' '.join(rescope_ids(ctx))}: the lenses named in the argument)."
           if check.get('refineScoped') else
           " (the round's refine pass: the lenses named in the argument)."
           if check.get('refineNow') else
           ' (the lean pass: make each lean named in the argument strong with evidence (a rule, a released ruling, a consumer '
           'need, a source or a probe), or keep it lean and name exactly what it depends on).'
           if check.get('focusing') else
           '.'),
        *rows,
        *([HELD_TEXT] if r.get('held') else []),
        pass_text(ctx, command),
        pass_report_format(ctx, command),
    )


# Ask: machine-issued batches marked round:<id>:<n>.

def dialog_question(q: dict, number: int | None = None) -> dict:
    """The AskUserQuestion entry: the recommended option first, its label marked with the strength and, on a lean,
    its description opening with what the lean rests on; a batch of 2+ numbers its questions (`1. `)."""
    best = next(o for o in q['options'] if o['label'] == q['recommendation'])
    description = best['description']
    if q['strength'] == 'lean':
        because = q.get('leanBecause') or {}
        kind = 'Unverified' if because.get('cause') == 'evidence' else 'Your call'
        description = f"{kind}: {because.get('detail')}" + (f' — {description}' if description else '')
    options = [{**best, 'label': best['label'] + recommended_suffix(q), 'description': description},
               *(o for o in q['options'] if o is not best)]
    text = f"{q['text']} {replaced_words(q)}".rstrip()
    return {'question': f'{number}. {text}' if number else text, 'header': q['header'], 'options': options,
            'multiSelect': q['multiSelect']}


def replaced_words(q: dict) -> str:
    """The records the question replaces, by id and title, added to the dialog's question text (the engine's, outside TEXT_MAX
    like the numbering): the question is what the user answers whichever option they pick, and an option's description would
    name them only on that option. An answer recorded closes the decided ones; a deferred one closes nothing."""
    closes, revised = q.get('replaces') or [], q.get('revises')
    titles = {hit['id']: hit.get('title') or '' for hit in q['overlaps']}
    named = lambda rid: f"{rid} ({cut(titles[rid], TITLE_MAX)})" if titles.get(rid) else rid
    return '; '.join(filter(None, [f"Recording it closes {', '.join(map(named, closes))}" if closes else '',
                                   f"{named(revised)} is replaced at release" if revised else ''])) + ('.' if closes or revised else '')


def released_held(ctx: Context) -> list[str]:
    """Held questions whose every `waitsOn` is answered now."""
    return [q['id'] for q in questions(ctx, 'held') if premise_status(ctx, q) == 'draft']


def unchecked(ctx: Context, kind: str | None = None) -> list[str]:
    """The questions an edit added or whose recommendation it changed (`scoped`), or raised to strong (`raised`): they wait
    out of the batches for their check at the hand-over."""
    return [q['id'] for q in questions(ctx, 'draft') if q.get('unchecked') and kind in (None, q['unchecked'])]


def take_unchecked(ctx: Context) -> list[str]:
    ids = unchecked(ctx)
    for qid in ids:
        del by_id(ctx, qid)['unchecked']
    return ids


def hand_over(ctx: Context) -> str:
    """Nothing is left to ask. A round continues with the questions that await a check, then ends (Record runs once, when
    nothing is left to ask):
    - held questions the answers released (r11 q42) and questions an edit added or re-recommended (r13 q47) get the scoped
      rerun (path pass and refine pair on their ids, a fresh Base loop, lean pass and challenge-rulings), then the next batch;
    - questions an edit raised to strong alone get one challenge-rulings pass on them (r13 q48);
    - once the last answer is in, one challenge-rulings over the answered set (r13 q49): a finding is a new question that
      takes the first path, and the pass runs again after its answer; a pass that changed nothing goes to Record.
    Questions still waiting on an unanswered one carry over."""
    r = ctx.round
    if r['protocol'] != 'round':
        return PROTOCOLS[r['protocol']].after_ask
    released, scoped, raised = released_held(ctx), unchecked(ctx, 'scoped'), unchecked(ctx, 'raised')
    if released or scoped:
        for q in questions(ctx, 'draft', 'held', 'ready'):
            q['status'] = premise_status(ctx, q)
        if released:
            ctx.log('continued', questions=released)
        if scoped:
            ctx.log('checking', questions=scoped)
        rescope_check(ctx, [*released, *take_unchecked(ctx)])
        return 'check'
    if raised:
        take_unchecked(ctx)
        ctx.log('checking', questions=raised, kind='raised')
        start_challenge(ctx, 'raised', raised)
        return 'check'
    heard = [q['id'] for q in questions(ctx, 'answered') if not q.get('recorded')]
    if heard and not r['check'].get('challenged'):
        start_challenge(ctx, 'answers', heard)
        return 'check'
    return PROTOCOLS[r['protocol']].after_ask


def ask_enter(ctx: Context) -> str | None:
    r = ctx.round
    if r['batch'] or r.get('held'):
        return None
    for q in questions(ctx, 'draft'):
        if q.get('unchecked'):
            continue  # an edit added it or changed its recommendation: it waits for its check (hand_over)
        q['status'] = 'ready'
        q.setdefault('messagesBefore', len(r['messages']))  # chat answers quote only messages sent after this
    ready = [q for q in questions(ctx, 'ready') if not q.get('typed')]  # typed answers wait for the model's reading
    if not ready:
        if questions(ctx, 'asked') or any(q.get('typed') for q in questions(ctx, 'ready')):
            return None
        return hand_over(ctx)
    # Only valid questions go out (an answer being recorded must not fail here). Only a question from before the limits
    # can be invalid here (staging, pass and edit updates check them): it names its error and the model shortens it in a
    # pass of its own (no automatic pass).
    valid, broken = [], {}
    for q in ready:
        try:
            check_question(q, q['id'], marks=bool(q.get('strength')))  # a release approval has no mark
            valid.append(q)
        except ProtocolError as error:
            broken[q['id']] = str(error)
    if broken:
        ctx.messages.append('Not asked yet: ' + '; '.join(broken.values()) + f". Shorten {', '.join(broken)} in a pass of its "
                            'own: call the ground skill on it (that Skill call counts as the observed run), then report the pass.')
    if not valid:
        return None
    chosen = valid[:BATCH]
    r['batchSeq'] += 1
    r['batch'] = {'marker': f"round:{r['id']}:{r['batchSeq']}", 'cap': False, 'ids': [q['id'] for q in chosen],
                  'questions': [dialog_question(q, i + 1 if len(chosen) > 1 else None) for i, q in enumerate(chosen)]}
    for q in chosen:
        q['status'] = 'asked'
    ctx.log('asked', marker=r['batch']['marker'], questions=r['batch']['ids'])
    return None


EDIT_STDIN = '{"updates": [...], "quote": "<the user\'s exact words>"}'
CHAT_STDIN = '{"question": "<q id>", "answer": "<the answer>", "quote": "<the user\'s exact words>"}'
EDIT_WORDS = 'a question the edit adds or whose recommendation it changes is checked before it is asked.'


def ask_text(ctx: Context) -> str:
    batch = ctx.round['batch']
    if not batch:
        if ctx.round.get('held'):
            return f"Round {ctx.round['id']} · Ask: {HELD_TEXT}"
        return f"Round {ctx.round['id']} · Ask: no batch out. `protocol step` with {{}} issues the next one."
    tool_input = {'questions': batch['questions'], 'metadata': {'source': batch['marker']}}
    lead = f"Round {ctx.round['id']} · " + ('Check cap reached: ask the user how to go on.' if batch['cap'] else
                                             f"Ask batch {batch['marker']} (walk through first under asking.md"
                                             + (', in this order, numbered like the dialog' if len(batch['questions']) > 1 else '') + ').')
    approval = approval_question(ctx) if ctx.round['protocol'] == 'release' else None
    if approval and approval['id'] in batch['ids'] and approval_reasons(ctx):
        lead += f" The dialog stays short; why it asks: {'; '.join(approval_reasons(ctx))}."
    once = first_time(ctx, 'ask')  # the dialog itself always prints; the instructions around it once
    if ctx.codex:
        answer_how = ('Then record the reply: `protocol answer --origin model-reported` with stdin '
                      + json_block({'marker': batch['marker'], 'answers': {batch['questions'][0]['question']: "<the user's own words, quoted verbatim>"}})
                      + ". Key each answer by the question's exact text and quote only what the user wrote; leave out questions "
                      'the user did not answer. If the user declines, run `protocol decline --origin model-reported` with stdin '
                      + json_block({'marker': batch['marker'], 'partial': None}) + '. To apply a change the user asked for to a question, '
                      f'run `protocol edit` (stdin {EDIT_STDIN}); ' + EDIT_WORDS)
        return lines(lead, f'Ask the user exactly these questions: {json_block(batch["questions"])}',
                     answer_how if once else f"Record the reply as before: `protocol answer --origin model-reported` (or `decline`), marker {batch['marker']}.")
    return lines(lead, f'Call AskUserQuestion with exactly this input: {json_block(tool_input)}',
                 f'To apply a change the user asked for to a question before they answer, use `protocol edit` (stdin {EDIT_STDIN}); '
                 + EDIT_WORDS +
                 ' A pass report updates questions only for a pass.\n'
                 'The console records the answers from the dialog. Never pass a person origin (dialog, composer, '
                 'bridge, press) yourself: the console relays those. Record an answer the user types in chat '
                 'instead with the protocol tool\'s ["answer"] (it stamps the origin; through Bash, `protocol '
                 'answer --origin chat`) and stdin '
                 + json_block({'question': batch['ids'][0] if batch['ids'] else '<q id>', 'answer': '<the answer>',
                               'quote': "<the user's exact words>"}) + '.' if once else '')


def ask_accept(ctx: Context, report: dict) -> str:
    """A pass report in Ask (after a decline, or an extra pass before the user answers) updates the questions: a batch
    still out comes back and is issued again, and a change reruns the check loop (asking.md Check)."""
    if ctx.round['batch'] and not report.get('pass'):
        fail(f"waiting on the user's answer to {ctx.round['batch']['marker']}; a pass report updates its questions")
    if ctx.round.get('held') and not report.get('pass'):
        fail('part of the last pass report was not applied: resend the refused updates in a pass report (the questions go out after it)')
    for q in questions(ctx):
        q.pop('typed', None)  # read: the step or pass report sends them out again
    if report.get('pass'):
        if ctx.round['batch']:
            ctx.log('batch-withdrawn', marker=ctx.round['batch']['marker'], reason='pass report')
            batch_back(ctx)
        command, changes, _ = record_pass(ctx, report)
        changes += (ctx.round.pop('held', None) or {}).get('changes', 0)
        if ctx.rejected:
            hold_pass(ctx, command, changes)
            return 'ask'
        if changes:
            waiting = take_unchecked(ctx)
            rescope_check(ctx, waiting) if waiting else fresh_check(ctx)
            return 'check'
    return 'ask'


# Record: the engine writes each record and runs board record (which lints it).

def note_of(q: dict) -> bool:
    return isinstance(q.get('annotations'), dict) and bool(str(q['annotations'].get('notes') or '').strip())


def record_text(ctx: Context) -> str:
    todo = [q for q in questions(ctx, 'answered') if not q.get('recorded')]
    rows = [f"- {q['id']}{' ' + q['board'] if q['board'] else ' (draft)'}: {q['text']}\n  answer ({q['origin']}): "
            f"{q['answer']}" + (f"\n  note: {q['annotations']['notes'].strip()}" if note_of(q) else '')
            + (f"\n  rule question, settles {', '.join(q['settles'])}: name each in the rationale or decision with how the "
               'rule applies' if q.get('settles') else '')
             + (f"\n  recording closes {', '.join(q['replaces'])}: name each in the rationale or decision with what the new "
                'record keeps or changes' if q.get('replaces') else '') for q in todo]
    held = [q['id'] for q in questions(ctx, 'held')]
    return lines(
        f"Round {ctx.round['id']} · Record (board-coordination.md#rulings). Check each answer against the option's "
        'wording; an answer stating a criterion restarts the affected questions instead (`protocol restart <ids>`).',
        *rows,
        *([f"Held for a later round: {', '.join(held)}."] if held else []),
        'Give each a rationale and its rule owner; decision and alternatives default to the answer and the options '
        'not chosen. A question the user deferred goes under `defer` with the reason.',
        report_hint(ctx, 'record', {'records': {q['id']: {'rationale': '<why, with provenance>', 'ruleOwner': '<path#anchor>'}
                                 for q in todo[:1]}, 'defer': {}}),
    )


def record_file(ctx: Context, q: dict, fields: dict) -> str:
    chosen = q['answer'] or ''
    # AskUserQuestion answers carry the chosen labels (comma-joined for multiSelect) or the user's own words.
    picked = {part.strip() for part in chosen.split(',')}
    alternatives = fields.get('alternatives') or '\n'.join(
        f"- {o['label']}: {o['description']}".rstrip(': ') for o in q['options'] if o['label'] not in picked)
    source = {'dialog': 'User (dialog)', 'chat': 'User (chat)', 'model-reported': 'User (model-reported)'}[q['origin']]
    quoted = f"{source}, {q.get('answeredAt', utcnow())[:10]}: \"{q.get('quote') or chosen}\""
    if q.get('strength') == 'strong' and isinstance(q.get('strongBecause'), dict):
        quoted = 'Recommended (strong): ' + '; '.join(f'{k} {v}' for k, v in q['strongBecause'].items()) + '\n\n' + quoted
    return (f"## Question\n{q['text']}\n\n## Alternatives Considered\n{alternatives or '- none offered'}\n\n"
            f"## Decision\n{fields.get('decision') or chosen}\n\n## Rationale\n{fields['rationale'].strip()}\n\n{quoted}\n\n"
            f"## Rule owner\n{fields['ruleOwner'].strip()}\n")


def board_item(ctx: Context, q: dict, path: Path) -> str:
    """The board id the record goes to: the question's item, else the draft created (or opened as a revision)."""
    if q['board']:
        return q['board']
    takeover = next((h['id'] for h in q['overlaps'] if h['outcome'] in ('duplicate', 'extend')), None)
    if takeover:
        q['board'] = takeover
        return takeover
    packet = path.with_suffix('.packet.md')
    packet.write_text(f"## Question\n{q['text']}\n\nOptions: " + '; '.join(o['label'] for o in q['options'])
                      + f"\n\nStaged in round {ctx.round['id']}.\n", encoding='utf-8')
    # The released record it revises, else the first record it closes: the new question is linked to it (parent and topic
    # labels come from it) until Record closes it; link_record links the other records it closes the same way.
    revised = q.get('revises') or next(iter(q.get('replaces') or []), None)
    if revised:
        new = ctx.board.checked('revise', revised, '--title', q['title'], '--body-file', str(packet)).strip()
    else:
        created = json.loads(ctx.board.checked('bd', 'create', '--type', 'decision', '--title', q['title'],
                                               '--body-file', str(packet), '--json') or '{}')
        new = created.get('id') if isinstance(created, dict) else None
    if not new:
        fail(f"{q['id']}: the board returned no id for the new question")
    q['board'] = new
    return new


def inherited_blocks(ctx: Context, q: dict) -> list[str]:
    """`bd batch` operations that give a rule question's record the `blocks` links of the items it settles (a released
    ruling blocks what it changes until planned, so closing the settled items must not unblock their dependents): the
    open items a settled item blocks wait on the record, and the open items a settled item waits on block the record.
    Edges among the settled items, to the record itself or to an item the record is linked to already are left."""
    settled = board_keys(q.get('settles'))
    if not settled:
        return []
    item = q['board']
    rows = ctx.board.json('show', *settled, item, '--json', '--field', 'dependencies')
    edges = {(dep['issue_id'], dep['depends_on_id'], dep['type']) for row in rows.values()
             for dep in (row or {}).get('dependencies') or []}
    linked = {frozenset((a, b)) for a, b, _ in edges if item in (a, b)}
    skip = {*settled, item}
    waiting = sorted({a for a, b, kind in edges if kind == 'blocks' and b in settled and a not in skip})
    blockers = sorted({b for a, b, kind in edges if kind == 'blocks' and a in settled and b not in skip
                       and not b.startswith('external:')})
    others = [*waiting, *blockers]
    open_items = {other for other, status in statuses(ctx, others).items() if status != 'closed'} if others else set()
    return [*(f'dep add {w} {item} blocks' for w in waiting if w in open_items and frozenset((w, item)) not in linked),
            *(f'dep add {item} {b} blocks' for b in blockers if b in open_items and frozenset((item, b)) not in linked)]


def link_record(ctx: Context, q: dict) -> None:
    """Relates the question's item to its `relate` hits and gives it the inherited blocks, in one batch; retried on a
    rerun until it succeeded once. bd keeps one edge per pair: a blocks link wins over a relate."""
    if not q.get('linked'):
        blocks = inherited_blocks(ctx, q)
        taken = {frozenset(op.split()[2:4]) for op in blocks}
        relate = [h['id'] for h in q['overlaps'] if h['outcome'] == 'relate' and frozenset((q['board'], h['id'])) not in taken]
        # A record the question closes stays linked (as a revision) until Record closes it: a Record that stops before the
        # close leaves a link `board release` refuses to pass, not two unrelated decided records.
        linked_now = q.get('revises') or next(iter(q.get('replaces') or []), None)
        pending = [old for old in q.get('replaces') or [] if old != linked_now]
        operations = [*(f"dep add {q['board']} {hit} relates-to" for hit in relate), *blocks,
                      *(f"dep add {q['board']} {old} {REVISES}" for old in pending)]
        if operations:
            ctx.board.checked('bd', 'batch', '-m', f"protocol: link {q['board']}", '--json', stdin=''.join(f'{op}\n' for op in operations))
    q['linked'] = True


def names_id(text: str, key: str) -> bool:
    return re.search(rf'(?<![\w.-]){re.escape(key)}(?![\w-]|\.\w)', text) is not None


def move_settled(ctx: Context, item: str, keys: list[str]) -> None:
    """The items a record settles, which stay claimed until a release closes them by that record."""
    settles = ctx.state.setdefault('settles', {})
    settles[item] = list(dict.fromkeys([*settles.get(item, []), *keys]))


def close_replaced(ctx: Context, q: dict, item: str) -> None:
    """Closes each decided record the recorded question replaces: `board supersede <old> --with <item>` once `item` is
    written and decided (it closes the old record and blocks the items waiting on it on the new one; a pending revision
    of the old record moves to the new one). The items the old record settles move to the new record, or they stay
    claimed with no release to close them. Repeatable: a record closed already is done. A hold of a gone session is
    taken; a live one's is refused."""
    todo = [old for old in q.get('replaces') or [] if old not in q.setdefault('closed', [])]
    if not todo:
        return
    rows = ctx.board.json('show', *todo, '--json', '--field', 'status', '--field', 'assignee')
    held = split_holds(ctx, {old: (rows.get(old) or {}).get('assignee') or '' for old in todo if (rows.get(old) or {}).get('status') != 'closed'})
    if held[0]:
        fail(f"{', '.join(f'{rid} (held by {holder})' for rid, holder in held[0].items())} closes with this record, and another "
             'live session holds it; ask that session to hand it off (board unclaim), then report again')
    for old in todo:
        status = (rows.get(old) or {}).get('status')
        if status == 'closed':
            pass
        elif status != 'decided':
            fail(f"{old} is {status}, not decided: it changed since Related, so it cannot close here")
        else:
            if old in held[1]:
                ctx.board.checked('take', old)
            result = ctx.board.run('supersede', old, '--with', item)
            after = (ctx.board.json('show', old, '--json', '--field', 'status').get(old) or {}).get('status')
            if after != 'closed':  # a failure before bd closed it; a later failure (blocks) leaves it closed
                fail(f"`board supersede {old} --with {item}` exited {result.returncode}: {(result.stderr or result.stdout).strip()}")
            if result.returncode != 0:
                ctx.messages.append(f"`board supersede {old} --with {item}` closed {old} but exited {result.returncode}: "
                                    f"{(result.stderr or result.stdout).strip()}")
        move_settled(ctx, item, ctx.state.get('settles', {}).pop(old, []))
        q['closed'].append(old)


def record_accept(ctx: Context, report: dict) -> str:
    records, deferred = report.get('records') or {}, report.get('defer') or {}
    if not isinstance(records, dict) or not isinstance(deferred, dict):
        fail('`records` and `defer` map question ids to objects and reasons')
    todo = [q for q in questions(ctx, 'answered') if not q.get('recorded')]
    for qid in [*records, *deferred]:
        if qid not in {q['id'] for q in todo}:
            fail(f'{qid}: not an answered question awaiting its record')
    missing = [q['id'] for q in todo if q['id'] not in records and q['id'] not in deferred]
    if missing:
        fail(f"records missing for {', '.join(missing)}")
    for qid, fields in records.items():
        if not isinstance(fields, dict) or not all(str(fields.get(k) or '').strip() for k in ('rationale', 'ruleOwner')):
            fail(f'records.{qid}: needs rationale and ruleOwner')
    # A question asked once its premise was answered rests on that answer: when the premise is deferred instead (the
    # engine learns of a deferral only here), the dependent's answer has no settled premise and carries over too (r11-q42).
    put_off = set(deferred) | {q['id'] for q in ctx.round['questions'] if q.get('recorded') == 'deferred'}
    resting = [f"{qid} rests on deferred {', '.join(w for w in q['waitsOn'] if w in put_off)}"
               for q in todo if (qid := q['id']) in records and any(w in put_off for w in q['waitsOn'])]
    if resting:
        fail('; '.join(resting) + ': defer it too, or restart it (`protocol restart <id>`) to ask it on a settled premise')
    unnamed = []
    for q in todo:  # a rule question's record names each item it settles (the release closes them by it)
        if q['id'] in records:
            said = ' '.join(str(records[q['id']].get(k) or '') for k in ('rationale', 'decision'))
            gone = [key for key in q.get('settles') or [] if not names_id(said, key)]
            if gone:
                unnamed.append(f"records.{q['id']}: the rule question settles {', '.join(gone)}; name each in the rationale or "
                               'decision with how the rule applies')
            unsaid = [old for old in q.get('replaces') or [] if not names_id(said, old)]
            if unsaid:  # the closed record's reader finds its replacement here, and the reader of this record what it replaced
                unnamed.append(f"records.{q['id']}: recording closes {', '.join(unsaid)}; name each in the rationale or "
                               'decision with what the new record keeps or changes')
    if unnamed:
        fail('; '.join(unnamed))
    folder = Path(ctx.round['records']) if ctx.round.get('records') else ctx.store.dir / 'records'
    folder.mkdir(parents=True, exist_ok=True)
    errors = []
    for q in todo:
        if q['id'] in deferred:
            q['recorded'] = 'deferred'
            ctx.log('deferred', question=q['id'], reason=deferred[q['id']])
            continue
        path = folder / f"{ctx.round['id']}-{q['id']}.md"
        path.write_text(record_file(ctx, q, records[q['id']]), encoding='utf-8')
        q['recordFile'] = str(path)
        if not ctx.board:
            q['recorded'] = 'file'
            ctx.log('recorded', question=q['id'], board=None, file=str(path), ok=True)
            continue
        try:
            item = board_item(ctx, q, path)
            link_record(ctx, q)
            ctx.board.checked('claim', item)
            ctx.board.checked('record', item, str(path))
            if board_keys(q.get('settles')):
                move_settled(ctx, item, board_keys(q['settles']))  # the release closes them
            close_replaced(ctx, q, item)  # a failed close leaves the question unrecorded: the rerun retries what is left
            q['recorded'] = item
            (ctx.state.get('dropReasons') or {}).pop(item, None)  # a re-recorded record is back in the default set
        except ProtocolError as error:
            errors.append(f"{q['id']}: {error}")
        ctx.log('recorded', question=q['id'], board=q['board'], file=str(path), ok=bool(q.get('recorded')))
        for old in [one for one in q.get('closed') or [] if one not in q.setdefault('reported', [])]:  # after the record's own line
            q['reported'].append(old)
            ctx.log('superseded', question=q['id'], old=old, new=q['board'], partial=None)
    if errors:
        ctx.messages.append('Not recorded (fix and report again; recorded questions stay recorded):\n' + '\n'.join(errors))
        return 'record'
    return 'closed'


def release_claims(ctx: Context) -> None:
    """A hold ends with its work: the round releases what it claimed and did not record (deferred, held for the next
    round's Select, removed, or the round abandoned). Best effort: the round closes either way."""
    done = [q for q in ctx.round['questions'] if q.get('recorded') not in (None, 'deferred', 'file')]
    recorded = {q['board'] for q in done} | {key for q in done for key in q.get('settles') or []}  # settled items stay held to the release
    release = [item for item in dict.fromkeys(ctx.round.get('claimed', [])) if item not in recorded]
    if not release or not ctx.board:
        return
    try:
        ctx.board.checked('unclaim', *release)
        ctx.log('released', items=release)
    except ProtocolError as error:
        ctx.messages.append(f"Claims not released ({error}); run `board unclaim {' '.join(release)}`.")


def refresh_board(ctx: Context) -> bool:
    """Reads the board's counts and the size of a bare release (the decided records this session holds, minus the
    dropped), saved for the Board line and `next.release`; `show` never reads the board. Best effort: a failing read must
    not lose the board writes this call made."""
    try:
        found = ctx.board.json('health', '--json', '--items', 'decided')
    except ProtocolError as error:
        ctx.messages.append(f'Board counts unavailable ({error}); run `board health`.')
        return False
    ctx.state['counts'] = {key: (found.get('counts') or {}).get(key, 0) for key in COUNT_KEYS}
    dropped = ctx.state.get('dropReasons') or {}
    ctx.state['releasable'] = sum(1 for rid in held_decided(ctx.board, found) if rid not in dropped)
    return True


def closed_enter(ctx: Context) -> None:
    r = ctx.round
    r['pending'], r['batch'] = None, None
    release_claims(ctx)
    carried = [q for q in r['questions'] if q['status'] == 'held']
    ctx.state['carried'] += carried
    r['closedAt'] = utcnow()
    if ctx.board and refresh_board(ctx):
        r['countsAt'] = r['closedAt']
    ctx.log('closed', recorded=[q['id'] for q in r['questions'] if q.get('recorded')], carried=[q['id'] for q in carried])


def closed_text(ctx: Context) -> str:
    r = ctx.round
    done = [f"- {q['id']} → {q['recorded'] if q['recorded'] not in ('file',) else q['recordFile']}"
            + (f", closed {', '.join(q['closed'])}" if q.get('closed') else '')
            for q in r['questions'] if q.get('recorded')]
    counts = ctx.state.get('counts')
    return '\n'.join([
        f"Round {r['id']} closed.", *done,
        *([f"Held for a later round: {', '.join(q['id'] for q in r['questions'] if q['status'] == 'held')}."]
          if any(q['status'] == 'held' for q in r['questions']) else []),
        (f"Board: {counts['questions']} open questions, {counts['decided']} decided awaiting release, "
         f"{counts['toPlan']} released to plan, {counts['inReview']} in review, {counts['forUser']} waiting on the user."
         if counts and r.get('countsAt') else 'No board counts.' if ctx.board else 'No board here: the records are files only.'),
        *([f"Next: a release (decide.md Release) takes {release_takes(waiting)}. It starts when the user types /release-round or "
           'asks for it; nothing starts by itself.'] if (waiting := release_next(ctx)) else []),
    ])


def foreign_holds(ctx: Context, items: list[dict], position: dict) -> tuple[dict[str, str], dict[str, str]]:
    """(live, gone): item id -> holder of the items another session holds, split by the board's mark for the holder
    (`board position` `held`): a gone session's hold can be taken over, a live one's cannot be claimed."""
    me = ctx.board.actor.split('/', 1)[0]
    holders = {item['id']: str(item['holder']) for item in items
               if item.get('holder') and str(item['holder']).split('/', 1)[0] != me}
    marks = {h['id']: h.get('mark') for h in position.get('held') or []} if holders else {}
    return ({rid: holder for rid, holder in holders.items() if marks.get(rid) != 'gone'},
            {rid: holder for rid, holder in holders.items() if marks.get(rid) == 'gone'})


OPEN_VIEWS = ('decided', 'questions', 'ratification', 'inReview', 'forUser')  # `board health --json` item views Collect offers


def read_open(ctx: Context) -> tuple[dict, dict]:
    """The board reads the open-item list comes from: `board health` for COLLECT_VIEWS, and `board position`."""
    return ctx.board.json('health', '--json', '--items', COLLECT_VIEWS), ctx.board.json('position', '--json')


def open_items(ctx: Context, found: dict, position: dict) -> tuple[list[dict], dict[str, list[str]], list[dict]]:
    """(items, elsewhere, waiting): every open item Collect offers, once under the first view that has it, the ids another
    live session holds by holder, and the items assigned to the user. Another live session's holds stay out (board claim
    refuses them), and so do the user's, which the list shows apart; a gone session's hold stays, marked: a deciding
    session takes it over (board take), as the release does."""
    seen = {}
    row = lambda item, view: {'id': item['id'], 'view': view, 'status': item.get('status'), 'type': item.get('type'),
                              'title': item.get('title', ''), 'priority': item.get('priority'),
                              'blockedBy': item.get('blockedBy') or []}
    for view in OPEN_VIEWS:
        for item in (found.get('items') or {}).get(view) or []:
            seen.setdefault(item['id'], row(item, view))
    for view, key in (('readyMilestone', 'readyMilestones'), ('finishedEpic', 'finishedEpics')):
        for item in position.get(key) or []:
            seen.setdefault(item['id'], row(item, view))
    live, gone = foreign_holds(ctx, [item for view in OPEN_VIEWS for item in (found.get('items') or {}).get(view) or []], position)
    for rid, holder in gone.items():
        seen[rid]['heldBy'] = f'{holder} (gone)'
    elsewhere, waiting = {}, []
    for rid, holder in live.items():
        if holder == 'user':
            waiting.append(seen[rid])
        else:
            elsewhere.setdefault(holder.split('/', 1)[0], []).append(rid)
        del seen[rid]
    return list(seen.values()), elsewhere, waiting


def named_errors(ctx: Context, named: list[str], items: list[dict], elsewhere: dict[str, list[str]], waiting: list[dict]) -> list[str]:
    """`start round <ids>`: each named id must be an open item the round offers; one a live session holds, a closed or an
    unknown one, and an open one no round offers are refused by name."""
    offered = {item['id'] for item in items}
    held = {rid: f'live session {holder}' for holder, ids in elsewhere.items() for rid in ids} | {item['id']: 'the user' for item in waiting}
    other = [rid for rid in named if rid not in offered and rid not in held]
    states = {}
    for rid in other:  # one read each: the board refuses a read naming an unknown id as a whole
        try:
            states |= ctx.board.json('show', rid, '--json', '--field', 'status')
        except ProtocolError:
            states[rid] = {'status': None}
    errors = []
    for rid in named:
        if rid in held:
            errors.append(f'{rid} is held by {held[rid]}')
        elif rid not in offered:
            status = (states.get(rid) or {}).get('status')
            errors.append(f'{rid} is ' + ('unknown' if status is None else 'closed' if status == 'closed'
                                          else f'{status}, an item no round offers'))
    return errors


def collect_enter(ctx: Context) -> None:
    if not ctx.board or ctx.round.get('scope') == 'discussion':
        return  # a discussion round's points come from the model; board items join through Related
    found, position = read_open(ctx)
    ctx.state['counts'] = {key: (found.get('counts') or {}).get(key, 0) for key in COUNT_KEYS}
    ctx.round['items'], ctx.round['heldElsewhere'], ctx.round['waiting'] = open_items(ctx, found, position)
    errors = named_errors(ctx, ctx.round.get('named') or [], ctx.round['items'], ctx.round['heldElsewhere'], ctx.round['waiting'])
    if errors:
        fail('start round: ' + '; '.join(errors))


ROUND = Protocol('round', [
    Step('collect', collect_text, collect_accept, collect_enter),
    Step('select', select_text, select_accept),
    Step('stage', stage_text, stage_accept),
    Step('related', related_text, related_accept, related_enter),
    Step('check', check_text, check_accept, check_enter),
    Step('ask', ask_text, ask_accept, ask_enter),
    Step('record', record_text, record_accept),
    Step('closed', closed_text, None, closed_enter),
], after_ask='record')

# Release: decide.md Release run like a round (r3-q7): the engine sequences the steps, takes approval only from a
# person origin, checks the owners, and runs board release, supersede and the answered closes. The reports carry
# the judgment. The run uses the round slot (state['round']) with the next run id (r4-q17).

HIT_CLASSES = {
    'revises': 'earlier ruling it revises or contradicts, closed included (supersede it)',
    'answers': 'open question it duplicates or answers (merge, or the engine closes it)',
    'premise': 'open question its own premise rests on (the record leaves the set)',
    'assumes': 'open item assuming the old state (board block <item> --on <record> --reason "<revised clause>")',
    'deferred': 'deferred item assuming the old state, or one it unblocks (relate it; comment the revised clause)',
    'held': 'item another session holds on the same concepts (comment or hand off)',
    'doc': "doc stating the old rule (a design-target doc: owner write now; a README or skill: owner write, or a task when it changes with the work)",
}
REACHES = ('contained', 'spreads')  # no "unsure": unsure is spreads (r4-q14, fails closed)
DISCLOSURE = ('ruling', 'alternative', 'fails', 'evidence')  # asking.md Walk through: own rulings
TOUCHES = ('own', 'decision')  # a contained change: only the model's own parts keeps the record; unsure is decision (r8-q36)
APPROVE, HOLD = 'Release', 'Hold'
SCOPED_PASSES = ('step-back', 'ground')  # once per release on the revised records, before the approval (r8-q36)


def in_set(ctx: Context) -> list[str]:
    """The records the release carries: in the set, or revised (kept with a corrected record text)."""
    return [rec['id'] for rec in ctx.round['set'] if rec['state'] in ('set', 'revised')]


def revised(ctx: Context) -> list[str]:
    return [rec['id'] for rec in ctx.round['set'] if rec['state'] == 'revised']


def set_record(ctx: Context, rid: str) -> dict:
    return next((rec for rec in ctx.round['set'] if rec['id'] == rid), None) or fail(f'{rid} is not in this release')


def release_label(ctx: Context) -> str:
    """`the session's records`, or the named ids: the run's title in the pane and the headline."""
    if ctx.round.get('source'):
        return "the session's records"
    ids = [rec['id'] for rec in ctx.round['set']]
    return ', '.join(ids[:3]) + (f' +{len(ids) - 3}' if len(ids) > 3 else '')


def default_set(ctx: Context) -> list[str]:
    """What a bare release takes (r13 q50): the decided records this session holds, read from the board now, minus the ones
    a release dropped or stopped (`dropReasons`, cleared by a re-recording or a release)."""
    held = held_decided(ctx.board)
    dropped = ctx.state.get('dropReasons') or {}
    ids = [rid for rid in held if rid not in dropped]
    if not ids:
        fail('no default set: ' + (f"every decided record this session holds ({', '.join(held)}) was dropped or stopped by a "
                                   'release: it goes to a round first' if held else 'this session holds no decided records')
             + '; name the ids: `protocol start release <id> …`')
    return ids


def start_release(ctx: Context, ids: list[str]) -> None:
    """The set (r4-q12, r13 q50): the named ids, else the decided records this session holds, minus the dropped. Ids
    another live session holds are refused; a gone session's hold is taken, unheld records are claimed."""
    if ctx.board is None:
        fail('a release needs a board: run it in the repository whose board holds the records; '
             'a --no-board round closes at Record')
    source = None
    if not ids:
        source, ids = 'the session', default_set(ctx)
    ids = list(dict.fromkeys(ids))
    found = ctx.board.json('show', *ids, '--json', '--field', 'status', '--field', 'issue_type', '--field', 'title',
                           '--field', 'assignee')
    rows = {rid: found.get(rid) or {} for rid in ids}
    undecided = [rid for rid in ids if rows[rid].get('issue_type') != 'decision' or rows[rid].get('status') != 'decided']
    if undecided:
        fail('not decided records: ' + ', '.join(f"{rid} ({rows[rid].get('status')} {rows[rid].get('issue_type')})"
                                                  for rid in undecided))
    me = ctx.board.actor.split('/', 1)[0]
    foreign = [rid for rid in ids if rows[rid].get('assignee') and rows[rid]['assignee'].split('/', 1)[0] != me]
    gone = []
    if foreign:
        marks = {h['id']: h.get('mark') for h in ctx.board.json('position', '--json').get('held') or []}
        live = [rid for rid in foreign if marks.get(rid) != 'gone']
        if live:
            fail('held by another live session: ' + ', '.join(f"{rid} ({rows[rid]['assignee']})" for rid in live)
                 + '; ask it to hand them off, or name other ids')
        gone = foreign
    claim = [rid for rid in ids if rid not in gone and rows[rid].get('assignee') != ctx.board.actor]
    if gone:
        ctx.board.checked('take', *gone)
    if claim:
        ctx.board.checked('claim', *claim)
    forget_cycles(ctx)
    ctx.state['round'] = {
        'id': next_id(ctx.state, 'round', 'r'), 'protocol': 'release', 'step': 'recheck', 'startedAt': utcnow(),
        'repo': ctx.board.repo, 'scope': 'release', 'source': source, 'title': None, 'summary': None,
        # the round keys the shared views and the ask machinery read
        'records': None, 'items': [], 'points': [], 'classes': {}, 'selected': [], 'questions': [], 'check': {},
        'pending': None, 'observed': {}, 'batch': None, 'batchSeq': 0, 'responses': [], 'messages': [],
        'set': [{'id': rid, 'title': rows[rid].get('title') or '', 'state': 'set', 'reason': None} for rid in ids],
        'checks': {}, 'supersedes': [], 'closes': {}, 'rulings': None, 'conditional': None, 'approval': None,
        'owners': {}, 'done': [], 'retry': False, 'stopped': None, 'outcome': None, 'scoped': {'done': [], 'seen': []},
    }
    ctx.round['title'] = release_label(ctx)
    ctx.log('start', protocol='release', repo=ctx.board.repo, records=ids, taken=gone, source=source)
    ctx.go('recheck')


def set_rows(ctx: Context) -> list[str]:
    return [f"- {rec['id']}: {rec['title']}" + (' (revised)' if rec['state'] == 'revised' else '')
            for rec in ctx.round['set'] if rec['state'] in ('set', 'revised')]


def drop(ctx: Context, rid: str, reason: str) -> None:
    """A record leaves the set (a contained change, or a premise still open); it stays decided and held for a round.
    The set changed: a conditional approval lapses (r4-q16)."""
    r = ctx.round
    rec = set_record(ctx, rid)
    rec.update(state='dropped', reason=reason)
    r['conditional'] = None
    r['supersedes'] = [sup for sup in r['supersedes'] if sup['new'] != rid]
    r['closes'] = {q: [x for x in recs if x != rid] for q, recs in r['closes'].items() if [x for x in recs if x != rid]}
    ctx.log('record-dropped', record=rid, reason=reason)


def revise(ctx: Context, rid: str, change: str) -> None:
    """A contained change of the model's own parts: the record stays in the release, its corrected text written. The
    approval no longer rests on what the person saw: a conditional approval lapses (r8-q36)."""
    set_record(ctx, rid).update(state='revised', reason=f'changed (contained, own): {change}', change=change)
    ctx.round['conditional'] = None
    ctx.log('record-revised', record=rid, reason=change)


def stop(ctx: Context, reason: str, ids: list[str], hold: bool = False) -> str:
    """Nothing releases; the records stay decided and held; the close names the round they go to (r4-q14). A person's Hold
    (r14 q52) goes to a round on what it was held for, so it drops nothing and a later bare release takes the rest."""
    r = ctx.round
    for rid in ids:
        set_record(ctx, rid)['state'] = 'changed'
    r['conditional'] = None
    r['stopped'] = {'reason': reason, 'hold': hold,
                    'ids': [rec['id'] for rec in r['set'] if rec['state'] in ('set', 'revised', 'changed', 'dropped')]}
    ctx.log('release-stopped', reason=reason, records=ids)
    return 'closed'


def apply_changes(ctx: Context, raw, where: str, every: bool, scope: list[str] | None = None) -> str | None:
    """Per record `unchanged`, or {change, reach, why, touches, file?}: contained (with `why` no other ruling moves)
    either keeps the record revised (touches own: the model's own rationale, evidence or clause; `file` is the corrected
    record text, which `board record` writes) or drops it (touches decision); spreads stops the run. Returns 'closed'
    when the run stops."""
    if not isinstance(raw, dict):
        fail(f'{where}: map each record id to "unchanged" or {{"change", "reach", "why", "touches"}}')
    current = in_set(ctx) if scope is None else scope  # a scoped pass maps the revised records only
    unknown = [rid for rid in raw if rid not in current]
    missing = [rid for rid in current if rid not in raw] if every else []
    if unknown or missing:
        fail(f"{where}: " + '; '.join(part for part in (
            f"not in the {'set' if scope is None else 'revised records'}: {', '.join(unknown)}" if unknown else '',
            f"no line for {', '.join(missing)}" if missing else '') if part))
    spreads, contained = [], []
    for rid, value in raw.items():
        if value == 'unchanged':
            continue
        if not isinstance(value, dict) or not str(value.get('change') or '').strip():
            fail(f'{where}.{rid}: "unchanged", or {{"change": "<what changed>", "reach": "contained" or "spreads"}}')
        if value.get('reach') not in REACHES:
            fail(f'{where}.{rid}: reach is contained or spreads; unsure is spreads')
        if value['reach'] == 'contained':
            if not str(value.get('why') or '').strip():
                fail(f'{where}.{rid}: a contained change names `why` no other ruling of the set or the board moves; '
                     'otherwise it spreads')
            if value.get('touches') not in TOUCHES:
                fail(f'{where}.{rid}: a contained change says what it touches: touches is "own" (only your own rationale, '
                     'evidence or a clause the chosen option did not state; the record stays, corrected) or "decision" '
                     '(what the user decided; the record leaves the set); unsure is decision')
            if value['touches'] == 'own' and not (isinstance(value.get('file'), str) and value['file'].strip()):
                fail(f'{where}.{rid}: an own change gives `file`, the path of the corrected record text')
        (spreads if value['reach'] == 'spreads' else contained).append((rid, value))
    if spreads:
        return stop(ctx, '; '.join(f"{rid} changed: {value['change']}" for rid, value in spreads), [rid for rid, _ in spreads])
    # The board writes come first and all-or-nothing for the state: a failure refuses the report, so it is sent again
    # (board record rewrites the same text).
    for rid, value in contained:
        if value['touches'] == 'own':
            result = ctx.board.run('record', rid, value['file'].strip())
            if result.returncode != 0:
                fail(f"{where}.{rid}: `board record {rid} {value['file']}` exited {result.returncode}: "
                     + (result.stderr.strip() or result.stdout.strip()) + '; fix the file and report again')
    for rid, value in contained:
        if value['touches'] == 'own':
            revise(ctx, rid, value['change'])
        else:
            drop(ctx, rid, f"changed (contained): {value['change']}")
    if not in_set(ctx):
        return stop(ctx, 'every record left the set', [])
    return None


def recheck_text(ctx: Context) -> str:
    return lines(
        f"Release {ctx.round['id']} · Re-check (decide.md Release 1) {release_label(ctx)}: compare each record with "
        "current items and source and with the set's other records; verify citations and counts. Where something "
        "changed since the decision, give its reach: contained (`why` no other ruling moves) or spreads (other rulings "
        'may move, or you are unsure: the run stops and the set goes to a round). A contained change says what it '
        f'{touches_hint()}',
        *(["A bare release takes the decided records this session holds, minus dropped ones; the ids named at start take "
           'fewer.'] if ctx.round.get('source') else []),
        *set_rows(ctx),
        report_hint(ctx, 'recheck', {'records': {rid: 'unchanged' for rid in in_set(ctx)[:1]}
                     | {'<id>': {'change': '<what changed>', 'reach': 'contained', 'why': '<why nothing else moves>',
                                 'touches': 'own', 'file': '<corrected record text, for own>'}}}),
    )


def touches_hint() -> str:
    return ('touches: "own" (only your own rationale, evidence or a clause the chosen option did not state: the record '
            'stays, revised; give `file`, the corrected record text, which the engine writes with `board record`, and '
            'a scoped step-back and ground pass check it before the approval) or "decision" (what the user decided: '
            'the record leaves the set for a round); unsure is decision.')


def recheck_accept(ctx: Context, report: dict) -> str:
    raw = report.get('records')
    changed = [rid for rid, value in raw.items() if value != 'unchanged'] if isinstance(raw, dict) else []
    ctx.log('rechecked', unchanged=len(raw or {}) - len(changed), changed=changed)  # queued: a refusal drops it
    return apply_changes(ctx, raw, 'records', every=True) or 'board-check'


def board_check_enter(ctx: Context) -> None:
    """The revisions the set's records name without a link (`board check --json`: a question missed them), read once on
    entering the step and listed in its text."""
    found = []
    try:
        rows = ctx.board.json('check', '--json')
        found = [row for row in (rows.get('unlinkedRevisions') if isinstance(rows, dict) else None) or []
                 if row.get('id') in in_set(ctx) or row.get('other') in in_set(ctx)]
    except ProtocolError as error:
        ctx.messages.append(f'Unlinked revisions unavailable ({error}); run `board check`.')
    ctx.round['unlinked'] = found


def board_check_text(ctx: Context) -> str:
    unlinked = ctx.round.get('unlinked') or []
    return lines(
        f"Release {ctx.round['id']} · Board check (decide.md Release 2): run `board related <terms>` across the set, "
        'closed items and canonical docs included (`--docs <paths>`), and act on every hit. Report per record one '
        'entry per hit class ("none", or rows {item, action}):',
        *(f'- {name}: {meaning}' for name, meaning in HIT_CLASSES.items()),
        *set_rows(ctx),
        *([f"Unlinked revisions the set's texts name (`board check`; a question missed them): "
           + '; '.join(f"{row['id']} {row['word']} {row['other']}: `board supersede {row['old']} --with {row['new']}`"
                       for row in unlinked) + '. Treat each as a `revises` hit of the record that replaces the other.']
          if unlinked else []),
        *(f"Pre-filled: {rid} answers {', '.join(settled)} (the items its rule question settled): the engine adds the "
          f"answers and the closes." for rid, settled in settled_in_set(ctx).items()),
        'Name the supersedes and the answered questions: the engine runs `board supersede` and closes those questions '
        'after the release ("Answered by released <record>"); every other action is yours. A ruling the check changes '
        f'goes under `changed` with its reach and, when contained, what it {touches_hint()}',
        report_hint(ctx, 'board-check', {'checks': {(in_set(ctx) or ['<id>'])[0]: {**{name: 'none' for name in HIT_CLASSES},
                                                              'answers': [{'item': '<question>', 'action': 'answered: close'}]}},
                     'supersedes': [{'old': '<record>', 'new': (in_set(ctx) or ['<id>'])[0], 'partial': '<rule, or leave out>'}],
                     'closes': {'<question>': [(in_set(ctx) or ['<id>'])[0]]}, 'changed': {}}),
    )


def settled_in_set(ctx: Context) -> dict[str, list[str]]:
    """The set's rule records and the board items their questions settled (recorded in this session's state)."""
    recorded = ctx.state.get('settles') or {}
    return {rid: recorded[rid] for rid in in_set(ctx) if recorded.get(rid)}


def prefill_settled(ctx: Context, checks: dict, closes: dict) -> tuple[dict, dict]:
    """Adds, for each settled item of a rule record in the set, the answers row `answered: close` and the close by that
    record, so `board release --closes` closes it. The report's own rows and closes stay."""
    checks, closes = copy.deepcopy(checks), copy.deepcopy(closes)
    for rid, settled in settled_in_set(ctx).items():
        classes = checks.get(rid)
        if not isinstance(classes, dict):
            continue  # the shape check names it
        rows = classes.get('answers')
        rows = [] if rows in (None, 'none') else rows
        if not isinstance(rows, list):
            continue
        for item in settled:
            if not any(isinstance(row, dict) and row.get('item') == item for row in rows):
                rows.append({'item': item, 'action': 'answered: close'})
            if isinstance(closes.get(item), list):
                closes[item] = list(dict.fromkeys([*closes[item], rid]))
            elif item not in closes:
                closes[item] = [rid]
        classes['answers'] = rows
    return checks, closes


def hit_items(checks: dict, rid: str, name: str) -> set[str]:
    rows = checks[rid][name]
    return set() if rows == 'none' else {row['item'] for row in rows}


def board_check_accept(ctx: Context, report: dict) -> str:
    r = ctx.round
    checks = report.get('checks')
    if not isinstance(checks, dict):
        fail('`checks` maps each record to its hit classes')
    if isinstance(report.get('closes') or {}, dict):
        checks, merged = prefill_settled(ctx, checks, report.get('closes') or {})
        report = {**report, 'closes': merged}
    current = in_set(ctx)
    problems = [f'no board check for {rid}' for rid in current if rid not in checks]
    problems += [f'{rid} is not in the set' for rid in checks if rid not in current]
    for rid, classes in checks.items():
        if not isinstance(classes, dict):
            problems.append(f'checks.{rid}: map each hit class to "none" or rows')
            continue
        problems += [f'checks.{rid}: no `{name}` entry ("none" allowed)' for name in HIT_CLASSES if name not in classes]
        problems += [f'checks.{rid}: unknown hit class {name}' for name in classes if name not in HIT_CLASSES]
        for name, rows in classes.items():
            if rows != 'none' and not (isinstance(rows, list) and rows and all(
                    isinstance(row, dict) and str(row.get('item') or '').strip() and str(row.get('action') or '').strip()
                    for row in rows)):
                problems.append(f'checks.{rid}.{name}: "none" or rows {{"item", "action"}}')
    if problems:
        fail('board check: ' + '; '.join(problems))
    supersedes = report.get('supersedes') or []
    closes = report.get('closes') or {}
    if not isinstance(supersedes, list) or not isinstance(closes, dict):
        fail('`supersedes` is a list of {old, new, partial?}; `closes` maps questions to the records answering them')
    for index, sup in enumerate(supersedes):
        if not isinstance(sup, dict) or not all(isinstance(sup.get(k), str) and sup[k].strip() for k in ('old', 'new')) \
                or not isinstance(sup.get('partial', ''), (str, type(None))):
            problems.append(f'supersedes[{index}]: {{"old", "new", "partial": "<rule>" (optional)}}')
        elif sup['new'] not in current:
            problems.append(f"supersedes[{index}]: {sup['new']} is not in the set")
        elif sup['old'] not in hit_items(checks, sup['new'], 'revises'):
            problems.append(f"supersedes[{index}]: {sup['old']} is no `revises` hit of {sup['new']}")
    for question, recs in closes.items():
        if not isinstance(recs, list) or not recs or not all(isinstance(x, str) for x in recs):
            problems.append(f'closes.{question}: the records answering it, as a list')
        elif [x for x in recs if x not in current]:
            problems.append(f"closes.{question}: not in the set: {', '.join(x for x in recs if x not in current)}")
        elif [x for x in recs if question not in hit_items(checks, x, 'answers')]:
            problems.append(f"closes.{question}: no `answers` hit of {', '.join(x for x in recs if question not in hit_items(checks, x, 'answers'))}")
    if not problems and (closes or supersedes):
        problems += board_targets(ctx, list(closes), [sup['old'] for sup in supersedes])
    if problems:
        fail('board check: ' + '; '.join(problems))
    r['checks'] = checks
    r['supersedes'] = [{'old': sup['old'], 'new': sup['new'], 'partial': sup.get('partial')} for sup in supersedes]
    r['closes'] = {question: list(dict.fromkeys(recs)) for question, recs in closes.items()}
    ctx.log('board-checked', supersedes=len(supersedes), closes=sorted(closes))
    stopped = apply_changes(ctx, report.get('changed') or {}, 'changed', every=False)
    if stopped:
        return stopped
    for rid in in_set(ctx):  # decide.md: an open question its premise rests on holds the record
        waiting = sorted(hit_items(checks, rid, 'premise'))
        if waiting:
            drop(ctx, rid, f"its premise waits on {', '.join(waiting)}")
    # board release refuses a record waiting on an open item outside the set: it leaves the set now, while the
    # report can still change, not after the approval (a blocker dropped here can drop its dependents in turn).
    blocked = {item['id']: item.get('blockedBy') or []
               for item in (ctx.board.json('health', '--json', '--items', 'decided').get('items') or {}).get('decided') or []}
    while True:
        waiting = {rid: [b for b in blocked.get(rid, []) if b not in in_set(ctx)] for rid in in_set(ctx)}
        waiting = {rid: blockers for rid, blockers in waiting.items() if blockers}
        if not waiting:
            break
        for rid, blockers in waiting.items():
            drop(ctx, rid, f"waits on open {', '.join(blockers)}")
    if not in_set(ctx):
        return stop(ctx, 'every record left the set', [])
    return 'own-rulings'


def board_targets(ctx: Context, closes: list[str], olds: list[str]) -> list[str]:
    """The answered closes and supersedes must exist, and each close be an open question this session may close: the
    conditions under which `board release --closes` refuses, checked while the report can still change."""
    try:
        found = ctx.board.json('show', *dict.fromkeys([*closes, *olds]), '--json', '--field', 'status', '--field',
                               'issue_type', '--field', 'assignee')
    except ProtocolError as error:
        return [f'closes and supersedes: {error}']
    me = ctx.board.actor.split('/', 1)[0]
    problems = []
    for question in closes:
        row = found.get(question) or {}
        if row.get('status') == 'closed':
            continue  # closed already: the release skips it
        if row.get('issue_type') != 'decision' or row.get('status') not in ('open', 'in_progress'):
            problems.append(f"closes.{question}: {row.get('status')} {row.get('issue_type')}, not an open question")
        elif row.get('assignee') and row['assignee'].split('/', 1)[0] != me:
            problems.append(f"closes.{question}: held by {row['assignee']}; hand it off first (comment, or ask its "
                            'session), or leave it out')
    return problems


def own_rulings_text(ctx: Context) -> str:
    return lines(
        f"Release {ctx.round['id']} · Own rulings (decide.md Release 3): list every ruling you made in the set with "
        "asking.md's disclosure fields: the ruling, its strongest realistic alternative, the test or principle that "
        'alternative fails, and the evidence. Mark each `sure` only when it is the only realistic clean option and '
        'grounded; an unsure ruling, like a dropped or revised record, sends the approval to a dialog.',
        *set_rows(ctx),
        report_hint(ctx, 'own-rulings', {'rulings': [{'record': (in_set(ctx) or ['<id>'])[0], 'ruling': '<your ruling>',
                                  'alternative': '<strongest alternative>', 'fails': '<what it fails>',
                                  'evidence': '<source>', 'sure': True}]}),
    )


def own_rulings_accept(ctx: Context, report: dict) -> str:
    rulings = report.get('rulings')
    if not isinstance(rulings, list):
        fail('`rulings` lists every ruling you made in the set (an empty list when there is none)')
    current = in_set(ctx)
    for index, ruling in enumerate(rulings):
        if not isinstance(ruling, dict) or ruling.get('record') not in current:
            fail(f'rulings[{index}]: `record` names a record of the set')
        missing = [k for k in DISCLOSURE if not str(ruling.get(k) or '').strip()]
        if missing or not isinstance(ruling.get('sure'), bool):
            fail(f"rulings[{index}]: needs {', '.join(missing) or 'the fields'} and `sure` true or false")
    ctx.round['rulings'] = rulings
    ctx.log('own-rulings', rulings=len(rulings), unsure=sum(1 for x in rulings if not x['sure']))
    return 'scoped'


def scoped_args(ctx: Context) -> str:
    return ' '.join(revised(ctx))


def scoped_enter(ctx: Context) -> str | None:
    """The scoped step-back, then ground, on the revised records (r8-q36), once per release: the pending pass waits for
    its report; without revised records, or once both ran, the approval follows."""
    r = ctx.round
    done = r.setdefault('scoped', {'done': [], 'seen': []})['done']
    command = next((one for one in SCOPED_PASSES if one not in done), None)
    if command is None or not revised(ctx):
        ctx.set_pending(None)
        return 'approval'
    args = scoped_args(ctx)
    if (r['pending'] or {}).get('command') != command or r['pending'].get('args') != args:
        ctx.set_pending(command, args)
    return None


def scoped_text(ctx: Context) -> str:
    r = ctx.round
    pending = r['pending'] or {}
    command, args = pending.get('command'), pending.get('args')
    lead = (f"Release {r['id']} · Scoped {command} pass (decide.md Release 4) on the revised records {args}: the "
            'corrected record text, each against its sources and the rest of the set. ')
    how = (f'Run the {command} skill now with the argument `{args}` (read its SKILL.md), then report the pass. '
           if ctx.codex else
           "Don't run or report the pass in this turn: the console starts it as its own turn. Finish any other work for "
           'the user, then end the turn without a closing status line. ')
    return lines(lead + how + 'Report each revised record as "unchanged" or a change as in the re-check (a change of your own '
                 "parts rewrites it again; a change to the user's decision drops it; a spread stops the run):",
                 report_hint(ctx, 'scoped', {
                     'pass': command, 'records': {rid: 'unchanged' for rid in revised(ctx)[:1]}
                     | {'<id>': {'change': '<what changed>', 'reach': 'contained', 'why': '<why nothing else moves>',
                                 'touches': 'own', 'file': '<corrected record text, for own>'}},
                     'summary': '<one line: what the pass found>'}))


def scoped_accept(ctx: Context, report: dict) -> str:
    r = ctx.round
    pending = r['pending'] or {}
    command = report.get('pass')
    if command != pending.get('command'):
        fail(f"`pass` is {pending.get('command')}, the scoped pass waiting; the other follows its report")
    if not ctx.codex:  # Codex has no console to observe its runs
        if command not in r['observed']:
            fail(f'no /{command} ran since its last report: the console runs it as its own turn (end your turn), or the '
                 'person types or presses it; a model Skill call counts once it ran')
        if command not in r['scoped']['seen']:
            fail(f"/{command} ran without the revised records as its argument (`{pending.get('args')}`)")
    origin = r['observed'].get(command, 'model')
    raw = report.get('records')
    ids = revised(ctx)
    changed = [rid for rid, value in raw.items() if value != 'unchanged'] if isinstance(raw, dict) else []
    ctx.log('pass', command=command, changes=len(changed), questions=changed, added=[], rejected=0, origin=origin,
            summary=report.get('summary'), scope='release', records=ids,
            kind='scoped', scoped=ids, told='full')  # queued: a refusal drops it
    stopped = apply_changes(ctx, raw, 'records', every=True, scope=ids)
    r['observed'].pop(command, None)
    r['scoped']['seen'] = [one for one in r['scoped']['seen'] if one != command]
    r['scoped']['done'].append(command)  # once per release: a later revision does not re-arm the pair
    r['pending'] = None
    return stopped or 'scoped'


def approval_reasons(ctx: Context) -> list[str]:
    """Why the approval is asked (unsure rulings, revised records, records that left the set): for the model and the Log."""
    return [f"unsure: {x['record']} {x['ruling']}" for x in ctx.round['rulings'] or [] if not x['sure']] + \
           [f"revised: {rec['id']} ({rec['change']})" for rec in ctx.round['set'] if rec['state'] == 'revised'] + \
           [f"left the set: {rec['id']} ({rec['reason']})" for rec in ctx.round['set'] if rec['state'] in ('dropped', 'changed')]


def release_question_text(ctx: Context) -> str:
    """`Release 3 records? Unsure: tstdl-a (…) Revised: tstdl-b (…)`: an unsure ruling first (r14 q56), within the dialog
    limits whatever the set holds; `unsure_rulings` gives it in full."""
    count = plural(len(in_set(ctx)), 'record')
    text = f"Release the session's {count}?" if ctx.round.get('source') else f"Release {count}?"
    unsure = '; '.join(f"{x['record']} ({x['ruling']})" for x in ctx.round['rulings'] or [] if not x['sure'])
    changes = '; '.join(f"{rec['id']} ({cut(rec['change'], 80)})" for rec in ctx.round['set'] if rec['state'] == 'revised')
    return cut(' '.join(filter(None, [text, f'Unsure: {unsure}' if unsure else '', f'Revised: {changes}' if changes else ''])), TEXT_MAX)


def unsure_rulings(ctx: Context) -> str:
    """The unsure rulings in full, for the Release option's preview: the question text cuts them."""
    return '\n\n'.join(f"{x['record']}: {x['ruling']}\nAlternative: {x['alternative']}"
                        for x in ctx.round['rulings'] or [] if not x['sure'])


def approval_question(ctx: Context) -> dict | None:
    return next((q for q in ctx.round['questions'] if q['kind'] == 'confirm-own-rulings'), None)


def approve(ctx: Context, origin: str, how: str, quote: str | None = None) -> str:
    ctx.round['approval'] = {'origin': origin, 'how': how, 'quote': quote, 'at': utcnow()}
    ctx.log('approved', origin=origin, how=how)
    return 'owners'


def approval_enter(ctx: Context) -> str | None:
    """Approval from a person only (r3-q7): a typed or pressed /release-round counts when every own ruling is sure and the set
    is unchanged (r4-q16); otherwise an engine-issued dialog question asks."""
    r = ctx.round
    if r['approval']:
        return 'owners'
    q = approval_question(ctx)
    if q and q['status'] == 'answered':
        if q['answer'] == APPROVE:
            return approve(ctx, q['origin'], 'dialog question', q.get('quote'))
        if q['answer'] == HOLD:
            return stop(ctx, f"held at approval ({q['origin']})", [], hold=True)
        # the user's own words (Codex model-reported) pick no option: ask again
        q.update(status='ready', answer=None, typed=q['answer'])
        ctx.state['answers'].pop(q['id'], None)
        ctx.messages.append(f"The approval needs the user's pick of {APPROVE} or {HOLD}; they wrote \"{q['typed']}\". "
                            'Ask again (`protocol step` with {}).')
        return 'ask'
    changed = [rec['id'] for rec in r['set'] if rec['state'] != 'set']
    unsure = [x for x in r['rulings'] or [] if not x['sure']]
    if r['conditional'] and not changed and not unsure:
        return approve(ctx, r['conditional']['origin'], '/release-round')
    if q is None:
        reasons = approval_reasons(ctx)
        q = {'id': next_id(ctx.state, 'question', 'q'), 'board': None, 'kind': 'confirm-own-rulings', 'multiSelect': False,
             'waitsOn': [], 'for': None, 'settles': [], 'premises': None, 'round': r['id'], 'status': 'draft', 'overlaps': [],
             'searched': True, 'answer': None,
             'text': release_question_text(ctx),
             'title': f'Release {release_label(ctx)}'[:TITLE_MAX], 'header': 'Release',
             'options': [{'label': APPROVE, 'description': 'Owner writes, then board release',
                          **({'preview': unsure_rulings(ctx)} if unsure else {})},
                         {'label': HOLD, 'description': 'Nothing releases; the records stay decided. Say why: a round takes what you held'}],
             'recommendation': APPROVE, 'strength': None, 'strongBecause': None, 'leanBecause': None}
        r['questions'].append(q)
        ctx.log('approval-asked', question=q['id'], reasons=reasons)
    return 'ask'


def approval_text(ctx: Context) -> str:
    reasons = approval_reasons(ctx)
    return f"Release {ctx.round['id']} · Approval: `protocol step` with {{}} continues." \
        + (f" The dialog asks because: {'; '.join(reasons)}." if reasons else '')


def release_ask_accept(ctx: Context, report: dict) -> str:
    if ctx.round['batch']:
        fail(f"waiting on the user's answer to {ctx.round['batch']['marker']}")
    for q in questions(ctx):
        q.pop('typed', None)  # read: the question goes out again
    return 'ask'


def anchors_of(text: str) -> set[str]:
    """GitHub heading slugs (lowercase; punctuation but hyphens and spaces dropped; spaces to hyphens; repeats get
    -1, -2) outside code fences, plus explicit `<a id=…>` and `{#…}` anchors. Mirrors the validator's heading_anchors."""
    found, seen, fenced = set(), {}, False
    for line in text.splitlines():
        if re.match(r'\s*(```|~~~)', line):
            fenced = not fenced
            continue
        if fenced:
            continue
        found.update(re.findall(r'<a\s+(?:id|name)=["\']([^"\']+)["\']', line))
        found.update(re.findall(r'\{#([\w-]+)\}', line))
        heading = re.match(r'#{1,6}\s+(.+?)\s*#*\s*$', line)
        if heading:
            title = re.sub(r'\s*\{#[\w-]+\}\s*$', '', heading.group(1))
            slug = re.sub(r'[^\w\- ]', '', title.strip().lower()).replace(' ', '-')
            count = seen.get(slug, 0)
            seen[slug] = count + 1
            found.add(slug if not count else f'{slug}-{count}')
    return found


def owner_path(ctx: Context, written: str) -> Path:
    """Repo-relative paths resolve from the board's repository root; absolute and ~ or $HOME paths as written."""
    home = env().get('HOME') or str(Path.home())
    if written.startswith('$HOME/') or written == '$HOME':
        written = home + written[5:]
    elif written.startswith('~/') or written == '~':
        written = home + written[1:]
    path = Path(written)
    return path if path.is_absolute() else Path(ctx.board.repo) / path


def git_ignored(ctx: Context, shown: str) -> bool:
    """Whether git ignores a repository-relative owner path (an installed `~`/`$HOME` or absolute path is not checked).
    Without git, or outside a git repository, nothing is ignored: the check is skipped."""
    if shown.startswith(('~', '$HOME', '/')):
        return False
    try:
        return subprocess.run(['git', 'check-ignore', '-q', '--', shown], cwd=ctx.board.repo, capture_output=True).returncode == 0
    except OSError:
        return False


def rule_owner_text(description: str) -> str:
    match = re.search(r'^##\s+Rule owner\s*$(.*?)(?=^##\s|\Z)', description or '', re.M | re.S)
    return match.group(1) if match else ''


def durable_owners(ctx: Context) -> str:
    """project-memory.md's `## Durable owners` section, read from the installed file: where each kind of rule is written."""
    path = Path(env().get('HOME') or str(Path.home())) / '.agents' / 'skills' / 'shared' / 'project-memory.md'
    try:
        match = re.search(r'^## Durable owners\s*$(.*?)(?=^## |\Z)', path.read_text(encoding='utf-8'), re.M | re.S)
    except OSError:
        match = None
    if match is None or not match.group(1).strip():
        return f'Durable owners: the `## Durable owners` section of {path} is missing; read what owns durable docs before writing.'
    return '## Durable owners (project-memory.md)' + match.group(1).rstrip()


def owners_text(ctx: Context) -> str:
    return lines(
        f"Release {ctx.round['id']} · Owner writes (decide.md Release 5): write each rule into its one owner, replacing "
        "the text it supersedes, and name each path (with its anchor) in the record's `## Rule owner` (rewrite the "
        'record with `board record <id> <file>`). A rule a topic\'s design-target doc states is written now, not pending. Report per record its owners: written {path, anchor} (a repo path '
        'from the board root, or absolute/~; installed files by their installed path), none {reason}, or '
        'pending {item} (an open board item).',
        durable_owners(ctx) if first_time(ctx, 'owners') else '',
        *set_rows(ctx),
        report_hint(ctx, 'owners', {'owners': {(in_set(ctx) or ['<id>'])[0]: [{'written': {'path': 'docs/x.md', 'anchor': 'the-rule'}},
                                                                              {'pending': {'item': '<task id>'}}]}}),
    )


def owners_accept(ctx: Context, report: dict) -> str:
    owners = report.get('owners')
    current = in_set(ctx)
    if not isinstance(owners, dict):
        fail('`owners` maps each record to its owner entries')
    problems = [f'no owners for {rid}' for rid in current if not owners.get(rid)]
    problems += [f'{rid} is not in the set' for rid in owners if rid not in current]
    written, pending = {}, {}
    for rid, entries in owners.items():
        for index, entry in enumerate(entries if isinstance(entries, list) else [None]):
            where = f'owners.{rid}[{index}]'
            kind = next(iter(entry), None) if isinstance(entry, dict) and len(entry) == 1 else None
            body = entry.get(kind) if kind else None
            if kind == 'written' and isinstance(body, dict) and isinstance(body.get('path'), str) and body['path'].strip() \
                    and isinstance(body.get('anchor') or '', str):
                written.setdefault(rid, []).append((body['path'].strip(), (body.get('anchor') or '').lstrip('#')))
            elif kind == 'none' and isinstance(body, dict) and str(body.get('reason') or '').strip():
                pass
            elif kind == 'pending' and isinstance(body, dict) and str(body.get('item') or '').strip():
                pending.setdefault(body['item'].strip(), []).append(rid)
            else:
                problems.append(f'{where}: one of {{"written": {{"path", "anchor"?}}}}, {{"none": {{"reason"}}}}, '
                                '{"pending": {"item"}}')
    if problems:
        fail('owner writes: ' + '; '.join(problems))
    for rid, paths in written.items():
        for shown, anchor in paths:
            path = owner_path(ctx, shown)
            resolved = path.resolve()
            if not resolved.is_file():  # the installed state: a rendered, linked file counts as it reads
                problems.append(f'{rid}: {shown} does not exist ({path})')
            elif git_ignored(ctx, shown):
                problems.append(f'{rid}: {shown} is ignored by git (e.g. .scratch): write the rule into a tracked or trackable owner')
            elif anchor and resolved.suffix.lower() not in ('.md', '.markdown'):
                problems.append(f'{rid}: {shown}#{anchor}: anchors name Markdown headings; name the section in words')
            elif anchor and anchor not in anchors_of(resolved.read_text(encoding='utf-8', errors='replace')):
                problems.append(f'{rid}: {shown} has no heading or anchor #{anchor}')
    if pending:
        try:
            found = ctx.board.json('show', *pending, '--json', '--field', 'status')
        except ProtocolError as error:
            found = {}
            problems.append(f"pending items: {error}")
        problems += [f"{', '.join(rids)}: pending item {item} is {(found.get(item) or {}).get('status')}, not open"
                     for item, rids in pending.items() if item in found and found[item].get('status') == 'closed']
    if written:
        texts = ctx.board.json('show', *written, '--json', '--field', 'description')
        for rid, paths in written.items():
            section = rule_owner_text((texts.get(rid) or {}).get('description') or '')
            problems += [f'{rid}: its ## Rule owner does not name {shown}; fix the record text and run '
                         f'`board record {rid} <file>`' for shown, _ in paths if shown not in section]
    if problems:
        fail('owner writes: ' + '; '.join(problems))
    ctx.round['owners'] = owners
    ctx.log('owners-checked', written=sum(len(paths) for paths in written.values()), pending=sorted(pending))
    return 'release'


def statuses(ctx: Context, ids) -> dict[str, str | None]:
    ids = list(dict.fromkeys(ids))
    found = ctx.board.json('show', *ids, '--json', '--field', 'status') if ids else {}
    return {rid: (found.get(rid) or {}).get('status') for rid in ids}


def release_enter(ctx: Context) -> str | None:
    """Runs board release (with the answered closes), then the other supersedes. Resumable (r4-q19): statuses come
    first, and released records, closed questions and done supersedes are not run again."""
    r = ctx.round
    ids = [rec['id'] for rec in r['set'] if rec['state'] in ('set', 'revised', 'released')]  # a rerun keeps the released ones
    fulls = [sup['old'] for sup in r['supersedes'] if sup['partial'] is None]
    now = statuses(ctx, [*ids, *fulls, *r['closes']])
    stray = [rid for rid in ids if now[rid] not in ('decided', 'released')]
    if stray:
        ctx.messages.append('Not released: ' + ', '.join(f'{rid} is {now[rid]}' for rid in stray)
                            + '; settle them on the board, then `protocol step` with {}.')
        return None
    still = [q for q in r['closes'] if now[q] != 'closed']
    if r['retry'] or still or any(now[rid] == 'decided' for rid in ids):
        argv = ['release', *ids, *(['--closes', *(f"{q}={','.join(r['closes'][q])}" for q in still)] if still else [])]
        result = ctx.board.run(*argv)
        r['retry'] = result.returncode != 0
        ctx.log('board-release', records=ids, closes=still, exit=result.returncode)
        if result.returncode != 0:
            ctx.messages.append(f"`board {' '.join(argv)}` exited {result.returncode}:\n"
                                + (result.stderr.strip() or result.stdout.strip()))
    for sup in r['supersedes']:
        key = f"{sup['old']}>{sup['new']}"
        if key in r['done'] or (sup['partial'] is None and now.get(sup['old']) == 'closed'):
            continue
        partial = ['--partial', sup['partial']] if sup['partial'] is not None else []
        result = ctx.board.run('supersede', sup['old'], '--with', sup['new'], *partial)
        if result.returncode == 0:
            r['done'].append(key)
            ctx.log('superseded', old=sup['old'], new=sup['new'], partial=sup['partial'])
        else:
            ctx.messages.append(f"`board supersede {sup['old']} --with {sup['new']}` exited {result.returncode}: "
                                + (result.stderr.strip() or result.stdout.strip()))
    try:  # the writes above stand: a failing read leaves the step to rerun, statuses first
        after = statuses(ctx, [*ids, *fulls, *r['closes']])
    except ProtocolError as error:
        ctx.messages.append(f'Board statuses unavailable after the writes ({error}); `protocol step` with {{}} rereads them.')
        return None
    for rid in ids:
        if after[rid] == 'released':
            set_record(ctx, rid)['state'] = 'released'
    for sup in r['supersedes']:
        if sup['partial'] is None and after.get(sup['old']) == 'closed' and f"{sup['old']}>{sup['new']}" not in r['done']:
            r['done'].append(f"{sup['old']}>{sup['new']}")
    r['outcome'] = {'closed': [q for q in r['closes'] if after[q] == 'closed'],
                    'open': [q for q in r['closes'] if after[q] != 'closed']}
    finished = not r['retry'] and all(after[rid] == 'released' for rid in ids) and not r['outcome']['open'] \
        and all(f"{sup['old']}>{sup['new']}" in r['done'] for sup in r['supersedes'])
    if not finished:
        ctx.messages.append('Release not finished: fix what the board reported, then `protocol step` with {} reruns '
                            'only what remains (released records, closed questions and done supersedes stay done).')
        return None
    ctx.log('release-done', records=ids, closed=r['outcome']['closed'])
    return 'closed'


def release_text(ctx: Context) -> str:
    return f"Release {ctx.round['id']} · Release: waiting for a rerun (`protocol step` with {{}})."


def release_step_accept(ctx: Context, report: dict) -> str:
    return 'release'


def release_closed_enter(ctx: Context) -> None:
    """A release that ran to its close settles what it did to the records: a released one is clear of any drop reason; a
    dropped one, and each record a stop held back, gets one (the next round's Stage shows it, a bare release leaves the record
    out until a round records it again or a release releases it). A person's Hold gives none (r14 q52). An abandoned release
    gets here never."""
    r = ctx.round
    r['pending'], r['batch'] = None, None
    r['closedAt'] = utcnow()
    reasons = ctx.state.setdefault('dropReasons', {})
    stopped = r.get('stopped') or {'reason': None, 'ids': []}
    held_back = [] if stopped.get('hold') else stopped['ids']
    for rec in r['set']:
        if rec['state'] == 'released':
            reasons.pop(rec['id'], None)
        elif rec['state'] == 'dropped' or rec['id'] in held_back:
            reasons[rec['id']] = rec['reason'] if rec['state'] == 'dropped' else stopped['reason']
    if refresh_board(ctx):
        r['countsAt'] = r['closedAt']
    ctx.log('closed', protocol='release', released=[rec['id'] for rec in r['set'] if rec['state'] == 'released'])


def release_closed_text(ctx: Context) -> str:
    r = ctx.round
    counts = ctx.state.get('counts')
    board = (f"Board: {counts['questions']} open questions, {counts['decided']} decided awaiting release, "
             f"{counts['toPlan']} released to plan, {counts['inReview']} in review, {counts['forUser']} waiting on the user."
             if counts and r.get('countsAt') else 'No board counts.')
    if r['stopped'] and r['stopped'].get('hold'):
        return '\n'.join([
            f"Release {r['id']} held: nothing released; the records stay decided and held.",
            'Next: ask what it was held for, then a round on those records, or on the set when the reason spreads to the others '
            '(`protocol start round`; its check loop opens with step-back). A later `protocol start release` takes the rest.', board])
    if r['stopped']:
        ids = ', '.join(r['stopped']['ids'])
        return '\n'.join([
            f"Release {r['id']} stopped: {r['stopped']['reason']}. Nothing released; {ids} stay decided and held.",
            f'Next: a round on {ids} (`protocol start round`, then classify and select them; its check loop opens '
            'with step-back).', board])
    dropped = [rec for rec in r['set'] if rec['state'] == 'dropped']
    outcome = r.get('outcome') or {'closed': [], 'open': []}
    return '\n'.join([
        f"Release {r['id']} closed.",
        *(f"- released {rec['id']}: {rec['title']}" + (f" (revised: {rec['change']})" if rec.get('change') else '')
          for rec in r['set'] if rec['state'] == 'released'),
        *(f"- superseded {sup['old']} by {sup['new']}" + (f" (rule: {sup['partial']})" if sup['partial'] is not None else '')
          for sup in r['supersedes']),
        *(f"- closed {q}: answered by released {', '.join(r['closes'][q])}" for q in outcome['closed']),
        *(f"- dropped {rec['id']} ({rec['reason']}): it stays decided and held for a round" for rec in dropped),
        board,
        'Next (decide.md Release 7): run `protocol next` (what waits on the user, the ranked seeds), recommend the next '
        "round as the cluster asking.md Scope gives, naming its questions, or, when no question round leads, the other "
        'next step by priority and what it unblocks, then report your proposal with '
        '`protocol next --set`.'
        + (f" Dropped records go to a round: {', '.join(rec['id'] for rec in dropped)}." if dropped else '') + ' Wait for the user.',
    ])


ID_WORD = re.compile(r'^[A-Za-z][\w]*-[\w.]+$')


def stamp_release(ctx: Context, origin: str, args: str = '') -> str:
    """A /release-round the person typed or pressed (r4-q16, press: user 2026-10-31): conditional approval of the open
    release, or of the release it starts. Leading id-shaped words after the command name the set; the rest is the
    skill's focus. The stamp lapses when the run stops or its set changes."""
    if origin not in ('composer', 'bridge', 'press'):
        fail(f'release-round: only the person approves (origin composer, bridge or press), not {origin}')
    ids = list(itertools.takewhile(ID_WORD.match, str(args or '').split()))
    r = ctx.round
    if r and r['step'] != 'closed' and r['protocol'] != 'release':
        fail(f"round {r['id']} is open at {r['step']}: the release starts once it closes")
    if not r or r['step'] == 'closed':
        start_release(ctx, ids)
        r = ctx.round
    elif ids and sorted(ids) != sorted(rec['id'] for rec in r['set']):
        fail(f"release {r['id']} is open on {', '.join(rec['id'] for rec in r['set'])}: finish it, or `protocol abandon`, "
             'before releasing other ids')
    if r['approval']:
        return f"Release {r['id']} is approved already."
    r['conditional'] = {'origin': origin, 'at': utcnow()}
    ctx.log('stamped', origin=origin)
    return (f"Release {r['id']}: the /release-round approves it if every own ruling is sure and no record "
            'leaves the set or is revised; otherwise a dialog asks.')


RELEASE = Protocol('release', [
    Step('recheck', recheck_text, recheck_accept),
    Step('board-check', board_check_text, board_check_accept, board_check_enter),
    Step('own-rulings', own_rulings_text, own_rulings_accept),
    Step('scoped', scoped_text, scoped_accept, scoped_enter),
    Step('approval', approval_text, release_ask_accept, approval_enter),
    Step('ask', ask_text, release_ask_accept, ask_enter),
    Step('owners', owners_text, owners_accept),
    Step('release', release_text, release_step_accept, release_enter),
    Step('closed', release_closed_text, None, release_closed_enter),
], after_ask='approval')

PROTOCOLS = {'round': ROUND, 'release': RELEASE}


# Next: the ranked seeds of the next round and the model's stored proposal (decide.md Release 7, Next).

def seeds(ctx: Context, found: dict, position: dict) -> list[dict]:
    """The top open decision questions to start a round from: unblocked, not held by another live session; members of
    an open milestone first, then priority, then the work they hold (`board position`), prerequisites first as in Select."""
    items = (found.get('items') or {}).get('questions') or []
    live, _ = foreign_holds(ctx, items, position)
    member = {}
    for milestone in found.get('milestones') or []:
        scoped = ctx.board.json('health', '--json', '--root', milestone['id'], '--items', 'questions')
        for item in (scoped.get('items') or {}).get('questions') or []:
            member.setdefault(item['id'], milestone['id'])
    holds = {item['id']: item.get('holds') or 0 for item in position.get('questionsHoldingWork') or []}
    pool = [{'key': item['id'], 'id': item['id'], 'title': item.get('title', ''), 'priority': item.get('priority'),
             'blockedBy': [], 'holds': holds.get(item['id'], 0), 'milestone': member.get(item['id'])}
            for item in items if not item.get('blockedBy') and item['id'] not in live]
    ordered = dependency_order(pool, lambda c: (c['milestone'] is None, priority_of(c), -c['holds'], c['key']))
    return ordered[:SEEDS]


def seed_line(seed: dict) -> str:
    return (f"- {seed['id']} · p{priority_of(seed)} · holds {seed['holds']} · "
            + (f"milestone {seed['milestone']}" if seed['milestone'] else 'no milestone') + f" · {seed['title']}")


def proposal_text(proposal: dict | None) -> list[str]:
    if not proposal:
        return ['No proposal stored.']
    rows = [f"{index}. {' '.join(r['ids'])} · {r['title']} · {'compacts first' if r['compact'] else 'keeps the context'} · {r['why']}"
            for index, r in enumerate(proposal['rounds'], 1)]
    return ['Stored proposal' + (' (the first row is the recommended one):' if rows else ':'), *rows,
            *([f"Compact, keeping: {proposal['compact']['keep']}"] if proposal.get('compact') else [])]


def next_text(ctx: Context) -> str:
    """decide.md Release 7: what the next round or step can start from. The open-item list (waiting questions, in_review
    designs, ready milestones, finished epics, what waits on the user) comes whole the first time between compactions, from
    one board read with the seeds; the model's judgment is the recommendation."""
    found, position = read_open(ctx) if ctx.board else ({}, {})
    seeded = seeds(ctx, found, position) if ctx.board else []
    items, elsewhere, waiting = open_items(ctx, found, position) if ctx.board else ([], {}, [])
    return lines(
        f'Seeds for the next round (top {SEEDS} open questions, unblocked, not held by another live session; open-milestone '
        'members first, then priority, then the work they hold):' if ctx.board else 'No board here: no seeds.',
        *([seed_line(seed) for seed in seeded] or (['- none'] if ctx.board else [])),
        items_text(ctx, items, elsewhere, waiting),
        *proposal_text(ctx.state.get('proposal')),
        'Record the proposal with `protocol next --set` (stdin '
        + json_block({'rounds': [{'ids': ['<question id>'], 'title': '<the round in plain words>', 'why': '<why this cluster>',
                                  'compact': False}], 'compact': {'keep': '<what the compaction keeps>'}})
        + f'): at most {PROPOSAL_ROUNDS} rounds, the one that reuses the read context first with compact false, other clusters with '
        'compact true; `compact` is required with a compact round or without rounds.',
    )


def proposal_errors(raw) -> list[str]:
    if not isinstance(raw, dict):
        return ['stdin must be an object with `rounds` and `compact`']
    errors = [f"unknown fields {', '.join(sorted(set(raw) - {'rounds', 'compact'}))}"] if set(raw) - {'rounds', 'compact'} else []
    rounds, compact = raw.get('rounds', []), raw.get('compact')
    if not isinstance(rounds, list):
        return [*errors, '`rounds` must be a list']
    if len(rounds) > PROPOSAL_ROUNDS:
        errors.append(f'`rounds` holds at most {PROPOSAL_ROUNDS}, not {len(rounds)}')
    for index, one in enumerate(rounds):
        where = f'rounds[{index}]'
        if not isinstance(one, dict):
            errors.append(f'{where}: must be an object')
            continue
        if set(one) - {'ids', 'title', 'why', 'compact'}:
            errors.append(f"{where}: unknown fields {', '.join(sorted(set(one) - {'ids', 'title', 'why', 'compact'}))}")
        ids = one.get('ids')
        if not isinstance(ids, list) or not ids or not all(isinstance(i, str) and i.strip() for i in ids):
            errors.append(f'{where}: `ids` needs at least one question id')
        for field, limit in (('title', TITLE_MAX), ('why', TEXT_MAX)):
            if not isinstance(one.get(field), str) or not one[field].strip():
                errors.append(f'{where}: `{field}` must be a non-empty string')
            elif len(one[field]) > limit:
                errors.append(f'{where}: `{field}` is {len(one[field])} characters, longer than {limit}')
        if not isinstance(one.get('compact'), bool):
            errors.append(f'{where}: `compact` must be true or false')
    needs = not rounds or any(isinstance(one, dict) and one.get('compact') is True for one in rounds)
    if compact is None:
        if needs:
            errors.append('`compact` is required with a compact round or without rounds: {"keep": "<what the compaction keeps>"}')
    elif not isinstance(compact, dict) or set(compact) - {'keep'} or not isinstance(compact.get('keep'), str) or not compact['keep'].strip():
        errors.append('`compact` must be {"keep": "<what the compaction keeps>"}')
    return errors


def set_proposal(ctx: Context, report: dict) -> str:
    if ctx.round and ctx.round['step'] != 'closed':
        fail(f"{ctx.round['protocol']} {ctx.round['id']} is open: propose the next rounds once it closes")
    refuse_all([f'next --set: {error}' for error in proposal_errors(report)])
    proposal = {'rounds': [{'ids': [i.strip() for i in one['ids']], 'title': one['title'].strip(), 'why': one['why'].strip(),
                            'compact': one['compact']} for one in report.get('rounds', [])]}
    if report.get('compact'):
        proposal['compact'] = {'keep': report['compact']['keep'].strip()}
    ctx.state['proposal'] = proposal
    ctx.store.log({'round': None, 'event': 'proposed', 'rounds': [one['ids'] for one in proposal['rounds']],
                   'compact': bool(proposal.get('compact'))})
    return '\n'.join(['Stored.', *proposal_text(proposal)])


# Views

def progress(ctx: Context) -> dict:
    """What the console says about the step: Collect's open items and points, Select's candidates, the selection."""
    r = ctx.round
    keys = [i['id'] for i in r['items']] + [p['id'] for p in r['points']]
    return {'items': len(r['items']), 'points': len(r['points']),
            'classified': sum(1 for key in keys if key in r['classes']),
            'candidates': len(candidates(ctx)) if r['step'] == 'select' else None,
            'selected': list(r['selected'])}


def batch_number(marker: str | None) -> str:
    """`round:r6:4` → `4`: the Log and the headline are per round."""
    return (marker or '?').rsplit(':', 1)[-1]


def cut(text: str, limit: int) -> str:
    """At most `limit` characters, cut at a word boundary and ending with `…` when it cut."""
    if len(text) <= limit:
        return text
    head = text[:limit - 1]
    if not text[limit - 1].isspace() and ' ' in head:
        head = head.rsplit(' ', 1)[0]
    return head.rstrip(' ,;:.-') + '…'


def plural(n: int, word: str) -> str:
    return f"{n} {word}{'' if n == 1 else 's'}"


def pass_words(e: dict) -> str:
    """`q3, q5 changed, 1 not applied`, `no change`."""
    ids, added, changes = e.get('questions'), e.get('added'), e.get('changes') or 0
    parts = [f"{', '.join(ids)} changed"] if ids else []
    parts += [f"{', '.join(added)} added"] if added else []
    words = ', '.join(parts) if parts else f'{changes} changes' if changes else 'no change'
    return words + (f", {e['rejected']} not applied" if e.get('rejected') else '')


def classified_words(e: dict) -> str:
    tally = e.get('classes') or {}
    return f"classified {plural(sum(tally.values()), 'point')}" + (': ' + ', '.join(f'{n} {name}' for name, n in tally.items()) if tally else '')


NO_CHANGE = re.compile(r'^\s*no changes?\b[:.]?\s*', re.IGNORECASE)


def pass_label(e: dict) -> str:
    """`ground`, `step-back (path)`, `ground (lean q39 q40)`: the pass and, when it ran as one of the sequence's
    scoped or named kinds, which, with the question or record ids it was scoped to."""
    detail = ' '.join(filter(None, [e.get('kind'), *(e.get('scoped') or [])]))
    return f"{e.get('command')} ({detail})" if detail else str(e.get('command'))


def pass_kind(ctx: Context, command: str) -> tuple[str | None, list[str]]:
    """The kind of the pass about to be reported (path, refine, lean) and the ids it is scoped to; None for a Base-loop,
    challenge or extra pass (one the sequence did not expect)."""
    check = ctx.round['check']
    if check.get('expect') != command:
        return None, []
    if command == 'step-back' and check.get('pathNow'):
        return 'path', rescope_ids(ctx) if check.get('pathScoped') else []
    if check.get('refineNow') == command:
        return 'refine', rescope_ids(ctx) if check.get('refineScoped') else []
    if command == 'ground' and check.get('focusing'):
        return 'lean', [one for one in ((ctx.round['pending'] or {}).get('args') or '').split() if one not in LEAN_LENSES]
    if command == 'challenge-rulings' and check.get('challenge'):
        spec = check['challenge']
        return ('after answers', []) if spec['kind'] == 'answers' else ('raised', spec['ids'])
    return None, []


def log_text(event: dict) -> str | None:
    """One history event in plain words for the console's log, or None for events it leaves out."""
    e, kind = event, event['event']
    ids = lambda key: ', '.join(e.get(key) or []) or 'none'
    said = NO_CHANGE.sub('', e['summary']) if e.get('summary') else ''  # the headline says whether anything changed
    summary = f': {cut(said, 90)}' if said else ''
    return {
        'start': 'release started' if e.get('protocol') == 'release' else 'round started',
        'rechecked': f"re-check: {e.get('unchanged')} unchanged" + (f", {ids('changed')} changed" if e.get('changed') else ''),
        'record-dropped': f"dropped {e.get('record')}: {(e.get('reason') or '')[:80]}",
        'record-revised': f"revised {e.get('record')}: {(e.get('reason') or '')[:80]}",
        'release-stopped': f"stopped: {(e.get('reason') or '')[:90]}",
        'board-checked': f"board check: {plural(e.get('supersedes') or 0, 'supersede')}, {plural(len(e.get('closes') or []), 'answered question')}",
        'own-rulings': f"own rulings: {e.get('rulings')}, {e.get('unsure')} unsure",
        'approval-asked': 'approval asked' + (f": {cut('; '.join(e['reasons']), 90)}" if isinstance(e.get('reasons'), list) and e['reasons'] else ''), 'approved': f"approved ({e.get('origin')}, {e.get('how')})",
        'stamped': f"/release-round ({e.get('origin')}): approves if the checks hold",
        'owners-checked': f"owners checked: {plural(e.get('written') or 0, 'written path')}",
        # a clean release without closes is "released <ids>" (release-done) alone
        'board-release': f"board release {ids('records')}" + (f" closing {ids('closes')}" if e.get('closes') else '') + (f": exit {e.get('exit')}" if e.get('exit') else '')
        if e.get('exit') or e.get('closes') else None,
        'superseded': f"superseded {e.get('old')} by {e.get('new')}", 'release-done': f"released {ids('records')}", 'selected': f"selected {ids('selected')}", 'staged': f"staged {ids('questions')}",
        'related': f"{e.get('question')}: {len(e.get('hits') or [])} related items",
        'pass': f"{pass_label(e)}: {pass_words(e)}{summary}", 'classified': classified_words(e),
        'asked': f"asked {ids('questions')}", 'answered': f"answered {ids('questions')} ({e.get('origin')})" + (f"; typed {ids('typed')}" if e.get('typed') else ''),
        'decline': f"batch {batch_number(e.get('marker'))} {e.get('reason')}", 'restart': f"restarted {ids('questions')}",
        'continued': f"released {ids('questions')} from held: checked again before the next batch", 'cap': f"cycle cap at {e.get('cycle')}", 'cap-decision': f"cap: {e.get('choice')}",
        'batch-withdrawn': f"batch {batch_number(e.get('marker'))} withdrawn for updates", 'recorded': f"recorded {e.get('question')} → {e.get('board') or 'file'}",
        'deferred': f"deferred {e.get('question')}", 'released': f"released {ids('items')}",
        'refused': f"refused {e.get('verb')}: {(e.get('error') or '')[:90]}", 'removed': f"removed {e.get('question')}",
        'edited': f"edited {ids('questions')} (your words)",
        'checking': f"{ids('questions')}: " + ('challenge-rulings on the raised strong mark' if e.get('kind') == 'raised'
                                               else 'checked before they are asked (added or re-recommended)'),
        'closed': 'release closed' if e.get('protocol') == 'release' else 'round closed', 'dropped': f"dropped {ids('questions')} (no longer open on the board)", 'abandoned': f"abandoned at {e.get('step')}",
    }.get(kind)


def recorded_line(events: list[dict]) -> str:
    """Consecutive `recorded` events as one line: `recorded q39, q40 → fx-1, fx-2`, or `→ files` when none reached the board."""
    targets = list(dict.fromkeys(e.get('board') or 'file' for e in events))
    return f"recorded {', '.join(e.get('question') for e in events)} → " + ('files' if targets == ['file'] else ', '.join(targets))


def round_log(ctx: Context) -> list[dict]:
    """The whole round's history in the Log's words (the console shows the last lines and folds the rest)."""
    lines, run = [], []
    path = ctx.store.dir / 'history.jsonl'

    def moment(event: dict) -> str:
        return datetime.strptime(event['at'], '%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=timezone.utc).astimezone().strftime('%H:%M')

    def flush() -> None:
        if run:
            lines.append({'at': moment(run[0]), 'text': recorded_line(run)})
            run.clear()

    for raw in path.read_text(encoding='utf-8').splitlines() if path.is_file() else []:
        with contextlib.suppress(ValueError):
            event = json.loads(raw)
            if event.get('round') != ctx.round['id']:
                continue
            if event['event'] == 'recorded':
                run.append(event)
            elif text := log_text(event):
                flush()
                lines.append({'at': moment(event), 'text': text})
    flush()
    return lines


def stopped_view(r: dict | None) -> dict | None:
    """A stopped release stays visible after it closed, until the next run starts: its records wait for a round."""
    stopped = (r or {}).get('stopped') if (r or {}).get('step') == 'closed' else None
    return {'run': r['id'], 'reason': stopped['reason'], 'ids': stopped['ids']} if stopped else None


def release_takes(waiting: dict) -> str:
    """What a bare release takes, for the closed round's text."""
    return (f"all {plural(waiting['count'], 'decided record')} this session holds, minus dropped ones; "
            'name ids to take fewer')


def release_next(ctx: Context) -> dict | None:
    """The bare release's size as the last board read left it (`refresh_board`); `show` never reads the board."""
    count = ctx.state.get('releasable') or 0
    return {'count': count} if count else None


def next_run(ctx: Context) -> dict | None:
    """What follows a close: the pending release and the model's stored proposal (`protocol next --set`)."""
    proposal = ctx.state.get('proposal') or {}
    release = release_next(ctx)
    found = {**({'release': release} if release else {}), **({'rounds': proposal['rounds']} if proposal.get('rounds') else {}),
             **({'compact': proposal['compact']} if proposal.get('compact') else {})}
    return found or None


def show_json(ctx: Context) -> dict:
    r = ctx.round
    base = {'version': VERSION, 'session': ctx.store.session, 'protocol': None, 'round': None, 'title': None,
            'summary': None, 'step': None,
            'check': None, 'pending': None, 'questions': [], 'batch': None, 'counts': ctx.state.get('counts'),
            'progress': None, 'log': [], 'records': [], 'stopped': stopped_view(r), 'next': None}
    if not r or r['step'] == 'closed':  # contract-rulings R-B3: no open round
        return {**base, 'next': next_run(ctx)}
    check = r['check']
    return {**base, 'protocol': r['protocol'], 'round': r['id'], 'title': r.get('title'), 'summary': r.get('summary'),
            'step': r['step'],
            'check': {'cycle': check.get('cycle', 0), 'cap': check.get('cap', CHECK_CAP), 'last': check.get('last', {})}
            if check.get('expect') else None,
            'pending': pending_view(ctx),
            'questions': [{'id': q['id'], 'board': q['board'], 'text': q['text'], 'title': q['title'], 'kind': q['kind'],
                           'status': q['status'], 'waitsOn': q['waitsOn'], 'settles': q.get('settles') or [], 'overlaps': q['overlaps'],
                           'answer': q['answer'],
                           'answeredAt': q.get('answeredAt') if q['answer'] is not None else None,
                           'changedBy': (r.get('lastPass') or {}).get('pass') if q['id'] in (r.get('lastPass') or {}).get('questions', []) else None,
                           'recommendation': q.get('recommendation'), 'strength': q.get('strength'),
                           'leanBecause': q.get('leanBecause'), 'strongBecause': q.get('strongBecause')}
                          for q in r['questions']],
            'batch': {'marker': r['batch']['marker'], 'questions': r['batch']['questions']} if r['batch'] else None,
            'progress': progress(ctx) if r['protocol'] == 'round' else None, 'log': round_log(ctx),
            # a release run: its records with their state (set, dropped, changed, released) and reason
            'records': [{'id': rec['id'], 'title': rec['title'], 'state': rec['state'], 'reason': rec['reason']}
                        for rec in r.get('set') or []],
            'stopped': None, 'next': None}


def show_markdown(ctx: Context) -> str:
    r = ctx.round
    if not r:
        return 'No round in this session.'
    check = r['check']
    noun = 'Release' if r['protocol'] == 'release' else 'Round'
    lines = [f"# {noun} {r['id']}{' · ' + r['title'] if r.get('title') else ''} · {r['step']}", '',
             *([r['summary'], ''] if r.get('summary') else [])]
    if r.get('set'):
        lines += ['| record | state | title |', '|---|---|---|',
                  *(f"| {rec['id']} | {rec['state']}{' (' + rec['reason'] + ')' if rec['reason'] else ''} | {rec['title']} |"
                    for rec in r['set']), '']
    if check.get('expect'):
        last = ', '.join(f"{k} {v['changes']} ({v['origin']})" for k, v in check.get('last', {}).items()) or 'none yet'
        lines.append(f"Check cycle {check['cycle']}/{check['cap']}; last passes: {last}.")
    if r['pending']:
        lines.append(f"Pending: /{r['pending']['command']} ({r['pending']['id']}).")
    if r['batch']:
        lines.append(f"Batch out: {r['batch']['marker']}.")
    lines += ['', '| id | board | status | kind | question | answer |', '|---|---|---|---|---|---|']
    for q in r['questions']:
        overlap = ''.join(f" (overlaps {h['id']}: {h['outcome'] or 'open'})" for h in q['overlaps'])
        lines.append(f"| {q['id']} | {q['board'] or 'draft'} | {q['status']}"
                     + (f" on {', '.join(q['waitsOn'])}" if q['status'] == 'held' else '')
                     + f" | {q['kind']} | {q['text']}{overlap} | {q['answer'] or ''} |")
    counts = ctx.state.get('counts')
    if counts:
        lines += ['', 'Board: ' + ', '.join(f'{k} {v}' for k, v in counts.items())]
    if r['step'] != 'closed':
        lines += ['', '## Next step', '', instructions(ctx)]  # recovery after compaction: the step's instructions
    return '\n'.join(lines)


def status_line(ctx: Context) -> str:
    r = ctx.round
    if not r or r['step'] == 'closed':
        return 'protocol: no open round'
    tally = {}
    for q in r['questions']:
        tally[q['status']] = tally.get(q['status'], 0) + 1
    parts = [f"{'release' if r['protocol'] == 'release' else 'round'} {r['id']}", r['step']]
    if r['step'] == 'check' and r['check'].get('expect'):
        parts[-1] += f" {r['check']['cycle']}/{r['check']['cap']}"
    if r['pending']:
        parts.append(f"pending /{r['pending']['command']} ({r['pending']['id']})")
    if r['batch']:
        parts.append(f"batch {r['batch']['marker']} out")
    parts.append('questions ' + (', '.join(f'{n} {s}' for s, n in tally.items()) or 'none'))
    if r.get('set'):
        states = {}
        for rec in r['set']:
            states[rec['state']] = states.get(rec['state'], 0) + 1
        parts.append('records ' + ', '.join(f'{n} {state}' for state, n in states.items()))
    parts.append("`protocol show` repeats the step's instructions")
    return 'protocol: ' + ' · '.join(parts)


def history_events(store: Store, everywhere: bool) -> list[dict]:
    files = sorted(state_root().glob('*.protocol/history.jsonl')) if everywhere else [store.dir / 'history.jsonl']
    events = []
    for path in files:
        with contextlib.suppress(FileNotFoundError):
            events += [json.loads(row) for row in path.read_text(encoding='utf-8').splitlines() if row.strip()]
    return events


def history_text(events: list[dict]) -> str:
    rounds: dict[tuple, dict] = {}
    for event in events:
        key = (event.get('session'), event.get('round'))
        if key[1] is None:
            continue
        summary = rounds.setdefault(key, {'passes': {}, 'changed': {}, 'restarts': [], 'declines': 0, 'caps': [],
                                          'answers': {}})
        kind = event['event']
        if kind == 'pass':
            origin = event.get('origin', 'model')
            summary['passes'][origin] = summary['passes'].get(origin, 0) + 1
            if event.get('changes'):
                summary['changed'][origin] = summary['changed'].get(origin, 0) + 1
        elif kind == 'restart':
            summary['restarts'].append(f"{','.join(event.get('questions', []))}" + (f" ({event['reason']})" if event.get('reason') else ''))
        elif kind == 'decline':
            summary['declines'] += 1
        elif kind == 'cap-decision':
            summary['caps'].append(event.get('choice'))
        elif kind == 'answered':
            origin = event.get('origin')
            summary['answers'][origin] = summary['answers'].get(origin, 0) + len(event.get('questions', []))
    if not rounds:
        return 'no protocol history'
    rows = []
    for (session, round_id), s in rounds.items():
        def counts(table):
            return ', '.join(f'{k} {v}' for k, v in sorted(table.items())) or 'none'
        rows.append(f"{session} {round_id}: passes {counts(s['passes'])}; changed something {counts(s['changed'])}; "
                    f"answers {counts(s['answers'])}; declines {s['declines']}; "
                    f"restarts {'; '.join(s['restarts']) or 'none'}; cap {', '.join(s['caps']) or 'not reached'}")
    return '\n'.join(rows)


# Write verbs relayed by the console (and the Codex model-reported path).

def require_origin(ctx: Context, verb: str, origin: str | None) -> None:
    allowed = VERB_ORIGINS.get(verb, ('model',))
    if origin is None and verb not in VERB_ORIGINS:
        return
    if origin not in allowed:
        fail(f"{verb}: origin {origin!r} is not accepted here (accepted: {', '.join(allowed)})")
    if origin == 'model-reported' and not ctx.codex:
        fail(f'{verb}: origin model-reported is the Codex path only; in Claude the console records the dialog, and '
             'an answer typed in chat goes through answer --origin chat with its quote')


def normalized(text: str) -> str:
    return ' '.join(str(text).split())


def chat_answer(ctx: Context, report: dict) -> str:
    """An answer the user typed in chat, mapped by the model: accepted only when its quote appears in a message the
    console relayed from the person after the question went out (a short "yes" from earlier must not count)."""
    qid, text, quote = report.get('question'), report.get('answer'), report.get('quote')
    if not all(isinstance(v, str) and v.strip() for v in (qid, text, quote)):
        fail('answer --origin chat: stdin needs "question" (an id), "answer" and "quote" (the user\'s exact words)')
    q = by_id(ctx, qid)
    if q['status'] not in ('ready', 'asked'):
        fail(f"answer --origin chat: {qid} is {q['status']}, not ready or asked")
    after = ctx.round['messages'][q.get('messagesBefore', 0):]
    if not any(normalized(quote) in normalized(message['text']) for message in after):
        fail('answer --origin chat: quote check failed: the quote appears in no message the user sent since the question '
             'went out')
    batch = ctx.round['batch']
    if batch and qid in batch['ids']:
        index = batch['ids'].index(qid)
        del batch['ids'][index], batch['questions'][index]
        if not batch['ids']:
            ctx.round['batch'] = None
    q.pop('typed', None)
    q.update(status='answered', answer=text, origin='chat', quote=quote, answeredAt=utcnow())
    ctx.state['answers'][qid] = text
    if ctx.round['protocol'] == 'round':
        ctx.round['check']['challenged'] = False  # the answer is news to the last challenge-rulings run
    ctx.log('answered', origin='chat', questions=[qid], quote=quote)
    if ctx.round['step'] == 'ask':
        ctx.go('ask')
    return f'Recorded the chat answer to {qid} with its quote.'


def recommended_index(q: dict) -> int | None:
    """Which option is recommended, by position: renaming its label (with `recommendation` following) is wording."""
    return next((i for i, o in enumerate(q['options']) if o['label'] == q.get('recommendation')), None)


def mark_unchecked(ctx: Context, before: dict[str, tuple]) -> None:
    """What an edit made unchecked (r13 q47, q48), kept out of the batches until hand_over checks it: a new question and a
    changed recommendation (the scoped check), a recommendation raised to strong (one challenge-rulings pass). Wording,
    options, premises, previews and a mark lowered to lean stay free: decide.md says edit applies the user's own words."""
    for qid in ctx.added:
        if by_id(ctx, qid)['status'] == 'draft':
            by_id(ctx, qid)['unchecked'] = 'scoped'
    for qid in ctx.applied:
        q = next((one for one in questions(ctx, 'draft', 'ready') if one['id'] == qid), None)
        if q is None or qid not in before:
            continue
        if recommended_index(q) != before[qid][0]:
            kind = 'scoped'
        elif q.get('strength') == 'strong' and before[qid][1] != 'strong' and q.get('unchecked') != 'scoped':
            kind = 'raised'
        else:
            continue
        q.update(status='draft', unchecked=kind)


def edit_round(ctx: Context, report: dict) -> str:
    """The user's requested change to the questions: the quote must appear in a message the console relayed (or a typed
    dialog text) since the questions it touches went out (the chat-answer check; Codex quotes verbatim). Changes apply
    without a pass and a batch that is out comes back and goes out again, except an edit that only adds questions, which
    leaves it out. A new question or a changed recommendation then gets the scoped check, a raise to strong one
    challenge-rulings pass, before it is asked (`mark_unchecked`): at the hand-over, or at once when nothing else waits."""
    r = ctx.round
    if r['protocol'] != 'round' or r['step'] not in ('related', 'check', 'ask'):
        fail('edit applies to a round between Related and Ask')
    if r['batch'] and r['batch']['cap']:
        fail('answer the cap question first')
    updates, quote = report.get('updates'), report.get('quote')
    if not isinstance(updates, list) or not updates or not isinstance(quote, str) or not quote.strip():
        fail('edit: stdin needs "updates" (per-question updates as in a pass report) and "quote" (the user\'s exact words asking for it)')
    if not ctx.codex:
        floor = min([by_id(ctx, u['id']).get('messagesBefore', 0) for u in updates if isinstance(u, dict) and u.get('id') in
                     {q['id'] for q in r['questions']}] or [0])
        if not any(normalized(quote) in normalized(message['text']) for message in r['messages'][floor:]):
            fail('edit: quote check failed: the quote appears in no message the user sent since the questions it changes went out')
    if r['batch'] and not all(isinstance(u, dict) and 'id' not in u for u in updates):
        ctx.log('batch-withdrawn', marker=r['batch']['marker'], reason='edit')
        batch_back(ctx)
    for q in questions(ctx):
        q.pop('typed', None)
    before = {q['id']: (recommended_index(q), q.get('strength')) for q in questions(ctx)}
    apply_updates(ctx, updates)
    if ctx.rejected and not ctx.applied and not ctx.added:
        fail('no update applied: ' + '; '.join(ctx.rejected))
    if ctx.rejected:
        ctx.messages.append('Not applied (fix and resend these through edit; the others applied): ' + '; '.join(ctx.rejected))
    mark_unchecked(ctx, before)
    touched = list(dict.fromkeys([*ctx.applied, *ctx.added]))
    r['lastPass'] = {'pass': 'edit', 'questions': touched}  # rows read "↻ edit"
    ctx.log('edited', questions=touched, rejected=len(ctx.rejected), quote=quote)
    if r['step'] != 'ask':
        # Before Ask the check takes them: not started yet, it covers them; under way, a scoped check restarts it and a raise
        # re-arms the round's challenge-rulings.
        scoped, waiting = bool(unchecked(ctx, 'scoped')), take_unchecked(ctx)
        if waiting and r['check'].get('expect'):
            if scoped:
                rescope_check(ctx, waiting)
            else:
                r['check']['challenged'] = False
    return r['step']


def open_batch(ctx: Context, marker) -> dict:
    r = ctx.round
    if not r or r['step'] == 'closed':
        fail('no open round')
    if not r['batch']:
        fail('no batch is out')
    if marker != r['batch']['marker']:
        fail(f"marker {marker!r} is not the issued batch {r['batch']['marker']}")
    return r['batch']


def batch_back(ctx: Context) -> None:
    for qid in ctx.round['batch']['ids']:
        by_id(ctx, qid)['status'] = 'ready'
    ctx.round['batch'] = None


def decline(ctx: Context, report: dict, origin: str, reason: str) -> str:
    batch = open_batch(ctx, report.get('marker'))
    partial = report.get('partial') or {}
    if not isinstance(partial, dict):
        fail('`partial` must map question texts to answers, or be null')
    batch_back(ctx)
    ctx.log('decline', marker=batch['marker'], origin=origin, reason=reason, partial=partial or None)
    if batch['cap']:
        ctx.round['check']['paused'] = True  # nothing decided: the loop waits for the user
    note = f"Batch {batch['marker']} {reason}: nothing recorded; its questions are back to ready."
    if partial:
        note += (' Answers given inside the declined batch (confirm them in the next batch, do not record them): '
                 + '; '.join(f'{text!r}: {answer!r}' for text, answer in partial.items()))
    return note + (' Ask the user what to change, or `protocol step` with {} to ask again.' if not batch['cap']
                   else ' The check loop is paused: `protocol resume` continues it.')


def cap_decision(ctx: Context, answer: str, origin: str) -> str:
    choice = next((c for c in CAP_CHOICES if answer.strip().lower().startswith(c.lower())), None)
    ctx.round['batch'] = None
    check = ctx.round['check']
    ctx.log('cap-decision', choice=choice or answer, origin=origin)
    if choice is None:
        check['paused'] = True
        return f'The user answered the cap question in their own words: "{answer}". Loop paused; act on it, then ' \
               '`protocol resume` or restart questions.'
    if choice == 'Continue':
        check['cap'] = check['cycle'] + CHECK_CAP
        next_cycle(ctx)
        return 'Continue: more check cycles.'
    if choice == 'Pause':
        check['paused'] = True
        return 'Paused: `protocol resume` continues the check loop.'
    check['askNow'] = True
    ctx.go(gate_ask(ctx))
    return 'Ask now: the questions go out as they stand.'


def option_pick(q: dict, value: str) -> str | None:
    """The answer as the option label(s) it picks, the dialog's recommended mark removed; None for typed text."""
    labels = {o['label'] for o in q['options']}
    parts = [part.strip().removesuffix(recommended_suffix(q)) for part in (value.split(', ') if q['multiSelect'] else [value])]
    return ', '.join(parts) if value and all(part in labels for part in parts) else None


def answer(ctx: Context, report: dict, origin: str) -> str:
    if origin == 'chat':
        return chat_answer(ctx, report)
    if report.get('afkTimeoutMs'):
        return decline(ctx, {'marker': report.get('marker'), 'partial': None}, origin, 'resolved itself (timeout)')
    batch = open_batch(ctx, report.get('marker'))
    answers = report.get('answers') or {}
    if not isinstance(answers, dict) or not all(isinstance(v, str) for v in answers.values()):
        fail('`answers` must map question texts to answer strings')
    texts = {q['question']: (batch['ids'][i] if not batch['cap'] else None) for i, q in enumerate(batch['questions'])}
    unknown = [text for text in answers if text not in texts]
    if unknown:
        fail(f'not a question of {batch["marker"]}: {unknown[0]!r}')
    if batch['cap']:
        if not answers:
            fail('the cap question has no answer')
        note = cap_decision(ctx, next(iter(answers.values())), origin)
        return note
    now = utcnow()
    done, typed, noted = [], [], []
    for text, qid in texts.items():
        q = by_id(ctx, qid)
        value = (answers.get(text) or '').strip()
        pick = option_pick(q, value)
        if pick is None and value and origin != 'dialog':
            pick = value  # model-reported (Codex): the user's quoted words, read at Record
        if pick is not None:
            annotation = (report.get('annotations') or {}).get(text)
            q.update(status='answered', answer=pick, origin=origin, answeredAt=now, annotations=annotation)
            ctx.state['answers'][qid] = pick
            done.append(qid)
            if isinstance(annotation, dict) and str(annotation.get('notes') or '').strip():
                noted.append(f'{qid}: picked "{pick}" with the note "{annotation["notes"].strip()}".')
        else:
            q['status'] = 'ready'
            if value:  # typed instead of a pick: the model reads it before the question goes out again
                q['typed'] = value
                ctx.round['messages'].append({'text': value, 'origin': origin, 'at': now})
                typed.append(qid)
    ctx.round['batch'] = None
    if done and ctx.round['protocol'] == 'round':
        ctx.round['check']['challenged'] = False  # the answers are news to the last challenge-rulings run
    response = report.get('response')
    ctx.log('answered', marker=batch['marker'], origin=origin, questions=done, typed=typed, response=response)
    notes = [f"Recorded answers to {', '.join(done) or 'no question'} ({origin})."]
    notes += [*noted, 'A note that states a criterion restarts its question (`protocol restart <id>`); otherwise the '
              'record carries it.'] if noted else []
    for qid in typed:
        notes.append(f'{qid}: the user typed "{by_id(ctx, qid)["typed"]}" instead of picking an option. Read it before '
                     f'{qid} goes out again: an option → the ["answer"] call with that text as quote; a criterion → '
                     f'`protocol restart {qid}`; a change to the questions → `protocol edit` (updates + the quote); another request '
                     f'(explain, step back, ground, …) → run it on {qid}, then `protocol step` with {{}} (or the pass report) asks it again.')
    if response:
        ctx.round['responses'].append({'marker': batch['marker'], 'text': response, 'origin': origin})
        notes.append(f'The user also wrote: "{response}" — not assigned to any question: it may state a criterion '
                     '(restart the affected questions) or ask for clarification.')
    unanswered = [qid for qid in batch['ids'] if qid not in done and qid not in typed]
    if unanswered:
        notes.append(f"Unanswered, back to ready: {', '.join(unanswered)}.")
    if report.get('followUp'):
        notes.append('The user asked for another round of questions: ask what they want asked, and stage it '
                     '(a criterion restarts the affected questions).')
    ctx.go('ask')
    return ' '.join(notes)


def restart(ctx: Context, ids: list[str], reason: str | None) -> None:
    r = ctx.round
    if r and r['protocol'] == 'release' and r['step'] != 'closed':
        fail('restart is a round verb: in a release, a criterion holds the set (answer Hold, or `protocol abandon`) '
             'and the next round restarts it')
    if not r or r['step'] in ('collect', 'select', 'stage', 'closed'):
        fail('restart needs an open round past Stage')
    targets = [by_id(ctx, qid) for qid in ids]
    if r['batch'] and not r['batch']['cap']:
        batch_back(ctx)
    for q in targets:
        if q.get('recorded'):
            fail(f"{q['id']} is recorded; a later change is a new question (board revise)")
        if q['answer'] is not None:
            ctx.state['answers'].pop(q['id'], None)
        q.pop('typed', None)
        q.update(answer=None, status='draft')
    for q in questions(ctx, 'draft', 'held', 'ready'):
        q['status'] = premise_status(ctx, q)
    ctx.log('restart', questions=ids, reason=reason)
    r['batch'] = None
    r.pop('held', None)
    rescope_check(ctx, [*ids, *take_unchecked(ctx)])
    ctx.messages.append(f'A restart that widens the round: list the open items with `{LIST_COMMAND}`.')
    ctx.go('check')


def prune(current: Store) -> None:
    """Deletes other sessions' protocol folders without an open round once nothing in them changed for PRUNE_DAYS
    (records live with the board or in the round's named folder, never here)."""
    cutoff = datetime.now(timezone.utc).timestamp() - timedelta(days=PRUNE_DAYS).total_seconds()
    for folder in state_root().glob('*.protocol'):
        if folder == current.dir or not folder.is_dir():
            continue
        try:
            if max((f.stat().st_mtime for f in folder.rglob('*')), default=folder.stat().st_mtime) > cutoff:
                continue
            state = json.loads((folder / 'state.json').read_text(encoding='utf-8'))
        except (OSError, ValueError):
            continue  # unreadable: leave it for a person to look at
        if (state.get('round') or {}).get('step') in (None, 'closed'):
            shutil.rmtree(folder, ignore_errors=True)


# CLI

def read_stdin() -> dict:
    source = _call.get().stdin
    text = source if isinstance(source, str) else '' if source is None or source.isatty() else source.read()
    if not text.strip():
        return {}
    try:
        value = json.loads(text)
    except ValueError as error:
        fail(f'stdin is not JSON: {error}')
    if not isinstance(value, dict):
        fail('stdin must be a JSON object')
    return value


def next_words(ctx: Context) -> str | None:
    """Where the round goes next, in the headline's words; None once it closed."""
    r = ctx.round
    if r['step'] == 'closed':
        if r['protocol'] == 'release':
            return f"a round on {', '.join(r['stopped']['ids'])}" if r.get('stopped') else None
        return 'release (/release-round or ask)' if release_next(ctx) else None
    if r['batch']:
        return 'your call on the cycle cap' if r['batch']['cap'] else f"your answers (batch {batch_number(r['batch']['marker'])})"
    if r.get('held'):
        return 'your resent pass report (part of the last was not applied)'
    if r['step'] == 'check':
        check = r['check']
        if check.get('paused'):
            return 'check paused; `protocol resume` continues'
        if check.get('challenge'):
            return 'challenge-rulings ' + ('after the last answer' if check['challenge']['kind'] == 'answers' else 'on the raised strong ' + ' '.join(check['challenge']['ids']))
        if check['expect'] == 'challenge-rulings':
            return 'challenge-rulings, last before asking'
        return f"{check['expect']}{', path pass' + (' ' + ' '.join(rescope_ids(ctx)) if check.get('pathScoped') else '') if check.get('pathNow') else ', refine pass' + (' ' + ' '.join(rescope_ids(ctx)) if check.get('refineScoped') else '') if check.get('refineNow') else ', lean pass' if check.get('focusing') else ''}, cycle {check['cycle']}/{check['cap']}"
    if r['step'] == 'scoped' and r['pending']:
        return f"{r['pending']['command']} pass on the revised {r['pending']['args']}"
    if r['step'] == 'collect':
        return 'classify ' + ' and '.join(plural(len(r[key]), key[:-1]) for key in ('points', 'items') if r[key])
    return {'select': 'select', 'stage': 'stage the questions', 'related': 'resolve related items',
            'ask': 'the next batch', 'record': 'record the answers', 'recheck': 're-check the records',
            'board-check': 'the board check', 'own-rulings': 'your own rulings', 'owners': 'owner writes',
            'release': 'rerun the release'}.get(r['step'], r['step'])


def headline(ctx: Context) -> str:
    """The output's first line, which the console shows as the call's chat row: this call's events in the Log's
    words (log_text), then where the round goes next."""
    words, recorded = [], []
    for event in ctx.store.pending:
        if event['event'] == 'recorded':
            if not recorded:
                words.append(None)  # keeps the place of the merged "recorded q1, q2"
            recorded.append(event['question'])
        elif text := log_text(event):
            words.append(text)
    words = [f"recorded {', '.join(recorded)}" if word is None else word for word in words]
    upcoming = next_words(ctx)
    r = ctx.round
    label = f"{r['id']} release · {r['title']}" if r['protocol'] == 'release' else r['id']  # `r5 release · the session's records`
    return ' · '.join([label, *words, *([f'next: {upcoming}'] if upcoming else [])])


def instructions(ctx: Context) -> str:
    r = ctx.round
    text = PROTOCOLS[r['protocol']].steps[r['step']].text(ctx)
    return '\n'.join([headline(ctx), *ctx.messages, text])


def drop_closed_carried(ctx: Context) -> None:
    """The board owns whether a held board question still exists; the carried copy only keeps its draft. Questions
    another session closed, decided or released since are dropped."""
    carried = [q for q in ctx.state['carried'] if q['board']]
    if not carried or not ctx.board:
        return
    found = ctx.board.json('show', *(q['board'] for q in carried), '--json', '--field', 'status')
    gone = [q for q in carried if (found.get(q['board']) or {}).get('status') != 'open']
    if not gone:
        return
    for q in gone:
        ctx.state['carried'].remove(q)
    ctx.log('dropped', questions=[q['id'] for q in gone])
    ctx.messages.append('Dropped held questions no longer open on the board: ' + ', '.join(
        f"{q['id']} {q['board']} ({(found.get(q['board']) or {}).get('status') or 'missing'})" for q in gone) + '.')


def start(ctx: Context, name: str, report: dict, scope: str = 'board', records: Path | None = None,
          ids: list[str] | None = None) -> None:
    if ctx.round and ctx.round['step'] != 'closed':
        fail(f"{ctx.round['protocol']} {ctx.round['id']} is open at {ctx.round['step']}: finish it, or `protocol abandon`"
             + (' (for a question to the user, abandon it: nothing is released, and `protocol start release` takes the same '
                'records again)' if ctx.round['protocol'] == 'release' else ''))
    if name == 'release':
        if scope != 'board' or records is not None or report:
            fail('start release takes record ids only (no --discussion, --no-board or stdin)')
        start_release(ctx, ids or [])
        return
    if ids and (scope != 'board' or ctx.board is None):
        fail('start round <ids> names open board items: not with --discussion or --no-board')
    if ctx.board is None and records is None:
        fail('no board here: name the records folder with `start round --no-board <dir>`')
    ctx.state.pop('proposal', None)  # a round starts from its proposal or without one: the next proposal is made after it
    forget_cycles(ctx)
    ctx.state['round'] = {'id': next_id(ctx.state, 'round', 'r'), 'protocol': name, 'step': 'collect',
                          'startedAt': utcnow(), 'repo': ctx.board.repo if ctx.board else None, 'scope': scope,
                          'records': str(records.resolve()) if records else None, 'items': [],
                          'named': list(dict.fromkeys(ids or [])),
                          'points': [], 'classes': {}, 'selected': [], 'questions': [], 'check': {}, 'pending': None,
                          'observed': {}, 'batch': None, 'batchSeq': 0, 'responses': [], 'messages': []}
    ctx.log('start', protocol=name, repo=ctx.state['round']['repo'], scope=scope, named=ctx.round['named'] or None)
    drop_closed_carried(ctx)
    for point in report.get('points') or []:
        ctx.round['points'].append({'id': next_id(ctx.state, 'point', 'pt'), 'text': str(point)})
    ctx.go('collect')


class Exit(Exception):
    def __init__(self, status: int, stderr: str = ''):
        self.status, self.stderr = status, stderr


class Parser(argparse.ArgumentParser):
    """argparse that reports into the current call (stdout/stderr buffers, `Exit`) instead of the process."""

    def __init__(self, **kwargs):
        if sys.version_info >= (3, 14):
            kwargs.setdefault('color', False)  # usage text must not depend on the terminal
        super().__init__(**kwargs)

    def print_help(self, file=None):
        _call.get().stdout.append(self.format_help())

    def print_usage(self, file=None):
        _call.get().stdout.append(self.format_usage())

    def exit(self, status=0, message=None):
        raise Exit(status, message or '')

    def error(self, message):
        raise Exit(2, self.format_usage() + f'{self.prog}: error: {message}\n')


def main(argv: list[str] | None = None) -> int:
    code, out, err = run_cli(sys.argv[1:] if argv is None else argv, os.environ, Path.cwd(), sys.stdin)
    sys.stdout.write(out)
    sys.stderr.write(err)
    return code


def run_cli(argv: list[str], env: Mapping[str, str], cwd: Path, stdin) -> tuple[int, str, str]:
    """The CLI as a function: (exit code, stdout, stderr). stdin is the JSON text or a file object."""
    call = Call(env, Path(cwd), stdin)
    token = _call.set(call)
    try:
        code = cli(argv)
    except Exit as stop:
        call.stderr.append(stop.stderr)
        code = stop.status
    finally:
        _call.reset(token)
    return code, ''.join(call.stdout), ''.join(call.stderr)


def cli(argv: list[str]) -> int:
    # No abbreviations: `--orig dialog` must not pass as --origin (person origins are refused by exact name).
    parser = Parser(prog='protocol', description=__doc__.split('\n\n')[0], allow_abbrev=False)
    parser.add_argument('--session', help='session id (the console passes it); default: CODEX_THREAD_ID, else the '
                                          'registered session of this environment')
    parser.add_argument('--origin', dest='global_origin', help='who caused the call (also accepted after the verb)')
    origin = Parser(add_help=False, allow_abbrev=False)
    origin.add_argument('--origin', help='who caused the call: answer dialog|chat|model-reported, decline '
                                         'dialog|model-reported, pass composer|bridge|press|plugin|model, say '
                                         'composer|bridge; other verbs model')
    commands = parser.add_subparsers(dest='command', required=True)

    def verb(name: str, text: str):
        return commands.add_parser(name, help=text, parents=[origin], allow_abbrev=False)

    sub = verb('start', 'open a protocol run; stdin {"points": [...]} adds pasted points')
    sub.add_argument('name', choices=sorted(PROTOCOLS))
    sub.add_argument('ids', nargs='*', help="release: the decided records (default: the decided records this session holds, "
                                            "minus dropped ones); round: the open items to look at first (default: the whole list)")
    sub.add_argument('--discussion', action='store_true',
                     help="the pasted points alone (question-me): no board list at Collect; board items join through Related")
    sub.add_argument('--no-board', metavar='DIR', type=Path,
                     help="a topic outside this repository's board: no board reads or writes; records go to DIR")
    verb('step', "submit the current step's report (stdin JSON); prints the next step")
    verb('answer', 'record answers (stdin JSON); prints show --json with a note')
    verb('decline', 'a declined batch returns to ready (stdin JSON); prints show --json')
    verb('pass', 'a pass started, or the person typed or pressed /release-round (stdin {"command","args","pending"}); prints '
                 'show --json')
    verb('edit', "apply the user's requested change to the questions (stdin {\"updates\", \"quote\"}); no pass for wording, options "
                 "or a mark lowered to lean; a new question or changed recommendation gets the scoped check, a raise to strong one challenge")
    verb('say', "store the person's message for the chat quote check (stdin {\"text\"})")
    sub = verb('restart', 'questions back to draft after a criterion answer; the check loop reruns')
    sub.add_argument('ids', nargs='+')
    sub.add_argument('--reason')
    sub = verb('next', 'the seed questions of the next round and the stored proposal; --set stores the proposal (stdin)')
    sub.add_argument('--set', action='store_true', help='store the proposal: stdin {"rounds": [{"ids", "title", "why", "compact"}], '
                                                        '"compact": {"keep"}}')
    verb('compacted', "the session's context was compacted: what it was told prints in full again")
    verb('resume', 'continue a paused check loop')
    verb('abandon', 'close the open round without records')
    sub = verb('show', 'the round as markdown, or --json (the console contract)')
    sub.add_argument('--json', action='store_true')
    verb('pending', 'the pending pass as JSON, or null')
    sub = verb('status', 'one recovery line')
    sub.add_argument('--line', action='store_true', required=True)
    sub = verb('history', 'passes by origin, answers, declines, restarts per round')
    sub.add_argument('--all', action='store_true', help='every session in the state dir')
    sub.add_argument('--json', action='store_true', help='the raw events')
    args = parser.parse_args(argv)
    args.origin = args.origin or args.global_origin
    if args.command in VERB_ORIGINS and not args.origin:
        parser.error(f'{args.command} needs --origin')

    try:
        session, entry = resolve_session(args.session)
        store = Store(session)
        write = args.command not in ('show', 'pending', 'status', 'history')  # `next` saves the board's release count
        with store.locked(write):
            state = store.load()
            open_round = state.get('round') if (state.get('round') or {}).get('step') not in (None, 'closed') else None
            if open_round:
                repo = open_round.get('repo')  # the round keeps the board it started on, or none (--no-board)
            elif args.command == 'start' and args.no_board is not None:
                repo = None
            else:
                repo = str(board_root(_call.get().cwd)) if board_root(_call.get().cwd) else None
            board = Board(repo, entry.get('actor') or session[-8:]) if repo else None
            ctx = Context(store, state, entry, board)
            require_origin(ctx, args.command, args.origin)
            output = run(ctx, args)
            if write:
                store.save(state)
                store.flush()
        _call.get().stdout.append(output + '\n')
        return 0
    except ProtocolError as error:
        _call.get().stderr.append(lines(f'protocol: {error}', error.formats) + '\n')
        log_refusal(args, error)
        return 1
    except Exit:
        raise
    except Exception as error:  # a defect: nothing was saved; say so instead of a stack trace
        message = f'internal error ({type(error).__name__}: {error}); nothing was saved'
        _call.get().stderr.append(f'protocol: {message}\n')
        log_refusal(args, ProtocolError(message))
        return 1


def log_refusal(args, error: ProtocolError) -> None:
    """Refused calls go to the history (the state stays unchanged): friction /retro and the pane's log can see."""
    with contextlib.suppress(ProtocolError, OSError, ValueError):
        session, _ = resolve_session(args.session)
        store = Store(session)
        if (store.dir / 'state.json').is_file():
            round_id = (json.loads((store.dir / 'state.json').read_text(encoding='utf-8')).get('round') or {}).get('id')
            store.log({'round': round_id, 'event': 'refused', 'verb': args.command, 'error': str(error)[:300]})
            store.flush()


def run(ctx: Context, args) -> str:
    command = args.command
    if command == 'show':
        ctx.complete = True  # the model asked: everything, whatever it was told
        return json.dumps(show_json(ctx), indent=1, ensure_ascii=False) if args.json else show_markdown(ctx)
    if command == 'pending':
        return json.dumps(pending_view(ctx))
    if command == 'compacted':
        ctx.state['told'] = []
        ctx.store.log({'round': (ctx.round or {}).get('id'), 'event': 'compacted'})
        return 'Compaction recorded: the next steps print their full text again.'
    if command == 'status':
        return status_line(ctx)
    if command == 'history':
        events = history_events(ctx.store, args.all)
        return '\n'.join(json.dumps(e, ensure_ascii=False) for e in events) if args.json else history_text(events)
    if command == 'next' and not args.set:
        if ctx.board:
            refresh_board(ctx)
        return '\n'.join([*ctx.messages, next_text(ctx)])
    report = read_stdin()
    if command == 'next':
        return set_proposal(ctx, report)
    if command == 'start':
        start(ctx, args.name, report, 'discussion' if args.discussion else 'board', args.no_board, args.ids)
        prune(ctx.store)
        return instructions(ctx)
    if command == 'pass' and report.get('command') == 'release-round':
        note = stamp_release(ctx, args.origin, report.get('args') or '')
        ctx.messages.insert(0, note)
        ctx.complete = True  # the console does not forward this note: nothing here counts as told
        return json.dumps({**show_json(ctx), 'note': instructions(ctx)}, indent=1, ensure_ascii=False)
    r = ctx.round
    if not r or r['step'] == 'closed':
        fail('no open round: protocol start round')
    if command == 'step':
        step = PROTOCOLS[r['protocol']].steps[r['step']]
        before = copy.deepcopy(ctx.state)
        try:
            ctx.go(step.accept(ctx, report))
        except ProtocolError as error:
            raise ProtocolError(str(error), formats=refused_formats(ctx, step, report, before)) from None
        return instructions(ctx)
    if command == 'edit':
        try:
            ctx.go(edit_round(ctx, report))
        except ProtocolError as error:
            raise ProtocolError(str(error), formats=f'Edit format: `protocol edit` with stdin {EDIT_STDIN}.') from None
        return instructions(ctx)
    if command == 'say':
        if not isinstance(report.get('text'), str) or not report['text'].strip():
            fail('say: stdin needs {"text"}')
        r['messages'].append({'text': report['text'], 'origin': args.origin, 'at': utcnow()})
        return json.dumps({**show_json(ctx), 'note': None}, indent=1, ensure_ascii=False)
    if command in ('answer', 'decline'):
        try:
            note = answer(ctx, report, args.origin) if command == 'answer' else decline(ctx, report, args.origin, 'declined')
        except ProtocolError as error:
            raise ProtocolError(str(error), formats=f'Chat answer format: stdin {CHAT_STDIN}.' if args.origin == 'chat' else '') from None
        ctx.messages.insert(0, note)
        if args.origin != 'dialog':  # the model reads this result: the note alone (the console's dialog path reads the state)
            return instructions(ctx)
        return json.dumps({**show_json(ctx), 'note': instructions(ctx)}, indent=1, ensure_ascii=False)
    if command == 'pass':
        pass_command = report.get('command')
        if pass_command not in PASSES:
            fail(f"`command` must be one of {', '.join(PASSES)}")
        # Observation only: the pending pass stays until its report (`step`), so the console can tell a pass turn
        # that ended without one.
        r['observed'][pass_command] = args.origin
        count_pass_args(ctx, pass_command, report.get('args') or '')
        told = 'reminder' if args.origin == 'plugin' and r['pending'] and r['pending']['id'] == report.get('pending') \
            and pass_reminder(ctx, pass_command) else 'full'  # only the console's own run swaps in the reminder
        r.setdefault('given', {})[pass_command] = told  # what this run got, for the `told` log
        ctx.log('pass-start', command=pass_command, args=report.get('args') or '', origin=args.origin,
                pending=report.get('pending'), told=told)
        return json.dumps({**show_json(ctx), 'note': None}, indent=1, ensure_ascii=False)
    if command == 'restart':
        restart(ctx, args.ids, args.reason)
        return instructions(ctx)
    if command == 'resume':
        check = r['check']
        if r['step'] != 'check' or not check.get('paused'):
            fail('the check loop is not paused')
        check.update(paused=False, cap=check['cycle'] + CHECK_CAP)
        if r['batch'] and r['batch']['cap']:
            r['batch'] = None
        next_cycle(ctx)
        return instructions(ctx)
    if command == 'abandon':
        if r['batch']:
            batch_back(ctx)
        r['pending'] = None
        ctx.log('abandoned', step=r['step'])
        if r['protocol'] == 'release':  # the records stay decided and held
            r['step'], r['closedAt'] = 'closed', utcnow()
            return '\n'.join([headline(ctx), *ctx.messages, f"Release {r['id']} abandoned at its step; nothing released, "
                              'the records stay decided and held; `protocol start release` takes them again.'])
        release_claims(ctx)
        r['step'] = 'closed'
        r['closedAt'] = utcnow()
        if ctx.board and any(q.get('recorded') not in (None, 'deferred', 'file') for q in r['questions']):
            refresh_board(ctx)  # records written before the abandon are decided and held
        ctx.state['carried'] += [q for q in r['questions'] if q['status'] == 'held']
        return '\n'.join([headline(ctx), *ctx.messages, f"Round {r['id']} abandoned at its step; nothing recorded."])
    fail(f'unknown command {command}')


if __name__ == '__main__':
    raise SystemExit(main())
