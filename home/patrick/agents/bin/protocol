#!/usr/bin/env python3
"""protocol: the protocol engine for deciding sessions. The engine is the protocol_engine package beside this file;
protocol_engine/cli.py holds the overview."""
import sys
from pathlib import Path

sys.dont_write_bytecode = True  # sessions run the engine from the git tree: no __pycache__ beside it
# The package beside the resolved file: through a symlink, a copied install and a SourceFileLoader load (no bin on sys.path).
sys.path.insert(0, str(Path(__file__).resolve().parent))

from protocol_engine.cli import main  # noqa: E402

if __name__ == '__main__':
    raise SystemExit(main())
