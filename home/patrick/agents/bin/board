#!/usr/bin/env python3
"""board: the agents' interface to a beads board (bd 1.3.1).

Run inside the repository. Each command reads the snapshot its view needs
(`Board.load`): non-closed items for status views, `bd export` where closed
items or comments are read, only the named items for `board show`.
`board bd <args>` runs any other bd command (raw item
reads excepted: `board show` renders them within the read budget). Every bd call carries the caller's
actor (`derived_actor`) and, on a server-mode board, finds the server running.

Routing: `ROLE_KINDS` and `Board.kind` route a bare claim; what a claim by id
does not enforce is in skills/shared/board-core.md#routing.

A board is shared only by board's own mark (`MARK_FILE`), which `board share` and `board join` write: every command pulls
first when due, a detached `board _sync-wait` sends writes, and views filter to the caller's queue (`Board.listed`). A board
without the mark runs none of that, whatever Dolt remotes it has.
"""
from __future__ import annotations

import argparse
import atexit
import contextlib
import fcntl
import io
import itertools
import json
import math
import os
import re
import shutil
import shlex
import signal
import socket
import subprocess
import sys
import tempfile
import time
import tomllib
from datetime import datetime, timedelta, timezone
from pathlib import Path

HOLDS_LEGEND = 'holds a/b: a stops at a milestone, b counts everything downstream'
IDLE_HOURS = 1  # holds without activity (holder's tool call, else item update) for longer are hinted as idle
WORKER_CAP = 3  # workers a session targets unless registered with its own (activate --workers); Codex thread limits lower it
WORKER_ACTIVE_MINUTES = 15  # a running worker with a tool call this recently counts as active
CODEX_SYSTEM_CONFIG = Path('/etc/codex/config.toml')  # Codex's system layer, under $CODEX_HOME/config.toml
CAPACITY_ROLES = ('agent', 'solo', 'autopilot')  # roles that dispatch workers
WORKER_KINDS = ('design', 'implement', 'review')  # kinds workers take; an agent's pulls narrow them
ROWS = 50  # rows per view section unless --limit (0: all)
READ_BUDGET = 35_000  # characters per command output; Codex cuts a call's output above ~40,000 from the middle
PREVIEW = 600  # characters a cut section still prints
SHOWN_COMMENTS = 3
SESSION_HOURS = 24  # position lists sessions of this project active or registered this recently (plus any holding items)
PULLS = ('plan', 'design', 'implement', 'review')
KINDS = (*PULLS, 'question', 'accept', 'ratify', 'milestone')
WORK_TYPES = ('task', 'bug', 'spike')
# Kinds a bare `board claim` takes per role (agent: its pulls).
ROLE_KINDS = {'lead': ('question',), 'agent': None, 'solo': ('question', 'plan', 'ratify', 'accept'),
              'autopilot': ('question', 'plan', 'accept')}
# Kinds each role handles, by bare claim or by id; `board position` counts sessions from these.
# A ready milestone is accepted with the user: claimed by id only, never by autopilot.
ROLE_HANDLES = {'lead': ('question', 'accept', 'ratify', 'milestone'), 'agent': None,
                'solo': ('question', 'plan', 'ratify', 'accept', 'milestone'), 'autopilot': ('question', 'plan', 'accept')}
TEXT_FIELDS = ('title', 'description', 'design', 'acceptance_criteria', 'notes', 'close_reason')
SHOW_FIELDS = TEXT_FIELDS[1:]
# Fields `board show --field` accepts besides those on the shown items (a read of few items would otherwise hide
# the ones its items leave unset).
ITEM_FIELDS = {*TEXT_FIELDS, 'comments', 'assignee', 'metadata', 'closed_at', 'started_at', 'external_ref', 'source_system', 'spec_id',
               'lease_expires_at', 'heartbeat_at', 'await_type'}
# A decision record's `##` sections (board-coordination.md#rulings). bd lint accepts the words anywhere in the text,
# so board checks the headings itself.
RECORD_SECTIONS = ('Question', 'Alternatives Considered', 'Decision', 'Rationale', 'Rule owner')
# A pending revision is a `tracks` edge from the new decision to the record it revises: bd 1.3.1 rejects custom
# dependency types, `tracks` never blocks, no other board use exists, and `supersede` replaces the pair's edge, so the
# link lives exactly until release. The partial rule's name sits in the new record's metadata.
REVISES = 'tracks'
REVISES_RULE = 'board.revises_rule'
REGISTRY = Path(__file__).resolve().parent / 'session-lead-mode'
SYNC_SECONDS = float(os.environ.get('AGENT_BOARD_SYNC_SECONDS') or 60)  # the send window and the pull interval; tests shorten it
PULL_TIMEOUT = 5  # a pull a command waits for gives up after this
SYNC_TIMEOUT = 300  # a sync running longer counts as stuck
SYNC_ATTEMPTS = 5  # tries per window, SYNC_RETRY_SECONDS apart; then the next board command starts a new wait
SYNC_RETRY_SECONDS = 5
SYNC_REPORT_AFTER = 3  # consecutive failures before every command reports them; single ones recover by themselves
WRITE_RETRIES = 4
# bd raises this on a write that meets a sync's merge. Retire the retry when a bd release stops raising it: rerun the soak.
# `Merge conflict detected` is a different error, a stopped merge, and never retried.
WRITE_RETRY_ERROR = 'foreign key conflicts'
STORE_WARN_BYTES = 1 << 30
STORE_CHECK_SECONDS = 3600
QUEUE_PREFIX = 'queue:'
MOVERS = ('lead', 'solo')  # roles that may change an item's queue
FOR_PREFIX = 'for:'  # an item filed for a person: held for its creator's check, then in that person's inbox
USER_HOLD = 'user'  # the assignee of an item waiting on its person
# The mark that makes a board shared, in .beads: local, so an unshared board's check costs no bd call, and written only after
# share's first push or join's clone, so a stray Dolt remote shares nothing.
MARK_FILE = 'board-shared.json'
SHARED_BY = 'custom.board.shared'  # travels with the database: the sharer labelled the existing items
MOVED = 'custom.board.moved'  # travels with the database: the board moved to this url (board move); its clones rejoin there
# The board settings, owned here (board setup applies them; share and join add the shared ones). In the database: they travel
# with a shared board's sync. min_hash_length is a real key bd warns about as unrecognized: top-level ids of 5+ characters.
TRAVELLING_CONFIG = (('status.custom', 'decided:wip,released:active,in_review:wip,needs_ratification:wip'),
                     ('types.custom', 'design'), ('min_hash_length', '5'))
# In .beads/config.yaml: they do not travel, so each clone sets them. no-git-ops stays true as `init --stealth` sets it: bd 1.3
# keys its stealth handling on it (with false, `bd doctor --fix` writes a project .gitignore).
LOCAL_CONFIG = (('create.require-description', 'true'), ('validation.on-close', 'error'),
                ('lint.sections.decision', 'Question,Decision,Rule owner'), ('events-journal', 'true'),
                ('events-journal-retain-days', '30'), ('no-git-ops', 'true'))
SERVER_CONFIG = (('dolt.auto-start', 'false'),)  # a server-mode board: board starts a stopped server itself (ensure_server)
SHARED_CONFIG = (('dolt.auto-commit', 'batch'),)  # a shared board: one commit per sync
SENT_AT = 'sent_at'  # item metadata: when board send last put the item in an inbox


class BoardError(Exception):
    pass


def ids_of(records: list[dict]) -> set[str]:
    return {record['id'] for record in records}


def utcnow() -> datetime:
    return datetime.now(timezone.utc)


_actors: dict[tuple, str | None] = {}


def derived_actor() -> str | None:
    """BEADS_ACTOR (bd-guard sets it for Claude subagents), else the session's actor."""
    actor = os.environ.get('BEADS_ACTOR', '').strip()
    if actor:
        return actor
    key = tuple(os.environ.get(name, '') for name in ('CODEX_SESSION_ID', 'CODEX_THREAD_ID', 'CLAUDE_CODE_SESSION_ID'))
    if key not in _actors:
        result = subprocess.run(['bash', str(REGISTRY), 'actor'], capture_output=True, text=True)
        _actors[key] = result.stdout.strip() if result.returncode == 0 else None
    return _actors[key]


def bd_env() -> dict[str, str]:
    """BD_NO_REMOTE_ADOPT: bd may adopt git origin as a sync remote on its own; only `board share` pushes a board."""
    actor = derived_actor()
    return {**os.environ, 'BD_NO_REMOTE_ADOPT': '1', **({'BEADS_ACTOR': actor} if actor else {})}


_server_checked = False


def ensure_server(start: Path | None = None) -> None:
    """Start a stopped server of a server-mode board; bd's own auto-start is off."""
    global _server_checked
    if _server_checked:
        return
    _server_checked = True
    start = (start or Path.cwd()).resolve()
    root = next((d for d in (start, *start.parents) if (d / '.beads' / 'metadata.json').is_file()), None)
    if root is None:
        return
    beads = root / '.beads'
    try:
        if json.loads((beads / 'metadata.json').read_text(encoding='utf-8')).get('dolt_mode') != 'server':
            return
        port = int((beads / 'dolt-server.port').read_text(encoding='utf-8').strip())
        socket.create_connection(('127.0.0.1', port), timeout=1).close()
        return
    except (OSError, ValueError):
        pass
    if os.environ.get('CODEX_SANDBOX'):
        raise BoardError('the board server is unreachable from this sandbox: rerun with elevated sandbox permissions')
    subprocess.run(['bd', 'dolt', 'start'], cwd=root, capture_output=True, env=bd_env())


def bd(*args: str, stdin: str | None = None) -> subprocess.CompletedProcess:
    ensure_server()
    for retry in range(1, WRITE_RETRIES + 2):
        result = subprocess.run(['bd', *args], input=stdin, capture_output=True, text=True, env=bd_env())
        if result.returncode == 0 or shared is None or retry > WRITE_RETRIES or WRITE_RETRY_ERROR not in result.stdout + result.stderr:
            return result
        print(f'board: bd {args[0]} met a sync ({WRITE_RETRY_ERROR}); retry {retry} of {WRITE_RETRIES}', file=sys.stderr)
        time.sleep(1)
    raise AssertionError('unreachable')


def bd_checked(*args: str, stdin: str | None = None) -> str:
    result = bd(*args, stdin=stdin)
    if result.returncode != 0:
        raise BoardError(f"`bd {' '.join(args)}` failed: {(result.stderr or result.stdout).strip()}")
    return result.stdout


# Shared boards: skills/shared/beads-setup.md#shared-boards.

def beads_dir(start: Path | None = None) -> Path | None:
    """This folder's board: the nearest `.beads`, else (a linked worktree) the main checkout's."""
    start = (start or Path.cwd()).resolve()
    found = next((d / '.beads' for d in (start, *start.parents) if (d / '.beads' / 'metadata.json').is_file()), None)
    if found is not None:
        return found
    try:
        common = subprocess.run(['git', 'rev-parse', '--path-format=absolute', '--git-common-dir'], cwd=start,
                                capture_output=True, text=True)
    except OSError:
        return None
    beads = Path(common.stdout.strip()).parent / '.beads'
    return beads if common.returncode == 0 and (beads / 'metadata.json').is_file() else None


def read_mark(beads: Path) -> dict | None:
    try:
        mark = json.loads((beads / MARK_FILE).read_text(encoding='utf-8'))
    except (OSError, ValueError):
        return None
    return mark if isinstance(mark, dict) and isinstance(mark.get('remote'), str) and mark['remote'] else None


def write_mark(beads: Path, remote: str) -> None:
    temporary = beads / f'{MARK_FILE}.{os.getpid()}.tmp'
    temporary.write_text(json.dumps({'remote': remote}), encoding='utf-8')
    temporary.replace(beads / MARK_FILE)


def bd_remotes() -> dict[str, str]:
    """Remote name -> url of this folder's board (share, join and move only: a bd call)."""
    rows = json.loads(bd_checked('sql', '--json', 'select name, url from dolt_remotes') or '[]')
    return {row['name']: row['url'] for row in rows}


def remote_branches(remote: str) -> int:
    """The remote's branches this board has fetched: none before its first push or clone."""
    return int(json.loads(bd_checked('sql', '--json', f"select count(*) c from dolt_remote_branches where name like 'remotes/{remote}/%'"))[0]['c'])


def config_value(key: str) -> str | None:
    rows = json.loads(bd_checked('sql', '--json', f"select value from config where `key` = '{key}'") or '[]')
    return rows[0]['value'] if rows and rows[0].get('value') else None


def git_url(url: str) -> str:
    """The url git itself takes for a bd git remote."""
    return url[len('git+'):] if url.startswith('git+') else url


def remote_refs(url: str) -> tuple[list[str] | None, str]:
    """(the repository's refs, the error): None when it can't be read; `refs/dolt/data` holds a board. Only bd's git remotes:
    other Dolt remotes give (None, '')."""
    if not url.startswith('git+'):
        return None, ''
    try:
        result = subprocess.run(['git', 'ls-remote', git_url(url)], capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as error:
        return None, str(error)
    if result.returncode != 0:
        return None, last_line(result.stderr)
    return [row.split('\t', 1)[1] for row in result.stdout.splitlines() if '\t' in row], ''


def moved_refusal(url: str) -> str:
    return f'this board moved to {url}: writes here are refused. Rejoin: board join {url} (beads-setup.md#history)'


def person() -> str | None:
    """The person whose queue this checkout works from: git config agents.person, global or per repository."""
    try:
        result = subprocess.run(['git', 'config', '--get', 'agents.person'], capture_output=True, text=True)
    except OSError:
        return None
    return result.stdout.strip() or None


PERSON_HELP = 'set your person: git config --global agents.person <name> (without --global for this repository only)'


class Shared:
    """A board marked shared (`MARK_FILE`). Files in .beads/board-sync: `wait.lock` (the one wait, freed when it dies), `pull.lock`,
    `unsent` (its mtime is the first unsent write, the window's start), `wrote` (stamped after each write, so a wait about
    to end sees a write that found it still running), `pulled` (last pull started),
    `state.json` (the reported problem, and `moved`: the url a pulled moved note names, read by every command)."""

    def __init__(self, beads: Path, remote: str):
        self.root, self.remote = beads.parent, remote
        self.dir = beads / 'board-sync'
        self.beads = beads

    def path(self, name: str) -> Path:
        self.dir.mkdir(exist_ok=True)
        return self.dir / name

    def mtime(self, name: str) -> float | None:
        try:
            return (self.dir / name).stat().st_mtime
        except OSError:
            return None

    def state(self) -> dict:
        try:
            state = json.loads((self.dir / 'state.json').read_text(encoding='utf-8'))
        except (OSError, ValueError):
            return {}
        return state if isinstance(state, dict) else {}

    def update_state(self, **fields) -> None:
        temporary = self.path(f'state.{os.getpid()}.tmp')
        temporary.write_text(json.dumps({**self.state(), **fields}), encoding='utf-8')
        temporary.replace(self.path('state.json'))

    def lock(self, name: str, tries: int = 1):
        """The named lock, or None when another process holds it; released when the file closes or the process dies."""
        handle = self.path(name).open('w')
        for attempt in range(tries):
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return handle
            except OSError:
                if attempt + 1 < tries:
                    time.sleep(0.2)
        handle.close()
        return None

    def waiting(self) -> dict | None:
        """{'unsent': a write or commit has not reached the remote, 'conflicts': live conflict rows}; None when the
        server does not answer. A commit a failed sync left behind counts: the working set alone would strand it."""
        ensure_server(self.root)
        result = subprocess.run(['bd', 'sql', '--json',
                                 "select (select count(*) from dolt_status) dirty, (select count(*) from dolt_conflicts) conflicts, "
                                 "(select hash from dolt_branches where name = active_branch()) local, "
                                 f"(select hash from dolt_remote_branches where name = concat('remotes/{self.remote}/', active_branch())) remote"],
                                cwd=self.root, capture_output=True, text=True, env=bd_env())
        try:
            row = json.loads(result.stdout)[0]
        except (ValueError, IndexError, KeyError, TypeError):
            return None
        return {'unsent': bool(int(row['dirty'])) or row['local'] != row['remote'], 'conflicts': int(row['conflicts'])}

    def spawn_wait(self) -> None:
        """Detached: its own session, no inherited pipes, or the caller's tool call would stay open for the whole wait."""
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), '_sync-wait'], cwd=self.root, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True, env=bd_env())

    def wait_running(self) -> bool:
        """A shared probe: probes never collide with each other, and `wait` retries past a passing one."""
        with self.path('wait.lock').open('w') as handle:
            try:
                fcntl.flock(handle, fcntl.LOCK_SH | fcntl.LOCK_NB)
            except OSError:
                return True
        return False

    def start_wait(self) -> None:
        """Starts the wait for known unsent writes, a window after the last failure at the earliest: a stopped sync must
        not run again on every command."""
        failed = self.state().get('last_failure')
        if not failed or time.time() - failed >= SYNC_SECONDS:
            self.spawn_wait()

    def before(self) -> None:
        """Restarts a dead wait; pulls when due and nothing is waiting. One process pulls, others carry on."""
        if self.wait_running():
            return
        if self.mtime('unsent') is not None:
            self.start_wait()
            return
        pulled = self.mtime('pulled')
        if pulled is not None and time.time() - pulled < SYNC_SECONDS:
            return
        handle = self.lock('pull.lock')
        if handle is None:
            return
        with handle:
            now = self.waiting()
            if now is None:
                return
            if now['unsent']:  # a pull would commit it and undo the grouping; a write from outside board comes here
                self.path('unsent').touch()
                self.start_wait()
                return
            self.path('pulled').touch()
            self.pull()
            self.check_store()

    def pull(self) -> None:
        child = subprocess.Popen(['bd', 'dolt', 'pull', '--remote', self.remote], cwd=self.root, stdin=subprocess.DEVNULL,
                                 stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, start_new_session=True, env=bd_env())
        try:
            output, _ = child.communicate(timeout=PULL_TIMEOUT)
        except subprocess.TimeoutExpired:
            with contextlib.suppress(OSError):
                os.killpg(child.pid, signal.SIGKILL)
            child.wait()
            self.failed(f'a pull took over {PULL_TIMEOUT} s')
            return
        if child.returncode == 0:
            self.succeeded()
            self.check_moved()
            return
        now = self.waiting()
        if now and now['conflicts']:
            self.update_state(kind='conflict', last_failure=time.time())
        else:
            self.failed(last_line(output))

    def after(self) -> None:
        """A command that may have written: starts the window unless a wait is on it. Clears a conflict report once
        the conflict is gone (resolved, or the merge aborted); the wait's next sync says how it went."""
        self.path('wrote').touch()
        if self.wait_running() and self.state().get('kind') != 'conflict':
            return
        now = self.waiting()
        if now is None:
            return
        if self.state().get('kind') == 'conflict' and not now['conflicts']:
            self.update_state(kind=None, failures=0, last_failure=None, detail=None)
        if now['unsent'] and not self.wait_running():
            if self.mtime('unsent') is None:
                self.path('unsent').touch()
            self.start_wait()

    def succeeded(self) -> None:
        if self.state().get('failures') or self.state().get('kind') or self.state().get('last_failure'):
            self.update_state(kind=None, failures=0, detail=None, last_failure=None)

    def moved(self) -> str | None:
        return self.state().get('moved') or None

    def check_moved(self) -> None:
        """After each pull: whether the board brought a moved note (board move). A failed read keeps what was known."""
        ensure_server(self.root)
        result = subprocess.run(['bd', 'sql', '--json', f"select value from config where `key` = '{MOVED}'"], cwd=self.root,
                                capture_output=True, text=True, env=bd_env())
        try:
            rows = json.loads(result.stdout)
        except ValueError:
            return
        url = rows[0].get('value') if rows and isinstance(rows[0], dict) else None
        if (url or None) != self.moved():
            self.update_state(moved=url or None)

    def failed(self, detail: str, kind: str = 'failing') -> None:
        self.update_state(kind=kind, failures=int(self.state().get('failures') or 0) + 1, detail=detail, last_failure=time.time())

    def sync_once(self) -> bool:
        """One commit and sync. True when the wait may go on trying (it succeeded, or the failure is transient)."""
        subprocess.run(['bd', 'dolt', 'commit', '-m', f"sync {person() or socket.gethostname()}"], cwd=self.root,
                       capture_output=True, env=bd_env())
        try:
            result = subprocess.run(['bd', 'sync', '--remote', self.remote], cwd=self.root, capture_output=True, text=True,
                                    timeout=SYNC_TIMEOUT, env=bd_env())
        except subprocess.TimeoutExpired:
            self.failed(f'a sync ran over {SYNC_TIMEOUT} s', 'stuck')
            return False
        if result.returncode == 0:
            self.succeeded()
            self.path('pulled').touch()
            self.check_moved()
            return True
        if result.returncode == 2:
            self.failed('', 'conflict')
            return False
        if result.returncode == 4:
            self.failed('uncommitted changes block every sync', 'stuck')
            return False
        self.failed(last_line(result.stderr or result.stdout))
        return True

    def send(self) -> bool:
        for attempt in range(SYNC_ATTEMPTS):
            if attempt:
                time.sleep(SYNC_RETRY_SECONDS)
            if not self.sync_once():
                return False
            if not self.state().get('failures'):
                return True
        return False

    def wait(self) -> int:
        """`board _sync-wait`: the first unsent write opens a window; at its end, commit and sync; writes during the sync
        open the next. Ends when nothing is left, or after a failed window with `unsent` kept for the next command."""
        while True:
            handle = self.lock('wait.lock', tries=5)
            if handle is None:
                return 0
            with handle:
                while True:
                    stamp = self.mtime('wrote')
                    now = self.waiting()
                    if now is None:
                        self.failed('the board server does not answer')
                        return 1
                    if now['conflicts']:
                        self.failed('', 'conflict')
                        return 1
                    if not now['unsent']:
                        with contextlib.suppress(OSError):
                            (self.dir / 'unsent').unlink()
                        break
                    if self.mtime('unsent') is None:
                        self.path('unsent').touch()
                    first = self.mtime('unsent') or time.time()
                    time.sleep(max(0.0, first + SYNC_SECONDS - time.time()))
                    (self.dir / 'unsent').unlink(missing_ok=True)  # a write from here on opens the next window
                    if not self.send():
                        self.path('unsent').touch()
                        os.utime(self.path('unsent'), (first, first))
                        return 1
            if self.mtime('wrote') == stamp:
                return 0

    def check_store(self) -> None:
        """Hourly: walking the store on every command would cost more than the warning is worth."""
        state = self.state()
        if time.time() - float(state.get('store_checked') or 0) < STORE_CHECK_SECONDS:
            return
        size = sum(entry.stat().st_size for entry in (self.beads / 'dolt').rglob('*') if entry.is_file())
        self.update_state(store_checked=time.time(), store_bytes=size, store_warned=False)

    def problem(self) -> str | None:
        """The one line for a stopped or repeatedly failing sync, with its fix; None while single failures recover."""
        state = self.state()
        kind, detail = state.get('kind'), state.get('detail') or ''
        if state.get('moved'):
            return moved_refusal(state['moved'])
        if kind == 'conflict':
            return ('sync stopped by a merge conflict, nothing goes out. Fix: board bd conflicts show, board bd conflicts '
                    'resolve <id> --ours|--theirs, board bd sync. Both sides created one id: board bd sql '
                    '"CALL DOLT_MERGE(\'--abort\')", board bd rename <id> <new id>, board bd sync')
        if kind == 'stuck':
            return f'sync stuck: {detail}. Fix: board bd sync shows the error; board bd dolt commit -m "<why>" clears uncommitted changes'
        if kind == 'failing' and int(state.get('failures') or 0) >= SYNC_REPORT_AFTER:
            return f"sync failing, {state['failures']} tries: {detail}. Fix: check the remote and your access; board bd sync shows the error"
        return None

    def store_warning(self) -> str | None:
        size = int(self.state().get('store_bytes') or 0)
        if size < STORE_WARN_BYTES:
            return None
        return f'board store is {size / (1 << 30):.1f} GB: plan a flatten with the others (beads-setup.md#history)'

    def report(self) -> None:
        """What every command prints, on stderr: the protocol, the console and --json views read stdout."""
        problem = self.problem()
        if problem:
            print(f'board: {problem}', file=sys.stderr)
        warning = self.store_warning()
        if warning and not self.state().get('store_warned'):
            self.update_state(store_warned=True)
            print(f'board: {warning}', file=sys.stderr)
        if person() is None:
            print(f'board: {PERSON_HELP}', file=sys.stderr)


def last_line(text: str) -> str:
    lines = [row.strip() for row in text.splitlines() if row.strip()]
    return next((row for row in lines if row.startswith('Error')), lines[-1] if lines else 'no output')[:200]


shared: Shared | None = None


def find_shared(start: Path | None = None) -> Shared | None:
    beads = beads_dir(start)
    mark = read_mark(beads) if beads else None
    return Shared(beads, mark['remote']) if mark else None


def may_move() -> bool:
    """A person's terminal has no actor and isn't limited; a session with no registered role and a worker count as agents."""
    actor = derived_actor()
    if not actor:
        return True
    if actor != session_actor(actor):
        return False
    try:
        entry = registry_by_actor(registrations()).get(actor)
    except BoardError:
        return False
    return bool(entry and entry.get('role') in MOVERS)


def bd_show(ids: list[str], *flags: str, comments: bool = True) -> list[dict]:
    """Full records of the ids that exist (bd reports unknown ids on stderr, or fails when none exists)."""
    result = bd('show', '--json', *(['--include-comments'] if comments else []), '--brief-deps', *flags, '--', *ids)
    if result.returncode != 0:
        try:
            if 'no issues found' in json.loads(result.stdout).get('error', ''):
                return []
        except (ValueError, AttributeError):
            pass
        raise BoardError(f"`bd show` failed: {(result.stderr or result.stdout).strip()}")
    return json.loads(result.stdout or '[]')


def registrations() -> list[dict]:
    result = subprocess.run(['bash', str(REGISTRY), 'list'], capture_output=True, text=True)
    if result.returncode != 0:
        raise BoardError(f'session registry unreadable: {result.stderr.strip()}')
    return [json.loads(line) for line in result.stdout.splitlines() if line.strip()]


def board_project() -> str | None:
    """The resolved folder holding this board: the parent of the first line of `bd where` (a worktree names the main
    checkout's .beads); None when the lookup fails. The registry records the same value (session-lead-mode project)."""
    result = bd('where')
    first = result.stdout.splitlines()[0].strip() if result.returncode == 0 and result.stdout.strip() else ''
    return str(Path(first).parent.resolve()) if first.startswith('/') else None


def parse_time(value) -> datetime | None:
    if not isinstance(value, str) or not value:
        return None
    try:
        moment = datetime.fromisoformat(value.replace('Z', '+00:00'))
    except ValueError:
        return None
    return moment if moment.tzinfo is not None else moment.replace(tzinfo=timezone.utc)


def age(moment: datetime | None) -> str:
    if moment is None:
        return 'age unknown'
    minutes = int((utcnow() - moment).total_seconds() // 60)
    if minutes < 120:
        return f'{minutes} min'
    if minutes < 48 * 60:
        return f'{minutes // 60} h'
    return f'{minutes // 1440} d'


def session_actor(actor: str) -> str:
    return actor.split('/', 1)[0]


_processes: dict[int, str | None] = {}  # pid -> start time, 'GONE', or None (unknown); per run


def holder_worker(holder: str) -> str | None:
    """The holding worker's marker name (its id's last 8 characters), None for a session hold."""
    return holder.split('/', 1)[1][-8:] if '/' in holder else None


def hooks_live(entry: dict | None) -> bool:
    """The session's activity hooks run: its own activity file exists. Without it, a missing worker marker or a
    marker's age proves nothing (a worker spawned before the hooks, or hooks not yet trusted)."""
    return bool(entry and entry.get('active_at'))


def worker_stopped(entry: dict | None, issue: dict) -> bool:
    """The holding worker has no running marker, and the session's own activity is newer than the item's
    `updated_at`: every claim updates it (later updates only raise it), so the hooks ran after this claim and a
    running worker would have a marker. Not `started_at`: it can predate the hold (a reclaim, a reviewer's claim).
    Only its owning session (`board mine`) acts on it: only the owner knows whether it continues the worker."""
    worker = holder_worker(issue.get('assignee') or '')
    if not (entry and worker) or worker in (entry.get('workers') or {}):
        return False
    active, claimed = parse_time(entry.get('active_at')), parse_time(issue.get('updated_at'))
    return bool(active and claimed and active > claimed)


def holder_activity(entry: dict | None, holder: str) -> datetime | None:
    """The holder's last tool call: a running worker's marker, else (a session hold, a stopped worker) the session's
    own; None without activity data (the session's hooks not live)."""
    if not hooks_live(entry):
        return None
    worker = holder_worker(holder)
    moment = parse_time((entry.get('workers') or {}).get(worker)) if worker else None
    return moment or parse_time(entry.get('active_at'))


def active_workers(entry: dict | None) -> list[str]:
    """The session's running workers with a tool call within WORKER_ACTIVE_MINUTES."""
    since = utcnow() - timedelta(minutes=WORKER_ACTIVE_MINUTES)
    return [worker for worker, moment in ((entry or {}).get('workers') or {}).items()
            if (parse_time(moment) or since) > since]


def worker_cap(entry: dict) -> int:
    """The session's own `worker_cap`, else WORKER_CAP, lowered for a Codex session by the effective `agents.max_threads` or
    `agents.max_concurrent_threads_per_session`: Codex's layers, the system config (CODEX_SYSTEM_CONFIG; tests set
    AGENT_CODEX_SYSTEM_CONFIG) overridden per key by `$CODEX_HOME/config.toml` (default ~/.codex)."""
    own = entry.get('worker_cap')
    cap = own if isinstance(own, int) and not isinstance(own, bool) and own >= 0 else WORKER_CAP
    if entry.get('tool') != 'codex':
        return cap
    layers = (Path(os.environ.get('AGENT_CODEX_SYSTEM_CONFIG') or CODEX_SYSTEM_CONFIG),
              Path(os.environ.get('CODEX_HOME') or Path.home() / '.codex') / 'config.toml')
    agents: dict = {}
    for path in layers:
        try:
            layer = tomllib.loads(path.read_text(encoding='utf-8')).get('agents')
        except (OSError, ValueError):  # a missing or unreadable layer sets nothing
            continue
        agents.update(layer if isinstance(layer, dict) else {})
    for key in ('max_threads', 'max_concurrent_threads_per_session'):
        value = agents.get(key)
        if isinstance(value, int) and not isinstance(value, bool) and value > 0:
            cap = min(cap, value)
    return cap


def process_started(pid: int) -> str | None:
    """The process's start time as `ps -o lstart=` prints it in UTC (whitespace-normalized; session-lead-mode
    stores the same form), or None when ps fails for any reason."""
    try:
        result = subprocess.run([shutil.which('ps') or '/bin/ps', '-o', 'lstart=', '-p', str(pid)], capture_output=True,
                                text=True, env={**os.environ, 'LC_ALL': 'C', 'TZ': 'UTC0'})
    except OSError:
        return None
    started = ' '.join(result.stdout.split())
    return started if result.returncode == 0 and started else None


def liveness(entry: dict | None) -> str | None:
    """'GONE' when the session's registered pid no longer exists or now names a process started at another
    time, 'alive' when it matches, None when unknown (no entry, no pid, ps failed): unknown keeps the idle hint."""
    if entry is None:
        return None
    pid, started = entry.get('pid'), entry.get('pid_started')
    if not isinstance(pid, int) or pid <= 1 or not isinstance(started, str):
        return None
    if pid not in _processes:
        try:
            os.kill(pid, 0)
            _processes[pid] = process_started(pid)
        except ProcessLookupError:
            _processes[pid] = 'GONE'
        except PermissionError:  # exists, owned by another user
            _processes[pid] = process_started(pid)
        except OSError:
            _processes[pid] = None
    current = _processes[pid]
    if current is None:
        return None
    return 'GONE' if current == 'GONE' or current != ' '.join(started.split()) else 'alive'


class Board:
    def __init__(self, issues: list[dict], complete: bool = True):
        """complete: the snapshot holds closed items too. Without them (status reads) a dependency target that is
        missing counts as closed; with them a missing one is unknown and counts as open (fail closed)."""
        self.complete = complete
        self._hydrated: set[str] = set()
        self.issues = issues
        self._milestone_work: dict[str, set[str]] = {}
        self._in_milestone: dict[str, list[str]] | None = None
        self.by_id = {issue['id']: issue for issue in issues}
        self.parent: dict[str, str] = {}
        self.parents: dict[str, list[str]] = {}  # bd allows several; `parent` keeps the last for the views that assume one
        self.view: str | None = None  # the queue the default lists show; None: every item (an unshared board, --queue all)
        self._loaded = ids_of(issues)
        self._outside: dict[str, tuple[list[str], list[str]]] = {}  # item not in the snapshot -> (labels, parents)
        self._queues: dict[str, list[str]] = {}
        self.children: dict[str, list[str]] = {}
        self.blockers: dict[str, list[str]] = {}  # waiting id -> ids it waits on
        self.dependents: dict[str, list[str]] = {}  # blocker id -> waiting ids
        self.linked: dict[str, set[str]] = {}  # id -> ids sharing any non-parent edge
        self.related: dict[str, set[str]] = {}  # relates-to, both ends
        self.edges: dict[str, list[tuple[str, str, bool]]] = {}  # id -> (other id, type, outgoing)
        for issue in issues:
            for dep in issue.get('dependencies') or []:
                waiting, target, kind = dep['issue_id'], dep['depends_on_id'], dep['type']
                self.edges.setdefault(waiting, []).append((target, kind, True))
                self.edges.setdefault(target, []).append((waiting, kind, False))
                if kind == 'parent-child':
                    self.parent[waiting] = target
                    if target not in self.parents.setdefault(waiting, []):
                        self.parents[waiting].append(target)
                    self.children.setdefault(target, []).append(waiting)
                    continue
                self.linked.setdefault(waiting, set()).add(target)
                self.linked.setdefault(target, set()).add(waiting)
                if kind == 'blocks':
                    self.blockers.setdefault(waiting, []).append(target)
                    self.dependents.setdefault(target, []).append(waiting)
                elif kind in ('relates-to', 'related'):
                    self.related.setdefault(waiting, set()).add(target)
                    self.related.setdefault(target, set()).add(waiting)

    @classmethod
    def load(cls, scope: str = 'status', ids: list[str] | None = None) -> 'Board':
        """The one place that picks the bd read, sized to the view:
        status: non-closed items with dependencies, no comments (`hydrate` adds the held items' comments);
        all: `bd export`, closed items and comments included;
        ids: only the named items with their comments and both edge directions (`board show`)."""
        if scope == 'all':
            lines = bd_checked('export').splitlines()
            return cls([issue for issue in map(json.loads, filter(str.strip, lines)) if issue.get('_type', 'issue') == 'issue'])
        if scope == 'status':
            issues = json.loads(bd_checked('list', '--json', '--limit', '0', '--include-gates') or '[]')
            for issue in issues:  # bd export orders an item's edges by target; list does not, and blocker order is printed
                issue['dependencies'] = sorted(issue.get('dependencies') or [], key=lambda d: (d['depends_on_id'], d['type']))
            return cls(issues, complete=False)
        records = bd_show(ids or [], '--include-dependents')
        edges, stubs = set(), {}
        for record in records:
            for stub, outgoing, key in [(d, True, 'dependencies') for d in record.get('dependencies') or []] \
                    + [(d, False, 'dependents') for d in record.get('dependents') or []]:
                edges.add((record['id'], stub['id'], stub['dependency_type']) if outgoing
                          else (stub['id'], record['id'], stub['dependency_type']))
                stubs[stub['id']] = stub
        for record in records:  # the export's edge shape: the item's own entries, both directions
            record['dependencies'] = [{'issue_id': a, 'depends_on_id': b, 'type': kind}
                                      for a, b, kind in sorted(edges) if record['id'] in (a, b)]
            record.pop('dependents', None)
        board = cls(records, complete=False)
        # A revision pending names its new record's partial rule, kept in that record's metadata.
        newer = sorted({a for a, b, kind in edges if kind == REVISES and b in ids_of(records)
                        and board.by_id[b].get('issue_type') == 'decision'} - ids_of(records))
        full = {record['id']: record for record in bd_show(newer)} if newer else {}
        for other_id, stub in stubs.items():
            board.by_id.setdefault(other_id, full.get(other_id, stub))
        return board

    def hydrate(self, ids) -> None:
        """Adds what a status read leaves out, for the given items, in one bd call: comments, and an epic's
        `epic_total_children` (its closed children are not in the read)."""
        todo = [item_id for item_id in dict.fromkeys(ids) if item_id in self.by_id and item_id not in self._hydrated]
        if not self.complete and todo:
            epics = any(self.by_id[item_id].get('issue_type') == 'epic' for item_id in todo)
            for record in bd_show(todo, *(['--include-dependents'] if epics else [])):  # only then bd counts an epic's children
                self.by_id[record['id']]['comments'] = record.get('comments') or []
                if 'epic_total_children' in record:
                    self.by_id[record['id']]['epic_total_children'] = record['epic_total_children']
        self._hydrated.update(todo)

    def held_ids(self) -> list[str]:
        """Held items: `last_activity` needs their comments (comments do not bump updated_at)."""
        return [issue['id'] for issue in self.issues if issue['status'] != 'closed' and issue.get('assignee')]

    def finished_epic(self, issue: dict) -> bool:
        """An epic with children, none of them open (needs `hydrate` of childless epics on a status read)."""
        return issue.get('issue_type') == 'epic' and bool(self.children.get(issue['id']) or issue.get('epic_total_children')) \
            and not any(self.is_open(child) for child in self.children.get(issue['id'], []))

    def ancestors(self, item_id: str):
        seen = set()
        while item_id in self.parent and item_id not in seen:
            seen.add(item_id)
            item_id = self.parent[item_id]
            yield item_id

    def scoped(self, root: str | None) -> list[dict]:
        if root is None:
            return self.issues
        if root not in self.by_id and (self.complete or root not in self.edges):  # a closed root: only its edges show
            raise BoardError(f'unknown root {root}')
        if self.by_id.get(root, {}).get('issue_type') == 'milestone':
            work = self.milestone_work(root) | {root}
            return [issue for issue in self.issues if issue['id'] in work]
        return [issue for issue in self.issues if root in self.ancestors(issue['id'])]

    def routing(self, item_id: str) -> tuple[list[str], list[str]]:
        """(labels, parents) of an item, reading ancestors the snapshot lacks (a status read holds no closed items) in one call."""
        if item_id in self._loaded:
            return self.by_id[item_id].get('labels') or [], self.parents.get(item_id, [])
        if item_id not in self._outside:
            missing = {item_id} | {p for parents in self.parents.values() for p in parents
                                   if p not in self._loaded and p not in self._outside}
            for record in bd_show(sorted(missing), comments=False):
                self._outside[record['id']] = (record.get('labels') or [],
                                               [d['id'] for d in record.get('dependencies') or [] if d.get('dependency_type') == 'parent-child'])
            for other in missing:
                self._outside.setdefault(other, ([], []))
        return self._outside[item_id]

    def queues(self, item_id: str, seen: frozenset = frozenset()) -> list[str]:
        """Its own queue label(s), else the union of its parents': more than one means no queue can be picked."""
        if item_id not in self._queues:
            labels, parents = self.routing(item_id)
            own = sorted(label[len(QUEUE_PREFIX):] for label in labels if label.startswith(QUEUE_PREFIX))
            self._queues[item_id] = own or sorted({queue for parent in parents if parent not in seen
                                                   for queue in self.queues(parent, seen | {item_id})})
        return self._queues[item_id]

    def queue(self, item_id: str) -> str | None:
        """The item's queue; None: unrouted (no label on it or above it, or several queues disagree)."""
        names = self.queues(item_id)
        return names[0] if len(names) == 1 else None

    def listed(self, root: str | None) -> list[dict]:
        """What default lists and bare claims cover: `scoped`, narrowed to the viewed queue on a shared board."""
        scoped = self.scoped(root)
        return scoped if self.view is None else [issue for issue in scoped if self.queue(issue['id']) == self.view]

    def milestone_work(self, milestone_id: str) -> set[str]:
        """Open items the milestone waits on (board-coordination.md#milestones): its open blockers, the open
        descendants of every reached epic, and transitively the open blockers of every reached item."""
        if milestone_id not in self._milestone_work:
            work: set[str] = set()
            visited: set[tuple[str, bool]] = set()  # an item reached as a blocker may be reached again as a descendant
            pending = [(blocker, False) for blocker in self.blockers.get(milestone_id, [])]
            while pending:
                visit = pending.pop()
                item_id, descendant = visit
                if visit in visited or not self.is_open(item_id):
                    continue
                visited.add(visit)
                work.add(item_id)
                pending += [(blocker, False) for blocker in self.blockers.get(item_id, [])]
                if descendant or self.by_id[item_id].get('issue_type') == 'epic':
                    pending += [(child, True) for child in self.children.get(item_id, [])]
            self._milestone_work[milestone_id] = work
        return self._milestone_work[milestone_id]

    def milestones(self) -> list[dict]:
        return [issue for issue in self.issues if issue.get('issue_type') == 'milestone' and issue['status'] != 'closed']

    @property
    def in_milestone(self) -> dict[str, list[str]]:
        """Item id -> the open milestones it is work of."""
        if self._in_milestone is None:
            self._in_milestone = {}
            for milestone in self.milestones():
                for item_id in self.milestone_work(milestone['id']):
                    self._in_milestone.setdefault(item_id, []).append(milestone['id'])
        return self._in_milestone

    def between(self, a: str, b: str) -> list[tuple[str, str, str]]:
        """(from, to, type) of every edge between the pair, either direction."""
        return [(a, other, kind) if outgoing else (other, a, kind) for other, kind, outgoing in self.edges.get(a, [])
                if other == b]

    def revises(self, item_id: str) -> list[str]:
        """Records a decision revises (pending until release)."""
        if self.by_id.get(item_id, {}).get('issue_type') != 'decision':
            return []
        return [other for other, kind, outgoing in self.edges.get(item_id, []) if outgoing and kind == REVISES]

    def revised_by(self, item_id: str) -> list[str]:
        """The decisions whose pending revision names this record."""
        return [other for other, kind, outgoing in self.edges.get(item_id, [])
                if not outgoing and kind == REVISES and self.by_id.get(other, {}).get('issue_type') == 'decision']

    def is_open(self, item_id: str) -> bool:
        return item_id in self.by_id and self.by_id[item_id]['status'] != 'closed'

    def open_blockers(self, item_id: str) -> list[str]:
        # In a complete snapshot a missing blocker counts as open (fail closed); a status read holds no closed
        # items, so there it counts as closed. `external:` references never block in bd 1.3.1.
        return [blocker for blocker in self.blockers.get(item_id, [])
                if self.is_open(blocker)
                or (self.complete and blocker not in self.by_id and not blocker.startswith('external:'))]

    def unsettled_blockers(self, item_id: str) -> list[str]:
        """What holds a decided record's release or an answered question's close: a released ruling is a settled
        premise, which holds only the open items it changes until planned."""
        return [blocker for blocker in self.open_blockers(item_id)
                if self.by_id.get(blocker, {}).get('status') != 'released']

    def kind(self, issue: dict) -> str | None:
        status, kind = issue['status'], issue.get('issue_type')
        if kind == 'decision':
            return {'released': 'plan', 'open': 'question', 'needs_ratification': 'ratify'}.get(status)
        if status == 'in_review':
            return 'review' if kind in WORK_TYPES else 'accept' if kind == 'design' else None
        if status != 'open':
            return None
        if kind in ('design', 'milestone'):
            return kind
        return 'implement' if kind in WORK_TYPES else None

    def claimable(self, issue: dict) -> str | None:
        kind = self.kind(issue)
        if kind is None or issue.get('assignee') or self.open_blockers(issue['id']):
            return None
        return kind

    def downstream(self, item_id: str, through_milestones: bool = True) -> int:
        """Open work waiting on an item. A milestone's whole scope waits on each member, which tells members apart by
        nothing: `through_milestones=False` counts a milestone as one item and stops there (r24-q109)."""
        seen: set[str] = set()
        pending = [item_id]
        while pending:
            for waiting in self.dependents.get(pending.pop(), []):
                if waiting not in seen and self.is_open(waiting):
                    seen.add(waiting)
                    if through_milestones or self.by_id.get(waiting, {}).get('issue_type') != 'milestone':
                        pending.append(waiting)
        return len(seen)

    def holds(self, item_id: str) -> tuple[int, int]:
        """(stopping at milestones, everything downstream): what `holds 2/52` prints and lists sort by."""
        return self.downstream(item_id, through_milestones=False), self.downstream(item_id)

    def last_activity(self, issue: dict) -> datetime | None:
        moments = [parse_time(issue.get('updated_at'))]
        moments += [parse_time(comment.get('created_at')) for comment in issue.get('comments') or []]
        moments = [moment for moment in moments if moment is not None]
        return max(moments) if moments else None

    def text(self, issue: dict) -> str:
        parts = [str(issue.get(field) or '') for field in TEXT_FIELDS]
        parts += issue.get('labels') or []
        parts += [comment.get('text') or '' for comment in issue.get('comments') or []]
        return '\n'.join(parts)


def line(issue: dict, *extra: str) -> str:
    fields = [issue['id'], issue['status'], issue.get('issue_type', ''), *extra]
    return '  ' + '  '.join(field for field in fields if field) + f"  {issue.get('title', '')}"


def section(title: str, rows: list[str], limit: int | None = None) -> None:
    print(f'{title}: {len(rows)}')
    shown = rows[:limit] if limit else rows  # None or 0: every row
    for row in shown:
        print(row)
    if len(shown) < len(rows):
        print(f'  ... {len(rows) - len(shown)} more')


def by_priority(issue: dict):
    return (issue.get('priority', 9), issue.get('created_at') or '', issue['id'])


def claim_order(board: Board, issue: dict):
    # P0 first, then milestone work (board-coordination.md#milestones), each by priority; at equal priority
    # a released ruling goes first: it blocks the work it changes until planned.
    priority, created, item_id = by_priority(issue)
    return (priority != 0, item_id not in board.in_milestone, priority, board.kind(issue) != 'plan', created, item_id)


# Views

HEALTH_VIEWS = ('questions', 'decided', 'ratification', 'released', 'review', 'user', 'ready', 'held', 'blocked',
                'outside', 'labels')
LIFECYCLE_LABELS = ('human', 'decided', 'review', 'needs-ratification', 'waiting')


def health_views(board: Board, root: str | None) -> dict[str, tuple[str, list[dict]]]:
    """view -> (heading, open items), the counts `board health` prints."""
    items = [issue for issue in board.listed(root) if issue['status'] != 'closed' and issue.get('issue_type') != 'epic']
    decisions = [issue for issue in items if issue.get('issue_type') == 'decision']

    def epic_of(issue):
        return next((a for a in board.ancestors(issue['id']) if board.by_id.get(a, {}).get('issue_type') == 'epic'), None)

    return {
        'questions': ('open questions', [i for i in decisions if i['status'] in ('open', 'in_progress')]),
        'decided': ('decided, not released', [i for i in decisions if i['status'] == 'decided']),
        'ratification': ('awaiting ratification', [i for i in items if i['status'] == 'needs_ratification']),
        'released': ('released rulings to plan', [i for i in decisions if i['status'] == 'released']),
        'review': ('in review', [i for i in items if i['status'] == 'in_review']),
        'user': ('waiting on the user (gates titled user, items assigned to user)',
                 [i for i in items if (i.get('issue_type') == 'gate' and i.get('title', '').startswith('user '))
                  or i.get('assignee') == 'user']),
        'ready': ('claimable now (unassigned, unblocked)', [i for i in items if board.claimable(i)]),
        'held': ('held (assigned, not closed)', [i for i in items if i.get('assignee')]),
        'blocked': ('waiting on open blockers', [i for i in items if board.open_blockers(i['id'])]),
        'outside': ('outside any epic', [i for i in items if epic_of(i) is None and i.get('issue_type') != 'gate']),
        'labels': ('lifecycle labels (use statuses, assignment or blocks)',
                   [i for i in items if set(i.get('labels') or []) & set(LIFECYCLE_LABELS)]),
    }


def milestone_states(board: Board, root: str | None) -> list[dict]:
    scope = {issue['id'] for issue in board.listed(root)}
    states = []
    for milestone in (m for m in board.milestones() if m['id'] in scope):
        work = [board.by_id[item_id] for item_id in board.milestone_work(milestone['id'])]
        work = [issue for issue in work if issue.get('issue_type') != 'epic']
        states.append({'id': milestone['id'], 'title': milestone.get('title', ''), 'openWork': len(work),
                       'ready': sum(1 for i in work if board.claimable(i)), 'held': sum(1 for i in work if i.get('assignee')),
                       'blocked': sum(1 for i in work if board.open_blockers(i['id'])),
                       'milestoneReady': not board.open_blockers(milestone['id'])})
    return states


def item_json(board: Board, issue: dict, **extra) -> dict:
    """An item row of a --json view."""
    return {'id': issue['id'], 'type': issue.get('issue_type'), 'status': issue['status'], 'priority': issue.get('priority'),
            'holder': issue.get('assignee') or None, 'title': issue.get('title', ''), 'labels': issue.get('labels') or [],
            'blockedBy': board.unsettled_blockers(issue['id']) if issue['status'] == 'decided' else board.open_blockers(issue['id']),
            **extra}


# health views under the console's count names (contract-rulings R-B5); the others keep their view name.
JSON_COUNTS = {'released': 'toPlan', 'review': 'inReview', 'user': 'forUser'}


def queue_summary(board: Board, root: str | None) -> dict | None:
    """What a queue-filtered list always adds, None without a filter: open items per other queue, unrouted items, and
    other people's items blocking the viewed queue's. Gates route nothing and don't count."""
    if board.view is None:
        return None
    items = [issue for issue in board.scoped(root) if issue['status'] != 'closed' and issue.get('issue_type') != 'gate']
    others: dict[str, int] = {}
    for issue in items:
        queue = board.queue(issue['id'])
        if queue and queue != board.view:
            others[queue] = others.get(queue, 0) + 1
    mine = [issue for issue in items if board.queue(issue['id']) == board.view]
    blocking = {blocker for issue in mine for blocker in board.open_blockers(issue['id'])
                if blocker in board.by_id and board.queue(blocker) != board.view and board.queue(blocker)}
    # Unrouted items wait on a lead: for you first (your inbox), then the longest waiting.
    unrouted = sorted((issue for issue in items if board.queue(issue['id']) is None),
                      key=lambda issue: (board.view not in filed_for(issue), waiting_since(issue), issue['id']))
    return {'others': others, 'unrouted': unrouted,
            'inbox': [issue for issue in unrouted if board.view in filed_for(issue)],
            'toSend': [issue for issue in mine if filed_for(issue) and issue.get('assignee') == USER_HOLD],
            'blocking': sorted((board.by_id[item_id] for item_id in blocking), key=by_priority)}


def filed_for(issue: dict) -> list[str]:
    """The people an item is filed for (`for:` labels)."""
    return [label[len(FOR_PREFIX):] for label in issue.get('labels') or [] if label.startswith(FOR_PREFIX)]


def sent_at(issue: dict) -> str | None:
    """When `board send` last put an item in an inbox (its metadata stamp), None for an item never sent."""
    metadata = issue.get('metadata') if isinstance(issue.get('metadata'), dict) else {}
    value = metadata.get(SENT_AT)
    return value if filed_for(issue) and isinstance(value, str) and parse_time(value) else None


def waiting_since(issue: dict) -> str:
    """An unrouted item waits since it was sent, if it was; otherwise since it was created."""
    return sent_at(issue) or issue.get('created_at') or ''


def unrouted_row(board: Board, issue: dict) -> str:
    names = board.queues(issue['id'])
    sent = sent_at(issue)
    return line(issue, f"queues {','.join(names)}" if names else '', *(FOR_PREFIX + who for who in filed_for(issue)),
                f"sent {age(parse_time(sent))} ago" if sent else f"{age(parse_time(issue.get('created_at')))} old")


def queue_rows(board: Board, root: str | None, command: str) -> None:
    summary = queue_summary(board, root)
    if summary is None:
        return
    if summary['others']:
        counts = ', '.join(f'{queue} {count}' for queue, count in sorted(summary['others'].items()))
        print(f'other queues: {counts} (board {command} --queue <person>, or --queue all)')
    if summary['unrouted']:
        section('unrouted', [unrouted_row(board, issue) for issue in summary['unrouted']])
    if summary['blocking']:
        section("blocking yours, in other people's queues", [line(issue, f"queue {board.queue(issue['id'])}") for issue in summary['blocking']])


def queue_line(board: Board, root: str | None) -> str | None:
    """The queue rows in one line, for the console pane."""
    summary = queue_summary(board, root)
    if summary is None:
        return None
    parts = ([f"other queues: {', '.join(f'{queue} {count}' for queue, count in sorted(summary['others'].items()))}"] if summary['others'] else []) \
        + ([f"unrouted: {', '.join(issue['id'] for issue in summary['unrouted'])}"
            + (f" ({len(summary['inbox'])} for you)" if summary['inbox'] else '')] if summary['unrouted'] else []) \
        + ([f"blocking yours: {', '.join(issue['id'] for issue in summary['blocking'])}"] if summary['blocking'] else [])
    return ' · '.join(parts) or None


def queues_json(board: Board, root: str | None) -> dict:
    """The queue fields of a --json view; none without a filter, so an unshared board's JSON stays as it was."""
    summary = queue_summary(board, root)
    if summary is None:
        return {}
    return {'queues': {'view': board.view, 'others': summary['others'],
                       'unrouted': [item_json(board, issue, queues=board.queues(issue['id']), waitingSince=waiting_since(issue) or None)
                                    for issue in summary['unrouted']],
                       'inbox': [item_json(board, issue, waitingSince=waiting_since(issue) or None) for issue in summary['inbox']],
                       'toSend': [item_json(board, issue) for issue in summary['toSend']],
                       'blocking': [item_json(board, issue, queue=board.queue(issue['id'])) for issue in summary['blocking']]}}


def health_json(board: Board, args) -> dict:
    views = health_views(board, args.root)
    ready = views['ready'][1]
    found = deviations(board, args.root)
    counts = {JSON_COUNTS.get(view, view): len(rows) for view, (_, rows) in views.items()}
    return {**queues_json(board, args.root), 'counts': counts,
            'claimable': {kind: sum(1 for i in ready if board.claimable(i) == kind) for kind in KINDS},
            'items': {JSON_COUNTS.get(view, view): [item_json(board, issue) for issue in sorted(views[view][1], key=by_priority)]
                      for view in HEALTH_VIEWS if view in args.items},
            'milestones': milestone_states(board, args.root),
            'deviations': {'count': len(found), 'reviewBlocked': sum(1 for _, kind, _ in found if kind == 'review-blocked')}}


def health(board: Board, args) -> None:
    views = health_views(board, args.root)
    for view, (name, rows) in views.items():
        print(f'{name}: {len(rows)}')
        if view == 'ready':
            counts = {kind: sum(1 for i in rows if board.claimable(i) == kind) for kind in KINDS}
            print('  by kind: ' + ', '.join(f'{pull} {count}' for pull, count in counts.items()))
        if view in args.items:
            listed = [line(issue, issue.get('assignee') or '') for issue in sorted(rows, key=by_priority)]
            for row in listed[:args.limit] if args.limit else listed:
                print(row)
            if args.limit and len(listed) > args.limit:
                print(f'  ... {len(listed) - args.limit} more')
    for state in milestone_states(board, args.root):
        print(f"milestone {state['id']} ({state['title']}): open work {state['openWork']}, "
              f"ready {state['ready']}, held {state['held']}, "
              f"blocked {state['blocked']}; milestone {'ready' if state['milestoneReady'] else 'not ready'}")
    found = deviations(board, args.root)
    if found:
        stuck = sum(1 for _, kind, _ in found if kind == 'review-blocked')  # fixed by board return, not a migration
        hints = (['run /board-migrate'] if stuck < len(found) else []) + ([f'{stuck} in review while blocked: board check'] if stuck else [])
        print(f"convention deviations: {len(found)} — {'; '.join(hints)}")
    queue_rows(board, args.root, 'health')


def registry_by_actor(entries: list[dict]) -> dict[str, dict]:
    known: dict[str, dict] = {}
    for entry in sorted(entries, key=lambda e: e.get('registered_at') or ''):
        known[entry.get('actor') or ''] = entry
    return known


def holder_label(holder: str, known: dict[str, dict]) -> str:
    entry = known.get(session_actor(holder))
    if entry is None:
        return holder
    pulls = f" {'+'.join(entry.get('pulls') or [])}" if entry.get('pulls') else ''
    return f"{holder} ({entry.get('role')}{pulls}, {entry.get('tool') or 'tool unknown'})"


def session_activity(entry: dict) -> datetime | None:
    """The session's last tool call, its own or a running worker's; None without activity data (hooks not live)."""
    if not hooks_live(entry):
        return None
    moments = [parse_time(entry.get('active_at')), *(parse_time(m) for m in (entry.get('workers') or {}).values())]
    return max((m for m in moments if m is not None), default=None)


def session_state(entry: dict, now: datetime) -> str | None:
    """'gone' (its registered process ended), 'active' or 'idle' (last activity within IDLE_HOURS or not), None
    unknown (no activity data). The console's 'stopped' has no session-level board state: a stopped worker is
    marked on its item (board mine)."""
    if liveness(entry) == 'GONE':
        return 'gone'
    latest = session_activity(entry)
    if latest is None:
        return None
    return 'active' if (now - latest).total_seconds() <= IDLE_HOURS * 3600 else 'idle'


def position_data(board: Board, args) -> dict:
    """What `board position` shows: ready work per kind against the sessions handling it, sessions, held items with
    their marks, questions holding work, ready milestones and finished epics."""
    items = [issue for issue in board.listed(args.root) if issue['status'] != 'closed']
    # One bd call for the held items' comments and the epics with no open child (all their children may be closed).
    board.hydrate([*board.held_ids(), *(issue['id'] for issue in items if issue.get('issue_type') == 'epic'
                                        and not any(board.is_open(child) for child in board.children.get(issue['id'], [])))])
    known = registry_by_actor(registrations())
    now = utcnow()
    ready = [issue for issue in items if board.claimable(issue)]
    held = sorted((issue for issue in items if issue.get('assignee') and issue.get('issue_type') != 'epic'),
                  key=lambda issue: (issue['assignee'], by_priority(issue)))
    holding = {session_actor(issue['assignee']) for issue in held}
    project = board_project()
    horizon = now - timedelta(hours=SESSION_HOURS)

    def recent(entry: dict) -> bool:
        moments = (parse_time(entry.get('registered_at')), session_activity(entry))
        return max((m for m in moments if m is not None), default=now) > horizon

    sessions = [entry for entry in known.values()
                if entry.get('actor') in holding
                or (project is not None and entry.get('project') == project and recent(entry))]
    kinds = {kind: {'ready': sum(1 for issue in ready if board.claimable(issue) == kind),
                    'sessions': sum(1 for entry in sessions if kind in session_kinds(entry, ROLE_HANDLES))}
             for kind in KINDS}
    holds = []
    for issue in held:
        entry = known.get(session_actor(issue['assignee']))
        updated = board.last_activity(issue)
        recorded = holder_activity(entry, issue['assignee'])
        activity = recorded or updated
        gone = liveness(entry) == 'GONE'
        idle = not gone and (activity is None or (now - activity).total_seconds() > IDLE_HOURS * 3600)
        # This machine can't know another machine's session: no idleness to claim, nothing to offer.
        elsewhere = shared is not None and entry is None and bool(ACTOR.fullmatch(issue['assignee']))
        holds.append((issue, entry, updated, recorded, 'elsewhere' if elsewhere else 'gone' if gone else 'idle' if idle else None))
    questions = sorted(((board.holds(issue['id']), issue) for issue in items
                        if issue.get('issue_type') == 'decision' and issue['status'] not in ('released', 'deferred')),
                       key=lambda pair: (-pair[0][0], -pair[0][1], by_priority(pair[1])))
    return {
        'kinds': kinds, 'known': known, 'now': now,
        'sessions': [(entry, sum(1 for issue in held if session_actor(issue['assignee']) == entry.get('actor')))
                     for entry in sessions],
        'held': holds,
        'questions': [(waiting, issue) for waiting, issue in questions if waiting[1]],
        'milestones': sorted((i for i in items if board.kind(i) == 'milestone' and not board.open_blockers(i['id'])),
                             key=by_priority),
        'finished': sorted((issue for issue in items if board.finished_epic(issue)), key=by_priority),
    }


def iso(moment: datetime | None) -> str | None:
    return moment.astimezone(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ') if moment else None


def session_json(board: Board, args, entry: dict, holds: int, now: datetime) -> dict:
    state = session_state(entry, now)
    kinds = session_kinds(entry)
    return {'session': entry.get('session'), 'role': entry.get('role'), 'actor': entry.get('actor'),
            'pulls': entry.get('pulls') or [], 'tool': entry.get('tool'),
            'handles': list(session_kinds(entry, ROLE_HANDLES)), 'registeredAt': entry.get('registered_at'), 'holds': holds,
            # Without live activity hooks no worker marker is trustworthy.
            'workers': {'active': len(active_workers(entry)), 'cap': worker_cap(entry)} if hooks_live(entry) else None,
            'process': {'alive': 'alive', 'GONE': 'gone'}.get(liveness(entry) or ''),
            'state': state, 'idleSince': iso(session_activity(entry)) if state == 'idle' else None,
            # what its bare `board claim` would take
            'claimable': sum(1 for issue in board.listed(args.root) if board.claimable(issue) in kinds)}


def position_json(board: Board, args) -> dict:
    data = position_data(board, args)
    return {
        **queues_json(board, args.root),
        'ready': data['kinds'],
        'sessions': [session_json(board, args, entry, count, data['now']) for entry, count in data['sessions']],
        'held': [item_json(board, issue, updatedAt=iso(updated), activeAt=iso(recorded), mark=mark)
                 for issue, _, updated, recorded, mark in data['held']],
        'questionsHoldingWork': [item_json(board, issue, holds=waiting[0], holdsAll=waiting[1]) for waiting, issue in data['questions']],
        'readyMilestones': [item_json(board, issue) for issue in data['milestones']],
        'finishedEpics': [item_json(board, issue) for issue in data['finished']],
    }


def position(board: Board, args) -> None:
    data = position_data(board, args)
    known = data['known']
    print('ready work by kind vs sessions handling it:')
    for kind, counts in data['kinds'].items():
        print(f"  {kind}: {counts['ready']} ready, {counts['sessions']} sessions")
    limit = args.limit
    section(f'sessions (holding items here, or of this project and registered or active within {SESSION_HOURS} h)',
            [f"  {entry.get('actor')}  {entry.get('role')}  {entry.get('tool') or 'tool unknown'}"
             f"  handles {','.join(session_kinds(entry, ROLE_HANDLES)) or '-'}  registered {age(parse_time(entry.get('registered_at')))} ago"
             f"  holds {count}"
             f"  workers {len(active_workers(entry))}/{worker_cap(entry)}"
             + {'alive': '  process alive', 'GONE': '  GONE'}.get(liveness(entry) or '', '')
             for entry, count in data['sessions']], limit)

    idle, gone = [], []
    rows = []
    for issue, _, updated, recorded, mark in data['held']:
        marker = {'gone': ' GONE', 'idle': ' IDLE', 'elsewhere': ' held elsewhere'}.get(mark or '', '')
        rows.append(line(issue, holder_label(issue['assignee'], known), f'updated {age(updated)} ago'
                         + (f', active {age(recorded)} ago' if recorded else '') + marker))
        if mark == 'idle':
            idle.append(issue['id'])
        elif mark == 'gone':
            gone.append(issue['id'])
    section('held items', rows, limit)
    if gone:
        print(f"  GONE = the holding session's process ended. Free {', '.join(gone)}: board take <id> | board unclaim <id> (the user or a deciding session)")
    if idle:
        print(f'  idle = no activity for {IDLE_HOURS} h. '
              'If that session is gone: board take <id> | board unclaim <id> (the user or a deciding session)')

    section('open questions holding work',
            [line(issue, f'holds {waiting[0]}/{waiting[1]}', issue.get('assignee') or 'unassigned') for waiting, issue in data['questions']],
            limit)
    if data['questions']:
        print(f'  {HOLDS_LEGEND}')
    section('ready milestones', [line(issue, issue.get('assignee') or 'unassigned') for issue in data['milestones']], limit)
    section('finished epics not closed', [line(issue) for issue in data['finished']], limit)
    queue_rows(board, args.root, 'position')


def session_kinds(entry: dict, table: dict = ROLE_KINDS) -> tuple[str, ...]:
    kinds = table.get(entry.get('role'), ())
    return tuple(entry.get('pulls') or ()) if kinds is None else kinds


def holders(board: Board, args) -> None:
    rows = []
    for issue in board.listed(args.root):
        if issue['status'] != 'closed':
            count = board.holds(issue['id'])
            if count[1]:
                rows.append((count, issue))
    rows.sort(key=lambda pair: (-pair[0][0], -pair[0][1], by_priority(pair[1])))
    section('items holding open work (transitive blocks dependents)',
            [line(issue, f'holds {count[0]}/{count[1]}', issue.get('assignee') or 'unassigned') for count, issue in rows], args.limit)
    if rows:
        print(f'  {HOLDS_LEGEND}')
    queue_rows(board, args.root, 'holders')


# Conformance with skills/shared/board-core.md and board-coordination.md: mechanical classes only.
ACTOR = re.compile(r'[0-9a-f]{8}(/.+)?')
TITLE_PREFIXES = ('[Design]', '[Gate]', '[Checkpoint]', '[Review]')
RETIRED_TYPES = ('feature', 'chore', 'check')
CHECK_CLASSES = {  # class -> board-core anchor
    'holder': 'actors-and-holds',
    'retired-type': 'kinds',
    'title-prefix': 'kinds',
    'release-gate': 'kinds',
    'label-status': 'statuses-and-labels',
    'review-blocked': 'hand-over-and-acceptance',
}
# Squashed text (words run together): a flag, never a deviation. Calibrated on
# the retro's samples (tools/ctx): clean board text 0 per 1,000 words, prompt
# text 8.8, squashed board text 210.
SQUASH_PER_1K = 50
SQUASH_MIN_HITS = 2
WORD_LIST = Path('/usr/share/dict/words')
EXTRA_WORDS = {'lint', 'typecheck', 'json', 'readonly', 'repo', 'config', 'dms', 'orm', 'api', 'ai', 'auth', 'pass',
               'fronts', 'checkpoint', 'workers', 'worker', 'diagnostics', 'integration', 'preexisting', 'canonical',
               'held', 'scoped', 'errors', 'queue', 'install', 'workaround', 'workarounds'}
SUFFIXES = ('s', 'es', 'ed', 'd', 'ing', 'ly', 'ized', 'ised', 'ation', 'ations', 'ies')


def deviations(board: Board, root: str | None) -> list[tuple[str, str, str]]:
    """(id, class, detail) for every convention deviation of a live (not closed) item in scope."""
    found = []
    for issue in board.scoped(root):
        item_id, kind, title = issue['id'], issue.get('issue_type'), issue.get('title', '')
        if issue['status'] == 'closed':
            continue  # closed items are immutable history
        holder = issue.get('assignee')
        if holder and holder != 'user' and not ACTOR.fullmatch(holder):
            found.append((item_id, 'holder', f'held by {holder}'))
        if kind in RETIRED_TYPES:
            found.append((item_id, 'retired-type', f'type {kind}'))
        prefix = next((p for p in TITLE_PREFIXES if title.startswith(p)), None)
        if prefix:
            found.append((item_id, 'title-prefix', f'title starts with {prefix}'))
        if kind == 'gate' and title.startswith('[Gate] Release'):
            found.append((item_id, 'release-gate', 'release gate title'))
        labels = sorted(set(issue.get('labels') or []) & set(LIFECYCLE_LABELS))
        if labels:
            found.append((item_id, 'label-status', f"labels {', '.join(labels)}"))
        waits = board.open_blockers(item_id) if issue['status'] == 'in_review' else []
        if waits:
            found.append((item_id, 'review-blocked', f"in review while waiting on {', '.join(waits)}: "
                                                     f'claim it and board return {item_id} "<amend to the blocker>"'))
    return found


# Passive forms first: "revised by <id>" means <id> revises this record.
REVISION_WORDS = re.compile(r'\b(?:(?P<passive>(?:revised|superseded|replaced)\s+by)|'
                            r'(?P<active>revis(?:es|ing|ion of)|supersed(?:es|ing)|replac(?:es|ing)))\b', re.IGNORECASE)
ITEM_ID = re.compile(r'[A-Za-z0-9][\w-]*(?:\.[\w-]+)*')
REJECTED = re.compile(r'^##\s+alternatives considered\b.*?(?=^##\s|\Z)', re.IGNORECASE | re.MULTILINE | re.DOTALL)
WINDOW = 60  # characters after the verb searched for the record it names


def unlinked_revision_rows(board: Board, root: str | None) -> list[dict]:
    """One row per live decision whose editable text says it revises, supersedes or replaces another decision (or is
    revised by one) without a supersedes or revise edge between them: {id, other, word, old, new}. Comments are
    history (moved packets quote old records); rejected alternatives describe what the record does not do."""
    flagged = []
    for issue in board.scoped(root):
        if issue['status'] == 'closed' or issue.get('issue_type') != 'decision':
            continue
        text = '\n'.join(REJECTED.sub('', str(issue.get(f) or '')) for f in ('title', 'description', 'design', 'notes'))
        named: dict[str, tuple[str, bool]] = {}  # other id -> (verb, other revises this one)
        covered = 0
        for match in REVISION_WORDS.finditer(text):
            if match.start() < covered:
                continue  # inside the previous verb's window ("revised by the superseding rulings: <id>")
            covered = match.end() + WINDOW
            for other in ITEM_ID.findall(text[match.end():covered]):
                if other != issue['id'] and board.by_id.get(other, {}).get('issue_type') == 'decision':
                    named.setdefault(other, (' '.join(match.group(0).lower().split()), bool(match.group('passive'))))
        for other, (word, passive) in named.items():
            if not any(kind in ('supersedes', REVISES) for _, _, kind in board.between(issue['id'], other)):
                old, new = (issue['id'], other) if passive else (other, issue['id'])
                flagged.append({'id': issue['id'], 'other': other, 'word': word, 'old': old, 'new': new})
    return flagged


def unlinked_revisions(board: Board, root: str | None) -> list[tuple[str, str]]:
    """(id, detail) per row of unlinked_revision_rows."""
    return [(row['id'], f"{row['word']} {row['other']} without a supersedes or revise link: board supersede "
                        f"{row['old']} --with {row['new']} [--partial \"<rule>\"]")
            for row in unlinked_revision_rows(board, root)]


def unnamed_waits(board: Board, root: str | None) -> list[tuple[str, str]]:
    """(id, detail) per open blocker a live item's text does not name: a flag, never a deviation, because bd keeps
    no reason on the edge and legacy waits have none to recover."""
    flagged = []
    for issue in board.scoped(root):
        if issue['status'] == 'closed' or issue.get('issue_type') == 'milestone':
            continue  # a milestone's blockers are its members (board-coordination.md#milestones)
        text = board.text(issue)
        # A gate carries its own reason (bd gate create --reason); a closed blocker holds nothing up.
        flagged += [(issue['id'], f'waits on {b} without naming it') for b in board.blockers.get(issue['id'], [])
                    if b not in text and board.is_open(b) and board.by_id.get(b, {}).get('issue_type') != 'gate']
    return flagged


def word_list() -> set[str]:
    try:
        words = {w.strip().lower() for w in WORD_LIST.read_text(encoding='utf-8', errors='ignore').split() if len(w.strip()) >= 3}
    except OSError:
        words = set()
    return words | EXTRA_WORDS


class Squash:
    """Port of the retro's detect.py: letter-digit runs and long lowercase
    tokens that split into dictionary words. Without a word list only the
    letter-digit runs count."""

    def __init__(self, words: set[str]):
        self.words = words
        self.cache: dict[tuple[str, int], bool] = {}

    def split(self, text: str, depth: int = 0) -> bool:
        key = (text, depth)
        if key not in self.cache:
            if text in self.words and depth > 0:
                result = True
            elif depth >= 3:
                result = False
            else:
                result = any(text[:i] in self.words and self.split(text[i:], depth + 1) for i in range(3, len(text) - 2))
            self.cache[key] = result
        return self.cache[key]

    def squashed(self, token: str) -> bool:
        if re.fullmatch(r'[A-Za-z]+\d+[A-Za-z]{3,}|\d+[a-z]{4,}[A-Z]*|[a-z]{3,}\d+[a-z]*', token):
            return True
        if not self.words or not re.fullmatch(r'[A-Z]?[a-z]{10,}', token):
            return False
        lower = token.lower()
        if lower in self.words or any(lower.endswith(x) and lower[:-len(x)] in self.words for x in SUFFIXES) \
                or (lower.endswith('ies') and lower[:-3] + 'y' in self.words):
            return False
        return self.split(lower)

    def score(self, texts: list[str]) -> tuple[int, int, list[str]]:
        words, hits = 0, []
        for text in texts:
            for token in re.split(r'[\s,;:()\[\]"\'→=+]+', re.sub(r'`[^`]*`', '', text)):
                token = token.strip('.!?')
                if not token:
                    continue
                words += 1
                if not any(c in token for c in '/._-') and self.squashed(token):
                    hits.append(token)
        return words, len(hits), hits


def squash_flags(board: Board, root: str | None, words: set[str]) -> list[tuple[str, str]]:
    squash = Squash(words)
    flagged = []
    for issue in board.scoped(root):
        if issue['status'] == 'closed':
            continue
        # Editable fields only: comments are history.
        texts = [str(issue.get(f) or '') for f in ('title', 'description', 'design', 'acceptance_criteria', 'notes')]
        total, hits, examples = squash.score(texts)
        if hits >= SQUASH_MIN_HITS and 1000 * hits / max(total, 1) > SQUASH_PER_1K:
            flagged.append((issue['id'], f"{1000 * hits / total:.0f} squashed per 1,000 words, e.g. {', '.join(examples[:3])}"))
    return flagged


def check_json(board: Board, args) -> dict:
    """Every finding of `board check`, unbudgeted: deviations by class, then the flags."""
    return {'deviations': [{'id': item_id, 'class': kind, 'detail': detail} for item_id, kind, detail in deviations(board, args.root)],
            'squashed': [{'id': item_id, 'detail': detail} for item_id, detail in squash_flags(board, args.root, word_list())],
            'unnamedBlockers': [{'id': item_id, 'detail': detail} for item_id, detail in unnamed_waits(board, args.root)],
            'unlinkedRevisions': unlinked_revision_rows(board, args.root)}


def check(board: Board, args) -> int:
    limit = args.limit
    found = deviations(board, args.root)
    print(f'convention deviations: {len(found)}')
    for name, anchor in CHECK_CLASSES.items():
        rows = [f'  {item_id}  {name}  board-core.md#{anchor}  {detail}'
                for item_id, kind, detail in found if kind == name]
        if rows:
            section(f'{name} (board-core.md#{anchor})', rows, limit)
    words = word_list()
    flags = squash_flags(board, args.root, words)
    note = '' if len(words) > len(EXTRA_WORDS) else f'; no word list at {WORD_LIST}, letter-digit runs only'
    section(f'flag, not a deviation: squashed text on open items{note}',
            [f'  {item_id}  squashed  {detail}' for item_id, detail in flags], limit)
    section('flag, not a deviation: unnamed waits on open items (board-core.md#dependencies)',
            [f'  {item_id}  unnamed-blocker  {detail}' for item_id, detail in unnamed_waits(board, args.root)], limit)
    section('flag, not a deviation: revisions without a supersedes or revise link (board-coordination.md#rulings)',
            [f'  {item_id}  unlinked-revision  {detail}' for item_id, detail in unlinked_revisions(board, args.root)], limit)
    return 1 if found else 0


STOPWORDS = set("""a about after all also an and any are as at be because been before being both but by can could do
does each either for from had has have how if in into is it its may might more most must no not of on once only or other
our out over own same should so such than that the their them then there these they this those through to under until up
use used uses using via was we were what when where whether which while who why will with without would you your""".split())
COMMON_SHARE = 0.2  # a --like word on more of the board's items than this says nothing about the draft
LIKE_TERMS = 15


def lowered(board: Board, issue: dict) -> str:
    cache = board.__dict__.setdefault('_lowered', {})
    if issue['id'] not in cache:
        cache[issue['id']] = board.text(issue).lower()
    return cache[issue['id']]


def related_data(board: Board, args) -> tuple[list[str], list[str], list[tuple[int, dict]], list[tuple[Path, int, str]]]:
    """(terms, words chosen from --like, [(matched terms, item)] rarest matches first, [(doc, line number, text)]).
    Ranks by inverse document frequency: a rare shared word says more than a template word every item carries."""
    scoped = board.scoped(args.root)
    texts = [(issue, lowered(board, issue)) for issue in scoped]
    total = max(len(texts), 1)
    frequency: dict[str, int] = {}

    def weight(term: str) -> float:
        if term not in frequency:
            frequency[term] = sum(1 for _, text in texts if term in text)
        return math.log((total + 1) / (frequency[term] + 1))

    terms = list(dict.fromkeys(term.lower() for term in args.terms))
    chosen = []
    if args.like is not None:
        words = dict.fromkeys(w for w in re.findall(r'[a-z][a-z0-9_.-]*[a-z0-9]', args.like.lower())
                              if len(w) >= 3 and w not in STOPWORDS and w not in terms)
        for word in words:
            weight(word)  # fills frequency
        # A word on no item matches nothing; one on many items is template text.
        candidates = [w for w in words if 0 < frequency[w] <= COMMON_SHARE * total]
        chosen = sorted(candidates, key=lambda w: (-weight(w), w))[:LIKE_TERMS]
        terms += chosen
    rows = []
    for issue, text in texts:
        hits = [term for term in terms if term in text]
        if hits:
            rows.append((sum(weight(term) for term in hits), len(hits), issue))
    rows.sort(key=lambda row: (-row[0], -row[1], by_priority(row[2])))
    matches = []
    for root in (part for value in args.docs for part in value.split(',') if part.strip()):
        path = Path(root.strip())
        files = sorted(path.rglob('*.md')) if path.is_dir() else [path]
        for file in files:
            try:
                lines = file.read_text(encoding='utf-8').splitlines()
            except (OSError, UnicodeDecodeError) as error:
                raise BoardError(f'cannot read {file}: {error}') from None
            matches += [(file, number, text.strip()) for number, text in enumerate(lines, 1)
                        if any(term in text.lower() for term in terms)]
    return terms, chosen, [(count, issue) for _, count, issue in rows], matches


def foreign_queue(board: Board, issue: dict) -> str | None:
    """The queue to name on an item from someone else's: never on an unshared board."""
    if shared is None:
        return None
    queue = board.queue(issue['id'])
    return queue if queue and queue != person() else None


def related_json(board: Board, args) -> dict:
    terms, chosen, rows, docs = related_data(board, args)
    shown = (lambda rows: rows[:args.limit]) if args.limit else (lambda rows: rows)
    return {'terms': terms, 'like': chosen,
            'items': [{'id': issue['id'], 'status': issue['status'], 'type': issue.get('issue_type'),
                       'priority': issue.get('priority'), 'holder': issue.get('assignee') or None,
                       'title': issue.get('title', ''), 'matched': count, 'of': len(terms),
                       **({'queue': foreign_queue(board, issue)} if foreign_queue(board, issue) else {})} for count, issue in shown(rows)],
            'docs': [{'path': str(file), 'line': number, 'text': text} for file, number, text in shown(docs)]}


def related(board: Board, args) -> None:
    terms, chosen, rows, docs = related_data(board, args)
    like = f"; from --like: {', '.join(chosen) or 'no distinctive words'}" if args.like is not None else ''
    section(f"items matching {', '.join(terms)}, rarest matches first (all text fields, closed included{like})",
            [line(issue, f'{count}/{len(terms)} terms', issue.get('assignee') or 'unassigned',
                  f'queue {foreign_queue(board, issue)}' if foreign_queue(board, issue) else '') for count, issue in rows],
            args.limit)
    if args.docs:
        section('doc lines', [f'  {file}:{number}: {text}' for file, number, text in docs], args.limit)


def queue(board: Board, args) -> None:
    ready = sorted((issue for issue in board.listed(args.root) if board.claimable(issue)),
                   key=lambda issue: claim_order(board, issue))

    def marker(issue: dict) -> str:
        milestones = board.in_milestone.get(issue['id'])
        return f"m:{','.join(milestones)}" if milestones else ''

    for kind in KINDS:
        section(kind, [line(issue, f"p{issue.get('priority', '?')}", marker(issue))
                       for issue in ready if board.claimable(issue) == kind], args.limit)
    queue_rows(board, args.root, 'queue')


# board show: items rendered from the snapshot, unwrapped, within READ_BUDGET (`--full` lifts it).

LINK_KINDS = {  # (type, outgoing) -> label from the shown item's side; order is print order
    ('blocks', True): 'blocked by', ('blocks', False): 'blocks', ('parent-child', True): 'parent',
    ('parent-child', False): 'children', ('relates-to', True): 'relates to', ('relates-to', False): 'relates to',
    ('related', True): 'relates to', ('related', False): 'relates to', ('supersedes', False): 'supersedes',
    ('supersedes', True): 'superseded by', ('discovered-from', True): 'discovered from',
    ('discovered-from', False): 'discovered here',
}
LINK_ORDER = ('blocked by', 'blocks', 'parent', 'children', 'relates to', 'supersedes', 'superseded by',
              'discovered from', 'discovered here', 'revises', 'revision pending')
HEADING = re.compile(r'^(#{2,3})\s+(.+?)\s*#*\s*$')


def normalized(name: str) -> str:
    return ' '.join(name.replace('_', ' ').lower().split())


def comment_list(issue: dict) -> list[dict]:
    return [{'author': c.get('author'), 'created_at': c.get('created_at'), 'text': c.get('text') or ''}
            for c in sorted(issue.get('comments') or [], key=lambda c: c.get('created_at') or '')]


def link_lines(board: Board, issue: dict) -> list[str]:
    grouped: dict[str, list[str]] = {}
    for other, kind, outgoing in board.edges.get(issue['id'], []):
        if kind == REVISES and issue.get('issue_type') == 'decision' and outgoing:
            label = 'revises'
        elif kind == REVISES and not outgoing and board.by_id.get(other, {}).get('issue_type') == 'decision':
            label = 'revision pending'
        else:
            label = LINK_KINDS.get((kind, outgoing), kind if outgoing else f'{kind} (from)')
        target = board.by_id.get(other, {})
        new = issue if label == 'revises' else target if label == 'revision pending' else {}
        rule = (new.get('metadata') or {}).get(REVISES_RULE) if isinstance(new.get('metadata'), dict) else None
        grouped.setdefault(label, []).append(f"  {label}: {other}  {target.get('status', 'not on board')}  "
                                             f"{target.get('title', '')}" + (f'  (partial: {rule})' if rule else ''))
    order = [*LINK_ORDER, *sorted(set(grouped) - set(LINK_ORDER))]
    return [row for label in order for row in sorted(set(grouped.get(label, [])))]  # relates-to may be stored twice


def field_units(issue: dict, field: str) -> list[tuple[str, str]]:
    """(section name, text) chunks of one field: its preamble under the field name, then one per heading."""
    text = str(issue.get(field) or '').strip('\n')
    if not text.strip():
        return []
    units, name, chunk = [], field, [f'{field}:']
    for row in text.splitlines():
        heading = HEADING.match(row)
        if heading:
            if name == field and len(chunk) == 1:  # no preamble: the field label leads its first heading
                name = heading.group(2)
                chunk.append(row)
                continue
            units.append((name, '\n'.join(chunk)))
            name, chunk = heading.group(2), [row]
        else:
            chunk.append(row)
    units.append((name, '\n'.join(chunk)))
    return units


def section_text(issue: dict, field: str, title: str) -> str:
    """A heading's text through the next heading of the same or a higher level."""
    rows, level, out = str(issue.get(field) or '').splitlines(), None, []
    for row in rows:
        heading = HEADING.match(row)
        if level is not None and heading and len(heading.group(1)) <= level:
            break
        if level is None and heading and heading.group(2) == title:
            level = len(heading.group(1))
        if level is not None:
            out.append(row)
    return '\n'.join(out)


def show_sections(board: Board, issue: dict, query: str) -> list[tuple[str, str]]:
    candidates = [(field, f'{field}:\n' + str(issue.get(field)).strip('\n')) for field in SHOW_FIELDS
                  if str(issue.get(field) or '').strip()]
    links = link_lines(board, issue)
    if links:
        candidates.append(('links', 'links:\n' + '\n'.join(links)))
    for field in SHOW_FIELDS:
        candidates += [(name, section_text(issue, field, name)) for name, _ in field_units(issue, field)[1:]
                       if name != field]
    wanted = normalized(query)
    matches = [c for c in candidates if normalized(c[0]) == wanted] \
        or [c for c in candidates if normalized(c[0]).startswith(wanted)]
    names = sorted({name for name, _ in matches})
    if not matches:
        raise BoardError(f"{issue['id']}: no section {query!r}; sections: " + ', '.join(dict.fromkeys(n for n, _ in candidates)))
    if len(names) > 1:
        raise BoardError(f"{issue['id']}: section {query!r} is ambiguous:\n" + '\n'.join(
            f'  board show {issue["id"]} --section {shlex.quote(name)}' for name in names))
    return matches


class Budget:
    """Prints units whole while the budget lasts; a unit that doesn't fit prints its first PREVIEW characters and
    the command that prints the rest. Past the budget, one line per item names the remaining sections."""

    def __init__(self, limit: int | None):
        self.remaining, self.skipped = limit, {}

    def out(self, text: str) -> None:
        """Always printed (headers, counts, footers); still spends the budget."""
        print(text)
        if self.remaining is not None:
            self.remaining -= len(text) + 1

    def emit(self, text: str, rest: str, name: str | None = None, item: str | None = None) -> None:
        if self.remaining is None or len(text) + 1 <= self.remaining - 300:  # 300: room for the closing lines
            self.out(text)
        elif self.remaining >= PREVIEW + 500:
            cut = text[:PREVIEW]
            self.out(f'{cut}\n… {len(text) - len(cut)} more chars: {rest}')
        else:
            self.skipped.setdefault(item, []).append((name, rest))

    def flush(self, item: str) -> None:
        skipped = self.skipped.pop(item, [])
        if skipped:
            names = ', '.join(f'"{name}"' for name, _ in skipped[:20]) + (', …' if len(skipped) > 20 else '')
            self.out(f'… {len(skipped)} more sections of {item} ({names}): {skipped[0][1]}')


def show(board: Board, args) -> int:
    missing = [item_id for item_id in args.ids if item_id not in board.by_id]
    if missing:
        raise BoardError(f"unknown {', '.join(missing)}")
    issues = [board.by_id[item_id] for item_id in args.ids]
    known = {key for issue in board.issues for key in issue} | ITEM_FIELDS
    unknown = [field for field in args.fields if field not in known]
    if unknown:
        raise BoardError(f"unknown field {', '.join(unknown)}; fields: {', '.join(sorted(known - {'_type'}))}")
    if args.json:
        if not args.fields:
            raise BoardError('--json needs --field <field> (repeatable)')
        print(json.dumps({issue['id']: {field: comment_list(issue) if field == 'comments' else issue.get(field)
                                        for field in args.fields} for issue in issues}, indent=2, ensure_ascii=False))
        return 0
    budget = Budget(None if args.full else READ_BUDGET)
    full = ' --full'
    for issue in issues:
        item_id = issue['id']
        q = shlex.quote
        header = [item_id, issue['status'], issue.get('issue_type', ''), f"p{issue.get('priority', '?')}",
                  issue.get('assignee') or 'unassigned']
        if item_id in board.parent:
            header.append(f'parent {board.parent[item_id]}')
        if issue.get('labels'):
            header.append('labels ' + ','.join(issue['labels']))
        if shared is not None:
            header.append(f"queue {board.queue(item_id) or 'unrouted'}")
        budget.out('  '.join(header) + '\n' + issue.get('title', ''))
        selected = bool(args.sections or args.fields or args.comments)
        for query in args.sections:
            for name, text in show_sections(board, issue, query):
                budget.emit(text, f'board show {item_id} --section {q(name)}{full}', name, item_id)
        for field in args.fields:
            value = comment_list(issue) if field == 'comments' else issue.get(field)
            text = f'{field}:\n' + (value.strip('\n') if isinstance(value, str) else json.dumps(value, ensure_ascii=False))
            budget.emit(text, f'board show {item_id} --field {q(field)}{full}', field, item_id)
        if not selected:
            links = link_lines(board, issue)
            if links:
                budget.emit('links:\n' + '\n'.join(links), f'board show {item_id} --section links', 'links', item_id)
            for field in SHOW_FIELDS:
                for name, text in field_units(issue, field):
                    budget.emit(text, f'board show {item_id} --section {q(name)}', name, item_id)
        comments = comment_list(issue)
        if args.comments or not selected:
            if args.comments and not args.sections and not args.fields:
                budget.out(f'comments only: board show {item_id} --full prints the whole item')
            shown = comments if args.comments else comments[-SHOWN_COMMENTS:]
            if comments:
                budget.out(f'comments: {len(comments)}' + (f', newest {len(shown)}' if len(shown) < len(comments) else ''))
            for note in reversed(shown):
                budget.emit(f"--- {note['author']} {note['created_at']}\n{note['text']}",
                            f'board show {item_id} --comments --full', f"comment {note['created_at']}", item_id)
            if len(shown) < len(comments):
                budget.out(f'… {len(comments) - len(shown)} older: board show {item_id} --comments')
        budget.flush(item_id)
    return 0


def budgeted(run, board: Board, args, argv: list[str]) -> int:
    """Runs a view within READ_BUDGET. Rows are the indented lines; --offset skips that many, keeping the heading of
    the section it lands in. A cut names the --offset that prints the next rows."""
    output = io.StringIO()
    with contextlib.redirect_stdout(output):
        code = run(board, args) or 0
    lines = output.getvalue().splitlines()
    kept, size, row, pending, cut, heading = [], 0, 0, [], None, None
    for text in lines:
        is_row = text.startswith('  ')
        if row < args.offset:
            if is_row:
                row += 1
                pending = [heading] if heading else []  # the section heading prints again before its next shown row
            else:
                heading = text
                pending.append(text)
            continue
        block = [*pending, text] if is_row else [text]
        cost = sum(len(item) + 1 for item in block)
        if size + cost > READ_BUDGET - 300:
            cut = row
            break
        kept += block
        size += cost
        pending = []
        row += is_row
    if pending and cut is None:
        kept += pending
    print('\n'.join(kept))
    if cut is not None:
        words, skip = [], False
        for word in argv:
            if skip:
                skip = False
            elif word == '--offset':
                skip = True
            elif not word.startswith('--offset='):
                words.append(word)
        total = sum(1 for text in lines if text.startswith('  '))
        print(f'… {total - cut} more rows: board {shlex.join([*words, "--offset", str(cut)])}')
    return code


# Writes

def caller() -> str:
    actor = derived_actor()
    if not actor:
        raise BoardError('no actor: run inside a Claude Code or Codex session, or set BEADS_ACTOR')
    return actor


HANDOVER = 'board handover: '


def authorship(board: Board, issue: dict) -> tuple[str | None, str | None]:
    """(author, legacy holder): who handed the item over, from its handover comment,
    else bd's status history; a hand-over by a pre-actor holder (goal-agent) is legacy."""
    legacy = None
    board.hydrate(i['id'] for i in board.issues if i['status'] == 'in_review')  # a status read carries no comments
    for note in sorted(issue.get('comments') or [], key=lambda c: c.get('created_at') or '', reverse=True):
        if (note.get('text') or '').startswith(HANDOVER):
            if ACTOR.fullmatch(note.get('author') or ''):
                return note['author'], None
            legacy = legacy or note.get('author')
    for event in json.loads(bd_checked('history', issue['id'], '--events', '--json') or '[]'):
        try:
            status = json.loads(event.get('new_value') or '{}').get('status')
        except (ValueError, AttributeError):
            continue
        if event.get('event_type') == 'status_changed' and status == 'in_review':
            if ACTOR.fullmatch(event.get('actor') or ''):
                return event['actor'], None
            legacy = legacy or event.get('actor')
    return None, legacy


def author_label(board: Board, issue: dict) -> str:
    actor, legacy = authorship(board, issue)
    return f'author {actor}' if actor else f'author unknown ({legacy})' if legacy else 'standalone'


def held_by_session(board: Board, actor: str) -> list[dict]:
    session = session_actor(actor)
    return sorted((issue for issue in board.issues if issue['status'] != 'closed' and issue.get('assignee')
                   and (issue['assignee'] == session or issue['assignee'].startswith(session + '/'))),
                  key=by_priority)


def mine_data(board: Board, args) -> tuple[str, list[tuple[dict, bool]]]:
    """(caller actor, [(item held by its session, worker stopped)])."""
    actor = caller()
    board.hydrate(board.held_ids())
    scoped = {issue['id'] for issue in board.scoped(args.root)}
    try:
        entry = registry_by_actor(registrations()).get(session_actor(actor))
    except BoardError:
        entry = None  # no marks without the registry; the holds still list
    return actor, [(issue, worker_stopped(entry, issue)) for issue in held_by_session(board, actor) if issue['id'] in scoped]


def console_json(board: Board, args) -> dict:
    """What the console pane draws, from one snapshot: health counts, this session's holds, the sessions and every
    hold with its idle or gone mark."""
    position = position_json(board, args)
    return {**({'sync': (shared.problem() or shared.store_warning()), 'queueLine': queue_line(board, args.root)} if shared else {}),
            'counts': health_json(board, args)['counts'], 'items': mine_json(board, args)['items'],
            'sessions': position['sessions'],
            'held': [{'id': h['id'], 'holder': h['holder'], 'mark': h['mark']} for h in position['held']]}


def console(board: Board, args) -> None:
    print(json.dumps(console_json(board, args), indent=2, ensure_ascii=False))


def mine_json(board: Board, args) -> dict:
    actor, rows = mine_data(board, args)
    return {'session': session_actor(actor), 'actor': actor,
            'items': [item_json(board, issue, updatedAt=iso(board.last_activity(issue)), workerStopped=stopped)
                      for issue, stopped in rows]}


def mine(board: Board, args) -> None:
    actor, held_rows = mine_data(board, args)
    you = f' (you: {actor})' if actor != session_actor(actor) else ''
    rows, stopped = [], []
    for issue, mark in held_rows:
        rows.append(line(issue, issue['assignee'], f'updated {age(board.last_activity(issue))} ago'
                         + (' WORKER STOPPED' if mark else '')))
        if mark:
            stopped.append(issue['id'])
    section(f'held by session {session_actor(actor)}{you}', rows, args.limit)
    if stopped:
        print(f"  WORKER STOPPED = the holding worker finished its last turn ({', '.join(stopped)}): "
              'continue the worker, hand the item over, or free it (board unclaim <id>)')


def capacity(board: Board, args) -> None:
    """The session's refill hint: printed for the session itself (no worker caller) in a dispatching role while
    fewer than its cap of workers were active and worker work (WORKER_KINDS, an agent's within its pulls) is
    claimable. A session's own hand-overs count: another of its workers may review them. The snapshot predates a write, so the
    items the command named or claimed are left out (one read per command). Never fails the command it follows."""
    actor = derived_actor()
    if not actor or actor != session_actor(actor):
        return
    try:
        entry = registry_by_actor(registrations()).get(actor)
        if entry is None or entry.get('role') not in CAPACITY_ROLES:
            return
        active, cap = len(active_workers(entry)), worker_cap(entry)
        if active >= cap:
            return
        pulls = entry.get('pulls') or ()
        kinds = tuple(kind for kind in WORKER_KINDS if entry.get('role') != 'agent' or kind in pulls)
        changed = {*(getattr(args, 'ids', None) or ()), getattr(args, 'id', None), *getattr(args, 'claimed', ())}
        counts = {kind: sum(1 for issue in board.listed(args.root)
                            if board.claimable(issue) == kind and issue['id'] not in changed) for kind in kinds}
    except BoardError:
        return
    ready = sorted(((kind, count) for kind, count in counts.items() if count), key=lambda pair: -pair[1])
    if ready:
        print(f"capacity: {active} of {cap} workers active in the last {WORKER_ACTIVE_MINUTES} min; "
              f"ready for your pulls: {', '.join(f'{kind} {count}' for kind, count in ready)} → refill (plan Dispatch)")


def claim_one(issue: dict, actor: str) -> tuple[bool, str]:
    """Atomically claim one item. Open items use bd's claim; in_review and
    released items keep their status through a compare-and-set on the assignee."""
    if issue['status'] == 'open':
        result = bd('update', issue['id'], '--claim', '--json')
    else:
        result = bd('update', issue['id'], '--assignee', actor, '--if-assignee', '', '--json')
    return result.returncode == 0, (result.stderr or result.stdout).strip()


def foreign_claim(board: Board, item_id: str) -> str | None:
    """Why this item can't be claimed from this queue, with the move that allows it: another person's queue, or none
    (unrouted, an inbox item included) until a lead routes it."""
    if shared is None:
        return None
    queue, mine = board.queue(item_id), person()
    if queue == mine and queue is not None:
        return None
    if queue is None:
        names = ','.join(board.queues(item_id))
        why = f'parents in queues {names}' if names else 'no queue'
        return f'{item_id}: unrouted ({why}); a lead or solo session routes it first: board route <person> {item_id}'
    return f"{item_id}: in {queue}'s queue; a lead or solo session moves it first: board route {mine or '<you>'} {item_id}"


def claim(board: Board, args) -> int:
    actor = caller()
    claimed, failed = [], []
    if args.ids:
        for item_id in args.ids:
            issue = board.by_id.get(item_id)
            if issue is None or issue['status'] == 'closed':
                raise BoardError(f'{item_id}: unknown or closed')
            holder = issue.get('assignee')
            if holder == actor:
                print(f'{item_id}: already held by {actor}')  # bin/protocol reads this line (claim_items)
                continue
            if holder and session_actor(holder) == session_actor(actor):
                # The session owns its workers' holds (design item 16): hand the item down.
                bd_checked('update', item_id, '--assignee', actor, '--force', '--json')
                comment(item_id, f'board claim: {actor} took this item over from {holder} in the same session.')
                claimed.append(issue)
                continue
            refusal = foreign_claim(board, item_id)
            if refusal:
                failed.append(item_id)
                print(refusal, file=sys.stderr)
                continue
            if holder and shared is not None and ACTOR.fullmatch(holder) and session_actor(holder) not in registry_by_actor(registrations()):
                failed.append(item_id)
                print(f'{item_id}: held elsewhere by {holder}, updated {age(board.last_activity(issue))} ago', file=sys.stderr)
                continue
            if holder:
                failed.append(item_id)
                print(f'{item_id}: held by {holder}; the user or a deciding session frees it with board take or board unclaim once its session is gone',
                      file=sys.stderr)
                continue
            if board.kind(issue) == 'milestone' and board.open_blockers(item_id):
                # Accepting a milestone needs its work done (board-coordination.md#milestones).
                failed.append(item_id)
                print(f"{item_id}: milestone not ready, waits on {', '.join(board.open_blockers(item_id))}", file=sys.stderr)
                continue
            ok, message = claim_one(issue, actor)
            if ok:
                claimed.append(issue)
            else:
                failed.append(item_id)
                print(f'{item_id}: not claimed: {message}', file=sys.stderr)
    else:
        entry = registry_by_actor(registrations()).get(session_actor(actor))
        if entry is None:
            raise BoardError(f'no registered role for session {session_actor(actor)}; run /role first')
        if shared is not None and person() is None:
            raise BoardError(f'a bare claim takes from your queue: {PERSON_HELP}')
        kinds = session_kinds(entry)
        scoped = board.listed(args.root)
        candidates = sorted((issue for issue in scoped if board.claimable(issue) in kinds),
                            key=lambda issue: claim_order(board, issue))
        for issue in candidates:
            if issue['status'] == 'in_review' and authorship(board, issue)[0] == actor:
                continue  # your own hand-over needs another reviewer
            ok, _ = claim_one(issue, actor)
            if ok:
                claimed.append(issue)
                break
        if not claimed:
            print(f"nothing claimable for {entry.get('role')} ({','.join(kinds)})")
    args.claimed = [issue['id'] for issue in claimed]
    for issue in claimed:
        by = f'; {author_label(board, issue)}' if issue['status'] == 'in_review' else ''
        print(f"claimed {issue['id']} ({board.kind(issue) or issue.get('issue_type')}{by}): {issue.get('title', '')}")
    still = [issue for issue in held_by_session(board, actor) if issue not in claimed]
    if still:
        section('this session still holds', [line(issue, issue['assignee']) for issue in still])
    return 1 if failed or not (claimed or args.ids) else 0


def comment(item_id: str, text: str) -> None:
    bd_checked('comments', 'add', item_id, text)


def require_open(board: Board, ids: list[str]) -> list[dict]:
    missing = [item_id for item_id in ids if not board.is_open(item_id)]
    if missing:
        raise BoardError(f"unknown or closed: {', '.join(missing)}")
    return [board.by_id[item_id] for item_id in ids]


def take(board: Board, args) -> None:
    actor = caller()
    for issue in require_open(board, args.ids):
        refusal = foreign_claim(board, issue['id'])
        if refusal:
            raise BoardError(refusal)
        previous = issue.get('assignee') or 'nobody'
        if previous == actor:
            print(f"{issue['id']}: already held by {actor}")
            continue
        bd_checked('update', issue['id'], '--assignee', actor, '--force', '--json')
        comment(issue['id'], f'board take: {actor} took this item over from {previous}.')
        print(f"took {issue['id']} from {previous}")


def unclaim(board: Board, args) -> None:
    actor = caller()
    for issue in require_open(board, args.ids):
        holder = issue.get('assignee')
        if not holder:
            print(f"{issue['id']}: not held")
            continue
        reason = f"board unclaim: {actor} released {holder}'s hold."
        if issue['status'] == 'in_progress':
            # bd unclaim resets to open; it refuses other statuses.
            bd_checked('unclaim', issue['id'], '--reason', reason, *(['--force'] if holder != actor else []))
        else:
            # in_review and released items keep their status for the next claimer.
            bd_checked('update', issue['id'], '--assignee', '', '--json')
            comment(issue['id'], reason)
        print(f"unclaimed {issue['id']} from {holder} ({issue['status']})")


def held(board: Board, item_id: str, actor: str, status: str | None = None) -> dict:
    issue = require_open(board, [item_id])[0]
    if issue.get('assignee') != actor or (status and issue['status'] != status):
        raise BoardError(f"{item_id}: {issue['status']}, held by {issue.get('assignee') or 'nobody'}; claim it first")
    return issue


def handover(board: Board, args) -> None:
    actor = caller()
    held(board, args.id, actor)
    bd_checked('update', args.id, '--status', 'in_review', '--assignee', '', '--if-assignee', actor, '--json')
    comment(args.id, HANDOVER + args.evidence)
    print(f'handed over {args.id} for review')


def return_item(board: Board, args) -> None:
    actor = caller()
    held(board, args.id, actor, 'in_review')
    bd_checked('update', args.id, '--status', 'open', '--assignee', '', '--if-assignee', actor, '--json')
    comment(args.id, f'board return: {args.findings}')
    print(f'returned {args.id} to the queue')


SHOW_PASSTHROUGH = ('--refs', '--children', '--as-of', '--long', '--watch', '--current', '--thread', '-w', '-h', '--help')
GLOBAL_VALUES = ('-C', '--directory', '--db', '--database', '--actor', '--dolt-auto-commit', '--mem-profile')
SHOW_USAGE = 'use board show <ids> [--section …] [--field …] [--comments] [--full]'


def passthrough(argv: list[str]) -> int:
    if argv[:1] == ['dolt'] and argv[1:2] in (['start'], ['restart']):
        raise BoardError('board starts the server before every bd call; rerun the failing command with elevated sandbox permissions')
    at = 0
    while at < len(argv) and argv[at].startswith('-'):
        at += 2 if argv[at] in GLOBAL_VALUES else 1
    command, rest = (argv[at], argv[at + 1:]) if at < len(argv) else ('', [])
    flags = {arg.split('=', 1)[0] for arg in rest}
    if command == 'edit':
        print('board: bd edit opens an editor and blocks; edit fields with board bd update --title/--description/--design/--acceptance',
              file=sys.stderr)
        return 2
    if '--readonly' in {arg.split('=', 1)[0] for arg in argv[:at]} | flags:
        print('board: bd --readonly is refused; run the command without it (a server-mode board needs elevated sandbox '
              'permissions, and board starts the server)', file=sys.stderr)
        return 2
    # Raw show output is padded and wraps; it cut most agent reads mid-item. board show renders and budgets it.
    if (command in ('show', 'view') and not flags & set(SHOW_PASSTHROUGH)) \
            or (command == 'comments' and rest[:1] != ['add'] and not flags & {'-h', '--help'}):
        print(f'board: {SHOW_USAGE}', file=sys.stderr)
        return 2
    if command in ('list', 'create', 'query') and any(
            pair in (('--type', 'question'), ('-t', 'question')) for pair in zip(rest, rest[1:])) \
            or any(arg in ('--type=question', '-t=question') or re.search(r'\btype\s*=\s*"?question\b', arg)
                   for arg in rest if command in ('list', 'create', 'query')):
        print('board: questions are type decision (--type decision; open ones have status open)', file=sys.stderr)
        return 2
    if command == 'dolt' and rest[:2] == ['remote', 'add']:
        print('board: a Dolt remote alone shares nothing; board share shares the board (queues, sync, config)', file=sys.stderr)
    directory = next((argv[i + 1] for i, arg in enumerate(argv[:-1]) if arg in ('-C', '--directory')),
                     next((arg.split('=', 1)[1] for arg in argv if arg.startswith('--directory=')), None))
    ensure_server(Path(directory) if directory else None)
    if shared is not None and derived_actor():
        refusal = queue_guard(command, rest)
        if refusal:
            print(f'board: {refusal}', file=sys.stderr)
            return 2
    argv = [*argv[:at], *rewritten_create(command, rest)]
    if shared is None:
        os.execvpe('bd', ['bd', *argv], bd_env())
    return run_shared(argv, flags)


def run_shared(argv: list[str], flags: set[str]) -> int:
    """A child, not an exec: board still has to retry a write and start the wait. A person's terminal and --watch keep
    the terminal, without the retry: bd may prompt, and capturing would hide it."""
    if sys.stdin.isatty() or flags & {'--watch', '-w'}:
        return subprocess.run(['bd', *argv], env=bd_env()).returncode
    reads_stdin = argv[:1] == ['batch'] or any(arg in ('-', '--stdin') or arg.endswith('=-') for arg in argv)
    result = bd(*argv, stdin=sys.stdin.read() if reads_stdin else None)
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    # A manual sync says as much about the remote as the wait's own.
    if argv[:1] == ['sync'] or argv[:2] in (['dolt', 'pull'], ['dolt', 'push']):
        if result.returncode == 0:
            shared.succeeded()
            shared.path('pulled').touch()
            shared.check_moved()
        elif result.returncode == 2:
            shared.failed('', 'conflict')
    return result.returncode


def flag_values(rest: list[str], *names: str) -> list[str]:
    """Every value of these flags, `--flag value` and `--flag=value`, comma lists split."""
    values = []
    for at, arg in enumerate(rest):
        name, equals, value = arg.partition('=')
        if name in names:
            value = value if equals else (rest[at + 1] if at + 1 < len(rest) else '')
            values += [part for part in value.split(',') if part]
    return values


def positionals(rest: list[str]) -> list[str]:
    """Arguments before the first flag: the ids `bd update`, `bd label` and `bd dep` start with."""
    return list(itertools.takewhile(lambda arg: not arg.startswith('-'), rest))


def queue_labels(labels: list[str]) -> list[str]:
    return [label for label in labels if label.startswith(QUEUE_PREFIX)]


def queue_guard(command: str, rest: list[str]) -> str | None:
    """Why this `board bd` command is refused on a shared board: a claim across queues, or a move by a session that may
    not. A move is any change to an item's queue: its label, or its parent when it inherits."""
    subcommand = rest[0] if rest else ''
    if command == 'update' and not positionals(rest) and {arg.split('=')[0] for arg in rest} & {'--claim', '--parent', '--set-labels'}:
        return 'name the ids first: board bd update <ids> <flags>'
    if command == 'update' and '--claim' in rest:
        ids = positionals(rest)
        board = Board.load('ids', ids)
        return next(filter(None, (foreign_claim(board, item_id) for item_id in ids if item_id in board.by_id)), None)
    moved = None
    if command == 'label' and subcommand in ('add', 'remove', 'propagate') and queue_labels(rest[1:]):
        moved = 'a queue label'
    elif command == 'update':
        ids = positionals(rest)
        added = flag_values(rest, '--add-label', '--remove-label')
        replaced = flag_values(rest, '--set-labels') if any(arg.split('=')[0] == '--set-labels' for arg in rest) else None
        board = Board.load('ids', ids) if ids and (replaced is not None or '--parent' in {a.split('=')[0] for a in rest}) else None
        if queue_labels(added):
            moved = 'a queue label'
        elif replaced is not None and any(sorted(queue_labels(board.routing(i)[0])) != sorted(queue_labels(replaced)) for i in ids):
            moved = 'a queue label'
        elif board is not None and '--parent' in {a.split('=')[0] for a in rest}:
            target = next(iter(flag_values(rest, '--parent')), None)
            for item_id in ids:
                if not queue_labels(board.routing(item_id)[0]) and board.queues(item_id) != (board.queues(target) if target else []):
                    moved = "an item's parent, which moves it to the parent's queue"
    elif command == 'dep' and subcommand in ('add', 'remove'):
        kinds = flag_values(rest, '--type', '-t')
        pair = positionals(rest[1:])
        file_text = ''.join(Path(path).read_text(encoding='utf-8') for path in flag_values(rest, '--file') if path != '-' and Path(path).is_file())
        if 'parent-child' in file_text:
            moved = "an item's parent"
        elif len(pair) == 2 and (subcommand == 'remove' or 'parent-child' in kinds or 'parent-child' in rest):
            board = Board.load('ids', pair[:1])
            child, target = pair
            if not queue_labels(board.routing(child)[0]) and (subcommand == 'add' or target in board.parents.get(child, [])) \
                    and board.queues(child) != (board.queues(target) if subcommand == 'add' else []):
                moved = "an item's parent, which moves it"
    elif command == 'sql':
        text = ' '.join(rest)
        if re.search(r'\b(insert|update|delete|replace)\b', text, re.IGNORECASE) \
                and re.search(r'\b(labels|dependencies)\b|queue:', text, re.IGNORECASE):
            moved = 'labels or links through SQL'
    elif command == 'batch' and 'parent-child' in rest:
        moved = "an item's parent"
    elif command in ('create', 'new', 'q'):
        mine = QUEUE_PREFIX + (person() or '')
        graph = next(iter(flag_values(rest, '--graph')), None)
        named = queue_labels(flag_values(rest, '-l', '--labels', '--label'))
        if graph:
            nodes = graph_plan(graph).get('nodes') or []
            named += queue_labels([label for node in nodes for label in node.get('labels') or []])
        if any(label != mine for label in named):
            moved = "an item into someone else's queue"
    if moved and not may_move():
        return (f'only lead and solo sessions change {moved}; file a find for another person with board create --for '
                '<person>, and ask your lead to route the rest (board route)')
    return None


def rewritten_create(command: str, rest: list[str], board: Board | None = None) -> list[str]:
    """The one rewrite of `create --parent`: a plain hash id plus a parent link. A dotted child id stops sync when two
    clones create under one parent (child_counters conflict). The link inherits no labels, so the parent's are copied;
    the queue label stays behind, since the child inherits its queue through the link. On a shared board a top-level
    item takes its creator's queue. Returns the command and its arguments; `board` spares a read when it holds the parent."""
    if command not in ('create', 'new', 'q'):
        return [command, *rest] if command else rest
    parent = next(iter(flag_values(rest, '--parent')), None)
    labels = flag_values(rest, '-l', '--labels', '--label')
    kept, skip = [], False
    for arg in rest:
        if skip:
            skip = False
        elif arg == '--parent':
            skip = True
        elif not arg.startswith('--parent='):
            kept.append(arg)
    added: list[str] = []
    if parent:
        if command == 'q':  # bd q takes neither --deps nor a description, which a board's create.require-description wants
            raise BoardError('q has no plain-id form with a parent: board bd create <title> --parent <id> --description <text> --silent')
        if board:  # its snapshot holds every item
            records = [board.by_id[parent]] if parent in board.by_id else []
        else:
            records = bd_show([parent])
        if not records:
            raise BoardError(f'unknown parent {parent}')
        if '--no-inherit-labels' not in kept:
            added = [label for label in records[0].get('labels') or [] if not label.startswith(QUEUE_PREFIX) and label not in labels]
        kept += ['--deps', f"parent-child:{records[0]['id']}"]
    elif shared is not None and person() and not queue_labels(labels):
        graph = next(iter(flag_values(kept, '--graph')), None)
        if graph:
            return [command, *graph_with_queue(kept, graph)]
        added = [QUEUE_PREFIX + person()]
    return [command, *kept, *(['--labels', ','.join(added)] if added else [])]


def graph_plan(path: str) -> dict:
    """The `create --graph` plan; empty when unreadable, which bd reports better when it runs."""
    try:
        plan = json.loads(Path(path).read_text(encoding='utf-8'))
    except (OSError, ValueError):
        return {}
    return plan if isinstance(plan, dict) else {}


def graph_with_queue(args: list[str], path: str) -> list[str]:
    """A plan whose parentless nodes carry the creator's queue, in a temp copy; graph ids are already plain."""
    plan = graph_plan(path)
    if not plan:
        return args
    children = {edge.get('from') for edge in plan.get('edges') or [] if edge.get('type') == 'parent-child'}
    for node in plan.get('nodes') or []:
        if not node.get('parent') and node.get('key') not in children and not queue_labels(node.get('labels') or []):
            node['labels'] = [*(node.get('labels') or []), QUEUE_PREFIX + person()]
    with tempfile.NamedTemporaryFile('w', suffix='.json', encoding='utf-8', delete=False) as handle:
        json.dump(plan, handle)
    atexit.register(os.unlink, handle.name)
    return [handle.name if arg == path else (f'--graph={handle.name}' if arg == f'--graph={path}' else arg) for arg in args]


def with_file(text: str, run):
    """Long text goes to bd through a file, never argv."""
    with tempfile.NamedTemporaryFile('w', suffix='.md', encoding='utf-8', delete=False) as handle:
        handle.write(text)
    try:
        return run(handle.name)
    finally:
        os.unlink(handle.name)


def comment_long(item_id: str, text: str) -> None:
    with_file(text, lambda path: bd_checked('comments', 'add', item_id, '-f', path))


def missing_sections(text: str, sections=RECORD_SECTIONS) -> list[str]:
    headings = [normalized(match.group(1)) for match in re.finditer(r'^##\s+(.+?)\s*$', text, re.MULTILINE)]
    return [name for name in sections if not any(heading.startswith(normalized(name)) for heading in headings)]


def section_body(text: str, name: str) -> str | None:
    """The body of the record's `## <name>` section (to the next `##` heading), None when it has none."""
    parts = re.split(r'^##\s+(.+?)\s*$', text, flags=re.MULTILINE)
    return next((parts[i + 1].strip() for i in range(1, len(parts) - 1, 2) if normalized(parts[i]).startswith(normalized(name))), None)


def record(board: Board, args) -> None:
    actor = caller()
    issue = held(board, args.id, actor)
    board.hydrate([args.id])  # the packet move below reads the item's comments
    if issue.get('issue_type') != 'decision':
        raise BoardError(f'{args.id}: {issue.get("issue_type")}, not a decision')
    if issue['status'] not in ('open', 'in_progress', 'decided', 'needs_ratification'):
        raise BoardError(f"{args.id}: {issue['status']}; a released record changes through board revise")
    try:
        text = Path(args.file).read_text(encoding='utf-8')
    except (OSError, UnicodeDecodeError) as error:
        raise BoardError(f'cannot read {args.file}: {error}') from None
    # Autopilot's unratified rulings carry how to reverse them (unattended protocol).
    required = RECORD_SECTIONS + (('Reversal',) if args.status == 'needs_ratification' else ())
    missing = missing_sections(text, required)
    if missing:
        raise BoardError(f"{args.file} lacks the record section(s) {', '.join('## ' + name for name in missing)}")
    old = str(issue.get('description') or '').strip()
    moved = ''
    if old and missing_sections(old):
        packet = f'Decision packet (moved from the description at decision time, {utcnow().date().isoformat()}):\n\n{old}'
        # A rerun after a failed update finds the packet already moved.
        if not any((c.get('text') or '').endswith(f'\n\n{old}') and (c.get('text') or '').startswith('Decision packet (moved')
                   for c in issue.get('comments') or []):
            comment_long(args.id, packet)
        moved = '; packet moved to a comment'
    # A rewrite keeps the Decision it replaces in a comment (the description holds one). A rerun after a failed update finds it.
    before = section_body(old, 'Decision') if issue['status'] == 'decided' and not missing_sections(old, ('Decision',)) else None
    if before and before != section_body(text, 'Decision') \
            and not any((c.get('text') or '').endswith(f'\n\n{before}') and (c.get('text') or '').startswith('Previous Decision')
                        for c in issue.get('comments') or []):
        comment_long(args.id, f'Previous Decision (replaced {utcnow().date().isoformat()}):\n\n{before}')
        moved += '; previous Decision kept in a comment'
    # An unratified autopilot record waits unheld for the user's ratification; a decided one stays held to release.
    unheld = ['--assignee', ''] if args.status == 'needs_ratification' else []
    bd_checked('update', args.id, '--body-file', args.file, '--status', args.status, *unheld, '--json')
    lint = json.loads(bd_checked('lint', args.id, '--json') or '{}')
    unlinted = [', '.join(result.get('missing') or []) for result in lint.get('results') or [] if result.get('missing')]
    if unlinted:
        raise BoardError(f"{args.id}: recorded ({args.status}{moved}), but bd lint reports missing {'; '.join(unlinted)}")
    print(f"recorded {args.id} ({args.status}{moved}): {issue.get('title', '')}")


def block_one(board: Board, item_id: str, blocker: str, reason: str, actor: str) -> tuple[str, bool]:
    """Blocks one item with its reason as a comment. (result line, returned from review)."""
    issue = board.by_id[item_id]
    edges = board.between(item_id, blocker)
    other = [kind for a, _, kind in edges if kind not in ('relates-to', 'related') and not (kind == 'blocks' and a == item_id)]
    if other:
        raise BoardError(f"{item_id}: already linked to {blocker} by {', '.join(other)}; bd keeps one edge per pair")
    # bd allows one edge per pair: a relates-to link between the two gives way to the wait.
    operations = [f'dep remove {a} {b}' for a, b, kind in edges if kind in ('relates-to', 'related')]
    if not any(kind == 'blocks' for _, _, kind in edges):
        operations.append(f'dep add {item_id} {blocker} blocks')
    holder = issue.get('assignee')
    reviewing = issue['status'] == 'in_review' and board.is_open(blocker)
    returning = reviewing and not holder
    if returning:
        # An unheld review waiting on an open blocker would be accepted against a moving premise (hand-over).
        operations.append(f'update {item_id} status=open assignee=""')
    if operations:
        bd_checked('batch', '-m', f'board block {item_id} --on {blocker}', '--json', stdin='\n'.join(operations) + '\n')
    # The comment names the wait for board check (unnamed waits read comments too); an append to a field would
    # rewrite it and lose a concurrent edit.
    comment(item_id, f'Blocked by {blocker}: {reason}')
    result = f'blocked {item_id} on {blocker}'
    if returning:
        comment(item_id, f'board block: returned from review; amend to {blocker}: {reason}')
        result += '; returned from review to open'
    elif reviewing and holder != actor:
        print(f'{item_id}: in review held by {holder}; it stays there, tell its holder about {blocker}', file=sys.stderr)
        result += f'; stays in review with {holder}'
    return result, returning


def block_items(board: Board, ids: list[str], blocker: str, reason: str, actor: str) -> tuple[list[str], list[str]]:
    """Blocks each item, one result line each; (returned from review, failed)."""
    returned, failed = [], []
    for item_id in ids:
        try:
            if item_id == blocker:
                raise BoardError(f'{item_id}: cannot block an item on itself')
            require_open(board, [item_id])
            result, back = block_one(board, item_id, blocker, reason, actor)
            print(result)
            returned += [item_id] if back else []
        except BoardError as error:
            failed.append(item_id)
            print(f'{item_id}: not blocked: {error}', file=sys.stderr)
    return returned, failed


def block(board: Board, args) -> int:
    actor = caller()
    if args.blocker not in board.by_id:
        raise BoardError(f'unknown blocker {args.blocker}')
    _, failed = block_items(board, args.ids, args.blocker, args.reason, actor)
    return 1 if failed else 0


def revise(board: Board, args) -> None:
    caller()
    old = board.by_id.get(args.old)
    if old is None or old.get('issue_type') != 'decision':
        raise BoardError(f'{args.old}: unknown or not a decision')
    if old['status'] in ('open', 'in_progress'):
        raise BoardError(f"{args.old}: {old['status']}, not yet a ruling; amend the question instead")
    parent = args.parent or board.parent.get(args.old)
    labels = [label for value in args.labels for label in value.split(',') if label] if args.labels \
        else [label for label in old.get('labels') or [] if label.startswith('topic:')]
    command = ['create', '--type', 'decision', '--title', args.title, '--body-file', args.body_file,
               '--priority', str(args.priority if args.priority is not None else old.get('priority', 2)),
               '--deps', f'{REVISES}:{args.old}']
    command += ['--parent', parent] if parent else []
    command += ['--labels', ','.join(labels)] if labels else []
    command += ['--metadata', json.dumps({REVISES_RULE: args.partial})] if args.partial is not None else []
    command += ['--external-ref', args.external_ref] if args.external_ref else []
    created = json.loads(bd_checked(*rewritten_create(command[0], command[1:], board), '--json') or '{}')
    new = created.get('id') if isinstance(created, dict) else None
    if not new:
        raise BoardError(f'bd create returned no id: {created!r}')
    print(new)


def release(board: Board, args) -> int:
    """Releases the decided rulings, supersedes the records they revise, then closes the questions they answer.
    Resumable: a ruling already released and a question already closed are done; a failed revise supersede of an
    already released ruling is retried (its revise link stays until it succeeds)."""
    actor = caller()
    rulings = require_open(board, args.ids)
    problems = []
    for issue in rulings:
        if issue.get('issue_type') != 'decision':
            problems.append(f"{issue['id']}: not a decision")
        elif issue['status'] not in ('decided', 'released'):
            problems.append(f"{issue['id']}: {issue['status']}, not decided")
        blocking = [b for b in board.unsettled_blockers(issue['id']) if b not in args.ids]
        if blocking and issue['status'] == 'decided':
            named = ', '.join(f"{b} ({board.by_id.get(b, {}).get('status', 'not found')})" for b in blocking)
            problems.append(f"{issue['id']}: waits on {named}")
        # A decided record a live question revises is about to be replaced: releasing it puts it in force first
        # (a board revise opened outside a round; Record closes the replaced record).
        live = [other for other in board.revised_by(issue['id']) if board.is_open(other) and other not in args.ids]
        if live and issue['status'] == 'decided':
            problems.append(f"{issue['id']}: revised by {', '.join(live)}, not closed or released with it; close the "
                            'revision (board supersede), or release them together')
    closes = []
    for question, records in args.closes:
        issue = board.by_id.get(question)
        if issue is None:
            problems.append(f'{question}: unknown')
        elif issue['status'] == 'closed':
            print(f'{question}: already closed')
            continue
        elif issue.get('issue_type') != 'decision' or issue['status'] not in ('open', 'in_progress'):
            problems.append(f"{question}: {issue['status']} {issue.get('issue_type')}, not an open question")
        elif issue.get('assignee') and session_actor(issue['assignee']) != session_actor(actor):
            problems.append(f"{question}: held by {issue['assignee']}; hand it off before closing it")
        unknown = [record for record in records if record not in args.ids]
        if unknown:
            problems.append(f"{question}: answered by {', '.join(unknown)}, which this call does not release")
        closes.append((question, records))
    if problems:
        raise BoardError('release refused:\n  ' + '\n  '.join(problems))

    pending = [issue for issue in rulings if issue['status'] == 'decided']
    if pending:
        lint = json.loads(bd_checked('lint', *(issue['id'] for issue in pending), '--json') or '{}')
        unlinted = [f"{result['id']}: missing {', '.join(result.get('missing') or [])}"
                    for result in lint.get('results') or [] if result.get('missing')]
        if unlinted:
            raise BoardError('release refused, record text fails bd lint (write the record first):\n  ' + '\n  '.join(unlinted))
        # A released ruling keeps blocking the items it changes; planning closes it and unblocks them.
        operations = [f"update {issue['id']} status=released assignee=\"\"" for issue in pending]
        bd_checked('batch', '-m', f"board release {' '.join(issue['id'] for issue in pending)}", '--json',
                   stdin='\n'.join(operations) + '\n')
    returned, failed = [], []
    for issue in rulings:
        print(f"{'released' if issue in pending else 'already released'} {issue['id']}: {issue.get('title', '')}")
        metadata = issue.get('metadata') if isinstance(issue.get('metadata'), dict) else {}
        for old in board.revises(issue['id']):
            back, lost = supersede_chain(board, old, issue['id'], metadata.get(REVISES_RULE), actor, {issue['id']})
            returned += back
            failed += lost
    if returned:
        print(f"returned from review: {', '.join(returned)}")
    left = close_answered(board, closes, set(args.ids))
    return 1 if failed or left else 0


def close_answered(board: Board, closes: list[tuple[str, list[str]]], released: set[str]) -> list[str]:
    """Closes each answered question once every unsettled blocker is a ruling of this release or a question closed
    before it here (dependency order); forces only past those and released rulings. Returns the questions left open."""
    closed: set[str] = set()
    pending = list(closes)
    while pending:
        progress = False
        for question, records in list(pending):
            blockers = board.open_blockers(question)
            if any(b not in released and b not in closed for b in board.unsettled_blockers(question)):
                continue
            pending.remove((question, records))
            result = bd('close', question, '--reason', f"Answered by released {', '.join(records)}",
                        *(['--force'] if blockers else []))
            if result.returncode != 0:
                print(f'{question}: not closed: {(result.stderr or result.stdout).strip()}', file=sys.stderr)
                continue
            closed.add(question)
            progress = True
            print(f"closed {question}: answered by released {', '.join(records)}")
        if not progress:
            break
    for question, _ in pending:
        others = [b for b in board.unsettled_blockers(question) if b not in released and b not in closed]
        print(f"{question}: left open, blocked by {', '.join(others) or 'a question not closed'}", file=sys.stderr)
    return [question for question, _ in closes if question not in closed]


def rule_of(issue: dict) -> str | None:
    metadata = issue.get('metadata') if isinstance(issue.get('metadata'), dict) else {}
    return metadata.get(REVISES_RULE)


def supersede_chain(board: Board, old: str, new: str, rule: str | None, actor: str, seen: set[str]) -> tuple[list[str], list[str]]:
    """supersede_pair, then follows the chain: a record replaced whole that itself revises another leaves that one to
    `new` too, with the replaced record's own rule, through unreleased records to the first released one.
    (returned from review, failed records)."""
    if old in seen:
        return [], []
    seen.add(old)
    try:
        returned, failed = supersede_pair(board, old, new, rule, actor)
    except BoardError as error:
        print(f"{old}: not superseded by {new}: {error}; finish with board supersede {old} --with {new}"
              + (f' --partial {shlex.quote(rule)}' if rule is not None else ''), file=sys.stderr)
        return [], [old]
    if rule is not None:
        return returned, failed
    for earlier in board.revises(old):
        more_returned, more_failed = supersede_chain(board, earlier, new, rule_of(board.by_id[old]), actor, seen)
        returned += more_returned
        failed += more_failed
    return returned, failed


def carry_revisions(board: Board, old: str, new: str) -> list[str]:
    """`dep` operations that move the revisions `old` still has pending to `new` (which replaces it whole), and the
    rule's metadata write first: a rerun after a partial failure repeats the same write. Returns the operations."""
    targets = [t for t in board.revises(old) if t != new]
    if not targets:
        return []
    own = [t for t in board.revises(new) if t != old]
    rule, new_rule = rule_of(board.by_id[old]), rule_of(board.by_id[new])
    if own and (set(own) != set(targets) or rule != new_rule):
        raise BoardError(f"{new} already revises {', '.join(own)} and {old} revises {', '.join(targets)}; bd keeps one "
                         'revision rule per record: finish the revisions one record at a time')
    if rule is not None and rule != new_rule:
        bd_checked('update', new, '--set-metadata', f'{REVISES_RULE}={rule}', '--json')
    operations = []
    for target in targets:
        operations.append(f'dep remove {old} {target}')
        if target not in own:
            operations += [f'dep remove {a} {b}' for a, b, kind in board.between(new, target) if kind != 'parent-child']
            operations.append(f'dep add {new} {target} {REVISES}')
    return operations


def supersede_pair(board: Board, old: str, new: str, rule: str | None, actor: str, carry: bool = False) -> tuple[list[str], list[str]]:
    """Supersedes old by new, wholly or (rule not None) one rule; (returned from review, failed items). `carry`: a
    whole replacement takes over the revisions the old record still has pending."""
    # bd allows one edge per pair: drop an existing link between the two records (a revise link included) first.
    operations = [f'dep remove {a} {b}' for a, b, kind in board.between(old, new) if kind != 'parent-child']
    carried = carry_revisions(board, old, new) if carry and rule is None else []
    if rule is not None:
        operations.append(f'dep add {old} {new} supersedes')
    operations += carried
    if operations:
        bd_checked('batch', '-m', f'board supersede {old} --with {new}', '--json', stdin='\n'.join(operations) + '\n')
    if rule is not None:
        if rule:
            comment(old, f'board supersede: rule "{rule}" superseded by {new}.')
        print(f"{old}: one rule{f' ({rule})' if rule else ''} superseded by {new}")
        return [], []
    # The new record restates the whole rule: the old record's open items wait for its planning.
    items = sorted(i for i in board.related.get(old, set()) | set(board.dependents.get(old, []))
                   if i != new and board.is_open(i)
                   and all(kind in ('relates-to', 'related') for _, _, kind in board.between(i, new)))
    returned, failed = block_items(board, items, new, f'supersedes {old}; replan against it', actor)
    bd_checked('supersede', old, '--with', new)
    print(f"superseded {old} by {new}; blocked {', '.join(i for i in items if i not in failed) or 'none'}"
          + (f"; revision of {', '.join(board.revises(old))} now pending on {new}" if carried else ''))
    return returned, failed


def supersede(board: Board, args) -> int:
    actor = caller()
    if args.old not in board.by_id:
        raise BoardError(f'unknown {args.old}')
    if args.partial is None:
        require_open(board, [args.new])  # a full replacement blocks items on the new record until it is planned
    elif args.new not in board.by_id:
        raise BoardError(f'unknown {args.new}')  # a closed record still supersedes one rule: the edge is the record
    returned, failed = supersede_pair(board, args.old, args.new, args.partial, actor, carry=True)
    if returned:
        print(f"returned from review: {', '.join(returned)}")
    return 1 if failed else 0


def normalized_remote(url: str) -> str:
    """The `git+ssh://` form bd's git remotes need; scp and https forms of one repository become one url. `git+...` and
    Dolt's own schemes stay as written, a local path becomes `git+file://`."""
    url = url.strip()
    if url.startswith('/'):
        return f'git+file://{url}'
    if url.startswith('file://'):
        return f'git+{url}'
    if url.startswith('ssh://'):
        return f'git+{url}'
    https = re.fullmatch(r'https?://(?:[^@/]+@)?([^/]+)/(.+?)(?:\.git)?/?', url)
    if https:
        return f'git+ssh://git@{https.group(1)}/{https.group(2)}.git'
    scp = re.fullmatch(r'(?:([^@/:]+)@)?([^/:]+):(?!//)(.+)', url)
    if scp:
        return f"git+ssh://{scp.group(1) or 'git'}@{scp.group(2)}/{scp.group(3)}"
    return url


def project_remote() -> str:
    result = subprocess.run(['git', 'remote', 'get-url', 'origin'], capture_output=True, text=True)
    if result.returncode != 0 or not result.stdout.strip():
        raise BoardError("this project's repository has no origin remote: name the url")
    return result.stdout.strip()


def ask_person() -> str:
    """The person, asked for when unset at a terminal. Their one choice of level is the git command itself."""
    who = person()
    if who:
        return who
    if not sys.stdin.isatty():
        raise BoardError(PERSON_HELP)
    who = input('Your name for queue labels (queue:<name>), set in global git config: ').strip()
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', who):
        raise BoardError(f'{who!r} does not fit a label; {PERSON_HELP}')
    subprocess.run(['git', 'config', '--global', 'agents.person', who], check=True)
    return who


def set_config(pairs) -> None:
    for key, value in pairs:
        bd_checked('config', 'set', key, value)


def send_first(remote: str, url: str, known: bool) -> None:
    """Sync, or the first push a sync can't do (it pulls first, and the remote has nothing yet)."""
    result = bd('sync', '--remote', remote)
    if result.returncode == 0:
        return
    if known:
        raise BoardError(f'sync failed: {last_line(result.stderr + result.stdout)}')
    pushed = bd('dolt', 'push', '--remote', remote)
    output = pushed.stderr + pushed.stdout
    if 'has no branches' in output:
        raise BoardError(f"{url} is a completely empty repository and can't take a first push: commit something to it first, then rerun")
    if pushed.returncode != 0:
        raise BoardError(f'first push failed: {last_line(output)}')


def readable_remote(url: str) -> list[str] | None:
    """The repository's refs before anything is sent to it; refuses one that can't be read or can't take a first push."""
    refs, error = remote_refs(url)
    if refs is None and url.startswith('git+'):
        raise BoardError(f'cannot read {url}: {error}')
    if refs == []:
        raise BoardError(f"{url} is a completely empty repository and can't take a first push: commit something to it first, then rerun")
    return refs


def default_prefix(root: Path) -> str:
    """The project's name: its origin repository's, else its folder's (a worktree folder is often named after a branch)."""
    origin = subprocess.run(['git', 'remote', 'get-url', 'origin'], capture_output=True, text=True).stdout.strip()
    name = re.sub(r'\.git$', '', origin.rstrip('/').rsplit('/', 1)[-1].rsplit(':', 1)[-1]) if origin else root.name
    return re.sub(r'[^a-z0-9]+', '-', name.lower()).strip('-') or 'board'


def current_setting(key: str) -> str:
    """bd's value for a setting, '' when unset; a config.yaml key reads as bd's default when the file leaves it out."""
    return str(json.loads(bd_checked('config', 'get', '--json', key) or '{}').get('value') or '')


def hiding_excludes() -> list[str]:
    """The .git/info/exclude lines matching tracked project files: init's patterns (1.3 adds `*.db`) would hide new ones."""
    exclude = git_exclude()
    if not exclude.is_file():
        return []
    found = []
    for pattern in exclude.read_text(encoding='utf-8').splitlines():
        if not pattern.strip() or pattern.startswith(('#', '!')):
            continue
        tracked = subprocess.run(['git', 'ls-files', '-c', '-i', '-x', pattern], capture_output=True, text=True).stdout.split('\n')
        tracked = [path for path in tracked if path]
        if tracked:
            more = f' and {len(tracked) - 5} more' if len(tracked) > 5 else ''
            found.append(f"{exclude}: `{pattern}` matches tracked project files ({', '.join(tracked[:5])}{more}); "
                         'remove the line unless new files like them should stay hidden')
    return found


KEPT_EMBEDDED = '.beads.before-server-'  # an embedded board's folder, kept beside the server board made from it


def to_server(beads: Path) -> None:
    """`board setup --server` on an embedded board: bd's backup into a new server board, restored whole (Dolt history
    included), the old folder kept beside it. A failure removes what it made and puts the old folder back."""
    root, exclude = beads.parent, git_exclude()
    database = json.loads((beads / 'metadata.json').read_text(encoding='utf-8')).get('dolt_database') or default_prefix(root)
    before = {json.loads(row)['id'] for row in bd_checked('export').splitlines() if row.strip()}
    saved = exclude.read_bytes() if exclude.exists() else None
    kept = root / f"{KEPT_EMBEDDED}{utcnow().strftime('%Y%m%d-%H%M%S')}"
    with tempfile.TemporaryDirectory(prefix='board-to-server-') as store:
        bd_checked('backup', 'init', store)
        try:
            bd_checked('backup', 'sync')
        except BaseException:
            bd('backup', 'remove')  # the embedded board keeps no registration of a backup that never came to be
            raise
        beads.rename(kept)
        try:
            bd_checked('init', '--server', '--stealth', '--prefix', database, '--skip-hooks', '--skip-agents', stdin='')
            bd_checked('backup', 'restore', '--force', store)
            bd_checked('backup', 'remove')  # the restore registers the temporary backup for future syncs
            lost = before - {json.loads(row)['id'] for row in bd_checked('export').splitlines() if row.strip()}
            if lost:
                raise BoardError(f"the server board lacks {', '.join(sorted(lost))}; nothing converted")
        except BaseException:
            stop_server(root)
            shutil.rmtree(beads, ignore_errors=True)
            kept.rename(beads)
            if saved is not None:
                exclude.write_bytes(saved)
            bd('backup', 'remove')
            raise
    pattern = f'/{KEPT_EMBEDDED}*/'
    if pattern not in (exclude.read_text(encoding='utf-8') if exclude.exists() else '').splitlines():
        with exclude.open('a', encoding='utf-8') as handle:
            handle.write(f"\n# board setup --server: an embedded board's old folder\n{pattern}\n")
    print(f'converted the board to server mode, {len(before)} items; the embedded board is kept in {kept}')


def setup(args) -> int:
    """Safe to repeat (r38-q218, server default): no board → `bd init --server --stealth` (--embedded opts out), then the
    settings. An existing board is never re-created: `--server` converts an embedded one in place (`to_server`), a missing
    setting is set and a differing one reset, each printed with its old and new value. A shared board also gets the shared
    settings, and its travelling ones reach the others by sync."""
    toplevel = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True, text=True)
    if toplevel.returncode != 0:
        raise BoardError('run board setup inside the project repository')
    os.chdir(toplevel.stdout.strip())
    beads = beads_dir()
    if beads is None:
        prefix = args.prefix or default_prefix(Path.cwd())
        if not re.fullmatch(r'[a-z0-9][a-z0-9-]*', prefix):
            raise BoardError(f'{prefix!r} does not fit an id prefix: lowercase letters, digits and dashes')
        bd_checked('init', *([] if args.embedded else ['--server']), '--stealth', '--prefix', prefix, '--skip-hooks', '--skip-agents', stdin='')
        beads = Path.cwd() / '.beads'
        print(f"created the board {prefix} ({'embedded' if args.embedded else 'server'} mode) in {beads}")
    else:
        mode = json.loads((beads / 'metadata.json').read_text(encoding='utf-8')).get('dolt_mode') or 'embedded'
        if args.embedded and mode != 'embedded':
            raise BoardError(f'this board is {mode}; --embedded applies only to a new board, and board setup never converts one back')
        if args.prefix:
            raise BoardError('this project already has a board, which keeps its prefix: drop --prefix')
        os.chdir(beads.parent)
        if args.server and mode == 'embedded':
            to_server(beads)
        else:
            print(f'this project already has a board ({mode} mode); applying the current settings')
    server = json.loads((beads / 'metadata.json').read_text(encoding='utf-8')).get('dolt_mode') == 'server'
    changed = []
    for key, value in (*LOCAL_CONFIG, *TRAVELLING_CONFIG, *(SERVER_CONFIG if server else ()), *(SHARED_CONFIG if read_mark(beads) else ())):
        old = current_setting(key)
        if old != value:
            bd_checked('config', 'set', key, value)
            changed.append(key)
            print(f"{key}: {old or '(unset)'} -> {value}", flush=True)  # printed as applied: a later failure leaves it said
    if changed:
        committed = bd('dolt', 'commit', '-m', 'board setup')  # in server mode an uncommitted status.custom stops the first sync
        output = committed.stdout + committed.stderr
        if committed.returncode != 0 and 'nothing to commit' not in output.lower():
            raise BoardError(f'the settings are set but not committed: {last_line(output)}; rerun board setup')
    else:
        print('settings up to date')
    for warning in hiding_excludes():
        print(warning)
    return 0


def share(args) -> int:
    """Safe to repeat. Only the first push asks: without --yes it says what goes out and changes nothing. The sharer's
    labelling runs once per board, marked in the database: a second person's share must not take the items other people
    left unrouted."""
    beads = beads_dir()
    if beads is None:
        raise BoardError('no board here: board setup creates one to share, or board join joins one')
    if json.loads((beads / 'metadata.json').read_text(encoding='utf-8')).get('dolt_mode') != 'server':
        raise BoardError('a shared board needs server mode, and this board is embedded: board setup --server converts it in place '
                         '(pause the sessions writing to it first)')
    os.chdir(beads.parent)
    remotes = bd_remotes()
    if remotes:
        remote = 'origin' if 'origin' in remotes else sorted(remotes)[0]
        url = remotes[remote]
        if args.url and normalized_remote(args.url) != url:
            raise BoardError(f'this board already syncs with {url} ({remote}); moving it: board move <url> (beads-setup.md#history)')
    else:
        remote, url = 'origin', normalized_remote(args.url or project_remote())
    known = remote in remotes and remote_branches(remote) > 0  # the remote already holds this board
    if not known:
        readable_remote(url)
        if not args.yes:
            print(f'board share sends the whole board to {url}: every item, comment and history entry, git emails included. '
                  f"Nothing has changed yet. To share, rerun: board share {args.url + ' ' if args.url else ''}--yes")
            return 1
    who = ask_person()
    if remote not in remotes:
        bd_checked('dolt', 'remote', 'add', remote, url, '--allow-git-origin')
    try:
        send_first(remote, url, known)
    except BoardError:
        if remote not in remotes:  # an unshared board keeps no remote it never pushed to
            bd('dolt', 'remote', 'remove', remote)
        raise
    write_mark(beads, remote)
    set_config((*LOCAL_CONFIG, *SERVER_CONFIG, *SHARED_CONFIG, *TRAVELLING_CONFIG))
    labelled = 0
    if not config_value(SHARED_BY):
        # Closed items too: an open child takes its queue from a closed parent.
        issues = [json.loads(row) for row in bd_checked('export').splitlines() if row.strip()]
        top = [issue['id'] for issue in issues if issue.get('_type', 'issue') == 'issue' and not queue_labels(issue.get('labels') or [])
               and not any(dep.get('type') == 'parent-child' for dep in issue.get('dependencies') or [])]
        for start in range(0, len(top), 200):
            bd_checked('label', 'add', *top[start:start + 200], QUEUE_PREFIX + who)
        labelled = len(top)
        bd_checked('config', 'set', SHARED_BY, who)
    bd('dolt', 'commit', '-m', f'board shared by {who}')  # nothing to commit on a repeat
    send_first(remote, url, True)
    print(f'shared with {url}; {labelled} top-level items labelled {QUEUE_PREFIX}{who}. Others join with: board join {url}')
    return 0


def git_exclude() -> Path:
    path = subprocess.run(['git', 'rev-parse', '--path-format=absolute', '--git-path', 'info/exclude'], capture_output=True, text=True)
    return Path(path.stdout.strip())


def stop_server(root: Path) -> None:
    if (root / '.beads' / 'dolt-server.pid').exists():
        subprocess.run(['bd', 'dolt', 'stop'], cwd=root, capture_output=True, env=bd_env(), stdin=subprocess.DEVNULL)


def fresh_join(url: str) -> None:
    """Clones the board at url into this folder's new .beads. A failure removes only what it made (the new .beads, the
    gate lock, init's exclude lines) and stops the server it started, so a rerun works."""
    root, exclude = Path.cwd(), git_exclude()
    before = {path.name for path in root.iterdir() if path.name.startswith('.beads')}
    saved = exclude.read_bytes() if exclude.exists() else None
    try:
        # The prefix only names the local database: items keep the board's own, which comes with the clone.
        database = re.sub(r'[^a-z0-9]+', '_', Path(url.rstrip('/')).stem.lower()).strip('_') or 'board'
        bd_checked('init', '--server', '--stealth', '--remote', url, '--prefix', database, '--skip-hooks', '--skip-agents', stdin='')
        if not remote_branches('origin'):  # bd starts an empty board when the repository holds none
            raise BoardError(f"no board data at {url}: name the board's address: board join <url>")
        moved = config_value(MOVED)
        if moved:
            raise BoardError(f'the board at {url} moved to {moved}: board join {moved}')
        set_config((*LOCAL_CONFIG, *SERVER_CONFIG, *SHARED_CONFIG))
        bd_checked('dolt', 'commit', '-m', 'board config')
        write_mark(root / '.beads', 'origin')
    except BaseException:
        stop_server(root)
        for path in root.iterdir():
            if path.name.startswith('.beads') and path.name not in before:
                shutil.rmtree(path) if path.is_dir() and not path.is_symlink() else path.unlink()
        if saved is None:
            exclude.unlink(missing_ok=True)
        else:
            exclude.write_bytes(saved)
        raise


def join(args) -> int:
    """Safe to repeat: an existing board stays as it is, unless it carries a moved note: then it rejoins."""
    toplevel = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True, text=True)
    if toplevel.returncode != 0:
        raise BoardError('run board join inside the project repository')
    os.chdir(toplevel.stdout.strip())
    beads = beads_dir()
    if beads is not None:
        mark = read_mark(beads)
        sharing = Shared(beads, mark['remote']) if mark else None
        if sharing:
            sharing.check_moved()
        if sharing is None or not sharing.moved():
            print(f"this project already has a board ({'shared' if mark else 'not shared: board share shares it'}); nothing to do")
        else:
            rejoin(sharing, normalized_remote(args.url) if args.url else sharing.moved())
    else:
        ask_person()
        url = normalized_remote(args.url or project_remote())
        fresh_join(url)
        print(f'joined {url}. Items go to {QUEUE_PREFIX}{person()}; a lead routes work to you (board route).')
    role = subprocess.run(['git', 'config', '--get', 'beads.role'], capture_output=True, text=True)
    if not role.stdout.strip():
        subprocess.run(['git', 'config', 'beads.role', 'maintainer'], check=True)
    return 0


KEPT = '.beads.before-move-'  # a rejoined board's old folder, kept beside the new one


def rejoin(sharing: Shared, url: str) -> None:
    """A moved board: keep the old folder as a copy, join the new board, list what the new one lacks. A failed join puts
    the old folder back."""
    root, beads = sharing.root, sharing.beads
    wait = sharing.path('wait.lock').open('w')  # a running wait finishes its send first, and no new one starts
    try:
        fcntl.flock(wait, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print('board: waiting for the pending sync to finish', file=sys.stderr)
        fcntl.flock(wait, fcntl.LOCK_EX)
    with wait:
        old = [json.loads(row) for row in bd_checked('export').splitlines() if row.strip()]
        stop_server(root)
        kept = root / f"{KEPT}{utcnow().strftime('%Y%m%d-%H%M%S')}"
        beads.rename(kept)
        try:
            fresh_join(url)
        except BaseException:
            kept.rename(beads)
            raise
    exclude = git_exclude()
    pattern = f'/{KEPT}*/'
    if pattern not in (exclude.read_text(encoding='utf-8') if exclude.exists() else '').splitlines():
        with exclude.open('a', encoding='utf-8') as handle:
            handle.write(f'\n# board join: a moved board\'s old folder\n{pattern}\n')
    (kept / 'board-export.jsonl').write_text(''.join(json.dumps(row) + '\n' for row in old), encoding='utf-8')
    present = {json.loads(row)['id'] for row in bd_checked('export').splitlines() if row.strip()}
    missing = [row for row in old if row.get('_type', 'issue') == 'issue' and row['id'] not in present]
    print(f'joined {url}; the board before the move is kept in {kept}.')
    if missing:
        path = kept / 'missing.jsonl'
        path.write_text(''.join(json.dumps(row) + '\n' for row in missing), encoding='utf-8')
        print(f'{len(missing)} items the new board lacks (written after the move): ' + ', '.join(row['id'] for row in missing))
        print(f'Bring them over: board bd import {path}')
    else:
        print('the new board holds every item of the old one')


def move(args) -> int:
    """board move <url>: the note on the old board, then flatten, switch the remote and push (beads-setup.md#history). The
    note goes out before the flatten and is removed from the local copy first: it travels with the data and would say the
    new board moved too."""
    if shared is None:
        raise BoardError('board move moves a shared board; this one is not shared')
    if not may_move():
        raise BoardError("only lead and solo sessions, or a person's terminal, move a board")
    if shared.moved():
        raise BoardError(moved_refusal(shared.moved()))
    url = normalized_remote(args.url)
    os.chdir(shared.root)
    old = bd_remotes().get(shared.remote)
    if old == url:
        raise BoardError(f'this board already syncs with {url}')
    refs = readable_remote(url)
    if refs and 'refs/dolt/data' in refs:
        raise BoardError(f'{url} already holds board data: name a fresh repository')
    wait = shared.path('wait.lock').open('w')
    try:
        fcntl.flock(wait, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print('board: waiting for the pending sync to finish', file=sys.stderr)
        fcntl.flock(wait, fcntl.LOCK_EX)
    with wait:
        bd('dolt', 'commit', '-m', 'before the move')  # nothing to commit when the wait just sent
        sent = bd('sync', '--remote', shared.remote)
        if sent.returncode != 0:
            raise BoardError(f'the sync before the move failed, nothing moved: {last_line(sent.stderr + sent.stdout)}')
        bd_checked('config', 'set', MOVED, url)
        bd_checked('dolt', 'commit', '-m', f'board moved to {url}')
        sent = bd('sync', '--remote', shared.remote)
        if sent.returncode != 0:
            bd('config', 'unset', MOVED)
            bd('dolt', 'commit', '-m', 'board move abandoned')
            raise BoardError(f'sending the moved note failed, nothing moved: {last_line(sent.stderr + sent.stdout)}')
        bd_checked('config', 'unset', MOVED)
        bd_checked('dolt', 'commit', '-m', 'board moved: the note stays on the old board')
        bd_checked('flatten', '--force')
        bd_checked('dolt', 'remote', 'remove', shared.remote)
        bd_checked('dolt', 'remote', 'add', shared.remote, url, '--allow-git-origin')
        pushed = bd('dolt', 'push', '--remote', shared.remote)
        if pushed.returncode != 0:
            raise BoardError(f'the old board says it moved to {url}, but the push there failed: {last_line(pushed.stderr + pushed.stdout)}. '
                             f'Fix the access, then: board bd dolt push --remote {shared.remote}')
        for name in ('pulled', 'unsent'):
            (shared.dir / name).unlink(missing_ok=True)
        shared.update_state(moved=None, kind=None, failures=0, detail=None, last_failure=None)
    print(f'moved to {url}. The old repository keeps its data and tells the others to run board join {url}. '
          f'Once everyone rejoined, delete it: git push {git_url(old or "<old url>")} --delete refs/dolt/data refs/heads/__dolt_remote_info__')
    return 0


PERSON_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]*')


def mover(board: Board | None, args, command: str) -> list[dict]:
    """The checks route and send share: a shared board, a mover, a person, known ids (`board` holds the named items; None
    checks the rest before the read)."""
    if shared is None:
        raise BoardError(f'board {command}: this board is not shared, so no queues')
    if not may_move():
        raise BoardError(f"only lead and solo sessions, or a person's terminal, {command} items; ask your lead")
    if not PERSON_NAME.fullmatch(args.person):
        raise BoardError(f'{args.person!r} does not fit a label')
    if board is None:
        return []
    found = {issue['id']: issue for issue in board.issues}
    missing = [item_id for item_id in args.ids if item_id not in found]
    if missing:
        raise BoardError(f"unknown: {', '.join(missing)}")
    return [found[item_id] for item_id in args.ids]


def route(board: Board, args) -> int:
    """Into a person's queue, replacing the queue label; an item filed for someone also leaves the inbox: its `for:` and
    its `user` hold go. Other `user` holds stay: they mark a wait on a person's action."""
    target = QUEUE_PREFIX + args.person
    for issue in mover(board, args, 'route'):
        labels = issue.get('labels') or []
        filed = [label for label in labels if label.startswith(FOR_PREFIX)]
        flags = [flag for label in queue_labels(labels) + filed if label != target for flag in ('--remove-label', label)]
        flags += ['--add-label', target] if target not in labels else []
        flags += ['--assignee', ''] if filed and issue.get('assignee') == USER_HOLD else []
        if flags:
            bd_checked('update', issue['id'], *flags, '--json')
        print(f"routed {issue['id']} to {args.person}'s queue" + (' (out of the inbox)' if filed else ''))
    return 0


def send(board: Board, args) -> int:
    """Into a person's inbox: `for:<person>`, no queue label and no `user` hold, so the item is unrouted until their lead
    routes it. Only a top-level item: one with a parent would still take the parent's queue."""
    target = FOR_PREFIX + args.person
    issues = mover(board, args, 'send')
    for issue in issues:
        inherited = sorted({queue for parent in board.parents.get(issue['id'], []) for queue in board.queues(parent)})
        if inherited:
            raise BoardError(f"{issue['id']} takes its queue from its parent ({', '.join(inherited)}), so it can't sit in an inbox: "
                             f"board route {args.person} {issue['id']}, or remove the parent link first")
    for issue in issues:
        labels = issue.get('labels') or []
        flags = [flag for label in labels if (label.startswith(QUEUE_PREFIX) or label.startswith(FOR_PREFIX)) and label != target
                 for flag in ('--remove-label', label)]
        flags += ['--add-label', target] if target not in labels else []
        flags += ['--assignee', ''] if issue.get('assignee') == USER_HOLD else []
        # Every send stamps the time, a pass-on and a repeat included: the inbox shows how long an item waited there (r38-q217).
        bd_checked('update', issue['id'], *flags, '--set-metadata', f"{SENT_AT}={utcnow().strftime('%Y-%m-%dT%H:%M:%SZ')}", '--json')
        print(f"sent {issue['id']} to {args.person}'s inbox")
    return 0


def create_for(argv: list[str]) -> int:
    """`board create --for <person> <bd create args>`: a find for another person, top-level, in your queue and held for
    you (`user`), labelled `for:<person>`; your lead checks it with you before `board send`."""
    targets = flag_values(argv, '--for')
    rest, skip = [], False
    for arg in argv:
        if skip:
            skip = False
        elif arg == '--for':
            skip = True
        elif not arg.startswith('--for='):
            rest.append(arg)
    if shared is None:
        raise BoardError('board create --for files for another person on a shared board; this board is not shared')
    if len(targets) != 1 or not PERSON_NAME.fullmatch(targets[0]):
        raise BoardError('name one person: board create --for <person> <title> [bd create flags]')
    if flag_values(rest, '--parent') or '--parent' in rest or flag_values(rest, '--graph'):
        raise BoardError('board create --for files a top-level item: drop --parent (a child takes its parent\'s queue)')
    if any(label.startswith((QUEUE_PREFIX, FOR_PREFIX)) for label in flag_values(rest, '-l', '--labels', '--label')) \
            or flag_values(rest, '-a', '--assignee'):
        raise BoardError('board create --for sets the queue, for: and the hold itself: drop those flags')
    me = person()
    if not me:
        raise BoardError(PERSON_HELP)
    result = bd('create', *rest, '--labels', f'{FOR_PREFIX}{targets[0]},{QUEUE_PREFIX}{me}', '--assignee', USER_HOLD)
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    return result.returncode


EXAMPLES = {
    'setup': 'board setup',
    'share': 'board share git@github.com:me/project.git',
    'join': 'board join',
    'move': 'board move git@github.com:me/project-board.git',
    'route': 'board route ben <id> <id>',
    'send': 'board send ben <id>',
    'create': 'board create --for ben "Login fails on Safari" -t bug --description "<what, where, how found>"',
    'health': 'board health --items ready,blocked',
    'position': 'board position --limit 20',
    'holders': 'board holders --root <epic>',
    'check': 'board check --all',
    'related': 'board related --like draft.md tenancy --docs docs,README.md',
    'queue': 'board queue --root <epic>',
    'mine': 'board mine',
    'console': 'board console',
    'show': 'board show <id> --section Decision',
    'claim': 'board claim',
    'record': 'board record <id> .scratch/<topic>/<arc>/record.md',
    'block': 'board block <item> <item> --on <blocker> --reason "waits for the cache ruling"',
    'revise': 'board revise <old> --title "May X replace Y?" --body-file packet.md --partial "Rule 2"',
    'release': 'board release <id> <id> --closes <question>=<id>',
    'supersede': 'board supersede <old> --with <new> --partial "Rule 2"',
    'bd': 'board bd list --status open --json',
    'handover': 'board handover <id> "pnpm test: exit 0, 412 passed; typecheck exit 0"',
    'return': 'board return <id> "test x fails: <finding>"',
    'take': 'board take <id>',
    'unclaim': 'board unclaim <id>',
    'help': 'board help',
}


# Commands that say nothing about the board, or that fix or run sync themselves: no pull first.
NO_PULL = {'help', '-h', '--help', 'share', 'join', 'move'}
BD_NO_PULL = {'dolt', 'sync', 'init', 'conflicts', 'sql', 'rename', 'flatten', 'vc', 'version', 'where', 'help', 'bootstrap'}
# Commands that write nothing: a wrong entry costs a late sync, a missing one a cheap check.
READS = {'health', 'position', 'holders', 'check', 'related', 'queue', 'mine', 'console', 'show', 'help', '-h', '--help', 'share', 'join',
         'move'}
BD_READS = {'list', 'ready', 'show', 'view', 'query', 'search', 'where', 'version', 'help', 'export', 'stats', 'blocked', 'lint',
            'history', 'count', 'events'}


def bd_word(argv: list[str]) -> str:
    """The bd command a `board bd` call runs, past bd's global flags."""
    at = 1
    while at < len(argv) and argv[at].startswith('-'):
        at += 2 if argv[at] in GLOBAL_VALUES else 1
    return argv[at] if at < len(argv) else ''


def writes(argv: list[str]) -> bool:
    """Whether a command may write: the window opens after it, and a moved board refuses it."""
    if argv[:1] == ['bd']:
        return not (bd_word(argv) in BD_READS or argv[1:3] in (['dolt', 'stop'], ['dolt', 'start'], ['dolt', 'status']))
    return (argv[0] if argv else '') not in READS


def main(argv: list[str] | None = None) -> int:
    global shared
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ['_sync-wait']:
        shared = find_shared()
        return shared.wait() if shared else 0
    directory = next((argv[i + 1] for i, arg in enumerate(argv[:-1]) if arg in ('-C', '--directory')), None) if argv[:1] == ['bd'] else None
    shared = find_shared(Path(directory) if directory else None)
    if shared is None or argv[:1] in (['share'], ['join']):
        return run_command(argv)

    def quietly(step, *values) -> None:
        """Sync never stops the command: a sandbox, a stopped server or a read-only folder only delay it."""
        try:
            step(*values)
        except (OSError, ValueError, BoardError, subprocess.SubprocessError) as error:
            print(f'board: sync step skipped: {error}', file=sys.stderr)

    word = bd_word(argv) if argv[:1] == ['bd'] else (argv[0] if argv else '')
    bare = bool({'-h', '--help'} & set(argv))
    if not bare and word not in (BD_NO_PULL if argv[:1] == ['bd'] else NO_PULL):
        quietly(shared.before)
    if not bare and shared.moved() and (writes(argv) or argv[:1] in (['share'], ['move'])):
        print(f'board: {moved_refusal(shared.moved())}', file=sys.stderr)
        return 1
    try:
        return run_command(argv)
    finally:
        if not bare and writes(argv):
            quietly(shared.after)
        quietly(shared.report)


def run_command(argv: list[str]) -> int:
    if argv[:1] == ['bd'] or (argv[:1] == ['create'] and not {'-h', '--help'} & set(argv)):
        try:
            return passthrough(argv[1:]) if argv[0] == 'bd' else create_for(argv[1:])
        except BoardError as error:
            print(f'board: {error}', file=sys.stderr)
            return 1
    parser = argparse.ArgumentParser(prog='board', description=__doc__.split('\n\n')[0])
    scope = argparse.ArgumentParser(add_help=False)
    scope.add_argument('--root', metavar='EPIC', help="limit to items below this epic, or to a milestone's work "
                       '(default: whole board)')
    listing = argparse.ArgumentParser(add_help=False)
    listing.add_argument('--offset', type=int, default=0, metavar='N', help='skip the first N rows (paging a cut output)')
    listing.add_argument('--limit', type=int, default=ROWS, help=f'rows per section (default {ROWS}, 0: all); the output '
                       f'stays within {READ_BUDGET} characters')
    commands = parser.add_subparsers(dest='command', required=True)

    def add(name: str, text: str, run, parents=()):
        sub = commands.add_parser(name, help=text, description=text, parents=list(parents), epilog=f'example: {EXAMPLES[name]}',
                                  formatter_class=argparse.RawDescriptionHelpFormatter)
        sub.set_defaults(run=run)
        return sub

    def nonempty(value: str) -> str:
        if not value.strip():
            raise argparse.ArgumentTypeError('must not be empty')
        return value

    def views(value: str) -> set[str]:
        chosen = {view for view in value.split(',') if view}
        unknown = chosen - set(HEALTH_VIEWS)
        if not chosen or unknown:
            raise argparse.ArgumentTypeError(f"choose from {', '.join(HEALTH_VIEWS)}")
        return chosen

    queues = argparse.ArgumentParser(add_help=False)
    queues.add_argument('--queue', metavar='PERSON|all', help="on a shared board: another person's queue, or every item (default: yours)")
    sub = add('health', 'counts', health, [scope, listing, queues])
    sub.add_argument('--items', type=views, default=set(), metavar='VIEW[,VIEW...]',
                     help=f"list the items behind these counts: {', '.join(HEALTH_VIEWS)}")
    sub.add_argument('--json', action='store_true', help='counts, claimable by kind, --items rows, milestones; every row')
    sub = add('position', 'ready work vs sessions, held items with gone and idle marks, questions holding work, '
              'ready milestones, finished epics', position, [scope, listing, queues])
    sub.add_argument('--all', dest='limit', action='store_const', const=0, help='every row (--limit 0)')
    sub.add_argument('--json', action='store_true', help='ready by kind, sessions with state, held items; every row')
    add('holders', 'items by open downstream work', holders, [scope, listing, queues])
    sub = add('check', 'deviations from the board conventions', check, [scope, listing])
    sub.add_argument('--all', dest='limit', action='store_const', const=0, help='every row (--limit 0)')
    sub.add_argument('--json', action='store_true', help='deviations and flags as rows, unlinked revisions with their old and new record')
    sub = add('related', 'items and doc lines mentioning terms', related, [scope, listing])
    sub.add_argument('terms', nargs='*')

    def draft(value: str) -> str:
        try:
            return sys.stdin.read() if value == '-' else Path(value).read_text(encoding='utf-8')
        except (OSError, UnicodeDecodeError) as error:
            raise argparse.ArgumentTypeError(f'cannot read {value}: {error}') from None

    sub.add_argument('--like', type=draft, metavar='FILE|-', help=f'terms from a draft: its {LIKE_TERMS} rarest board words')
    sub.add_argument('--docs', nargs='+', default=[], metavar='PATH',
                     help='canonical docs (files or directories of .md), separated by spaces or commas')
    sub.add_argument('--json', action='store_true', help='{terms, like, items, docs}; --limit per list')
    add('queue', 'claimable work by pull', queue, [scope, listing, queues])
    sub = add('mine', 'items held by this session and its workers', mine, [scope, listing])
    sub.add_argument('--json', action='store_true', help='{session, actor, items}; every row')
    sub = add('console', 'JSON for the console pane from one snapshot: {counts, items (mine), sessions, held (position)}',
              console, [scope])
    sub.set_defaults(items=set(), limit=0)
    sub = add('show', 'items with links, fields and newest comments, within the read budget', show)
    sub.add_argument('ids', nargs='+')
    sub.add_argument('--section', dest='sections', action='append', default=[], metavar='NAME',
                     help='a field or a ##/### heading (case-insensitive prefix; repeatable)')
    sub.add_argument('--field', dest='fields', action='append', default=[], metavar='FIELD',
                     help='a named field, comments included (repeatable)')
    sub.add_argument('--comments', action='store_true', help='select the comments, every one, newest first (not the rest of the item)')
    sub.add_argument('--full', action='store_true', help=f'no {READ_BUDGET}-character budget')
    sub.add_argument('--json', action='store_true', help='with --field: {id: {field: value}}, unbudgeted')
    sub = add('claim', 'claim the next item routed to your role, or the given ids', claim, [scope])
    sub.add_argument('ids', nargs='*')
    sub = add('record', 'write the decision record you hold from a file and set it decided', record)
    sub.add_argument('id')
    sub.add_argument('file')
    sub.add_argument('--status', choices=('decided', 'needs_ratification'), default='decided',
                     help='needs_ratification: an autopilot ruling; requires ## Reversal and frees the hold')
    sub = add('block', 'make items wait on a blocker, with the reason commented on each item', block)
    sub.add_argument('ids', nargs='+', metavar='item')
    sub.add_argument('--on', dest='blocker', required=True)
    sub.add_argument('--reason', required=True, type=nonempty)
    sub = add('revise', 'open a revision question linked to the record it revises; prints its id', revise)
    sub.add_argument('old')
    sub.add_argument('--title', required=True, type=nonempty)
    sub.add_argument('--body-file', required=True)
    sub.add_argument('--partial', metavar='RULE', help='revise one named rule; the rest stays in force')
    sub.add_argument('-p', '--priority', type=int, choices=range(5), help="default: the old record's")
    sub.add_argument('--parent', help="default: the old record's parent")
    sub.add_argument('-l', '--labels', action='append', default=[], help="default: the old record's topic: labels")
    sub.add_argument('--external-ref', metavar='REF', help='tag the new question with an external reference')
    sub = add('release', 'release decided rulings in one bd batch; supersedes the records they revise, then closes '
              'the questions they answer', release)
    sub.add_argument('ids', nargs='+')

    def answered(value: str) -> tuple[str, list[str]]:
        question, _, records = value.partition('=')
        named = [record for record in records.split(',') if record]
        if not question or not named:
            raise argparse.ArgumentTypeError('QUESTION=RECORD[,RECORD]')
        return question, named

    sub.add_argument('--closes', nargs='+', type=answered, default=[], metavar='QUESTION=RECORD[,RECORD]',
                     help='close each question as answered by the named released rulings, in dependency order; '
                          'forces only past blockers released or closed in this call')
    sub = add('supersede', "supersede a ruling; a full replacement blocks the old record's open items", supersede)
    sub.add_argument('old')
    sub.add_argument('--with', dest='new', required=True)
    sub.add_argument('--partial', metavar='RULE', nargs='?', const='', help='one rule of the old record: add the edge only')
    add('bd', 'run any bd command with your actor (board bd <args>)', None)
    sub = add('handover', 'comment the evidence and hand your item over for review', handover)
    sub.add_argument('id')
    sub.add_argument('evidence', type=nonempty)
    sub = add('return', 'return a claimed review to the work queue with its findings', return_item)
    sub.add_argument('id')
    sub.add_argument('findings', type=nonempty)
    for name, run, text in (('take', take, 'reassign held items to yourself (with a comment)'),
                            ('unclaim', unclaim, "free a hold, yours or another's (with a comment)")):
        add(name, text, run).add_argument('ids', nargs='+')
    sub = add('route', "move items into a person's queue (lead, solo or a person's terminal); an inbox item leaves the inbox", route)
    sub.add_argument('person')
    sub.add_argument('ids', nargs='+')
    sub = add('send', "move top-level items into a person's inbox, unrouted until their lead routes them (lead, solo or a person's terminal)", send)
    sub.add_argument('person')
    sub.add_argument('ids', nargs='+')
    sub = add('create', "file a top-level item for another person: held in your queue for your check, then board send", None)
    sub.add_argument('--for', dest='for_', required=True, metavar='PERSON')
    sub.add_argument('args', nargs=argparse.REMAINDER, help='bd create arguments')
    sub = add('setup', 'create this project\'s board, or bring an existing one to the current settings (safe to rerun)', setup)
    modes = sub.add_mutually_exclusive_group()
    modes.add_argument('--server', action='store_true', help='convert an existing embedded board to server mode (a new board is one already)')
    modes.add_argument('--embedded', action='store_true', help='a new board in embedded mode: one writer at a time, never shared')
    sub.add_argument('--prefix', help="a new board's id prefix (default: the origin repository's name, else the folder's)")
    sub = add('share', "share this board: without --yes, say what goes out and stop; with it: remote (default: the project's "
              "repository), first push, config, and your queue on existing items", share)
    sub.add_argument('url', nargs='?')
    sub.add_argument('--yes', action='store_true', help='share: the first push sends the whole board, git emails included')
    sub = add('join', "join a shared board (default: the project's repository's); an existing board stays as it is, a moved "
              "one rejoins", join)
    sub.add_argument('url', nargs='?')
    sub = add('move', 'move this shared board to a fresh repository: a moved note on the old one, flatten, push', move)
    sub.add_argument('url')
    add('help', 'every command with an example', None)

    args, extra = parser.parse_known_args(argv)
    if args.command == 'related' and not args.terms and args.like is None:
        commands.choices['related'].error('give terms, --like <draft>, or both')
    if extra:
        hint = next((word for word in extra if word in HEALTH_VIEWS), None)
        commands.choices[args.command].error(f"unrecognized arguments: {' '.join(extra)}"
                                             + (f'; for that list run board health --items {hint}' if hint else ''))
    if args.run is None:
        print(parser.format_usage().strip() + '\n')
        for name, sub in commands.choices.items():
            print(sub.format_usage().strip() + f'\n  {sub.description or ""}'.rstrip() + f'\n  example: {EXAMPLES[name]}')
        return 0
    args.root = getattr(args, 'root', None)
    if args.run in (setup, share, join, move):
        try:
            return args.run(args)
        except BoardError as error:
            print(f'board: {error}', file=sys.stderr)
            return 1
    JSON_VIEWS = {health: health_json, position: position_json, mine: mine_json, related: related_json, check: check_json}
    try:
        # Status views read non-closed items. These read closed items too (check: closed decisions named in text;
        # block, revise, release, supersede: a closed blocker or old record) or comments (related, check).
        scope = 'ids' if args.run in (show, route, send) else 'all' if args.run in (related, check, block, revise, release, supersede) \
            else 'status'
        if args.run in (route, send):
            mover(None, args, args.command)  # refuse before reading
        board = Board.load(scope, args.ids if scope == 'ids' else None)
        chosen = getattr(args, 'queue', None)
        if chosen and shared is None:
            raise BoardError('--queue: this board is not shared, so no queues (board share shares it)')
        board.view = None if shared is None or chosen == 'all' else chosen or person()
        if getattr(args, 'json', False) and args.run in JSON_VIEWS:
            # Unbudgeted, every row (related keeps --limit per list); no capacity line after it.
            print(json.dumps(JSON_VIEWS[args.run](board, args), indent=2, ensure_ascii=False))
            return 0
        if args.run in (health, position, holders, check, related, queue, mine):
            code = budgeted(args.run, board, args, argv)
        else:
            code = args.run(board, args) or 0
        if args.run in (claim, handover, return_item, block, mine, queue):
            capacity(board, args)
        return code
    except BoardError as error:
        print(f'board: {error}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
