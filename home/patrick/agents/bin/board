#!/usr/bin/env python3
"""board: the agents' interface to a beads board (bd 1.3.1).

Run inside the repository. Each command reads the snapshot its view needs
(`Board.load`): non-closed items for status views, `bd export` where closed
items or comments are read, only the named items for `board show`.
`board bd <args>` runs any other bd command (raw item
reads excepted: `board show` renders them within the read budget). Every bd call carries the caller's
actor (`derived_actor`) and, on a server-mode board, finds the server running.

Routing: `ROLE_KINDS` and `Board.kind` route a bare claim; what a claim by id
does not enforce is in skills/shared/board-core.md#routing.

A board is shared only by board's own mark (`MARK_FILE`), which `board share` and `board join` write: every command pulls
first when due, a detached `board _sync-wait` sends writes, and views filter to the caller's queue (`Board.listed`). A board
without the mark runs none of that, whatever Dolt remotes it has.
"""
from __future__ import annotations

import argparse
import atexit
import contextlib
import fcntl
import hashlib
import io
import itertools
import json
import math
import os
import re
import shutil
import shlex
import signal
import socket
import subprocess
import sys
import tempfile
import time
import tomllib
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import NamedTuple

HOLDS_LEGEND = 'holds a/b: a stops at a milestone, b counts everything downstream'
IDLE_HOURS = 1  # holds without activity (holder's tool call, else item update) for longer are hinted as idle
WORKER_CAP = 3  # workers a session targets unless registered with its own (activate --workers); Codex thread limits lower it
WORKER_ACTIVE_MINUTES = 15  # a running worker with a tool call this recently counts as active
CODEX_SYSTEM_CONFIG = Path('/etc/codex/config.toml')  # Codex's system layer, under $CODEX_HOME/config.toml
CAPACITY_ROLES = ('agent', 'solo', 'autopilot')  # roles that dispatch workers (any role with pulls does)
WORK_HOLD_TYPES = ('task', 'bug', 'spike', 'design')  # items a worker cap counts and a stale hold flags
STALE_HOURS = 1  # a held work item without an update (fields, notes, comments) for longer is flagged stale
DEEP_REVIEW = 'deep_review'  # item metadata a review sets to the failure path it escalates to deep-review; board show prints it
FORCED_BY, FORCED_REASON = 'forced_hold_by', 'forced_hold'  # item metadata: who held it past the cap with --force, and why
FIELD_LIMIT = 2000  # characters a work item's description, design, acceptance or notes, and a comment a session writes, may hold (refused above)
PACKET_FLAG = '--board-packet'  # on `board bd comments add`: the board's own packet (protocol autopilot park), exempt from FIELD_LIMIT
WORKER_KINDS = ('design', 'implement', 'review')  # kinds workers take; an agent's pulls narrow them
ROWS = 50  # rows per view section unless --limit (0: all)
READ_BUDGET = 35_000  # characters per command output; Codex cuts a call's output above ~40,000 from the middle
PREVIEW = 600  # characters a cut section still prints
SHOWN_COMMENTS = 5  # newest comments a plain board show prints, each cut at FIELD_LIMIT
SESSION_HOURS = 24  # position lists sessions of this project active or registered this recently (plus any holding items)
PULLS = ('plan', 'design', 'implement', 'review')
KINDS = (*PULLS, 'question', 'accept', 'ratify', 'milestone', 'refresh')  # refresh: review pulls take it (session_kinds)
WORK_TYPES = ('task', 'bug', 'spike')
# A released ruling waits only for planning (r21-q139): a live decision (an open question, or an unreleased revision
# record), a `user <date>` gate, a design or a spike. Any other wait is work or a container: refused by `board block`,
# ignored when claiming (q140).
LIVE_DECISIONS = ('open', 'in_progress', 'decided', 'needs_ratification')


def planning_wait(record: dict) -> bool:
    kind = record.get('issue_type')
    return kind in ('design', 'spike') or (kind == 'gate' and str(record.get('title', '')).startswith('user ')) \
        or (kind == 'decision' and record.get('status') in LIVE_DECISIONS)


# Rank of a kind within one claim-order tier at equal priority (r22-q177).
CLAIM_RANK = {kind: at for at, kind in enumerate(('plan', 'review', 'refresh', 'ratify', 'accept', 'design', 'question', 'implement', 'milestone'))}
FINISHING = ('review', 'refresh', 'ratify', 'accept')
# Kinds a bare `board claim` takes per role preset; the session's registered pulls come on top (agent: only its pulls).
ROLE_KINDS = {'lead': ('question',), 'agent': (), 'solo': ('question', 'plan', 'ratify', 'accept'),
              'autopilot': ('question', 'plan', 'accept')}
# Kinds each role handles, by bare claim or by id; `board position` counts sessions from these.
# A ready milestone is accepted with the user: claimed by id only, never by autopilot.
ROLE_HANDLES = {'lead': ('question', 'accept', 'ratify', 'milestone'), 'agent': (),
                'solo': ('question', 'plan', 'ratify', 'accept', 'milestone'), 'autopilot': ('question', 'plan', 'accept')}
TEXT_FIELDS = ('title', 'description', 'design', 'acceptance_criteria', 'notes', 'close_reason')
SHOW_FIELDS = TEXT_FIELDS[1:]
# Fields `board show --field` accepts besides those on the shown items (a read of few items would otherwise hide
# the ones its items leave unset; bd omits an empty `labels` and a root's `parent`).
ITEM_FIELDS = {*TEXT_FIELDS, 'comments', 'assignee', 'metadata', 'closed_at', 'started_at', 'external_ref', 'source_system', 'spec_id',
               'lease_expires_at', 'heartbeat_at', 'await_type', 'labels', 'parent'}
# A decision record's `##` sections (board-coordination.md#rulings). bd lint accepts the words anywhere in the text,
# so board checks the headings itself.
RECORD_SECTIONS = ('Question', 'Alternatives Considered', 'Decision', 'Rationale', 'Rule owner')
# A pending revision is a `tracks` edge from the new decision to the record it revises: bd 1.3.1 rejects custom
# dependency types, `tracks` never blocks, no other board use exists, and `board ruling supersede` replaces the pair's edge, so the
# link lives exactly until release. The partial rule's name sits in the new record's metadata.
REVISES = 'tracks'
REVISES_RULE = 'board.revises_rule'
REGISTRY = Path(__file__).resolve().parent / 'session'
SYNC_SECONDS = float(os.environ.get('AGENT_BOARD_SYNC_SECONDS') or 60)  # the send window and the pull interval; tests shorten it
PULL_TIMEOUT = 5  # a pull a command waits for gives up after this
SYNC_TIMEOUT = 300  # a sync running longer counts as stuck
SYNC_ATTEMPTS = 5  # tries per window, SYNC_RETRY_SECONDS apart; then the next board command starts a new wait
SYNC_RETRY_SECONDS = 5
SYNC_REPORT_AFTER = 3  # consecutive failures before every command reports them; single ones recover by themselves
WRITE_RETRIES = 4
# bd raises this on a write that meets a sync's merge. Retire the retry when a bd release stops raising it: rerun the soak (bin/test-shared-board.py).
# On a bd upgrade recheck beads issues 4796 and 7839 and PR 7849.
# `Merge conflict detected` is a different error, a stopped merge, and never retried.
WRITE_RETRY_ERROR = 'foreign key conflicts'
STORE_WARN_BYTES = 1 << 30
STORE_CHECK_SECONDS = 3600
QUEUE_PREFIX = 'queue:'
MOVERS = ('lead', 'solo')  # roles that may change an item's queue
FOR_PREFIX = 'for:'  # an item filed for a person: held for its creator's check, then in that person's inbox
USER_HOLD = 'user'  # the assignee of an item waiting on its person
# The mark that makes a board shared, in .beads: local, so an unshared board's check costs no bd call, and written only after
# share's first push or join's clone, so a stray Dolt remote shares nothing.
MARK_FILE = 'board-shared.json'
SHARED_BY = 'custom.board.shared'  # travels with the database: the sharer labelled the existing items
MOVED = 'custom.board.moved'  # travels with the database: the board moved to this url (board move); its clones rejoin there
# The board settings, owned here (board setup applies them; share and join add the shared ones). In the database: they travel
# with a shared board's sync. min_hash_length is a real key bd warns about as unrecognized: top-level ids of 5+ characters.
TRAVELLING_CONFIG = (('status.custom', 'decided:wip,released:active,in_review:wip,needs_ratification:wip,needs_acceptance:wip'),
                     ('types.custom', 'design,change-request'), ('min_hash_length', '5'))
# In .beads/config.yaml: they do not travel, so each clone sets them. no-git-ops stays true as `init --stealth` sets it: bd 1.3
# keys its stealth handling on it (with false, `bd doctor --fix` writes a project .gitignore).
LOCAL_CONFIG = (('create.require-description', 'true'), ('validation.on-close', 'error'),
                ('lint.sections.decision', 'Question,Decision,Rule owner'), ('events-journal', 'true'),
                ('events-journal-retain-days', '30'), ('no-git-ops', 'true'))
SERVER_CONFIG = (('dolt.auto-start', 'false'),)  # a server-mode board: board starts a stopped server itself (ensure_server)
SHARED_CONFIG = (('dolt.auto-commit', 'batch'),)  # a shared board: one commit per sync
SENT_AT = 'sent_at'  # item metadata: when board send last put the item in an inbox
CR_TYPE = 'change-request'
ACCEPT = 'needs_acceptance'  # a change request waiting for the user: finished (look before) or at a user design checkpoint


class BoardError(Exception):
    pass


def ids_of(records: list[dict]) -> set[str]:
    return {record['id'] for record in records}


def utcnow() -> datetime:
    return datetime.now(timezone.utc)


_actors: dict[tuple, str | None] = {}


def derived_actor() -> str | None:
    """BEADS_ACTOR (bd-guard sets it for Claude subagents), else the session's actor."""
    actor = os.environ.get('BEADS_ACTOR', '').strip()
    if actor:
        return actor
    key = tuple(os.environ.get(name, '') for name in ('CODEX_SESSION_ID', 'CODEX_THREAD_ID', 'CLAUDE_CODE_SESSION_ID'))
    if key not in _actors:
        result = subprocess.run(['bash', str(REGISTRY), 'actor'], capture_output=True, text=True)
        _actors[key] = result.stdout.strip() if result.returncode == 0 else None
    return _actors[key]


def bd_env() -> dict[str, str]:
    """BD_NO_REMOTE_ADOPT: bd may adopt git origin as a sync remote on its own; only `board share` pushes a board."""
    actor = derived_actor()
    return {**os.environ, 'BD_NO_REMOTE_ADOPT': '1', **({'BEADS_ACTOR': actor} if actor else {})}


_server_checked = False


def ensure_server(start: Path | None = None) -> None:
    """Start a stopped server of a server-mode board; bd's own auto-start is off."""
    global _server_checked
    if _server_checked:
        return
    _server_checked = True
    beads = beads_dir(start)
    if beads is None:
        return
    root = beads.parent
    try:
        if json.loads((beads / 'metadata.json').read_text(encoding='utf-8')).get('dolt_mode') != 'server':
            return
        port = int((beads / 'dolt-server.port').read_text(encoding='utf-8').strip())
        socket.create_connection(('127.0.0.1', port), timeout=1).close()
        return
    except (OSError, ValueError):
        pass
    if os.environ.get('CODEX_SANDBOX'):
        raise BoardError('the board server is unreachable from this sandbox: rerun with elevated sandbox permissions')
    subprocess.run(['bd', 'dolt', 'start'], cwd=root, capture_output=True, env=bd_env())


def bd(*args: str, stdin: str | None = None) -> subprocess.CompletedProcess:
    ensure_server()
    for retry in range(1, WRITE_RETRIES + 2):
        result = subprocess.run(['bd', *args], input=stdin, capture_output=True, text=True, env=bd_env())
        if result.returncode == 0 or shared is None or retry > WRITE_RETRIES or WRITE_RETRY_ERROR not in result.stdout + result.stderr:
            return result
        print(f'board: bd {args[0]} met a sync ({WRITE_RETRY_ERROR}); retry {retry} of {WRITE_RETRIES}', file=sys.stderr)
        time.sleep(1)
    raise AssertionError('unreachable')


def bd_checked(*args: str, stdin: str | None = None) -> str:
    result = bd(*args, stdin=stdin)
    if result.returncode != 0:
        raise BoardError(f"`bd {' '.join(args)}` failed: {(result.stderr or result.stdout).strip()}")
    return result.stdout


# Shared boards: skills/shared/beads-setup.md#shared-boards.

def beads_dir(start: Path | None = None) -> Path | None:
    """This folder's board: BEADS_DIR (as bd reads it), else the nearest `.beads`, else (a linked worktree) the main checkout's."""
    named = Path(os.environ['BEADS_DIR']) if os.environ.get('BEADS_DIR') else None
    if named is not None and (named / 'metadata.json').is_file():
        return named
    start = (start or Path.cwd()).resolve()
    found = next((d / '.beads' for d in (start, *start.parents) if (d / '.beads' / 'metadata.json').is_file()), None)
    if found is not None:
        return found
    try:
        common = subprocess.run(['git', 'rev-parse', '--path-format=absolute', '--git-common-dir'], cwd=start,
                                capture_output=True, text=True)
    except OSError:
        return None
    beads = Path(common.stdout.strip()).parent / '.beads'
    return beads if common.returncode == 0 and (beads / 'metadata.json').is_file() else None


def read_mark(beads: Path) -> dict | None:
    try:
        mark = json.loads((beads / MARK_FILE).read_text(encoding='utf-8'))
    except (OSError, ValueError):
        return None
    return mark if isinstance(mark, dict) and isinstance(mark.get('remote'), str) and mark['remote'] else None


def write_mark(beads: Path, remote: str) -> None:
    temporary = beads / f'{MARK_FILE}.{os.getpid()}.tmp'
    temporary.write_text(json.dumps({'remote': remote}), encoding='utf-8')
    temporary.replace(beads / MARK_FILE)


def bd_remotes() -> dict[str, str]:
    """Remote name -> url of this folder's board (share, join and move only: a bd call)."""
    rows = json.loads(bd_checked('sql', '--json', 'select name, url from dolt_remotes') or '[]')
    return {row['name']: row['url'] for row in rows}


def remote_branches(remote: str) -> int:
    """The remote's branches this board has fetched: none before its first push or clone."""
    return int(json.loads(bd_checked('sql', '--json', f"select count(*) c from dolt_remote_branches where name like 'remotes/{remote}/%'"))[0]['c'])


def config_value(key: str) -> str | None:
    rows = json.loads(bd_checked('sql', '--json', f"select value from config where `key` = '{key}'") or '[]')
    return rows[0]['value'] if rows and rows[0].get('value') else None


def git_url(url: str) -> str:
    """The url git itself takes for a bd git remote."""
    return url[len('git+'):] if url.startswith('git+') else url


def remote_refs(url: str) -> tuple[list[str] | None, str]:
    """(the repository's refs, the error): None when it can't be read; `refs/dolt/data` holds a board. Only bd's git remotes:
    other Dolt remotes give (None, '')."""
    if not url.startswith('git+'):
        return None, ''
    try:
        result = subprocess.run(['git', 'ls-remote', git_url(url)], capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as error:
        return None, str(error)
    if result.returncode != 0:
        return None, last_line(result.stderr)
    return [row.split('\t', 1)[1] for row in result.stdout.splitlines() if '\t' in row], ''


def moved_refusal(url: str) -> str:
    return f'this board moved to {url}: writes here are refused. Rejoin: board join {url} (beads-setup.md#history)'


def person() -> str | None:
    """The person whose queue this checkout works from: git config agents.person, global or per repository."""
    try:
        result = subprocess.run(['git', 'config', '--get', 'agents.person'], capture_output=True, text=True)
    except OSError:
        return None
    return result.stdout.strip() or None


PERSON_HELP = 'set your person: git config --global agents.person <name> (without --global for this repository only)'


class Shared:
    """A board marked shared (`MARK_FILE`). Files in .beads/board-sync: `wait.lock` (the one wait, freed when it dies), `pull.lock`,
    `unsent` (its mtime is the first unsent write, the window's start), `wrote` (stamped after each write, so a wait about
    to end sees a write that found it still running), `pulled` (last pull started),
    `state.json` (the reported problem, and `moved`: the url a pulled moved note names, read by every command)."""

    def __init__(self, beads: Path, remote: str):
        self.root, self.remote = beads.parent, remote
        self.dir = beads / 'board-sync'
        self.beads = beads

    def path(self, name: str) -> Path:
        self.dir.mkdir(exist_ok=True)
        return self.dir / name

    def mtime(self, name: str) -> float | None:
        try:
            return (self.dir / name).stat().st_mtime
        except OSError:
            return None

    def state(self) -> dict:
        try:
            state = json.loads((self.dir / 'state.json').read_text(encoding='utf-8'))
        except (OSError, ValueError):
            return {}
        return state if isinstance(state, dict) else {}

    def update_state(self, **fields) -> None:
        temporary = self.path(f'state.{os.getpid()}.tmp')
        temporary.write_text(json.dumps({**self.state(), **fields}), encoding='utf-8')
        temporary.replace(self.path('state.json'))

    def lock(self, name: str, tries: int = 1):
        """The named lock, or None when another process holds it; released when the file closes or the process dies."""
        handle = self.path(name).open('w')
        for attempt in range(tries):
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return handle
            except OSError:
                if attempt + 1 < tries:
                    time.sleep(0.2)
        handle.close()
        return None

    def waiting(self) -> dict | None:
        """{'unsent': a write or commit has not reached the remote, 'conflicts': live conflict rows}; None when the
        server does not answer. A commit a failed sync left behind counts: the working set alone would strand it."""
        ensure_server(self.root)
        result = subprocess.run(['bd', 'sql', '--json',
                                 "select (select count(*) from dolt_status) dirty, (select count(*) from dolt_conflicts) conflicts, "
                                 "(select hash from dolt_branches where name = active_branch()) local, "
                                 f"(select hash from dolt_remote_branches where name = concat('remotes/{self.remote}/', active_branch())) remote"],
                                cwd=self.root, capture_output=True, text=True, env=bd_env())
        try:
            row = json.loads(result.stdout)[0]
        except (ValueError, IndexError, KeyError, TypeError):
            return None
        return {'unsent': bool(int(row['dirty'])) or row['local'] != row['remote'], 'conflicts': int(row['conflicts'])}

    def spawn_wait(self) -> None:
        """Detached: its own session, no inherited pipes, or the caller's tool call would stay open for the whole wait."""
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), '_sync-wait'], cwd=self.root, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True, env=bd_env())

    def wait_running(self) -> bool:
        """A shared probe: probes never collide with each other, and `wait` retries past a passing one."""
        with self.path('wait.lock').open('w') as handle:
            try:
                fcntl.flock(handle, fcntl.LOCK_SH | fcntl.LOCK_NB)
            except OSError:
                return True
        return False

    def start_wait(self) -> None:
        """Starts the wait for known unsent writes, a window after the last failure at the earliest: a stopped sync must
        not run again on every command."""
        failed = self.state().get('last_failure')
        if not failed or time.time() - failed >= SYNC_SECONDS:
            self.spawn_wait()

    def before(self) -> None:
        """Restarts a dead wait; pulls when due and nothing is waiting. One process pulls, others carry on."""
        if self.wait_running():
            return
        if self.mtime('unsent') is not None:
            self.start_wait()
            return
        pulled = self.mtime('pulled')
        if pulled is not None and time.time() - pulled < SYNC_SECONDS:
            return
        handle = self.lock('pull.lock')
        if handle is None:
            return
        with handle:
            now = self.waiting()
            if now is None:
                return
            if now['unsent']:  # a pull would commit it and undo the grouping; a write from outside board comes here
                self.path('unsent').touch()
                self.start_wait()
                return
            self.path('pulled').touch()
            self.pull()
            self.check_store()

    def pull(self) -> None:
        child = subprocess.Popen(['bd', 'dolt', 'pull', '--remote', self.remote], cwd=self.root, stdin=subprocess.DEVNULL,
                                 stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, start_new_session=True, env=bd_env())
        try:
            output, _ = child.communicate(timeout=PULL_TIMEOUT)
        except subprocess.TimeoutExpired:
            with contextlib.suppress(OSError):
                os.killpg(child.pid, signal.SIGKILL)
            child.wait()
            self.failed(f'a pull took over {PULL_TIMEOUT} s')
            return
        if child.returncode == 0:
            self.succeeded()
            self.check_moved()
            return
        now = self.waiting()
        if now and now['conflicts']:
            self.update_state(kind='conflict', last_failure=time.time())
        else:
            self.failed(last_line(output))

    def after(self) -> None:
        """A command that may have written: starts the window unless a wait is on it. Clears a conflict report once
        the conflict is gone (resolved, or the merge aborted); the wait's next sync says how it went."""
        self.path('wrote').touch()
        if self.wait_running() and self.state().get('kind') != 'conflict':
            return
        now = self.waiting()
        if now is None:
            return
        if self.state().get('kind') == 'conflict' and not now['conflicts']:
            self.update_state(kind=None, failures=0, last_failure=None, detail=None)
        if now['unsent'] and not self.wait_running():
            if self.mtime('unsent') is None:
                self.path('unsent').touch()
            self.start_wait()

    def succeeded(self) -> None:
        if self.state().get('failures') or self.state().get('kind') or self.state().get('last_failure'):
            self.update_state(kind=None, failures=0, detail=None, last_failure=None)

    def moved(self) -> str | None:
        return self.state().get('moved') or None

    def check_moved(self) -> None:
        """After each pull: whether the board brought a moved note (board move). A failed read keeps what was known."""
        ensure_server(self.root)
        result = subprocess.run(['bd', 'sql', '--json', f"select value from config where `key` = '{MOVED}'"], cwd=self.root,
                                capture_output=True, text=True, env=bd_env())
        try:
            rows = json.loads(result.stdout)
        except ValueError:
            return
        url = rows[0].get('value') if rows and isinstance(rows[0], dict) else None
        if (url or None) != self.moved():
            self.update_state(moved=url or None)

    def failed(self, detail: str, kind: str = 'failing') -> None:
        self.update_state(kind=kind, failures=int(self.state().get('failures') or 0) + 1, detail=detail, last_failure=time.time())

    def sync_once(self) -> bool:
        """One commit and sync. True when the wait may go on trying (it succeeded, or the failure is transient)."""
        subprocess.run(['bd', 'dolt', 'commit', '-m', f"sync {person() or socket.gethostname()}"], cwd=self.root,
                       capture_output=True, env=bd_env())
        try:
            result = subprocess.run(['bd', 'sync', '--remote', self.remote], cwd=self.root, capture_output=True, text=True,
                                    timeout=SYNC_TIMEOUT, env=bd_env())
        except subprocess.TimeoutExpired:
            self.failed(f'a sync ran over {SYNC_TIMEOUT} s', 'stuck')
            return False
        if result.returncode == 0:
            self.succeeded()
            self.path('pulled').touch()
            self.check_moved()
            return True
        if result.returncode == 2:
            self.failed('', 'conflict')
            return False
        if result.returncode == 4:
            self.failed('uncommitted changes block every sync', 'stuck')
            return False
        self.failed(last_line(result.stderr or result.stdout))
        return True

    def send(self) -> bool:
        for attempt in range(SYNC_ATTEMPTS):
            if attempt:
                time.sleep(SYNC_RETRY_SECONDS)
            if not self.sync_once():
                return False
            if not self.state().get('failures'):
                return True
        return False

    def wait(self) -> int:
        """`board _sync-wait`: the first unsent write opens a window; at its end, commit and sync; writes during the sync
        open the next. Ends when nothing is left, or after a failed window with `unsent` kept for the next command."""
        while True:
            handle = self.lock('wait.lock', tries=5)
            if handle is None:
                return 0
            with handle:
                while True:
                    stamp = self.mtime('wrote')
                    now = self.waiting()
                    if now is None:
                        self.failed('the board server does not answer')
                        return 1
                    if now['conflicts']:
                        self.failed('', 'conflict')
                        return 1
                    if not now['unsent']:
                        with contextlib.suppress(OSError):
                            (self.dir / 'unsent').unlink()
                        break
                    if self.mtime('unsent') is None:
                        self.path('unsent').touch()
                    first = self.mtime('unsent') or time.time()
                    time.sleep(max(0.0, first + SYNC_SECONDS - time.time()))
                    (self.dir / 'unsent').unlink(missing_ok=True)  # a write from here on opens the next window
                    if not self.send():
                        self.path('unsent').touch()
                        os.utime(self.path('unsent'), (first, first))
                        return 1
            if self.mtime('wrote') == stamp:
                return 0

    def check_store(self) -> None:
        """Hourly: walking the store on every command would cost more than the warning is worth."""
        state = self.state()
        if time.time() - float(state.get('store_checked') or 0) < STORE_CHECK_SECONDS:
            return
        size = sum(entry.stat().st_size for entry in (self.beads / 'dolt').rglob('*') if entry.is_file())
        self.update_state(store_checked=time.time(), store_bytes=size, store_warned=False)

    def problem(self) -> str | None:
        """The one line for a stopped or repeatedly failing sync, with its fix; None while single failures recover."""
        state = self.state()
        kind, detail = state.get('kind'), state.get('detail') or ''
        if state.get('moved'):
            return moved_refusal(state['moved'])
        if kind == 'conflict':
            return ('sync stopped by a merge conflict, nothing goes out. Fix: board bd conflicts show, board bd conflicts '
                    'resolve <id> --ours|--theirs, board bd sync. Both sides created one id: board bd sql '
                    '"CALL DOLT_MERGE(\'--abort\')", board bd rename <id> <new id>, board bd sync')
        if kind == 'stuck':
            return f'sync stuck: {detail}. Fix: board bd sync shows the error; board bd dolt commit -m "<why>" clears uncommitted changes'
        if kind == 'failing' and int(state.get('failures') or 0) >= SYNC_REPORT_AFTER:
            return f"sync failing, {state['failures']} tries: {detail}. Fix: check the remote and your access; board bd sync shows the error"
        return None

    def store_warning(self) -> str | None:
        size = int(self.state().get('store_bytes') or 0)
        if size < STORE_WARN_BYTES:
            return None
        return f'board store is {size / (1 << 30):.1f} GB: plan a flatten with the others (beads-setup.md#history)'

    def report(self) -> None:
        """What every command prints, on stderr: the protocol, the console and --json views read stdout."""
        problem = self.problem()
        if problem:
            print(f'board: {problem}', file=sys.stderr)
        warning = self.store_warning()
        if warning and not self.state().get('store_warned'):
            self.update_state(store_warned=True)
            print(f'board: {warning}', file=sys.stderr)
        if person() is None:
            print(f'board: {PERSON_HELP}', file=sys.stderr)


def last_line(text: str) -> str:
    lines = [row.strip() for row in text.splitlines() if row.strip()]
    return next((row for row in lines if row.startswith('Error')), lines[-1] if lines else 'no output')[:200]


shared: Shared | None = None
settled = False  # a read finished a landing (settle_landed): its writes need the sync window like a write command's


def find_shared(start: Path | None = None) -> Shared | None:
    beads = beads_dir(start)
    mark = read_mark(beads) if beads else None
    return Shared(beads, mark['remote']) if mark else None


def may_move(board: 'Board | None' = None) -> bool:
    """A person's terminal has no actor and isn't limited; a session with no registered role and a worker count as agents."""
    actor = derived_actor()
    if not actor:
        return True
    if actor != session_actor(actor):
        return False
    try:
        entry = (board.registry() if board else registry_by_actor(registrations()[0])).get(actor)
    except BoardError:
        return False
    return bool(entry and entry.get('role') in MOVERS)


def bd_show(ids: list[str], *flags: str, comments: bool = True) -> list[dict]:
    """Full records of the ids that exist (bd reports unknown ids on stderr, or fails when none exists)."""
    result = bd('show', '--json', *(['--include-comments'] if comments else []), '--brief-deps', *flags, '--', *ids)
    if result.returncode != 0:
        try:
            if 'no issues found' in json.loads(result.stdout).get('error', ''):
                return []
        except (ValueError, AttributeError):
            pass
        raise BoardError(f"`bd show` failed: {(result.stderr or result.stdout).strip()}")
    return json.loads(result.stdout or '[]')


def registrations() -> tuple[list[dict], set[str]]:
    """(readable registrations, actors of the files that cannot be read): one `session list` call. An unreadable
    file's session counts as unregistered; the person is told once."""
    result = subprocess.run(['bash', str(REGISTRY), 'list'], capture_output=True, text=True)
    if result.returncode != 0:
        raise BoardError(f'session registry unreadable: {result.stderr.strip()}')
    rows = [json.loads(line) for line in result.stdout.splitlines() if line.strip()]
    skipped = [row['unreadable'] for row in rows if 'unreadable' in row]
    for file in skipped:
        print(f'session: skipped unreadable registration {file}', file=sys.stderr)
    return [row for row in rows if 'unreadable' not in row], {Path(file).stem[-8:] for file in skipped}


def bd_closed() -> list[dict]:
    """Every closed item without its free text, in one call."""
    return json.loads(bd_checked('list', '--status', 'closed', '--brief', '--json', '--limit', '0') or '[]')


_prefix: list[str | None] = []


def board_prefix() -> str | None:
    """The board's own id prefix (bd `issue_prefix`), read once; None when bd has none to give."""
    if not _prefix:
        try:
            _prefix.append(current_setting('issue_prefix') or None)
        except (BoardError, ValueError):
            _prefix.append(None)
    return _prefix[0]


def board_id(raw: str) -> str:
    """An id as bd takes it: a bare one (`28g0i`, `overhaul.2.25`; every full id has `<prefix>-`) gets the board's prefix."""
    prefix = board_prefix() if re.fullmatch(r'[0-9a-z][0-9a-z.]*', raw) else None
    return f'{prefix}-{raw}' if prefix else raw


def board_project() -> str | None:
    """The resolved folder holding this board: the parent of the first line of `bd where` (a worktree names the main
    checkout's .beads); None when the lookup fails. The registry records the same value (session project)."""
    result = bd('where')
    first = result.stdout.splitlines()[0].strip() if result.returncode == 0 and result.stdout.strip() else ''
    return str(Path(first).parent.resolve()) if first.startswith('/') else None


def parse_time(value) -> datetime | None:
    if not isinstance(value, str) or not value:
        return None
    try:
        moment = datetime.fromisoformat(value.replace('Z', '+00:00'))
    except ValueError:
        return None
    return moment if moment.tzinfo is not None else moment.replace(tzinfo=timezone.utc)


def age(moment: datetime | None) -> str:
    if moment is None:
        return 'age unknown'
    minutes = int((utcnow() - moment).total_seconds() // 60)
    if minutes < 120:
        return f'{minutes} min'
    if minutes < 48 * 60:
        return f'{minutes // 60} h'
    return f'{minutes // 1440} d'


def session_actor(actor: str) -> str:
    return actor.split('/', 1)[0]


_processes: dict[int, str | None] = {}  # pid -> start time, 'GONE', or None (unknown); per run


def holder_worker(holder: str) -> str | None:
    """The holding worker's marker name (its id's last 8 characters), None for a session hold."""
    return holder.split('/', 1)[1][-8:] if '/' in holder else None


def hooks_live(entry: dict | None) -> bool:
    """The session's activity hooks run: its own activity file exists. Without it, a missing worker marker or a
    marker's age proves nothing (a worker spawned before the hooks, or hooks not yet trusted)."""
    return bool(entry and entry.get('active_at'))


def worker_stopped(entry: dict | None, issue: dict) -> bool:
    """The holding worker has no running marker, and the session's own activity is newer than the item's
    `updated_at`: every claim updates it (later updates only raise it), so the hooks ran after this claim and a
    running worker would have a marker. Not `started_at`: it can predate the hold (a reclaim, a reviewer's claim).
    Only its owning session (`board mine`) acts on it: only the owner knows whether it continues the worker."""
    worker = holder_worker(issue.get('assignee') or '')
    if not (entry and worker) or worker in (entry.get('workers') or {}):
        return False
    active, claimed = parse_time(entry.get('active_at')), parse_time(issue.get('updated_at'))
    return bool(active and claimed and active > claimed)


def holder_activity(entry: dict | None, holder: str) -> datetime | None:
    """The holder's last tool call: a running worker's marker, else (a session hold, a stopped worker) the session's
    own; None without activity data (the session's hooks not live)."""
    if not hooks_live(entry):
        return None
    worker = holder_worker(holder)
    moment = parse_time((entry.get('workers') or {}).get(worker)) if worker else None
    return moment or parse_time(entry.get('active_at'))


def active_workers(entry: dict | None) -> list[str]:
    """The session's running workers with a tool call within WORKER_ACTIVE_MINUTES."""
    since = utcnow() - timedelta(minutes=WORKER_ACTIVE_MINUTES)
    return [worker for worker, moment in ((entry or {}).get('workers') or {}).items()
            if (parse_time(moment) or since) > since]


def worker_cap(entry: dict) -> int:
    """The session's own `worker_cap`, else WORKER_CAP, lowered for a Codex session by the effective `agents.max_threads` or
    `agents.max_concurrent_threads_per_session`: Codex's layers, the system config (CODEX_SYSTEM_CONFIG; tests set
    AGENT_CODEX_SYSTEM_CONFIG) overridden per key by `$CODEX_HOME/config.toml` (default ~/.codex)."""
    own = entry.get('worker_cap')
    cap = own if isinstance(own, int) and not isinstance(own, bool) and own >= 0 else WORKER_CAP
    if entry.get('tool') != 'codex':
        return cap
    layers = (Path(os.environ.get('AGENT_CODEX_SYSTEM_CONFIG') or CODEX_SYSTEM_CONFIG),
              Path(os.environ.get('CODEX_HOME') or Path.home() / '.codex') / 'config.toml')
    agents: dict = {}
    for path in layers:
        try:
            layer = tomllib.loads(path.read_text(encoding='utf-8')).get('agents')
        except (OSError, ValueError):  # a missing or unreadable layer sets nothing
            continue
        agents.update(layer if isinstance(layer, dict) else {})
    for key in ('max_threads', 'max_concurrent_threads_per_session'):
        value = agents.get(key)
        if isinstance(value, int) and not isinstance(value, bool) and value > 0:
            cap = min(cap, value)
    return cap


def process_started(pid: int) -> str | None:
    """The process's start time as `ps -o lstart=` prints it in UTC (whitespace-normalized; session
    stores the same form), or None when ps fails for any reason."""
    try:
        result = subprocess.run([shutil.which('ps') or '/bin/ps', '-o', 'lstart=', '-p', str(pid)], capture_output=True,
                                text=True, env={**os.environ, 'LC_ALL': 'C', 'TZ': 'UTC0'})
    except OSError:
        return None
    started = ' '.join(result.stdout.split())
    return started if result.returncode == 0 and started else None


def liveness(entry: dict | None) -> str | None:
    """'GONE' when the session's registered pid no longer exists or now names a process started at another
    time, 'alive' when it matches, None when unknown (no entry, no pid, ps failed): unknown keeps the idle hint."""
    if entry is None:
        return None
    pid, started = entry.get('pid'), entry.get('pid_started')
    if not isinstance(pid, int) or pid <= 1 or not isinstance(started, str):
        return None
    if pid not in _processes:
        try:
            os.kill(pid, 0)
            _processes[pid] = process_started(pid)
        except ProcessLookupError:
            _processes[pid] = 'GONE'
        except PermissionError:  # exists, owned by another user
            _processes[pid] = process_started(pid)
        except OSError:
            _processes[pid] = None
    current = _processes[pid]
    if current is None:
        return None
    return 'GONE' if current == 'GONE' or current != ' '.join(started.split()) else 'alive'


class Board:
    def __init__(self, issues: list[dict], complete: bool = True):
        """complete: the snapshot holds closed items too. Without them (status reads) a dependency target that is
        missing counts as closed; with them a missing one is unknown and counts as open (fail closed)."""
        self.complete = complete
        self._hydrated: set[str] = set()
        self.issues = issues
        self._milestone_work: dict[str, set[str]] = {}
        self._in_milestone: dict[str, list[str]] | None = None
        self._accept_queue: tuple[tuple, list[dict]] | None = None  # (key, queue): see accept_queue
        self.effective: dict[str, tuple[int, str | None, bool]] = {}  # item id -> effective_priority
        self.by_id = {issue['id']: issue for issue in issues}
        self.parent: dict[str, str] = {}
        self.parents: dict[str, list[str]] = {}  # bd allows several; `parent` keeps the last for the views that assume one
        self.view: str | None = None  # the queue the default lists show; None: every item (an unshared board, --queue all)
        self._loaded = ids_of(issues)
        self._outside: dict[str, tuple[list[str], list[str]]] = {}  # item not in the snapshot -> (labels, parents)
        self._outside_type: dict[str, str | None] = {}
        self.settings: dict[str, str] = {}  # project settings read so far (board_setting)
        self._registry: dict[str, dict] | None = None
        self._unreadable: set[str] = set()
        self._ended: set[str] | None = None
        self._cr_blockers_read = False
        self.git_view: GitView | None = None  # set by `read_git_view` on a read-only command; dropped when the command changes git state
        self._ref_format: dict[str, bool] = {}
        self._cr: dict[str, dict] = {}  # change request id -> git facts read so far (cr_info)
        self._cr_items: dict[str, list[dict]] = {}
        self._queues: dict[str, list[str]] = {}
        self.children: dict[str, list[str]] = {}
        self.blockers: dict[str, list[str]] = {}  # waiting id -> ids it waits on
        self.dependents: dict[str, list[str]] = {}  # blocker id -> waiting ids
        self.linked: dict[str, set[str]] = {}  # id -> ids sharing any non-parent edge
        self.related: dict[str, set[str]] = {}  # relates-to, both ends
        self.edges: dict[str, list[tuple[str, str, bool]]] = {}  # id -> (other id, type, outgoing)
        for issue in issues:
            for dep in issue.get('dependencies') or []:
                waiting, target, kind = dep['issue_id'], dep['depends_on_id'], dep['type']
                self.edges.setdefault(waiting, []).append((target, kind, True))
                self.edges.setdefault(target, []).append((waiting, kind, False))
                if kind == 'parent-child':
                    self.parent[waiting] = target
                    if target not in self.parents.setdefault(waiting, []):
                        self.parents[waiting].append(target)
                    self.children.setdefault(target, []).append(waiting)
                    continue
                self.linked.setdefault(waiting, set()).add(target)
                self.linked.setdefault(target, set()).add(waiting)
                if kind == 'blocks':
                    self.blockers.setdefault(waiting, []).append(target)
                    self.dependents.setdefault(target, []).append(waiting)
                elif kind in ('relates-to', 'related'):
                    self.related.setdefault(waiting, set()).add(target)
                    self.related.setdefault(target, set()).add(waiting)

    @classmethod
    def load(cls, scope: str = 'status', ids: list[str] | None = None) -> 'Board':
        """The one place that picks the bd read, sized to the view:
        status: non-closed items with dependencies, no comments (`hydrate` adds the held items' comments);
        all: `bd export`, closed items and comments included;
        ids: only the named items with their comments and both edge directions (`board show`)."""
        if scope == 'all':
            lines = bd_checked('export').splitlines()
            return cls([issue for issue in map(json.loads, filter(str.strip, lines)) if issue.get('_type', 'issue') == 'issue'])
        if scope == 'status':
            issues = json.loads(bd_checked('list', '--json', '--limit', '0', '--include-gates') or '[]')
            for issue in issues:  # bd export orders an item's edges by target; list does not, and blocker order is printed
                issue['dependencies'] = sorted(issue.get('dependencies') or [], key=lambda d: (d['depends_on_id'], d['type']))
            return cls(issues, complete=False)
        records = bd_show(ids or [], '--include-dependents')
        edges, stubs = set(), {}
        for record in records:
            for stub, outgoing, key in [(d, True, 'dependencies') for d in record.get('dependencies') or []] \
                    + [(d, False, 'dependents') for d in record.get('dependents') or []]:
                edges.add((record['id'], stub['id'], stub['dependency_type']) if outgoing
                          else (stub['id'], record['id'], stub['dependency_type']))
                stubs[stub['id']] = stub
        for record in records:  # the export's edge shape: the item's own entries, both directions
            record['dependencies'] = [{'issue_id': a, 'depends_on_id': b, 'type': kind}
                                      for a, b, kind in sorted(edges) if record['id'] in (a, b)]
            record.pop('dependents', None)
        board = cls(records, complete=False)
        # A revision pending names its new record's partial rule, kept in that record's metadata.
        newer = sorted({a for a, b, kind in edges if kind == REVISES and b in ids_of(records)
                        and board.by_id[b].get('issue_type') == 'decision'} - ids_of(records))
        full = {record['id']: record for record in bd_show(newer)} if newer else {}
        for other_id, stub in stubs.items():
            board.by_id.setdefault(other_id, full.get(other_id, stub))
        return board

    def registry(self) -> dict[str, dict]:
        """The session registry by actor, read once per command (board never writes it; a failed read is not kept)."""
        if self._registry is None:
            entries, self._unreadable = registrations()
            self._registry = registry_by_actor(entries)
        return self._registry

    def unreadable(self) -> set[str]:
        """Actors whose registration file exists but cannot be read, from the same `list` call as the registry."""
        self.registry()
        return self._unreadable

    def ended(self) -> set[str]:
        """Actors of the sessions whose registration was pruned (session `ended`), read on first use."""
        if self._ended is None:
            result = subprocess.run(['bash', str(REGISTRY), 'ended'], capture_output=True, text=True)
            self._ended = set(result.stdout.split()) if result.returncode == 0 else set()
        return self._ended

    def hydrate(self, ids) -> None:
        """Adds what a status read leaves out, for the given items, in one bd call: comments, and an epic's
        `epic_total_children` (its closed children are not in the read)."""
        todo = [item_id for item_id in dict.fromkeys(ids) if item_id in self.by_id and item_id not in self._hydrated]
        if not self.complete and todo:
            epics = any(self.by_id[item_id].get('issue_type') == 'epic' for item_id in todo)
            for record in bd_show(todo, *(['--include-dependents'] if epics else [])):  # only then bd counts an epic's children
                self.by_id[record['id']]['comments'] = record.get('comments') or []
                if 'epic_total_children' in record:
                    self.by_id[record['id']]['epic_total_children'] = record['epic_total_children']
        self._hydrated.update(todo)

    def held_ids(self) -> list[str]:
        """Held items: `last_activity` needs their comments (comments do not bump updated_at)."""
        return [issue['id'] for issue in self.issues if issue['status'] != 'closed' and issue.get('assignee')]

    def finished_epic(self, issue: dict) -> bool:
        """An epic with children, none of them open (needs `hydrate` of childless epics on a status read)."""
        return issue.get('issue_type') == 'epic' and bool(self.children.get(issue['id']) or issue.get('epic_total_children')) \
            and not any(self.is_open(child) for child in self.children.get(issue['id'], []))

    def ancestors(self, item_id: str):
        seen = set()
        while item_id in self.parent and item_id not in seen:
            seen.add(item_id)
            item_id = self.parent[item_id]
            yield item_id

    def scoped(self, root: str | None) -> list[dict]:
        if root is None:
            return self.issues
        if root not in self.by_id and (self.complete or root not in self.edges):  # a closed root: only its edges show
            raise BoardError(f'unknown root {root}')
        if self.by_id.get(root, {}).get('issue_type') == 'milestone':
            work = self.milestone_work(root) | {root}
            return [issue for issue in self.issues if issue['id'] in work]
        return [issue for issue in self.issues if root in self.ancestors(issue['id'])]

    def routing(self, item_id: str) -> tuple[list[str], list[str]]:
        """(labels, parents) of an item, reading ancestors the snapshot lacks (a status read holds no closed items) in one call."""
        if item_id in self._loaded:
            return self.by_id[item_id].get('labels') or [], self.parents.get(item_id, [])
        self.fetch_outside([item_id])
        return self._outside[item_id]

    def fetch_outside(self, item_ids) -> None:
        """Reads the given items the snapshot lacks, with the parents it lacks, in one call."""
        wanted = {i for i in item_ids if i not in self._loaded and i not in self._outside}
        if not wanted:
            return
        missing = wanted | {p for parents in self.parents.values() for p in parents if p not in self._loaded and p not in self._outside}
        for record in bd_show(sorted(missing), comments=False):
            self._outside[record['id']] = (record.get('labels') or [],
                                           [d['id'] for d in record.get('dependencies') or [] if d.get('dependency_type') == 'parent-child'])
            self._outside_type[record['id']] = record.get('issue_type')
        for other in missing:
            self._outside.setdefault(other, ([], []))

    def queues(self, item_id: str, seen: frozenset = frozenset()) -> list[str]:
        """Its own queue label(s), else the union of its parents': more than one means no queue can be picked."""
        if item_id not in self._queues:
            labels, parents = self.routing(item_id)
            own = sorted(label[len(QUEUE_PREFIX):] for label in labels if label.startswith(QUEUE_PREFIX))
            self._queues[item_id] = own or sorted({queue for parent in parents if parent not in seen
                                                   for queue in self.queues(parent, seen | {item_id})})
        return self._queues[item_id]

    def queue(self, item_id: str) -> str | None:
        """The item's queue; None: unrouted (no label on it or above it, or several queues disagree)."""
        names = self.queues(item_id)
        return names[0] if len(names) == 1 else None

    def listed(self, root: str | None) -> list[dict]:
        """What default lists and bare claims cover: `scoped`, narrowed to the viewed queue on a shared board."""
        scoped = self.scoped(root)
        return scoped if self.view is None else [issue for issue in scoped if self.queue(issue['id']) == self.view]

    def milestone_work(self, milestone_id: str) -> set[str]:
        """Open items the milestone waits on (board-coordination.md#milestones): its open blockers, the open
        descendants of every reached epic, and transitively the open blockers of every reached item."""
        if milestone_id not in self._milestone_work:
            work: set[str] = set()
            visited: set[tuple[str, bool]] = set()  # an item reached as a blocker may be reached again as a descendant
            pending = [(blocker, False) for blocker in self.blockers.get(milestone_id, [])]
            while pending:
                visit = pending.pop()
                item_id, descendant = visit
                if visit in visited or not self.is_open(item_id):
                    continue
                visited.add(visit)
                work.add(item_id)
                pending += [(blocker, False) for blocker in self.blockers.get(item_id, [])]
                if descendant or self.by_id[item_id].get('issue_type') in ('epic', CR_TYPE):
                    pending += [(child, True) for child in self.children.get(item_id, [])]
            self._milestone_work[milestone_id] = work
        return self._milestone_work[milestone_id]

    def milestones(self) -> list[dict]:
        return [issue for issue in self.issues if issue.get('issue_type') == 'milestone' and issue['status'] != 'closed']

    @property
    def in_milestone(self) -> dict[str, list[str]]:
        """Item id -> the open milestones it is work of."""
        if self._in_milestone is None:
            self._in_milestone = {}
            for milestone in self.milestones():
                for item_id in self.milestone_work(milestone['id']):
                    self._in_milestone.setdefault(item_id, []).append(milestone['id'])
        return self._in_milestone

    def between(self, a: str, b: str) -> list[tuple[str, str, str]]:
        """(from, to, type) of every edge between the pair, either direction."""
        return [(a, other, kind) if outgoing else (other, a, kind) for other, kind, outgoing in self.edges.get(a, [])
                if other == b]

    def revises(self, item_id: str) -> list[str]:
        """Records a decision revises (pending until release)."""
        if self.by_id.get(item_id, {}).get('issue_type') != 'decision':
            return []
        return [other for other, kind, outgoing in self.edges.get(item_id, []) if outgoing and kind == REVISES]

    def revised_by(self, item_id: str) -> list[str]:
        """The decisions whose pending revision names this record."""
        return [other for other, kind, outgoing in self.edges.get(item_id, [])
                if not outgoing and kind == REVISES and self.by_id.get(other, {}).get('issue_type') == 'decision']

    def is_open(self, item_id: str) -> bool:
        return item_id in self.by_id and self.by_id[item_id]['status'] != 'closed'

    def open_blockers(self, item_id: str) -> list[str]:
        # In a complete snapshot a missing blocker counts as open (fail closed); a status read holds no closed
        # items, so there it counts as closed. `external:` references never block in bd 1.3.1.
        return [blocker for blocker in self.blockers.get(item_id, [])
                if self.is_open(blocker)
                or (self.complete and blocker not in self.by_id and not blocker.startswith('external:'))]

    def unsettled_blockers(self, item_id: str) -> list[str]:
        """What holds a decided record's release or an answered question's close: a released ruling is a settled
        premise, which holds only the open items it changes until planned."""
        return [blocker for blocker in self.open_blockers(item_id)
                if self.by_id.get(blocker, {}).get('status') != 'released']

    def kind(self, issue: dict) -> str | None:
        status, kind = issue['status'], issue.get('issue_type')
        if kind == CR_TYPE:
            return self.cr_kind(issue)
        if kind == 'decision':
            return {'released': 'plan', 'open': 'question', 'needs_ratification': 'ratify'}.get(status)
        if status == 'needs_ratification' and kind in WORK_TYPES:
            return 'ratify'  # the ratification of a landed change request or an accepted design
        # Work items are claimed through their change request (by id, by the session holding it): no pull of their own;
        # a standalone review (an in_review task outside any CR, findings and no commits) is the exception.
        if status == 'in_review' and kind in WORK_TYPES and self.cr_of(issue['id']) is None:
            return 'review'
        return 'milestone' if status == 'open' and kind == 'milestone' else None

    def is_cr(self, item_id: str) -> bool:
        return self.by_id.get(item_id, {}).get('issue_type') == CR_TYPE

    def cr_of(self, item_id: str) -> str | None:
        """The live change request an item belongs to (itself, for a change request), else None."""
        if self.is_cr(item_id):
            return item_id
        if item_id in self._loaded:
            parents = self.parents.get(item_id, [])
        else:
            parents = self.routing(item_id)[1]
        return next((p for p in parents if self.is_cr(p)), None)

    def cr_items(self, cr_id: str) -> list[dict]:
        """The CR's items that are not closed. A ratification waits for its person and is no work of the CR."""
        return [self.by_id[c] for c in self.children.get(cr_id, []) if self.is_open(c) and self.by_id[c]['status'] != 'needs_ratification']

    def cr_kind(self, issue: dict) -> str | None:
        m = meta(issue)
        if issue['status'] == 'open':
            open_items = self.cr_items(issue['id'])
            if not open_items or m.get('replan'):
                return 'plan'
            return 'design' if all(i.get('issue_type') == 'design' for i in open_items) else 'implement'
        if issue['status'] == ACCEPT:
            return 'accept'
        if issue['status'] == 'in_review' and after_base(self, issue):
            return None  # passed, waiting for its parent to land (look after)
        return 'review' if issue['status'] == 'in_review' else None

    def stackable(self, issue: dict) -> bool:
        """May a change request build on this one: only a parent waiting for the user (look before), never one in agent review
        or at a design checkpoint (q235, q230)."""
        return issue['status'] == ACCEPT and not meta(issue).get('checkpoint')

    def cr_blockers(self, issue: dict) -> list[str]:
        """What the CR and its open items wait on, apart from each other."""
        members = [issue['id'], *self.children.get(issue['id'], [])]
        return [b for m in members if m in self.by_id and self.is_open(m) for b in self.blockers.get(m, []) if b not in members]

    def fetch_cr_blockers(self) -> None:
        """Reads the blockers outside the snapshot of every change request in one call, not one per request (a bd call
        costs ~0.1 s). Those are closed items, and all a change request needs of one is its parents (to lift it to its
        request): one list of the closed items, free text omitted, costs ~0.3 s however many blockers there are, where
        `bd show` of them cost ~16 ms each."""
        if not self._cr_blockers_read:
            wanted = [b for issue in self.issues if self.is_cr(issue['id']) for b in self.cr_blockers(issue)
                      if b not in self.by_id and not b.startswith('external:')]
            if any(b not in self._loaded and b not in self._outside for b in wanted):
                for row in bd_closed():
                    self._outside.setdefault(row['id'], (row.get('labels') or [], [d['depends_on_id'] for d in row.get('dependencies') or []
                                                                                  if d.get('type') == 'parent-child']))
                    self._outside_type.setdefault(row['id'], row.get('issue_type'))
            self.fetch_outside(wanted)  # what the list lacks (an item that is not closed or not there)
            self._cr_blockers_read = True  # only a read that worked: a failed one is asked again

    def cr_waits(self, issue: dict) -> tuple[list[str], list[str]]:
        """(waits, stackable bases) of a change request (A2): the blockers of the CR and of its open items, lifted to their CRs.
        An unlanded CR is a wait unless it is stackable; one stackable base is the base, a second one is a wait. Items of
        the CR order its own work only."""
        waits: list[str] = []
        bases: list[str] = []
        blockers = self.cr_blockers(issue)
        self.fetch_cr_blockers()
        for blocker in dict.fromkeys(blockers):
            record = self.by_id.get(blocker)
            if record is not None and not self.is_open(blocker) and self.cr_of(blocker) is None:
                continue  # closed
            if record is None and (blocker.startswith('external:') or (not self.complete and self.cr_of(blocker) is None)):
                continue  # closed outside a status snapshot, or never blocking
            if record is None and self.complete:
                waits.append(blocker)  # unknown: fail closed
                continue
            cr_id = self.cr_of(blocker)
            if cr_id is None:
                waits.append(blocker)
                continue
            target = self.by_id.get(cr_id)
            if target is None or target['status'] == 'closed':
                continue  # landed
            if cr_id == issue['id']:
                continue
            if self.stackable(target):
                if cr_id not in bases:
                    bases.append(cr_id)
            elif cr_id not in waits:
                waits.append(cr_id)
        if len(bases) > 1:
            waits += bases
            bases = []
        return waits, bases

    def foreign_waits(self, issue: dict) -> list[str]:
        """The open blockers a released ruling may not wait on (r21-q139): work and containers, not planning. Claiming
        ignores them and the claim names the fix (q140); `board check` lists them as `ruling-blocked`."""
        if issue.get('issue_type') != 'decision' or issue['status'] != 'released':
            return []
        return [blocker for blocker in self.open_blockers(issue['id'])
                if blocker in self.by_id and not planning_wait(self.by_id[blocker])]

    def planning_blockers(self, issue: dict) -> list[str]:
        """The open blockers that hold the item from being claimed."""
        ignored = set(self.foreign_waits(issue))
        return [blocker for blocker in self.open_blockers(issue['id']) if blocker not in ignored]

    def waits_of(self, issue: dict) -> list[str]:
        """What holds the item from its step: a change request's lifted waits, else its open blockers."""
        if issue.get('issue_type') == CR_TYPE:
            return self.cr_waits(issue)[0]
        return self.planning_blockers(issue)

    def step_kind(self, issue: dict) -> str | None:
        """The pull kind of an item, a change request in work included (the work pull that holds it)."""
        if issue.get('issue_type') == CR_TYPE and issue['status'] == 'in_progress':
            return self.cr_kind({**issue, 'status': 'open'})
        return self.kind(issue)

    def claimable(self, issue: dict) -> str | None:
        kind = self.kind(issue)
        if kind is None or issue.get('assignee'):
            return None
        if issue.get('issue_type') == CR_TYPE:
            return cr_claimable(self, issue, kind)
        return None if self.planning_blockers(issue) else kind

    def downstream(self, item_id: str, through_milestones: bool = True) -> int:
        """Open work waiting on an item. A milestone's whole scope waits on each member, which tells members apart by
        nothing: `through_milestones=False` counts a milestone as one item and stops there (r24-q109)."""
        seen: set[str] = set()
        pending = [item_id]
        while pending:
            for waiting in self.dependents.get(pending.pop(), []):
                if waiting not in seen and self.is_open(waiting):
                    seen.add(waiting)
                    if through_milestones or self.by_id.get(waiting, {}).get('issue_type') != 'milestone':
                        pending.append(waiting)
        return len(seen)

    def holds(self, item_id: str) -> tuple[int, int]:
        """(stopping at milestones, everything downstream): what `holds 2/52` prints and lists sort by."""
        return self.downstream(item_id, through_milestones=False), self.downstream(item_id)

    def last_activity(self, issue: dict) -> datetime | None:
        moments = [parse_time(issue.get('updated_at'))]
        moments += [parse_time(comment.get('created_at')) for comment in issue.get('comments') or []]
        moments = [moment for moment in moments if moment is not None]
        return max(moments) if moments else None

    def text(self, issue: dict) -> str:
        parts = [str(issue.get(field) or '') for field in TEXT_FIELDS]
        parts += issue.get('labels') or []
        parts += [comment.get('text') or '' for comment in issue.get('comments') or []]
        return '\n'.join(parts)


def held_by_a_session(issue: dict) -> bool:
    """'held' in every view: a session holds the item. An item assigned to the user waits on the person (r22-q171)."""
    return bool(issue.get('assignee')) and issue['assignee'] != USER_HOLD


def line(issue: dict, *extra: str) -> str:
    fields = [issue['id'], issue['status'], issue.get('issue_type', ''), *extra]
    return '  ' + '  '.join(field for field in fields if field) + f"  {issue.get('title', '')}"


def section(title: str, rows: list[str], limit: int | None = None) -> None:
    print(f'{title}: {len(rows)}')
    shown = rows[:limit] if limit else rows  # None or 0: every row
    for row in shown:
        print(row)
    if len(shown) < len(rows):
        print(f'  ... {len(rows) - len(shown)} more')


def by_priority(issue: dict):
    return (issue.get('priority', 9), issue.get('created_at') or '', issue['id'])


def work_unit(board: Board, issue: dict) -> list[str]:
    """What ranks together (r5-q20): a change request and its open items, which are claimed, reviewed and landed as one;
    any other item stands alone."""
    if issue.get('issue_type') != CR_TYPE:
        return [issue['id']]
    return [issue['id'], *(item['id'] for item in board.cr_items(issue['id']) if item.get('issue_type') != CR_TYPE)]  # not the requests stacked under it


def waiting_priority(board: Board, item: dict) -> tuple[int, str | None]:
    """(priority, waiting item) of the item alone: the highest priority among it and every open item waiting on it through
    blocking edges, transitively (r22-q179). The second field is the nearest such item that sets it, None when the item's
    own priority is the highest. A milestone confers none: its whole scope waits on each member."""
    best, via = item.get('priority', 9), None
    seen, pending = {item['id']}, [item['id']]
    while pending:
        for waiting in board.dependents.get(pending.pop(0), []):
            if waiting in seen or not board.is_open(waiting) or board.by_id[waiting].get('issue_type') == 'milestone':
                continue
            seen.add(waiting)
            if (priority := board.by_id[waiting].get('priority', 9)) < best:
                best, via = priority, waiting
            pending.append(waiting)
    return best, via


def effective_priority(board: Board, issue: dict) -> tuple[int, str | None, bool]:
    """(priority, item that sets it, whether that item is part of the request's own unit) the rank counts the item at: its
    `waiting_priority`; a change request counts with its work unit. A request under another counts alone: priority does not
    pass up through a parent request."""
    if issue['id'] not in board.effective:
        best, via = waiting_priority(board, issue)
        own = False
        for member in work_unit(board, issue)[1:]:
            priority, raised = waiting_priority(board, board.by_id[member])
            if priority < best:
                best, via, own = priority, raised or member, raised is None
        board.effective[issue['id']] = (best, via, own)
    return board.effective[issue['id']]


def milestones_of(board: Board, issue: dict) -> list[str]:
    """The open milestones the item is work of (`Board.in_milestone`); a change request also through its open items and
    through a change request it sits under (r5-q20)."""
    if issue.get('issue_type') != CR_TYPE:
        return board.in_milestone.get(issue['id'], [])
    reached = set(work_unit(board, issue))
    for ancestor in board.ancestors(issue['id']):
        if board.is_cr(ancestor):
            reached.update(work_unit(board, board.by_id[ancestor]))
    return sorted({m for item_id in reached for m in board.in_milestone.get(item_id, [])})


def work_rank(board: Board, issue: dict) -> tuple[bool, int]:
    """(milestone work, effective priority): the rank claims, `board queue` and the change-request lists share."""
    return bool(milestones_of(board, issue)), effective_priority(board, issue)[0]


def claim_order(board: Board, issue: dict):
    # Tiers (r22-q176, r23-q180): P0, then the planning of any released ruling, milestone work (board-coordination.md#milestones),
    # review, ratification and acceptance, the rest. Within a tier: effective priority, kind (CLAIM_RANK), then created.
    milestone, priority = work_rank(board, issue)
    kind = board.claimable(issue) or board.kind(issue)  # refresh work ranks as a refresh, not as its Accept
    tier = 0 if priority == 0 else 1 if kind == 'plan' else 2 if milestone else 3 if kind in FINISHING else 4
    return (tier, priority, CLAIM_RANK.get(kind, len(CLAIM_RANK)), issue.get('created_at') or '', issue['id'])


# Views

HEALTH_VIEWS = ('questions', 'decided', 'ratification', 'ratify', 'released', 'review', 'accept', 'user', 'ready', 'held', 'blocked',
                'outside', 'labels')
LIFECYCLE_LABELS = ('human', 'decided', 'review', 'needs-ratification', 'waiting')


def health_views(board: Board, root: str | None) -> dict[str, tuple[str, list[dict]]]:
    """view -> (heading, open items), the counts `board health` prints."""
    items = [issue for issue in board.listed(root) if issue['status'] != 'closed' and issue.get('issue_type') != 'epic']
    decisions = [issue for issue in items if issue.get('issue_type') == 'decision']

    def epic_of(issue):
        return next((a for a in board.ancestors(issue['id']) if board.by_id.get(a, {}).get('issue_type') == 'epic'), None)

    return {
        'questions': ('open questions', [i for i in decisions if i['status'] in ('open', 'in_progress')]),
        'decided': ('decided, not released', [i for i in decisions if i['status'] == 'decided']),
        'ratification': ('awaiting ratification', [i for i in items if i['status'] == 'needs_ratification' and i.get('issue_type') not in WORK_TYPES]),
        'ratify': ('ratifications of landed change requests and agent-passed designs (block nothing)',
                   [i for i in items if i['status'] == 'needs_ratification' and i.get('issue_type') in WORK_TYPES]),
        'released': ('released rulings to plan', [i for i in decisions if i['status'] == 'released']),
        'review': ('to review (change requests in agent review)', [i for i in items if board.kind(i) == 'review']),
        'accept': ('to accept (change requests waiting for the user)', [i for i in items if board.kind(i) == 'accept']),
        'user': ('waiting on the user (gates titled user, items assigned to user)',
                 [i for i in items if (i.get('issue_type') == 'gate' and i.get('title', '').startswith('user '))
                  or i.get('assignee') == 'user']),
        'ready': ('claimable now (unassigned, unblocked)', [i for i in items if board.claimable(i)]),
        'held': ('held (assigned to a session, not closed)', [i for i in items if held_by_a_session(i)]),
        'blocked': ('waiting on open blockers', [i for i in items if board.open_blockers(i['id'])]),
        # Outcome epics (r21-q153): only an item serving an outcome belongs in one; a stand-alone item carries a topic: label.
        'outside': ('outside any epic, no topic: label',
                    [i for i in items if epic_of(i) is None and i.get('issue_type') != 'gate'
                     and not any(label.startswith('topic:') for label in i.get('labels') or [])]),
        'labels': ('lifecycle labels (use statuses, assignment or blocks)',
                   [i for i in items if set(i.get('labels') or []) & set(LIFECYCLE_LABELS)]),
    }


def milestone_states(board: Board, root: str | None) -> list[dict]:
    scope = {issue['id'] for issue in board.listed(root)}
    states = []
    for milestone in (m for m in board.milestones() if m['id'] in scope):
        work = [board.by_id[item_id] for item_id in board.milestone_work(milestone['id'])]
        work = [issue for issue in work if issue.get('issue_type') != 'epic']
        states.append({'id': milestone['id'], 'title': milestone.get('title', ''), 'openWork': len(work),
                       'ready': sum(1 for i in work if board.claimable(i)), 'held': sum(1 for i in work if held_by_a_session(i)),
                       'blocked': sum(1 for i in work if board.open_blockers(i['id'])),
                       'milestoneReady': not board.open_blockers(milestone['id'])})
    return states


def item_json(board: Board, issue: dict, **extra) -> dict:
    """An item row of a --json view."""
    return {'id': issue['id'], 'type': issue.get('issue_type'), 'status': issue['status'], 'priority': issue.get('priority'),
            'holder': issue.get('assignee') or None, 'title': issue.get('title', ''), 'labels': issue.get('labels') or [],
            'blockedBy': board.unsettled_blockers(issue['id']) if issue['status'] == 'decided' else board.open_blockers(issue['id']),
            **extra}


# health views under the console's count names (contract-rulings R-B5); the others keep their view name.
JSON_COUNTS = {'released': 'toPlan', 'review': 'toReview', 'accept': 'toAccept', 'ratify': 'toRatify', 'user': 'forUser'}
# The views counted as steps (r21-q141, q146): ready = can be taken now, waiting = the rest of the step.
STEP_VIEWS = ('questions', 'decided', 'released', 'review', 'accept', 'ratify', 'user')


def step_blocked(board: Board, view: str, issue: dict) -> bool:
    """Whether an open blocker holds the item from its step (a decided record waits on unsettled ones only)."""
    if view == 'decided':
        return bool(board.unsettled_blockers(issue['id']))
    return bool(board.waits_of(issue))


def step_counts(board: Board, views: dict[str, tuple[str, list[dict]]]) -> dict[str, tuple[int, int, int]]:
    """view -> (ready, held, waiting) for the step views (r21-q141, q146): waiting = blocked, held or not; held = has a
    session holder and is not blocked; ready = the rest. An item assigned to the user is never held (r22-q171).
    The one definition health, the console and position print."""
    counts = {}
    for view in STEP_VIEWS:
        rows = views[view][1]
        waiting = sum(1 for issue in rows if step_blocked(board, view, issue))
        held = sum(1 for issue in rows if held_by_a_session(issue) and not step_blocked(board, view, issue))
        counts[view] = (len(rows) - held - waiting, held, waiting)
    return counts


def count_suffix(held: int, waiting: int) -> str:
    parts = ([f'{held} held'] if held else []) + ([f'{waiting} wait'] if waiting else [])
    return f" ({', '.join(parts)})" if parts else ''


def queue_summary(board: Board, root: str | None) -> dict | None:
    """What a queue-filtered list always adds, None without a filter: open items per other queue, unrouted items, and
    other people's items blocking the viewed queue's. Gates route nothing and don't count."""
    if board.view is None:
        return None
    items = [issue for issue in board.scoped(root) if issue['status'] != 'closed' and issue.get('issue_type') != 'gate']
    others: dict[str, int] = {}
    for issue in items:
        queue = board.queue(issue['id'])
        if queue and queue != board.view:
            others[queue] = others.get(queue, 0) + 1
    mine = [issue for issue in items if board.queue(issue['id']) == board.view]
    blocking = {blocker for issue in mine for blocker in board.open_blockers(issue['id'])
                if blocker in board.by_id and board.queue(blocker) != board.view and board.queue(blocker)}
    # Unrouted items wait on a lead: for you first (your inbox), then the longest waiting.
    unrouted = sorted((issue for issue in items if board.queue(issue['id']) is None),
                      key=lambda issue: (board.view not in filed_for(issue), waiting_since(issue), issue['id']))
    return {'others': others, 'unrouted': unrouted,
            'inbox': [issue for issue in unrouted if board.view in filed_for(issue)],
            'toSend': [issue for issue in mine if filed_for(issue) and issue.get('assignee') == USER_HOLD],
            'blocking': sorted((board.by_id[item_id] for item_id in blocking), key=by_priority)}


def filed_for(issue: dict) -> list[str]:
    """The people an item is filed for (`for:` labels)."""
    return [label[len(FOR_PREFIX):] for label in issue.get('labels') or [] if label.startswith(FOR_PREFIX)]


def sent_at(issue: dict) -> str | None:
    """When `board send` last put an item in an inbox (its metadata stamp), None for an item never sent."""
    metadata = issue.get('metadata') if isinstance(issue.get('metadata'), dict) else {}
    value = metadata.get(SENT_AT)
    return value if filed_for(issue) and isinstance(value, str) and parse_time(value) else None


def waiting_since(issue: dict) -> str:
    """An unrouted item waits since it was sent, if it was; otherwise since it was created."""
    return sent_at(issue) or issue.get('created_at') or ''


def unrouted_row(board: Board, issue: dict) -> str:
    names = board.queues(issue['id'])
    sent = sent_at(issue)
    return line(issue, f"queues {','.join(names)}" if names else '', *(FOR_PREFIX + who for who in filed_for(issue)),
                f"sent {age(parse_time(sent))} ago" if sent else f"{age(parse_time(issue.get('created_at')))} old")


def queue_rows(board: Board, root: str | None, command: str) -> None:
    summary = queue_summary(board, root)
    if summary is None:
        return
    if summary['others']:
        counts = ', '.join(f'{queue} {count}' for queue, count in sorted(summary['others'].items()))
        print(f'other queues: {counts} (board {command} --queue <person>, or --queue all)')
    if summary['unrouted']:
        section('unrouted', [unrouted_row(board, issue) for issue in summary['unrouted']])
    if summary['blocking']:
        section("blocking yours, in other people's queues", [line(issue, f"queue {board.queue(issue['id'])}") for issue in summary['blocking']])


def queue_line(board: Board, root: str | None) -> str | None:
    """The queue rows in one line, for the console pane."""
    summary = queue_summary(board, root)
    if summary is None:
        return None
    parts = ([f"other queues: {', '.join(f'{queue} {count}' for queue, count in sorted(summary['others'].items()))}"] if summary['others'] else []) \
        + ([f"unrouted: {', '.join(issue['id'] for issue in summary['unrouted'])}"
            + (f" ({len(summary['inbox'])} for you)" if summary['inbox'] else '')] if summary['unrouted'] else []) \
        + ([f"blocking yours: {', '.join(issue['id'] for issue in summary['blocking'])}"] if summary['blocking'] else [])
    return ' · '.join(parts) or None


def queues_json(board: Board, root: str | None) -> dict:
    """The queue fields of a --json view; none without a filter, so an unshared board's JSON stays as it was."""
    summary = queue_summary(board, root)
    if summary is None:
        return {}
    return {'queues': {'view': board.view, 'others': summary['others'],
                       'unrouted': [item_json(board, issue, queues=board.queues(issue['id']), waitingSince=waiting_since(issue) or None)
                                    for issue in summary['unrouted']],
                       'inbox': [item_json(board, issue, waitingSince=waiting_since(issue) or None) for issue in summary['inbox']],
                       'toSend': [item_json(board, issue) for issue in summary['toSend']],
                       'blocking': [item_json(board, issue, queue=board.queue(issue['id'])) for issue in summary['blocking']]}}


def health_counts(board: Board, views: dict) -> dict:
    """The `counts` of a --json health view, from its `health_views`."""
    steps = step_counts(board, views)
    return {JSON_COUNTS.get(view, view): ({'ready': steps[view][0], 'held': steps[view][1], 'waiting': steps[view][2]} if view in steps else len(rows))
            for view, (_, rows) in views.items()}


def health_json(board: Board, args) -> dict:
    views = health_views(board, args.root)
    ready = views['ready'][1]
    found = deviations(board, args.root)
    return {**queues_json(board, args.root), 'counts': health_counts(board, views),
            'claimable': {kind: sum(1 for i in ready if board.claimable(i) == kind) for kind in KINDS},
            'items': {JSON_COUNTS.get(view, view): [item_json(board, issue) for issue in sorted(views[view][1], key=by_priority)]
                      for view in HEALTH_VIEWS if view in args.items},
            'milestones': milestone_states(board, args.root),
            'deviations': {'count': len(found)}}


def health(board: Board, args) -> None:
    views = health_views(board, args.root)
    steps = step_counts(board, views)
    for view, (name, rows) in views.items():
        print(f'{name}: {len(rows)}' if view not in steps else f'{name}: {steps[view][0]}{count_suffix(steps[view][1], steps[view][2])}')
        if view == 'ready':
            counts = {kind: sum(1 for i in rows if board.claimable(i) == kind) for kind in KINDS}
            print('  by kind: ' + ', '.join(f'{pull} {count}' for pull, count in counts.items()))
        if view in args.items:
            listed = [line(issue, issue.get('assignee') or '') for issue in sorted(rows, key=by_priority)]
            for row in listed[:args.limit] if args.limit else listed:
                print(row)
            if args.limit and len(listed) > args.limit:
                print(f'  ... {len(listed) - args.limit} more')
    shown = {i['id'] for i in board.listed(args.root)}
    waiting = [i for i in accept_queue(board) if i['id'] in shown]
    if waiting:
        stale = [i for i in waiting if cr_info(board, i)['state'] != 'current']
        print(f'change requests waiting for you: {len(waiting)} ({len(stale)} not current; board queue lists them)')
    for state in milestone_states(board, args.root):
        print(f"milestone {state['id']} ({state['title']}): open work {state['openWork']}, "
              f"ready {state['ready']}, held {state['held']}, "
              f"blocked {state['blocked']}; milestone {'ready' if state['milestoneReady'] else 'not ready'}")
    found = deviations(board, args.root)
    if found:
        fixed = sum(1 for _, kind, _ in found if kind in COMMAND_FIXED)  # fixed by a board command, not a migration
        hints = (['run /board-migrate'] if fixed < len(found) else []) + ([f'{fixed} ruling waits wrongly: board check'] if fixed else [])
        print(f"convention deviations: {len(found)} — {'; '.join(hints)}")
    queue_rows(board, args.root, 'health')


def registry_by_actor(entries: list[dict]) -> dict[str, dict]:
    known: dict[str, dict] = {}
    for entry in sorted(entries, key=lambda e: e.get('registered_at') or ''):
        known[entry.get('actor') or ''] = entry
    return known


def holder_label(holder: str, known: dict[str, dict]) -> str:
    entry = known.get(session_actor(holder))
    if entry is None:
        return holder
    pulls = f" {'+'.join(entry.get('pulls') or [])}" if entry.get('pulls') else ''
    return f"{holder} ({entry.get('role')}{pulls}, {entry.get('tool') or 'tool unknown'})"


def session_activity(entry: dict) -> datetime | None:
    """The session's last tool call, its own or a running worker's; None without activity data (hooks not live)."""
    if not hooks_live(entry):
        return None
    moments = [parse_time(entry.get('active_at')), *(parse_time(m) for m in (entry.get('workers') or {}).values())]
    return max((m for m in moments if m is not None), default=None)


def session_state(entry: dict, now: datetime) -> str | None:
    """'gone' (its registered process ended), 'active' or 'idle' (last activity within IDLE_HOURS or not), None
    unknown (no activity data). The console's 'stopped' has no session-level board state: a stopped worker is
    marked on its item (board mine)."""
    if liveness(entry) == 'GONE':
        return 'gone'
    latest = session_activity(entry)
    if latest is None:
        return None
    return 'active' if (now - latest).total_seconds() <= IDLE_HOURS * 3600 else 'idle'


def position_data(board: Board, args) -> dict:
    """What `board position` shows: ready work per kind against the sessions handling it, sessions, held items with
    their marks, questions holding work, ready milestones and finished epics."""
    items = [issue for issue in board.listed(args.root) if issue['status'] != 'closed']
    # One bd call for the held items' comments and the epics with no open child (all their children may be closed).
    board.hydrate([*board.held_ids(), *(issue['id'] for issue in items if issue.get('issue_type') == 'epic'
                                        and not any(board.is_open(child) for child in board.children.get(issue['id'], [])))])
    known = board.registry()
    now = utcnow()
    ready = [issue for issue in items if board.claimable(issue)]
    held = sorted((issue for issue in items if held_by_a_session(issue) and issue.get('issue_type') != 'epic'),
                  key=lambda issue: (issue['assignee'], by_priority(issue)))
    holding = {session_actor(issue['assignee']) for issue in held}
    project = board_project()
    horizon = now - timedelta(hours=SESSION_HOURS)

    def recent(entry: dict) -> bool:
        moments = (parse_time(entry.get('registered_at')), session_activity(entry))
        return max((m for m in moments if m is not None), default=now) > horizon

    sessions = [entry for entry in known.values()
                if entry.get('actor') in holding
                or (project is not None and entry.get('project') == project and recent(entry))]
    kinds = {kind: {'ready': sum(1 for issue in ready if board.claimable(issue) == kind),
                    'held': sum(1 for issue in items if board.step_kind(issue) == kind and held_by_a_session(issue) and not board.waits_of(issue)),
                    'waiting': sum(1 for issue in items if board.kind(issue) == kind and board.waits_of(issue)),
                    'sessions': sum(1 for entry in sessions if kind in session_kinds(entry, ROLE_HANDLES))}
             for kind in KINDS}
    holds = []
    for issue in held:
        entry = known.get(session_actor(issue['assignee']))
        updated = board.last_activity(issue)
        recorded = holder_activity(entry, issue['assignee'])
        activity = recorded or updated
        gone = liveness(entry) == 'GONE' or (entry is None and session_actor(issue['assignee']) in board.ended())  # pruned: its process ended, or a pid-less one idle (r3-q17, r5-q25)
        idle = not gone and (activity is None or (now - activity).total_seconds() > IDLE_HOURS * 3600)
        # This machine can't know another machine's session: no idleness to claim, nothing to offer.
        elsewhere = shared is not None and entry is None and bool(ACTOR.fullmatch(issue['assignee']))
        holds.append((issue, entry, updated, recorded, 'gone' if gone else 'elsewhere' if elsewhere else 'idle' if idle else None))
    questions = sorted(((board.holds(issue['id']), issue) for issue in items
                        if issue.get('issue_type') == 'decision' and issue['status'] not in ('released', 'deferred')),
                       key=lambda pair: (-pair[0][0], -pair[0][1], by_priority(pair[1])))
    return {
        'kinds': kinds, 'known': known, 'now': now,
        'sessions': [(entry, sum(1 for issue in held if session_actor(issue['assignee']) == entry.get('actor')))
                     for entry in sessions],
        'held': holds,
        'questions': [(waiting, issue) for waiting, issue in questions if waiting[1]],
        'milestones': sorted((i for i in items if board.kind(i) == 'milestone' and not board.open_blockers(i['id'])),
                             key=by_priority),
        'finished': sorted((issue for issue in items if board.finished_epic(issue)), key=by_priority),
    }


def iso(moment: datetime | None) -> str | None:
    return moment.astimezone(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ') if moment else None


def session_json(board: Board, args, entry: dict, holds: int, now: datetime) -> dict:
    state = session_state(entry, now)
    kinds = session_kinds(entry)
    return {'session': entry.get('session'), 'role': entry.get('role'), 'actor': entry.get('actor'),
            'pulls': entry.get('pulls') or [], 'tool': entry.get('tool'),
            'handles': list(session_kinds(entry, ROLE_HANDLES)), 'registeredAt': entry.get('registered_at'), 'holds': holds,
            # Without live activity hooks no worker marker is trustworthy.
            'workers': {'active': len(active_workers(entry)), 'cap': worker_cap(entry)} if hooks_live(entry) else None,
            'process': {'alive': 'alive', 'GONE': 'gone'}.get(liveness(entry) or ''),
            'state': state, 'idleSince': iso(session_activity(entry)) if state == 'idle' else None,
            # what its bare `board claim` would take
            'claimable': sum(1 for issue in board.listed(args.root) if board.claimable(issue) in kinds)}


def position_json(board: Board, args) -> dict:
    data = position_data(board, args)
    return {
        **queues_json(board, args.root),
        'ready': data['kinds'],
        'sessions': [session_json(board, args, entry, count, data['now']) for entry, count in data['sessions']],
        'held': [item_json(board, issue, updatedAt=iso(updated), activeAt=iso(recorded), mark=mark,
                           stale=stale_since(board, issue) is not None, forced=forced_reason(issue))
                 for issue, _, updated, recorded, mark in data['held']],
        'questionsHoldingWork': [item_json(board, issue, holds=waiting[0], holdsAll=waiting[1]) for waiting, issue in data['questions']],
        'readyMilestones': [item_json(board, issue) for issue in data['milestones']],
        'finishedEpics': [item_json(board, issue) for issue in data['finished']],
    }


def position(board: Board, args) -> None:
    data = position_data(board, args)
    known = data['known']
    print('ready work by kind vs sessions handling it:')
    for kind, counts in data['kinds'].items():
        print(f"  {kind}: {counts['ready']} ready{count_suffix(counts['held'], counts['waiting'])}, {counts['sessions']} sessions")
    limit = args.limit
    section(f'sessions (holding items here, or of this project and registered or active within {SESSION_HOURS} h)',
            [f"  {entry.get('actor')}  {entry.get('role')}  {entry.get('tool') or 'tool unknown'}"
             f"  handles {','.join(session_kinds(entry, ROLE_HANDLES)) or '-'}  registered {age(parse_time(entry.get('registered_at')))} ago"
             f"  holds {count}"
             f"  workers {len(active_workers(entry))}/{worker_cap(entry)}"
             + {'alive': '  process alive', 'GONE': '  GONE'}.get(liveness(entry) or '', '')
             for entry, count in data['sessions']], limit)

    idle, gone = [], []
    rows = []
    for issue, _, updated, recorded, mark in data['held']:
        marker = {'gone': ' GONE', 'idle': ' IDLE', 'elsewhere': ' held elsewhere'}.get(mark or '', '')
        rows.append(line(issue, holder_label(issue['assignee'], known), *hold_marks(board, issue), f'updated {age(updated)} ago'
                         + (f', active {age(recorded)} ago' if recorded else '') + marker))
        if mark == 'idle':
            idle.append(issue['id'])
        elif mark == 'gone':
            gone.append(issue['id'])
    section('held items', rows, limit)
    if any(stale_since(board, issue) for issue, *_ in data['held']):
        print(STALE_OTHERS_LEGEND)
    if gone:
        print(f"  GONE = the holding session ended or its registration was pruned. Free {', '.join(gone)}: board take <id> | board unclaim <id> (the user or a deciding session)")
    if idle:
        print(f'  idle = no activity for {IDLE_HOURS} h. '
              'If that session is gone: board take <id> | board unclaim <id> (the user or a deciding session)')

    section('open questions holding work',
            [line(issue, f'holds {waiting[0]}/{waiting[1]}', issue.get('assignee') or 'unassigned') for waiting, issue in data['questions']],
            limit)
    if data['questions']:
        print(f'  {HOLDS_LEGEND}')
    section('ready milestones', [line(issue, issue.get('assignee') or 'unassigned') for issue in data['milestones']], limit)
    section('finished epics not closed', [line(issue) for issue in data['finished']], limit)
    queue_rows(board, args.root, 'position')


def session_kinds(entry: dict, table: dict = ROLE_KINDS) -> tuple[str, ...]:
    kinds = (*table.get(entry.get('role'), ()), *(entry.get('pulls') or ()))
    return tuple(dict.fromkeys((*kinds, *(['refresh'] if 'review' in kinds else []))))  # a review pull also takes the queue head's refresh


def holders(board: Board, args) -> None:
    rows = []
    for issue in board.listed(args.root):
        if issue['status'] != 'closed':
            count = board.holds(issue['id'])
            if count[1]:
                rows.append((count, issue))
    rows.sort(key=lambda pair: (-pair[0][0], -pair[0][1], by_priority(pair[1])))
    section('items holding open work (transitive blocks dependents)',
            [line(issue, f'holds {count[0]}/{count[1]}', issue.get('assignee') or 'unassigned') for count, issue in rows], args.limit)
    if rows:
        print(f'  {HOLDS_LEGEND}')
    queue_rows(board, args.root, 'holders')


# Conformance with skills/shared/board-core.md and board-coordination.md: mechanical classes only.
ACTOR = re.compile(r'[0-9a-f]{8}(/.+)?')
TITLE_PREFIXES = ('[Design]', '[Gate]', '[Checkpoint]', '[Review]')
ITEM_TYPES = ('task', 'bug', 'spike', 'design', 'decision', 'change-request', 'epic', 'milestone', 'gate')  # board-core.md Kinds: the one list
CHECK_CLASSES = {  # class -> board-core anchor
    'holder': 'actors-and-holds',
    'unknown-type': 'kinds',
    'title-prefix': 'kinds',
    'release-gate': 'kinds',
    'label-status': 'statuses-and-labels',
    'ruling-blocked': 'statuses-and-labels',
    'no-cr': 'change-requests',
    'cr-settings': 'change-requests',
    'cr-worktree': 'change-requests',
    'cr-branch': 'change-requests',
    'cr-landing': 'change-requests',
}
CHECK_DOCS = {'change-requests': 'change-requests.md'}  # anchors that live outside board-core.md


def doc_ref(anchor: str) -> str:
    return f"{CHECK_DOCS.get(anchor, 'board-core.md')}#{anchor}"


# Deviations a board command fixes, which /board-migrate does not.
COMMAND_FIXED = ('ruling-blocked',)
# Squashed text (words run together): a flag, never a deviation. Calibrated on
# the retro's samples (tools/ctx): clean board text 0 per 1,000 words, prompt
# text 8.8, squashed board text 210.
SQUASH_PER_1K = 50
SQUASH_MIN_HITS = 2
WORD_LIST = Path('/usr/share/dict/words')
EXTRA_WORDS = {'lint', 'typecheck', 'json', 'readonly', 'repo', 'config', 'dms', 'orm', 'api', 'ai', 'auth', 'pass',
               'fronts', 'checkpoint', 'workers', 'worker', 'diagnostics', 'integration', 'preexisting', 'canonical',
               'held', 'scoped', 'errors', 'queue', 'install', 'workaround', 'workarounds'}
SUFFIXES = ('s', 'es', 'ed', 'd', 'ing', 'ly', 'ized', 'ised', 'ation', 'ations', 'ies')


def deviations(board: Board, root: str | None) -> list[tuple[str, str, str]]:
    """(id, class, detail) for every convention deviation of a live (not closed) item in scope."""
    found = []
    for issue in board.scoped(root):
        item_id, kind, title = issue['id'], issue.get('issue_type'), issue.get('title', '')
        if issue['status'] == 'closed':
            continue  # closed items are immutable history
        holder = issue.get('assignee')
        if holder and holder != 'user' and not ACTOR.fullmatch(holder):
            found.append((item_id, 'holder', f'held by {holder}'))
        if kind and kind not in ITEM_TYPES:
            found.append((item_id, 'unknown-type', f'type {kind}'))
        prefix = next((p for p in TITLE_PREFIXES if title.startswith(p)), None)
        if prefix:
            found.append((item_id, 'title-prefix', f'title starts with {prefix}'))
        if kind == 'gate' and title.startswith('[Gate] Release'):
            found.append((item_id, 'release-gate', 'release gate title'))
        labels = sorted(set(issue.get('labels') or []) & set(LIFECYCLE_LABELS))
        if labels:
            found.append((item_id, 'label-status', f"labels {', '.join(labels)}"))
        foreign = board.foreign_waits(issue)
        if foreign:
            found.append((item_id, 'ruling-blocked', f"released ruling waits on {', '.join(foreign)}, work and not planning: "
                                                     f"{'; '.join(dep_fix(item_id, blocker) for blocker in foreign)}"))
        if is_work_hold(issue) and board.cr_of(item_id) is None and issue['status'] != 'in_review' and not is_no_code(issue):
            found.append((item_id, 'no-cr', f'work item outside any change request: board bd update {item_id} --parent <change request>'))
    return found + cr_deviations(board, root)


def dep_fix(item_id: str, blocker: str) -> str:
    return f'board bd dep remove {item_id} {blocker}'


# Passive forms first: "revised by <id>" means <id> revises this record.
REVISION_WORDS = re.compile(r'\b(?:(?P<passive>(?:revised|superseded|replaced)\s+by)|'
                            r'(?P<active>revis(?:es|ing|ion of)|supersed(?:es|ing)|replac(?:es|ing)))\b', re.IGNORECASE)
ITEM_ID = re.compile(r'[A-Za-z0-9][\w-]*(?:\.[\w-]+)*')
REJECTED = re.compile(r'^##\s+alternatives considered\b.*?(?=^##\s|\Z)', re.IGNORECASE | re.MULTILINE | re.DOTALL)
WINDOW = 60  # characters after the verb searched for the record it names


def unlinked_revision_rows(board: Board, root: str | None) -> list[dict]:
    """One row per live decision whose editable text says it revises, supersedes or replaces another decision (or is
    revised by one) without a supersedes or revise edge between them: {id, other, word, old, new}. Comments are
    history (moved packets quote old records); rejected alternatives describe what the record does not do."""
    flagged = []
    for issue in board.scoped(root):
        if issue['status'] == 'closed' or issue.get('issue_type') != 'decision':
            continue
        text = '\n'.join(REJECTED.sub('', str(issue.get(f) or '')) for f in ('title', 'description', 'design', 'notes'))
        named: dict[str, tuple[str, bool]] = {}  # other id -> (verb, other revises this one)
        covered = 0
        for match in REVISION_WORDS.finditer(text):
            if match.start() < covered:
                continue  # inside the previous verb's window ("revised by the superseding rulings: <id>")
            covered = match.end() + WINDOW
            for other in ITEM_ID.findall(text[match.end():covered]):
                if other != issue['id'] and board.by_id.get(other, {}).get('issue_type') == 'decision':
                    named.setdefault(other, (' '.join(match.group(0).lower().split()), bool(match.group('passive'))))
        for other, (word, passive) in named.items():
            if not any(kind in ('supersedes', REVISES) for _, _, kind in board.between(issue['id'], other)):
                old, new = (issue['id'], other) if passive else (other, issue['id'])
                flagged.append({'id': issue['id'], 'other': other, 'word': word, 'old': old, 'new': new})
    return flagged


def unlinked_revisions(board: Board, root: str | None) -> list[tuple[str, str]]:
    """(id, detail) per row of unlinked_revision_rows."""
    return [(row['id'], f"{row['word']} {row['other']} without a supersedes or revise link: board ruling supersede "
                        f"{row['old']} --with {row['new']} [--partial \"<rule>\"]")
            for row in unlinked_revision_rows(board, root)]


def unnamed_waits(board: Board, root: str | None) -> list[tuple[str, str]]:
    """(id, detail) per open blocker a live item's text does not name: a flag, never a deviation, because bd keeps
    no reason on the edge and legacy waits have none to recover."""
    flagged = []
    for issue in board.scoped(root):
        if issue['status'] == 'closed' or issue.get('issue_type') == 'milestone':
            continue  # a milestone's blockers are its members (board-coordination.md#milestones)
        text = board.text(issue)
        # A gate carries its own reason (bd gate create --reason); a closed blocker holds nothing up.
        flagged += [(issue['id'], f'waits on {b} without naming it') for b in board.blockers.get(issue['id'], [])
                    if b not in text and board.is_open(b) and board.by_id.get(b, {}).get('issue_type') != 'gate']
    return flagged


def word_list() -> set[str]:
    try:
        words = {w.strip().lower() for w in WORD_LIST.read_text(encoding='utf-8', errors='ignore').split() if len(w.strip()) >= 3}
    except OSError:
        words = set()
    return words | EXTRA_WORDS


class Squash:
    """Port of the retro's detect.py: letter-digit runs and long lowercase
    tokens that split into dictionary words. Without a word list only the
    letter-digit runs count."""

    def __init__(self, words: set[str]):
        self.words = words
        self.cache: dict[tuple[str, int], bool] = {}

    def split(self, text: str, depth: int = 0) -> bool:
        key = (text, depth)
        if key not in self.cache:
            if text in self.words and depth > 0:
                result = True
            elif depth >= 3:
                result = False
            else:
                result = any(text[:i] in self.words and self.split(text[i:], depth + 1) for i in range(3, len(text) - 2))
            self.cache[key] = result
        return self.cache[key]

    def squashed(self, token: str) -> bool:
        if re.fullmatch(r'[A-Za-z]+\d+[A-Za-z]{3,}|\d+[a-z]{4,}[A-Z]*|[a-z]{3,}\d+[a-z]*', token):
            return True
        if not self.words or not re.fullmatch(r'[A-Z]?[a-z]{10,}', token):
            return False
        lower = token.lower()
        if lower in self.words or any(lower.endswith(x) and lower[:-len(x)] in self.words for x in SUFFIXES) \
                or (lower.endswith('ies') and lower[:-3] + 'y' in self.words):
            return False
        return self.split(lower)

    def score(self, texts: list[str]) -> tuple[int, int, list[str]]:
        words, hits = 0, []
        for text in texts:
            for token in re.split(r'[\s,;:()\[\]"\'→=+]+', re.sub(r'`[^`]*`', '', text)):
                token = token.strip('.!?')
                if not token:
                    continue
                words += 1
                if not any(c in token for c in '/._-') and self.squashed(token):
                    hits.append(token)
        return words, len(hits), hits


def squash_flags(board: Board, root: str | None, words: set[str]) -> list[tuple[str, str]]:
    squash = Squash(words)
    flagged = []
    for issue in board.scoped(root):
        if issue['status'] == 'closed':
            continue
        # Editable fields only: comments are history.
        texts = [str(issue.get(f) or '') for f in ('title', 'description', 'design', 'acceptance_criteria', 'notes')]
        total, hits, examples = squash.score(texts)
        if hits >= SQUASH_MIN_HITS and 1000 * hits / max(total, 1) > SQUASH_PER_1K:
            flagged.append((issue['id'], f"{1000 * hits / total:.0f} squashed per 1,000 words, e.g. {', '.join(examples[:3])}"))
    return flagged


def hold_flags(board: Board, root: str | None) -> tuple[list[tuple[str, str]], list[tuple[str, str]]]:
    """(stale holds, forced holds) as (id, detail) among the held work items in scope."""
    held = [issue for issue in board.scoped(root) if issue['status'] != 'closed' and issue.get('assignee') and is_work_hold(issue)]
    stale = [(issue['id'], f"{issue['assignee']}: no update for {age(since)}") for issue in held if (since := stale_since(board, issue))]
    forced = [(issue['id'], f"{issue['assignee']}: {reason}") for issue in held if (reason := forced_reason(issue)) is not None]
    return stale, forced


def check_json(board: Board, args) -> dict:
    """Every finding of `board check`, unbudgeted: deviations by class, then the flags."""
    return {'deviations': [{'id': item_id, 'class': kind, 'detail': detail} for item_id, kind, detail in deviations(board, args.root)],
            'squashed': [{'id': item_id, 'detail': detail} for item_id, detail in squash_flags(board, args.root, word_list())],
            'unnamedBlockers': [{'id': item_id, 'detail': detail} for item_id, detail in unnamed_waits(board, args.root)],
            'unlinkedRevisions': unlinked_revision_rows(board, args.root),
            'staleHolds': [{'id': item_id, 'detail': detail} for item_id, detail in hold_flags(board, args.root)[0]],
            'forcedHolds': [{'id': item_id, 'detail': detail} for item_id, detail in hold_flags(board, args.root)[1]]}


def check(board: Board, args) -> int:
    limit = args.limit
    found = deviations(board, args.root)
    print(f'convention deviations: {len(found)}')
    for name, anchor in CHECK_CLASSES.items():
        rows = [f'  {item_id}  {name}  {doc_ref(anchor)}  {detail}'
                for item_id, kind, detail in found if kind == name]
        if rows:
            section(f'{name} ({doc_ref(anchor)})', rows, limit)
    words = word_list()
    flags = squash_flags(board, args.root, words)
    note = '' if len(words) > len(EXTRA_WORDS) else f'; no word list at {WORD_LIST}, letter-digit runs only'
    section(f'flag, not a deviation: squashed text on open items{note}',
            [f'  {item_id}  squashed  {detail}' for item_id, detail in flags], limit)
    section('flag, not a deviation: unnamed waits on open items (board-core.md#dependencies)',
            [f'  {item_id}  unnamed-blocker  {detail}' for item_id, detail in unnamed_waits(board, args.root)], limit)
    section('flag, not a deviation: revisions without a supersedes or revise link (board-coordination.md#rulings)',
            [f'  {item_id}  unlinked-revision  {detail}' for item_id, detail in unlinked_revisions(board, args.root)], limit)
    stale, forced = hold_flags(board, args.root)
    section(f'flag, not a deviation: stale holds, no update for {STALE_HOURS} h (board-core.md#hand-over-and-acceptance)',
            [f'  {item_id}  stale-hold  {detail}' for item_id, detail in stale], limit)
    section('flag, not a deviation: holds past the worker cap (board claim --force)',
            [f'  {item_id}  forced-hold  {detail}' for item_id, detail in forced], limit)
    return 1 if found else 0


STOPWORDS = set("""a about after all also an and any are as at be because been before being both but by can could do
does each either for from had has have how if in into is it its may might more most must no not of on once only or other
our out over own same should so such than that the their them then there these they this those through to under until up
use used uses using via was we were what when where whether which while who why will with without would you your""".split())
COMMON_SHARE = 0.2  # a --like word on more of the board's items than this says nothing about the draft
LIKE_TERMS = 15


def lowered(board: Board, issue: dict) -> str:
    cache = board.__dict__.setdefault('_lowered', {})
    if issue['id'] not in cache:
        cache[issue['id']] = board.text(issue).lower()
    return cache[issue['id']]


def related_data(board: Board, args) -> tuple[list[str], list[str], list[tuple[int, dict]], list[tuple[Path, int, str]]]:
    """(terms, words chosen from --like, [(matched terms, item)] rarest matches first, [(doc, line number, text)]).
    Ranks by inverse document frequency: a rare shared word says more than a template word every item carries."""
    scoped = board.scoped(args.root)
    texts = [(issue, lowered(board, issue)) for issue in scoped]
    total = max(len(texts), 1)
    frequency: dict[str, int] = {}

    def weight(term: str) -> float:
        if term not in frequency:
            frequency[term] = sum(1 for _, text in texts if term in text)
        return math.log((total + 1) / (frequency[term] + 1))

    terms = list(dict.fromkeys(term.lower() for term in args.terms))
    chosen = []
    if args.like is not None:
        words = dict.fromkeys(w for w in re.findall(r'[a-z][a-z0-9_.-]*[a-z0-9]', args.like.lower())
                              if len(w) >= 3 and w not in STOPWORDS and w not in terms)
        for word in words:
            weight(word)  # fills frequency
        # A word on no item matches nothing; one on many items is template text.
        candidates = [w for w in words if 0 < frequency[w] <= COMMON_SHARE * total]
        chosen = sorted(candidates, key=lambda w: (-weight(w), w))[:LIKE_TERMS]
        terms += chosen
    rows = []
    for issue, text in texts:
        hits = [term for term in terms if term in text]
        if hits:
            rows.append((sum(weight(term) for term in hits), len(hits), issue))
    rows.sort(key=lambda row: (-row[0], -row[1], by_priority(row[2])))
    matches = []
    for root in (part for value in args.docs for part in value.split(',') if part.strip()):
        path = Path(root.strip())
        files = sorted(path.rglob('*.md')) if path.is_dir() else [path]
        for file in files:
            try:
                lines = file.read_text(encoding='utf-8').splitlines()
            except (OSError, UnicodeDecodeError) as error:
                raise BoardError(f'cannot read {file}: {error}') from None
            matches += [(file, number, text.strip()) for number, text in enumerate(lines, 1)
                        if any(term in text.lower() for term in terms)]
    return terms, chosen, [(count, issue) for _, count, issue in rows], matches


def foreign_queue(board: Board, issue: dict) -> str | None:
    """The queue to name on an item from someone else's: never on an unshared board."""
    if shared is None:
        return None
    queue = board.queue(issue['id'])
    return queue if queue and queue != person() else None


def related_json(board: Board, args) -> dict:
    terms, chosen, rows, docs = related_data(board, args)
    shown = (lambda rows: rows[:args.limit]) if args.limit else (lambda rows: rows)
    return {'terms': terms, 'like': chosen,
            'items': [{'id': issue['id'], 'status': issue['status'], 'type': issue.get('issue_type'),
                       'priority': issue.get('priority'), 'holder': issue.get('assignee') or None,
                       'title': issue.get('title', ''), 'matched': count, 'of': len(terms),
                       **({'queue': foreign_queue(board, issue)} if foreign_queue(board, issue) else {})} for count, issue in shown(rows)],
            'docs': [{'path': str(file), 'line': number, 'text': text} for file, number, text in shown(docs)]}


def related(board: Board, args) -> None:
    terms, chosen, rows, docs = related_data(board, args)
    like = f"; from --like: {', '.join(chosen) or 'no distinctive words'}" if args.like is not None else ''
    section(f"items matching {', '.join(terms)}, rarest matches first (all text fields, closed included{like})",
            [line(issue, f'{count}/{len(terms)} terms', issue.get('assignee') or 'unassigned',
                  f'queue {foreign_queue(board, issue)}' if foreign_queue(board, issue) else '') for count, issue in rows],
            args.limit)
    if args.docs:
        section('doc lines', [f'  {file}:{number}: {text}' for file, number, text in docs], args.limit)


def queue(board: Board, args) -> None:
    ready = sorted((issue for issue in board.listed(args.root) if board.claimable(issue)),
                   key=lambda issue: claim_order(board, issue))

    def marker(issue: dict) -> str:
        milestones = milestones_of(board, issue)
        return f"m:{','.join(milestones)}" if milestones else ''

    for kind in KINDS:
        section(kind, [line(issue, f"p{issue.get('priority', '?')}", marker(issue))
                       for issue in ready if board.claimable(issue) == kind], args.limit)
    shown = {i['id'] for i in board.listed(args.root)}
    accepting = accept_queue(board)
    live = [i for i in accepting + [i for i in live_crs(board) if i not in accepting]
            if i['id'] in shown and i['status'] != 'open']  # open ones are in their pull's section above
    section('change requests (stage, check state, stack base)',
            [line(i, cr_stage(i) or '', f"check {check_label(i, cr_info(board, i)['state'])}", f"base {meta(i).get('base') or '-'}",
                  *([f"land blocked: {', '.join(cr_info(board, i)['blocked'])}"] if cr_info(board, i)['blocked'] else []),
                  *([f"after {after_base(board, i)}"] if after_base(board, i) else []), i.get('assignee') or '') for i in live], args.limit)
    queue_rows(board, args.root, 'queue')


# board show: items rendered from the snapshot, unwrapped, within READ_BUDGET (`--full` lifts it).

LINK_KINDS = {  # (type, outgoing) -> label from the shown item's side; order is print order
    ('blocks', True): 'blocked by', ('blocks', False): 'blocks', ('parent-child', True): 'parent',
    ('parent-child', False): 'children', ('relates-to', True): 'relates to', ('relates-to', False): 'relates to',
    ('related', True): 'relates to', ('related', False): 'relates to', ('supersedes', False): 'supersedes',
    ('supersedes', True): 'superseded by', ('discovered-from', True): 'discovered from',
    ('discovered-from', False): 'discovered here',
}
LINK_ORDER = ('blocked by', 'blocks', 'parent', 'children', 'relates to', 'supersedes', 'superseded by',
              'discovered from', 'discovered here', 'revises', 'revision pending')
HEADING = re.compile(r'^(#{2,3})\s+(.+?)\s*#*\s*$')


def normalized(name: str) -> str:
    return ' '.join(name.replace('_', ' ').lower().split())


def comment_list(issue: dict) -> list[dict]:
    return [{'author': c.get('author'), 'created_at': c.get('created_at'), 'text': c.get('text') or ''}
            for c in sorted(issue.get('comments') or [], key=lambda c: c.get('created_at') or '')]


def link_lines(board: Board, issue: dict) -> list[str]:
    grouped: dict[str, list[str]] = {}
    for other, kind, outgoing in board.edges.get(issue['id'], []):
        if kind == REVISES and issue.get('issue_type') == 'decision' and outgoing:
            label = 'revises'
        elif kind == REVISES and not outgoing and board.by_id.get(other, {}).get('issue_type') == 'decision':
            label = 'revision pending'
        else:
            label = LINK_KINDS.get((kind, outgoing), kind if outgoing else f'{kind} (from)')
        target = board.by_id.get(other, {})
        new = issue if label == 'revises' else target if label == 'revision pending' else {}
        rule = (new.get('metadata') or {}).get(REVISES_RULE) if isinstance(new.get('metadata'), dict) else None
        grouped.setdefault(label, []).append(f"  {label}: {other}  {target.get('status', 'not on board')}  "
                                             f"{target.get('title', '')}" + (f'  (partial: {rule})' if rule else ''))
    order = [*LINK_ORDER, *sorted(set(grouped) - set(LINK_ORDER))]
    return [row for label in order for row in sorted(set(grouped.get(label, [])))]  # relates-to may be stored twice


def field_units(issue: dict, field: str) -> list[tuple[str, str]]:
    """(section name, text) chunks of one field: its preamble under the field name, then one per heading."""
    text = str(issue.get(field) or '').strip('\n')
    if not text.strip():
        return []
    units, name, chunk = [], field, [f'{field}:']
    for row in text.splitlines():
        heading = HEADING.match(row)
        if heading:
            if name == field and len(chunk) == 1:  # no preamble: the field label leads its first heading
                name = heading.group(2)
                chunk.append(row)
                continue
            units.append((name, '\n'.join(chunk)))
            name, chunk = heading.group(2), [row]
        else:
            chunk.append(row)
    units.append((name, '\n'.join(chunk)))
    return units


def section_text(issue: dict, field: str, title: str) -> str:
    """A heading's text through the next heading of the same or a higher level."""
    rows, level, out = str(issue.get(field) or '').splitlines(), None, []
    for row in rows:
        heading = HEADING.match(row)
        if level is not None and heading and len(heading.group(1)) <= level:
            break
        if level is None and heading and heading.group(2) == title:
            level = len(heading.group(1))
        if level is not None:
            out.append(row)
    return '\n'.join(out)


def show_sections(board: Board, issue: dict, query: str) -> list[tuple[str, str]]:
    candidates = [(field, f'{field}:\n' + str(issue.get(field)).strip('\n')) for field in SHOW_FIELDS
                  if str(issue.get(field) or '').strip()]
    links = link_lines(board, issue)
    if links:
        candidates.append(('links', 'links:\n' + '\n'.join(links)))
    for field in SHOW_FIELDS:
        candidates += [(name, section_text(issue, field, name)) for name, _ in field_units(issue, field)[1:]
                       if name != field]
    wanted = normalized(query)
    matches = [c for c in candidates if normalized(c[0]) == wanted] \
        or [c for c in candidates if normalized(c[0]).startswith(wanted)]
    names = sorted({name for name, _ in matches})
    if not matches:
        raise BoardError(f"{issue['id']}: no section {query!r}; sections: " + ', '.join(dict.fromkeys(n for n, _ in candidates)))
    if len(names) > 1:
        raise BoardError(f"{issue['id']}: section {query!r} is ambiguous:\n" + '\n'.join(
            f'  board show {issue["id"]} --section {shlex.quote(name)}' for name in names))
    return matches


class Budget:
    """Prints units whole while the budget lasts; a unit that doesn't fit prints its first PREVIEW characters and
    the command that prints the rest. Past the budget, one line per item names the remaining sections."""

    def __init__(self, limit: int | None):
        self.remaining, self.skipped = limit, {}

    def out(self, text: str) -> None:
        """Always printed (headers, counts, footers); still spends the budget."""
        print(text)
        if self.remaining is not None:
            self.remaining -= len(text) + 1

    def emit(self, text: str, rest: str, name: str | None = None, item: str | None = None) -> None:
        if self.remaining is None or len(text) + 1 <= self.remaining - 300:  # 300: room for the closing lines
            self.out(text)
        elif self.remaining >= PREVIEW + 500:
            cut = text[:PREVIEW]
            self.out(f'{cut}\n… {len(text) - len(cut)} more chars: {rest}')
        else:
            self.skipped.setdefault(item, []).append((name, rest))

    def flush(self, item: str) -> None:
        skipped = self.skipped.pop(item, [])
        if skipped:
            names = ', '.join(f'"{name}"' for name, _ in skipped[:20]) + (', …' if len(skipped) > 20 else '')
            self.out(f'… {len(skipped)} more sections of {item} ({names}): {skipped[0][1]}')


def show(board: Board, args) -> int:
    missing = [item_id for item_id in args.ids if item_id not in board.by_id]
    if missing:
        raise BoardError(f"unknown {', '.join(missing)}")
    issues = [board.by_id[item_id] for item_id in args.ids]
    known = {key for issue in board.issues for key in issue} | ITEM_FIELDS
    unknown = [field for field in args.fields if field not in known]
    if unknown:
        raise BoardError(f"unknown field {', '.join(unknown)}; fields: {', '.join(sorted(known - {'_type'}))}")
    if args.json:
        if not args.fields:
            raise BoardError('--json needs --field <field> (repeatable)')
        print(json.dumps({issue['id']: {field: comment_list(issue) if field == 'comments' else issue.get(field)
                                        for field in args.fields} for issue in issues}, indent=2, ensure_ascii=False))
        return 0
    budget = Budget(None if args.full else READ_BUDGET)
    full = ' --full'
    for issue in issues:
        item_id = issue['id']
        q = shlex.quote
        header = [item_id, issue['status'], issue.get('issue_type', ''), f"p{issue.get('priority', '?')}",
                  issue.get('assignee') or 'unassigned']
        if item_id in board.parent:
            header.append(f'parent {board.parent[item_id]}')
        if issue.get('labels'):
            header.append('labels ' + ','.join(issue['labels']))
        if shared is not None:
            header.append(f"queue {board.queue(item_id) or 'unrouted'}")
        harm = (issue.get('metadata') or {}).get(DEEP_REVIEW) if isinstance(issue.get('metadata'), dict) else None
        budget.out('  '.join(header) + '\n' + issue.get('title', '') + (f'\ndeep-review: {harm}' if harm else ''))
        selected = bool(args.sections or args.fields or args.comments)
        for query in args.sections:
            for name, text in show_sections(board, issue, query):
                budget.emit(text, f'board show {item_id} --section {q(name)}{full}', name, item_id)
        for field in args.fields:
            value = comment_list(issue) if field == 'comments' else issue.get(field)
            text = f'{field}:\n' + (value.strip('\n') if isinstance(value, str) else json.dumps(value, ensure_ascii=False))
            budget.emit(text, f'board show {item_id} --field {q(field)}{full}', field, item_id)
        if not selected:
            links = link_lines(board, issue)
            if links:
                budget.emit('links:\n' + '\n'.join(links), f'board show {item_id} --section links', 'links', item_id)
            for field in SHOW_FIELDS:
                for name, text in field_units(issue, field):
                    budget.emit(text, f'board show {item_id} --section {q(name)}', name, item_id)
        comments = comment_list(issue)
        if args.comments or not selected:
            if args.comments and not args.sections and not args.fields:
                budget.out(f'comments only: board show {item_id} --full prints the whole item')
            shown = comments if args.comments else comments[-SHOWN_COMMENTS:]
            if comments:
                budget.out(f'comments: {len(comments)}' + (f', newest {len(shown)}' if len(shown) < len(comments) else ''))
            for note in reversed(shown):
                text = note['text'] or ''
                if not (args.comments or args.full) and len(text) > FIELD_LIMIT:
                    text = f'{text[:FIELD_LIMIT]}\n… cut at {FIELD_LIMIT} of {len(text)} characters: board show {item_id} --comments'
                budget.emit(f"--- {note['author']} {note['created_at']}\n{text}",
                            f'board show {item_id} --comments --full', f"comment {note['created_at']}", item_id)
            if len(shown) < len(comments):
                budget.out(f'… {len(comments) - len(shown)} older: board show {item_id} --comments')
        budget.flush(item_id)
    return 0


def budgeted(run, board: Board, args, argv: list[str]) -> int:
    """Runs a view within READ_BUDGET. Rows are the indented lines; --offset skips that many, keeping the heading of
    the section it lands in. A cut names the --offset that prints the next rows."""
    output = io.StringIO()
    with contextlib.redirect_stdout(output):
        code = run(board, args) or 0
    lines = output.getvalue().splitlines()
    kept, size, row, pending, cut, heading = [], 0, 0, [], None, None
    for text in lines:
        is_row = text.startswith('  ')
        if row < args.offset:
            if is_row:
                row += 1
                pending = [heading] if heading else []  # the section heading prints again before its next shown row
            else:
                heading = text
                pending.append(text)
            continue
        block = [*pending, text] if is_row else [text]
        cost = sum(len(item) + 1 for item in block)
        if size + cost > READ_BUDGET - 300:
            cut = row
            break
        kept += block
        size += cost
        pending = []
        row += is_row
    if pending and cut is None:
        kept += pending
    print('\n'.join(kept))
    if cut is not None:
        words, skip = [], False
        for word in argv:
            if skip:
                skip = False
            elif word == '--offset':
                skip = True
            elif not word.startswith('--offset='):
                words.append(word)
        total = sum(1 for text in lines if text.startswith('  '))
        print(f'… {total - cut} more rows: board {shlex.join([*words, "--offset", str(cut)])}')
    return code


# Writes

def caller() -> str:
    actor = derived_actor()
    if not actor:
        raise BoardError('no actor: run inside a Claude Code or Codex session, or set BEADS_ACTOR')
    return actor


HANDOVER = 'board handover: '


def authorship(board: Board, issue: dict) -> tuple[str | None, str | None]:
    """(author, legacy holder): who handed the item over, from its handover comment,
    else bd's status history; a hand-over by a pre-actor holder (goal-agent) is legacy."""
    legacy = None
    board.hydrate(i['id'] for i in board.issues if i['status'] == 'in_review')  # a status read carries no comments
    for note in sorted(issue.get('comments') or [], key=lambda c: c.get('created_at') or '', reverse=True):
        if (note.get('text') or '').startswith(HANDOVER):
            if ACTOR.fullmatch(note.get('author') or ''):
                return note['author'], None
            legacy = legacy or note.get('author')
    for event in json.loads(bd_checked('history', issue['id'], '--events', '--json') or '[]'):
        try:
            status = json.loads(event.get('new_value') or '{}').get('status')
        except (ValueError, AttributeError):
            continue
        if event.get('event_type') == 'status_changed' and status == 'in_review':
            if ACTOR.fullmatch(event.get('actor') or ''):
                return event['actor'], None
            legacy = legacy or event.get('actor')
    return None, legacy


def author_label(board: Board, issue: dict) -> str:
    actor, legacy = authorship(board, issue)
    return f'author {actor}' if actor else f'author unknown ({legacy})' if legacy else 'standalone'


NO_CODE = 'no_code'  # metadata of a work item that by design changes no code (a check, a baseline run): set when it is created, claimed outside any CR


def is_no_code(issue: dict) -> bool:
    return meta(issue).get(NO_CODE) == '1'


def is_work_hold(issue: dict) -> bool:
    return issue.get('issue_type') in WORK_HOLD_TYPES


def counted_holds(board: Board, actor: str) -> list[dict]:
    """The work items a worker cap counts for this actor: in progress, held by exactly this actor (a worker's holds
    are not its session's). Decisions and in-review items an acceptor or reviewer holds are not work in hand."""
    return [issue for issue in board.issues if issue['status'] == 'in_progress' and issue.get('assignee') == actor and is_work_hold(issue)]


def own_entry(board: Board, actor: str) -> dict | None:
    """The calling session's registration: None for an unregistered session (no cap, r3-q16). A registration that exists
    but cannot be read is no such session: claims and takeovers are refused until it registers again."""
    entry = board.registry().get(session_actor(actor))
    if entry is None and session_actor(actor) in board.unreadable():
        raise BoardError("this session's registration is unreadable. Register again: /role <role> (Codex: $role <role>)")
    return entry


def cap_refusal(board: Board, entry: dict | None, actor: str, claimed: list[dict]) -> str | None:
    """Why this actor may not claim one more work item, None when it may (an unregistered session has no cap)."""
    if entry is None:
        return None
    held = len(counted_holds(board, actor)) + sum(1 for issue in claimed if is_work_hold(issue)
                                                  and (issue['status'] == 'open' or (issue['status'] == 'in_progress' and issue.get('assignee') != actor)))  # claims and takeovers this call
    cap = worker_cap(entry)
    return f'{actor} holds {held} of {cap} work items (its worker cap)' if held >= cap else None


def forced_reason(issue: dict) -> str | None:
    """The reason the current holder held the item past its cap, None when the hold is within it."""
    metadata = issue.get('metadata') if isinstance(issue.get('metadata'), dict) else {}
    return str(metadata.get(FORCED_REASON) or '') if metadata.get(FORCED_BY) == issue.get('assignee') and issue.get('assignee') else None


def stale_since(board: Board, issue: dict) -> datetime | None:
    """The last update of a held work item without one for STALE_HOURS, else None (needs its comments hydrated)."""
    holder = issue.get('assignee')
    updated = board.last_activity(issue)
    if not holder or holder == USER_HOLD or not is_work_hold(issue) or updated is None:
        return None
    return updated if (utcnow() - updated).total_seconds() > STALE_HOURS * 3600 else None


def hold_marks(board: Board, issue: dict) -> list[str]:
    forced = forced_reason(issue)
    return [*(['STALE'] if stale_since(board, issue) else []), *([f'FORCED: {forced}'] if forced is not None else [])]


STALE_OTHERS_LEGEND = (f'  STALE = no update to the item for {STALE_HOURS} h: ask its holder what it waits on; the holder moves it on or renews it by '
                       'updating its notes. Only the holder, the user or a deciding session frees it (board take | board unclaim)')
STALE_LEGEND = (f'  STALE = no update to the item for {STALE_HOURS} h: find out what it waits on, then move it on, board unclaim it, '
                'or renew it by updating its notes with what it waits on')


def held_by_session(board: Board, actor: str) -> list[dict]:
    session = session_actor(actor)
    return sorted((issue for issue in board.issues if issue['status'] != 'closed' and issue.get('assignee')
                   and (issue['assignee'] == session or issue['assignee'].startswith(session + '/'))),
                  key=by_priority)


def mine_data(board: Board, args) -> tuple[str, list[tuple[dict, bool]]]:
    """(caller actor, [(item held by its session, worker stopped)])."""
    actor = caller()
    board.hydrate(board.held_ids())
    scoped = {issue['id'] for issue in board.scoped(args.root)}
    try:
        entry = board.registry().get(session_actor(actor))
    except BoardError:
        entry = None  # no marks without the registry; the holds still list
    return actor, [(issue, worker_stopped(entry, issue)) for issue in held_by_session(board, actor) if issue['id'] in scoped]


def console_counts(board: Board, views: dict, position: dict) -> dict:
    """The health counts with the design and implement steps between plan and review, counted as `board position` counts them."""
    counts = health_counts(board, views)
    step = lambda kind: {name: position['ready'][kind][name] for name in ('ready', 'held', 'waiting')}
    ordered: dict = {}
    for name, value in counts.items():
        if name == 'toReview':
            ordered |= {'toDesign': step('design'), 'toImplement': step('implement')}
        ordered[name] = value
    return ordered


def console_json(board: Board, args) -> dict:
    """What the console pane draws, from one snapshot: health counts, the user's ready items, this session's holds, the
    sessions and every hold with its idle or gone mark. `crs` lists the requests waiting for the user and those in work;
    `queued` counts the rest."""
    position = position_json(board, args)
    views = health_views(board, args.root)  # counts and forYou only: health's deviations, claimable kinds and milestones are not read
    queue = accept_queue(board)
    listed, answering, queued = console_crs(board, queue)
    return {**({'sync': (shared.problem() or shared.store_warning()), 'queueLine': queue_line(board, args.root)} if shared else {}),
            'noBoard': False, 'prefix': board_prefix(),
            'counts': console_counts(board, views, position),
            'forYou': [item_json(board, issue) for issue in sorted(views['user'][1], key=by_priority)
                       if not step_blocked(board, 'user', issue) and not held_by_a_session(issue)],  # the ready part of forUser
            'items': [item for item in mine_json(board, args)['items'] if item['type'] != CR_TYPE],  # held CRs show in crs
            'crs': crs_json(board, listed, queue), 'waitingOnYou': answering, 'queued': queued, 'ratifications': ratifications_json(board),
            'sessions': position['sessions'],
            'held': [{'id': h['id'], 'holder': h['holder'], 'mark': h['mark']} for h in position['held']]}


def no_board_json() -> dict:
    """`board console` outside a board: the same shape, empty. Not an error; a bd failure on a board still is one."""
    return {'noBoard': True, 'counts': None, 'forYou': [], 'items': [], 'crs': [], 'waitingOnYou': 0, 'queued': 0, 'prefix': None, 'ratifications': [], 'sessions': [], 'held': []}


def has_board() -> bool:
    return beads_dir() is not None


def console(board: Board, args) -> None:
    print(json.dumps(console_json(board, args), indent=2, ensure_ascii=False))


def mine_json(board: Board, args) -> dict:
    actor, rows = mine_data(board, args)
    return {'session': session_actor(actor), 'actor': actor,
            'items': [item_json(board, issue, updatedAt=iso(board.last_activity(issue)), workerStopped=stopped)
                      for issue, stopped in rows]}


def mine(board: Board, args) -> None:
    actor, held_rows = mine_data(board, args)
    you = f' (you: {actor})' if actor != session_actor(actor) else ''
    rows, stopped = [], []
    for issue, mark in held_rows:
        rows.append(line(issue, issue['assignee'], *hold_marks(board, issue), f'updated {age(board.last_activity(issue))} ago'
                         + (' WORKER STOPPED' if mark else '')))
        if mark:
            stopped.append(issue['id'])
    section(f'held by session {session_actor(actor)}{you}', rows, args.limit)
    if any(stale_since(board, issue) for issue, _ in held_rows):
        print(STALE_LEGEND)
    if stopped:
        print(f"  WORKER STOPPED = the holding worker finished its last turn ({', '.join(stopped)}): "
              'continue the worker, hand the item over, or free it (board unclaim <id>)')


def capacity(board: Board, args) -> None:
    """The session's refill hint: printed for the session itself (no worker caller) in a dispatching role while
    fewer than its cap of workers were active and worker work (WORKER_KINDS, within the pulls of a role without a preset) is
    claimable. A session's own hand-overs count: another of its workers may review them. The snapshot predates a write, so the
    items the command named or claimed are left out (one read per command). Never fails the command it follows."""
    actor = derived_actor()
    if not actor or actor != session_actor(actor):
        return
    try:
        entry = board.registry().get(actor)
        pulls = entry.get('pulls') or () if entry else ()
        if entry is None or not (entry.get('role') in CAPACITY_ROLES or pulls):
            return
        active, cap = len(active_workers(entry)), worker_cap(entry)
        if active >= cap:
            return
        kinds = tuple(kind for kind in WORKER_KINDS if entry.get('role') in ('solo', 'autopilot') or kind in pulls)
        changed = {*(getattr(args, 'ids', None) or ()), getattr(args, 'id', None), *getattr(args, 'claimed', ())}
        counts = {kind: sum(1 for issue in board.listed(args.root)
                            if board.claimable(issue) == kind and issue['id'] not in changed) for kind in kinds}
    except BoardError:
        return
    ready = sorted(((kind, count) for kind, count in counts.items() if count), key=lambda pair: -pair[1])
    if ready:
        print(f"capacity: {active} of {cap} workers active in the last {WORKER_ACTIVE_MINUTES} min; "
              f"ready for your pulls: {', '.join(f'{kind} {count}' for kind, count in ready)} → refill (plan Dispatch)")


def claim_one(issue: dict, actor: str) -> tuple[bool, str]:
    """Atomically claim one item. Open items use bd's claim; in_review and
    released items keep their status through a compare-and-set on the assignee."""
    if issue['status'] == 'open':
        result = bd('update', issue['id'], '--claim', '--json')
    else:
        result = bd('update', issue['id'], '--assignee', actor, '--if-assignee', '', '--json')
    return result.returncode == 0, (result.stderr or result.stdout).strip()


def foreign_claim(board: Board, item_id: str) -> str | None:
    """Why this item can't be claimed from this queue, with the move that allows it: another person's queue, or none
    (unrouted, an inbox item included) until a lead routes it."""
    if shared is None:
        return None
    queue, mine = board.queue(item_id), person()
    if queue == mine and queue is not None:
        return None
    if queue is None:
        names = ','.join(board.queues(item_id))
        why = f'parents in queues {names}' if names else 'no queue'
        return f'{item_id}: unrouted ({why}); a lead or solo session routes it first: board route <person> {item_id}'
    return f"{item_id}: in {queue}'s queue; a lead or solo session moves it first: board route {mine or '<you>'} {item_id}"


def mark_forced(issue: dict, actor: str, reason: str | None) -> None:
    """Record a hold past the cap with its reason; a hold within it drops a mark the item's earlier holder left."""
    metadata = issue.get('metadata') if isinstance(issue.get('metadata'), dict) else {}
    if reason is not None:
        bd_checked('update', issue['id'], '--set-metadata', f'{FORCED_BY}={actor}', '--set-metadata', f'{FORCED_REASON}={reason}', '--json')
    elif FORCED_BY in metadata:
        bd_checked('update', issue['id'], '--unset-metadata', FORCED_BY, '--unset-metadata', FORCED_REASON, '--json')


def claim(board: Board, args) -> int:
    actor = caller()
    claimed, failed, forced = [], [], {}
    entry = own_entry(board, actor)
    if args.ids:
        for item_id in args.ids:
            issue = board.by_id.get(item_id)
            if issue is None or issue['status'] == 'closed':
                raise BoardError(f'{item_id}: unknown or closed')
        for item_id in args.ids:
            issue = board.by_id[item_id]
            holder = issue.get('assignee')
            if holder == actor:
                print(f'{item_id}: already held by {actor}')  # bin/protocol reads this line (claim_items)
                if board.is_cr(item_id) and issue['status'] == 'in_progress':  # a failed setup is rerun by claiming again (q222)
                    failure = ensure_setup(board, issue, cr_worktree(main_root(), item_id))
                    print(f'  setup failed:\n{failure}' if failure is not None else '  setup passed')
                continue
            if not board.is_cr(item_id) and holder and session_actor(holder) == session_actor(actor):
                # The session owns its workers' holds (design item 16): hand the item down. A work item counts against the cap.
                over = cap_refusal(board, entry, actor, claimed) if issue['status'] == 'in_progress' and is_work_hold(issue) else None
                if over and args.force is None:
                    failed.append(item_id)
                    print(f'{item_id}: not taken over: {over}; hand over or unclaim one, or board claim {item_id} --force "<reason>"', file=sys.stderr)
                    continue
                bd_checked('update', item_id, '--assignee', actor, '--force', '--json')
                comment(item_id, f'board claim: {actor} took this item over from {holder} in the same session.')
                claimed.append(issue)
                forced[item_id] = args.force if over else None
                continue
            refusal = foreign_claim(board, item_id) or work_item_refusal(board, issue, actor)
            if refusal:
                failed.append(item_id)
                print(refusal, file=sys.stderr)
                continue
            if holder and shared is not None and ACTOR.fullmatch(holder) and session_actor(holder) not in board.registry():
                failed.append(item_id)
                print(f'{item_id}: held elsewhere by {holder}, updated {age(board.last_activity(issue))} ago', file=sys.stderr)
                continue
            if holder:
                failed.append(item_id)
                print(f'{item_id}: held by {holder}; the user or a deciding session frees it with board take or board unclaim once its session is gone',
                      file=sys.stderr)
                continue
            if board.kind(issue) == 'milestone' and board.open_blockers(item_id):
                # Accepting a milestone needs its work done (board-coordination.md#milestones).
                failed.append(item_id)
                print(f"{item_id}: milestone not ready, waits on {', '.join(board.open_blockers(item_id))}", file=sys.stderr)
                continue
            if board.is_cr(item_id):
                kind = board.claimable(issue)
                if kind is None and issue['status'] == 'in_review' and after_base(board, issue) and may_move(board):
                    # a passed look-after child waiting for its parent: a deciding session takes it so it can return it
                    ok, message = claim_one(issue, actor)
                    if ok:
                        put_meta(issue, reviewing_tip=None)
                        claimed.append(issue)
                        issue['claim_kind'] = 'review'
                    else:
                        failed.append(item_id)
                        print(f'{item_id}: not claimed: {message}', file=sys.stderr)
                    continue
                if kind is None:
                    failed.append(item_id)
                    waits = board.cr_waits(issue)[0] if board.kind(issue) in ('plan', 'design', 'implement') else []
                    print(f"{item_id}: not claimable ({issue['status']})"
                          + (f", waits on {', '.join(waits)}" if waits else ''), file=sys.stderr)
                    continue
                if claim_cr_checked(board, issue, actor, kind, claimed, failed):
                    issue['claim_kind'] = kind
                continue
            over = cap_refusal(board, entry, actor, claimed) if is_work_hold(issue) else None
            if over and args.force is None:
                failed.append(item_id)
                print(f'{item_id}: not claimed: {over}; hand over or unclaim one, or board claim {item_id} --force "<reason>"', file=sys.stderr)
                continue
            ok, message = claim_one(issue, actor)
            if ok:
                claimed.append(issue)
                forced[item_id] = args.force if over else None
            else:
                failed.append(item_id)
                print(f'{item_id}: not claimed: {message}', file=sys.stderr)
    else:
        if entry is None:
            raise BoardError(f'no registered role for session {session_actor(actor)}; run /role first')
        if shared is not None and person() is None:
            raise BoardError(f'a bare claim takes from your queue: {PERSON_HELP}')
        kinds = session_kinds(entry)
        scoped = board.listed(args.root)
        candidates = sorted((issue for issue in scoped if board.claimable(issue) in kinds),
                            key=lambda issue: claim_order(board, issue))
        for issue in candidates:
            if issue['status'] == 'in_review' and board.claimable(issue) == 'review' and authorship(board, issue)[0] \
                    and session_actor(authorship(board, issue)[0]) == session_actor(actor):
                continue  # your own hand-over needs another reviewer
            if issue.get('issue_type') == CR_TYPE:
                kind = board.claimable(issue)
                if claim_cr_checked(board, issue, actor, kind, claimed, failed):
                    issue['claim_kind'] = kind
                    break
                continue
            ok, _ = claim_one(issue, actor)
            if ok:
                claimed.append(issue)
                break
        if not claimed:
            print(f"nothing claimable for {entry.get('role')} ({','.join(kinds)})")
    args.claimed = [issue['id'] for issue in claimed]
    for issue in claimed:
        kind = issue.get('claim_kind') or board.kind(issue) or issue.get('issue_type')
        by = f'; {author_label(board, issue)}' if issue['status'] == 'in_review' and kind == 'review' else ''
        inherited = effective_priority(board, issue)
        counts_as = f"; P{issue.get('priority', 9)}, counts as P{inherited[0]}: {'its item' if inherited[2] else 'blocks'} {inherited[1]}" if inherited[1] else ''
        print(f"claimed {issue['id']} ({kind}{by}{counts_as}): {issue.get('title', '')}")
        if kind == 'refresh':
            print(f"  refresh work: board cr refresh {issue['id']}, then board unclaim {issue['id']}")
        if kind == 'accept' and meta(issue).get('checkpoint') == 'user':
            pin, designs = design_pin(board, issue)
            print(f"  design hash {pin} ({', '.join(designs) or 'no design item'}); accept it with board cr land {issue['id']} --checkpoint --design {pin}")
        for blocker in board.foreign_waits(issue):  # a released ruling waits for planning only (r21-q139): the plan session removes it
            print(f"  fix: {issue['id']} waits on {blocker}, which is work and not planning; check what the ruling changes there, "
                  f"then {dep_fix(issue['id'], blocker)}")
        if issue['id'] in forced:
            mark_forced(issue, actor, forced[issue['id']])
    still = [issue for issue in held_by_session(board, actor) if issue not in claimed]
    if still:
        board.hydrate([issue['id'] for issue in still])  # staleness reads the comments
        section('this session still holds', [line(issue, issue['assignee'], *hold_marks(board, issue), f'updated {age(board.last_activity(issue))} ago')
                                                  for issue in still])
        if any(stale_since(board, issue) for issue in still):
            print(STALE_LEGEND)
    return 1 if failed or not (claimed or args.ids) else 0


def claim_cr_checked(board: Board, issue: dict, actor: str, kind: str, claimed: list, failed: list) -> bool:
    """claim_cr with its refusals printed: a git or setting failure leaves the CR unclaimed."""
    try:
        ok, message = claim_cr(board, issue, actor, kind)
    except BoardError as error:
        failed.append(issue['id'])
        print(f"{issue['id']}: not claimed: {error}", file=sys.stderr)
        return False
    if not ok:
        failed.append(issue['id'])
        print(f"{issue['id']}: not claimed: {message}", file=sys.stderr)
        return False
    claimed.append(issue)
    return True


def work_item_refusal(board: Board, issue: dict, actor: str) -> str | None:
    """A work item is claimed by a worker of the session holding its change request (q203); one outside any is refused."""
    if issue.get('issue_type') not in (*WORK_TYPES, 'design'):
        return None
    item_id = issue['id']
    cr_id = board.cr_of(item_id)
    if cr_id is None and (issue['status'] == 'in_review' or is_no_code(issue)):
        return None  # a standalone review, or work that changes no code (r10-q50)
    if cr_id is None:
        return f'{item_id}: outside any change request; put it in one: board bd update {item_id} --parent <change request>'
    cr = board.by_id[cr_id]
    if cr['status'] != 'in_progress' or not holds_cr(cr, actor):
        return f"{item_id}: in {cr_id} ({cr['status']}, held by {cr.get('assignee') or 'nobody'}); the session holding {cr_id} claims it for its workers"
    return None


def refuse_long_comment(text: str) -> None:
    refusal = comment_refusal(len(text))
    if refusal:
        raise BoardError(refusal)


def comment(item_id: str, text: str) -> None:
    bd_checked('comments', 'add', item_id, text)


def require_open(board: Board, ids: list[str]) -> list[dict]:
    missing = [item_id for item_id in ids if not board.is_open(item_id)]
    if missing:
        raise BoardError(f"unknown or closed: {', '.join(missing)}")
    return [board.by_id[item_id] for item_id in ids]


def take(board: Board, args) -> int:
    actor = caller()
    entry = own_entry(board, actor)
    taken, failed = [], False
    for issue in require_open(board, args.ids):
        refusal = foreign_claim(board, issue['id'])
        if refusal:
            raise BoardError(refusal)
        if board.is_cr(issue['id']) and issue['status'] == 'in_review' and authorship(board, issue)[0] \
                and session_actor(authorship(board, issue)[0]) == session_actor(actor):
            raise BoardError(f"{issue['id']}: your own hand-over needs another reviewer; the session that handed it over cannot take its review")
        previous = issue.get('assignee') or 'nobody'
        if previous == actor:
            print(f"{issue['id']}: already held by {actor}")
            continue
        # A work item held in progress counts against the worker cap however the hold arrives.
        over = cap_refusal(board, entry, actor, taken) if issue['status'] == 'in_progress' and is_work_hold(issue) else None
        if over and args.force is None:
            failed = True
            print(f"{issue['id']}: not taken: {over}; hand over or unclaim one, or board take {issue['id']} --force \"<reason>\"", file=sys.stderr)
            continue
        bd_checked('update', issue['id'], '--assignee', actor, '--force', '--json')
        comment(issue['id'], f'board take: {actor} took this item over from {previous}.')
        if board.is_cr(issue['id']) and issue['status'] == 'in_review':  # the new holder has seen nothing yet
            put_meta(issue, reviewing_tip=None)
        taken.append(issue)
        print(f"took {issue['id']} from {previous}")
        mark_forced(issue, actor, args.force if over else None)
    return 1 if failed else 0


def unclaim(board: Board, args) -> int:
    actor = caller()
    failed = False
    for issue in require_open(board, args.ids):
        holder = issue.get('assignee')
        if not holder:
            print(f"{issue['id']}: not held")
            continue
        reason = f"board unclaim: {actor} released {holder}'s hold."
        if issue['status'] == 'in_progress':
            # bd unclaim resets to open; it refuses other statuses. A change request keeps its worktree and branch.
            bd_checked('unclaim', issue['id'], '--reason', reason, *(['--force'] if holder != actor else []))
            if board.is_cr(issue['id']):
                try:
                    wt = cr_worktree(main_root(), issue['id'])
                    if wt.is_dir() and tree_problem(wt):
                        print(f"{issue['id']}: uncommitted work stays in {wt} for whoever claims it next", file=sys.stderr)
                except BoardError:
                    pass
        else:
            # in_review and released items keep their status for the next claimer.
            bd_checked('update', issue['id'], '--assignee', '', '--json')
            comment(issue['id'], reason)
        print(f"unclaimed {issue['id']} from {holder} ({issue['status']})")
    return 1 if failed else 0


def held(board: Board, item_id: str, actor: str, status: str | None = None) -> dict:
    issue = require_open(board, [item_id])[0]
    if issue.get('assignee') != actor or (status and issue['status'] != status):
        raise BoardError(f"{item_id}: {issue['status']}, held by {issue.get('assignee') or 'nobody'}; claim it first")
    return issue


def git(root: Path, *args: str, env: dict[str, str] | None = None, check: bool = True, input: str | None = None) -> subprocess.CompletedProcess:
    """git in the repository root, output as bytes; a failure raises with git's message unless `check` is off."""
    result = subprocess.run(['git', '-C', str(root), *args], capture_output=True, env={**os.environ, **(env or {})},
                            input=input.encode() if input is not None else None)
    if check and result.returncode != 0:
        raise BoardError(f"git {' '.join(args[:2])}: {result.stderr.decode('utf-8', 'replace').strip() or 'exit ' + str(result.returncode)}")
    return result


def git_text(root: Path, *args: str, env: dict[str, str] | None = None, input: str | None = None) -> str:
    return git(root, *args, env=env, input=input).stdout.decode('utf-8', 'surrogateescape')


# Change requests (r24, r25). The CR is the only unit claimed for work; its items are children claimed by the workers of the
# session holding it. Its place in the flow is its status (open, in_progress, in_review, needs_acceptance); the flow is in
# skills/shared/change-requests.md.
SETTINGS = {name: f'custom.board.{name}' for name in ('target', 'setup', 'checks', 'look', 'view')}  # bd's namespace for custom keys
LOOKS, VIEWS, CHECKPOINTS = ('before', 'after'), ('code', 'result'), ('agent', 'user')
# Worktrees live inside the main checkout, <main>/.worktrees/<cr id>, so every runtime's workspace sandbox covers them without
# a grant (q239 reversed 2026-11-11); the repository's local exclude file hides them from git status.
WORKTREES = '.worktrees'
OUTPUT_TAIL = 800  # characters of setup or check output kept in a refusal or the stored check


def meta(issue: dict) -> dict:
    found = issue.get('metadata')
    return found if isinstance(found, dict) else {}


def put_meta(issue: dict, **fields) -> None:
    """Sets (None: removes) metadata keys on the item and in the snapshot. Flat string keys: a whole-object write would
    replace what a concurrent writer set."""
    if not isinstance(issue.get('metadata'), dict):
        issue['metadata'] = {}
    flags = []
    for key, value in fields.items():
        if value is None:
            flags += ['--unset-metadata', key]
            issue['metadata'].pop(key, None)
        else:
            flags += ['--set-metadata', f'{key}={value}']
            issue['metadata'][key] = str(value)
    if flags:
        bd_checked('update', issue['id'], *flags, '--json')


def stamp() -> str:
    return utcnow().strftime('%Y-%m-%dT%H:%M:%SZ')


def tail(text: str) -> str:
    text = text.strip()
    return text if len(text) <= OUTPUT_TAIL else '…' + text[-OUTPUT_TAIL:]


def board_setting(board: Board, name: str) -> str:
    """A project setting (bd config board.<name>), failing closed when it is missing or invalid."""
    key = SETTINGS[name]
    if name not in board.settings:
        board.settings[name] = current_setting(key)
    value = board.settings[name].strip()
    allowed = {'look': LOOKS, 'view': VIEWS}.get(name)
    if not value:
        raise BoardError(f'{key} is not set: board setup --{name} <{"|".join(allowed) if allowed else "value"}>')
    if allowed and value not in allowed:
        raise BoardError(f"{key} is {value!r}, not one of {', '.join(allowed)}: board setup --{name} <value>")
    return value


def settings_problems(board: Board) -> list[str]:
    problems = []
    for name in SETTINGS:
        try:
            board_setting(board, name)
        except BoardError as error:
            problems.append(str(error))
    return problems


def cr_look(board: Board, cr: dict) -> str:
    value = meta(cr).get('look') or board_setting(board, 'look')
    if value not in LOOKS:
        raise BoardError(f"{cr['id']}: look {value!r} is not one of {', '.join(LOOKS)}")
    return value


def cr_branch(cr_id: str) -> str:
    return f'cr/{cr_id}'


def main_root() -> Path:
    """The main checkout: the first entry of `git worktree list`, wherever board runs (main, a worktree)."""
    result = subprocess.run(['git', 'worktree', 'list', '--porcelain'], capture_output=True, text=True)
    first = result.stdout.splitlines()[0] if result.returncode == 0 and result.stdout.strip() else ''
    if not first.startswith('worktree '):
        raise BoardError('not inside a git repository')
    return Path(first.removeprefix('worktree '))


def cr_worktree(main: Path, cr_id: str) -> Path:
    return main / WORKTREES / cr_id


def exclude_worktrees(main: Path) -> None:
    """Adds `/.worktrees/` to the repository's local exclude file (never a committed ignore line) before a worktree is added."""
    exclude, line = git_exclude(main), f'/{WORKTREES}/'
    text = exclude.read_text(encoding='utf-8') if exclude.is_file() else ''
    if line not in text.splitlines():
        exclude.parent.mkdir(parents=True, exist_ok=True)
        with exclude.open('a', encoding='utf-8') as out:  # append: keeps lines another writer added meanwhile
            out.write(('\n' if text and not text.endswith('\n') else '') + line + '\n')


class GitView(NamedTuple):
    """The repository facts a read-only view needs for every change request, read once: the main checkout, the local
    branch tips and the worktrees. A command that writes git state keeps the live reads."""
    main: Path
    heads: dict[str, str]
    worktrees: list[dict]


def read_git_view(board: Board) -> None:
    """Fills `board.git_view` (one `git worktree list`, one `git for-each-ref`); none outside a repository."""
    try:
        main = main_root()
        rows = git_text(main, 'for-each-ref', '--format=%(objectname) %(refname)', 'refs/heads').splitlines()
        board.git_view = GitView(main, {ref: sha for sha, _, ref in (row.partition(' ') for row in rows)}, worktrees_listing(main))
    except BoardError:
        return  # the live reads follow, and fail per change request as they always did


def view_main(board: Board) -> Path:
    return board.git_view.main if board.git_view else main_root()


def view_rev(board: Board, root: Path, ref: str) -> str | None:
    """`rev` of a local branch, from the view when the command read one."""
    if board.git_view and ref.startswith('refs/heads/') and root == board.git_view.main:
        return board.git_view.heads.get(ref)
    return rev(root, ref)


def rev(root: Path, ref: str) -> str | None:
    found = git(root, 'rev-parse', '--verify', '-q', f'{ref}^{{commit}}', check=False)
    return found.stdout.decode().strip() or None


def is_ancestor(root: Path, ancestor: str, descendant: str) -> bool:
    return git(root, 'merge-base', '--is-ancestor', ancestor, descendant, check=False).returncode == 0


def target_branch(board: Board, main: Path) -> str:
    name = board_setting(board, 'target')
    if name not in board._ref_format:  # a property of the name alone
        board._ref_format[name] = git(main, 'check-ref-format', '--branch', name, check=False).returncode == 0
    if not board._ref_format[name] or view_rev(board, main, f'refs/heads/{name}') is None:
        raise BoardError(f"{SETTINGS['target']} {name!r} is not a local branch: board setup --target <branch>")
    return name


def live_parent(board: Board, cr: dict) -> str | None:
    """The change request this one is stacked on while that one is unlanded, else None."""
    base = meta(cr).get('base')
    return base if base and base != cr['id'] and board.is_cr(base) and board.is_open(base) else None


def cr_base(board: Board, cr: dict, main: Path) -> tuple[str, str]:
    """(base as stored, its ref): a change request id while that one is live, else the target branch."""
    base = live_parent(board, cr)
    if base:
        return base, f'refs/heads/{cr_branch(base)}'
    name = target_branch(board, main)
    return name, f'refs/heads/{name}'


def tree_problem(wt: Path) -> str | None:
    """Why the worktree cannot be rebased or checked: a rebase or merge in progress, or uncommitted changes."""
    for name in ('rebase-merge', 'rebase-apply', 'MERGE_HEAD', 'CHERRY_PICK_HEAD'):
        found = Path(git_text(wt, 'rev-parse', '--path-format=absolute', '--git-path', name).strip())
        if found.exists():
            return f'a rebase or merge is in progress in {wt}: finish it (git rebase --continue) or abort it, then rerun'
    changes = [row for row in git_text(wt, 'status', '--porcelain', '--untracked-files=normal').splitlines() if row.strip()]
    if changes:
        shown = ', '.join(row[3:] for row in changes[:5]) + (f' and {len(changes) - 5} more' if len(changes) > 5 else '')
        return f'uncommitted changes in {wt} ({shown}): commit them (one commit per pass) first'
    return None


def run_shell_full(cwd: Path, command: str) -> tuple[int, str]:
    result = subprocess.run(['/bin/sh', '-c', command], cwd=cwd, capture_output=True, text=True)
    return result.returncode, result.stdout + result.stderr


def run_shell(cwd: Path, command: str) -> tuple[int, str]:
    code, out = run_shell_full(cwd, command)
    return code, tail(out)


def run_check(cwd: Path, command: str) -> tuple[int, str, str]:
    """The project check's exit status, its stdout (where the failure lines go, q241) and stdout plus stderr for display."""
    result = subprocess.run(['/bin/sh', '-c', command], cwd=cwd, capture_output=True, text=True)
    return result.returncode, result.stdout, result.stdout + result.stderr


def failure_counts(stdout: str) -> dict[tuple[str, str], int]:
    """One `file code` line per failure on the check's stdout (q241); its other lines and all of stderr are not failures."""
    found: dict[tuple[str, str], int] = {}
    for row in stdout.splitlines():
        parts = row.split()
        if len(parts) == 2:
            found[(parts[0], parts[1])] = found.get((parts[0], parts[1]), 0) + 1
    return found


def base_failures(board: Board, cr: dict, main: Path, base_tip: str) -> dict[tuple[str, str], int]:
    """The failures at the base commit, cached per project in the repository's common git dir, keyed by the base commit and the
    setup and check settings (q241); a green project has none. A lock makes concurrent hand-overs onto one base run it once: the
    second waits, then reads the first's result. Setup and checks run in a detached worktree of the base."""
    setup, checks = board_setting(board, 'setup'), board_setting(board, 'checks')
    folder = Path(git_text(main, 'rev-parse', '--path-format=absolute', '--git-common-dir').strip()) / 'board-base-checks'
    folder.mkdir(parents=True, exist_ok=True)
    key = hashlib.sha256('\0'.join((base_tip, setup, checks)).encode()).hexdigest()[:40]
    result = folder / key
    with (folder / f'{key}.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if result.is_file():
            try:
                return {(f, c): int(n) for f, c, n in (row.split() for row in result.read_text(encoding='utf-8').splitlines() if row.strip())}
            except ValueError:  # an unreadable result is a miss: recompute it
                result.unlink(missing_ok=True)
        path = main / WORKTREES / f'.base-{key[:12]}'
        exclude_worktrees(main)
        path.parent.mkdir(parents=True, exist_ok=True)
        # A run killed before its cleanup left this board-owned path. A symlink there is not ours: drop the link only, since
        # `worktree remove --force` would follow it. `add --force` takes over a registration whose folder is gone, so no
        # repo-wide prune touches other worktrees' records.
        if path.is_symlink():
            path.unlink()
        elif path.exists():
            git(main, 'worktree', 'remove', '--force', str(path), check=False)
            shutil.rmtree(path, ignore_errors=True)
        git(main, 'worktree', 'add', '--force', '--detach', str(path), base_tip)
        try:
            code, out = run_shell(path, setup)
            if code:
                raise BoardError(f'{cr["id"]}: setup failed at the base commit {base_tip[:12]}, so its failures are unknown:\n{out}')
            base_code, stdout, full = run_check(path, checks)
            if base_code not in (0, 1) or (base_code == 1 and not failure_counts(stdout)):
                raise BoardError(f'{cr["id"]}: the check is broken at the base commit {base_tip[:12]} (exit {base_code}), so its failures are unknown:\n{tail(full)}')
        finally:
            git(main, 'worktree', 'remove', '--force', str(path), check=False)
        found = failure_counts(stdout)
        scratch = folder / f'{key}.{os.getpid()}.tmp'
        scratch.write_text(''.join(f'{f} {c} {n}\n' for (f, c), n in sorted(found.items())), encoding='utf-8')
        os.replace(scratch, result)  # atomic: a reader never sees half a result
        return found


def check_verdict(board: Board, cr: dict, main: Path, wt: Path, base_tip: str) -> tuple[bool, str, dict | None]:
    """Runs the project check at the tip; passes when no (file, code) failure count rises from the base to the tip (q241)."""
    code, stdout, full = run_check(wt, board_setting(board, 'checks'))
    at_tip = failure_counts(stdout)
    # Exit status contract: 0 = ran, the `file code` lines on stdout are the failures; 1 = ran with failures, at least one such
    # line; anything else, or 1 with no line, is a broken check and fails closed.
    if code not in (0, 1) or (code == 1 and not at_tip):
        return False, f'check broken (exit {code}' + (', no failure line on stdout' if code == 1 else '') + f'):\n{tail(full)}', None
    if not at_tip:
        return True, '', None  # no comparison ran
    base = base_failures(board, cr, main, base_tip)
    rises = [(f, c) for (f, c), n in sorted(at_tip.items()) if n > base.get((f, c), 0)]
    text = '\n'.join(f'{f} {c}: {base.get((f, c), 0)} -> {at_tip[(f, c)]}' for f, c in rises)
    return not rises, ('new failures:\n' + text) if rises else '', \
        {'new': [f'{f} {c}' for f, c in rises], 'base': sum(base.values()), 'tip': sum(at_tip.values())}


def check_pair(cr: dict) -> dict | None:
    m = meta(cr)
    if not m.get('check_tip'):
        return None
    return {'tip': m.get('check_tip'), 'baseTip': m.get('check_base_tip'), 'result': m.get('check_result'),
            'at': m.get('check_at'), 'output': m.get('check_output') or '', 'kind': m.get('check_kind') or 'full',
            'command': m.get('check_command') or None, 'reason': m.get('check_reason') or None}


def check_label(cr: dict, state: str) -> str:
    """The check state as shown: a targeted or no-gate result says what it was, never a full pass (r15-q78)."""
    pair = check_pair(cr)
    if pair is None or pair['kind'] == 'full' or state in ('unchecked', 'failed'):
        return state
    detail = f"targeted: {pair['command']}" if pair['kind'] == 'targeted' else f"no check: {pair['reason']}"
    return f'{state} ({detail})'


def check_state(main: Path, cr: dict, tip: str | None, base_tip: str | None) -> str:
    """The stored check against the refs now (q209): current, stale (the branch or its base moved), conflict (the base moved
    and a dry-run merge conflicts), failed, unchecked."""
    pair = check_pair(cr)
    if pair is None or tip is None or base_tip is None:
        return 'unchecked'
    if pair['result'] == 'fail':
        return 'failed'
    if pair['tip'] == tip and pair['baseTip'] == base_tip:
        return 'current'
    if pair['baseTip'] != base_tip and git(main, 'merge-tree', '--write-tree', base_tip, tip, check=False).returncode == 1:
        return 'conflict'
    return 'stale'


def worktrees_listing(main: Path) -> list[dict]:
    entries, entry = [], {}
    for row in git_text(main, 'worktree', 'list', '--porcelain').splitlines() + ['']:
        if not row:
            if entry:
                entries.append(entry)
            entry = {}
            continue
        key, _, value = row.partition(' ')
        entry[key] = value
    return entries


def dirty_paths(wt: Path) -> set[str]:
    fields = git(wt, 'status', '--porcelain=v1', '-z', '--untracked-files=all', check=False).stdout.decode('utf-8', 'surrogateescape').split('\0')
    paths, at = set(), 0
    while at < len(fields) and len(fields[at]) > 3:
        paths.add(fields[at][3:])
        at += 2 if fields[at][0] in 'RC' else 1
    return paths


def checked_out_at(main: Path, ref: str, listing: list[dict] | None = None) -> tuple[Path | None, str | None]:
    """(the worktree with this branch checked out, why a landing must wait): a worktree that is rebasing or bisecting the
    branch has it detached, and moving the ref under it would be undone by its abort (F7)."""
    for entry in worktrees_listing(main) if listing is None else listing:
        path = Path(entry['worktree'])
        if 'prunable' in entry:  # its directory is gone: nothing there rebases or holds a branch
            continue
        if entry.get('branch') == ref:
            return path, None
        gitdir = Path(git_text(path, 'rev-parse', '--absolute-git-dir').strip())
        for name in ('rebase-merge', 'rebase-apply'):
            head = gitdir / name / 'head-name'
            if head.is_file() and head.read_text(encoding='utf-8').strip() == ref:
                return None, f'{path} is rebasing {ref.removeprefix("refs/heads/")}: finish or abort that first'
        start = gitdir / 'BISECT_START'
        if start.is_file() and start.read_text(encoding='utf-8').strip() == ref.removeprefix('refs/heads/'):
            return None, f'{path} is bisecting {ref.removeprefix("refs/heads/")}: finish that first'
    return None, None


def land_blocked(main: Path, name: str, tip: str, board: Board | None = None) -> list[str]:
    """Paths the landing changes that hold uncommitted edits in the worktree with the target checked out."""
    ref = f'refs/heads/{name}'
    view = board.git_view if board else None
    where, _ = checked_out_at(main, ref, view.worktrees if view else None)
    old = view_rev(board, main, ref) if board else rev(main, ref)
    if where is None or old is None:
        return []
    changed = set(git_text(main, 'diff', '--name-only', '--no-renames', old, tip).splitlines())
    return sorted(dirty_paths(where) & changed)


def cr_info(board: Board, cr: dict) -> dict:
    """Git facts of a change request, read once per command: branch, worktree, tips, check state, blocked landing."""
    if cr['id'] not in board._cr:
        info = {'main': None, 'branch': cr_branch(cr['id']), 'worktree': None, 'tip': None, 'baseTip': None, 'state': 'unchecked', 'blocked': []}
        try:
            main = view_main(board)
            info.update(main=main, worktree=str(cr_worktree(main, cr['id'])), tip=view_rev(board, main, f"refs/heads/{info['branch']}"))
            info['baseTip'] = view_rev(board, main, cr_base(board, cr, main)[1])
            info['state'] = check_state(main, cr, info['tip'], info['baseTip'])
            if cr['status'] == ACCEPT and info['tip'] and not live_parent(board, cr):
                info['blocked'] = land_blocked(main, target_branch(board, main), info['tip'], board)
        except BoardError:
            pass
        board._cr[cr['id']] = info
    return board._cr[cr['id']]


def live_crs(board: Board) -> list[dict]:
    return [i for i in board.issues if i.get('issue_type') == CR_TYPE and i['status'] != 'closed']


def stacked_order(board: Board, issues: list[dict], since) -> list[dict]:
    """Change requests in list order (r5-q21): a stack's base before the requests on it, then the claim order's tiers without
    kind (P0, milestone work, effective priority; `work_rank`), then `since(issue)`, then id."""
    ids = {i['id'] for i in issues}
    ordered: list[dict] = []
    seen: set[str] = set()

    def emit(issue: dict) -> None:
        if issue['id'] in seen:
            return
        seen.add(issue['id'])
        base = meta(issue).get('base')
        if base in ids:
            emit(board.by_id[base])
        ordered.append(issue)

    def key(issue: dict):
        milestone, priority = work_rank(board, issue)
        return (priority != 0, not milestone, priority, since(issue), issue['id'])

    for issue in sorted(issues, key=key):
        emit(issue)
    return ordered


def accept_queue(board: Board) -> list[dict]:
    """Change requests waiting for the user, in `stacked_order` by the time they began waiting. Kept per snapshot, since every
    unheld accept request's claimability asks for the head; the key notices the status and base writes a command makes."""
    live = live_crs(board)
    key = tuple((i['id'], i['status'], meta(i).get('since'), i.get('updated_at'), meta(i).get('base')) for i in live)
    if board._accept_queue is None or board._accept_queue[0] != key:
        board._accept_queue = (key, stacked_order(board, [i for i in live if i['status'] == ACCEPT],
                                                  lambda i: meta(i).get('since') or i.get('updated_at') or ''))
    return list(board._accept_queue[1])


def in_work_crs(board: Board) -> list[dict]:
    """Change requests being built or reviewed, in `stacked_order` by creation."""
    return stacked_order(board, [i for i in live_crs(board) if i['status'] in ('in_review', 'in_progress')], lambda i: i.get('created_at') or '')


def queue_head(board: Board, queue: list[dict] | None = None) -> dict | None:
    """The first queued CR that is not itself waiting: the only one that can be refresh work (q196, q201)."""
    return next((i for i in (accept_queue(board) if queue is None else queue) if not board.cr_waits(i)[0]), None)


def needs_refresh(board: Board, cr: dict) -> bool:
    info = cr_info(board, cr)
    return info['state'] != 'current' or not review_current(cr, info)


REVIEW_END_REF = 'refs/worktree/console-review-end'  # the review tree's marker: the tip the console set it to, or the commit `cr edits` made of its files (review.ts)


def review_tree_end(main: Path) -> str | None:
    """The console review tree's marker (`<main>-review`, review.ts `reviewTreeOf`): what the user has open there; None without one."""
    tree = Path(f'{main}-review')
    return rev(tree, REVIEW_END_REF) if tree.is_dir() else None


def held_by_review_tree(board: Board, cr: dict) -> bool:
    """The user has this CR, waiting for their Accept, open at its current tip in the review tree: no refresh moves it under them; it
    refreshes once a deciding session claims it."""
    if cr['status'] != ACCEPT:
        return False
    info = cr_info(board, cr)
    if info['main'] is None or info['tip'] is None:
        return False
    if '_review_end' not in board.__dict__:
        board._review_end = review_tree_end(info['main'])
    return board._review_end == info['tip']


def cr_claimable(board: Board, cr: dict, kind: str) -> str | None:
    if board.cr_waits(cr)[0]:
        return None  # includes a review whose base was returned (q206)
    if kind == 'accept':
        head = queue_head(board)
        if head and head['id'] == cr['id'] and needs_refresh(board, cr) and not held_by_review_tree(board, cr):
            return 'refresh'  # the head of the queue gets the refresh before its Accept
    return kind


def cr_closed_items(board: Board, cr_id: str) -> list[dict]:
    """The CR's items from bd, closed ones included (a status snapshot holds none)."""
    if cr_id not in board._cr_items:
        board._cr_items[cr_id] = json.loads(bd_checked('list', '--parent', cr_id, '--all', '--json', '--limit', '0') or '[]')
    return board._cr_items[cr_id]


def cr_stage(cr: dict) -> str | None:
    """The place of a change request as the views show it: review, checkpoint (agent), accept (waiting for the user)."""
    if cr['status'] == ACCEPT:
        return 'accept'
    if cr['status'] == 'in_review':
        return 'checkpoint' if meta(cr).get('checkpoint') == 'agent' else 'review'
    return None


def edit_entries(cr: dict) -> list[dict]:
    """The commits `board cr edits --commit` made from the user's review edits, recorded in the CR's metadata `review_edits` (JSON list
    of {commit}): the user's own edits, which keep the review (`edit_commits`)."""
    try:
        found = json.loads(meta(cr).get('review_edits') or '[]')
    except ValueError:
        return []
    return [one for one in found if isinstance(one, dict) and one.get('commit')] if isinstance(found, list) else []


def is_replay(root: Path, recorded: str, commit: str) -> bool:
    """`commit` is the recorded edit commit or a faithful replay of it: replaying the recorded change onto `commit`'s parent (a 3-way
    merge from the recorded parent) gives exactly `commit`'s tree. Exact in content and place, unlike a patch-id (r16 N5)."""
    if commit == recorded:
        return True
    parents = git_text(root, 'rev-list', '--parents', '-n', '1', commit).split() if rev(root, commit) else []
    if len(parents) != 2 or rev(root, recorded) is None:
        return False
    merged = git(root, 'merge-tree', '--write-tree', f'--merge-base={recorded}^', parents[1], recorded, check=False)
    return merged.returncode == 0 and merged.stdout.decode().split()[:1] == [git_text(root, 'rev-parse', f'{commit}^{{tree}}').strip()]


def edit_commits(root: Path, cr: dict, base: str, tip: str) -> list[bool]:
    """For each commit in base..tip, oldest first: whether it is one of the recorded edit commits (or its replay), each recorded
    commit matched at most once."""
    left = [one['commit'] for one in edit_entries(cr)]
    out = []
    for commit in git_text(root, 'rev-list', '--reverse', f'{base}..{tip}').split():
        match = next((one for one in left if is_replay(root, one, commit)), None)
        if match is not None:
            left.remove(match)
        out.append(match is not None)
    return out


def edits_only(main: Path | None, cr: dict, reviewed: str, tip: str) -> bool:
    """Every commit after the reviewed tip, up to `tip`, is one of the recorded edit commits or its replay after a rebase: the user's
    own edits need no agent review. A copied message, or the same change at another place, does not count."""
    if main is None or not is_ancestor(main, reviewed, tip):
        return False
    found = edit_commits(main, cr, reviewed, tip)
    return bool(found) and all(found)


def review_current(cr: dict, info: dict) -> bool:
    """The review verdict holds for the (tip, base tip) pair now (q236), also past the reviewed tip while every later commit is
    one of the user's recorded review edits (r15-q77); `info['main']` lets it read them."""
    m = meta(cr)
    reviewed = m.get('review_tip')
    if not reviewed or m.get('review_base_tip') != info['baseTip']:
        return False
    return reviewed == info['tip'] or edits_only(info.get('main'), cr, reviewed, info['tip'])


def after_base(board: Board, cr: dict) -> str | None:
    """The base a look-after CR (or one with no commits of its own) waits for in stage accept (A1): it lands when that base has."""
    base = live_parent(board, cr)
    info = cr_info(board, cr) if cr['status'] == 'in_review' else None
    if info and meta(cr).get('review_tip') and base and review_current(cr, info):
        try:  # a CR with nothing to merge waits for its base in either look (r10-q50)
            return base if cr_look(board, cr) == 'after' or (info['main'] and no_own_commits(info['main'], cr, info['tip'])) else None
        except BoardError:
            return None
    return None


UNBLOCKED_TYPES = (*WORK_TYPES, 'design', 'decision', CR_TYPE)  # what a request's count holds: work, not containers (milestone, epic, gate)


def cr_unblocks(board: Board, cr_id: str) -> tuple[int, int]:
    """(all, direct): open work waiting on the request or its work unit, directly or through other work's `blocks` edges.
    Milestones, epics and gates are neither counted nor passed through (so `Board.downstream` does not serve: it counts and
    crosses them); the request's own unit is its part."""
    own = set(work_unit(board, board.by_id[cr_id]))
    direct: set[str] = set()
    seen: set[str] = set()
    pending = list(own)
    while pending:
        item_id = pending.pop()
        for waiting in board.dependents.get(item_id, []):
            if waiting in own or waiting in seen or not board.is_open(waiting) \
                    or board.by_id[waiting].get('issue_type') not in UNBLOCKED_TYPES:
                continue
            seen.add(waiting)
            pending.append(waiting)
            if item_id in own:
                direct.add(waiting)
    return len(seen), len(direct)


def cr_milestone(board: Board, cr_id: str) -> str | None:
    """Title of the open milestone the request is work of (`milestones_of`); several: the lowest milestone id."""
    found = milestones_of(board, board.by_id[cr_id])
    return board.by_id[found[0]].get('title', '') if found else None


def cr_json(board: Board, cr: dict, children: dict[str, list[str]], refresh_id: str | None) -> dict:
    m, info = meta(cr), cr_info(board, cr)
    pair = check_pair(cr) or {}
    base = m.get('base')
    parent = live_parent(board, cr)
    unblocks, direct = cr_unblocks(board, cr['id'])
    priority, raised_by, by_item = effective_priority(board, cr)
    return {'id': cr['id'], 'title': cr.get('title', ''), 'status': cr['status'], 'stage': cr_stage(cr),
            'holder': cr.get('assignee') or None, 'look': m.get('look') or board.settings.get('look') or None,
            'view': m.get('view') or board.settings.get('view') or None, 'checkpoint': m.get('checkpoint') or None,
            'base': base or board.settings.get('target') or None, 'branch': info['branch'],
            'worktree': info['worktree'], 'tip': info['tip'], 'baseTip': info['baseTip'],
            'check': {'state': info['state'], 'tip': pair.get('tip'), 'baseTip': pair.get('baseTip'), 'at': pair.get('at'),
                      'result': pair.get('result'), 'kind': pair.get('kind', 'full'), 'command': pair.get('command'), 'reason': pair.get('reason'),
                      'newFailures': ([] if m.get('check_new') == '-' else m['check_new'].splitlines()) if m.get('check_new') else None,
                      'baseCount': int(m['check_base_count']) if m.get('check_base_count') is not None else None,
                      'tipCount': int(m['check_tip_count']) if m.get('check_tip_count') is not None else None},
            'parent': parent,
            'children': children.get(cr['id'], []), 'baseSha': m.get('base_sha') or None, 'landBlocked': info['blocked'] or None,
            'reviewState': ('current' if review_current(cr, info) else 'stale') if m.get('review_tip') else None,
            'refreshWork': cr['id'] == refresh_id,  # the console offers Refresh there alone (r27-q252)
            'heldByReviewTree': held_by_review_tree(board, cr),
            'after': after_base(board, cr),
            'setupFailed': cr['status'] == 'in_progress' and bool(m.get('base_sha')) and m.get('setup_sha') != m.get('base_sha'),
            'unblocks': unblocks, 'unblocksDirect': direct, 'milestone': cr_milestone(board, cr['id']),
            'priority': priority, 'ownPriority': cr.get('priority', 9),  # the rank counts it at `priority`; raisedBy names what sets it
            'raisedBy': {'id': raised_by, 'isItem': by_item} if raised_by else None}


ANSWER_WAIT = ('open', 'in_progress', 'decided')  # a question the user answers, in a round, or a ruling not yet released


def waits_on_answers(board: Board, cr: dict) -> bool:
    """The request or one of its open items waits on a question not yet released (r5-q26); a released ruling waits for planning."""
    unit = work_unit(board, cr)
    return any(board.by_id.get(b, {}).get('issue_type') == 'decision' and board.by_id[b]['status'] in ANSWER_WAIT
               for member in unit for b in board.blockers.get(member, []) if b not in unit)


def console_crs(board: Board, queue: list[dict]) -> tuple[list[dict], int, int]:
    """(the requests the console lists, those waiting on your answers, those queued): the accept queue, then those in work. The
    rest wait for an agent to pick them up and are only counted."""
    in_work = in_work_crs(board)
    rest = [i for i in live_crs(board) if i['status'] not in (ACCEPT, 'in_review', 'in_progress')]
    answering = sum(1 for i in rest if waits_on_answers(board, i))
    return [*queue, *in_work], answering, len(rest) - answering


def crs_json(board: Board, listed: list[dict], queue: list[dict]) -> list[dict]:
    for name in ('look', 'view', 'target'):  # the defaults a CR without its own value shows
        try:
            board_setting(board, name)
        except BoardError:
            pass
    children: dict[str, list[str]] = {}
    for issue in listed:
        base = live_parent(board, issue)
        if base:
            children.setdefault(base, []).append(issue['id'])
    head = queue_head(board, queue)
    refresh_id = head['id'] if head and needs_refresh(board, head) and not held_by_review_tree(board, head) else None
    return [cr_json(board, issue, children, refresh_id) for issue in listed]


def ratifications_json(board: Board) -> list[dict]:
    """The ratification rows: id, CR, title and the range the CR landed (`tip`: its `landing`, else the checked tip; `baseTip`: the
    base tip of its check), which the console's Open shows; null when the CR is gone or recorded none. One read for the CRs."""
    rows = [i for i in board.issues if i['status'] == 'needs_ratification' and i.get('issue_type') in WORK_TYPES]
    crs = {i['id']: i for i in bd_show(sorted({(board.parents.get(r['id']) or [''])[0] for r in rows} - {''}), comments=False)} if rows else {}
    out = []
    for i in rows:
        cr_id = (board.parents.get(i['id']) or [''])[0]
        m = meta(crs.get(cr_id) or {})
        tip, base = m.get('landing') or m.get('check_tip'), m.get('check_base_tip')
        out.append({'id': i['id'], 'cr': cr_id, 'title': i.get('title', ''), 'tip': tip if tip and base else None, 'baseTip': base if tip and base else None})
    return out


def cr_deviations(board: Board, root: str | None) -> list[tuple[str, str, str]]:
    """Change requests that cannot work as set: invalid settings, a live worktree or branch missing."""
    scope = {i['id'] for i in board.scoped(root)}
    found = [(cid, 'cr-landing', problem) for cid, problem in board.__dict__.get('settle_problems', {}).items() if cid in scope]
    live = [i for i in live_crs(board) if i['id'] in scope]
    if live:
        found += [(live[0]['id'], 'cr-settings', problem) for problem in settings_problems(board)]
    for cr in live:
        if cr['status'] not in ('in_progress', 'in_review', ACCEPT):
            continue
        info = cr_info(board, cr)
        if info['main'] is None:
            continue
        if info['tip'] is None:
            found.append((cr['id'], 'cr-branch', f"{cr['status']} without its branch {info['branch']}: restore it, or board return/unclaim the change request"))
        elif not Path(info['worktree']).is_dir():
            found.append((cr['id'], 'cr-worktree', f"{cr['status']} without its worktree {info['worktree']}: git worktree add {info['worktree']} {info['branch']}"))
    return found


def open_worktree(board: Board, cr: dict, main: Path, start: str | None = None) -> tuple[bool, str | None]:
    """Makes sure the CR's worktree exists, creating it from its branch (a returned or moved CR) or from its base tip
    (a new one, recording the fork point, A3). `start`: a new branch forks there, on the target (a follow-up to a landed range
    forks at that range's tip; the next refresh rebases it). (worktree created here, the tip a branch created here started at)."""
    cid = cr['id']
    path, branch = cr_worktree(main, cid), cr_branch(cid)
    exclude_worktrees(main)
    if path.exists():
        head = git(path, 'rev-parse', '--abbrev-ref', 'HEAD', check=False).stdout.decode().strip()
        if head != branch:
            raise BoardError(f'{cid}: {path} exists but is on {head or "no branch"}, not {branch}: remove or fix it, then claim again')
        return False, None
    if rev(main, f'refs/heads/{branch}'):
        git(main, 'worktree', 'add', str(path), branch)
        return True, None
    base = None if start else next(iter(board.cr_waits(cr)[1]), None)
    if base:
        base_value, ref = base, f'refs/heads/{cr_branch(base)}'
    else:
        base_value = target_branch(board, main)
        ref = f'refs/heads/{base_value}'
    tip = start or rev(main, ref)
    if tip is None:
        raise BoardError(f'{cid}: base {base_value} has no branch')
    git(main, 'worktree', 'add', '-b', branch, str(path), tip)
    put_meta(cr, base=base_value, base_sha=tip)
    return True, tip


def drop_worktree(main: Path, cr_id: str, branch_tip: str | None) -> None:
    """Undoes what a failed claim made: a worktree this call added (never forced) when nobody holds the CR now, and the branch
    only when this call created it and it still points where it was created. A branch that existed before is never touched (F3)."""
    held = bd_show([cr_id], comments=False)
    if held and held[0].get('assignee'):
        return
    if git(main, 'worktree', 'remove', str(cr_worktree(main, cr_id)), check=False).returncode == 0 and branch_tip:
        git(main, 'update-ref', '-d', f'refs/heads/{cr_branch(cr_id)}', branch_tip, check=False)


def ensure_setup(board: Board, cr: dict, wt: Path) -> str | None:
    """Runs the project setup when the base commit differs from the one it last ran at (q210, A5); its output tail on failure."""
    sha = meta(cr).get('base_sha')
    if sha and meta(cr).get('setup_sha') == sha:
        return None
    code, out = run_shell(wt, board_setting(board, 'setup'))
    if code:
        return out or f'setup exited {code}'
    if sha:
        put_meta(cr, setup_sha=sha)
    return None


def sync_branch(board: Board, cr: dict, main: Path, wt: Path) -> dict:
    """Rebase onto the base tip (`--onto <base tip> <fork point>`, A3), set up when the base moved, run the checks, store the
    (tip, base tip) pair (q209) from a clean tree (A5). The checks' failure is a result, not an error."""
    cid = cr['id']
    problem = tree_problem(wt)
    if problem:
        raise BoardError(f'{cid}: {problem}')
    base_value, ref = cr_base(board, cr, main)
    base_tip = rev(main, ref)
    if base_tip is None:
        raise BoardError(f'{cid}: base {base_value} has no branch')
    fork = meta(cr).get('base_sha') or git_text(wt, 'merge-base', base_tip, 'HEAD').strip()
    old_tip, moved = rev(wt, 'HEAD'), None
    # Every rebase is `--onto <base tip> <fork point>`; the marker remembers a rebase that stopped on a conflict, so a rerun
    # after the base moved again does not replay the base's own commits (F4, F5).
    marker, started_at = meta(cr).get('rebase_onto'), meta(cr).get('rebase_from')
    if marker and is_ancestor(wt, marker, 'HEAD') and not (started_at and is_ancestor(wt, started_at, 'HEAD')):
        fork = marker  # that rebase was completed by hand: HEAD has its target and no longer the commits it started from
        put_meta(cr, base_sha=fork, rebase_onto=None, rebase_from=None)
    if fork != base_tip:
        if is_ancestor(wt, base_tip, 'HEAD') and is_ancestor(wt, fork, base_tip):
            pass  # the branch already contains the base tip, and only the fork point was behind
        else:
            moved = fork
            put_meta(cr, rebase_onto=base_tip, rebase_from=old_tip)
            if git(wt, 'rebase', '--onto', base_tip, fork, check=False).returncode != 0:
                raise BoardError(f'{cid}: the rebase onto {base_tip[:12]} stopped on a conflict in {wt}: resolve it, git add, '
                                 'git rebase --continue, then rerun')
    put_meta(cr, base=base_value, base_sha=base_tip, rebase_onto=None, rebase_from=None)
    head = rev(wt, 'HEAD')
    failure = ensure_setup(board, cr, wt)
    if failure is not None:
        raise BoardError(f'{cid}: setup failed (the claim stays; hand-over waits until it passes):\n{failure}')
    passed, out, detail = check_verdict(board, cr, main, wt, base_tip)
    code = 0 if passed else 1
    tip = rev(wt, 'HEAD')
    if tip != head or tree_problem(wt):  # the pair must name the tree that was checked (F8)
        raise BoardError(f'{cid}: setup or the checks changed the worktree (a commit, or uncommitted files); nothing was recorded: '
                         f'{tree_problem(wt) or "HEAD moved from " + head[:12] + " to " + tip[:12]}')
    put_meta(cr, check_tip=tip, check_base_tip=base_tip, check_result='pass' if passed else 'fail', check_at=stamp(), check_output=out or None,
             check_new=('\n'.join(detail['new']) or '-') if detail else None, check_base_count=detail['base'] if detail else None,
             check_tip_count=detail['tip'] if detail else None, check_kind=None, check_command=None, check_reason=None)
    board._cr.pop(cid, None)
    return {'oldTip': old_tip, 'oldBase': fork, 'moved': moved is not None, 'baseTip': base_tip, 'tip': tip, 'code': code, 'output': out}


def claim_cr(board: Board, cr: dict, actor: str, kind: str) -> tuple[bool, str]:
    """Claims a change request for the pull that found it. Work: the worktree first, then the hold (a worktree failure leaves
    it unclaimed), then setup (a failure keeps the claim, A5). Planning: the hold. Review, accept, refresh: the hold, status kept."""
    cid = cr['id']
    if kind == 'plan':
        ok, message = claim_one(cr, actor)
        if ok and meta(cr).get('replan'):
            put_meta(cr, replan=None)
        return ok, message
    main = main_root()
    created, made_tip = open_worktree(board, cr, main)
    ok, message = claim_one(cr, actor)
    if not ok:
        if created and kind in ('design', 'implement'):
            drop_worktree(main, cid, made_tip)
        return False, message
    if kind in ('design', 'implement'):
        print(f'  worktree {cr_worktree(main, cid)} on {cr_branch(cid)}; base {meta(cr).get("base") or target_branch(board, main)}')
        failure = ensure_setup(board, cr, cr_worktree(main, cid))
        if failure is not None:
            print(f'  setup failed; the claim stays and hand-over waits until it passes:\n{failure}', file=sys.stderr)
    else:
        print(f'  worktree {cr_worktree(main, cid)}')
        if kind == 'review':
            put_meta(cr, reviewing_tip=rev(main, f'refs/heads/{cr_branch(cid)}'))  # the tip this reviewer is shown
    return True, ''


def open_item_refusal(board: Board, cr: dict) -> str | None:
    items = board.cr_items(cr['id'])
    return f"{cr['id']}: items still open: {', '.join(i['id'] for i in items)}; close them (board bd close <item> --reason \"<sha>: …\") or move them out" if items else None


def cr_ratification(board: Board, cr: dict, title: str) -> str | None:
    """The item for the user's look at what already landed or passed (blocks nothing), once per title."""
    if any(board.by_id.get(c, {}).get('title') == title for c in board.children.get(cr['id'], [])):
        return None
    command = rewritten_create('create', ['--type', 'task', '--title', title, '--priority', str(cr.get('priority', 2)),
                                          '--description', f"Look at {cr.get('title', '')} ({cr['id']}): branch {cr_branch(cr['id'])}. Close when ratified; "
                                          'a "no" becomes a follow-up change request.', '--parent', cr['id'], '--silent'], board)
    made = bd_checked(*command).strip().splitlines()[-1]
    bd_checked('update', made, '--status', 'needs_ratification', '--set-metadata', 'ratification=1', '--json')
    return made


class LandedError(BoardError):
    """The target already holds the tip: only the work after the fast-forward failed."""


def no_own_commits(main: Path, cr: dict, tip: str) -> bool:
    """The CR's branch holds no commit of its own: nothing between its fork point and its tip (r10-q50). An unknown fork point
    counts as commits, so a CR the board cannot judge goes the normal way."""
    fork = meta(cr).get('base_sha')
    if not fork or not tip:
        return False
    counted = git(main, 'rev-list', '--count', f'{fork}..{tip}', check=False)
    return counted.returncode == 0 and counted.stdout.decode().strip() == '0'


def finish_landing(board: Board, cr: dict, tip: str, name: str, main: Path) -> list[str]:
    """What follows the target holding the CR's tip, idempotent (ff and close are two writes, A6): the ratification of a
    look-after CR, the close (forced: the git fact is authoritative), the CRs stacked on it re-based to the target, the worktree
    and branch gone (the branch only if it still is at the landed tip)."""
    cid, notes = cr['id'], []
    look = cr_look(board, cr)
    if look == 'after' and not no_own_commits(main, cr, tip):  # nothing landed, nothing to ratify (r10-q50)
        made = cr_ratification(board, cr, f"Ratify: {cr.get('title', '')}")
        notes += [f'ratification {made}'] if made else []
    if cr['status'] != 'closed':
        bd_checked('close', cid, '--reason', f'landed {tip[:12]} on {name} from {cr_branch(cid)}', '--force')
        cr['status'] = 'closed'
    for other in live_crs(board):
        if meta(other).get('base') == cid:
            put_meta(other, base=name)
    wt = cr_worktree(main, cid)
    if wt.exists() and git(main, 'worktree', 'remove', str(wt), check=False).returncode != 0:
        notes.append(f'worktree {wt} kept (it holds uncommitted files)')
    elif git(main, 'update-ref', '-d', f'refs/heads/{cr_branch(cid)}', tip, check=False).returncode == 0:
        notes.append(f'removed {wt} and {cr_branch(cid)}')
    else:
        notes.append(f'{cr_branch(cid)} kept (it moved past {tip[:12]})')
    return notes


def settle_landed(board: Board) -> bool:
    """A change request whose tip the target holds is landed (A6): the next board command finishes what a failed second write
    left. Only a tip the board vouched for counts: the one `land` wrote as `landing` before advancing the target, or the checked
    tip with commits past its fork point; a branch that merely fast-forwarded to the target is not landed (F6). A failure is
    kept per change request for `board check`, never stopping the command."""
    changed = False
    live = [i for i in live_crs(board) if i['status'] in ('in_progress', 'in_review', ACCEPT)]
    if not live:
        return False
    try:
        main = view_main(board)
        name = target_branch(board, main)
    except BoardError:
        return False
    target_tip = view_rev(board, main, f'refs/heads/{name}')
    problems = board.__dict__.setdefault('settle_problems', {})
    for cr in live:
        tip = cr_info(board, cr)['tip']
        fork, m = meta(cr).get('base_sha'), meta(cr)
        vouched = bool(tip) and (m.get('landing') == tip or (m.get('check_tip') == tip and bool(fork) and tip != fork))
        if vouched and target_tip and is_ancestor(main, tip, target_tip):
            board.git_view = None  # finishing a landing (even a failed one) moves branches and worktrees: live reads from here on
            try:
                for note in finish_landing(board, cr, tip, name, main):
                    print(f"{cr['id']}: landed on {name} (the target holds {tip[:12]}); {note}", file=sys.stderr)
                changed = True
            except BoardError as error:
                problems[cr['id']] = f'the target holds {tip[:12]} but finishing the landing failed: {error}'
    return changed


def land_core(board: Board, cr: dict, main: Path, tip: str | None = None) -> list[str]:
    """Fast-forwards the target to the CR's tip and finishes the landing. Refuses unless the base is the target, the items
    are closed and the check and review pairs are the current (branch tip, target tip) with a pass (q183, q209, q236, A1, A6)."""
    cid = cr['id']
    base, _ = cr_base(board, cr, main)
    if board.is_cr(base):
        raise BoardError(f'{cid}: stacked on {base}, which has not landed: board cr land {base} first (it then lands this one when its check is current)')
    refusal = open_item_refusal(board, cr)
    if refusal:
        raise BoardError(refusal)
    name = target_branch(board, main)
    ref = f'refs/heads/{name}'
    branch_tip, old = rev(main, f'refs/heads/{cr_branch(cid)}'), rev(main, ref)
    if branch_tip is None:
        raise BoardError(f'{cid}: no branch {cr_branch(cid)}')
    if tip and rev(main, tip) != branch_tip:
        raise BoardError(f'{cid}: the branch moved since {tip}: now {branch_tip[:12]}; look at the change again (board cr refresh, then re-show the range)')
    pair = check_pair(cr)
    if pair is None or pair['result'] != 'pass' or pair['tip'] != branch_tip or pair['baseTip'] != old:
        state = check_state(main, cr, branch_tip, old)
        raise BoardError(f'{cid}: not landed, its check is {state} (it must pass for tip {branch_tip[:12]} on {name} {old[:12]}): board cr refresh {cid}')
    if not review_current(cr, {'tip': branch_tip, 'baseTip': old, 'main': main}):
        raise BoardError(f'{cid}: not landed, its review is of another (tip, base tip) than {branch_tip[:12]} on {name} {old[:12]}: '
                         f'board cr refresh {cid} --review-holds if the review still holds, else board handover {cid} "<flag>" sends it back to review')
    where, rebasing = checked_out_at(main, ref)
    if rebasing:
        raise BoardError(f'{cid}: not landed, {rebasing}')
    blocked = land_blocked(main, name, branch_tip)
    if blocked:
        raise BoardError(f"{cid}: land blocked: uncommitted edits in the worktree with {name} checked out overlap: {', '.join(blocked)}; commit or stash them")
    put_meta(cr, landing=branch_tip)  # vouches for this tip: if the close fails after the fast-forward, the next read finishes it
    done = git(where, 'merge', '--ff-only', branch_tip, check=False) if where else git(main, 'update-ref', ref, branch_tip, old, check=False)
    if done.returncode != 0:
        put_meta(cr, landing=None)
        raise BoardError(f"{cid}: the fast-forward of {name} failed: {done.stderr.decode('utf-8', 'replace').strip() or 'exit ' + str(done.returncode)}")
    after = [other for other in live_crs(board) if after_base(board, other) == cid]  # before their base is reset to the target
    try:
        notes = finish_landing(board, cr, branch_tip, name, main)
    except BoardError as error:
        raise LandedError(f'{cid}: {name} now holds {branch_tip[:12]}, but finishing the landing failed ({error}); the next board read finishes it') from None
    board._cr.clear()
    for other in after:
        try:
            if cr_info(board, other)['state'] == 'current' and review_current(other, cr_info(board, other)):
                notes.append(f"{other['id']} (after {cid}): " + '; '.join(land_core(board, other, main)))
            else:
                notes.append(f"{other['id']} (after {cid}): left as refresh work (its check or review no longer matches)")
        except LandedError as error:
            notes.append(f"{other['id']} (after {cid}): landed on {name}, but: {error}")
        except BoardError as error:
            notes.append(f"{other['id']} (after {cid}): not landed: {error}")
    return notes


def cr_arg(board: Board, item_id: str, verb: str) -> dict:
    """The change request the verb names; an item inside one is told to use its CR."""
    issue = require_open(board, [item_id])[0]
    if not board.is_cr(item_id):
        cr_id = board.cr_of(item_id)
        raise BoardError(f"{item_id}: board {verb} works on change requests" + (f"; its change request is {cr_id}" if cr_id else ''))
    return issue


def holds_cr(issue: dict, actor: str) -> bool:
    holder = issue.get('assignee')
    return bool(holder) and session_actor(holder) == session_actor(actor)


def waiting_for_user(cr: dict, holder: str | None) -> None:
    """Moves a change request to the user's Accept (needs_acceptance), unassigned, remembering since when."""
    bd_checked('update', cr['id'], '--status', ACCEPT, '--assignee', '', *(['--if-assignee', holder] if holder else []), '--json')
    cr['status'] = ACCEPT
    put_meta(cr, since=stamp())


def handover(board: Board, args) -> None:
    actor = caller()
    cr = cr_arg(board, args.id, 'handover')
    holder = cr.get('assignee')
    if not holds_cr(cr, actor):
        raise BoardError(f"{args.id}: {cr['status']}, held by {holder or 'nobody'}; claim it first")
    m, status = meta(cr), cr['status']
    author = status == 'in_progress'
    if not author and status not in ('in_review', ACCEPT):
        raise BoardError(f"{args.id}: {status} is neither work in hand, a review to pass nor a refresh to send back to review")
    refuse_long_comment(HANDOVER + args.evidence)
    refusal = open_item_refusal(board, cr)
    if refusal:
        raise BoardError(refusal)
    main = main_root()
    wt = cr_worktree(main, args.id)
    if not wt.is_dir():
        raise BoardError(f'{args.id}: no worktree {wt}: git worktree add {wt} {cr_branch(args.id)}')
    result = sync_branch(board, cr, main, wt)
    if result['code']:
        raise BoardError(f"{args.id}: checks failed, not handed over:\n{result['output']}")
    look = cr_look(board, cr)
    expect = ['--if-assignee', holder]
    seen = meta(cr).get('reviewing_tip')
    if status == 'in_review' and result['tip'] != seen:  # the pass records only a tip the reviewer saw; none seen counts as moved (F2)
        put_meta(cr, reviewing_tip=result['tip'])
        if seen:
            shown = git(wt, 'range-diff', f"{result['oldBase']}..{seen}", f"{result['baseTip']}..{result['tip']}", check=False).stdout.decode('utf-8', 'replace')
            said = f"the tip moved from {seen[:12]} to {result['tip'][:12]} (a rebase onto the new base, or new commits) since you looked"
        else:
            shown = git(wt, 'log', '--stat', '--format=%h %s', f"{result['baseTip']}..{result['tip']}", check=False).stdout.decode('utf-8', 'replace')
            said = f"no tip is recorded as seen by you (the CR was taken over); the tip is {result['tip'][:12]}"
        raise BoardError(f"{args.id}: {said}; nothing was recorded. Review the change, then pass again:\n{shown.rstrip() or '(nothing to show)'}")
    if status == ACCEPT:  # the refresh triage flagged it: back to agent review, its verdict no longer stands (q236)
        bd_checked('update', args.id, '--status', 'in_review', '--assignee', '', *expect, '--json')
        put_meta(cr, since=None, review_tip=None, review_base_tip=None, reviewing_tip=None)
        comment(args.id, HANDOVER + args.evidence)
        print(f'handed over {args.id} back to agent review (check {"pass" if not result["code"] else "fail"} on {result["tip"][:12]})')
        return
    if author:
        put_meta(cr, review_tip=None, review_base_tip=None, reviewing_tip=None)  # a new hand-over starts a new review (F9)
        if m.get('checkpoint') == 'user':  # a design for the user goes straight to the user's Accept
            waiting_for_user(cr, holder)
            comment(args.id, HANDOVER + args.evidence)
            print(f'handed over {args.id}: its design checkpoint waits for you (check pass on {result["tip"][:12]})')
            return
        bd_checked('update', args.id, '--status', 'in_review', '--assignee', '', *expect, '--json')
        comment(args.id, HANDOVER + args.evidence)
        print(f'handed over {args.id} for {"checkpoint " if m.get("checkpoint") == "agent" else ""}review (check pass on {result["tip"][:12]})')
        return
    comment(args.id, f'board pass: {args.evidence}')
    put_meta(cr, review_tip=result['tip'], review_base_tip=result['baseTip'])  # the verdict holds for this (tip, base tip) pair (q236)
    if m.get('checkpoint') == 'agent':  # the agent's design checkpoint passed: the CR goes to planning
        bd_checked('update', args.id, '--status', 'open', '--assignee', '', *expect, '--json')
        put_meta(cr, checkpoint=None, since=None)
        made = cr_ratification(board, cr, f"Ratify design: {cr.get('title', '')}") if look == 'after' else None
        print(f'passed the checkpoint of {args.id}: open for planning' + (f'; ratification {made}' if made else ''))
        return
    base = cr_base(board, cr, main)[0]
    empty = no_own_commits(main, cr, result['tip'])  # nothing to merge: lands on its passed review, in either look, unseen (r10-q50)
    if (look == 'after' or empty) and not board.is_cr(base):
        bd_checked('update', args.id, '--assignee', '', *expect, '--json')
        try:
            notes = land_core(board, cr, main)
        except LandedError as error:
            print(f'passed and landed {args.id}, but: {error}')
            return
        except BoardError as error:  # the pass stands; the Accept queue holds it until the landing can run
            waiting_for_user(cr, None)
            print(f'passed {args.id}, not landed: {error}\n  it waits in the Accept queue')
            return
        print('\n'.join(notes))
        print(f'passed and landed {args.id}')
        return
    if (look == 'after' or empty) and board.is_cr(base):  # lands with its parent when the check and this review still match (q219)
        bd_checked('update', args.id, '--assignee', '', *expect, '--json')
        print(f'passed {args.id}: stays in review, marked after {base}; it lands with {base} when its check and review still match')
        return
    waiting_for_user(cr, holder)
    print(f'passed {args.id}: waiting for your Accept')


def return_item(board: Board, args) -> None:
    actor = derived_actor() or 'user'
    cr = cr_arg(board, args.id, 'return')
    refuse_long_comment(f'board return: {args.findings}')
    if cr['status'] not in ('in_review', ACCEPT):
        raise BoardError(f"{args.id}: {cr['status']}; only a change request in review or waiting for its Accept is returned (unclaim frees work in hand)")
    if cr['status'] == ACCEPT:
        if not may_move(board):
            raise BoardError(f'{args.id}: waiting for your Accept; the lead returns it with the findings you gave')
        if cr.get('assignee') and not holds_cr(cr, actor):
            raise BoardError(f"{args.id}: held by {cr['assignee']} (a refresh); return it once that is released")
    elif not holds_cr(cr, actor):
        raise BoardError(f"{args.id}: {cr['status']}, held by {cr.get('assignee') or 'nobody'}; claim it first")
    bd_checked('update', args.id, '--status', 'open', '--assignee', '', '--json')
    put_meta(cr, since=None, review_tip=None, review_base_tip=None, reviewing_tip=None)
    comment(args.id, f'board return: {args.findings}')
    print(f'returned {args.id} to the queue (worktree and branch kept)')


DESIGN_FIELDS = ('description', 'design', 'acceptance_criteria', 'notes')


def design_pin(board: Board, cr: dict) -> tuple[str, list[str]]:
    """(hash, ids) of a design checkpoint's design items (its children of type design, closed ones included): the text the user
    is walked through. `board cr land --checkpoint --design <hash>` accepts only that text."""
    designs = sorted((i for i in cr_closed_items(board, cr['id']) if i.get('issue_type') == 'design'), key=lambda i: i['id'])
    text = json.dumps([[i['id'], *(i.get(field) or '' for field in DESIGN_FIELDS)] for i in designs])
    return hashlib.sha256(text.encode()).hexdigest()[:12], [i['id'] for i in designs]


def land(board: Board, args) -> int:
    caller_actor = derived_actor() or 'user'
    cr = cr_arg(board, args.id, 'land')
    if not may_move(board):
        raise BoardError('only a lead or solo session, or a person, lands a change request (the Accept)')
    m = meta(cr)
    if cr['status'] != ACCEPT:
        raise BoardError(f"{args.id}: {cr['status']}; only a change request waiting for its Accept lands")
    if cr.get('assignee') and not holds_cr(cr, derived_actor() or ''):
        raise BoardError(f"{args.id}: held by {cr['assignee']}: land it once that session releases it")
    main = main_root()
    if args.design is not None and not args.checkpoint:
        raise BoardError('--design pins a design checkpoint: use it with --checkpoint')
    if args.checkpoint and args.design is None:
        raise BoardError(f'{args.id}: --checkpoint needs --design <hash>, the design hash board claim {args.id} printed')
    if args.checkpoint:
        if m.get('checkpoint') != 'user':
            raise BoardError(f'{args.id}: no user checkpoint is pending')
        if (pin := design_pin(board, cr)[0]) != args.design:
            raise BoardError(f'{args.id}: the design changed since the claim (hash {pin}, not {args.design}); walk through it again, then land with --design {pin}')
        put_meta(cr, checkpoint=None, since=None)
        bd_checked('update', args.id, '--status', 'open', '--assignee', '', '--json')
        comment(args.id, f'board cr land --checkpoint: {caller_actor} accepted the design; nothing landed, the planner adds the items.')
        print(f'accepted the design checkpoint of {args.id}: open for planning')
        return 0
    if m.get('checkpoint') == 'user':
        raise BoardError(f'{args.id}: a design checkpoint is pending: board cr land {args.id} --checkpoint')
    for note in land_core(board, cr, main, args.tip):
        print(note)
    print(f"landed {args.id} on {board_setting(board, 'target')}")
    return 0


def reject(board: Board, args) -> int:
    actor = derived_actor() or 'user'
    cr = cr_arg(board, args.id, 'reject')
    if not may_move(board):
        raise BoardError('only a lead or solo session, or a person, rejects a change request')
    refuse_long_comment(f'board cr reject: {args.reason}')
    comment(args.id, f'board cr reject: {actor}: {args.reason}')
    reopened = [c for c in cr_closed_items(board, args.id) if c['status'] == 'closed' and not meta(c).get('ratification')
                and not c.get('title', '').startswith('Ratify')]  # a ratification is no work to redo
    for child in reopened:
        bd_checked('update', child['id'], '--status', 'open', '--assignee', '', '--json')
        comment(child['id'], f'board cr reject: {args.id} was rejected ({args.reason}); the work is not landed.')
    bd_checked('close', args.id, '--reason', f"rejected: {args.reason}"[:300].ljust(20, '.'), '--force')  # open items stay open for replanning
    cr['status'] = 'closed'
    target = board_setting(board, 'target')
    back = []
    for other in live_crs(board):
        if meta(other).get('base') == args.id:
            put_meta(other, base=target, replan=args.reason[:200], since=None)
            bd_checked('update', other['id'], '--status', 'open', '--assignee', '', '--json')
            comment(other['id'], f"board cr reject: {args.id}, which this stacked on, was rejected ({args.reason}); back to planning with the base reset to the target.")
            back.append(other['id'])
    print(f"rejected {args.id}; reopened {len(reopened)} items" + (f"; back to planning: {', '.join(back)}" if back else '')
          + f"; branch {cr_branch(args.id)} and its worktree stay until you confirm deleting them")
    return 0


def patch_ids(wt: Path, base: str, tip: str) -> list[str]:
    """The patch-id of each commit in base..tip, oldest first: equal lists mean the same changes, however they were rebased."""
    log = git(wt, 'log', '--reverse', '-p', '--binary', '--no-color', f'{base}..{tip}', check=False).stdout
    out = subprocess.run(['git', 'patch-id', '--verbatim'], cwd=wt, input=log, capture_output=True).stdout.decode()
    return [row.split()[0] for row in out.splitlines() if row.strip()]


def refresh(board: Board, args) -> int:
    actor = caller()
    cr = cr_arg(board, args.id, 'refresh')
    if cr.get('assignee') and not holds_cr(cr, actor):
        raise BoardError(f"{args.id}: held by {cr['assignee']}; refresh waits until that session releases it")
    if cr['status'] not in ('in_review', 'in_progress', ACCEPT):
        raise BoardError(f"{args.id}: {cr['status']}, no worktree in use to refresh")
    if args.review_holds and cr['status'] != ACCEPT:
        raise BoardError(f'{args.id}: --review-holds re-stamps the review of a change request waiting for its Accept')
    if not holds_cr(cr, actor) and held_by_review_tree(board, cr):
        raise BoardError(f'{args.id} is open in your review tree; it refreshes once a deciding session claims it')
    main = main_root()
    wt = cr_worktree(main, args.id)
    if not wt.is_dir():
        raise BoardError(f'{args.id}: no worktree {wt}: git worktree add {wt} {cr_branch(args.id)}')
    result = sync_branch(board, cr, main, wt)
    print(f"refreshed {args.id}: tip {result['tip'][:12]} on base {result['baseTip'][:12]}; checks {'failed (exit ' + str(result['code']) + ')' if result['code'] else 'pass'}")
    if result['code']:
        print(result['output'])
    old_tip, old_base = result['oldTip'], result['oldBase']
    reviewed, reviewed_base = meta(cr).get('review_tip'), meta(cr).get('review_base_tip')
    # What a waiting-for-Accept CR's triage asks is what changed since the review, not since the last fork (q236).
    since_review = cr['status'] == ACCEPT and bool(reviewed and reviewed_base and rev(wt, reviewed) and rev(wt, reviewed_base)) \
        and not review_current(cr, {'tip': result['tip'], 'baseTip': result['baseTip'], 'main': main})
    from_base, from_tip = (reviewed_base, reviewed) if since_review else (old_base, old_tip)
    if since_review or result['moved'] or result['tip'] != old_tip:
        ranges = git(wt, 'range-diff', f'{from_base}..{from_tip}', f"{result['baseTip']}..{result['tip']}", check=False).stdout.decode('utf-8', 'replace')
        print(f"range-diff {'review' if since_review else 'old'}..new:\n" + ranges.rstrip())
    incoming = git_text(wt, 'diff', '--name-only', from_base, result['baseTip']).splitlines() if from_base != result['baseTip'] else []
    print(f'incoming files ({from_base[:12]}..{result["baseTip"][:12]}{", since the review" if since_review else ""}): {len(incoming)}' + ''.join(f'\n  {path}' for path in incoming))
    if cr['status'] == ACCEPT:
        info = {'tip': result['tip'], 'baseTip': result['baseTip'], 'main': main}
        triaged = (meta(cr).get('triaged_tip'), meta(cr).get('triaged_base_tip'))
        put_meta(cr, triaged_tip=result['tip'], triaged_base_tip=result['baseTip'])  # what this output asked the triage about
        if not review_current(cr, info) and not args.review_holds:
            print(f'{args.id}: its review was of another (tip, base tip); if the incoming change touches it: board handover {args.id} "<flag>" '
                  f'sends it back to agent review; if the review still holds: board cr refresh {args.id} --review-holds, then board unclaim {args.id}')
        if args.review_holds:  # the triage verdict "the review still holds" is recorded explicitly (F1)
            if result['code']:
                raise BoardError(f'{args.id}: the check is not passing, so the review cannot be kept; board handover {args.id} "<why>" sends it back to review')
            if not reviewed or not reviewed_base or rev(wt, reviewed) is None or rev(wt, reviewed_base) is None:
                raise BoardError(f'{args.id}: no reviewed range is recorded; board handover {args.id} "<why>" sends it back to review')
            held = patch_ids(wt, reviewed_base, reviewed)  # edit commits the reviewed range already holds stay in the comparison
            new = zip(patch_ids(wt, result['baseTip'], result['tip']), edit_commits(wt, cr, result['baseTip'], result['tip']))
            if held != [one for one, is_edit in new if not is_edit or one in held]:  # a changed edit commit is no recorded one
                raise BoardError(f'{args.id}: its commits are no longer the reviewed changes (a conflict resolution, or new commits); '
                                 f'board handover {args.id} "<why>" sends it back to review')
            if triaged != (result['tip'], result['baseTip']):  # the base or the tip moved after the triage: that change is untriaged
                raise BoardError(f'{args.id}: the base or the tip moved since the last refresh, so the incoming list above is new and untriaged; '
                                 f'triage it, then run board cr refresh {args.id} --review-holds again (or board handover {args.id} "<flag>")')
            put_meta(cr, review_tip=result['tip'], review_base_tip=result['baseTip'])
            print(f'{args.id}: the review holds for tip {result["tip"][:12]} on base {result["baseTip"][:12]}; board unclaim {args.id}')
    return 0


def review_edits_tree(main: Path, tree: Path, tip: str) -> str:
    """The tree object holding the review tree's files: tracked and new (not ignored) as they are on disk. Built in a throwaway
    index, so the review tree's own index and files are never touched. The console's clean check (review.ts `snapshotTree`) is the
    same recipe; the test proves both give one tree."""
    if not tree.is_dir() or git(tree, 'rev-parse', '--git-dir', check=False).returncode != 0:
        raise BoardError(f'{tree} is not a git worktree')
    common = lambda root: Path(git_text(root, 'rev-parse', '--path-format=absolute', '--git-common-dir').strip()).resolve()
    if common(tree) != common(main):
        raise BoardError(f'{tree} is a worktree of another repository')
    marked = rev(tree, REVIEW_END_REF)
    if not marked:
        raise BoardError(f'{tree} has no review-end marker: it is not the console review tree, so its files are not your edits')
    if marked != tip:
        raise BoardError(f'the review tree {tree} was set to {marked[:12]}, not {tip[:12]}: its edits are against another tip')
    with tempfile.TemporaryDirectory() as scratch:
        env = {'GIT_INDEX_FILE': str(Path(scratch) / 'index')}
        git(tree, 'read-tree', tip, env=env)
        git(tree, 'add', '-A', env=env)
        return git_text(tree, 'write-tree', env=env).strip()


def mark_reviewed(tree: Path, tip: str, commit: str) -> bool:
    """Moves the review tree's marker from the tip its edits were against to the commit that holds them, only if it still names that
    tip: the tree's files then equal the marker's tree, which the console reads as clean (review.ts `readReviewTree`)."""
    return git(tree, 'update-ref', REVIEW_END_REF, commit, tip, check=False).returncode == 0


def user_identity(main: Path) -> dict[str, str]:
    """Author environment of the user's commit: git's user.name and user.email of the repository."""
    who = {key: git(main, 'config', key, check=False).stdout.decode().strip() for key in ('user.name', 'user.email')}
    if not all(who.values()):
        raise BoardError('git user.name and user.email are not set: the review edits are committed as yours')
    return {'GIT_AUTHOR_NAME': who['user.name'], 'GIT_AUTHOR_EMAIL': who['user.email']}


def edits_commit(main: Path, tree: Path, tip: str, edits: str, message: str) -> str:
    """The commit of the edits' exact tree on `tip`: author the user, committer the session, no trailer; the board records it."""
    actor = derived_actor()
    author = user_identity(main)
    committer = {'GIT_COMMITTER_NAME': actor, 'GIT_COMMITTER_EMAIL': f'{actor}@board.invalid'} if actor else \
        {'GIT_COMMITTER_NAME': author['GIT_AUTHOR_NAME'], 'GIT_COMMITTER_EMAIL': author['GIT_AUTHOR_EMAIL']}
    return git_text(main, 'commit-tree', edits, '-p', tip, '-m', message.rstrip() + '\n', env={**author, **committer}).strip()


def edits_target(board: Board, args) -> tuple[dict, dict | None, str]:
    """(the item, the landed change request or None, the tip the edits are against): a change request waiting for its Accept, or the
    ratification of a landed one."""
    issue = require_open(board, [args.id])[0]
    if board.is_cr(args.id):
        if issue['status'] != ACCEPT:
            raise BoardError(f"{args.id}: {issue['status']}; board cr edits works on a change request waiting for its Accept, or a ratification")
        return issue, None, rev(main_root(), f'refs/heads/{cr_branch(args.id)}') or ''
    if issue['status'] != 'needs_ratification' or not meta(issue).get('ratification'):
        raise BoardError(f"{args.id}: board cr edits works on a change request waiting for its Accept, or a ratification" +
                         (f"; its change request is {board.cr_of(args.id)}" if board.cr_of(args.id) else ''))
    parent = (board.parents.get(args.id) or [''])[0]
    landed = bd_show([parent], comments=False) if parent else []
    if not landed:
        raise BoardError(f'{args.id}: its change request {parent or "-"} is gone: no landed range to take edits against')
    m = meta(landed[0])
    return issue, landed[0], m.get('landing') or m.get('check_tip') or ''


def record_edits(cr: dict, commit: str) -> None:
    """Appends the commit to the CR's `review_edits`, so it keeps the review (`edits_only`)."""
    put_meta(cr, review_edits=json.dumps([*edit_entries(cr), {'commit': commit}]))


def store_gate(cr: dict, tip: str, base_tip: str, gate: str | None, reason: str | None, passed: bool, output: str) -> None:
    """The check of an edit commit, stored as what it was: a targeted run (command, output) or no check (the reason). Never a full pass."""
    put_meta(cr, check_tip=tip, check_base_tip=base_tip, check_result='pass' if passed else 'fail', check_at=stamp(),
             check_output=tail(output) or None, check_kind='targeted' if gate else 'none', check_command=gate, check_reason=reason,
             check_new=None, check_base_count=None, check_tip_count=None)


def cr_edits(board: Board, args) -> int:
    main = main_root()
    issue, landed, branch_tip = edits_target(board, args)
    tree, expect = Path(args.tree).resolve(), rev(main, args.tip)
    if expect is None:
        raise BoardError(f'{args.tip} is not a commit here')
    what = landed['id'] if landed else args.id
    if branch_tip != expect:
        raise BoardError(f"{what}: {'landed at' if landed else 'its branch tip is'} {branch_tip[:12] or 'none'}, not {expect[:12]}: the edits are against a tip it no longer has; look at the change again")
    edits = review_edits_tree(main, tree, expect)
    if edits == git_text(main, 'rev-parse', f'{expect}^{{tree}}').strip():
        raise BoardError(f'{args.id}: the review tree {tree} holds no edits against {expect[:12]}')
    if not args.commit:
        shown = git_text(main, 'diff', '--binary', '--no-color', expect, edits)
        names = git_text(main, 'diff', '--name-status', expect, edits).splitlines()
        print(f'edits in {tree} against {expect[:12]} ({len(names)} files):' + ''.join(f'\n  {row}' for row in names) + f'\n\n{shown}', end='')
        return 0
    if not may_move(board):
        raise BoardError('only a lead or solo session, or a person, commits the review edits')
    if landed is None and issue.get('assignee') and not holds_cr(issue, derived_actor() or ''):
        raise BoardError(f"{args.id}: held by {issue['assignee']}: commit the edits once that session releases it")
    if landed is not None and (args.gate or args.no_gate or args.checks):
        raise BoardError(f'{args.id}: a ratification edit starts a follow-up change request, whose own checks run at its hand-over: drop --gate, --no-gate and --checks')
    commit = edits_commit(main, tree, expect, edits, args.message)
    if landed is not None:
        return follow_up(board, issue, landed, expect, commit, tree)
    cr, wt = issue, cr_worktree(main, args.id)
    if not wt.is_dir():
        raise BoardError(f'{args.id}: no worktree {wt}: git worktree add {wt} {cr_branch(args.id)}')
    if rev(wt, 'HEAD') != expect or tree_problem(wt):
        raise BoardError(f"{args.id}: {tree_problem(wt) or 'its worktree is not at ' + expect[:12]}")
    base_tip = rev(main, cr_base(board, cr, main)[1])
    if (args.gate or args.no_gate) and not is_ancestor(main, base_tip, expect):  # --checks rebases itself
        raise BoardError(f'{args.id}: its base moved ({base_tip[:12]}): board cr refresh {args.id} first, then look again; a check of the edit would name a base the branch is not on')
    git(wt, 'merge', '--ff-only', commit)
    if not mark_reviewed(tree, expect, commit):
        git(wt, 'reset', '-q', '--keep', expect)
        raise BoardError(f'{args.id}: the review tree {tree} was set to another range meanwhile; nothing committed')
    record_edits(cr, commit)
    print(f'committed the edits of {tree} on {cr_branch(args.id)} as {commit[:12]} (author {git(main, "log", "-1", "--format=%an", commit).stdout.decode().strip()})')
    comment(args.id, f'board cr edits: the review edits of {tree}@{expect[:12]} committed as {commit[:12]}.')
    if args.checks:  # the handover/refresh runner: rebase, setup, the project checks, no-new-failures, stored as a full check
        result = sync_branch(board, cr, main, wt)
        board._cr.pop(args.id, None)
        if result['code']:
            rebased = f"; the branch was rebased to {result['tip'][:12]}: Open {args.id} again before editing" if result['tip'] != commit else ''
            print(f"checks failed (exit {result['code']}):\n{result['output']}\n"
                  f"nothing lands; the edit commit stays on {cr_branch(args.id)} and {args.id} waits for the user: fix it{rebased}, or board return {args.id} \"<findings>\" sends it to a worker")
            return 1
        if not review_current(cr, {'tip': result['tip'], 'baseTip': result['baseTip'], 'main': main}):  # the rebase moved its base
            print(f"stored: full check passed for {result['tip'][:12]}; the review is of the old base: board cr refresh {args.id} shows what came in; "
                  f"if the review still holds, board cr refresh {args.id} --review-holds, then board cr land {args.id} --tip {result['tip'][:12]}")
            return 0
        print(f"stored: full check passed for {result['tip'][:12]}; land with board cr land {args.id} --tip {result['tip'][:12]}")
        return 0
    if not (args.gate or args.no_gate):
        print('no check stored for it')
        return 0
    passed, output = True, ''
    if args.gate:
        code, output = run_shell_full(wt, args.gate)
        passed = code == 0
    if rev(wt, 'HEAD') != commit or tree_problem(wt):
        raise BoardError(f"{args.id}: the gate changed the worktree ({tree_problem(wt) or 'HEAD moved'}); nothing was recorded")
    store_gate(cr, commit, base_tip, args.gate, args.no_gate, passed, output)
    board._cr.pop(args.id, None)
    if not passed:
        print(f'gate failed (exit {code}): {args.gate}\n{tail(output)}\n'
              f'nothing lands; the edit commit stays on {cr_branch(args.id)} and {args.id} waits for the user: fix it, or board return {args.id} "<findings>" sends it to a worker')
        return 1
    print(f"stored: {'targeted check passed: ' + args.gate if args.gate else 'no check: ' + args.no_gate} (for {commit[:12]} only; it never counts as a full check); land with board cr land {args.id} --tip {commit[:12]}")
    return 0


def follow_up(board: Board, ratification: dict, landed: dict, tip: str, commit: str, tree: Path) -> int:
    """A ratification edit: a new change request whose first commit is the edit, forked at the landed tip (the target may have moved on;
    a refresh rebases it), linked to the ratification."""
    main = main_root()
    if not is_ancestor(main, tip, f'refs/heads/{target_branch(board, main)}'):
        raise BoardError(f'{landed["id"]}: its landed tip {tip[:12]} is not on {target_branch(board, main)}')
    title = f"Follow-up to {landed.get('title', '')}: review edits"
    command = rewritten_create('create', ['--type', CR_TYPE, '--title', title, '--priority', str(ratification.get('priority', 2)),
                                          '--description', f"The user's edits to {landed.get('title', '')} ({landed['id']}), made in the review tree at its landed range "
                                          f"and committed as this branch's first commit (ratification {ratification['id']}). Plan what follows.",
                                          '--deps', f"discovered-from:{ratification['id']}", '--silent'], board)
    made = bd_checked(*command).strip().splitlines()[-1]
    found = bd_show([made], comments=False)
    if not found:
        raise BoardError(f'{made}: created, but not readable; nothing committed')
    cr = found[0]
    created, made_tip = open_worktree(board, cr, main, start=tip)
    try:
        git(cr_worktree(main, made), 'merge', '--ff-only', commit)
        if not mark_reviewed(tree, tip, commit):
            raise BoardError(f'{ratification["id"]}: the review tree {tree} was set to another range meanwhile; nothing committed')
    except BoardError as error:
        branch = f'refs/heads/{cr_branch(made)}'
        removed = git(main, 'worktree', 'remove', '--force', str(cr_worktree(main, made)), check=False).returncode == 0
        now = rev(main, branch)  # the fork point, or the edit commit once the merge ran
        dropped = removed and made_tip is not None and now in (made_tip, commit) \
            and git(main, 'update-ref', '-d', branch, now, check=False).returncode == 0
        bd_checked('close', made, '--reason', 'the edit did not commit; nothing made', '--force')
        if made_tip and now and not dropped:
            raise BoardError(f'{error}; the rollback left branch {cr_branch(made)} at {now[:12]}: git branch -D {cr_branch(made)}') from None
        raise
    record_edits(cr, commit)
    comment(ratification['id'], f'board cr edits: the review edits of {tree}@{tip[:12]} started follow-up {made} (commit {commit[:12]} on {cr_branch(made)}).')
    print(f'follow-up {made} created: the edits of {tree} are its first commit {commit[:12]} on {cr_branch(made)} (forked at {tip[:12]}); plan it and close {ratification["id"]} with the user\'s answer')
    return 0


def edits_cmd(board: Board, args) -> int:
    if args.commit and not args.message:
        raise BoardError('--commit needs -m <message>')
    if (args.gate or args.no_gate or args.checks) and not args.commit:
        raise BoardError('--gate, --no-gate and --checks go with --commit')
    if sum(bool(one) for one in (args.gate, args.no_gate, args.checks)) > 1:
        raise BoardError('--gate, --no-gate and --checks exclude each other')
    return cr_edits(board, args)


SHOW_PASSTHROUGH = ('--refs', '--children', '--as-of', '--long', '--watch', '--current', '--thread', '-w', '-h', '--help')
GLOBAL_VALUES = ('-C', '--directory', '--db', '--database', '--actor', '--dolt-auto-commit', '--mem-profile')
SHOW_USAGE = 'use board show <ids> [--section …] [--field …] [--comments] [--full]'


def board_read(argv: list[str]) -> list[str] | None:
    """The board command a plain raw item read means (r9-q35): `show`/`view <ids>` and `comments <ids>`, global flags and
    other flags excluded (those keep the raw route or its refusal)."""
    if len(argv) < 2 or argv[0] not in ('show', 'view', 'comments') or argv[1] in ('add', 'list') \
            or any(arg.startswith('-') for arg in argv[1:]):
        return None
    return ['show', *argv[1:], *(['--comments'] if argv[0] == 'comments' else [])]


def type_refusal(command: str, rest: list[str]) -> str | None:
    """A creation or retyping with a type outside ITEM_TYPES (r9-q42): `create`, `q`, `create --for`, `create --graph` nodes and `update --type`."""
    types = flag_values(rest, '-t', '--type')
    graph = next(iter(flag_values(rest, '--graph')), None)
    if graph:
        types += [str(node.get('type')) for node in graph_plan(graph).get('nodes') or [] if isinstance(node, dict) and node.get('type')]
    bad = sorted({kind for kind in types if kind not in ITEM_TYPES})
    return (f"type {', '.join(bad)} is not a board type ({', '.join(ITEM_TYPES)}; board-core.md Kinds); "
            'a check others wait on is a task, a question is a decision') if bad else None


def default_look_refusal(rest: list[str]) -> str | None:
    """A change request's own `look` or `view` equal to the project default (r10-q52): metadata overrides the default, so a copy
    would hide a later switch. Checks `update --set-metadata` and the `metadata` of `create --graph` nodes; the default is read
    only when one is given, and an unreadable default lets bd answer."""
    given = [tuple(pair.partition('=')[::2]) for pair in flag_values(rest, '--set-metadata')]
    graph = next(iter(flag_values(rest, '--graph')), None)
    if graph:
        given += [(key, str(value)) for node in graph_plan(graph).get('nodes') or [] if isinstance(node, dict)
                  for key, value in (node.get('metadata') if isinstance(node.get('metadata'), dict) else {}).items()]
    given = [(key, value) for key, value in given if key in ('look', 'view')]
    for key, value in given:
        try:
            default = current_setting(SETTINGS[key])
        except BoardError:
            return None
        if value == default:
            return (f'{key} {value} is the project default: set a change request\'s {key} only to override it '
                    f'(board setup --{key} changes the default; plan.md and change-requests.md)')
    return None


def question_type(rest: list[str]) -> list[str]:
    """`rest` with type question read as decision, the store's type for questions (r9-q35)."""
    out = ['decision' if before in ('--type', '-t') and arg == 'question' else arg for before, arg in zip(['', *rest], rest)]
    return [{'--type=question': '--type=decision', '-t=question': '-t=decision'}.get(arg)
            or re.sub(r'(\btype\s*=\s*"?)question\b', r'\1decision', arg) for arg in out]


FIELD_FLAGS = {'description': ('-d', '--description'), 'design': ('--design',), 'acceptance_criteria': ('--acceptance',), 'notes': ('--notes',)}
FIELD_FILES = {'description': '--body-file', 'design': '--design-file'}  # `-` reads stdin
APPEND_NOTES = '--append-notes'  # appends to notes: the guard counts the old notes plus the appended text


def last_flag_value(rest: list[str], *names: str) -> str | None:
    """The last value of a flag, `--flag value` and `--flag=value`."""
    found = None
    for at, arg in enumerate(rest):
        name, equals, value = arg.partition('=')
        if name in names:
            found = value if equals else (rest[at + 1] if at + 1 < len(rest) else None)
    return found


def field_texts(rest: list[str]) -> tuple[dict[str, str], str | None]:
    """(field -> the text a create or update sets, stdin when read to get it)."""
    texts, stdin = {}, None
    for field, names in FIELD_FLAGS.items():
        value = last_flag_value(rest, *names)
        if value is not None:
            texts[field] = value
    for field, flag in FIELD_FILES.items():
        path = last_flag_value(rest, flag)
        if field == 'description' and ('--stdin' in rest or path == '-') or path == '-':
            stdin = sys.stdin.read() if stdin is None else stdin
            texts[field] = stdin
        elif path:
            try:
                texts[field] = Path(path).read_text(encoding='utf-8')
            except (OSError, UnicodeDecodeError):
                pass  # bd reports an unreadable file
    return texts, stdin


def size_guard(command: str, rest: list[str]) -> tuple[str | None, str | None]:
    """(refusal, stdin read to judge it): a work item's description, design, acceptance or notes stays within FIELD_LIMIT
    characters, so items hold current state and not history. An edit that shrinks an over-limit field passes; an append
    to notes counts the old notes plus the new text. Decisions and other types are not work items: records are long by design."""
    if command not in ('create', 'new', 'update'):
        return None, None
    texts, stdin = field_texts(rest)
    appended = last_flag_value(rest, APPEND_NOTES) if command == 'update' else None
    if not any(len(text) > FIELD_LIMIT for text in texts.values()) and appended is None:
        return None, stdin
    if command == 'update':
        targets = bd_show(positionals(rest), comments=False)
        new_type = last_flag_value(rest, '-t', '--type')
        targets = [issue for issue in targets if (new_type or issue.get('issue_type')) in WORK_HOLD_TYPES]
    else:
        targets = [{'id': 'the new item', 'issue_type': last_flag_value(rest, '-t', '--type') or 'task'}]
        targets = [issue for issue in targets if issue['issue_type'] in WORK_HOLD_TYPES]
    for issue in targets:
        sizes = {field: len(text) for field, text in texts.items()}
        if appended is not None and 'notes' not in texts:
            old = issue.get('notes') or ''
            sizes['notes'] = len(old) + (1 if old else 0) + len(appended)
        for field, size in sizes.items():
            if size > FIELD_LIMIT and size >= len(issue.get(field) or ''):
                old_text = ' (the board keeps the old text)' if command == 'update' else ''
                return (f"{issue['id']}: {field} is {size} characters, over the {FIELD_LIMIT} limit. Rewrite it shorter as the current state: "
                        f'dated history leaves{old_text}; every rule, gate and criterion still in force stays. '
                        'Long material may go in a doc the item links, where that fits.'), stdin
    return None, stdin


COMMENT_VALUE_FLAGS = ('-a', '--author', '-f', '--file')


def comment_refusal(size: int) -> str | None:
    """Why a comment a session writes is refused: a comment is a one-line event, so it stays within FIELD_LIMIT characters."""
    if size <= FIELD_LIMIT:
        return None
    return (f'comment is {size} characters, over the {FIELD_LIMIT} limit. A comment is a one-line event; '
            'long material belongs in a doc the item links.')


def comment_guard(command: str, rest: list[str]) -> tuple[str | None, str | None]:
    """(refusal, stdin read to judge it) for `bd comments add <id> <text…>` and `-f <file>` (`-` reads stdin): a session's
    comment stays within FIELD_LIMIT characters. The board's own packet passes with PACKET_FLAG."""
    if PACKET_FLAG in rest:
        return None, None
    if command == 'comments' and rest[:1] == ['add']:
        args = rest[1:]
    elif command == 'comment':  # bd's shorthand for `comments add`
        args = rest
    else:
        return None, None
    words, stdin, path, at = [], None, None, 0
    while at < len(args):
        arg = args[at]
        name, equals, value = arg.partition('=')
        if name in COMMENT_VALUE_FLAGS:
            if name in ('-f', '--file'):
                path = value if equals else (args[at + 1] if at + 1 < len(args) else None)
            at += 1 if equals else 2
            continue
        if not arg.startswith('-'):
            words.append(arg)
        at += 1
    text = ' '.join(words[1:])  # the first positional is the item id
    if path == '-' or '--stdin' in args:
        stdin = sys.stdin.read()
        text = stdin
    elif path:
        try:
            text = Path(path).read_text(encoding='utf-8')
        except (OSError, UnicodeDecodeError):
            pass  # bd reports an unreadable file
    return comment_refusal(len(text)), stdin


def passthrough(argv: list[str]) -> int:
    if argv[:1] == ['dolt'] and argv[1:2] in (['start'], ['restart']):
        raise BoardError('board starts the server before every bd call; rerun the failing command with elevated sandbox permissions')
    at = 0
    while at < len(argv) and argv[at].startswith('-'):
        at += 2 if argv[at] in GLOBAL_VALUES else 1
    command, rest = (argv[at], argv[at + 1:]) if at < len(argv) else ('', [])
    flags = {arg.split('=', 1)[0] for arg in rest}
    if command == 'edit':
        print('board: bd edit opens an editor and blocks; edit fields with board bd update --title/--description/--design/--acceptance',
              file=sys.stderr)
        return 2
    if '--readonly' in {arg.split('=', 1)[0] for arg in argv[:at]} | flags:
        print('board: bd --readonly is refused; run the command without it (a server-mode board needs elevated sandbox '
              'permissions, and board starts the server)', file=sys.stderr)
        return 2
    # Raw show output is padded and wraps; it cut most agent reads mid-item. board show renders and budgets it; a plain
    # read by ids runs it (board_read), and JSON, which does not wrap, passes through (r9-q35).
    if (command in ('show', 'view') and not flags & {*SHOW_PASSTHROUGH, '--json'}) \
            or (command == 'comments' and rest[:1] not in (['add'], ['list']) and not flags & {'-h', '--help', '--json'}):
        print(f'board: {SHOW_USAGE}', file=sys.stderr)
        return 2
    if command in ('close', 'done'):  # a change request closes by landing or rejecting (closed means landed)
        ids = positionals(rest)
        crs = [issue['id'] for issue in bd_show(ids, comments=False) if issue.get('issue_type') == CR_TYPE] if ids else []
        if crs:
            print(f"board: {', '.join(crs)} is a change request: board cr land <cr> closes it landed, board cr reject <cr> \"<reason>\" closes it unlanded", file=sys.stderr)
            return 2
    if command in ('list', 'create', 'query', 'update', 'q'):
        meant = question_type(rest)
        if meant != rest:
            print('board: questions are type decision; ran it with type decision', file=sys.stderr)
            rest = meant
    if command == 'update' and any(pair.partition('=')[0] == NO_CODE for pair in flag_values(rest, '--set-metadata')):
        print(f'board: {NO_CODE} marks work that changes no code when the item is created (create --graph node metadata or '
              'create --metadata); an existing item is not marked later (board-core.md Work items)', file=sys.stderr)
        return 2
    if command in ('create', 'new', 'update', 'q') and (refusal := type_refusal(command, rest) or default_look_refusal(rest)):
        print(f'board: {refusal}', file=sys.stderr)
        return 2
    if command == 'dolt' and rest[:2] == ['remote', 'add']:
        print('board: a Dolt remote alone shares nothing; board share shares the board (queues, sync, config)', file=sys.stderr)
    directory = next((argv[i + 1] for i, arg in enumerate(argv[:-1]) if arg in ('-C', '--directory')),
                     next((arg.split('=', 1)[1] for arg in argv if arg.startswith('--directory=')), None))
    ensure_server(Path(directory) if directory else None)
    if shared is not None and derived_actor():
        refusal = queue_guard(command, rest)
        if refusal:
            print(f'board: {refusal}', file=sys.stderr)
            return 2
    refusal, stdin = size_guard(command, rest)
    if not refusal and stdin is None:
        refusal, stdin = comment_guard(command, rest)
    if refusal:
        print(f'board: {refusal}', file=sys.stderr)
        return 2
    if PACKET_FLAG in rest:
        rest = [arg for arg in rest if arg != PACKET_FLAG]
    if stdin is not None:
        sys.stdin = io.StringIO(stdin)  # judged: bd still reads it
    argv = [*argv[:at], *rewritten_create(command, rest)]
    if shared is None and stdin is None:
        os.execvpe('bd', ['bd', *argv], bd_env())
    return run_shared(argv, flags)


def run_shared(argv: list[str], flags: set[str]) -> int:
    """A child, not an exec: board still has to retry a write and start the wait. A person's terminal and --watch keep
    the terminal, without the retry: bd may prompt, and capturing would hide it."""
    if sys.stdin.isatty() or flags & {'--watch', '-w'}:
        return subprocess.run(['bd', *argv], env=bd_env()).returncode
    reads_stdin = argv[:1] == ['batch'] or any(arg in ('-', '--stdin') or arg.endswith('=-') for arg in argv)
    result = bd(*argv, stdin=sys.stdin.read() if reads_stdin else None)
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    # A manual sync says as much about the remote as the wait's own.
    if argv[:1] == ['sync'] or argv[:2] in (['dolt', 'pull'], ['dolt', 'push']):
        if result.returncode == 0:
            shared.succeeded()
            shared.path('pulled').touch()
            shared.check_moved()
        elif result.returncode == 2:
            shared.failed('', 'conflict')
    return result.returncode


def flag_values(rest: list[str], *names: str) -> list[str]:
    """Every value of these flags, `--flag value` and `--flag=value`, comma lists split."""
    values = []
    for at, arg in enumerate(rest):
        name, equals, value = arg.partition('=')
        if name in names:
            value = value if equals else (rest[at + 1] if at + 1 < len(rest) else '')
            values += [part for part in value.split(',') if part]
    return values


def positionals(rest: list[str]) -> list[str]:
    """Arguments before the first flag: the ids `bd update`, `bd label` and `bd dep` start with."""
    return list(itertools.takewhile(lambda arg: not arg.startswith('-'), rest))


def queue_labels(labels: list[str]) -> list[str]:
    return [label for label in labels if label.startswith(QUEUE_PREFIX)]


def queue_guard(command: str, rest: list[str]) -> str | None:
    """Why this `board bd` command is refused on a shared board: a claim across queues, or a move by a session that may
    not. A move is any change to an item's queue: its label, or its parent when it inherits."""
    subcommand = rest[0] if rest else ''
    if command == 'update' and not positionals(rest) and {arg.split('=')[0] for arg in rest} & {'--claim', '--parent', '--set-labels'}:
        return 'name the ids first: board bd update <ids> <flags>'
    if command == 'update' and '--claim' in rest:
        ids = positionals(rest)
        board = Board.load('ids', ids)
        return next(filter(None, (foreign_claim(board, item_id) for item_id in ids if item_id in board.by_id)), None)
    moved = None
    if command == 'label' and subcommand in ('add', 'remove', 'propagate') and queue_labels(rest[1:]):
        moved = 'a queue label'
    elif command == 'update':
        ids = positionals(rest)
        added = flag_values(rest, '--add-label', '--remove-label')
        replaced = flag_values(rest, '--set-labels') if any(arg.split('=')[0] == '--set-labels' for arg in rest) else None
        board = Board.load('ids', ids) if ids and (replaced is not None or '--parent' in {a.split('=')[0] for a in rest}) else None
        if queue_labels(added):
            moved = 'a queue label'
        elif replaced is not None and any(sorted(queue_labels(board.routing(i)[0])) != sorted(queue_labels(replaced)) for i in ids):
            moved = 'a queue label'
        elif board is not None and '--parent' in {a.split('=')[0] for a in rest}:
            target = next(iter(flag_values(rest, '--parent')), None)
            for item_id in ids:
                if not queue_labels(board.routing(item_id)[0]) and board.queues(item_id) != (board.queues(target) if target else []):
                    moved = "an item's parent, which moves it to the parent's queue"
    elif command == 'dep' and subcommand in ('add', 'remove'):
        kinds = flag_values(rest, '--type', '-t')
        pair = positionals(rest[1:])
        file_text = ''.join(Path(path).read_text(encoding='utf-8') for path in flag_values(rest, '--file') if path != '-' and Path(path).is_file())
        if 'parent-child' in file_text:
            moved = "an item's parent"
        elif len(pair) == 2 and (subcommand == 'remove' or 'parent-child' in kinds or 'parent-child' in rest):
            board = Board.load('ids', pair[:1])
            child, target = pair
            if not queue_labels(board.routing(child)[0]) and (subcommand == 'add' or target in board.parents.get(child, [])) \
                    and board.queues(child) != (board.queues(target) if subcommand == 'add' else []):
                moved = "an item's parent, which moves it"
    elif command == 'sql':
        text = ' '.join(rest)
        if re.search(r'\b(insert|update|delete|replace)\b', text, re.IGNORECASE) \
                and re.search(r'\b(labels|dependencies)\b|queue:', text, re.IGNORECASE):
            moved = 'labels or links through SQL'
    elif command == 'batch' and 'parent-child' in rest:
        moved = "an item's parent"
    elif command in ('create', 'new', 'q'):
        mine = QUEUE_PREFIX + (person() or '')
        graph = next(iter(flag_values(rest, '--graph')), None)
        named = queue_labels(flag_values(rest, '-l', '--labels', '--label'))
        if graph:
            nodes = graph_plan(graph).get('nodes') or []
            named += queue_labels([label for node in nodes for label in node.get('labels') or []])
        if any(label != mine for label in named):
            moved = "an item into someone else's queue"
    if moved and not may_move():
        return (f'only lead and solo sessions change {moved}; file a find for another person with board create --for '
                '<person>, and ask your lead to route the rest (board route)')
    return None


def rewritten_create(command: str, rest: list[str], board: Board | None = None) -> list[str]:
    """The one rewrite of `create --parent`: a plain hash id plus a parent link. A dotted child id stops sync when two
    clones create under one parent (child_counters conflict). The link inherits no labels, so the parent's are copied;
    the queue label stays behind, since the child inherits its queue through the link. On a shared board a top-level
    item takes its creator's queue. Returns the command and its arguments; `board` spares a read when it holds the parent."""
    if command not in ('create', 'new', 'q'):
        return [command, *rest] if command else rest
    parent = next(iter(flag_values(rest, '--parent')), None)
    labels = flag_values(rest, '-l', '--labels', '--label')
    kept, skip = [], False
    for arg in rest:
        if skip:
            skip = False
        elif arg == '--parent':
            skip = True
        elif not arg.startswith('--parent='):
            kept.append(arg)
    added: list[str] = []
    if parent:
        if command == 'q':  # bd q takes neither --deps nor a description, which a board's create.require-description wants
            raise BoardError('q has no plain-id form with a parent: board bd create <title> --parent <id> --description <text> --silent')
        if board:  # its snapshot holds every item
            records = [board.by_id[parent]] if parent in board.by_id else []
        else:
            records = bd_show([parent])
        if not records:
            raise BoardError(f'unknown parent {parent}')
        if '--no-inherit-labels' not in kept:
            added = [label for label in records[0].get('labels') or [] if not label.startswith(QUEUE_PREFIX) and label not in labels]
        kept += ['--deps', f"parent-child:{records[0]['id']}"]
    elif shared is not None and person() and not queue_labels(labels):
        graph = next(iter(flag_values(kept, '--graph')), None)
        if graph:
            return [command, *graph_with_queue(kept, graph)]
        added = [QUEUE_PREFIX + person()]
    return [command, *kept, *(['--labels', ','.join(added)] if added else [])]


def graph_plan(path: str) -> dict:
    """The `create --graph` plan; empty when unreadable, which bd reports better when it runs."""
    try:
        plan = json.loads(Path(path).read_text(encoding='utf-8'))
    except (OSError, ValueError):
        return {}
    return plan if isinstance(plan, dict) else {}


def graph_with_queue(args: list[str], path: str) -> list[str]:
    """A plan whose parentless nodes carry the creator's queue, in a temp copy; graph ids are already plain."""
    plan = graph_plan(path)
    if not plan:
        return args
    children = {edge.get('from') for edge in plan.get('edges') or [] if edge.get('type') == 'parent-child'}
    for node in plan.get('nodes') or []:
        if not node.get('parent') and node.get('key') not in children and not queue_labels(node.get('labels') or []):
            node['labels'] = [*(node.get('labels') or []), QUEUE_PREFIX + person()]
    with tempfile.NamedTemporaryFile('w', suffix='.json', encoding='utf-8', delete=False) as handle:
        json.dump(plan, handle)
    atexit.register(os.unlink, handle.name)
    return [handle.name if arg == path else (f'--graph={handle.name}' if arg == f'--graph={path}' else arg) for arg in args]


def missing_sections(text: str, sections=RECORD_SECTIONS) -> list[str]:
    headings = [normalized(match.group(1)) for match in re.finditer(r'^##\s+(.+?)\s*$', text, re.MULTILINE)]
    return [name for name in sections if not any(heading.startswith(normalized(name)) for heading in headings)]


def section_body(text: str, name: str) -> str | None:
    """The body of the record's `## <name>` section (to the next `##` heading), None when it has none."""
    parts = re.split(r'^##\s+(.+?)\s*$', text, flags=re.MULTILINE)
    return next((parts[i + 1].strip() for i in range(1, len(parts) - 1, 2) if normalized(parts[i]).startswith(normalized(name))), None)


def record(board: Board, args) -> None:
    actor = caller()
    issue = held(board, args.id, actor)
    if issue.get('issue_type') != 'decision':
        raise BoardError(f'{args.id}: {issue.get("issue_type")}, not a decision')
    if issue['status'] not in ('open', 'in_progress', 'decided', 'needs_ratification'):
        raise BoardError(f"{args.id}: {issue['status']}; a released record changes through board ruling revise")
    try:
        text = Path(args.file).read_text(encoding='utf-8')
    except (OSError, UnicodeDecodeError) as error:
        raise BoardError(f'cannot read {args.file}: {error}') from None
    # Autopilot's unratified rulings carry how to reverse them (unattended protocol).
    required = RECORD_SECTIONS + (('Reversal',) if args.status == 'needs_ratification' else ())
    missing = missing_sections(text, required)
    if missing:
        raise BoardError(f"{args.file} lacks the record section(s) {', '.join('## ' + name for name in missing)}")
    # An unratified autopilot record waits unheld for the user's ratification; a decided one stays held to release.
    unheld = ['--assignee', ''] if args.status == 'needs_ratification' else []
    bd_checked('update', args.id, '--body-file', args.file, '--status', args.status, *unheld, '--json')
    lint = json.loads(bd_checked('lint', args.id, '--json') or '{}')
    unlinted = [', '.join(result.get('missing') or []) for result in lint.get('results') or [] if result.get('missing')]
    if unlinted:
        raise BoardError(f"{args.id}: recorded ({args.status}), but bd lint reports missing {'; '.join(unlinted)}")
    print(f"recorded {args.id} ({args.status}): {issue.get('title', '')}")


WHOLE_WAIT = '(the whole item waits)'


def block_comment(blocker: str, reason: str, whole: bool = True) -> str:
    """The wait's comment: it names the blocker for board check, and says the whole item waits unless a part was split off."""
    return f'Blocked by {blocker}: {reason}' + (f' {WHOLE_WAIT}' if whole else '')


def block_one(board: Board, item_id: str, blocker: str, reason: str, actor: str) -> tuple[str, bool]:
    """Blocks one whole item with its reason as a comment. (result line, False). The holder's own block hands the item
    back (r21-q144): the hold is freed; a change request keeps its worktree."""
    issue = board.by_id[item_id]
    record = board.by_id.get(blocker, {})
    if issue.get('issue_type') == 'decision' and issue['status'] == 'released' and not planning_wait(record):
        raise BoardError(f'{item_id}: a released ruling waits for planning only (a live decision, a user <date> gate, a design or a spike), '
                         f"not on {blocker} ({record.get('issue_type')} {record.get('status')}); plan the work the ruling changes and block that work on {blocker}")
    edges = board.between(item_id, blocker)
    other = [kind for a, _, kind in edges if kind not in ('relates-to', 'related') and not (kind == 'blocks' and a == item_id)]
    if other:
        raise BoardError(f"{item_id}: already linked to {blocker} by {', '.join(other)}; bd keeps one edge per pair")
    # bd allows one edge per pair: a relates-to link between the two gives way to the wait.
    operations = [f'dep remove {a} {b}' for a, b, kind in edges if kind in ('relates-to', 'related')]
    if not any(kind == 'blocks' for _, _, kind in edges):
        operations.append(f'dep add {item_id} {blocker} blocks')
    holder = issue.get('assignee')
    own = holder == actor and board.is_open(blocker) and issue['status'] == 'in_progress'
    if operations:
        bd_checked('batch', '-m', f'board block {item_id} --on {blocker}', '--json', stdin='\n'.join(operations) + '\n')
    # The comment names the wait for board check (unnamed waits read comments too); an append to a field would
    # rewrite it and lose a concurrent edit.
    comment(item_id, block_comment(blocker, reason))
    result = f'blocked {item_id} on {blocker}'
    if own:
        bd_checked('unclaim', item_id, '--reason', f'board block: {actor} handed the item back, waiting on {blocker}.')
        result += '; handed back to the queue'
    return result, False


def block_items(board: Board, ids: list[str], blocker: str, reason: str, actor: str) -> tuple[list[str], list[str]]:
    """Blocks each item, one result line each; (returned from review, failed)."""
    returned, failed = [], []
    for item_id in ids:
        try:
            if item_id == blocker:
                raise BoardError(f'{item_id}: cannot block an item on itself')
            require_open(board, [item_id])
            result, back = block_one(board, item_id, blocker, reason, actor)
            print(result)
            returned += [item_id] if back else []
        except BoardError as error:
            failed.append(item_id)
            print(f'{item_id}: not blocked: {error}', file=sys.stderr)
    return returned, failed


def block(board: Board, args) -> int:
    actor = caller()
    if args.blocker not in board.by_id:
        raise BoardError(f'unknown blocker {args.blocker}')
    refuse_long_comment(block_comment(args.blocker, args.reason))
    _, failed = block_items(board, args.ids, args.blocker, args.reason, actor)
    return 1 if failed else 0


def revise(board: Board, args) -> None:
    caller()
    old = board.by_id.get(args.old)
    if old is None or old.get('issue_type') != 'decision':
        raise BoardError(f'{args.old}: unknown or not a decision')
    if old['status'] in ('open', 'in_progress'):
        raise BoardError(f"{args.old}: {old['status']}, not yet a ruling; amend the question instead")
    parent = args.parent or board.parent.get(args.old)
    labels = [label for value in args.labels for label in value.split(',') if label] if args.labels \
        else [label for label in old.get('labels') or [] if label.startswith('topic:')]
    command = ['create', '--type', 'decision', '--title', args.title, '--body-file', args.body_file,
               '--priority', str(args.priority if args.priority is not None else old.get('priority', 2)),
               '--deps', f'{REVISES}:{args.old}']
    command += ['--parent', parent] if parent else []
    command += ['--labels', ','.join(labels)] if labels else []
    command += ['--metadata', json.dumps({REVISES_RULE: args.partial})] if args.partial is not None else []
    command += ['--external-ref', args.external_ref] if args.external_ref else []
    created = json.loads(bd_checked(*rewritten_create(command[0], command[1:], board), '--json') or '{}')
    new = created.get('id') if isinstance(created, dict) else None
    if not new:
        raise BoardError(f'bd create returned no id: {created!r}')
    print(new)


def release(board: Board, args) -> int:
    """Releases the decided rulings, supersedes the records they revise, then closes the questions they answer.
    Resumable: a ruling already released and a question already closed are done; a failed revise supersede of an
    already released ruling is retried (its revise link stays until it succeeds)."""
    actor = caller()
    rulings = require_open(board, args.ids)
    problems = []
    for issue in rulings:
        if issue.get('issue_type') != 'decision':
            problems.append(f"{issue['id']}: not a decision")
        elif issue['status'] not in ('decided', 'released'):
            problems.append(f"{issue['id']}: {issue['status']}, not decided")
        blocking = [b for b in board.unsettled_blockers(issue['id']) if b not in args.ids]
        if blocking and issue['status'] == 'decided':
            named = ', '.join(f"{b} ({board.by_id.get(b, {}).get('status', 'not found')})" for b in blocking)
            problems.append(f"{issue['id']}: waits on {named}")
        # A decided record a live question revises is about to be replaced: releasing it puts it in force first
        # (a board ruling revise opened outside a round; Record closes the replaced record).
        live = [other for other in board.revised_by(issue['id']) if board.is_open(other) and other not in args.ids]
        if live and issue['status'] == 'decided':
            problems.append(f"{issue['id']}: revised by {', '.join(live)}, not closed or released with it; close the "
                            'revision (board ruling supersede), or release them together')
    closes = []
    for question, records in args.closes:
        issue = board.by_id.get(question)
        if issue is None:
            problems.append(f'{question}: unknown')
        elif issue['status'] == 'closed':
            print(f'{question}: already closed')
            continue
        elif issue.get('issue_type') != 'decision' or issue['status'] not in ('open', 'in_progress'):
            problems.append(f"{question}: {issue['status']} {issue.get('issue_type')}, not an open question")
        elif issue.get('assignee') and session_actor(issue['assignee']) != session_actor(actor):
            problems.append(f"{question}: held by {issue['assignee']}; hand it off before closing it")
        unknown = [record for record in records if record not in args.ids]
        if unknown:
            problems.append(f"{question}: answered by {', '.join(unknown)}, which this call does not release")
        closes.append((question, records))
    if problems:
        raise BoardError('release refused:\n  ' + '\n  '.join(problems))

    pending = [issue for issue in rulings if issue['status'] == 'decided']
    if pending:
        lint = json.loads(bd_checked('lint', *(issue['id'] for issue in pending), '--json') or '{}')
        unlinted = [f"{result['id']}: missing {', '.join(result.get('missing') or [])}"
                    for result in lint.get('results') or [] if result.get('missing')]
        if unlinted:
            raise BoardError('release refused, record text fails bd lint (write the record first):\n  ' + '\n  '.join(unlinted))
        # A released ruling keeps blocking the items it changes; planning closes it and unblocks them.
        operations = [f"update {issue['id']} status=released assignee=\"\"" for issue in pending]
        bd_checked('batch', '-m', f"board ruling release {' '.join(issue['id'] for issue in pending)}", '--json',
                   stdin='\n'.join(operations) + '\n')
    returned, failed = [], []
    for issue in rulings:
        print(f"{'released' if issue in pending else 'already released'} {issue['id']}: {issue.get('title', '')}")
        metadata = issue.get('metadata') if isinstance(issue.get('metadata'), dict) else {}
        for old in board.revises(issue['id']):
            back, lost = supersede_chain(board, old, issue['id'], metadata.get(REVISES_RULE), actor, {issue['id']})
            returned += back
            failed += lost
    if returned:
        print(f"returned from review: {', '.join(returned)}")
    left = close_answered(board, closes, set(args.ids))
    return 1 if failed or left else 0


def close_answered(board: Board, closes: list[tuple[str, list[str]]], released: set[str]) -> list[str]:
    """Closes each answered question once every unsettled blocker is a ruling of this release or a question closed
    before it here (dependency order); forces only past those and released rulings. Returns the questions left open."""
    closed: set[str] = set()
    pending = list(closes)
    while pending:
        progress = False
        for question, records in list(pending):
            blockers = board.open_blockers(question)
            if any(b not in released and b not in closed for b in board.unsettled_blockers(question)):
                continue
            pending.remove((question, records))
            result = bd('close', question, '--reason', f"Answered by released {', '.join(records)}",
                        *(['--force'] if blockers else []))
            if result.returncode != 0:
                print(f'{question}: not closed: {(result.stderr or result.stdout).strip()}', file=sys.stderr)
                continue
            closed.add(question)
            progress = True
            print(f"closed {question}: answered by released {', '.join(records)}")
        if not progress:
            break
    for question, _ in pending:
        others = [b for b in board.unsettled_blockers(question) if b not in released and b not in closed]
        print(f"{question}: left open, blocked by {', '.join(others) or 'a question not closed'}", file=sys.stderr)
    return [question for question, _ in closes if question not in closed]


def rule_of(issue: dict) -> str | None:
    metadata = issue.get('metadata') if isinstance(issue.get('metadata'), dict) else {}
    return metadata.get(REVISES_RULE)


def supersede_chain(board: Board, old: str, new: str, rule: str | None, actor: str, seen: set[str]) -> tuple[list[str], list[str]]:
    """supersede_pair, then follows the chain: a record replaced whole that itself revises another leaves that one to
    `new` too, with the replaced record's own rule, through unreleased records to the first released one.
    (returned from review, failed records)."""
    if old in seen:
        return [], []
    seen.add(old)
    try:
        returned, failed = supersede_pair(board, old, new, rule, actor)
    except BoardError as error:
        print(f"{old}: not superseded by {new}: {error}; finish with board ruling supersede {old} --with {new}"
              + (f' --partial {shlex.quote(rule)}' if rule is not None else ''), file=sys.stderr)
        return [], [old]
    if rule is not None:
        return returned, failed
    for earlier in board.revises(old):
        more_returned, more_failed = supersede_chain(board, earlier, new, rule_of(board.by_id[old]), actor, seen)
        returned += more_returned
        failed += more_failed
    return returned, failed


def carry_revisions(board: Board, old: str, new: str) -> list[str]:
    """`dep` operations that move the revisions `old` still has pending to `new` (which replaces it whole), and the
    rule's metadata write first: a rerun after a partial failure repeats the same write. Returns the operations."""
    targets = [t for t in board.revises(old) if t != new]
    if not targets:
        return []
    own = [t for t in board.revises(new) if t != old]
    rule, new_rule = rule_of(board.by_id[old]), rule_of(board.by_id[new])
    if own and (set(own) != set(targets) or rule != new_rule):
        raise BoardError(f"{new} already revises {', '.join(own)} and {old} revises {', '.join(targets)}; bd keeps one "
                         'revision rule per record: finish the revisions one record at a time')
    if rule is not None and rule != new_rule:
        bd_checked('update', new, '--set-metadata', f'{REVISES_RULE}={rule}', '--json')
    operations = []
    for target in targets:
        operations.append(f'dep remove {old} {target}')
        if target not in own:
            operations += [f'dep remove {a} {b}' for a, b, kind in board.between(new, target) if kind != 'parent-child']
            operations.append(f'dep add {new} {target} {REVISES}')
    return operations


def supersede_pair(board: Board, old: str, new: str, rule: str | None, actor: str, carry: bool = False) -> tuple[list[str], list[str]]:
    """Supersedes old by new, wholly or (rule not None) one rule; (returned from review, failed items). `carry`: a
    whole replacement takes over the revisions the old record still has pending."""
    # bd allows one edge per pair: drop an existing link between the two records (a revise link included) first.
    operations = [f'dep remove {a} {b}' for a, b, kind in board.between(old, new) if kind != 'parent-child']
    carried = carry_revisions(board, old, new) if carry and rule is None else []
    if rule is not None:
        operations.append(f'dep add {old} {new} supersedes')
    operations += carried
    if operations:
        bd_checked('batch', '-m', f'board ruling supersede {old} --with {new}', '--json', stdin='\n'.join(operations) + '\n')
    if rule is not None:
        if rule:
            comment(old, f'board ruling supersede: rule "{rule}" superseded by {new}.')
        print(f"{old}: one rule{f' ({rule})' if rule else ''} superseded by {new}")
        return [], []
    # The new record restates the whole rule: the old record's open items wait for its planning.
    items = sorted(i for i in board.related.get(old, set()) | set(board.dependents.get(old, []))
                   if i != new and board.is_open(i)
                   and all(kind in ('relates-to', 'related') for _, _, kind in board.between(i, new)))
    returned, failed = block_items(board, items, new, f'supersedes {old}; replan against it', actor)
    bd_checked('supersede', old, '--with', new)
    print(f"superseded {old} by {new}; blocked {', '.join(i for i in items if i not in failed) or 'none'}"
          + (f"; revision of {', '.join(board.revises(old))} now pending on {new}" if carried else ''))
    return returned, failed


def supersede(board: Board, args) -> int:
    actor = caller()
    if args.old not in board.by_id:
        raise BoardError(f'unknown {args.old}')
    if args.partial is None:
        require_open(board, [args.new])  # a full replacement blocks items on the new record until it is planned
    elif args.new not in board.by_id:
        raise BoardError(f'unknown {args.new}')  # a closed record still supersedes one rule: the edge is the record
    returned, failed = supersede_pair(board, args.old, args.new, args.partial, actor, carry=True)
    if returned:
        print(f"returned from review: {', '.join(returned)}")
    return 1 if failed else 0


def normalized_remote(url: str) -> str:
    """The `git+ssh://` form bd's git remotes need; scp and https forms of one repository become one url. `git+...` and
    Dolt's own schemes stay as written, a local path becomes `git+file://`."""
    url = url.strip()
    if url.startswith('/'):
        return f'git+file://{url}'
    if url.startswith('file://'):
        return f'git+{url}'
    if url.startswith('ssh://'):
        return f'git+{url}'
    https = re.fullmatch(r'https?://(?:[^@/]+@)?([^/]+)/(.+?)(?:\.git)?/?', url)
    if https:
        return f'git+ssh://git@{https.group(1)}/{https.group(2)}.git'
    scp = re.fullmatch(r'(?:([^@/:]+)@)?([^/:]+):(?!//)(.+)', url)
    if scp:
        return f"git+ssh://{scp.group(1) or 'git'}@{scp.group(2)}/{scp.group(3)}"
    return url


def project_remote() -> str:
    result = subprocess.run(['git', 'remote', 'get-url', 'origin'], capture_output=True, text=True)
    if result.returncode != 0 or not result.stdout.strip():
        raise BoardError("this project's repository has no origin remote: name the url")
    return result.stdout.strip()


def ask_person() -> str:
    """The person, asked for when unset at a terminal. Their one choice of level is the git command itself."""
    who = person()
    if who:
        return who
    if not sys.stdin.isatty():
        raise BoardError(PERSON_HELP)
    who = input('Your name for queue labels (queue:<name>), set in global git config: ').strip()
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', who):
        raise BoardError(f'{who!r} does not fit a label; {PERSON_HELP}')
    subprocess.run(['git', 'config', '--global', 'agents.person', who], check=True)
    return who


def set_config(pairs) -> None:
    for key, value in pairs:
        bd_checked('config', 'set', key, value)


def send_first(remote: str, url: str, known: bool) -> None:
    """Sync, or the first push a sync can't do (it pulls first, and the remote has nothing yet)."""
    result = bd('sync', '--remote', remote)
    if result.returncode == 0:
        return
    if known:
        raise BoardError(f'sync failed: {last_line(result.stderr + result.stdout)}')
    pushed = bd('dolt', 'push', '--remote', remote)
    output = pushed.stderr + pushed.stdout
    if 'has no branches' in output:
        raise BoardError(f"{url} is a completely empty repository and can't take a first push: commit something to it first, then rerun")
    if pushed.returncode != 0:
        raise BoardError(f'first push failed: {last_line(output)}')


def readable_remote(url: str) -> list[str] | None:
    """The repository's refs before anything is sent to it; refuses one that can't be read or can't take a first push."""
    refs, error = remote_refs(url)
    if refs is None and url.startswith('git+'):
        raise BoardError(f'cannot read {url}: {error}')
    if refs == []:
        raise BoardError(f"{url} is a completely empty repository and can't take a first push: commit something to it first, then rerun")
    return refs


def default_prefix(root: Path) -> str:
    """The project's name: its origin repository's, else its folder's (a worktree folder is often named after a branch)."""
    origin = subprocess.run(['git', 'remote', 'get-url', 'origin'], capture_output=True, text=True).stdout.strip()
    name = re.sub(r'\.git$', '', origin.rstrip('/').rsplit('/', 1)[-1].rsplit(':', 1)[-1]) if origin else root.name
    return re.sub(r'[^a-z0-9]+', '-', name.lower()).strip('-') or 'board'


def current_setting(key: str) -> str:
    """bd's value for a setting, '' when unset; a config.yaml key reads as bd's default when the file leaves it out."""
    found = json.loads(bd_checked('config', 'get', '--json', key) or '{}')
    return str(found.get('value') or '') if isinstance(found, dict) else ''


def hiding_excludes() -> list[str]:
    """The .git/info/exclude lines matching tracked project files: init's patterns (1.3 adds `*.db`) would hide new ones."""
    exclude = git_exclude()
    if not exclude.is_file():
        return []
    found = []
    for pattern in exclude.read_text(encoding='utf-8').splitlines():
        if not pattern.strip() or pattern.startswith(('#', '!')):
            continue
        tracked = subprocess.run(['git', 'ls-files', '-c', '-i', '-x', pattern], capture_output=True, text=True).stdout.split('\n')
        tracked = [path for path in tracked if path]
        if tracked:
            more = f' and {len(tracked) - 5} more' if len(tracked) > 5 else ''
            found.append(f"{exclude}: `{pattern}` matches tracked project files ({', '.join(tracked[:5])}{more}); "
                         'remove the line unless new files like them should stay hidden')
    return found


KEPT_EMBEDDED = '.beads.before-server-'  # an embedded board's folder, kept beside the server board made from it


def to_server(beads: Path) -> None:
    """`board setup --server` on an embedded board: bd's backup into a new server board, restored whole (Dolt history
    included), the old folder kept beside it. A failure removes what it made and puts the old folder back."""
    root, exclude = beads.parent, git_exclude()
    database = json.loads((beads / 'metadata.json').read_text(encoding='utf-8')).get('dolt_database') or default_prefix(root)
    before = {json.loads(row)['id'] for row in bd_checked('export').splitlines() if row.strip()}
    saved = exclude.read_bytes() if exclude.exists() else None
    kept = root / f"{KEPT_EMBEDDED}{utcnow().strftime('%Y%m%d-%H%M%S')}"
    with tempfile.TemporaryDirectory(prefix='board-to-server-') as store:
        bd_checked('backup', 'init', store)
        try:
            bd_checked('backup', 'sync')
        except BaseException:
            bd('backup', 'remove')  # the embedded board keeps no registration of a backup that never came to be
            raise
        beads.rename(kept)
        try:
            bd_checked('init', '--server', '--stealth', '--prefix', database, '--skip-hooks', '--skip-agents', stdin='')
            bd_checked('backup', 'restore', '--force', store)
            bd_checked('backup', 'remove')  # the restore registers the temporary backup for future syncs
            lost = before - {json.loads(row)['id'] for row in bd_checked('export').splitlines() if row.strip()}
            if lost:
                raise BoardError(f"the server board lacks {', '.join(sorted(lost))}; nothing converted")
        except BaseException:
            stop_server(root)
            shutil.rmtree(beads, ignore_errors=True)
            kept.rename(beads)
            if saved is not None:
                exclude.write_bytes(saved)
            bd('backup', 'remove')
            raise
    pattern = f'/{KEPT_EMBEDDED}*/'
    if pattern not in (exclude.read_text(encoding='utf-8') if exclude.exists() else '').splitlines():
        with exclude.open('a', encoding='utf-8') as handle:
            handle.write(f"\n# board setup --server: an embedded board's old folder\n{pattern}\n")
    print(f'converted the board to server mode, {len(before)} items; the embedded board is kept in {kept}')


def project_pairs(args) -> list[tuple[str, str]]:
    """The project settings board setup was given, validated before anything changes (q223, q238): the target is a local
    branch, look and view are of their kinds, setup and checks name a command (a path in it must exist)."""
    pairs = []
    for name in SETTINGS:
        value = getattr(args, name, None)
        if value is None:
            continue
        value = value.strip()
        if not value:
            raise BoardError(f'--{name} is empty')
        if name == 'target' and (git(Path.cwd(), 'check-ref-format', '--branch', value, check=False).returncode != 0
                                 or git(Path.cwd(), 'rev-parse', '--verify', '-q', f'refs/heads/{value}', check=False).returncode != 0):
            raise BoardError(f'--target {value!r} is not a local branch of this repository')
        if name in ('look', 'view') and value not in {'look': LOOKS, 'view': VIEWS}[name]:
            raise BoardError(f"--{name} {value!r} is not one of {', '.join({'look': LOOKS, 'view': VIEWS}[name])}")
        if name in ('setup', 'checks'):
            first = shlex.split(value)[0] if value else ''
            if '/' in first and not (Path(first).is_absolute() and Path(first).exists() or (Path.cwd() / first).exists()):
                raise BoardError(f'--{name}: {first} does not exist (settings name project scripts)')
        pairs.append((SETTINGS[name], value))
    return pairs


def own_value_lines(name: str, default: str) -> list[str]:
    """After a switch of the project's `look` or `view` (r10-q52): the open change requests that keep their own value, each with
    the line of its text that gives the reason (the first one naming the setting), for the person to clear the ones they
    disagree with. Best effort: the setting is set either way."""
    try:
        crs = [i for i in Board.load('status').issues if i.get('issue_type') == CR_TYPE and meta(i).get(name)]
    except (BoardError, ValueError, subprocess.SubprocessError):
        return [f'(the change requests keeping their own {name} could not be listed: board bd list --json)']
    if not crs:
        return []
    word = re.compile(rf'\b{name}\b', re.IGNORECASE)

    def reason(issue: dict) -> str:
        text = '\n'.join(str(issue.get(field) or '') for field in ('description', 'design', 'notes'))
        found = next((line.strip() for line in re.split(r'(?<=[.!?])\s+|\n', text) if word.search(line)), None)
        return found[:160] if found else 'no reason in its text'

    return [f'  {len(crs)} open change request(s) keep their own {name}; clear one you disagree with: board bd update <id> --unset-metadata {name}',
            *(f"    {i['id']}  {meta(i)[name]}{' (equals the new default)' if meta(i)[name] == default else ''}: {reason(i)}" for i in sorted(crs, key=lambda i: i['id']))]


def setup(args) -> int:
    """Safe to repeat (r38-q218, server default): no board → `bd init --server --stealth` (--embedded opts out), then the
    settings. An existing board is never re-created: `--server` converts an embedded one in place (`to_server`), a missing
    setting is set and a differing one reset, each printed with its old and new value. A shared board also gets the shared
    settings, and its travelling ones reach the others by sync."""
    toplevel = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True, text=True)
    if toplevel.returncode != 0:
        raise BoardError('run board setup inside the project repository')
    os.chdir(toplevel.stdout.strip())
    wanted = project_pairs(args)
    beads = beads_dir()
    if beads is None:
        prefix = args.prefix or default_prefix(Path.cwd())
        if not re.fullmatch(r'[a-z0-9][a-z0-9-]*', prefix):
            raise BoardError(f'{prefix!r} does not fit an id prefix: lowercase letters, digits and dashes')
        bd_checked('init', *([] if args.embedded else ['--server']), '--stealth', '--prefix', prefix, '--skip-hooks', '--skip-agents', stdin='')
        beads = Path.cwd() / '.beads'
        print(f"created the board {prefix} ({'embedded' if args.embedded else 'server'} mode) in {beads}")
    else:
        mode = json.loads((beads / 'metadata.json').read_text(encoding='utf-8')).get('dolt_mode') or 'embedded'
        if args.embedded and mode != 'embedded':
            raise BoardError(f'this board is {mode}; --embedded applies only to a new board, and board setup never converts one back')
        if args.prefix:
            raise BoardError('this project already has a board, which keeps its prefix: drop --prefix')
        os.chdir(beads.parent)
        if args.server and mode == 'embedded':
            to_server(beads)
        else:
            print(f'this project already has a board ({mode} mode); applying the current settings')
    server = json.loads((beads / 'metadata.json').read_text(encoding='utf-8')).get('dolt_mode') == 'server'
    changed = []
    for key, value in (*LOCAL_CONFIG, *TRAVELLING_CONFIG, *(SERVER_CONFIG if server else ()), *(SHARED_CONFIG if read_mark(beads) else ()), *wanted):
        old = current_setting(key)
        if old != value:
            bd_checked('config', 'set', key, value)
            changed.append(key)
            print(f"{key}: {old or '(unset)'} -> {value}", flush=True)  # printed as applied: a later failure leaves it said
            if key in (SETTINGS['look'], SETTINGS['view']):
                for line in own_value_lines(key.rsplit('.', 1)[1], value):
                    print(line, flush=True)
    if changed:
        committed = bd('dolt', 'commit', '-m', 'board setup')  # in server mode an uncommitted status.custom stops the first sync
        output = committed.stdout + committed.stderr
        if committed.returncode != 0 and 'nothing to commit' not in output.lower():
            raise BoardError(f'the settings are set but not committed: {last_line(output)}; rerun board setup')
    else:
        print('settings up to date')
    for warning in hiding_excludes():
        print(warning)
    return 0


def share(args) -> int:
    """Safe to repeat. Only the first push asks: without --yes it says what goes out and changes nothing. The sharer's
    labelling runs once per board, marked in the database: a second person's share must not take the items other people
    left unrouted."""
    beads = beads_dir()
    if beads is None:
        raise BoardError('no board here: board setup creates one to share, or board join joins one')
    if json.loads((beads / 'metadata.json').read_text(encoding='utf-8')).get('dolt_mode') != 'server':
        raise BoardError('a shared board needs server mode, and this board is embedded: board setup --server converts it in place '
                         '(pause the sessions writing to it first)')
    os.chdir(beads.parent)
    remotes = bd_remotes()
    if remotes:
        remote = 'origin' if 'origin' in remotes else sorted(remotes)[0]
        url = remotes[remote]
        if args.url and normalized_remote(args.url) != url:
            raise BoardError(f'this board already syncs with {url} ({remote}); moving it: board move <url> (beads-setup.md#history)')
    else:
        remote, url = 'origin', normalized_remote(args.url or project_remote())
    known = remote in remotes and remote_branches(remote) > 0  # the remote already holds this board
    if not known:
        readable_remote(url)
        if not args.yes:
            print(f'board share sends the whole board to {url}: every item, comment and history entry, git emails included. '
                  f"Nothing has changed yet. To share, rerun: board share {args.url + ' ' if args.url else ''}--yes")
            return 1
    who = ask_person()
    if remote not in remotes:
        bd_checked('dolt', 'remote', 'add', remote, url, '--allow-git-origin')
    try:
        send_first(remote, url, known)
    except BoardError:
        if remote not in remotes:  # an unshared board keeps no remote it never pushed to
            bd('dolt', 'remote', 'remove', remote)
        raise
    write_mark(beads, remote)
    set_config((*LOCAL_CONFIG, *SERVER_CONFIG, *SHARED_CONFIG, *TRAVELLING_CONFIG))
    labelled = 0
    if not config_value(SHARED_BY):
        # Closed items too: an open child takes its queue from a closed parent.
        issues = [json.loads(row) for row in bd_checked('export').splitlines() if row.strip()]
        top = [issue['id'] for issue in issues if issue.get('_type', 'issue') == 'issue' and not queue_labels(issue.get('labels') or [])
               and not any(dep.get('type') == 'parent-child' for dep in issue.get('dependencies') or [])]
        for start in range(0, len(top), 200):
            bd_checked('label', 'add', *top[start:start + 200], QUEUE_PREFIX + who)
        labelled = len(top)
        bd_checked('config', 'set', SHARED_BY, who)
    bd('dolt', 'commit', '-m', f'board shared by {who}')  # nothing to commit on a repeat
    send_first(remote, url, True)
    print(f'shared with {url}; {labelled} top-level items labelled {QUEUE_PREFIX}{who}. Others join with: board join {url}')
    return 0


def git_exclude(root: Path | None = None) -> Path:
    path = subprocess.run(['git', 'rev-parse', '--path-format=absolute', '--git-path', 'info/exclude'], capture_output=True, text=True, cwd=root)
    return Path(path.stdout.strip())


def stop_server(root: Path) -> None:
    if (root / '.beads' / 'dolt-server.pid').exists():
        subprocess.run(['bd', 'dolt', 'stop'], cwd=root, capture_output=True, env=bd_env(), stdin=subprocess.DEVNULL)


def fresh_join(url: str) -> None:
    """Clones the board at url into this folder's new .beads. A failure removes only what it made (the new .beads, the
    gate lock, init's exclude lines) and stops the server it started, so a rerun works."""
    root, exclude = Path.cwd(), git_exclude()
    before = {path.name for path in root.iterdir() if path.name.startswith('.beads')}
    saved = exclude.read_bytes() if exclude.exists() else None
    try:
        # The prefix only names the local database: items keep the board's own, which comes with the clone.
        database = re.sub(r'[^a-z0-9]+', '_', Path(url.rstrip('/')).stem.lower()).strip('_') or 'board'
        bd_checked('init', '--server', '--stealth', '--remote', url, '--prefix', database, '--skip-hooks', '--skip-agents', stdin='')
        if not remote_branches('origin'):  # bd starts an empty board when the repository holds none
            raise BoardError(f"no board data at {url}: name the board's address: board join <url>")
        moved = config_value(MOVED)
        if moved:
            raise BoardError(f'the board at {url} moved to {moved}: board join {moved}')
        set_config((*LOCAL_CONFIG, *SERVER_CONFIG, *SHARED_CONFIG))
        bd_checked('dolt', 'commit', '-m', 'board config')
        write_mark(root / '.beads', 'origin')
    except BaseException:
        stop_server(root)
        for path in root.iterdir():
            if path.name.startswith('.beads') and path.name not in before:
                shutil.rmtree(path) if path.is_dir() and not path.is_symlink() else path.unlink()
        if saved is None:
            exclude.unlink(missing_ok=True)
        else:
            exclude.write_bytes(saved)
        raise


def join(args) -> int:
    """Safe to repeat: an existing board stays as it is, unless it carries a moved note: then it rejoins."""
    toplevel = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True, text=True)
    if toplevel.returncode != 0:
        raise BoardError('run board join inside the project repository')
    os.chdir(toplevel.stdout.strip())
    beads = beads_dir()
    if beads is not None:
        mark = read_mark(beads)
        sharing = Shared(beads, mark['remote']) if mark else None
        if sharing:
            sharing.check_moved()
        if sharing is None or not sharing.moved():
            print(f"this project already has a board ({'shared' if mark else 'not shared: board share shares it'}); nothing to do")
        else:
            rejoin(sharing, normalized_remote(args.url) if args.url else sharing.moved())
    else:
        ask_person()
        url = normalized_remote(args.url or project_remote())
        fresh_join(url)
        print(f'joined {url}. Items go to {QUEUE_PREFIX}{person()}; a lead routes work to you (board route).')
    role = subprocess.run(['git', 'config', '--get', 'beads.role'], capture_output=True, text=True)
    if not role.stdout.strip():
        subprocess.run(['git', 'config', 'beads.role', 'maintainer'], check=True)
    return 0


KEPT = '.beads.before-move-'  # a rejoined board's old folder, kept beside the new one


def rejoin(sharing: Shared, url: str) -> None:
    """A moved board: keep the old folder as a copy, join the new board, list what the new one lacks. A failed join puts
    the old folder back."""
    root, beads = sharing.root, sharing.beads
    wait = sharing.path('wait.lock').open('w')  # a running wait finishes its send first, and no new one starts
    try:
        fcntl.flock(wait, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print('board: waiting for the pending sync to finish', file=sys.stderr)
        fcntl.flock(wait, fcntl.LOCK_EX)
    with wait:
        old = [json.loads(row) for row in bd_checked('export').splitlines() if row.strip()]
        stop_server(root)
        kept = root / f"{KEPT}{utcnow().strftime('%Y%m%d-%H%M%S')}"
        beads.rename(kept)
        try:
            fresh_join(url)
        except BaseException:
            kept.rename(beads)
            raise
    exclude = git_exclude()
    pattern = f'/{KEPT}*/'
    if pattern not in (exclude.read_text(encoding='utf-8') if exclude.exists() else '').splitlines():
        with exclude.open('a', encoding='utf-8') as handle:
            handle.write(f'\n# board join: a moved board\'s old folder\n{pattern}\n')
    (kept / 'board-export.jsonl').write_text(''.join(json.dumps(row) + '\n' for row in old), encoding='utf-8')
    present = {json.loads(row)['id'] for row in bd_checked('export').splitlines() if row.strip()}
    missing = [row for row in old if row.get('_type', 'issue') == 'issue' and row['id'] not in present]
    print(f'joined {url}; the board before the move is kept in {kept}.')
    if missing:
        path = kept / 'missing.jsonl'
        path.write_text(''.join(json.dumps(row) + '\n' for row in missing), encoding='utf-8')
        print(f'{len(missing)} items the new board lacks (written after the move): ' + ', '.join(row['id'] for row in missing))
        print(f'Bring them over: board bd import {path}')
    else:
        print('the new board holds every item of the old one')


def move(args) -> int:
    """board move <url>: the note on the old board, then flatten, switch the remote and push (beads-setup.md#history). The
    note goes out before the flatten and is removed from the local copy first: it travels with the data and would say the
    new board moved too."""
    if shared is None:
        raise BoardError('board move moves a shared board; this one is not shared')
    if not may_move():
        raise BoardError("only lead and solo sessions, or a person's terminal, move a board")
    if shared.moved():
        raise BoardError(moved_refusal(shared.moved()))
    url = normalized_remote(args.url)
    os.chdir(shared.root)
    old = bd_remotes().get(shared.remote)
    if old == url:
        raise BoardError(f'this board already syncs with {url}')
    refs = readable_remote(url)
    if refs and 'refs/dolt/data' in refs:
        raise BoardError(f'{url} already holds board data: name a fresh repository')
    wait = shared.path('wait.lock').open('w')
    try:
        fcntl.flock(wait, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print('board: waiting for the pending sync to finish', file=sys.stderr)
        fcntl.flock(wait, fcntl.LOCK_EX)
    with wait:
        bd('dolt', 'commit', '-m', 'before the move')  # nothing to commit when the wait just sent
        sent = bd('sync', '--remote', shared.remote)
        if sent.returncode != 0:
            raise BoardError(f'the sync before the move failed, nothing moved: {last_line(sent.stderr + sent.stdout)}')
        bd_checked('config', 'set', MOVED, url)
        bd_checked('dolt', 'commit', '-m', f'board moved to {url}')
        sent = bd('sync', '--remote', shared.remote)
        if sent.returncode != 0:
            bd('config', 'unset', MOVED)
            bd('dolt', 'commit', '-m', 'board move abandoned')
            raise BoardError(f'sending the moved note failed, nothing moved: {last_line(sent.stderr + sent.stdout)}')
        bd_checked('config', 'unset', MOVED)
        bd_checked('dolt', 'commit', '-m', 'board moved: the note stays on the old board')
        bd_checked('flatten', '--force')
        bd_checked('dolt', 'remote', 'remove', shared.remote)
        bd_checked('dolt', 'remote', 'add', shared.remote, url, '--allow-git-origin')
        pushed = bd('dolt', 'push', '--remote', shared.remote)
        if pushed.returncode != 0:
            raise BoardError(f'the old board says it moved to {url}, but the push there failed: {last_line(pushed.stderr + pushed.stdout)}. '
                             f'Fix the access, then: board bd dolt push --remote {shared.remote}')
        for name in ('pulled', 'unsent'):
            (shared.dir / name).unlink(missing_ok=True)
        shared.update_state(moved=None, kind=None, failures=0, detail=None, last_failure=None)
    print(f'moved to {url}. The old repository keeps its data and tells the others to run board join {url}. '
          f'Once everyone rejoined, delete it: git push {git_url(old or "<old url>")} --delete refs/dolt/data refs/heads/__dolt_remote_info__')
    return 0


PERSON_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]*')


def mover(board: Board | None, args, command: str) -> list[dict]:
    """The checks route and send share: a shared board, a mover, a person, known ids (`board` holds the named items; None
    checks the rest before the read)."""
    if shared is None:
        raise BoardError(f'board {command}: this board is not shared, so no queues')
    if not may_move():
        raise BoardError(f"only lead and solo sessions, or a person's terminal, {command} items; ask your lead")
    if not PERSON_NAME.fullmatch(args.person):
        raise BoardError(f'{args.person!r} does not fit a label')
    if board is None:
        return []
    found = {issue['id']: issue for issue in board.issues}
    missing = [item_id for item_id in args.ids if item_id not in found]
    if missing:
        raise BoardError(f"unknown: {', '.join(missing)}")
    return [found[item_id] for item_id in args.ids]


def route(board: Board, args) -> int:
    """Into a person's queue, replacing the queue label; an item filed for someone also leaves the inbox: its `for:` and
    its `user` hold go. Other `user` holds stay: they mark a wait on a person's action."""
    target = QUEUE_PREFIX + args.person
    for issue in mover(board, args, 'route'):
        labels = issue.get('labels') or []
        filed = [label for label in labels if label.startswith(FOR_PREFIX)]
        flags = [flag for label in queue_labels(labels) + filed if label != target for flag in ('--remove-label', label)]
        flags += ['--add-label', target] if target not in labels else []
        flags += ['--assignee', ''] if filed and issue.get('assignee') == USER_HOLD else []
        if flags:
            bd_checked('update', issue['id'], *flags, '--json')
        print(f"routed {issue['id']} to {args.person}'s queue" + (' (out of the inbox)' if filed else ''))
    return 0


def send(board: Board, args) -> int:
    """Into a person's inbox: `for:<person>`, no queue label and no `user` hold, so the item is unrouted until their lead
    routes it. Only a top-level item: one with a parent would still take the parent's queue."""
    target = FOR_PREFIX + args.person
    issues = mover(board, args, 'send')
    for issue in issues:
        inherited = sorted({queue for parent in board.parents.get(issue['id'], []) for queue in board.queues(parent)})
        if inherited:
            raise BoardError(f"{issue['id']} takes its queue from its parent ({', '.join(inherited)}), so it can't sit in an inbox: "
                             f"board route {args.person} {issue['id']}, or remove the parent link first")
    for issue in issues:
        labels = issue.get('labels') or []
        flags = [flag for label in labels if (label.startswith(QUEUE_PREFIX) or label.startswith(FOR_PREFIX)) and label != target
                 for flag in ('--remove-label', label)]
        flags += ['--add-label', target] if target not in labels else []
        flags += ['--assignee', ''] if issue.get('assignee') == USER_HOLD else []
        # Every send stamps the time, a pass-on and a repeat included: the inbox shows how long an item waited there (r38-q217).
        bd_checked('update', issue['id'], *flags, '--set-metadata', f"{SENT_AT}={utcnow().strftime('%Y-%m-%dT%H:%M:%SZ')}", '--json')
        print(f"sent {issue['id']} to {args.person}'s inbox")
    return 0


def create_for(argv: list[str]) -> int:
    """`board create --for <person> <bd create args>`: a find for another person, top-level, in your queue and held for
    you (`user`), labelled `for:<person>`; your lead checks it with you before `board send`."""
    targets = flag_values(argv, '--for')
    rest, skip = [], False
    for arg in argv:
        if skip:
            skip = False
        elif arg == '--for':
            skip = True
        elif not arg.startswith('--for='):
            rest.append(arg)
    if refusal := type_refusal('create', rest):
        raise BoardError(refusal)
    if shared is None:
        raise BoardError('board create --for files for another person on a shared board; this board is not shared')
    if len(targets) != 1 or not PERSON_NAME.fullmatch(targets[0]):
        raise BoardError('name one person: board create --for <person> <title> [bd create flags]')
    if flag_values(rest, '--parent') or '--parent' in rest or flag_values(rest, '--graph'):
        raise BoardError('board create --for files a top-level item: drop --parent (a child takes its parent\'s queue)')
    if any(label.startswith((QUEUE_PREFIX, FOR_PREFIX)) for label in flag_values(rest, '-l', '--labels', '--label')) \
            or flag_values(rest, '-a', '--assignee'):
        raise BoardError('board create --for sets the queue, for: and the hold itself: drop those flags')
    me = person()
    if not me:
        raise BoardError(PERSON_HELP)
    refusal, stdin = size_guard('create', rest)
    if refusal:
        raise BoardError(refusal)
    result = bd('create', *rest, '--labels', f'{FOR_PREFIX}{targets[0]},{QUEUE_PREFIX}{me}', '--assignee', USER_HOLD, stdin=stdin)
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    return result.returncode


