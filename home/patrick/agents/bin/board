import subprocess
import sys
import tempfile
import time
import tomllib
from datetime import date, datetime, timedelta, timezone
from pathlib import Path
from collections import deque
from collections.abc import Iterable, Iterator
from fractions import Fraction
from functools import cached_property
from typing import NamedTuple

HOLDS_LEGEND = 'holds a/b: a stops at a milestone, b counts everything downstream'
IDLE_HOURS = 1  # holds without activity (holder's tool call, else item update) for longer are hinted as idle
WORKER_CAP = 3  # workers a session targets unless registered with its own (activate --workers); Codex thread limits lower it
WORKER_ACTIVE_MINUTES = 15  # a running worker with a tool call this recently counts as active
CODEX_SYSTEM_CONFIG = Path('/etc/codex/config.toml')  # Codex's system layer, under $CODEX_HOME/config.toml
STALE_HOURS = 1  # a held work item without an update (fields, notes, comments) for longer is flagged stale
DEEP_REVIEW = 'deep_review'  # item metadata a review sets to the failure path it escalates to deep-review; board show prints it
FORCED_BY, FORCED_REASON = 'forced_hold_by', 'forced_hold'  # item metadata: who held it past the cap with --force, and why
FIELD_LIMIT = 2000  # characters a work item's description, design, acceptance or notes, and a comment a session writes, may hold (refused above)
WORKER_KINDS = ('implement', 'review')  # kinds workers take; an agent's pulls narrow them
ROWS = 50  # rows per view section unless --limit (0: all)
READ_BUDGET = 35_000  # characters per command output; Codex cuts a call's output above ~40,000 from the middle
PREVIEW = 600  # characters a cut section still prints
SHOWN_COMMENTS = 5  # newest comments a plain board show prints, each cut at FIELD_LIMIT
SESSION_HOURS = 24  # position lists sessions of this project active or registered this recently (plus any holding items)
PULLS = ('plan', 'implement', 'review')  # an item's kind (a `kind:` label) is no pull: no rule reads it
KINDS = (*PULLS, 'question', 'accept', 'milestone', 'refresh')  # refresh: review pulls take it (session_kinds)
WORK_TYPE = 'task'  # an item and a task are one bd type; a `kind:` label (KIND_LABELS) says what sort, and no rule reads it
KIND_LABEL, KIND_LABELS = 'kind:', ('bug', 'feature', 'design', 'cleanup')
# An in-force ruling waits only for planning (r21-q139): a live decision (an open question, or an unreleased revision
# record) or a human gate. Any other wait is work or a container: refused by `board wait`,
# ignored when claiming (q140).
LIVE_DECISIONS = ('open', 'decided')


def planning_wait(record: dict) -> bool:
    kind = record.get('issue_type')
    return is_human_gate(record) or (kind == 'decision' and record.get('status') in LIVE_DECISIONS)


def is_human_gate(record: dict) -> bool:
    """A step only a person takes: a gate bd made with `await_type` human (`board gate create`); `for:<person>` names whose on a shared board."""
    return record.get('issue_type') == 'gate' and record.get('await_type') == 'human'


# Rank of a kind within one claim-order tier at equal priority (r22-q177).
CLAIM_RANK = {kind: at for at, kind in enumerate(('plan', 'review', 'refresh', 'accept', 'question', 'implement', 'milestone'))}
FINISHING = ('review', 'refresh', 'accept')
# Kinds a bare `board claim` takes for a role's authority (with the user: lead, solo; unattended: autopilot); the session's
# registered pulls (plan, implement, review) come on top, for every role.
ROLE_KINDS = {'lead': ('question', 'accept'), 'agent': (), 'solo': ('question', 'accept'),
              'autopilot': ('question',)}
# Kinds each role handles, by bare claim or by id; `board position` counts sessions from these.
# A ready milestone is accepted with the user: claimed by id only, never by autopilot.
ROLE_HANDLES = {'lead': ('question', 'accept', 'milestone'), 'agent': (),
                'solo': ('question', 'accept', 'milestone'), 'autopilot': ('question',)}
TEXT_FIELDS = ('title', 'description', 'design', 'acceptance_criteria', 'notes', 'close_reason')
SHOW_FIELDS = TEXT_FIELDS[1:]
# Fields `board show --field` accepts besides those on the shown items (a read of few items would otherwise hide
# the ones its items leave unset; bd omits an empty `labels` and a root's `parent`).
ITEM_FIELDS = {*TEXT_FIELDS, 'comments', 'assignee', 'metadata', 'closed_at', 'started_at', 'external_ref', 'source_system', 'spec_id',
               'lease_expires_at', 'heartbeat_at', 'await_type', 'labels', 'parent', 'holds', 'holdsAll'}
# A decision record's `##` sections (board-coordination.md#rulings). bd lint accepts the words anywhere in the text,
# so board checks the headings itself.
RECORD_SECTIONS = ('Question', 'Alternatives Considered', 'Decision', 'Rationale', 'Rule owner')
# A pending revision is a `tracks` edge from the new decision to the record it revises: bd 1.3.1 rejects custom
# dependency types, `tracks` never blocks, no other board use exists, and `board ruling supersede` replaces the pair's edge, so the
# link lives exactly until release. The partial rule's name sits in the new record's metadata.
REVISES = 'tracks'
REVISES_RULE = 'board.revises_rule'
REGISTRY = Path(__file__).resolve().parent / 'session'
SYNC_SECONDS = float(os.environ.get('AGENT_BOARD_SYNC_SECONDS') or 60)  # the send window and the pull interval; tests shorten it
PULL_TIMEOUT = 5  # a pull a command waits for gives up after this
SYNC_TIMEOUT = 300  # a sync running longer counts as stuck
SYNC_ATTEMPTS = 5  # tries per window, SYNC_RETRY_SECONDS apart; then the next board command starts a new wait
SYNC_RETRY_SECONDS = 5
SYNC_REPORT_AFTER = 3  # consecutive failures before every command reports them; single ones recover by themselves
WRITE_RETRIES = 4
# bd raises this on a write that meets a sync's merge. Retire the retry when a bd release stops raising it: rerun the soak (bin/test-shared-board.py).
# On a bd upgrade recheck beads issues 4796 and 7839 and PR 7849.
# `Merge conflict detected` is a different error, a stopped merge, and never retried.
WRITE_RETRY_ERROR = 'foreign key conflicts'
STORE_WARN_BYTES = 1 << 30
STORE_CHECK_SECONDS = 3600
QUEUE_PREFIX = 'queue:'
ATTENDED_ROLES = ('lead', 'solo')  # the `attended` who-word: roles that change an item's queue, take an Accept and reject; not autopilot
DECIDING_ROLES = ('lead', 'solo', 'autopilot')  # a deciding session (role/SKILL.md)
FOR_PREFIX = 'for:'  # an item filed for a person: unclaimable, held for its creator's check, then in that person's inbox
# The mark that makes a board shared, in .beads: local, so an unshared board's check costs no bd call, and written only after
# share's first push or join's clone, so a stray Dolt remote shares nothing.
MARK_FILE = 'board-shared.json'
SHARED_BY = 'custom.board.shared'  # travels with the database: the sharer labelled the existing items
MOVED = 'custom.board.moved'  # travels with the database: the board moved to this url (board relocate); its clones rejoin there
# The board settings, owned here (board setup applies them; share and join add the shared ones). In the database: they travel
# with a shared board's sync. min_hash_length is a real key bd warns about as unrecognized: top-level ids of 5+ characters.
STATUS_CUSTOM = 'decided:wip,in_force:active,in_review:wip,passed:wip'  # the statuses beyond bd's open, closed and deferred
TRAVELLING_CONFIG = (('status.custom', STATUS_CUSTOM),
                     ('types.custom', 'change-request'), ('min_hash_length', '5'))
# In .beads/config.yaml: they do not travel, so each clone sets them. no-git-ops stays true as `init --stealth` sets it: bd 1.3
# keys its stealth handling on it (with false, `bd doctor --fix` writes a project .gitignore).
LOCAL_CONFIG = (('create.require-description', 'true'), ('validation.on-close', 'error'),
                ('lint.sections.decision', 'Question,Decision,Rule owner'), ('events-journal', 'true'),
                ('events-journal-retain-days', '30'), ('no-git-ops', 'true'))
SERVER_CONFIG = (('dolt.auto-start', 'false'),)  # a server-mode board: board starts a stopped server itself (ensure_server)
SHARED_CONFIG = (('dolt.auto-commit', 'batch'),)  # a shared board: one commit per sync
SENT_AT = 'sent_at'  # item metadata: when board send last put the item in an inbox
CR_TYPE = 'change-request'
PASSED = 'passed'  # a change request whose review passed and whose landing is pending; waiting for the user's Accept is passed with look before


class BoardError(Exception):
    """A refusal or failure; `next` holds the steps that clear it, in the views' step shape ({action, command|text|paths})."""

    def __init__(self, message: str = '', next: list[dict] | None = None):
        super().__init__(message)
        self.next = list(next or [])


class PairMoved(BoardError):
    """A refusal because the pair to land moved: `part` is 'branch' or 'base'."""

    def __init__(self, message: str, next: list[dict], part: str):
        super().__init__(message, next)
        self.part = part


STEP_WORDS = {'wait': 'it waits', 'merge': 'a deciding session merges it with the user', 'owner': 'its owner ends it',
              'ask-user': 'ask the user to commit or move those edits'}


def step_text(step: dict) -> str:
    return step.get('command') or step.get('text') or STEP_WORDS.get(step['action'], step['action'])


def report_error(error: BoardError) -> None:
    sys.stdout.flush()  # a piped listing must not land after, and bury, the reason
    print(f'board: {error}', file=sys.stderr)
    for step in error.next:
        print(f'next: {step_text(step)}', file=sys.stderr)


def ids_of(records: list[dict]) -> set[str]:
    return {record['id'] for record in records}


def utcnow() -> datetime:
    return datetime.now(timezone.utc)


_actors: dict[tuple, str | None] = {}


def derived_actor() -> str | None:
    """BEADS_ACTOR (bd-guard sets it for Claude subagents), else the session's actor."""
    actor = os.environ.get('BEADS_ACTOR', '').strip()
    if actor:
        return actor
    key = tuple(os.environ.get(name, '') for name in ('CODEX_SESSION_ID', 'CODEX_THREAD_ID', 'CLAUDE_CODE_SESSION_ID'))
    if key not in _actors:
        result = subprocess.run(['bash', str(REGISTRY), 'actor'], capture_output=True, text=True)
        _actors[key] = result.stdout.strip() if result.returncode == 0 else None
    return _actors[key]


def bd_actor() -> str:
    """The actor bd records for this caller: BEADS_ACTOR (the session's actor), else git's user.name, else $USER, as bd resolves it."""
    named = derived_actor() or subprocess.run(['git', 'config', 'user.name'], capture_output=True, text=True).stdout.strip()
    return named or os.environ.get('USER', '')


def bd_env() -> dict[str, str]:
    """BD_NO_REMOTE_ADOPT: bd may adopt git origin as a sync remote on its own; only `board share` pushes a board."""
    actor = derived_actor()
    return {**os.environ, 'BD_NO_REMOTE_ADOPT': '1', **({'BEADS_ACTOR': actor} if actor else {})}


_server_checked = False


def ensure_server(start: Path | None = None) -> None:
    """Start a stopped server of a server-mode board; bd's own auto-start is off."""
    global _server_checked
    if _server_checked:
        return
    _server_checked = True
    beads = beads_dir(start)
    if beads is None:
        return
    root = beads.parent
    port = None
    try:
        if json.loads((beads / 'metadata.json').read_text(encoding='utf-8')).get('dolt_mode') != 'server':
            return
        port = int((beads / 'dolt-server.port').read_text(encoding='utf-8').strip())
        socket.create_connection(('127.0.0.1', port), timeout=1).close()
        return
    except (OSError, ValueError):
        pass
    if os.environ.get('CODEX_SANDBOX'):
        raise BoardError('the board server is unreachable from this sandbox: rerun with elevated sandbox permissions')
    holder = server_holding(beads)
    if holder is not None:  # a slow server is not a dead one: a second start fails on the lock after bd rewrote the port file
        raise BoardError(f'the board server (pid {holder[0]}, port {holder[1]}) holds the database but did not answer on port {port}: '
                         'retry; if it persists, tell the user')
    subprocess.run(['bd', 'dolt', 'start'], cwd=root, capture_output=True, env=bd_env())


def server_holding(beads: Path) -> tuple[int, str] | None:
    """(pid, port) of the running sql-server Dolt records as holding the board's database, else None. A crash or reboot
    can leave the record behind with its pid reused, so the pid must still run a sql-server."""
    try:
        pid, port = (beads / 'dolt' / '.dolt' / 'sql-server.info').read_text(encoding='utf-8').split(':')[:2]
        args = subprocess.run([shutil.which('ps') or '/bin/ps', '-o', 'args=', '-p', str(int(pid))], capture_output=True, text=True).stdout
    except (OSError, ValueError):
        return None
    return (int(pid), port) if 'sql-server' in args else None


BD_GLOBALS: list[str] = []  # bd's global flags (-C, --actor, --db …) of the `board bd` call being run, for the reads and writes it makes


def bd(*args: str, stdin: str | None = None, server: bool = True) -> subprocess.CompletedProcess:
    if server:
        ensure_server()
    for retry in range(1, WRITE_RETRIES + 2):
        result = subprocess.run(['bd', *BD_GLOBALS, *args], input=stdin, capture_output=True, text=True, env=bd_env())
        if result.returncode == 0 or shared is None or retry > WRITE_RETRIES or WRITE_RETRY_ERROR not in result.stdout + result.stderr:
            return result
        print(f'board: bd {args[0]} met a sync ({WRITE_RETRY_ERROR}); retry {retry} of {WRITE_RETRIES}', file=sys.stderr)
        time.sleep(1)
    raise AssertionError('unreachable')


def bd_message(result: subprocess.CompletedProcess) -> str:
    """What bd said when it failed: its JSON `error` when it printed one, else the text."""
    text = (result.stderr or result.stdout).strip()
    for part in (result.stderr, result.stdout):
        try:
            error = json.loads(part).get('error')
        except (ValueError, AttributeError, TypeError):
            continue
        if isinstance(error, str) and error.strip():
            return error.strip()
    return text


def bd_checked(*args: str, stdin: str | None = None) -> str:
    result = bd(*args, stdin=stdin)
    if result.returncode != 0:
        raise BoardError(f"`bd {' '.join(args)}` failed: {bd_message(result)}")
    return result.stdout


# The board model: one table of states per type, one of transitions, and `move`, the one function that writes a status.
# docs/board/model.md embeds both tables (`model_tables`) and a test keeps them equal; the prose there gives the meaning and the reasons.
CR_GROUP, WORK_GROUP, ITEM_GROUP = 'change request', 'task', 'item'
GROUP_OF = {CR_TYPE: CR_GROUP, WORK_TYPE: WORK_GROUP,
            'decision': 'decision', 'milestone': 'milestone', 'gate': 'gate'}  # a work-type record inside a change request is an item (group_of)
STATES = {CR_GROUP: ('open', 'in_review', 'passed', 'deferred', 'closed'), WORK_GROUP: ('open', 'deferred', 'closed'), ITEM_GROUP: ('open', 'closed'),
          'decision': ('open', 'decided', 'in_force', 'deferred', 'closed'), 'milestone': ('open', 'closed'), 'gate': ('open', 'closed')}


# `who` and `guards` are what `move` enforces, in the vocabulary of WHO_WORDS and GUARDS: who is a list of alternatives, one of
# which must hold; an alternative is parts joined by '+', all of which must hold. What a command checks before it reaches `move`
# (its pull, the worker cap, the check pair, the review) stays with the command and is not in the table.
WHO_WORDS = {'anyone': 'anyone', 'agent': 'an agent session', 'user': 'the user', 'deciding': 'a deciding session (lead, solo or autopilot)',
             'holder': "the holder's session (or anyone while it is unheld)", 'gone': "once the holder's session is gone, or the user agrees (take or unclaim --agreed)",
             'non-author': "not the actor that handed it over or that actor's session itself, unless the user agrees (claim --agreed)", 'planner': 'a session pulling plan',
             'deferrer': "the deferrer's side (the deferring session or a deciding session; a user's deferral, or one without a deferrer, is a lead or solo session's or the user's)",
             'holding': 'the session holding it', 'unheld': 'while it is unheld',
             'attended': "a lead or solo session (not autopilot: it leaves these moves, the user's to make or hard to undo, to the user; unattended protocol)"}


class Move(NamedTuple):
    """One row of the transition table. `held`: the holder the write expects ('-' none, 'you' the caller's session, '*' any);
    `holds`: the holder after ('-' none, 'you' the caller, '=' unchanged)."""
    command: str
    group: str
    frm: tuple[str, ...]
    to: str  # '=' keeps the status
    held: str
    holds: str
    who: tuple[str, ...]
    guards: tuple[str, ...] = ()
    outcomes: tuple[str, ...] = ()  # a closing row: the outcomes it records (the first is the default), in metadata `outcome`


_ANY_CR = ('open', 'in_review', 'passed')
FREE_HOLD = ('holder', 'user', 'deciding+gone')  # freeing a hold: its own session, the user, or a deciding session once the holder is gone
DEFER = ('planner+holder', 'deciding', 'user')  # setting aside: a session pulling plan (its own deferrals), a deciding session, the user
# An item has no hold of its own: its change request's holder decides who writes it (item_write_refusal). A change request nobody holds is
# claimed first; only the user, a deciding session or (items of an unheld request only) a planner write its items without that. A wait is also
# written by a deciding session whoever holds.
ITEM_WRITE = ('holding', 'user', 'deciding+unheld', 'deciding+gone', 'planner+unheld')
ITEM_WAIT = (*ITEM_WRITE, 'deciding')
DECIDING_CLOSE = ('deciding+holder', 'deciding+gone', 'user')
ATTENDED_CLOSE = ('attended+holder', 'attended+gone', 'user')  # a milestone is accepted with the user: not autopilot
MOVES = (
    Move('claim', CR_GROUP, ('open',), '=', '-', 'you', ('agent',)),
    Move('claim', CR_GROUP, ('in_review',), '=', '-', 'you', ('agent+non-author',)),
    Move('claim', CR_GROUP, ('passed',), '=', '-', 'you', ('agent',)),
    Move('take', CR_GROUP, _ANY_CR, '=', '*', 'you', ('agent+holder+non-author', 'agent+deciding+gone+non-author')),
    Move('unclaim', CR_GROUP, _ANY_CR, '=', '*', '-', FREE_HOLD),
    Move('handover', CR_GROUP, ('open',), 'in_review', 'you', '-', ('agent',), ('items-closed', 'not-open-for-review')),
    Move('handover --no-agent-review', CR_GROUP, ('open',), 'passed', 'you', '-', ('agent',), ('items-closed', 'look-before', 'not-open-for-review')),
    Move('handover (reviewer passes)', CR_GROUP, ('in_review',), 'passed', 'you', '-', ('agent',), ('items-closed',)),
    Move('send to review', CR_GROUP, ('passed',), 'in_review', '*', '-', ('holding', 'deciding', 'user')),
    Move('return', CR_GROUP, ('in_review',), 'open', '*', '-', ('agent+holder', 'deciding', 'user')),
    Move('return', CR_GROUP, ('passed',), 'open', '*', '-', ('deciding', 'user')),  # a change request waiting for its Accept is the Accept's to return
    Move('return --ruling', CR_GROUP, ('in_review',), 'open', 'you', '-', ('planner',)),
    Move('landing', CR_GROUP, _ANY_CR, 'closed', '*', '-', ('anyone',), (), ('landed',)),  # the target already holds the tip: the command checked before the fast-forward
    Move('cr reject', CR_GROUP, (*_ANY_CR, 'deferred'), 'closed', '*', '-', ('attended', 'user'), ('reason', 'items-closed', 'no-waiters'), ('dropped',)),
    Move('base rejected', CR_GROUP, _ANY_CR, 'open', '*', '-', ('anyone',)),
    Move('defer', CR_GROUP, ('open',), 'deferred', '*', '-', DEFER),
    Move('undefer', CR_GROUP, ('deferred',), 'open', '-', '-', ('deferrer',)),
    Move('claim', WORK_GROUP, ('open',), '=', '-', 'you', ('agent',)),
    Move('take', WORK_GROUP, ('open',), '=', '*', 'you', ('agent+holder', 'agent+deciding+gone')),
    Move('unclaim', WORK_GROUP, ('open',), '=', '*', '-', FREE_HOLD),
    Move('close', WORK_GROUP, ('open',), 'closed', '*', '-', FREE_HOLD, ('reason', 'no-waiters'), ('done', 'dropped')),
    Move('reopen', WORK_GROUP, ('closed',), 'open', '*', '-', FREE_HOLD, ('no-dropped-target',)),  # reopen takes close's authority; unheld, 'holder' admits anyone
    Move('close', ITEM_GROUP, ('open',), 'closed', '*', '-', ITEM_WRITE, ('reason', 'no-waiters'), ('done', 'dropped')),
    Move('reopen', ITEM_GROUP, ('closed',), 'open', '*', '-', ITEM_WRITE, ('no-dropped-target',)),
    Move('defer', WORK_GROUP, ('open',), 'deferred', '*', '-', DEFER),
    Move('undefer', WORK_GROUP, ('deferred',), 'open', '-', '-', ('deferrer',)),
    Move('defer', 'decision', ('open',), 'deferred', '*', '-', DEFER),
    Move('undefer', 'decision', ('deferred',), 'open', '-', '-', ('deferrer',)),
    Move('claim', 'decision', ('open', 'decided'), '=', '-', 'you', ('agent',)),  # which sessions a bare claim gives a question is the pull (ROLE_KINDS)
    Move('claim', 'decision', ('in_force',), '=', '-', 'you', ('planner',)),
    Move('take', 'decision', ('open', 'decided', 'in_force'), '=', '*', 'you', ('agent+holder', 'agent+deciding+gone')),
    Move('unclaim', 'decision', ('open', 'decided', 'in_force'), '=', '*', '-', FREE_HOLD),
    Move('ruling record', 'decision', ('open', 'decided'), 'decided', 'you', '=', ('holder',)),
    Move('ruling record --unratified', 'decision', ('open', 'decided', 'in_force'), 'in_force', 'you', '=', ('holder',)),
    Move('ruling release', 'decision', ('decided',), 'in_force', '*', '-', ('attended', 'user')),
    Move('supersede', 'decision', ('open', 'decided', 'in_force', 'closed'), 'closed', '*', '-', ('deciding', 'user'), (), ('superseded',)),
    Move('close', 'decision', ('open', 'decided'), 'closed', '*', '-', DECIDING_CLOSE, ('reason',), ('dropped', 'superseded')),  # superseded: another ruling answered it
    Move('close', 'decision', ('in_force',), 'closed', '*', '-', ('planner+holding', *DECIDING_CLOSE), ('reason',), ('planned',)),  # planning closes the ruling it claimed
    Move('claim', 'milestone', ('open',), '=', '-', 'you', ('attended',)),
    Move('take', 'milestone', ('open',), '=', '*', 'you', ('attended+holder', 'attended+gone')),
    Move('unclaim', 'milestone', ('open',), '=', '*', '-', FREE_HOLD),
    Move('close', 'milestone', ('open',), 'closed', '*', '-', ATTENDED_CLOSE, ('reason',), ('accepted',)),
    Move('reopen', 'milestone', ('closed',), 'open', '*', '-', ATTENDED_CLOSE),
    Move('reopen', 'decision', ('closed',), 'open', '*', '-', DECIDING_CLOSE, ('not-superseded', 'no-dropped-target')),
    Move('close', 'gate', ('open',), 'closed', '*', '-', ('attended', 'user'), ('reason',), ('resolved',)),
    Move('reopen', 'gate', ('closed',), 'open', '*', '-', ('attended', 'user')),
)


def who_text(row: 'Move') -> str:
    return ' or '.join(' and '.join(WHO_WORDS[part] for part in alternative.split('+')) for alternative in row.who)


def states_table() -> str:
    """Statuses and outcomes by type, from STATES and the closing rows of MOVES: `agents board help` and model.md print it."""
    outcomes = {group: list(dict.fromkeys(o for m in MOVES if m.group == group for o in m.outcomes)) for group in STATES}
    return '\n'.join(['| Type | Statuses | Outcomes when closed |', '|---|---|---|',
                      *(f"| {group} | {', '.join(statuses)} | {', '.join(outcomes[group]) or '-'} |" for group, statuses in STATES.items())])


# The MOVES commands a verb's help prints; a verb not named here prints the rows named like it (`return` also prints `return --ruling`).
VERB_MOVES = {'cr land': (('landing',), None), 'cr request-review': (('send to review',), None), 'gate resolve': (('close',), 'gate'),
              'ruling supersede': (('supersede',), None)}


def verb_rules(verb: str) -> str:
    """The rows of the transition table that a verb performs, for its --help: types, from and to, holder, who, guards and outcomes."""
    names, group = VERB_MOVES.get(verb, ((verb,), None))
    rows = [m for m in MOVES if any(m.command == n or m.command.startswith(f'{n} ') for n in names) and group in (None, m.group)]
    if not rows:
        return ''
    lines = [f"  {m.command}: {m.group} {', '.join(m.frm)} -> {m.to if m.to != '=' else 'same status'}; holder {m.held} -> {m.holds}; who: {who_text(m)}"
             + (f"; guards: {', '.join(m.guards)}" if m.guards else '') + (f"; outcomes: {', '.join(m.outcomes)}" if m.outcomes else '') for m in rows]
    return "rules (the board's transition table; holder: - none, you the caller, * any, = unchanged):\n" + '\n'.join(lines) + '\n\n'


def model_tables() -> str:
    """The tables docs/board/model.md embeds, as markdown: statuses and outcomes by type, the transitions, and what each `who` word means."""
    states = states_table()
    moves = ['| Command | Type | From | To | Held before | Held after | Who | Guards | Outcomes |', '|---|---|---|---|---|---|---|---|---|',
             *(f"| {m.command} | {m.group} | {', '.join(m.frm)} | {m.to} | {m.held} | {m.holds} | {' / '.join(m.who)} | {', '.join(m.guards) or '-'} | {', '.join(m.outcomes) or '-'} |" for m in MOVES)]
    words = ['| Who word | Means |', '|---|---|', *(f'| {word} | {meaning} |' for word, meaning in WHO_WORDS.items())]
    return '\n\n'.join([states, '\n'.join(moves), '\n'.join(words)])


def group_of(board: 'Board | None', issue: dict) -> str | None:
    """The table group of a record: a task inside a change request is an item (no holder, no deferral), outside one a task."""
    group = GROUP_OF.get(issue.get('issue_type'))
    return ITEM_GROUP if group == WORK_GROUP and board is not None and board.cr_of(issue['id']) else group


def refuse_held(issue: dict, row: Move, command: str, actor: str | None) -> None:
    """The row's held rule: '-' needs the record unheld, 'you' needs the caller's session holding it."""
    current = issue.get('assignee') or ''
    if row.held == '-' and current:
        raise BoardError(f"{issue['id']}: {command} needs it unheld; held by {current}")
    if row.held == 'you' and (not current or session_actor(current) != session_actor(actor or caller())):
        raise BoardError(f"{issue['id']}: {command} needs your session to hold it; held by {current or 'nobody'}")


def authority_part(part: str, issue: dict, actor: str | None, board: 'Board', agreed: frozenset = frozenset()) -> bool:
    """One part of a row's `who`, for the caller (`actor`: None is a person's terminal). A worker holds and acts under its session but is
    no deciding session; the registry is read only when a part needs it."""
    current = issue.get('assignee') or ''
    if part == 'anyone':
        return True
    if part == 'user':
        return actor is None
    if actor is None:
        return part == 'deferrer'  # a person undefers anything; the remaining parts name sessions
    session = session_actor(actor)
    if part == 'agent':
        return True
    if part == 'holder':
        return not current or session_actor(current) == session
    if part == 'holding':
        return bool(current) and session_actor(current) == session
    if part == 'unheld':
        return not current
    if part == 'non-author':
        return self_review_refusal(issue, actor, 'non-author' in agreed) is None
    if part == 'gone':
        return bool(current) and ('gone' in agreed or holder_gone(board, board.registry(), current))
    entry = board.registry().get(session)
    if part == 'deciding':
        return actor == session and bool(entry) and entry.get('role') in DECIDING_ROLES
    if part == 'attended':
        return actor == session and bool(entry) and entry.get('role') in ATTENDED_ROLES
    if part == 'planner':
        return bool(entry) and 'plan' in session_kinds(entry)
    if part == 'deferrer':
        by = meta(issue).get(DEFERRED_BY) or 'user'  # a deferral that records no deferrer (migrated, or by raw bd) is the user's
        if by == 'user':
            return authority_part('attended', issue, actor, board)  # the user's deferral is not autopilot's to undo (762y5)
        return by == session or authority_part('deciding', issue, actor, board)
    raise BoardError(f'internal: unknown who part {part}')


def authority_refusal(issue: dict, row: 'Move', command: str, actor: str | None, board: 'Board | None', agreed: frozenset = frozenset()) -> str | None:
    """Why the caller may not make this move (the row's `who`), naming who may and, for a hold, whose it is."""
    if row.who == ('anyone',):
        return None
    deck = board if board is not None else Board([])
    if any(all(authority_part(part, issue, actor, deck, agreed) for part in alternative.split('+')) for alternative in row.who):
        return None
    allowed = who_text(row)
    holder = issue.get('assignee')
    return f"{issue['id']}: {command} is for {allowed}" + (f"; it is held by {holder}" if holder else '')


def table_refusal(board: Board, issue: dict, command: str) -> str | None:
    """The Authority check of `move` for the caller, read before a command writes anything else (the table's Who column is the one owner)."""
    row = next((m for m in MOVES if m.command == command and m.group == group_of(board, issue) and issue['status'] in m.frm), None)
    return authority_refusal(issue, row, command, derived_actor(), board) if row else None  # no row: `move` refuses it


def item_write_refusal(board: 'Board | None', issue: dict, command: str, actor: str | None) -> str | None:
    """Why the caller may not write this item: the Authority check of `move`, read on the change request that holds it (ITEM_WRITE, ITEM_WAIT
    for a wait or its removal). A change request nobody holds is claimed first, unless the user or a deciding session writes."""
    if board is not None:
        board.read_whole(board.parents.get(issue['id'], []))  # a stub parent would pass for an unheld one, or for no change request
    if board is None or group_of(board, issue) != ITEM_GROUP:
        return None
    cr_id = board.cr_of(issue['id'])
    if not cr_id or cr_id not in board.by_id:
        return None
    cr = board.by_id[cr_id]
    row = Move(command, ITEM_GROUP, ('open',), '=', '*', '=', ITEM_WAIT if command in ('wait', 'unlink') else ITEM_WRITE)
    refusal = authority_refusal(cr, row, command, actor, board)
    if refusal is None:
        return None
    message = (f"{issue['id']}: " + refusal.removeprefix(f'{cr_id}: ')).replace('; it is held by', f'; its change request {cr_id} is held by')
    return message if cr.get('assignee') else f'{message}; nobody holds its change request {cr_id}: claim it first (agents board claim {cr_id})'


def write_fields(board: 'Board', ids: list[str], flags: list[str], command: str = 'update', actor: str | None = None) -> None:
    """The one write of record fields (title, priority, labels, the long fields, settings and metadata given with them): the hold rule on every
    item of a change request (item_write_refusal, as `move` reads it), then one bd update. Status and holder: move; parents and links: write_edges;
    the board's own bookkeeping metadata: put_meta. bin/test-agent-configs.py pins the writers."""
    who = (actor if actor is not None else derived_actor()) or None
    for item_id in ids:
        if refusal := item_write_refusal(board, board.by_id[item_id], command, who):
            raise BoardError(refusal)
    bd_checked('update', *ids, *flags, '--json')


CLOSE_REASON_MIN = 20  # bd refuses a shorter close reason


GUARDS = {
    'reason': lambda issue, board, reason, outcome, together: None if reason and reason.strip() else 'a reason is required',
    'items-closed': lambda issue, board, reason, outcome, together: board and open_item_refusal(board, issue),
    'look-before': lambda issue, board, reason, outcome, together: None if board is None or cr_look(board, issue) == 'before' else 'only a look before change request passes without an agent review',
    'not-open-for-review': lambda issue, board, reason, outcome, together: f'it is open for your review (tip {opened_tip(issue)[:12]}): end the review first' if opened_tip(issue) else None,
    'no-waiters': lambda issue, board, reason, outcome, together: board and outcome == 'dropped' and dropped_waits_refusal(board, issue['id'], together),
    'no-dropped-target': lambda issue, board, reason, outcome, together: board and (found := dropped_targets(board, issue['id'])) and (
        f"it waits on {', '.join(found)}, closed dropped, which never delivers; unlink it first ({'; '.join(dep_fix(issue['id'], b) for b in found)}) or wait on the record that keeps the work"),
    'not-superseded': lambda issue, board, reason, outcome, together: f'it is superseded by {", ".join(found)}: record a revision to put it back in force' if board and (found := superseding(board, issue['id'])) else None,
}


def move(issue: dict, command: str, *, to: str | None = None, actor: str | None = None, fields: dict | None = None,
         reason: str | None = None, force: bool = False, via: str | None = None, check: bool = True,
         board: 'Board | None' = None, outcome: str | None = None, agreed: frozenset = frozenset(),
         together: frozenset = frozenset(), write: bool = True) -> subprocess.CompletedProcess:
    """The one status write. Finds the table row for the command, the item's type and its status (`to` picks among rows that
    differ only in where they go), refuses what the row forbids, then writes status and holder in one bd compare-and-set on
    the status and holder just read. A close is one compare-and-set write of status, outcome and holder (the closer takes a record another actor holds; bd validates the close in it), then `bd close` only records the reason. `via='supersede'` records
    it through bd supersede, whose `reason` names the new record. `fields` are metadata keys written with it (None removes one), as
    `put_meta` writes them. A closing row records its `outcome` (default: the row's first) in the same write. `board` tells an item
    (inside a change request) from a task. `together`: the ids closed in the same call, which do not hold each other up. The issue is updated in place.
    `write=False` is the check-only path: every refusal above (the row, the holder, authority, guards), nothing written; a multi-id call checks all its ids first."""
    group = group_of(board, issue)
    rows = [m for m in MOVES if m.command == command and m.group == group and issue['status'] in m.frm
            and (to is None or m.to in (to, '='))]
    if len(rows) != 1:
        raise BoardError(f"{issue['id']}: {command} does not apply to a {group or issue.get('issue_type')} that is {issue['status']}" if not rows
                         else f'internal: {len(rows)} rows for {command} of {issue["id"]}')
    row = rows[0]
    if outcome and not row.outcomes:
        raise BoardError(f"{issue['id']}: {command} records no outcome")
    if row.outcomes:
        if outcome not in (None, *row.outcomes):
            raise BoardError(f"{issue['id']}: {command} records {' or '.join(row.outcomes)}, not {outcome}")
        fields = {**(fields or {}), 'outcome': outcome or row.outcomes[0]}
    current = issue.get('assignee') or ''
    refusal = None
    try:
        refuse_held(issue, row, command, actor)
    except BoardError as error:
        refusal = str(error)
    if not refusal:
        refusal = item_write_refusal(board, issue, command, actor or derived_actor()) if group == ITEM_GROUP \
            else authority_refusal(issue, row, command, actor or derived_actor(), board, agreed)
    for name in row.guards if not refusal else ():
        if why := GUARDS[name](issue, board, reason, fields.get('outcome') if fields else None, together):
            refusal = why if why.startswith(f"{issue['id']}:") else f"{issue['id']}: {command} refused: {why}"
            break

    def refused(why: str) -> subprocess.CompletedProcess:
        if check:
            raise BoardError(why)
        return subprocess.CompletedProcess(['move', command, issue['id']], 1, '', why)  # a caller that reads the result sees every refusal as a failed write

    if refusal:
        return refused(refusal)
    if not write:
        return subprocess.CompletedProcess(['move', command, issue['id']], 0, '', '')
    target = issue['status'] if row.to == '=' else row.to
    holder_after = '' if row.holds == '-' else (actor or caller()) if row.holds == 'you' else current
    if group == CR_GROUP and row.holds == '-' and HOLD in meta(issue) and target != 'closed':
        fields = {**(fields or {}), HOLD: None}  # a released hold leaves no kind behind
    if issue['status'] == 'closed' and target != 'closed' and 'outcome' in meta(issue):
        fields = {**(fields or {}), 'outcome': None}  # an open record carries no outcome
    meta_args = [arg for key, value in (fields or {}).items()
                 for arg in (('--unset-metadata', key) if value is None else ('--set-metadata', f'{key}={value}'))]
    if target == 'closed' and force:
        # bd cannot combine --force with a compare-and-set, so the guard takes the record: holder := the closer, expecting the holder just read. A second
        # closer expects a holder that is gone, and its guard fails. A closer who already holds it changes nothing by taking, so it releases first and retakes.
        closer, original = bd_actor(), current
        if current == closer:  # between this release and the retake another session could claim it: the retake then fails as changed meanwhile, and the holder is put back below
            released = bd('update', issue['id'], '--assignee', '', '--if-assignee', closer, '--if-status', issue['status'], '--json')
            if released.returncode != 0:
                return refused(f"{issue['id']}: {command} refused, it changed meanwhile: {bd_message(released)}" if released.returncode == 13
                               else f"{issue['id']}: {command} failed: {bd_message(released)}")
            current = ''
        guard = bd('update', issue['id'], '--assignee', closer, '--if-assignee', current, '--if-status', issue['status'], *meta_args, '--json')
        if guard.returncode != 0:
            if original == closer:
                bd('update', issue['id'], '--assignee', original, '--if-assignee', '', '--if-status', issue['status'], '--json')  # the release stands only if the retake won
            return refused(f"{issue['id']}: {command} refused, it changed meanwhile: {bd_message(guard)}" if guard.returncode == 13
                           else f"{issue['id']}: {command} failed: {bd_message(guard)}")
        result = bd('supersede', issue['id'], '--with', reason or '') if via == 'supersede' else bd('close', issue['id'], '--reason', reason or '', '--force')
        if result.returncode != 0:  # bd refused the close: the record stays open, so the guard's writes are undone: the holder and the metadata it set are put back
            undo = [arg for key in (fields or {}) for arg in (('--set-metadata', f'{key}={meta(issue)[key]}') if key in meta(issue) else ('--unset-metadata', key))]
            bd('update', issue['id'], '--assignee', original, '--if-assignee', closer, '--if-status', issue['status'], *undo, '--json')
        holder_after = closer
    elif target == 'closed':
        if via != 'supersede' and len(reason or '') < CLOSE_REASON_MIN:
            return refused(f"{issue['id']}: {command} refused: bd wants a close reason of {CLOSE_REASON_MIN} or more characters describing what was done ({len(reason or '')} given)")
        # One compare-and-set writes the status, the outcome and the holder (the closer takes a record another actor holds, which bd's close of it requires),
        # and bd validates the close in it (open children, blockers). `bd close` or `bd supersede` then only records the reason.
        holder_closing = current if not current or current == bd_actor() else bd_actor()
        written = bd('update', issue['id'], '--status', 'closed', '--assignee', holder_closing, '--if-assignee', current, '--if-status', issue['status'], *meta_args, '--json')
        if written.returncode != 0:
            return refused(f"{issue['id']}: {command} refused, it changed meanwhile: {bd_message(written)}" if written.returncode == 13
                           else f"{issue['id']}: {command} failed: {bd_message(written)}")
        holder_after = holder_closing
        result = bd('supersede', issue['id'], '--with', reason or '') if via == 'supersede' else bd('close', issue['id'], '--reason', reason or '')
    else:
        args = ['update', issue['id'], *(['--status', target] if row.to != '=' else []),
                *(['--assignee', holder_after] if holder_after != current or row.holds == '-' else []),
                '--if-assignee', current, '--if-status', issue['status'], *meta_args, '--json']
        result = bd(*args)
    if check and result.returncode != 0:
        raise BoardError(f"{issue['id']}: {command} failed: {bd_message(result)}")
    if result.returncode == 0:
        issue.update(status=target, assignee=holder_after)
        if fields:
            if not isinstance(issue.get('metadata'), dict):
                issue['metadata'] = {}
            for key, value in fields.items():
                issue['metadata'].pop(key, None) if value is None else issue['metadata'].__setitem__(key, str(value))
    return result


# Shared boards: skills/shared/beads-setup.md#shared-boards.

def beads_dir(start: Path | None = None) -> Path | None:
    """This folder's board: BEADS_DIR (as bd reads it), else the nearest `.beads`, else (a linked worktree) the main checkout's."""
    named = Path(os.environ['BEADS_DIR']) if os.environ.get('BEADS_DIR') else None
    if named is not None and (named / 'metadata.json').is_file():
        return named
    start = (start or Path.cwd()).resolve()
    found = next((d / '.beads' for d in (start, *start.parents) if (d / '.beads' / 'metadata.json').is_file()), None)
    if found is not None:
        return found
    try:
        common = subprocess.run(['git', 'rev-parse', '--path-format=absolute', '--git-common-dir'], cwd=start,
                                capture_output=True, text=True)
    except OSError:
        return None
    beads = Path(common.stdout.strip()).parent / '.beads'
    return beads if common.returncode == 0 and (beads / 'metadata.json').is_file() else None


def read_mark(beads: Path) -> dict | None:
    try:
        mark = json.loads((beads / MARK_FILE).read_text(encoding='utf-8'))
    except (OSError, ValueError):
        return None
    return mark if isinstance(mark, dict) and isinstance(mark.get('remote'), str) and mark['remote'] else None


def write_mark(beads: Path, remote: str) -> None:
    temporary = beads / f'{MARK_FILE}.{os.getpid()}.tmp'
    temporary.write_text(json.dumps({'remote': remote}), encoding='utf-8')
    temporary.replace(beads / MARK_FILE)


def bd_remotes() -> dict[str, str]:
    """Remote name -> url of this folder's board (share, join and move only: a bd call)."""
    rows = json.loads(bd_checked('sql', '--json', 'select name, url from dolt_remotes') or '[]')
    return {row['name']: row['url'] for row in rows}


def remote_branches(remote: str) -> int:
    """The remote's branches this board has fetched: none before its first push or clone."""
    return int(json.loads(bd_checked('sql', '--json', f"select count(*) c from dolt_remote_branches where name like 'remotes/{remote}/%'"))[0]['c'])


def config_value(key: str) -> str | None:
    rows = json.loads(bd_checked('sql', '--json', f"select value from config where `key` = '{key}'") or '[]')
    return rows[0]['value'] if rows and rows[0].get('value') else None


def git_url(url: str) -> str:
    """The url git itself takes for a bd git remote."""
    return url[len('git+'):] if url.startswith('git+') else url


def remote_refs(url: str) -> tuple[list[str] | None, str]:
    """(the repository's refs, the error): None when it can't be read; `refs/dolt/data` holds a board. Only bd's git remotes:
    other Dolt remotes give (None, '')."""
    if not url.startswith('git+'):
        return None, ''
    try:
        result = subprocess.run(['git', 'ls-remote', git_url(url)], capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as error:
        return None, str(error)
    if result.returncode != 0:
        return None, last_line(result.stderr)
    return [row.split('\t', 1)[1] for row in result.stdout.splitlines() if '\t' in row], ''


def moved_refusal(url: str) -> str:
    return f'this board moved to {url}: writes here are refused. Rejoin: agents board join {url} (beads-setup.md#history)'


def person() -> str | None:
    """The person whose queue this checkout works from: git config agents.person, global or per repository."""
    try:
        result = subprocess.run(['git', 'config', '--get', 'agents.person'], capture_output=True, text=True)
    except OSError:
        return None
    return result.stdout.strip() or None


PERSON_HELP = 'set your person: git config --global agents.person <name> (without --global for this repository only)'


class Shared:
    """A board marked shared (`MARK_FILE`). Files in .beads/board-sync: `wait.lock` (the one wait, freed when it dies), `pull.lock`,
    `unsent` (its mtime is the first unsent write, the window's start), `wrote` (stamped after each write, so a wait about
    to end sees a write that found it still running), `pulled` (last pull started),
    `state.json` (the reported problem, and `moved`: the url a pulled moved note names, read by every command)."""

    def __init__(self, beads: Path, remote: str):
        self.root, self.remote = beads.parent, remote
        self.dir = beads / 'board-sync'
        self.beads = beads

    def path(self, name: str) -> Path:
        self.dir.mkdir(exist_ok=True)
        return self.dir / name

    def mtime(self, name: str) -> float | None:
        try:
            return (self.dir / name).stat().st_mtime
        except OSError:
            return None

    def state(self) -> dict:
        try:
            state = json.loads((self.dir / 'state.json').read_text(encoding='utf-8'))
        except (OSError, ValueError):
            return {}
        return state if isinstance(state, dict) else {}

    def update_state(self, **fields) -> None:
        temporary = self.path(f'state.{os.getpid()}.tmp')
        temporary.write_text(json.dumps({**self.state(), **fields}), encoding='utf-8')
        temporary.replace(self.path('state.json'))

    def hold_wait(self):
        """The wait lock, held until closed: a running wait finishes its send first, and no new one starts."""
        wait = self.path('wait.lock').open('w')
        try:
            fcntl.flock(wait, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print('board: waiting for the pending sync to finish', file=sys.stderr)
            fcntl.flock(wait, fcntl.LOCK_EX)
        return wait

    def lock(self, name: str, tries: int = 1):
        """The named lock, or None when another process holds it; released when the file closes or the process dies."""
        handle = self.path(name).open('w')
        for attempt in range(tries):
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return handle
            except OSError:
                if attempt + 1 < tries:
                    time.sleep(0.2)
        handle.close()
        return None

    def waiting(self) -> dict | None:
        """{'unsent': a write or commit has not reached the remote, 'conflicts': live conflict rows}; None when the
        server does not answer. A commit a failed sync left behind counts: the working set alone would strand it."""
        ensure_server(self.root)
        result = subprocess.run(['bd', 'sql', '--json',
                                 "select (select count(*) from dolt_status) dirty, (select count(*) from dolt_conflicts) conflicts, "
                                 "(select hash from dolt_branches where name = active_branch()) local, "
                                 f"(select hash from dolt_remote_branches where name = concat('remotes/{self.remote}/', active_branch())) remote"],
                                cwd=self.root, capture_output=True, text=True, env=bd_env())
        try:
            row = json.loads(result.stdout)[0]
        except (ValueError, IndexError, KeyError, TypeError):
            return None
        return {'unsent': bool(int(row['dirty'])) or row['local'] != row['remote'], 'conflicts': int(row['conflicts'])}

    def spawn_wait(self) -> None:
        """Detached: its own session, no inherited pipes, or the caller's tool call would stay open for the whole wait."""
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), '_sync-wait'], cwd=self.root, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True, env=bd_env())

    def wait_running(self) -> bool:
        """A shared probe: probes never collide with each other, and `wait` retries past a passing one."""
        with self.path('wait.lock').open('w') as handle:
            try:
                fcntl.flock(handle, fcntl.LOCK_SH | fcntl.LOCK_NB)
            except OSError:
                return True
        return False

    def start_wait(self) -> None:
        """Starts the wait for known unsent writes, a window after the last failure at the earliest: a stopped sync must
        not run again on every command."""
        failed = self.state().get('last_failure')
        if not failed or time.time() - failed >= SYNC_SECONDS:
            self.spawn_wait()

    def before(self) -> None:
        """Restarts a dead wait; pulls when due and nothing is waiting. One process pulls, others carry on."""
        if self.wait_running():
            return
        if self.mtime('unsent') is not None:
            self.start_wait()
            return
        pulled = self.mtime('pulled')
        if pulled is not None and time.time() - pulled < SYNC_SECONDS:
            return
        handle = self.lock('pull.lock')
        if handle is None:
            return
        with handle:
            now = self.waiting()
            if now is None:
                return
            if now['unsent']:  # a pull would commit it and undo the grouping; a write from outside board comes here
                self.path('unsent').touch()
                self.start_wait()
                return
            self.path('pulled').touch()
            self.pull()
            self.check_store()

    def pull(self) -> None:
        child = subprocess.Popen(['bd', 'dolt', 'pull', '--remote', self.remote], cwd=self.root, stdin=subprocess.DEVNULL,
                                 stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, start_new_session=True, env=bd_env())
        try:
            output, _ = child.communicate(timeout=PULL_TIMEOUT)
        except subprocess.TimeoutExpired:
            with contextlib.suppress(OSError):
                os.killpg(child.pid, signal.SIGKILL)
            child.wait()
            self.failed(f'a pull took over {PULL_TIMEOUT} s')
            return
        if child.returncode == 0:
            self.succeeded()
            self.check_moved()
            return
        now = self.waiting()
        if now and now['conflicts']:
            self.update_state(kind='conflict', last_failure=time.time())
        else:
            self.failed(last_line(output))

    def after(self) -> None:
        """A command that may have written: starts the window unless a wait is on it. Clears a conflict report once
        the conflict is gone (resolved, or the merge aborted); the wait's next sync says how it went."""
        self.path('wrote').touch()
        if self.wait_running() and self.state().get('kind') != 'conflict':
            return
        now = self.waiting()
        if now is None:
            return
        if self.state().get('kind') == 'conflict' and not now['conflicts']:
            self.update_state(kind=None, failures=0, last_failure=None, detail=None)
        if now['unsent'] and not self.wait_running():
            if self.mtime('unsent') is None:
                self.path('unsent').touch()
            self.start_wait()

    def succeeded(self) -> None:
        if self.state().get('failures') or self.state().get('kind') or self.state().get('last_failure'):
            self.update_state(kind=None, failures=0, detail=None, last_failure=None)

    def moved(self) -> str | None:
        return self.state().get('moved') or None

    def check_moved(self) -> None:
        """After each pull: whether the board brought a moved note (board relocate). A failed read keeps what was known."""
        ensure_server(self.root)
        result = subprocess.run(['bd', 'sql', '--json', f"select value from config where `key` = '{MOVED}'"], cwd=self.root,
                                capture_output=True, text=True, env=bd_env())
        try:
            rows = json.loads(result.stdout)
        except ValueError:
            return
        url = rows[0].get('value') if rows and isinstance(rows[0], dict) else None
        if (url or None) != self.moved():
            self.update_state(moved=url or None)

    def failed(self, detail: str, kind: str = 'failing') -> None:
        self.update_state(kind=kind, failures=int(self.state().get('failures') or 0) + 1, detail=detail, last_failure=time.time())

    def sync_once(self) -> bool:
        """One commit and sync. True when the wait may go on trying (it succeeded, or the failure is transient)."""
        subprocess.run(['bd', 'dolt', 'commit', '-m', f"sync {person() or socket.gethostname()}"], cwd=self.root,
                       capture_output=True, env=bd_env())
        try:
            result = subprocess.run(['bd', 'sync', '--remote', self.remote], cwd=self.root, capture_output=True, text=True,
                                    timeout=SYNC_TIMEOUT, env=bd_env())
        except subprocess.TimeoutExpired:
            self.failed(f'a sync ran over {SYNC_TIMEOUT} s', 'stuck')
            return False
        if result.returncode == 0:
            self.succeeded()
            self.path('pulled').touch()
            self.check_moved()
            return True
        if result.returncode == 2:
            self.failed('', 'conflict')
            return False
        if result.returncode == 4:
            self.failed('uncommitted changes block every sync', 'stuck')
            return False
        self.failed(last_line(result.stderr or result.stdout))
        return True

    def send(self) -> bool:
        for attempt in range(SYNC_ATTEMPTS):
            if attempt:
                time.sleep(SYNC_RETRY_SECONDS)
            if not self.sync_once():
                return False
            if not self.state().get('failures'):
                return True
        return False

    def wait(self) -> int:
        """`board _sync-wait`: the first unsent write opens a window; at its end, commit and sync; writes during the sync
        open the next. Ends when nothing is left, or after a failed window with `unsent` kept for the next command."""
        while True:
            handle = self.lock('wait.lock', tries=5)
            if handle is None:
                return 0
            with handle:
                while True:
                    stamp = self.mtime('wrote')
                    now = self.waiting()
                    if now is None:
                        self.failed('the board server does not answer')
                        return 1
                    if now['conflicts']:
                        self.failed('', 'conflict')
                        return 1
                    if not now['unsent']:
                        with contextlib.suppress(OSError):
                            (self.dir / 'unsent').unlink()
                        break
                    if self.mtime('unsent') is None:
                        self.path('unsent').touch()
                    first = self.mtime('unsent') or time.time()
                    time.sleep(max(0.0, first + SYNC_SECONDS - time.time()))
                    (self.dir / 'unsent').unlink(missing_ok=True)  # a write from here on opens the next window
                    if not self.send():
                        self.path('unsent').touch()
                        os.utime(self.path('unsent'), (first, first))
                        return 1
            if self.mtime('wrote') == stamp:
                return 0

    def check_store(self) -> None:
        """Hourly: walking the store on every command would cost more than the warning is worth."""
        state = self.state()
        if time.time() - float(state.get('store_checked') or 0) < STORE_CHECK_SECONDS:
            return
        size = sum(entry.stat().st_size for entry in (self.beads / 'dolt').rglob('*') if entry.is_file())
        self.update_state(store_checked=time.time(), store_bytes=size, store_warned=False)

    def problem(self) -> str | None:
        """The one line for a stopped or repeatedly failing sync, with its fix; None while single failures recover."""
        state = self.state()
        kind, detail = state.get('kind'), state.get('detail') or ''
        if state.get('moved'):
            return moved_refusal(state['moved'])
        if kind == 'conflict':
            return ('sync stopped by a merge conflict, nothing goes out. Fix: agents board bd conflicts show, ' + raw_form('conflicts '
                    'resolve <id> --ours|--theirs') + ', ' + raw_form('sync') + '. A row one side deleted: ' + raw_form('conflicts resolve --all --table issues --ours|--theirs')
                    + ' (--all alone fails when a dependency row conflicts). Both sides created one id: ' + raw_form('sql '
                    '"CALL DOLT_MERGE(\'--abort\')"') + ', ' + raw_form('rename <id> <new id>') + ', ' + raw_form('sync'))
        if kind == 'stuck':
            return f'sync stuck: {detail}. Fix: {raw_form("sync")} shows the error; {raw_form('dolt commit -m "<why>"')} clears uncommitted changes'
        if kind == 'failing' and int(state.get('failures') or 0) >= SYNC_REPORT_AFTER:
            return f"sync failing, {state['failures']} tries: {detail}. Fix: check the remote and your access; {raw_form('sync')} shows the error"
        return None

    def store_warning(self) -> str | None:
        size = int(self.state().get('store_bytes') or 0)
        if size < STORE_WARN_BYTES:
            return None
        return f'board store is {size / (1 << 30):.1f} GB: plan a flatten with the others (beads-setup.md#history)'

    def report(self) -> None:
        """What every command prints, on stderr: the protocol, the console and --json views read stdout."""
        problem = self.problem()
        if problem:
            print(f'board: {problem}', file=sys.stderr)
        warning = self.store_warning()
        if warning and not self.state().get('store_warned'):
            self.update_state(store_warned=True)
            print(f'board: {warning}', file=sys.stderr)
        if person() is None:
            print(f'board: {PERSON_HELP}', file=sys.stderr)


def last_line(text: str) -> str:
    lines = [row.strip() for row in text.splitlines() if row.strip()]
    return next((row for row in lines if row.startswith('Error')), lines[-1] if lines else 'no output')[:200]


shared: Shared | None = None
settled = False  # a read finished a landing (settle_landed): its writes need the sync window like a write command's


def find_shared(start: Path | None = None) -> Shared | None:
    beads = beads_dir(start)
    mark = read_mark(beads) if beads else None
    return Shared(beads, mark['remote']) if mark else None


def session_role(board: 'Board | None' = None) -> str | None:
    """The calling session's registered role: None for a person, a worker, or a session with no readable registration."""
    actor = derived_actor()
    if not actor or actor != session_actor(actor):
        return None
    try:
        entry = (board.registry() if board else registry_by_actor(registrations()[0])).get(actor)
    except BoardError:
        return None
    return entry.get('role') if entry else None


def may_attend(board: 'Board | None' = None) -> bool:
    """A person's terminal has no actor and isn't limited; a session with no registered role and a worker count as agents."""
    return not derived_actor() or session_role(board) in ATTENDED_ROLES


def may_decide(board: 'Board | None' = None) -> bool:
    """A person's terminal, or a deciding session (lead, solo, autopilot)."""
    return not derived_actor() or session_role(board) in DECIDING_ROLES


def autopilot_barred(board: Board) -> bool:
    """An autopilot session facing a finished change request: its Accept is the user's, so autopilot neither claims nor judges it."""
    return session_role(board) == 'autopilot'


def bd_show(ids: list[str], *flags: str, comments: bool = True) -> list[dict]:
    """Full records of the ids that exist (bd reports unknown ids on stderr, or fails when none exists)."""
    result = bd('show', '--json', *(['--include-comments'] if comments else []), '--brief-deps', *flags, '--', *ids)
    if result.returncode != 0:
        try:
            if 'no issues found' in json.loads(result.stdout).get('error', ''):
                return []
        except (ValueError, AttributeError):
            pass
        raise BoardError(f"`bd show` failed: {(result.stderr or result.stdout).strip()}")
    return json.loads(result.stdout or '[]')


def registrations() -> tuple[list[dict], set[str]]:
    """(readable registrations, actors of the files that cannot be read): one `session list` call. An unreadable
    file's session counts as unregistered; the person is told once."""
    result = subprocess.run(['bash', str(REGISTRY), 'list'], capture_output=True, text=True)
    if result.returncode != 0:
        raise BoardError(f'session registry unreadable: {result.stderr.strip()}')
    rows = [json.loads(line) for line in result.stdout.splitlines() if line.strip()]
    skipped = [row['unreadable'] for row in rows if 'unreadable' in row]
    for file in skipped:
        print(f'session: skipped unreadable registration {file}', file=sys.stderr)
    return [row for row in rows if 'unreadable' not in row], {Path(file).stem[-8:] for file in skipped}


def bd_closed() -> list[dict]:
    """Every closed item without its free text, in one call."""
    return json.loads(bd_checked('list', '--status', 'closed', '--brief', '--json', '--limit', '0') or '[]')


_prefix: list[str | None] = []


def board_prefix() -> str | None:
    """The board's own id prefix (bd `issue_prefix`), read once; None when bd has none to give."""
    if not _prefix:
        try:
            _prefix.append(current_setting('issue_prefix') or None)
        except (BoardError, ValueError):
            _prefix.append(None)
    return _prefix[0]


def board_id(raw: str) -> str:
    """An id as bd takes it: a bare one (`28g0i`, `overhaul.2.25`; every full id has `<prefix>-`) gets the board's prefix."""
    prefix = board_prefix() if re.fullmatch(r'[0-9a-z][0-9a-z.]*', raw) else None
    return f'{prefix}-{raw}' if prefix else raw


def board_project() -> str | None:
    """The resolved folder holding this board: the parent of the first line of `bd where` (a worktree names the main
    checkout's .beads); None when the lookup fails. The registry records the same value (session project)."""
    result = bd('where')
    first = result.stdout.splitlines()[0].strip() if result.returncode == 0 and result.stdout.strip() else ''
    return str(Path(first).parent.resolve()) if first.startswith('/') else None


def parse_time(value) -> datetime | None:
    if not isinstance(value, str) or not value:
        return None
    try:
        moment = datetime.fromisoformat(value)
    except ValueError:
        return None
    return moment if moment.tzinfo is not None else moment.replace(tzinfo=timezone.utc)


def age(moment: datetime | None) -> str:
    if moment is None:
        return 'age unknown'
    minutes = int((utcnow() - moment).total_seconds() // 60)
    if minutes < 120:
        return f'{minutes} min'
    if minutes < 48 * 60:
        return f'{minutes // 60} h'
    return f'{minutes // 1440} d'


def session_actor(actor: str) -> str:
    return actor.split('/', 1)[0]


_processes: dict[int, str | None] = {}  # pid -> start time, 'GONE', or None (unknown); per run


def holder_worker(holder: str) -> str | None:
    """The holding worker's marker name (its id's last 8 characters), None for a session hold."""
    return holder.split('/', 1)[1][-8:] if '/' in holder else None


def hooks_live(entry: dict | None) -> bool:
    """The session's activity hooks run: its own activity file exists. Without it, a missing worker marker or a
    marker's age proves nothing (a worker spawned before the hooks, or hooks not yet trusted)."""
    return bool(entry and entry.get('active_at'))


def worker_stopped(entry: dict | None, issue: dict) -> bool:
    """The holding worker has no running marker, and the session's own activity is newer than the item's
    `updated_at`: every claim updates it (later updates only raise it), so the hooks ran after this claim and a
    running worker would have a marker. Not `started_at`: it can predate the hold (a reclaim, a reviewer's claim).
    Only its owning session (`board mine`) acts on it: only the owner knows whether it continues the worker."""
    worker = holder_worker(issue.get('assignee') or '')
    if not (entry and worker) or worker in (entry.get('workers') or {}):
        return False
    active, claimed = parse_time(entry.get('active_at')), parse_time(issue.get('updated_at'))
    return bool(active and claimed and active > claimed)


def holder_activity(entry: dict | None, holder: str) -> datetime | None:
    """The holder's last tool call: a running worker's marker, else (a session hold, a stopped worker) the session's
    own; None without activity data (the session's hooks not live)."""
    if not hooks_live(entry):
        return None
    worker = holder_worker(holder)
    moment = parse_time((entry.get('workers') or {}).get(worker)) if worker else None
    return moment or parse_time(entry.get('active_at'))


def active_workers(entry: dict | None) -> list[str]:
    """The session's running workers with a tool call within WORKER_ACTIVE_MINUTES."""
    since = utcnow() - timedelta(minutes=WORKER_ACTIVE_MINUTES)
    return [worker for worker, moment in ((entry or {}).get('workers') or {}).items()
            if (parse_time(moment) or since) > since]


def worker_cap(entry: dict) -> int:
    """The session's own `worker_cap`, else WORKER_CAP, lowered for a Codex session by the effective `agents.max_threads` or
    `agents.max_concurrent_threads_per_session`: Codex's layers, the system config (CODEX_SYSTEM_CONFIG; tests set
    AGENT_CODEX_SYSTEM_CONFIG) overridden per key by `$CODEX_HOME/config.toml` (default ~/.codex)."""
    own = entry.get('worker_cap')
    cap = own if isinstance(own, int) and not isinstance(own, bool) and own >= 0 else WORKER_CAP
    if entry.get('tool') != 'codex':
        return cap
    layers = (Path(os.environ.get('AGENT_CODEX_SYSTEM_CONFIG') or CODEX_SYSTEM_CONFIG),
              Path(os.environ.get('CODEX_HOME') or Path.home() / '.codex') / 'config.toml')
    agents: dict = {}
    for path in layers:
        try:
            layer = tomllib.loads(path.read_text(encoding='utf-8')).get('agents')
        except (OSError, ValueError):  # a missing or unreadable layer sets nothing
            continue
        agents.update(layer if isinstance(layer, dict) else {})
    for key in ('max_threads', 'max_concurrent_threads_per_session'):
        value = agents.get(key)
        if isinstance(value, int) and not isinstance(value, bool) and value > 0:
            cap = min(cap, value)
    return cap


def process_started(pid: int) -> str | None:
    """The process's start time as `ps -o lstart=` prints it in UTC (whitespace-normalized; session
    stores the same form), or None when ps fails for any reason."""
    try:
        result = subprocess.run([shutil.which('ps') or '/bin/ps', '-o', 'lstart=', '-p', str(pid)], capture_output=True,
                                text=True, env={**os.environ, 'LC_ALL': 'C', 'TZ': 'UTC0'})
    except OSError:
        return None
    started = ' '.join(result.stdout.split())
    return started if result.returncode == 0 and started else None


def liveness(entry: dict | None) -> str | None:
    """'GONE' when the session's registered pid no longer exists or now names a process started at another
    time, 'alive' when it matches, None when unknown (no entry, no pid, ps failed): unknown keeps the idle hint."""
    if entry is None:
        return None
    pid, started = entry.get('pid'), entry.get('pid_started')
    if not isinstance(pid, int) or pid <= 1 or not isinstance(started, str):
        return None
    if pid not in _processes:
        try:
            os.kill(pid, 0)
            _processes[pid] = process_started(pid)
        except ProcessLookupError:
            _processes[pid] = 'GONE'
        except PermissionError:  # exists, owned by another user
            _processes[pid] = process_started(pid)
        except OSError:
            _processes[pid] = None
    current = _processes[pid]
    if current is None:
        return None
    return 'GONE' if current == 'GONE' or current != ' '.join(started.split()) else 'alive'


class Board:
    def __init__(self, issues: list[dict], complete: bool = True):
        """complete: the snapshot holds closed items too. Without them (status reads) a dependency target that is
        missing counts as closed; with them a missing one is unknown and counts as open (fail closed)."""
        self.complete = complete
        self._hydrated: set[str] = set()
        self.issues = issues
        self._milestone_work: dict[str, set[str]] = {}
        self._in_milestone: dict[str, list[str]] | None = None
        self._accept_queue: tuple[tuple, list[dict]] | None = None  # (key, queue): see accept_queue
        self.effective: dict[str, tuple[int, str | None, bool]] = {}  # item id -> effective_priority
        self.by_id = {issue['id']: issue for issue in issues}
        self.parent: dict[str, str] = {}
        self.parents: dict[str, list[str]] = {}  # bd allows several; `parent` keeps the last for the views that assume one
        self.view: str | None = None  # the queue the default lists show; None: every item (an unshared board, --queue all)
        self._loaded = ids_of(issues)
        self._outside: dict[str, tuple[list[str], list[str]]] = {}  # item not in the snapshot -> (labels, parents)
        self._closed_blockers: dict[str, str | None] = {}
        self.settings: dict[str, str] = {}  # project settings read so far (board_setting)
        self._registry: dict[str, dict] | None = None
        self._unreadable: set[str] = set()
        self._ended: set[str] | None = None
        self._cr_blockers_read = False
        self.git_view: GitView | None = None  # set by `read_git_view` on a read-only command; dropped when the command changes git state
        self._ref_format: dict[str, bool] = {}
        self._cr: dict[str, dict] = {}  # change request id -> git facts read so far (cr_info)
        self._queues: dict[str, list[str]] = {}
        self.children: dict[str, list[str]] = {}
        self.blockers: dict[str, list[str]] = {}  # waiting id -> ids it waits on
        self.dependents: dict[str, list[str]] = {}  # blocker id -> waiting ids
        self.linked: dict[str, set[str]] = {}  # id -> ids sharing any non-parent edge
        self.related: dict[str, set[str]] = {}  # relates-to, both ends
        self.edges: dict[str, list[tuple[str, str, bool]]] = {}  # id -> (other id, type, outgoing)
        for issue in issues:
            for dep in issue.get('dependencies') or []:
                waiting, target, kind = dep['issue_id'], dep['depends_on_id'], dep['type']
                self.edges.setdefault(waiting, []).append((target, kind, True))
                self.edges.setdefault(target, []).append((waiting, kind, False))
                if kind == 'parent-child':
                    self.parent[waiting] = target
                    if target not in self.parents.setdefault(waiting, []):
                        self.parents[waiting].append(target)
                    self.children.setdefault(target, []).append(waiting)
                    continue
                self.linked.setdefault(waiting, set()).add(target)
                self.linked.setdefault(target, set()).add(waiting)
                if blocking(kind):
                    self.blockers.setdefault(waiting, []).append(target)
                    self.dependents.setdefault(target, []).append(waiting)
                elif kind == 'relates-to':
                    self.related.setdefault(waiting, set()).add(target)
                    self.related.setdefault(target, set()).add(waiting)

    @classmethod
    def load(cls, scope: str = 'status', ids: list[str] | None = None) -> 'Board':
        """The one place that picks the bd read, sized to the view:
        status: non-closed items with dependencies, no comments (`hydrate` adds the held items' comments);
        all: `bd export`, closed items and comments included;
        ids: only the named items with their comments and both edge directions (`board show`)."""
        if scope == 'all':
            lines = bd_checked('export').splitlines()
            return cls([issue for issue in map(json.loads, filter(str.strip, lines)) if issue.get('_type', 'issue') == 'issue'])
        if scope == 'status':
            issues = json.loads(bd_checked('list', '--json', '--limit', '0', '--include-gates') or '[]')
            for issue in issues:  # bd export orders an item's edges by target; list does not, and blocker order is printed
                issue['dependencies'] = sorted(issue.get('dependencies') or [], key=lambda d: (d['depends_on_id'], d['type']))
            return cls(issues, complete=False)
        records = bd_show(ids or [], '--include-dependents')
        edges, stubs = set(), {}
        for record in records:
            for stub, outgoing, key in [(d, True, 'dependencies') for d in record.get('dependencies') or []] \
                    + [(d, False, 'dependents') for d in record.get('dependents') or []]:
                edges.add((record['id'], stub['id'], stub['dependency_type']) if outgoing
                          else (stub['id'], record['id'], stub['dependency_type']))
                stubs[stub['id']] = stub
        for record in records:  # the export's edge shape: the item's own entries, both directions
            record['dependencies'] = [{'issue_id': a, 'depends_on_id': b, 'type': kind}
                                      for a, b, kind in sorted(edges) if record['id'] in (a, b)]
            record.pop('dependents', None)
        board = cls(records, complete=False)
        # A revision pending names its new record's partial rule, kept in that record's metadata.
        newer = sorted({a for a, b, kind in edges if kind == REVISES and b in ids_of(records)
                        and board.by_id[b].get('issue_type') == 'decision'} - ids_of(records))
        full = {record['id']: record for record in bd_show(newer)} if newer else {}
        for other_id, stub in stubs.items():
            board.by_id.setdefault(other_id, full.get(other_id, stub))
        return board

    def registry(self) -> dict[str, dict]:
        """The session registry by actor, read once per command (board never writes it; a failed read is not kept)."""
        if self._registry is None:
            entries, self._unreadable = registrations()
            self._registry = registry_by_actor(entries)
        return self._registry

    def unreadable(self) -> set[str]:
        """Actors whose registration file exists but cannot be read, from the same `list` call as the registry."""
        self.registry()
        return self._unreadable

    def ended(self) -> set[str]:
        """Actors of the sessions whose registration was pruned (session `ended`), read on first use."""
        if self._ended is None:
            result = subprocess.run(['bash', str(REGISTRY), 'ended'], capture_output=True, text=True)
            self._ended = set(result.stdout.split()) if result.returncode == 0 else set()
        return self._ended

    def hydrate(self, ids) -> None:
        """Adds what a status read leaves out, for the given items, in one bd call: their comments."""
        todo = [item_id for item_id in dict.fromkeys(ids) if item_id in self.by_id and item_id not in self._hydrated]
        if not self.complete and todo:
            for record in bd_show(todo):
                self.by_id[record['id']]['comments'] = record.get('comments') or []
        self._hydrated.update(todo)

    def held_ids(self) -> list[str]:
        """Held items: `last_activity` needs their comments (comments do not bump updated_at)."""
        return [issue['id'] for issue in self.issues if holder(issue)]

    def ancestors(self, item_id: str):
        seen = set()
        while item_id in self.parent and item_id not in seen:
            seen.add(item_id)
            item_id = self.parent[item_id]
            yield item_id

    def scoped(self, root: str | None) -> list[dict]:
        if root is None:
            return self.issues
        if root not in self.by_id and (self.complete or root not in self.edges):  # a closed root: only its edges show
            raise BoardError(f'unknown root {root}')
        if self.by_id.get(root, {}).get('issue_type') == 'milestone':
            work = self.milestone_work(root) | {root}
            return [issue for issue in self.issues if issue['id'] in work]
        return [issue for issue in self.issues if root in self.ancestors(issue['id'])]

    def read_whole(self, item_ids) -> None:
        """Replaces the stubs of these records (an ids read holds its items' neighbours as stubs, without holder or type) with the records."""
        stubs = sorted({i for i in item_ids if i in self.by_id and i not in self._loaded})
        for record in bd_show(stubs, comments=False) if stubs else []:
            self.by_id[record['id']] = record

    def routing(self, item_id: str) -> tuple[list[str], list[str]]:
        """(labels, parents) of an item, reading ancestors the snapshot lacks (a status read holds no closed items) in one call."""
        if item_id in self._loaded:
            return self.by_id[item_id].get('labels') or [], self.parents.get(item_id, [])
        self.fetch_outside([item_id])
        return self._outside[item_id]

    def fetch_outside(self, item_ids) -> None:
        """Reads the given items the snapshot lacks, with the parents it lacks, in one call."""
        wanted = {i for i in item_ids if i not in self._loaded and i not in self._outside}
        if not wanted:
            return
        missing = wanted | {p for parents in self.parents.values() for p in parents if p not in self._loaded and p not in self._outside}
        for record in bd_show(sorted(missing), comments=False):
            self._outside[record['id']] = (record.get('labels') or [],
                                           [d['id'] for d in record.get('dependencies') or [] if d.get('dependency_type') == 'parent-child'])
            if record.get('status') == 'closed':
                self._closed_blockers[record['id']] = record.get('issue_type')
        for other in missing:
            self._outside.setdefault(other, ([], []))

    def queues(self, item_id: str, seen: frozenset = frozenset()) -> list[str]:
        """Its own queue label(s), else the union of its parents': more than one means no queue can be picked."""
        if item_id not in self._queues:
            labels, parents = self.routing(item_id)
            own = sorted(label[len(QUEUE_PREFIX):] for label in labels if label.startswith(QUEUE_PREFIX))
            self._queues[item_id] = own or sorted({queue for parent in parents if parent not in seen
                                                   for queue in self.queues(parent, seen | {item_id})})
        return self._queues[item_id]

    def queue(self, item_id: str) -> str | None:
        """The item's queue; None: unrouted (no label on it or above it, or several queues disagree)."""
        names = self.queues(item_id)
        return names[0] if len(names) == 1 else None

    def listed(self, root: str | None) -> list[dict]:
        """What default lists and bare claims cover: `scoped`, narrowed to the viewed queue on a shared board."""
        scoped = self.scoped(root)
        return scoped if self.view is None else [issue for issue in scoped if self.queue(issue['id']) == self.view]

    def milestone_work(self, milestone_id: str) -> set[str]:
        """Open work of the milestone (board-coordination.md#milestones): the open records that are part of it (parent-child; a milestone waits
        on nothing), the open descendants of every reached change request, and transitively the open blockers of every reached item."""
        if milestone_id not in self._milestone_work:
            work: set[str] = set()
            visited: set[tuple[str, bool]] = set()  # an item reached as a blocker may be reached again as a descendant
            pending = [(member, False) for member in self.children.get(milestone_id, [])]
            while pending:
                visit = pending.pop()
                item_id, descendant = visit
                if visit in visited or not self.is_open(item_id):
                    continue
                visited.add(visit)
                work.add(item_id)
                pending += [(blocker, False) for blocker in self.blockers.get(item_id, [])]
                if descendant or self.by_id[item_id].get('issue_type') == CR_TYPE:
                    pending += [(child, True) for child in self.children.get(item_id, [])]
            self._milestone_work[milestone_id] = work
        return self._milestone_work[milestone_id]

    def milestone_ready(self, milestone_id: str) -> bool:
        """A milestone is accepted once none of its work is open."""
        return not self.milestone_work(milestone_id)

    def milestones(self) -> list[dict]:
        return [issue for issue in self.issues if issue.get('issue_type') == 'milestone' and issue['status'] != 'closed']

    @property
    def in_milestone(self) -> dict[str, list[str]]:
        """Item id -> the open milestones it is work of."""
        if self._in_milestone is None:
            self._in_milestone = {}
            for milestone in self.milestones():
                for item_id in self.milestone_work(milestone['id']):
                    self._in_milestone.setdefault(item_id, []).append(milestone['id'])
        return self._in_milestone

    def between(self, a: str, b: str) -> list[tuple[str, str, str]]:
        """(from, to, type) of every edge between the pair, either direction."""
        return [(a, other, kind) if outgoing else (other, a, kind) for other, kind, outgoing in self.edges.get(a, [])
                if other == b]

    def revises(self, item_id: str) -> list[str]:
        """Records a decision revises (pending until release)."""
        if self.by_id.get(item_id, {}).get('issue_type') != 'decision':
            return []
        return [other for other, kind, outgoing in self.edges.get(item_id, []) if outgoing and kind == REVISES]

    def revised_by(self, item_id: str) -> list[str]:
        """The decisions whose pending revision names this record."""
        return [other for other, kind, outgoing in self.edges.get(item_id, [])
                if not outgoing and kind == REVISES and self.by_id.get(other, {}).get('issue_type') == 'decision']

    def is_open(self, item_id: str) -> bool:
        return item_id in self.by_id and self.by_id[item_id]['status'] != 'closed'

    def open_blockers(self, item_id: str) -> list[str]:
        # In a complete snapshot a missing blocker counts as open (fail closed); a status read holds no closed
        # items, so there it counts as closed. `external:` references never block in bd 1.3.1.
        return [blocker for blocker in self.blockers.get(item_id, [])
                if self.is_open(blocker)
                or (self.complete and blocker not in self.by_id and not blocker.startswith('external:'))]

    def waits_on_decision(self, item_id: str, seen: set[str] | None = None) -> bool:
        """An open decision holds it, directly or through open blockers: it stays out of a CR until that closes."""
        seen = set() if seen is None else seen
        for blocker in self.open_blockers(item_id):
            if blocker not in seen:
                seen.add(blocker)
                if self.by_id.get(blocker, {}).get('issue_type') == 'decision' or self.waits_on_decision(blocker, seen):
                    return True
        return False

    def unsettled_blockers(self, item_id: str) -> list[str]:
        """What holds a decided record's release or an answered question's close: an in-force ruling is a settled
        premise, which holds only the open items it changes until planned."""
        return [blocker for blocker in self.open_blockers(item_id)
                if self.by_id.get(blocker, {}).get('status') != 'in_force']

    def release_holds(self, item_id: str) -> list[str]:
        """What holds a decided record's release (`board ruling release` and health's `blockedBy`): its unsettled blockers, and
        a live record revising it, which supersedes it when released with it and leaves it nothing to release alone (r9-q33)."""
        return [*self.unsettled_blockers(item_id), *(r for r in self.revised_by(item_id) if self.is_open(r))]

    def kind(self, issue: dict) -> str | None:
        status, kind = issue['status'], issue.get('issue_type')
        if kind == CR_TYPE:
            return self.cr_kind(issue)
        if kind == 'decision':
            return {'in_force': 'plan', 'open': 'question'}.get(status)
        # Work items are claimed through their change request (by id, by the session holding it): no pull of their own;
        # open no-commit work is the exception.
        if status == 'open' and is_no_commit(issue) and self.cr_of(issue['id']) is None:
            return 'plan'  # work that commits nothing: the dispatcher triages it (a worker's brief, or the user's assignment)
        return 'milestone' if status == 'open' and kind == 'milestone' else None

    def is_cr(self, item_id: str) -> bool:
        return self.by_id.get(item_id, {}).get('issue_type') == CR_TYPE

    def cr_of(self, item_id: str) -> str | None:
        """The live change request an item belongs to (itself, for a change request), else None."""
        if self.is_cr(item_id):
            return item_id
        if item_id in self._loaded:
            parents = self.parents.get(item_id, [])
        else:
            parents = self.routing(item_id)[1]
        return next((p for p in parents if self.is_cr(p)), None)

    def cr_items(self, cr_id: str) -> list[dict]:
        """The CR's items that are not closed."""
        return [self.by_id[c] for c in self.children.get(cr_id, []) if self.is_open(c)]

    def cr_kind(self, issue: dict) -> str | None:
        m = meta(issue)
        if issue['status'] == 'open':
            return 'plan' if m.get(PLAN_FIRST) else 'implement'  # no open item left is the handover step, not planning
        if issue['status'] == PASSED:
            return None if after_base(self, issue) else 'accept'  # a passed child of an unlanded parent (look after) waits for it to land
        return 'review' if issue['status'] == 'in_review' else None

    def stackable(self, issue: dict) -> bool:
        """May a change request build on this one: any passed one (waiting for the user's Accept, or for its own base to land), never one in agent
        review (q235). Landing a base lands the look-after requests stacked on it, each in turn, so a chain lands from its first base."""
        return issue['status'] == PASSED

    def cr_blockers(self, issue: dict, scope: bool = False) -> list[str]:
        """What the CR and its open items wait on, apart from each other; `scope`: what the CR itself waits on (a wait on the whole CR)."""
        members = [issue['id'], *self.children.get(issue['id'], [])]
        return [b for m in ([issue['id']] if scope else members) if m in self.by_id and self.is_open(m)
                for b in self.blockers.get(m, []) if b not in members]

    def fetch_cr_blockers(self) -> None:
        """Reads the blockers outside the snapshot of every change request in one call, not one per request (a bd call
        costs ~0.1 s). Those are closed items, and all a change request needs of one is its parents (to lift it to its
        request): one list of the closed items, free text omitted, costs ~0.3 s however many blockers there are, where
        `bd show` of them cost ~16 ms each."""
        if not self.complete and not self._cr_blockers_read:
            wanted = [b for issue in self.issues if self.is_cr(issue['id']) for b in self.cr_blockers(issue)
                      if b not in self.by_id and not b.startswith('external:')]
            if any(b not in self._loaded and b not in self._outside for b in wanted):
                for row in bd_closed():
                    self._outside.setdefault(row['id'], (row.get('labels') or [], [d['depends_on_id'] for d in row.get('dependencies') or []
                                                                                  if d.get('type') == 'parent-child']))
                    self._closed_blockers[row['id']] = row.get('issue_type')
            self.fetch_outside(wanted)  # what the list lacks (an item that is not closed or not there)
            self._cr_blockers_read = True  # only a read that worked: a failed one is asked again

    def cr_wait_parts(self, issue: dict, *, projected: bool = False) -> tuple[list[str], list[str]]:
        """Hard waits of the CR itself (a wait on the whole CR) and the candidate stack bases of the CR and its items, before the one-base
        threshold. What its items wait on holds the items, not the CR (`item_waits`)."""
        waits, bases = self.wait_parts(issue['id'], self.cr_blockers(issue), projected)
        own = set(self.wait_parts(issue['id'], self.cr_blockers(issue, scope=True), projected)[0])
        return [w for w in waits if w in own], bases

    def item_waits(self, item: dict, cr_id: str | None = None) -> list[str]:
        """What an open item of a CR still waits on: a sibling that is open, another CR that has not landed (unless its CR stacks on it), a
        question that is not closed (planned, dropped or superseded), a gate or task not closed."""
        cr_id = cr_id or self.cr_of(item['id'])
        blockers = self.blockers.get(item['id'], [])
        siblings = [b for b in blockers if self.is_open(b) and self.cr_of(b) == cr_id]
        waits, bases = self.wait_parts(cr_id, [b for b in blockers if b not in siblings], False)
        return [*siblings, *waits, *(bases if len(self.cr_wait_parts(self.by_id[cr_id])[1]) > 1 else [])]  # a CR stacks on one base only

    def cr_stuck(self, cr: dict) -> list[str]:
        """What holds an open CR with open items when none of them is ready (the items' unmet waits), else []."""
        items = self.cr_items(cr['id'])
        if cr['status'] != 'open' or not items:
            return []
        waits = [self.item_waits(item, cr['id']) for item in items if item.get('issue_type') != CR_TYPE]
        if not waits or any(not one for one in waits):
            return []
        return list(dict.fromkeys(b for one in waits for b in one))

    def wait_parts(self, owner: str | None, blockers: list[str], projected: bool) -> tuple[list[str], list[str]]:
        """The unmet waits and candidate stack bases of `blockers` waited on from the CR `owner`: other CRs unlanded are waits, a stackable one a base."""
        waits: list[str] = []
        bases: list[str] = []
        self.fetch_cr_blockers()
        issue = {'id': owner}
        for blocker in dict.fromkeys(blockers):
            record = self.by_id.get(blocker)
            if record is not None and not self.is_open(blocker) and self.cr_of(blocker) is None:
                continue  # closed
            if record is None and (blocker.startswith('external:') or
                                   (not self.complete and not projected and self.cr_of(blocker) is None)):
                continue  # closed outside a status snapshot, or never blocking
            if record is None and blocker not in self._closed_blockers and (self.complete or projected):
                waits.append(blocker)  # unknown: fail closed
                continue
            cr_id = self.cr_of(blocker)
            if cr_id is None:
                if blocker not in self._closed_blockers:
                    waits.append(blocker)
                continue
            target = self.by_id.get(cr_id)
            if target is None or target['status'] == 'closed':
                continue  # landed
            if cr_id == issue['id']:
                continue
            if self.stackable(target):
                if cr_id not in bases:
                    bases.append(cr_id)
            elif cr_id not in waits:
                waits.append(cr_id)
        return waits, bases

    def cr_waits(self, issue: dict) -> tuple[list[str], list[str]]:
        """A request can start with at most one unlanded stackable base."""
        waits, bases = self.cr_wait_parts(issue)
        return (waits + bases, []) if len(bases) > 1 else (waits, bases)

    @cached_property
    def unlocks(self) -> WorkUnlocks:
        return WorkUnlocks(self)

    def foreign_waits(self, issue: dict) -> list[str]:
        """The open blockers an in-force ruling may not wait on (r21-q139): work and containers, not planning. Claiming
        ignores them and the claim names the fix (q140); `board check` lists them as `ruling-blocked`."""
        if issue.get('issue_type') != 'decision' or issue['status'] != 'in_force':
            return []
        return [blocker for blocker in self.open_blockers(issue['id'])
                if blocker in self.by_id and not planning_wait(self.by_id[blocker])]

    def planning_blockers(self, issue: dict) -> list[str]:
        """The open blockers that hold the item from being claimed."""
        ignored = set(self.foreign_waits(issue))
        return [blocker for blocker in self.open_blockers(issue['id']) if blocker not in ignored]

    def waits_of(self, issue: dict) -> list[str]:
        """What holds the item from its step: a change request's lifted waits, else its open blockers."""
        if issue.get('issue_type') == CR_TYPE:
            return [*self.cr_waits(issue)[0], *self.cr_stuck(issue)]
        return self.planning_blockers(issue)

    def step_kind(self, issue: dict) -> str | None:
        """The pull kind of an item, a change request in work included (the work pull that holds it)."""
        return self.kind(issue)

    def claimable(self, issue: dict) -> str | None:
        kind = self.kind(issue)
        if kind is None or issue.get('assignee') or filed_for(issue):
            return None
        if issue.get('issue_type') == CR_TYPE:
            return cr_claimable(self, issue, kind)
        if kind == 'milestone' and not self.milestone_ready(issue['id']):
            return None  # accepted once its work is done
        return None if self.planning_blockers(issue) else kind

    def downstream(self, item_id: str, through_milestones: bool = True) -> int:
        """Open work waiting on an item. A milestone's whole scope waits on each member, which tells members apart by
        nothing: `through_milestones=False` counts a milestone as one item and stops there (r24-q109)."""
        seen: set[str] = set()
        pending = [item_id]
        while pending:
            for waiting in self.dependents.get(pending.pop(), []):
                if waiting not in seen and self.is_open(waiting):
                    seen.add(waiting)
                    if through_milestones or self.by_id.get(waiting, {}).get('issue_type') != 'milestone':
                        pending.append(waiting)
        return len(seen)

    def holds(self, item_id: str) -> tuple[int, int]:
        """(stopping at milestones, everything downstream): what `holds 2/52` prints and lists sort by."""
        return self.downstream(item_id, through_milestones=False), self.downstream(item_id)

    def last_activity(self, issue: dict) -> datetime | None:
        moments = [parse_time(issue.get('updated_at'))]
        moments += [parse_time(comment.get('created_at')) for comment in issue.get('comments') or []]
        moments = [moment for moment in moments if moment is not None]
        return max(moments) if moments else None

    def text(self, issue: dict) -> str:
        parts = [str(issue.get(field) or '') for field in TEXT_FIELDS]
        parts += issue.get('labels') or []
        parts += [comment.get('text') or '' for comment in issue.get('comments') or []]
        return '\n'.join(parts)


def holder(issue: dict) -> str | None:
    """Who holds the item now: its assignee while it is not closed. A closed item's assignee is history, not a hold."""
    return issue.get('assignee') or None if issue.get('status') != 'closed' else None


def held_by_a_session(issue: dict) -> bool:
    """'held' in every view: a session holds the item."""
    return holder(issue) is not None


def line(issue: dict, *extra: str) -> str:
    fields = [issue['id'], issue['status'], issue.get('issue_type', ''), *extra]
    return '  ' + '  '.join(field for field in fields if field) + f"  {issue.get('title', '')}"


def section(title: str, rows: list[str], limit: int | None = None) -> None:
    print(f'{title}: {len(rows)}')
    shown = rows[:limit] if limit else rows  # None or 0: every row
    for row in shown:
        print(row)
    if len(shown) < len(rows):
        print(f'  ... {len(rows) - len(shown)} more')


def by_priority(issue: dict):
    return (issue.get('priority', 9), issue.get('created_at') or '', issue['id'])


def work_unit(board: Board, issue: dict) -> list[str]:
    """What ranks together (r5-q20): a change request and its open items, which are claimed, reviewed and landed as one;
    any other item stands alone."""
    if issue.get('issue_type') != CR_TYPE:
        return [issue['id']]
    return [issue['id'], *(item['id'] for item in board.cr_items(issue['id']) if item.get('issue_type') != CR_TYPE)]  # not the requests stacked under it


def waiting_priority(board: Board, item: dict) -> tuple[int, str | None]:
    """(priority, waiting item) of the item alone: the highest priority among it and every open item waiting on it through
    blocking edges, transitively (r22-q179). The second field is the nearest such item that sets it, None when the item's
    own priority is the highest. A milestone confers none: its whole scope waits on each member."""
    best, via = item.get('priority', 9), None
    seen, pending = {item['id']}, [item['id']]
    while pending:
        for waiting in board.dependents.get(pending.pop(0), []):
            if waiting in seen or not board.is_open(waiting) or board.by_id[waiting].get('issue_type') == 'milestone':
                continue
            seen.add(waiting)
            if (priority := board.by_id[waiting].get('priority', 9)) < best:
                best, via = priority, waiting
            pending.append(waiting)
    return best, via


def effective_priority(board: Board, issue: dict) -> tuple[int, str | None, bool]:
    """(priority, item that sets it, whether that item is part of the request's own unit) the rank counts the item at: its
    `waiting_priority`; a change request counts with its work unit. A request under another counts alone: priority does not
    pass up through a parent request."""
    if issue['id'] not in board.effective:
        best, via = waiting_priority(board, issue)
        own = False
        for member in work_unit(board, issue)[1:]:
            priority, raised = waiting_priority(board, board.by_id[member])
            if priority < best:
                best, via, own = priority, raised or member, raised is None
        board.effective[issue['id']] = (best, via, own)
    return board.effective[issue['id']]


def milestones_of(board: Board, issue: dict) -> list[str]:
    """The open milestones the item is work of (`Board.in_milestone`); a change request also through its open items and
    through a change request it sits under (r5-q20)."""
    if issue.get('issue_type') != CR_TYPE:
        return board.in_milestone.get(issue['id'], [])
    reached = set(work_unit(board, issue))
    for ancestor in board.ancestors(issue['id']):
        if board.is_cr(ancestor):
            reached.update(work_unit(board, board.by_id[ancestor]))
    return sorted({m for item_id in reached for m in board.in_milestone.get(item_id, [])})


def work_rank(board: Board, issue: dict) -> tuple[bool, int]:
    """(milestone work, effective priority): the rank claims, `board queue` and the change-request lists share."""
    return bool(milestones_of(board, issue)), effective_priority(board, issue)[0]


class WorkWait(NamedTuple):
    hard: frozenset[str]
    bases: frozenset[str]
    items: tuple[frozenset[str], ...] = ()  # a change request: what each open item waits on; the request is ready when one has nothing left to wait for

    def ready(self, delivered: set[str]) -> bool:
        return self.hard <= delivered and len(self.bases - delivered) <= 1 and (not self.items or any(waits <= delivered for waits in self.items))

    def relevant(self) -> frozenset[str]:
        return (self.hard | self.bases if len(self.bases) > 1 else self.hard).union(*self.items)


class UnlockImpact(NamedTuple):
    score: Fraction = Fraction()
    solo: int = 0
    breadth: int = 0
    shared: int = 0


class WorkUnlocks:
    """Delivery and wait projection shared by the rank, console and question seeds."""

    def __init__(self, board: Board):
        self.board = board
        board.fetch_cr_blockers()
        if not board.complete:
            board.fetch_outside({blocker for blockers in board.blockers.values() for blocker in blockers
                                 if blocker not in board.by_id and not blocker.startswith('external:')})
        self.waits: dict[str, WorkWait] = {}
        self.delivers: dict[str, set[str]] = {}
        self.reverse: dict[str, list[str]] = {}
        self.ready: set[str] = set()
        for issue in board.issues:
            item_id, kind = issue['id'], issue.get('issue_type')
            if kind not in UNBLOCKED_TYPES or issue['status'] in ('closed', 'deferred'):
                continue
            if kind != CR_TYPE and (parent := board.cr_of(item_id)) and board.is_open(parent):
                continue  # the parent is the work unit
            self.delivers[item_id] = {item_id}
            wait = self.waits[item_id] = self.wait_for(issue)
            if wait.ready(set()):
                self.ready.add(item_id)
            else:
                for token in wait.relevant():
                    self.reverse.setdefault(token, []).append(item_id)

    def wait_for(self, issue: dict) -> WorkWait:
        board, item_id = self.board, issue['id']
        if issue.get('issue_type') == CR_TYPE:
            hard, bases = board.cr_wait_parts(issue, projected=True)
            if issue['status'] == PASSED and (parent := live_parent(board, issue)):
                hard.append(parent)
            items = tuple(frozenset(board.item_waits(item, item_id)) for item in board.cr_items(item_id) if item.get('issue_type') != CR_TYPE)
            return WorkWait(frozenset(hard), frozenset(bases), items)
        hard = set()
        ignored = set(board.foreign_waits(issue))
        blockers = board.blockers.get(item_id, [])
        if issue['status'] == 'decided' and issue.get('issue_type') == 'decision':
            ignored.update(b for b in blockers if board.by_id.get(b, {}).get('status') == 'in_force')
            blockers = [*blockers, *(r for r in board.revised_by(item_id) if board.is_open(r))]
        for blocker in blockers:
            if blocker in ignored or blocker.startswith('external:'):
                continue
            record = board.by_id.get(blocker)
            closed = record['status'] == 'closed' if record else blocker in board._closed_blockers
            kind = record.get('issue_type') if record else board._closed_blockers.get(blocker)
            parent = board.cr_of(blocker) if record or blocker in board._outside else None
            if parent and parent != blocker:
                if board.is_open(parent):
                    hard.add(parent)  # an implementation item's delivery is its parent's landing
            elif not closed:
                hard.add(blocker)    # missing blockers stay unresolved in the projection
        return WorkWait(frozenset(hard), frozenset())

    def release(self, roots: Iterable[str], within: set[str] | None = None) -> tuple[list[str], int]:
        """Release initially blocked units through token delivery; breadth measures the first wave."""
        delivered = {token for root in roots for token in self.delivers[root]}
        pending = deque(sorted(delivered))
        released: list[str] = []
        completed: set[str] = set()
        breadth = 0
        while pending:
            wave: list[str] = []
            for _ in range(len(pending)):
                for unit in self.reverse.get(pending.popleft(), []):
                    if unit not in completed and (within is None or unit in within) and self.waits[unit].ready(delivered):
                        completed.add(unit)
                        wave.append(unit)
            if not released:
                breadth = len(wave)
            released.extend(sorted(wave))
            for unit in wave:
                for token in sorted(self.delivers[unit] - delivered):
                    pending.append(token)
                    delivered.add(token)
        return released, breadth

    def _impossible_base_edges(self, released: list[str]) -> set[tuple[str, str]]:
        """A stack base that must follow a unit cannot help release it through a two-base threshold."""
        positions = {unit: i for i, unit in enumerate(released)}
        producers = {token: unit for unit, tokens in self.delivers.items() for token in tokens}
        impossible = set()
        for unit, position in positions.items():
            hard, bases = self.waits[unit].hard, self.waits[unit].bases
            if len(bases) < 2:
                continue
            later = {base for base in bases - hard if positions.get(base, -1) >= position}
            needed: set[str] = set()
            pending = list(later)
            while pending:
                upstream = pending.pop()
                if upstream in needed or upstream not in positions:
                    continue
                needed.add(upstream)
                if upstream != unit:
                    pending.extend(producers[token] for token in self.waits[upstream].relevant() if token in producers)
            if unit in needed:
                # Only projected feedback needs replay, and only its candidate bases' ancestors.
                feasible, _ = self.release(self.ready, within=needed - {unit})
                impossible.update((base, unit) for base in later - set(feasible))
        return impossible

    @cached_property
    def impact(self) -> dict[str, UnlockImpact]:
        released, _ = self.release(self.ready)
        reachable = set(released)
        impossible = self._impossible_base_edges(released)
        participants = {unit: {unit} for unit in self.ready}
        pending = deque((unit, {unit}) for unit in self.ready)
        while pending:
            unit, added = pending.popleft()
            for token in self.delivers[unit]:
                for waiting in self.reverse.get(token, []):
                    if waiting in reachable and (token, waiting) not in impossible:
                        found = participants.setdefault(waiting, set())
                        new = added - found
                        if new:
                            found.update(new)
                            pending.append((waiting, new))
        score: dict[str, Fraction] = {}
        joined: dict[str, set[str]] = {}
        for unit in released:
            contributors = participants[unit]
            credit = Fraction(1, len(contributors))
            for root in contributors:
                score[root] = score.get(root, Fraction()) + credit
                joined.setdefault(root, set()).add(unit)
        impact = {}
        for root, credit in score.items():
            solo, breadth = self.release([root])
            impact[root] = UnlockImpact(credit, len(solo), breadth, len(joined[root] - set(solo)))
        return impact

    def key(self, item_id: str) -> tuple[Fraction, int]:
        impact = self.impact.get(item_id, UnlockImpact())
        return -impact.score, -impact.breadth

    def question_seeds(self, visible: list[dict]) -> list[dict]:
        questions = {row['id']: row for row in visible if row['id'] in self.waits}
        roots = self.ready & questions.keys()
        released, _ = self.release(roots, within=set(questions))
        order = sorted(roots) + released
        available: dict[str, frozenset[str]] = {}
        for qid in order:
            required = self.waits[qid].hard
            if required <= available.keys():
                available[qid] = frozenset({qid}).union(*(available[q] for q in required))

        observed: dict[frozenset[str], list[str]] = {}
        for item_id, (hard, bases, _) in self.waits.items():
            if hard and len(bases) <= 1 and hard <= available.keys():
                required = frozenset().union(*(available[q] for q in hard))
                observed.setdefault(required, []).append(item_id)
        seeds = []
        def unit_rank(unit: str) -> tuple[bool, int, str | None]:
            issue = self.board.by_id[unit]
            milestones = milestones_of(self.board, issue)
            return not milestones, effective_priority(self.board, issue)[0], min(milestones, default=None)

        ranks = {unit: unit_rank(unit) for units in observed.values() for unit in units}
        for required in observed:
            freed = [item_id for subset, units in observed.items() if subset <= required for item_id in units]
            milestone, priority, milestone_id = min(ranks[unit] for unit in freed)
            ids = [qid for qid in order if qid in required]
            key = (milestone, priority, -Fraction(len(freed), len(ids)), tuple(sorted(ids)))
            seeds.append((key, {'questions': [{'id': qid, 'title': questions[qid].get('title', '')} for qid in ids],
                                'milestone': milestone_id, 'priority': priority, 'unblocks': len(freed)}))
        return [row for _, row in sorted(seeds, key=lambda one: one[0])]


def claim_order(board: Board, issue: dict):
    # Tiers (r22-q176, r23-q180): P0, then planning (in-force rulings, plan_first CRs, no-commit tasks), milestone work (board-coordination.md#milestones),
    # review and acceptance, the rest. Within a tier: effective priority, unlocks, kind, then created.
    milestone, priority = work_rank(board, issue)
    kind = board.claimable(issue) or board.kind(issue)  # refresh work ranks as a refresh, not as its Accept
    tier = 0 if priority == 0 else 1 if kind == 'plan' else 2 if milestone else 3 if kind in FINISHING else 4
    return (tier, priority, *board.unlocks.key(issue['id']), CLAIM_RANK.get(kind, len(CLAIM_RANK)), issue.get('created_at') or '', issue['id'])


# Views

HEALTH_VIEWS = ('questions', 'decided', 'in_force', 'review', 'accept', 'user', 'ready', 'held', 'blocked')
LIFECYCLE_LABELS = ('human', 'decided', 'review', 'needs-ratification', 'waiting')  # labels never carry a status


def due_deferral(issue: dict, side: str) -> bool:
    """A deferred record whose revisit day has come, for the side that deferred it ('user', else a session's plan work). It stays
    deferred until that side undefers it; nothing reopens by itself."""
    m = meta(issue)
    return issue['status'] == 'deferred' and bool(m.get(REVISIT)) and m[REVISIT] <= date.today().isoformat() \
        and ((m.get(DEFERRED_BY) or 'user') == 'user') == (side == 'user')


def health_views(board: Board, root: str | None) -> dict[str, tuple[str, list[dict]]]:
    """view -> (heading, open items), the counts `board health` prints."""
    items = [issue for issue in board.listed(root) if issue['status'] != 'closed']
    decisions = [issue for issue in items if issue.get('issue_type') == 'decision']

    return {
        'questions': ('open questions', [i for i in decisions if i['status'] == 'open']),
        'decided': ('decided, not released', [i for i in decisions if i['status'] == 'decided']),
        'in_force': ('rulings in force to plan', [i for i in decisions if i['status'] == 'in_force']),
        'review': ('to review (change requests in agent review)', [i for i in items if board.kind(i) == 'review']),
        'accept': ('to accept (change requests waiting for the user)', [i for i in items if board.kind(i) == 'accept']),
        'user': ('waiting on the user (human gates, due deferrals)', [i for i in items if is_human_gate(i) or due_deferral(i, 'user')]),
        'ready': ('claimable now (unassigned, unblocked)', [i for i in items if board.claimable(i)]),
        'held': ('held (assigned to a session, not closed)', [i for i in items if held_by_a_session(i)]),
        'blocked': ('waiting on open blockers', [i for i in items if board.open_blockers(i['id'])]),
    }


def milestone_states(board: Board, root: str | None) -> list[dict]:
    scope = {issue['id'] for issue in board.listed(root)}
    states = []
    for milestone in (m for m in board.milestones() if m['id'] in scope):
        work = [board.by_id[item_id] for item_id in board.milestone_work(milestone['id'])]
        states.append({'id': milestone['id'], 'title': milestone.get('title', ''), 'openWork': len(work),
                       'ready': sum(1 for i in work if board.claimable(i)), 'held': sum(1 for i in work if held_by_a_session(i)),
                       'blocked': sum(1 for i in work if board.open_blockers(i['id'])),
                       'milestoneReady': board.milestone_ready(milestone['id'])})
    return states


def item_json(board: Board, issue: dict, **extra) -> dict:
    """An item row of a --json view."""
    return {'id': issue['id'], 'type': issue.get('issue_type'), 'status': issue['status'], 'priority': issue.get('priority'),
            'holder': issue.get('assignee') or None, 'title': issue.get('title', ''), 'labels': issue.get('labels') or [],
            'blockedBy': board.release_holds(issue['id']) if issue['status'] == 'decided' else board.open_blockers(issue['id']),
            **extra}


# health views under the console's count names (contract-rulings R-B5); the others keep their view name.
JSON_COUNTS = {'in_force': 'toPlan', 'review': 'toReview', 'accept': 'toAccept', 'user': 'forUser'}
# The views counted as steps (r21-q141, q146): ready = can be taken now, waiting = the rest of the step.
STEP_VIEWS = ('questions', 'decided', 'in_force', 'review', 'accept', 'user')


def step_blocked(board: Board, view: str, issue: dict) -> bool:
    """Whether an open blocker holds the item from its step (a decided record waits on unsettled ones only)."""
    if view == 'decided':
        return bool(board.unsettled_blockers(issue['id']))
    return bool(board.waits_of(issue))


def step_counts(board: Board, views: dict[str, tuple[str, list[dict]]]) -> dict[str, tuple[int, int, int]]:
    """view -> (ready, held, waiting) for the step views (r21-q141, q146): waiting = blocked, held or not; held = has a
    session holder and is not blocked; ready = the rest. A user step is never held by a session (r22-q171).
    The one definition health, the console and position print."""
    counts = {}
    for view in STEP_VIEWS:
        rows = views[view][1]
        waiting = sum(1 for issue in rows if step_blocked(board, view, issue))
        held = sum(1 for issue in rows if held_by_a_session(issue) and not step_blocked(board, view, issue))
        counts[view] = (len(rows) - held - waiting, held, waiting)
    return counts


def count_suffix(held: int, waiting: int) -> str:
    parts = ([f'{held} held'] if held else []) + ([f'{waiting} wait'] if waiting else [])
    return f" ({', '.join(parts)})" if parts else ''


def queue_summary(board: Board, root: str | None) -> dict | None:
    """What a queue-filtered list always adds, None without a filter: open items per other queue, unrouted items, and
    other people's items blocking the viewed queue's. Gates route nothing and don't count."""
    if board.view is None:
        return None
    items = [issue for issue in board.scoped(root) if issue['status'] != 'closed' and issue.get('issue_type') != 'gate']
    others: dict[str, int] = {}
    for issue in items:
        queue = board.queue(issue['id'])
        if queue and queue != board.view:
            others[queue] = others.get(queue, 0) + 1
    mine = [issue for issue in items if board.queue(issue['id']) == board.view]
    blocking = {blocker for issue in mine for blocker in board.open_blockers(issue['id'])
                if blocker in board.by_id and board.queue(blocker) != board.view and board.queue(blocker)}
    # Unrouted items wait on a lead: for you first (your inbox), then the longest waiting.
    unrouted = sorted((issue for issue in items if board.queue(issue['id']) is None),
                      key=lambda issue: (board.view not in filed_for(issue), waiting_since(issue), issue['id']))
    return {'others': others, 'unrouted': unrouted,
            'inbox': [issue for issue in unrouted if board.view in filed_for(issue)],
            'toSend': [issue for issue in mine if filed_for(issue)],
            'blocking': sorted((board.by_id[item_id] for item_id in blocking), key=by_priority)}


def filed_for(issue: dict) -> list[str]:
    """The people an item is filed for (`for:` labels)."""
    return [label[len(FOR_PREFIX):] for label in issue.get('labels') or [] if label.startswith(FOR_PREFIX)]


def sent_at(issue: dict) -> str | None:
    """When `board send` last put an item in an inbox (its metadata stamp), None for an item never sent."""
    metadata = issue.get('metadata') if isinstance(issue.get('metadata'), dict) else {}
    value = metadata.get(SENT_AT)
    return value if filed_for(issue) and isinstance(value, str) and parse_time(value) else None


def waiting_since(issue: dict) -> str:
    """An unrouted item waits since it was sent, if it was; otherwise since it was created."""
    return sent_at(issue) or issue.get('created_at') or ''


def unrouted_row(board: Board, issue: dict) -> str:
    names = board.queues(issue['id'])
    sent = sent_at(issue)
    return line(issue, f"queues {','.join(names)}" if names else '', *(FOR_PREFIX + who for who in filed_for(issue)),
                f"sent {age(parse_time(sent))} ago" if sent else f"{age(parse_time(issue.get('created_at')))} old")


def queue_rows(board: Board, root: str | None, command: str) -> None:
    summary = queue_summary(board, root)
    if summary is None:
        return
    if summary['others']:
        counts = ', '.join(f'{queue} {count}' for queue, count in sorted(summary['others'].items()))
        print(f'other queues: {counts} (board {command} --queue <person>, or --queue all)')
    if summary['unrouted']:
        section('unrouted', [unrouted_row(board, issue) for issue in summary['unrouted']])
    if summary['blocking']:
        section("blocking yours, in other people's queues", [line(issue, f"queue {board.queue(issue['id'])}") for issue in summary['blocking']])


def queue_line(board: Board, root: str | None) -> str | None:
    """The queue rows in one line, for the console pane."""
    summary = queue_summary(board, root)
    if summary is None:
        return None
    parts = ([f"other queues: {', '.join(f'{queue} {count}' for queue, count in sorted(summary['others'].items()))}"] if summary['others'] else []) \
        + ([f"unrouted: {', '.join(issue['id'] for issue in summary['unrouted'])}"
            + (f" ({len(summary['inbox'])} for you)" if summary['inbox'] else '')] if summary['unrouted'] else []) \
        + ([f"blocking yours: {', '.join(issue['id'] for issue in summary['blocking'])}"] if summary['blocking'] else [])
    return ' · '.join(parts) or None


def queues_json(board: Board, root: str | None) -> dict:
    """The queue fields of a --json view; none without a filter, so an unshared board's JSON stays as it was."""
    summary = queue_summary(board, root)
    if summary is None:
        return {}
    return {'queues': {'view': board.view, 'others': summary['others'],
                       'unrouted': [item_json(board, issue, queues=board.queues(issue['id']), waitingSince=waiting_since(issue) or None)
                                    for issue in summary['unrouted']],
                       'inbox': [item_json(board, issue, waitingSince=waiting_since(issue) or None) for issue in summary['inbox']],
                       'toSend': [item_json(board, issue) for issue in summary['toSend']],
                       'blocking': [item_json(board, issue, queue=board.queue(issue['id'])) for issue in summary['blocking']]}}


def health_counts(board: Board, views: dict) -> dict:
    """The `counts` of a --json health view, from its `health_views`."""
    steps = step_counts(board, views)
    return {JSON_COUNTS.get(view, view): ({'ready': steps[view][0], 'held': steps[view][1], 'waiting': steps[view][2]} if view in steps else len(rows))
            for view, (_, rows) in views.items()}


def health_json(board: Board, args) -> dict:
    views = health_views(board, args.root)
    ready = views['ready'][1]
    found = deviations(board, args.root)
    return {**queues_json(board, args.root), 'counts': health_counts(board, views),
            'claimable': {kind: sum(1 for i in ready if board.claimable(i) == kind) for kind in KINDS},
            'items': {JSON_COUNTS.get(view, view): [item_json(board, issue) for issue in sorted(views[view][1], key=by_priority)]
                      for view in HEALTH_VIEWS if view in args.items},
            **({'questionSeeds': board.unlocks.question_seeds(views['questions'][1])} if 'questions' in args.items else {}),
            'milestones': milestone_states(board, args.root),
            'deviations': {'count': len(found)}}


def health(board: Board, args) -> None:
    views = health_views(board, args.root)
    steps = step_counts(board, views)
    for view, (name, rows) in views.items():
        print(f'{name}: {len(rows)}' if view not in steps else f'{name}: {steps[view][0]}{count_suffix(steps[view][1], steps[view][2])}')
        if view == 'ready':
            counts = {kind: sum(1 for i in rows if board.claimable(i) == kind) for kind in KINDS}
            print('  by kind: ' + ', '.join(f'{pull} {count}' for pull, count in counts.items()))
        if view in args.items:
            listed = [line(issue, issue.get('assignee') or '') for issue in sorted(rows, key=by_priority)]
            for row in listed[:args.limit] if args.limit else listed:
                print(row)
            if args.limit and len(listed) > args.limit:
                print(f'  ... {len(listed) - args.limit} more')
    due = [i for i in board.listed(args.root) if due_deferral(i, 'plan')]
    if due:
        print(f"deferred, revisit day reached (plan work): {len(due)}: {', '.join(i['id'] for i in due)}")
    shown = {i['id'] for i in board.listed(args.root)}
    waiting = [i for i in accept_queue(board) if i['id'] in shown]
    if waiting:
        stale = [i for i in waiting if cr_info(board, i)['state'] != 'current']
        print(f'change requests waiting for you: {len(waiting)} ({len(stale)} not current; agents board queue lists them)')
    for state in milestone_states(board, args.root):
        print(f"milestone {state['id']} ({state['title']}): open work {state['openWork']}, "
              f"ready {state['ready']}, held {state['held']}, "
              f"blocked {state['blocked']}; milestone {'ready' if state['milestoneReady'] else 'not ready'}")
    found = deviations(board, args.root)
    if found:
        fixed = sum(1 for _, kind, _ in found if kind in COMMAND_FIXED)  # fixed by a board command, not a migration
        hints = (['run /board-migrate'] if fixed < len(found) else []) + ([f'board fixes: {fixed} (agents board check)'] if fixed else [])
        print(f"convention deviations: {len(found)} — {'; '.join(hints)}")
    queue_rows(board, args.root, 'health')


def registry_by_actor(entries: list[dict]) -> dict[str, dict]:
    known: dict[str, dict] = {}
    for entry in sorted(entries, key=lambda e: e.get('registered_at') or ''):
        known[entry.get('actor') or ''] = entry
    return known


def holder_label(holder: str, known: dict[str, dict]) -> str:
    entry = known.get(session_actor(holder))
    if entry is None:
        return holder
    pulls = f" {'+'.join(entry.get('pulls') or [])}" if entry.get('pulls') else ''
    return f"{holder} ({entry.get('role')}{pulls}, {entry.get('tool') or 'tool unknown'})"


def session_activity(entry: dict) -> datetime | None:
    """The session's last tool call, its own or a running worker's; None without activity data (hooks not live)."""
    if not hooks_live(entry):
        return None
    moments = [parse_time(entry.get('active_at')), *(parse_time(m) for m in (entry.get('workers') or {}).values())]
    return max((m for m in moments if m is not None), default=None)


def session_state(entry: dict, now: datetime) -> str | None:
    """'gone' (its registered process ended), 'active' or 'idle' (last activity within IDLE_HOURS or not), None
    unknown (no activity data). The console's 'stopped' has no session-level board state: a stopped worker is
    marked on its item (board mine)."""
    if liveness(entry) == 'GONE':
        return 'gone'
    latest = session_activity(entry)
    if latest is None:
        return None
    return 'active' if (now - latest).total_seconds() <= IDLE_HOURS * 3600 else 'idle'


def holder_gone(board: Board, known: dict[str, dict], holder: str) -> bool:
    """The holding session's process ended, or it was pruned (a pid-less one idle): its hold can be taken over (r3-q17, r5-q25)."""
    entry = known.get(session_actor(holder))
    return liveness(entry) == 'GONE' or (entry is None and session_actor(holder) in board.ended())


def position_data(board: Board, args) -> dict:
    """What `board position` shows: ready work per kind against the sessions handling it, sessions, held items with
    their marks, questions holding work and ready milestones."""
    items = [issue for issue in board.listed(args.root) if issue['status'] != 'closed']
    board.hydrate(board.held_ids())  # one bd call for the held items' comments
    known = board.registry()
    now = utcnow()
    ready = [issue for issue in items if board.claimable(issue)]
    held = sorted((issue for issue in items if held_by_a_session(issue)),
                  key=lambda issue: (issue['assignee'], by_priority(issue)))
    holding = {session_actor(issue['assignee']) for issue in held}
    project = board_project()
    horizon = now - timedelta(hours=SESSION_HOURS)

    def recent(entry: dict) -> bool:
        moments = (parse_time(entry.get('registered_at')), session_activity(entry))
        return max((m for m in moments if m is not None), default=now) > horizon

    sessions = [entry for entry in known.values()
                if entry.get('actor') in holding
                or (project is not None and entry.get('project') == project and recent(entry))]
    kinds = {kind: {'ready': sum(1 for issue in ready if board.claimable(issue) == kind),
                    'held': sum(1 for issue in items if board.step_kind(issue) == kind and held_by_a_session(issue) and not board.waits_of(issue)),
                    'waiting': sum(1 for issue in items if board.kind(issue) == kind and board.waits_of(issue)),
                    'sessions': sum(1 for entry in sessions if kind in session_kinds(entry, ROLE_HANDLES) and liveness(entry) != 'GONE')}
             for kind in KINDS}
    holds = []
    for issue in held:
        entry = known.get(session_actor(issue['assignee']))
        updated = board.last_activity(issue)
        recorded = holder_activity(entry, issue['assignee'])
        activity = recorded or updated
        gone = holder_gone(board, known, issue['assignee'])
        idle = not gone and (activity is None or (now - activity).total_seconds() > IDLE_HOURS * 3600)
        # This machine can't know another machine's session: no idleness to claim, nothing to offer.
        elsewhere = shared is not None and entry is None and bool(ACTOR.fullmatch(issue['assignee']))
        holds.append((issue, entry, updated, recorded, 'gone' if gone else 'elsewhere' if elsewhere else 'idle' if idle else None))
    questions = sorted(((board.holds(issue['id']), issue) for issue in items
                        if issue.get('issue_type') == 'decision' and issue['status'] not in ('in_force', 'deferred')),
                       key=lambda pair: (-pair[0][0], -pair[0][1], by_priority(pair[1])))
    return {
        'kinds': kinds, 'known': known, 'now': now,
        'sessions': [(entry, sum(1 for issue in held if session_actor(issue['assignee']) == entry.get('actor')))
                     for entry in sessions],
        'held': holds,
        'questions': [(waiting, issue) for waiting, issue in questions if waiting[1]],
        'milestones': sorted((i for i in items if board.kind(i) == 'milestone' and board.milestone_ready(i['id'])),
                             key=by_priority),
    }


def iso(moment: datetime | None) -> str | None:
    return moment.astimezone(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ') if moment else None


def session_json(entry: dict, holds: int, now: datetime) -> dict:
    return {'session': entry.get('session'), 'role': entry.get('role'), 'actor': entry.get('actor'),
            'pulls': entry.get('pulls') or [], 'tool': entry.get('tool'),
            'handles': list(session_kinds(entry, ROLE_HANDLES)), 'registeredAt': entry.get('registered_at'), 'holds': holds,
            # Without live activity hooks no worker marker is trustworthy.
            'workers': {'active': len(active_workers(entry)), 'cap': worker_cap(entry)} if hooks_live(entry) else None,
            'process': {'alive': 'alive', 'GONE': 'gone'}.get(liveness(entry) or ''),
            'state': session_state(entry, now)}


def position_json(board: Board, args) -> dict:
    data = position_data(board, args)
    return {
        **queues_json(board, args.root),
        'ready': data['kinds'],
        'sessions': [session_json(entry, count, data['now']) for entry, count in data['sessions']],
        'held': [item_json(board, issue, updatedAt=iso(updated), activeAt=iso(recorded), mark=mark,
                           stale=stale_since(board, issue) is not None, forced=forced_reason(issue))
                 for issue, _, updated, recorded, mark in data['held']],
        'questionsHoldingWork': [item_json(board, issue, holds=waiting[0], holdsAll=waiting[1]) for waiting, issue in data['questions']],
        'readyMilestones': [item_json(board, issue) for issue in data['milestones']],
    }


def position(board: Board, args) -> None:
    data = position_data(board, args)
    known = data['known']
    print('ready work by kind vs sessions handling it:')
    for kind, counts in data['kinds'].items():
        print(f"  {kind}: {counts['ready']} ready{count_suffix(counts['held'], counts['waiting'])}, {counts['sessions']} sessions")
    limit = args.limit
    section(f'sessions (holding items here, or of this project and registered or active within {SESSION_HOURS} h)',
            [f"  {entry.get('actor')}  {entry.get('role')}  {entry.get('tool') or 'tool unknown'}"
             f"  handles {','.join(session_kinds(entry, ROLE_HANDLES)) or '-'}  registered {age(parse_time(entry.get('registered_at')))} ago"
             f"  holds {count}"
             f"  workers {len(active_workers(entry))}/{worker_cap(entry)}"
             + {'alive': '  process alive', 'GONE': '  GONE'}.get(liveness(entry) or '', '')
             for entry, count in data['sessions']], limit)

    idle, gone = [], []
    rows = []
    for issue, _, updated, recorded, mark in data['held']:
        marker = {'gone': ' GONE', 'idle': ' IDLE', 'elsewhere': ' held elsewhere'}.get(mark or '', '')
        rows.append(line(issue, holder_label(issue['assignee'], known), *hold_marks(board, issue), f'updated {age(updated)} ago'
                         + (f', active {age(recorded)} ago' if recorded else '') + marker))
        if mark == 'idle':
            idle.append(issue['id'])
        elif mark == 'gone':
            gone.append(issue['id'])
    section('held items', rows, limit)
    if any(stale_since(board, issue) for issue, *_ in data['held']):
        print(STALE_OTHERS_LEGEND)
    if gone:
        print(f"  GONE = the holding session ended or its registration was pruned. A deciding session takes {', '.join(gone)}: agents board take <id> (agents board unclaim <id> frees it: the user or a deciding session)")
    if idle:
        print(f'  idle = no activity for {IDLE_HOURS} h. '
              'If that session is gone, a deciding session takes the item: agents board take <id>; otherwise only the user frees it: agents board unclaim <id>')

    section('open questions holding work',
            [line(issue, f'holds {waiting[0]}/{waiting[1]}', issue.get('assignee') or 'unassigned') for waiting, issue in data['questions']],
            limit)
    if data['questions']:
        print(f'  {HOLDS_LEGEND}')
    section('ready milestones', [line(issue, issue.get('assignee') or 'unassigned') for issue in data['milestones']], limit)
    queue_rows(board, args.root, 'position')


def session_kinds(entry: dict, table: dict = ROLE_KINDS) -> tuple[str, ...]:
    kinds = (*table.get(entry.get('role'), ()), *(entry.get('pulls') or ()))
    return tuple(dict.fromkeys((*kinds, *(['refresh'] if 'review' in kinds else []))))  # a review pull also takes the queue head's refresh


def holders(board: Board, args) -> None:
    rows = []
    for issue in board.listed(args.root):
        if issue['status'] != 'closed':
            count = board.holds(issue['id'])
            if count[1]:
                rows.append((count, issue))
    rows.sort(key=lambda pair: (-pair[0][0], -pair[0][1], by_priority(pair[1])))
    section('items holding open work (transitive blocks dependents)',
            [line(issue, f'holds {count[0]}/{count[1]}', issue.get('assignee') or 'unassigned') for count, issue in rows], args.limit)
    if rows:
        print(f'  {HOLDS_LEGEND}')
    queue_rows(board, args.root, 'holders')


# Conformance with skills/shared/board-core.md and board-coordination.md: mechanical classes only.
ACTOR = re.compile(r'[0-9a-f]{8}(/.+)?')
TITLE_PREFIXES = ('[Design]', '[Gate]', '[Checkpoint]', '[Review]')
ITEM_TYPES = (WORK_TYPE, 'decision', 'change-request', 'milestone', 'gate')  # board-core.md Kinds: the one list
CHECK_CLASSES = {  # class -> board-core anchor
    'holder': 'actors-and-holds',
    'unknown-type': 'kinds',
    'unknown-status': 'statuses-and-labels',
    'title-prefix': 'kinds',
    'release-gate': 'kinds',
    'label-status': 'statuses-and-labels',
    'ruling-blocked': 'statuses-and-labels',
    'no-cr': 'change-requests',
    'unknown-metadata': 'kinds',
    'unknown-link': 'dependencies',
    'label-form': 'statuses-and-labels',
    'deferred-blocker': 'deferrals-and-environment-facts',
    'wait-cycle': 'dependencies',
    'cr-settings': 'change-requests',
    'cr-checkpoint': 'change-requests',
    'cr-worktree': 'change-requests',
    'cr-branch': 'change-requests',
    'cr-landing': 'change-requests',
    'cr-git-state': 'actors-and-holds',
}
CHECK_DOCS = {'change-requests': 'change-requests.md', 'deferrals-and-environment-facts': 'board-coordination.md'}  # anchors that live outside board-core.md


def doc_ref(anchor: str) -> str:
    return f"{CHECK_DOCS.get(anchor, 'board-core.md')}#{anchor}"


# Deviations a board command fixes, which /board-migrate does not.
COMMAND_FIXED = ('ruling-blocked', 'wait-cycle')


def dropped_blockers(board: Board) -> set[str]:
    """The records waited on that closed dropped, or whose change request did: the verbs refuse such a close under a live waiter, so a live
    wait on one stands only from outside them. A status snapshot holds no closed record, so those are read here."""
    waited = {b for w, record in board.by_id.items() if record['status'] != 'closed' and group_of(board, record) in (WORK_GROUP, ITEM_GROUP, CR_GROUP)
              for b in board.blockers.get(w, []) if not b.startswith('external:')}
    owner = {b: board.cr_of(b) or b for b in waited}
    unread = sorted({i for i in (*waited, *owner.values()) if i not in board.by_id})
    records = {**board.by_id, **{r['id']: r for r in bd_show(unread, comments=False)}} if unread else board.by_id

    return {b for b in waited if is_dropped_work(records.get(b)) or is_dropped_work(records.get(owner[b]))}


def is_dropped_work(record: dict | None) -> bool:
    """A record closed dropped that a wait can never see delivered (model.md Waits); a question closed dropped releases its waiters instead.
    Every reader checks the target and its change request with it: an item of a request closed dropped never delivers either."""
    return bool(record) and record.get('status') == 'closed' and meta(record).get('outcome') == 'dropped' and record.get('issue_type') != 'decision'


def dropped_targets(board: 'Board', item_id: str) -> list[str]:
    """What the record waits on that closed dropped, itself or with its change request (a complete snapshot: closed records are read)."""
    return [b for b in board.blockers.get(item_id, []) if not b.startswith('external:')
            and (is_dropped_work(board.by_id.get(b)) or is_dropped_work(board.by_id.get(board.cr_of(b) or b)))]


def deviations(board: Board, root: str | None, dropped_targets: set[str] | frozenset[str] = frozenset()) -> list[tuple[str, str, str]]:
    """(id, class, detail) for every convention deviation of a live (not closed) item in scope."""
    found = []
    for issue in board.scoped(root):
        item_id, kind, title = issue['id'], issue.get('issue_type'), issue.get('title', '')
        if issue['status'] == 'closed':
            continue  # closed items are immutable history
        holder = issue.get('assignee')
        if holder and not ACTOR.fullmatch(holder):
            found.append((item_id, 'holder', f'held by {holder}'))
        if kind and kind not in ITEM_TYPES:
            found.append((item_id, 'unknown-type', f'type {kind}'))
        group = group_of(board, issue)
        if group and issue['status'] not in STATES[group]:
            found.append((item_id, 'unknown-status', f"{kind} status {issue['status']} (a {group} is {', '.join(STATES[group])}): follow /board-migrate"))
        prefix = next((p for p in (*TITLE_PREFIXES, *(('user ',) if kind == 'gate' else ())) if title.startswith(p)), None)
        if prefix:
            found.append((item_id, 'title-prefix', f'title starts with {prefix}'))
        if kind == 'gate' and title.startswith('[Gate] Release'):
            found.append((item_id, 'release-gate', 'release gate title'))
        labels = sorted(set(issue.get('labels') or []) & set(LIFECYCLE_LABELS))
        if labels:
            found.append((item_id, 'label-status', f"labels {', '.join(labels)}"))
        foreign = board.foreign_waits(issue)
        if foreign:
            found.append((item_id, 'ruling-blocked', f"in-force ruling waits on {', '.join(foreign)}, work and not planning: "
                                                     f"{'; '.join(dep_fix(item_id, blocker) for blocker in foreign)}"))
        if group in (WORK_GROUP, ITEM_GROUP, CR_GROUP):
            for blocker in sorted(dropped_targets.intersection(board.blockers.get(item_id, []))):
                found.append((item_id, 'dropped-blocker', f'waits on {blocker}, closed dropped, which never delivers: {dep_fix(item_id, blocker)}, or wait on the record that keeps the work'))
        if issue['status'] == 'deferred':
            waiting = deferred_waiters(board, item_id)
            if waiting:
                found.append((item_id, 'deferred-blocker', f"deferred, yet {', '.join(waiting)} wait on it: "
                                                           f"{deferred_fix(board, item_id, waiting)}"))
        if is_work_hold(issue) and board.cr_of(item_id) is None and issue['status'] != 'deferred' and not is_no_commit(issue) \
                and not board.waits_on_decision(item_id):
            found.append((item_id, 'no-cr', f'work item outside any change request: agents board move {item_id} --to <change request>, '
                                            f'or --no-commit for work that commits nothing to this repository'))
        for key in sorted(set(meta(issue)) - BOARD_METADATA - {'checkpoint'}):
            found.append((item_id, 'unknown-metadata', f'metadata {key}: {metadata_fix(issue, key)}'))
        for dep in issue.get('dependencies') or []:
            link, target = dep.get('type') or 'blocks', dep.get('depends_on_id')
            if dep.get('issue_id') == item_id and link not in PASS_LINKS and not blocking(link):
                found.append((item_id, 'unknown-link', f'link {link} to {target}: agents board unlink {item_id} {target}'))
        for label in issue.get('labels') or []:
            if label_shape(label) == 'label-form':
                found.append((item_id, 'label-form', f'label {label}: agents board update {item_id} --unlabel {label} --label topic:{label} (or drop it)'))
    seen_cycles: set[frozenset] = set()
    for issue in board.scoped(root):
        if issue['status'] == 'closed':
            continue
        for blocker in board.open_blockers(issue['id']):
            if (chain := wait_cycle(board, [(issue['id'], blocker)])) and (ring := frozenset(chain[:-1])) not in seen_cycles:
                seen_cycles.add(ring)
                found.append((issue['id'], 'wait-cycle', f"waits form a cycle, nothing in it can start: {' waits on '.join(chain)}; "
                                                          f"agents board unlink {issue['id']} {blocker} breaks it here"))
    return found + cr_deviations(board, root)


def dep_fix(item_id: str, blocker: str) -> str:
    return f'agents board unlink {item_id} {blocker}'


def check_json(board: Board, args) -> dict:
    """Every finding of `board check`, unbudgeted: the deviations by class."""
    return {'deviations': [{'id': item_id, 'class': kind, 'detail': detail} for item_id, kind, detail in deviations(board, args.root, dropped_blockers(board))]}


def check(board: Board, args) -> int:
    limit = args.limit
    found = deviations(board, args.root, dropped_blockers(board))
    print(f'convention deviations: {len(found)}')
    for name, anchor in CHECK_CLASSES.items():
        rows = [f'  {item_id}  {name}  {doc_ref(anchor)}  {detail}'
                for item_id, kind, detail in found if kind == name]
        if rows:
            section(f'{name} ({doc_ref(anchor)})', rows, limit)
    return 1 if found else 0


STOPWORDS = set("""a about after all also an and any are as at be because been before being both but by can could do
does each either for from had has have how if in into is it its may might more most must no not of on once only or other
our out over own same should so such than that the their them then there these they this those through to under until up
use used uses using via was we were what when where whether which while who why will with without would you your""".split())
COMMON_SHARE = 0.2  # a --like word on more of the board's items than this says nothing about the draft
LIKE_TERMS = 15


def lowered(board: Board, issue: dict) -> str:
    cache = board.__dict__.setdefault('_lowered', {})
    if issue['id'] not in cache:
        cache[issue['id']] = board.text(issue).lower()
    return cache[issue['id']]


def related_data(board: Board, args) -> tuple[list[str], list[str], list[tuple[int, dict]], list[tuple[Path, int, str]]]:
    """(terms, words chosen from --like, [(matched terms, item)] rarest matches first, [(doc, line number, text)]).
    Ranks by inverse document frequency: a rare shared word says more than a template word every item carries."""
    scoped = board.scoped(args.root)
    texts = [(issue, lowered(board, issue)) for issue in scoped]
    total = max(len(texts), 1)
    frequency: dict[str, int] = {}

    def weight(term: str) -> float:
        if term not in frequency:
            frequency[term] = sum(1 for _, text in texts if term in text)
        return math.log((total + 1) / (frequency[term] + 1))

    terms = list(dict.fromkeys(term.lower() for term in args.terms))
    chosen = []
    if args.like is not None:
        words = dict.fromkeys(w for w in re.findall(r'[a-z][a-z0-9_.-]*[a-z0-9]', args.like.lower())
                              if len(w) >= 3 and w not in STOPWORDS and w not in terms)
        for word in words:
            weight(word)  # fills frequency
        # A word on no item matches nothing; one on many items is template text.
        candidates = [w for w in words if 0 < frequency[w] <= COMMON_SHARE * total]
        chosen = sorted(candidates, key=lambda w: (-weight(w), w))[:LIKE_TERMS]
        terms += chosen
    rows = []
    for issue, text in texts:
        hits = [term for term in terms if term in text]
        if hits:
            rows.append((sum(weight(term) for term in hits), len(hits), issue))
    rows.sort(key=lambda row: (-row[0], -row[1], by_priority(row[2])))
    matches = []
    for root in (part for value in args.docs for part in value.split(',') if part.strip()):
        path = Path(root.strip())
        files = sorted(path.rglob('*.md')) if path.is_dir() else [path]
        for file in files:
            try:
                lines = file.read_text(encoding='utf-8').splitlines()
            except (OSError, UnicodeDecodeError) as error:
                raise BoardError(f'cannot read {file}: {error}') from None
            matches += [(file, number, text.strip()) for number, text in enumerate(lines, 1)
                        if any(term in text.lower() for term in terms)]
    return terms, chosen, [(count, issue) for _, count, issue in rows], matches


def foreign_queue(board: Board, issue: dict) -> str | None:
    """The queue to name on an item from someone else's: never on an unshared board."""
    if shared is None:
        return None
    queue = board.queue(issue['id'])
    return queue if queue and queue != person() else None


def related_json(board: Board, args) -> dict:
    terms, chosen, rows, docs = related_data(board, args)
    shown = (lambda rows: rows[:args.limit]) if args.limit else (lambda rows: rows)
    return {'terms': terms, 'like': chosen,
            'items': [{'id': issue['id'], 'status': issue['status'], 'type': issue.get('issue_type'),
                       'priority': issue.get('priority'), 'holder': issue.get('assignee') or None,
                       'title': issue.get('title', ''), 'matched': count, 'of': len(terms),
                       **({'queue': foreign_queue(board, issue)} if foreign_queue(board, issue) else {})} for count, issue in shown(rows)],
            'docs': [{'path': str(file), 'line': number, 'text': text} for file, number, text in shown(docs)]}


def related(board: Board, args) -> None:
    terms, chosen, rows, docs = related_data(board, args)
    like = f"; from --like: {', '.join(chosen) or 'no distinctive words'}" if args.like is not None else ''
    section(f"items matching {', '.join(terms)}, rarest matches first (all text fields, closed included{like})",
            [line(issue, f'{count}/{len(terms)} terms', issue.get('assignee') or 'unassigned',
                  f'queue {foreign_queue(board, issue)}' if foreign_queue(board, issue) else '') for count, issue in rows],
            args.limit)
    if args.docs:
        section('doc lines', [f'  {file}:{number}: {text}' for file, number, text in docs], args.limit)


def queue(board: Board, args) -> None:
    ready = sorted((issue for issue in board.listed(args.root) if board.claimable(issue)),
                   key=lambda issue: claim_order(board, issue))

    def marker(issue: dict) -> str:
        milestones = milestones_of(board, issue)
        return f"m:{','.join(milestones)}" if milestones else ''

    for kind in KINDS:
        section(kind, [line(issue, f"p{issue.get('priority', '?')}", marker(issue))
                       for issue in ready if board.claimable(issue) == kind], args.limit)
    shown = {i['id'] for i in board.listed(args.root)}
    accepting = accept_queue(board)
    live = [i for i in accepting + [i for i in live_crs(board) if i not in accepting]
            if i['id'] in shown and i['status'] != 'open']  # open ones are in their pull's section above
    target = refresh_target(board, accepting)
    section('change requests (stage, check state, stack base, problems with their step)',
            [line(i, cr_stage(i) or '', f"check {check_label(i, cr_info(board, i)['state'])}", f"base {meta(i).get('base') or '-'}",
                  *[problem_line(one) for one in cr_problems(board, i, cr_info(board, i), target)],
                  *([f"after {after_base(board, i)}"] if after_base(board, i) else []), i.get('assignee') or '') for i in live], args.limit)
    queue_rows(board, args.root, 'queue')


# board show: items rendered from the snapshot, unwrapped, within READ_BUDGET (`--full` lifts it).

LINK_KINDS = {  # (type, outgoing) -> label from the shown item's side; order is print order
    ('blocks', True): 'blocked by', ('blocks', False): 'blocks', ('parent-child', True): 'parent',
    ('parent-child', False): 'children', ('relates-to', True): 'relates to', ('relates-to', False): 'relates to',
    ('supersedes', False): 'supersedes', ('supersedes', True): 'superseded by',
}
LINK_ORDER = ('blocked by', 'blocks', 'parent', 'children', 'relates to', 'supersedes', 'superseded by', 'revises', 'revision pending')
HEADING = re.compile(r'^(#{2,3})\s+(.+?)\s*#*\s*$')


def normalized(name: str) -> str:
    return ' '.join(name.replace('_', ' ').lower().split())


def comment_list(issue: dict) -> list[dict]:
    return [{'author': c.get('author'), 'created_at': c.get('created_at'), 'text': c.get('text') or ''}
            for c in sorted(issue.get('comments') or [], key=lambda c: c.get('created_at') or '')]


def link_lines(board: Board, issue: dict) -> list[str]:
    grouped: dict[str, list[str]] = {}
    for other, kind, outgoing in board.edges.get(issue['id'], []):
        if kind == REVISES and issue.get('issue_type') == 'decision' and outgoing:
            label = 'revises'
        elif kind == REVISES and not outgoing and board.by_id.get(other, {}).get('issue_type') == 'decision':
            label = 'revision pending'
        else:
            label = LINK_KINDS.get((kind, outgoing), kind if outgoing else f'{kind} (from)')
        target = board.by_id.get(other, {})
        new = issue if label == 'revises' else target if label == 'revision pending' else {}
        rule = (new.get('metadata') or {}).get(REVISES_RULE) if isinstance(new.get('metadata'), dict) else None
        grouped.setdefault(label, []).append(f"  {label}: {other}  {target.get('status', 'not on board')}  "
                                             f"{target.get('title', '')}" + (f'  (partial: {rule})' if rule else ''))
    order = [*LINK_ORDER, *sorted(set(grouped) - set(LINK_ORDER))]
    return [row for label in order for row in sorted(set(grouped.get(label, [])))]  # relates-to may be stored twice


def field_units(issue: dict, field: str) -> list[tuple[str, str]]:
    """(section name, text) chunks of one field: its preamble under the field name, then one per heading."""
    text = str(issue.get(field) or '').strip('\n')
    if not text.strip():
        return []
    units, name, chunk = [], field, [f'{field}:']
    for row in text.splitlines():
        heading = HEADING.match(row)
        if heading:
            if name == field and len(chunk) == 1:  # no preamble: the field label leads its first heading
                name = heading.group(2)
                chunk.append(row)
                continue
            units.append((name, '\n'.join(chunk)))
            name, chunk = heading.group(2), [row]
        else:
            chunk.append(row)
    units.append((name, '\n'.join(chunk)))
    return units


def section_text(issue: dict, field: str, title: str) -> str:
    """A heading's text through the next heading of the same or a higher level."""
    rows, level, out = str(issue.get(field) or '').splitlines(), None, []
    for row in rows:
        heading = HEADING.match(row)
        if level is not None and heading and len(heading.group(1)) <= level:
            break
        if level is None and heading and heading.group(2) == title:
            level = len(heading.group(1))
        if level is not None:
            out.append(row)
    return '\n'.join(out)


def incoming_main_section(main: Path, cr: dict, info: dict, base: str | None = None) -> tuple[str, str]:
    base = base or incoming_base_of(cr)
    commits = incoming_cr_commits(main, cr, base, info.get('baseTip'), info.get('tip'))
    return 'incoming main commits', incoming_main_text(commits, base, info.get('baseTip'))


def incoming_base_of(cr: dict) -> str | None:
    m = meta(cr)
    return m.get('review_base_tip') or m.get('user_seen_base_tip') or m.get('base_sha')


def show_sections(board: Board, issue: dict, query: str) -> list[tuple[str, str]]:
    candidates = [(field, f'{field}:\n' + str(issue.get(field)).strip('\n')) for field in SHOW_FIELDS
                  if str(issue.get(field) or '').strip()]
    if board.is_cr(issue['id']) and issue['status'] == PASSED:
        info = cr_info(board, issue)
        if info.get('main'):
            name, text = incoming_main_section(info['main'], issue, info)
            candidates.append((name, text))
    links = link_lines(board, issue)
    if links:
        candidates.append(('links', 'links:\n' + '\n'.join(links)))
    for field in SHOW_FIELDS:
        candidates += [(name, section_text(issue, field, name)) for name, _ in field_units(issue, field)[1:]
                       if name != field]
    wanted = normalized(query)
    matches = [c for c in candidates if normalized(c[0]) == wanted] \
        or [c for c in candidates if normalized(c[0]).startswith(wanted)]
    names = sorted({name for name, _ in matches})
    if not matches:
        raise BoardError(f"{issue['id']}: no section {query!r}; sections: " + ', '.join(dict.fromkeys(n for n, _ in candidates)))
    if len(names) > 1:
        raise BoardError(f"{issue['id']}: section {query!r} is ambiguous:\n" + '\n'.join(
            f'  agents board show {issue["id"]} --section {shlex.quote(name)}' for name in names))
    return matches


class Budget:
    """Prints units whole while the budget lasts; a unit that doesn't fit prints its first PREVIEW characters and
    the command that prints the rest. Past the budget, one line per item names the remaining sections."""

    def __init__(self, limit: int | None):
        self.remaining, self.skipped = limit, {}

    def out(self, text: str) -> None:
        """Always printed (headers, counts, footers); still spends the budget."""
        print(text)
        if self.remaining is not None:
            self.remaining -= len(text) + 1

    def emit(self, text: str, rest: str, name: str | None = None, item: str | None = None) -> None:
        if self.remaining is None or len(text) + 1 <= self.remaining - 300:  # 300: room for the closing lines
            self.out(text)
        elif self.remaining >= PREVIEW + 500:
            cut = text[:PREVIEW]
            self.out(f'{cut}\n… {len(text) - len(cut)} more chars: {rest}')
        else:
            self.skipped.setdefault(item, []).append((name, rest))

    def flush(self, item: str) -> None:
        skipped = self.skipped.pop(item, [])
        if skipped:
            names = ', '.join(f'"{name}"' for name, _ in skipped[:20]) + (', …' if len(skipped) > 20 else '')
            self.out(f'… {len(skipped)} more sections of {item} ({names}): {skipped[0][1]}')


def review_line(held: dict) -> str:
    """`board show`'s line for an item open for the user's review: the tip it opened at and whether the user edited it."""
    edits = f"edits unreadable: {held.get('why') or 'see agents board cr edits'}" if held['edited'] is None else \
        (f"edited ({', '.join(held['files'][:5])}{' and more' if len(held['files']) > 5 else ''}): not yet recorded as yours" if held['edited'] else 'not edited')
    return f"opened at {held['opened'][:12]}; {edits}"


def show(board: Board, args) -> int:
    known_items(board, args.ids)
    issues = [board.by_id[item_id] for item_id in args.ids]
    known = {key for issue in board.issues for key in issue} | ITEM_FIELDS
    unknown = [field for field in args.fields if field not in known]
    if unknown:
        raise BoardError(f"unknown field {', '.join(unknown)}; fields: {', '.join(sorted(known - {'_type'}))}")
    if args.json:
        # Whole items without --field: the fields the board holds plus the comments, as the --field form shapes them.
        has_reach = not args.fields or any(field in ('holds', 'holdsAll') for field in args.fields)
        reach_board = Board.load('status') if has_reach else None  # show's id snapshot has only direct neighbors; reach is transitive.

        def fields_json(issue, fields):
            reach = reach_board.holds(issue['id']) if any(field in ('holds', 'holdsAll') for field in fields) else None
            return {field: (comment_list(issue) if field == 'comments' else
                            reach[0] if field == 'holds' else reach[1] if field == 'holdsAll' else issue.get(field))
                    for field in fields}

        print(json.dumps({issue['id']: fields_json(issue, args.fields) if args.fields else
                          {**{key: value for key, value in issue.items() if not key.startswith('_')},
                           **fields_json(issue, ('holds', 'holdsAll')), 'comments': comment_list(issue)}
                          for issue in issues}, indent=2, ensure_ascii=False))
        return 0
    budget = Budget(None if args.full else READ_BUDGET)
    full = ' --full'
    for issue in issues:
        item_id = issue['id']
        q = shlex.quote
        header = [item_id, issue['status'], issue.get('issue_type', ''), f"p{issue.get('priority', '?')}",
                  holder(issue) or (f"last held by {issue['assignee']}" if issue.get('assignee') else 'unassigned')]
        if item_id in board.parent:
            header.append(f'parent {board.parent[item_id]}')
        if issue.get('labels'):
            header.append('labels ' + ','.join(issue['labels']))
        if shared is not None:
            header.append(f"queue {board.queue(item_id) or 'unrouted'}")
        harm = (issue.get('metadata') or {}).get(DEEP_REVIEW) if isinstance(issue.get('metadata'), dict) else None
        held = review_of(board, issue)
        if held and held['edited'] is None:
            held = {**held, 'why': (review_read(board, issue) or {}).get('why')}  # the console row carries no reason; show says it
        problems = cr_problems(board, issue, cr_info(board, issue), refresh_target(board)) \
            if board.is_cr(item_id) and issue['status'] != 'closed' else []
        budget.out('  '.join(header) + '\n' + issue.get('title', '') + (f'\ndeep-review: {harm}' if harm else '')
                   + (f'\nopen for your review: {review_line(held)}' if held else '') + ''.join(f'\n{problem_line(one)}' for one in problems))
        selected = bool(args.sections or args.fields or args.comments)
        for query in args.sections:
            for name, text in show_sections(board, issue, query):
                budget.emit(text, f'agents board show {item_id} --section {q(name)}{full}', name, item_id)
        for field in args.fields:
            value = comment_list(issue) if field == 'comments' else issue.get(field)
            text = f'{field}:\n' + (value.strip('\n') if isinstance(value, str) else json.dumps(value, ensure_ascii=False))
            budget.emit(text, f'agents board show {item_id} --field {q(field)}{full}', field, item_id)
        if not selected:
            links = link_lines(board, issue)
            if links:
                budget.emit('links:\n' + '\n'.join(links), f'agents board show {item_id} --section links', 'links', item_id)
            if board.is_cr(item_id) and issue['status'] == PASSED:
                info = cr_info(board, issue)
                if info.get('main'):
                    name, text = incoming_main_section(info['main'], issue, info)
                    budget.emit(text, f'agents board show {item_id} --section {q(name)}', name, item_id)
            for field in SHOW_FIELDS:
                for name, text in field_units(issue, field):
                    budget.emit(text, f'agents board show {item_id} --section {q(name)}', name, item_id)
        comments = comment_list(issue)
        if args.comments or not selected:
            if args.comments and not args.sections and not args.fields:
                budget.out(f'comments only: agents board show {item_id} --full prints the whole item')
            shown = comments if args.comments else comments[-SHOWN_COMMENTS:]
            if comments:
                budget.out(f'comments: {len(comments)}' + (f', newest {len(shown)}' if len(shown) < len(comments) else ''))
            for note in reversed(shown):
                text = note['text'] or ''
                if not (args.comments or args.full) and len(text) > FIELD_LIMIT:
                    text = f'{text[:FIELD_LIMIT]}\n… cut at {FIELD_LIMIT} of {len(text)} characters: agents board show {item_id} --comments'
                budget.emit(f"--- {note['author']} {note['created_at']}\n{text}",
                            f'agents board show {item_id} --comments --full', f"comment {note['created_at']}", item_id)
            if len(shown) < len(comments):
                budget.out(f'… {len(comments) - len(shown)} older: agents board show {item_id} --comments')
        budget.flush(item_id)
    return 0


FIELDS = {'description': 'description', 'design': 'design', 'acceptance': 'acceptance_criteria', 'notes': 'notes'}  # field name -> the item's key
FIELD_ALIASES = {'acceptance_criteria': 'acceptance'}
BASE_FILE = '.base.json'  # per exported item: {field: hash of the text exported}


def scratch_dir() -> Path:
    """This session's scratch folder (bin/scratch dir)."""
    result = subprocess.run([sys.executable, str(REGISTRY.parent / 'scratch'), 'dir'], capture_output=True, text=True)
    if result.returncode != 0 or not result.stdout.strip():
        raise BoardError(f'no scratch folder: {(result.stderr or result.stdout).strip()}')
    return Path(result.stdout.strip())


def field_digest(text: str) -> str:
    return hashlib.sha256(text.encode('utf-8')).hexdigest()


def field_names(given: list[str]) -> list[str]:
    """The fields a `board field` call names (comma lists and repeats; acceptance_criteria is acceptance); every field without any."""
    names = [FIELD_ALIASES.get(name, name) for name in given]
    unknown = [name for name in names if name not in FIELDS]
    if unknown:
        raise BoardError(f"unknown field {', '.join(unknown)}; fields: {', '.join(FIELDS)}")
    return list(dict.fromkeys(names)) or list(FIELDS)


class FieldFolder:
    """One item's exports: `<scratch>/fields/<id>/<field>.md` and `.base.json`, the hash of each text as exported."""

    def __init__(self, item_id: str):
        if not re.fullmatch(r'[0-9A-Za-z][0-9A-Za-z._-]*', item_id) or '..' in item_id:
            raise BoardError(f'{item_id!r} is not an item id')
        self.id = item_id
        self.folder = scratch_dir() / 'fields' / item_id
        try:
            base = json.loads((self.folder / BASE_FILE).read_text(encoding='utf-8'))
        except (OSError, ValueError):
            base = {}
        self.base = base if isinstance(base, dict) else {}

    def path(self, field: str) -> Path:
        return self.folder / f'{field}.md'

    def edited(self, field: str) -> bool:
        """The export of this field exists and is not what was exported (a file without a recorded export counts as edited)."""
        try:
            return field_digest(self.path(field).read_text(encoding='utf-8')) != self.base.get(field)
        except OSError:
            return False
        except UnicodeDecodeError:
            return True

    def save(self) -> None:
        self.folder.mkdir(parents=True, exist_ok=True)
        (self.folder / BASE_FILE).write_text(json.dumps(self.base, indent=1), encoding='utf-8')

    def drop(self, field: str) -> None:
        self.path(field).unlink(missing_ok=True)
        self.base.pop(field, None)
        if self.base:
            self.save()
        else:
            (self.folder / BASE_FILE).unlink(missing_ok=True)
            try:
                self.folder.rmdir()
            except OSError:
                pass  # another file lives there: not ours to remove


def field_export(board: Board, args) -> int:
    """`board field export <id>... [--field F]...`: each field's text in a scratch file to edit in place, never rewrite from memory.
    An export edited since and not applied is never overwritten (apply or discard it); an untouched one is refreshed."""
    names = field_names(args.fields)
    known_items(board, args.ids)
    folders = {item_id: FieldFolder(item_id) for item_id in dict.fromkeys(args.ids)}
    kept = [(item_id, name) for item_id, folder in folders.items() for name in names if folder.edited(name)]
    if kept:
        raise BoardError('; '.join(f'{item_id} {name}: the export was edited since and not applied (agents board field apply {item_id} --field {name}, '
                                   f'or agents board field discard {item_id} --field {name})' for item_id, name in kept) + '; nothing exported')
    for item_id, folder in folders.items():
        for name in names:
            text = board.by_id[item_id].get(FIELDS[name]) or ''
            folder.folder.mkdir(parents=True, exist_ok=True)
            folder.path(name).write_text(text, encoding='utf-8')
            folder.base[name] = field_digest(text)
            print(folder.path(name))
        folder.save()
    return 0


def field_apply_one(board: Board, item_id: str, names: list[str] | None) -> list[str]:
    """Writes one item's edited exports with one `bd update`; the lines it printed. Refuses the whole item (files kept) when a field
    changed on the board since its export, an edited file is empty, or the size limit holds a field back."""
    if item_id not in board.by_id:
        raise BoardError(f'{item_id}: unknown')
    folder = FieldFolder(item_id)
    exported = [name for name in FIELDS if name in folder.base]
    chosen = exported if names is None else names
    absent = [name for name in chosen if name not in exported]
    if absent or not chosen:
        flags = ''.join(f' --field {name}' for name in absent)
        raise BoardError(f"{item_id}: no export of {', '.join(absent) or 'any field'}: re-export with agents board field export {item_id}{flags} "
                         f"or discard with agents board field discard {item_id}{flags}")
    issue, lines, changes = board.by_id[item_id], [], {}
    texts = {}
    for name in chosen:
        try:
            texts[name] = folder.path(name).read_text(encoding='utf-8')
        except (OSError, UnicodeDecodeError) as error:
            raise BoardError(f'{item_id}: cannot read the export of {name} ({error}); re-export with agents board field export {item_id} --field {name} '
                             f'or discard with agents board field discard {item_id} --field {name}') from None
    edited = [name for name in chosen if field_digest(texts[name]) != folder.base[name]]
    moved = [name for name in edited if field_digest(issue.get(FIELDS[name]) or '') != folder.base[name]]  # an unedited field is not written: it may move
    if moved:
        raise BoardError(f"{item_id}: {', '.join(moved)} changed on the board since the export; nothing applied, your files stay: "
                         f"copy what you need, agents board field discard {item_id} --field {', '.join(moved)}, agents board field export {item_id} --field {', '.join(moved)}, edit again")
    empty = [name for name in edited if not texts[name].strip()]
    if empty:
        raise BoardError(f'{item_id}: the export of {empty[0]} is empty: a field is never cleared this way; edit the text instead; nothing applied')
    for name in chosen:
        if name in edited:
            changes[name] = texts[name]
        else:
            folder.drop(name)
            lines.append(f'{item_id}: {name} unchanged')
    if changes:
        flags = []
        for name in changes:
            if name in ('description', 'design'):
                flags += ['--body-file' if name == 'description' else '--design-file', str(folder.path(name))]
            else:
                flags.append(f"--{'acceptance' if name == 'acceptance' else 'notes'}={changes[name]}")
        # The size limit board applies to every long-field write (a work item's field over FIELD_LIMIT, unless it shrinks).
        refusal = size_refusal(issue, {FIELDS[name]: text for name, text in changes.items()})
        if refusal:
            raise BoardError(f'{refusal} Nothing applied for {item_id}; your files stay.')
        write_fields(board, [item_id], flags)  # an item of a held change request is its holder's to write (nixes-cs2mp)
        for name, text in changes.items():
            old = issue.get(FIELDS[name]) or ''
            folder.drop(name)
            lines.append(f'{item_id}: {name} updated ({len(old)} -> {len(text)} characters)')
    return lines


def field_apply(board: Board, args) -> int:
    """`board field apply <id>... [--field F]...`: one `bd update` per item with all its edited fields; items are independent."""
    names = field_names(args.fields) if args.fields else None
    failed = False
    for item_id in dict.fromkeys(args.ids):
        try:
            for line in field_apply_one(board, item_id, names):
                print(line)
        except BoardError as error:
            report_error(error)
            failed = True
    return 2 if failed else 0


def field_discard(args) -> int:
    """`board field discard <id>... [--field F]...`: removes the exports, edited or not."""
    names = field_names(args.fields)
    for item_id in dict.fromkeys(args.ids):
        folder = FieldFolder(item_id)
        gone = [name for name in names if name in folder.base or folder.path(name).exists()]
        for name in gone:
            folder.drop(name)
        print(f"{item_id}: discarded {', '.join(gone) or 'nothing (no export)'}")
    return 0


def budgeted(run, board: Board, args, argv: list[str]) -> int:
    """Runs a view within READ_BUDGET. Rows are the indented lines; --offset skips that many, keeping the heading of
    the section it lands in. A cut names the --offset that prints the next rows."""
    output = io.StringIO()
    with contextlib.redirect_stdout(output):
        code = run(board, args) or 0
    lines = output.getvalue().splitlines()
    kept, size, row, pending, cut, heading = [], 0, 0, [], None, None
    for text in lines:
        is_row = text.startswith('  ')
        if row < args.offset:
            if is_row:
                row += 1
                pending = [heading] if heading else []  # the section heading prints again before its next shown row
            else:
                heading = text
                pending.append(text)
            continue
        block = [*pending, text] if is_row else [text]
        cost = sum(len(item) + 1 for item in block)
        if size + cost > READ_BUDGET - 300:
            cut = row
            break
        kept += block
        size += cost
        pending = []
        row += is_row
    if pending and cut is None:
        kept += pending
    print('\n'.join(kept))
    if cut is not None:
        words, skip = [], False
        for word in argv:
            if skip:
                skip = False
            elif word == '--offset':
                skip = True
            elif not word.startswith('--offset='):
                words.append(word)
        total = sum(1 for text in lines if text.startswith('  '))
        print(f'… {total - cut} more rows: agents board {shlex.join([*words, "--offset", str(cut)])}')
    return code


# Writes

def caller() -> str:
    actor = derived_actor()
    if not actor:
        raise BoardError('no actor: run inside a Claude Code or Codex session, or set BEADS_ACTOR')
    return actor


HANDOVER = 'board handover: '
DEFERRED_BY = 'deferred_by'  # metadata of a deferred record: 'user' or the deferring session's actor; only that side undefers
REVISIT = 'revisit'  # metadata of a deferred record: a day (YYYY-MM-DD) from which it shows as due; nothing reopens by itself
HOLD = 'hold'  # change-request metadata: 'work' while the holder works it in its worktree, 'plan' while a planner holds it (claim writes it, every release clears it)


AUTHOR = 'author'  # metadata: the actor that handed the change request over, written by the hand-over (no rule reads a comment)
RESUME_NOTE = 'resume'  # metadata: the next action of work handed back unfinished; the next claim prints and clears it


def self_review_refusal(issue: dict, actor: str, agreed: bool = False) -> str | None:
    """Why this actor may not review the change request in review: it handed it over, or it is the session whose worker did (it
    briefed that worker); another worker of the session starts fresh and may. The user's word (`agreed`) lifts it. No recorded
    author fails closed."""
    if issue['status'] != 'in_review' or agreed:
        return None
    author = meta(issue).get(AUTHOR)
    if not author:
        return f"{issue['id']}: no author is recorded for its hand-over, so its independence cannot be shown: /board-migrate records it"
    if actor in (author, session_actor(author)):
        return (f"{issue['id']}: your own hand-over (by {author}) needs a fresh worker as reviewer, or the user's word: "
                f'agents board claim {issue["id"]} --agreed "<what they said>"')
    return None


def author_label(issue: dict) -> str:
    author = meta(issue).get(AUTHOR)
    return f'author {author}' if author else 'author unknown'


NO_COMMIT = 'no_commit'  # a work item that by design commits nothing to this repository (a run, an external step): it needs no CR. Stored as
# JSON true: bd parses `--set-metadata k=1` to a number and a graph node keeps a string, so a boolean is the one form both writes give
CR_SETTINGS = {'look': ('before', 'after'), 'view': ('code', 'result')}  # a CR's own settings (change-requests.md)


def metadata_fix(issue: dict, key: str) -> str:
    """The fix board check names for a metadata key the board does not own: it may be another tool's, so the reader decides."""
    return f"not the board's: drop it if nothing else uses it (agents board bd --raw --yes update {issue['id']} --unset-metadata {key})"


def is_no_commit(issue: dict) -> bool:
    return issue.get('issue_type') == WORK_TYPE and meta(issue).get(NO_COMMIT) is True


def setting_refusal(item_id: str, kind: str | None, settings: dict[str, object]) -> str | None:
    """Why these item settings (create, a graph node, update) do not fit the item: no_commit on unassigned or agent work items only, a CR's
    own settings on change requests from their value sets, look and view only to override the project default (r10-q52)."""
    for name, value in settings.items():
        if name == NO_COMMIT:
            if value is not True:
                return f'{item_id}: no_commit is true or absent'
            if kind != WORK_TYPE:
                return f'{item_id}: no_commit marks a task'
            continue
        if kind != CR_TYPE:
            return f'{item_id}: {name} is a change request setting'
        if value not in CR_SETTINGS[name]:
            return f"{item_id}: {name} is one of {', '.join(CR_SETTINGS[name])}"
    return default_look_refusal([(name, str(value)) for name, value in settings.items() if name in ('look', 'view')])


def is_work_hold(issue: dict) -> bool:
    return issue.get('issue_type') == WORK_TYPE


def in_hand(issue: dict, actor: str) -> bool:
    """Work in hand of the actor's session: an open item it holds, its own hold or one of its workers'. A claim keeps the status, so
    a request in review or an in-force ruling a session holds is not in hand."""
    holder = issue.get('assignee')
    return bool(holder) and issue['status'] == 'open' and session_actor(holder) == session_actor(actor)


def counted_holds(board: Board, actor: str) -> list[dict]:
    """The work items a worker cap counts for this actor: held by exactly this actor (a worker's holds are not its session's).
    Decisions and the change requests an acceptor or reviewer holds are not work in hand."""
    return [issue for issue in board.issues if issue['status'] == 'open' and issue.get('assignee') == actor and is_work_hold(issue)]


def own_entry(board: Board, actor: str) -> dict | None:
    """The calling session's registration: None for an unregistered session (no cap, r3-q16). A registration that exists
    but cannot be read is no such session: claims and takeovers are refused until it registers again."""
    entry = board.registry().get(session_actor(actor))
    if entry is None and session_actor(actor) in board.unreadable():
        raise BoardError("this session's registration is unreadable. Register again: /role <role> (Codex: $role <role>)")
    return entry


def cap_refusal(board: Board, entry: dict | None, actor: str, claimed: list[dict]) -> str | None:
    """Why this actor may not claim one more work item, None when it may (an unregistered session has no cap)."""
    if entry is None:
        return None
    held = len({issue['id'] for issue in counted_holds(board, actor)} | {issue['id'] for issue in claimed if is_work_hold(issue)})  # claims and takeovers this call included
    cap = worker_cap(entry)
    return f'{actor} holds {held} of {cap} work items (its worker cap)' if held >= cap else None


def forced_reason(issue: dict) -> str | None:
    """The reason the current holder held the item past its cap, None when the hold is within it."""
    metadata = issue.get('metadata') if isinstance(issue.get('metadata'), dict) else {}
    return str(metadata.get(FORCED_REASON) or '') if metadata.get(FORCED_BY) == issue.get('assignee') and issue.get('assignee') else None


def stale_since(board: Board, issue: dict) -> datetime | None:
    """The last update of a held work item without one for STALE_HOURS, else None (needs its comments hydrated)."""
    holder = issue.get('assignee')
    updated = board.last_activity(issue)
    if not holder or not is_work_hold(issue) or updated is None:
        return None
    return updated if (utcnow() - updated).total_seconds() > STALE_HOURS * 3600 else None


def hold_marks(board: Board, issue: dict) -> list[str]:
    forced = forced_reason(issue)
    return [*(['STALE'] if stale_since(board, issue) else []), *([f'FORCED: {forced}'] if forced is not None else [])]


STALE_OTHERS_LEGEND = (f'  STALE = no update to the item for {STALE_HOURS} h: ask its holder what it waits on; the holder moves it on or renews it by '
                       'updating its notes. Only the holder or the user frees it, a deciding session once its session is gone (agents board take | agents board unclaim)')
STALE_LEGEND = (f'  STALE = no update to the item for {STALE_HOURS} h: find out what it waits on, then move it on, agents board unclaim it, '
                'or renew it by updating its notes with what it waits on')


def held_by_session(board: Board, actor: str) -> list[dict]:
    session = session_actor(actor)
    return sorted((issue for issue in board.issues if (held := holder(issue)) and (held == session or held.startswith(session + '/'))),
                  key=by_priority)


def mine_data(board: Board, args) -> tuple[str, list[tuple[dict, bool]]]:
    """(caller actor, [(item held by its session, worker stopped)])."""
    actor = caller()
    board.hydrate(board.held_ids())
    scoped = {issue['id'] for issue in board.scoped(args.root)}
    try:
        entry = board.registry().get(session_actor(actor))
    except BoardError:
        entry = None  # no marks without the registry; the holds still list
    return actor, [(issue, worker_stopped(entry, issue)) for issue in held_by_session(board, actor) if issue['id'] in scoped]


def console_counts(board: Board, views: dict, position: dict) -> dict:
    """The health counts, the agents' steps (plan, implement, review) as `board position` counts what a claim gives
    each pull: a review pull takes refresh work too."""
    counts = health_counts(board, views)
    step = lambda *kinds: {name: sum(position['ready'][kind][name] for kind in kinds) for name in ('ready', 'held', 'waiting')}
    ordered: dict = {}
    for name, value in counts.items():
        if name == 'toPlan':
            value = step('plan')
        if name == 'toReview':
            ordered |= {'toImplement': step('implement')}
            value = step('review', 'refresh')
        ordered[name] = value
    return ordered


def console_json(board: Board, args) -> dict:
    """What the console pane draws, from one snapshot: health counts, the user's ready items, this session's holds, the
    sessions and every hold with its idle or gone mark. `crs` lists the requests waiting for the user and those in work;
    `queued` counts the rest."""
    position = position_json(board, args)
    views = health_views(board, args.root)  # counts and forYou only: health's deviations, claimable kinds and milestones are not read
    queue = accept_queue(board)
    listed, answering, queued = console_crs(board, queue)
    return {**({'sync': (shared.problem() or shared.store_warning()), 'queueLine': queue_line(board, args.root)} if shared else {}),
            'noBoard': False, 'prefix': board_prefix(),
            'counts': {**console_counts(board, views, position),
                       'deferred': sum(1 for issue in board.scoped(args.root) if issue['status'] == 'deferred')},  # the backlog, any type
            'forYou': [item_json(board, issue) for issue in sorted(views['user'][1], key=by_priority)
                       if not step_blocked(board, 'user', issue) and not held_by_a_session(issue)],  # the ready part of forUser
            'items': [item for item in mine_json(board, args)['items'] if item['type'] != CR_TYPE],  # held CRs show in crs
            'crs': crs_json(board, listed, queue), 'waitingOnYou': answering, 'queued': queued,
            'sessions': position['sessions'],
            'held': [{'id': h['id'], 'holder': h['holder'], 'mark': h['mark']} for h in position['held']]}


def no_board_json() -> dict:
    """`board console` outside a board: the same shape, empty. Not an error; a bd failure on a board still is one."""
    return {'noBoard': True, 'counts': None, 'forYou': [], 'items': [], 'crs': [], 'waitingOnYou': 0, 'queued': 0, 'prefix': None, 'sessions': [], 'held': []}


def has_board() -> bool:
    return beads_dir() is not None


def console(board: Board, args) -> None:
    print(json.dumps(console_json(board, args), indent=2, ensure_ascii=False))


def mine_json(board: Board, args) -> dict:
    actor, rows = mine_data(board, args)
    return {'session': session_actor(actor), 'actor': actor,
            'items': [item_json(board, issue, updatedAt=iso(board.last_activity(issue)), workerStopped=stopped)
                      for issue, stopped in rows]}


def mine(board: Board, args) -> None:
    actor, held_rows = mine_data(board, args)
    you = f' (you: {actor})' if actor != session_actor(actor) else ''
    rows, stopped = [], []
    for issue, mark in held_rows:
        rows.append(line(issue, issue['assignee'], *hold_marks(board, issue), f'updated {age(board.last_activity(issue))} ago'
                         + (' WORKER STOPPED' if mark else '')))
        if mark:
            stopped.append(issue['id'])
    section(f'held by session {session_actor(actor)}{you}', rows, args.limit)
    if any(stale_since(board, issue) for issue, _ in held_rows):
        print(STALE_LEGEND)
    if stopped:
        print(f"  WORKER STOPPED = the holding worker finished its last turn ({', '.join(stopped)}): "
              'continue the worker, hand the item over, or free it (agents board unclaim <id>)')


def capacity(board: Board, args) -> None:
    """The session's refill hint: printed for the session itself (no worker caller) in a dispatching role while
    fewer than its cap of workers were active and worker work (WORKER_KINDS within the session's pulls) is
    claimable. A session's own hand-overs count: another of its workers may review them. The snapshot predates a write, so the
    items the command named or claimed are left out (one read per command). Never fails the command it follows."""
    actor = derived_actor()
    if not actor or actor != session_actor(actor):
        return
    try:
        entry = board.registry().get(actor)
        pulls = entry.get('pulls') or () if entry else ()
        if entry is None or not pulls:
            return
        active, cap = len(active_workers(entry)), worker_cap(entry)
        if active >= cap:
            return
        kinds = tuple(kind for kind in WORKER_KINDS if kind in pulls)
        changed = {*(getattr(args, 'ids', None) or ()), getattr(args, 'id', None), *getattr(args, 'claimed', ())}
        counts = {kind: sum(1 for issue in board.listed(args.root)
                            if board.claimable(issue) == kind and issue['id'] not in changed) for kind in kinds}
    except BoardError:
        return
    ready = sorted(((kind, count) for kind, count in counts.items() if count), key=lambda pair: -pair[1])
    if ready:
        print(f"capacity: {active} of {cap} workers active in the last {WORKER_ACTIVE_MINUTES} min; "
              f"ready for your pulls: {', '.join(f'{kind} {count}' for kind, count in ready)} → refill (plan Dispatch)")


def claim_one(board: Board, issue: dict, actor: str, fields: dict | None = None, agreed: bool = False) -> tuple[bool, str]:
    """Atomically claim one item: the holder is written only if it is still empty (and, for a change request, the status is the
    one just read: a planner can finish Return after a reviewer reads the unassigned CR)."""
    try:
        result = move(issue, 'claim', actor=actor, fields=fields, check=False, board=board, agreed=frozenset({'non-author'}) if agreed else frozenset())
    except BoardError as error:
        return False, str(error)
    return result.returncode == 0, (result.stderr or result.stdout).strip()


def in_work(cr: dict) -> bool:
    """A change request its holder works in its worktree: open, held, hold kind work. A planner's hold is kind plan (claim writes it)."""
    return cr['status'] == 'open' and bool(cr.get('assignee')) and meta(cr).get(HOLD) == 'work'


def foreign_claim(board: Board, item_id: str) -> str | None:
    """Why this item can't be claimed from this queue, with the move that allows it: another person's queue, or none
    (unrouted, an inbox item included) until a lead routes it."""
    if shared is None:
        return None
    queue, mine = board.queue(item_id), person()
    if queue == mine and queue is not None:
        return None
    if queue is None:
        names = ','.join(board.queues(item_id))
        why = f'parents in queues {names}' if names else 'no queue'
        return f'{item_id}: unrouted ({why}); a lead or solo session routes it first: agents board route <person> {item_id}'
    return f"{item_id}: in {queue}'s queue; a lead or solo session moves it first: agents board route {mine or '<you>'} {item_id}"


def mark_forced(issue: dict, actor: str, reason: str | None) -> None:
    """Record a hold past the cap with its reason; a hold within it drops a mark the item's earlier holder left."""
    metadata = issue.get('metadata') if isinstance(issue.get('metadata'), dict) else {}
    if reason is not None:
        put_meta(issue, **{FORCED_BY: actor, FORCED_REASON: reason})
    elif FORCED_BY in metadata:
        put_meta(issue, **{FORCED_BY: None, FORCED_REASON: None})


def held_skips(board: Board, scoped: list[dict], kinds: list[str], actor: str) -> list[str]:
    """What a bare claim passed over: items of its kinds that another session holds, with holder, state and age
    (an empty queue is not a held item)."""
    skipped = [issue for issue in scoped if held_by_a_session(issue)
               and session_actor(issue['assignee']) != session_actor(actor)
               and board.step_kind(issue) in kinds and not board.waits_of(issue)]
    board.hydrate([issue['id'] for issue in skipped])
    known = board.registry()
    lines = []
    for issue in skipped:
        gone = holder_gone(board, known, issue['assignee'])
        lines.append(f"  held: {issue['id']} {issue['status']}, held by {issue['assignee']} ({'gone' if gone else 'live'}), "
                     f"updated {age(board.last_activity(issue))} ago")
    return lines


def waiting_skips(board: Board, scoped: list[dict], kinds: tuple[str, ...]) -> list[str]:
    """What a bare claim passed over as waiting: unheld items of its kinds and what each waits on."""
    return [f"  waiting: {issue['id']} on {', '.join(board.waits_of(issue))}" for issue in scoped
            if not issue.get('assignee') and board.kind(issue) in kinds and board.waits_of(issue)]


WATCH_SECONDS = 60  # poll gap of `board watch`: a read of the board takes about a second


def watch_command(board: Board, args) -> int:
    """Blocks until a bare `board claim` would have a candidate (claim_candidates), prints it and exits 0; claims nothing.
    Exit 3 once --timeout passes, 1 when the session's registration is gone. Each poll reads the board anew."""
    actor, end = caller(), None if args.timeout is None else time.monotonic() + args.timeout
    while True:
        entry = own_entry(board, actor)
        kinds = claim_kinds(board, entry, actor)
        found = next(claim_candidates(board, board.listed(args.root), kinds, actor, entry), None)
        if found is not None:
            print(f"claimable: {found['id']} ({board.claimable(found)}) {found.get('title', '')}")
            return 0
        if end is not None and time.monotonic() >= end:
            print('nothing claimable yet')
            return 3
        time.sleep(WATCH_SECONDS if args.interval is None else args.interval)
        if shared is not None:
            with contextlib.suppress(OSError, ValueError, BoardError, subprocess.SubprocessError):
                shared.before()  # the pull a command start makes
        board = Board.load('status', None)
        set_view(board, getattr(args, 'queue', None))


def claim_kinds(board: Board, entry: dict | None, actor: str) -> tuple[str, ...]:
    """The kinds a bare claim takes from: the calling session's pulls (the refusals a bare claim and `board watch` share)."""
    if entry is None:
        raise BoardError(f'no registered role for session {session_actor(actor)}; run /role first')
    if shared is not None and person() is None:
        raise BoardError(f'a bare claim takes from your queue: {PERSON_HELP}')
    return session_kinds(entry)


def claim_candidates(board: Board, scoped: list[dict], kinds: tuple[str, ...], actor: str, entry: dict,
                     passed: list[str] | None = None) -> Iterator[dict]:
    """What a bare claim tries, in claim order: claimable in the session's kinds, minus its own hand-overs (the author is
    metadata on the item, `self_review_refusal`) and open work past the worker cap, which a named claim refuses too (noted in `passed`)."""
    for issue in sorted((i for i in scoped if board.claimable(i) in kinds), key=lambda i: claim_order(board, i)):
        if board.claimable(issue) == 'review' and self_review_refusal(issue, actor):
            continue  # your own hand-over needs another reviewer
        if is_work_hold(issue) and issue['status'] == 'open' and (over := cap_refusal(board, entry, actor, [])):
            if passed is not None:
                passed.append(f'  at your worker cap ({over}): {issue["id"]}; agents board claim {issue["id"]} --force "<reason>" takes it')
            continue  # a review hold counts against no cap
        yield issue


def claim(board: Board, args) -> int:
    actor = caller()
    claimed, failed, forced = [], [], {}
    entry = own_entry(board, actor)
    if args.ids:
        for item_id in args.ids:
            issue = board.by_id.get(item_id)
            if issue is None or issue['status'] == 'closed':
                raise BoardError(f'{item_id}: unknown or closed')
        for item_id in args.ids:
            issue = board.by_id[item_id]
            holder = issue.get('assignee')
            if refusal := item_hold_refusal(board, issue):
                failed.append(item_id)
                print(refusal, file=sys.stderr)
                continue
            if holder == actor:
                print(f'{item_id}: already held by {actor}')  # bin/protocol reads this line (claim_items)
                kind = board.kind(issue) if board.is_cr(item_id) else None
                if kind == 'implement' and meta(issue).get(HOLD) == 'plan':  # a planner's hold becomes work: worktree and setup as a fresh claim
                    if claim_cr_checked(board, issue, actor, kind, claimed, failed):
                        issue['claim_kind'] = kind
                elif in_work(issue):  # a failed setup is rerun by claiming again (q222)
                    failure = ensure_setup(board, issue, cr_worktree(main_root(), item_id))
                    print(f'  setup failed:\n{failure}' if failure is not None else '  setup passed')
                continue
            if not board.is_cr(item_id) and holder and session_actor(holder) == session_actor(actor):
                # The session owns its workers' holds (design item 16): hand the item down. A work item counts against the cap.
                over = cap_refusal(board, entry, actor, claimed) if is_work_hold(issue) else None
                if over and args.force is None:
                    failed.append(item_id)
                    print(f'{item_id}: not taken over: {over}; hand over or unclaim one, or agents board claim {item_id} --force "<reason>"', file=sys.stderr)
                    continue
                move(issue, 'take', board=board, actor=actor)
                comment(item_id, f'board claim: {actor} took this item over from {holder} in the same session.')
                claimed.append(issue)
                forced[item_id] = args.force if over else None
                continue
            refusal = foreign_claim(board, item_id) or work_item_refusal(board, issue, actor)
            if refusal:
                failed.append(item_id)
                print(refusal, file=sys.stderr)
                continue
            if holder and shared is not None and ACTOR.fullmatch(holder) and session_actor(holder) not in board.registry():
                failed.append(item_id)
                print(f'{item_id}: held elsewhere by {holder}, updated {age(board.last_activity(issue))} ago', file=sys.stderr)
                continue
            if holder:
                failed.append(item_id)
                print(f'{item_id}: held by {holder}; once its session is gone, a deciding session takes it with agents board take {item_id}; otherwise only the user frees it with agents board unclaim',
                      file=sys.stderr)
                continue
            if board.kind(issue) == 'milestone' and not board.milestone_ready(item_id):
                # Accepting a milestone needs its work done (board-coordination.md#milestones).
                failed.append(item_id)
                print(f"{item_id}: milestone not ready, its work is open: {', '.join(sorted(board.milestone_work(item_id)))}", file=sys.stderr)
                continue
            if not board.is_cr(item_id) and (waits := board.waits_of(issue)):
                failed.append(item_id)  # readiness: unheld and every wait met (board model, Readiness)
                print(f"{item_id}: not claimable: waits on {', '.join(waits)}", file=sys.stderr)
                continue
            if board.is_cr(item_id):
                kind = board.claimable(issue)
                if kind is None and issue['status'] == PASSED and after_base(board, issue) and may_attend(board):
                    # a passed look-after child waiting for its parent: a deciding session takes it so it can return it
                    ok, message = claim_one(board, issue, actor)
                    if ok:
                        put_meta(issue, reviewing_tip=None)
                        claimed.append(issue)
                        issue['claim_kind'] = 'review'
                    else:
                        failed.append(item_id)
                        print(f'{item_id}: not claimed: {message}', file=sys.stderr)
                    continue
                if kind is None and board.kind(issue) == 'accept' and autopilot_barred(board):
                    failed.append(item_id)
                    print(f"{item_id}: not claimable: a finished change request waits for the user's Accept",
                          file=sys.stderr)
                    continue
                if kind is None and board.kind(issue) == 'accept' and accept_waits(board, issue) and not cr_worktree_state(board, issue):
                    kind = 'accept'  # named: the Accept protocol may still return or reject it; landing refuses while it waits
                if kind is None:
                    failed.append(item_id)
                    why = [problem_line(one) for one in cr_problems(board, issue, cr_info(board, issue), refresh_target(board))]
                    if refusal := open_refusal(item_id, issue, 'a claim'):
                        why.append(refusal)
                    print(f"{item_id}: not claimable ({issue['status']})" + ''.join(f'\n  {line}' for line in why), file=sys.stderr)
                    continue
                if claim_cr_checked(board, issue, actor, kind, claimed, failed, bool(args.agreed)):
                    issue['claim_kind'] = kind
                continue
            over = cap_refusal(board, entry, actor, claimed) if is_work_hold(issue) else None
            if over and args.force is None:
                failed.append(item_id)
                print(f'{item_id}: not claimed: {over}; hand over or unclaim one, or agents board claim {item_id} --force "<reason>"', file=sys.stderr)
                continue
            ok, message = claim_one(board, issue, actor)
            if ok:
                claimed.append(issue)
                forced[item_id] = args.force if over else None
            else:
                failed.append(item_id)
                print(f'{item_id}: not claimed: {message}', file=sys.stderr)
    else:
        if args.force is not None:
            raise BoardError('--force holds a named item past your worker cap: agents board claim <id> --force "<reason>"')
        if args.agreed is not None:
            raise BoardError('--agreed names the change request you review on the user\'s word: agents board claim <id> --agreed "<what they said>"')
        kinds, passed = claim_kinds(board, entry, actor), []
        scoped = board.listed(args.root)
        for issue in claim_candidates(board, scoped, kinds, actor, entry, passed):
            if issue.get('issue_type') == CR_TYPE:
                kind = board.claimable(issue)
                if claim_cr_checked(board, issue, actor, kind, claimed, failed):
                    issue['claim_kind'] = kind
                    break
                continue
            ok, _ = claim_one(board, issue, actor)
            if ok:
                claimed.append(issue)
                break
        for hint in passed:
            print(hint)
        if not claimed:
            print(f"nothing claimable for {entry.get('role')} ({','.join(kinds)})")
            for skipped in [*held_skips(board, scoped, kinds, actor), *waiting_skips(board, scoped, kinds)]:
                print(skipped)
    args.claimed = [issue['id'] for issue in claimed]
    for issue in claimed:
        kind = issue.get('claim_kind') or board.kind(issue) or issue.get('issue_type')
        by = f'; {author_label(issue)}' if issue['status'] == 'in_review' and kind == 'review' else ''
        inherited = effective_priority(board, issue)
        counts_as = f"; P{issue.get('priority', 9)}, counts as P{inherited[0]}: {'its item' if inherited[2] else 'blocks'} {inherited[1]}" if inherited[1] else ''
        print(f"claimed {issue['id']} ({kind}{by}{counts_as}): {issue.get('title', '')}")
        if args.agreed and kind == 'review' and self_review_refusal(issue, actor):
            comment(issue['id'], f'board claim: {actor} reviews its own hand-over (agreed: {args.agreed}).')
        if kind == 'refresh':
            print(f"  refresh work: agents board cr refresh {issue['id']}, then agents board unclaim {issue['id']}")
        if resume := meta(issue).get(RESUME_NOTE):
            print(f'  resume: {resume}')
            put_meta(issue, **{RESUME_NOTE: None})  # printed once
        for blocker in board.foreign_waits(issue):  # an in-force ruling waits for planning only (r21-q139): the plan session removes it
            print(f"  fix: {issue['id']} waits on {blocker}, which is work and not planning; check what the ruling changes there, "
                  f"then {dep_fix(issue['id'], blocker)}")
        if issue['id'] in forced:
            mark_forced(issue, actor, forced[issue['id']])
    still = [issue for issue in held_by_session(board, actor) if issue not in claimed]
    if still:
        board.hydrate([issue['id'] for issue in still])  # staleness reads the comments
        section('this session still holds', [line(issue, issue['assignee'], *hold_marks(board, issue), f'updated {age(board.last_activity(issue))} ago')
                                                  for issue in still])
        if any(stale_since(board, issue) for issue in still):
            print(STALE_LEGEND)
    return 1 if failed or not (claimed or args.ids) else 0


def claim_cr_checked(board: Board, issue: dict, actor: str, kind: str, claimed: list, failed: list, agreed: bool = False) -> bool:
    """claim_cr with its refusals printed: a git or setting failure leaves the CR unclaimed."""
    try:
        ok, message = claim_cr(board, issue, actor, kind, agreed)
    except BoardError as error:
        failed.append(issue['id'])
        print(f"{issue['id']}: not claimed: {error}", file=sys.stderr)
        return False
    if not ok:
        failed.append(issue['id'])
        print(f"{issue['id']}: not claimed: {message}", file=sys.stderr)
        return False
    claimed.append(issue)
    return True


def item_of(board: Board, issue: dict) -> str | None:
    """The change request a work-type record belongs to: it is then an item, which has no holder, deferral or review of its own."""
    return board.cr_of(issue['id']) if issue.get('issue_type') == WORK_TYPE else None


def item_hold_refusal(board: Board, issue: dict) -> str | None:
    """An item has no holder of its own: its change request holds it. A hold left on one from before is cleared by /board-migrate."""
    if item_cr := item_of(board, issue):
        return (f"{issue['id']}: an item has no holder of its own; its change request {item_cr} holds it: agents board claim {item_cr}, "
                'then close the item when it is done')
    return None


def work_item_refusal(board: Board, issue: dict, actor: str) -> str | None:
    """A task is claimed outside any change request only when it commits nothing here (an item is held with its change request)."""
    if issue.get('issue_type') != WORK_TYPE or is_no_commit(issue):
        return None
    return f"{issue['id']}: outside any change request; put it in one: agents board move {issue['id']} --to <change request>"


def refuse_long_comment(text: str) -> None:
    refusal = comment_refusal(len(text))
    if refusal:
        raise BoardError(refusal)


def comment(item_id: str, text: str) -> None:
    bd_checked('comments', 'add', item_id, text)


def require_open(board: Board, ids: list[str]) -> list[dict]:
    missing = [item_id for item_id in ids if not board.is_open(item_id)]
    if missing:
        raise BoardError(f"unknown or closed: {', '.join(missing)}")
    return [board.by_id[item_id] for item_id in ids]


def elsewhere_refusal(board: Board, issue: dict, verb: str, agreed: str | None) -> str | None:
    """A shared board's hold by a session outside this machine's registry: only its person frees it, so `take` and `unclaim` refuse
    without `--agreed` (beads-setup.md Shared boards)."""
    holder = issue.get('assignee') or ''
    if shared is None or agreed or not ACTOR.fullmatch(holder) or session_actor(holder) in board.registry():
        return None
    return (f"{issue['id']}: held elsewhere by {holder}, updated {age(board.last_activity(issue))} ago: ask its person; "
            f'with their agreement: board {verb} {issue["id"]} --agreed "<what they said>"')


def take(board: Board, args) -> int:
    actor = caller()
    entry = own_entry(board, actor)
    taken, failed = [], False
    for issue in require_open(board, args.ids):
        refusal = item_hold_refusal(board, issue) or foreign_claim(board, issue['id']) or elsewhere_refusal(board, issue, 'take', args.agreed)
        if refusal:
            raise BoardError(refusal)
        if board.is_cr(issue['id']) and (refusal := self_review_refusal(issue, actor)):
            raise BoardError(refusal)
        previous = issue.get('assignee') or 'nobody'
        if previous == actor:
            print(f"{issue['id']}: already held by {actor}")
            continue
        # A work item held counts against the worker cap however the hold arrives.
        over = cap_refusal(board, entry, actor, taken) if is_work_hold(issue) else None
        if over and args.force is None:
            failed = True
            print(f"{issue['id']}: not taken: {over}; hand over or unclaim one, or agents board take {issue['id']} --force \"<reason>\"", file=sys.stderr)
            continue
        move(issue, 'take', board=board, actor=actor, agreed=frozenset({'gone'}) if args.agreed else frozenset())
        comment(issue['id'], f'board take: {actor} took this item over from {previous}' + (f' (agreed: {args.agreed})' if args.agreed else '') + '.')
        if board.is_cr(issue['id']) and issue['status'] == 'in_review':  # the new holder has seen nothing yet
            put_meta(issue, reviewing_tip=None)
        taken.append(issue)
        print(f"took {issue['id']} from {previous}")
        mark_forced(issue, actor, args.force if over else None)
    return 1 if failed else 0


RESUME = 'board unclaim: resume: '  # the comment that records a hand-back in the history


def unclaim(board: Board, args) -> int:
    actor = caller()
    failed = False
    for issue in require_open(board, args.ids):
        holder = issue.get('assignee')
        if not holder:
            print(f"{issue['id']}: not held")
            continue
        refusal = item_hold_refusal(board, issue) or elsewhere_refusal(board, issue, 'unclaim', args.agreed)
        if refusal:
            print(refusal, file=sys.stderr)
            failed = True
            continue
        own_work = in_hand(issue, actor) and (board.is_cr(issue['id']) or is_work_hold(issue))
        if own_work and not args.resume:
            print(f"{issue['id']}: your work in progress: if it waits on something, record that first (agents board wait <item> --on <id> --for \"<the input it waits for>\"), "
                  f"then hand it back: agents board unclaim {issue['id']} --resume \"<next action>\"", file=sys.stderr)
            failed = True
            continue
        if args.resume and not own_work:
            print(f"{issue['id']}: --resume hands back your own work in progress; {holder} holds it {issue['status']}", file=sys.stderr)
            failed = True
            continue
        reason = f"board unclaim: {actor} released {holder}'s hold" + (f' (agreed: {args.agreed})' if args.agreed else '') + '.'
        move(issue, 'unclaim', board=board, actor=actor, agreed=frozenset({'gone'}) if args.agreed else frozenset(), fields={RESUME_NOTE: args.resume} if args.resume else None)  # the status stays for the next claimer; a change request keeps its worktree and branch
        comment(issue['id'], reason)
        if board.is_cr(issue['id']) and issue['status'] == 'open':
            try:
                wt = cr_worktree(main_root(), issue['id'])
                if wt.is_dir() and tree_problem(wt):
                    print(f"{issue['id']}: uncommitted work stays in {wt} for whoever claims it next", file=sys.stderr)
            except BoardError:
                pass
        if args.resume:
            comment(issue['id'], RESUME + args.resume)
        print(f"unclaimed {issue['id']} from {holder} ({issue['status']})")
    return 1 if failed else 0


def held(board: Board, item_id: str, actor: str, status: str | None = None) -> dict:
    issue = require_open(board, [item_id])[0]
    if issue.get('assignee') != actor or (status and issue['status'] != status):
        raise BoardError(f"{item_id}: {issue['status']}, held by {issue.get('assignee') or 'nobody'}; claim it first")
    return issue


def git(root: Path, *args: str, env: dict[str, str] | None = None, check: bool = True, input: str | None = None) -> subprocess.CompletedProcess:
    """git in the repository root, output as bytes; a failure raises with git's message unless `check` is off."""
    result = subprocess.run(['git', '-C', str(root), *args], capture_output=True, env={**os.environ, **(env or {})},
                            input=input.encode() if input is not None else None)
    if check and result.returncode != 0:
        raise BoardError(f"git {' '.join(args[:2])}: {result.stderr.decode('utf-8', 'replace').strip() or 'exit ' + str(result.returncode)}")
    return result


def git_text(root: Path, *args: str, env: dict[str, str] | None = None, input: str | None = None) -> str:
    return git(root, *args, env=env, input=input).stdout.decode('utf-8', 'surrogateescape')


# Change requests (r24, r25). The CR is the only unit claimed for work; its items are children claimed by the workers of the
# session holding it. Its place in the flow is its status (open, in_review, passed, closed) and its holder; the flow is in
# skills/shared/change-requests.md and the model in docs/board/model.md.
SETTINGS = {name: f'custom.board.{name}' for name in ('target', 'setup', 'checks', 'look', 'view')}  # bd's namespace for custom keys
LOOKS, VIEWS = ('before', 'after'), ('code', 'result')
# The model marker is the model version: a change request that changes stored forms raises MODEL and adds its conversions to board-migrate's
# convert-stored-forms.py, which reads MODEL from here. Written by `board setup` on a board it creates and, last, by board-migrate on an older one. Every write verb refuses a board
# without it, naming /board-migrate; reads and raw bd stay open so migrate can inspect and convert, and MODEL_EXEMPT names the writes that need no marker.
MODEL_KEY, MODEL = 'custom.board.model', '1'
# Worktrees live inside the main checkout, <main>/.worktrees/<cr id>, so every runtime's workspace sandbox covers them without
# a grant (q239 reversed 2026-11-11); the repository's local exclude file hides them from git status.
WORKTREES = '.worktrees'
OUTPUT_TAIL = 800  # characters of setup or check output kept in a refusal or the stored check


def meta(issue: dict) -> dict:
    found = issue.get('metadata')
    return found if isinstance(found, dict) else {}


def put_meta(issue: dict, **fields) -> None:
    """Sets (None: removes) metadata keys on the item and in the snapshot. Flat string keys: a whole-object write would
    replace what a concurrent writer set."""
    if not isinstance(issue.get('metadata'), dict):
        issue['metadata'] = {}
    flags = []
    for key, value in fields.items():
        if value is None:
            flags += ['--unset-metadata', key]
            issue['metadata'].pop(key, None)
        else:
            flags += ['--set-metadata', f'{key}={value}']
            issue['metadata'][key] = str(value)
    if flags:
        bd_checked('update', issue['id'], *flags, '--json')


def stamp() -> str:
    return utcnow().strftime('%Y-%m-%dT%H:%M:%SZ')


def tail(text: str) -> str:
    text = text.strip()
    return text if len(text) <= OUTPUT_TAIL else '…' + text[-OUTPUT_TAIL:]


def board_setting(board: Board, name: str) -> str:
    """A project setting (bd config board.<name>), failing closed when it is missing or invalid."""
    key = SETTINGS[name]
    if name not in board.settings:
        for missing, value in project_settings().items():  # one bd read for all of them: each read costs about 0.1 s
            board.settings.setdefault(missing, value)
    value = board.settings[name].strip()
    allowed = {'look': LOOKS, 'view': VIEWS}.get(name)
    if not value:
        raise BoardError(f'{key} is not set: agents board setup --{name} <{"|".join(allowed) if allowed else "value"}>')
    if allowed and value not in allowed:
        raise BoardError(f"{key} is {value!r}, not one of {', '.join(allowed)}: agents board setup --{name} <value>")
    return value


def settings_problems(board: Board) -> list[str]:
    problems = []
    for name in SETTINGS:
        try:
            board_setting(board, name)
        except BoardError as error:
            problems.append(str(error))
    return problems


# The commands that write a board without the model marker (require_model), each with why. Every other write refuses a board without it.
MODEL_EXEMPT = {'setup': 'it creates the board, or brings an existing one to the current settings, so the marker cannot be its precondition',
                'join': 'it fetches a board whose marker travels with the database: a joiner reads an old board, and its writes name /board-migrate'}

def require_model() -> None:
    """Refuses a write on a board that has not been brought to the current model (MODEL_KEY); MODEL_EXEMPT's commands are the writes that need no marker."""
    if beads_dir() is None or (value := current_setting(MODEL_KEY)) == MODEL:
        return
    if value.isdigit() and int(value) > int(MODEL):
        raise BoardError(f'this board is on model {value}, newer than this checkout\'s {MODEL}: update the agents checkout. Reads still work')
    raise BoardError(f'this board is not on the current model ({MODEL_KEY} is not {MODEL}): run /board-migrate. Reads still work; board bd --raw is migrate\'s way in')


def cr_look(board: Board, cr: dict) -> str:
    value = meta(cr).get('look') or board_setting(board, 'look')
    if value not in LOOKS:
        raise BoardError(f"{cr['id']}: look {value!r} is not one of {', '.join(LOOKS)}")
    return value


def cr_branch(cr_id: str) -> str:
    return f'cr/{cr_id}'


def main_root() -> Path:
    """The main checkout: the first entry of `git worktree list`, wherever board runs (main, a worktree)."""
    result = subprocess.run(['git', 'worktree', 'list', '--porcelain'], capture_output=True, text=True)
    first = result.stdout.splitlines()[0] if result.returncode == 0 and result.stdout.strip() else ''
    if not first.startswith('worktree '):
        raise BoardError('not inside a git repository')
    return Path(first.removeprefix('worktree '))


def cr_worktree(main: Path, cr_id: str) -> Path:
    return main / WORKTREES / cr_id


def exclude_worktrees(main: Path) -> None:
    """Adds `/.worktrees/` to the repository's local exclude file (never a committed ignore line) before a worktree is added."""
    exclude_line(git_exclude(main), f'/{WORKTREES}/')


def exclude_line(exclude: Path, line: str, why: str = '') -> None:
    """Adds `line` (after a `# why` comment) to a local exclude file once."""
    text = exclude.read_text(encoding='utf-8') if exclude.is_file() else ''
    if line not in text.splitlines():
        exclude.parent.mkdir(parents=True, exist_ok=True)
        with exclude.open('a', encoding='utf-8') as out:  # append: keeps lines another writer added meanwhile
            out.write(('\n' if text and not text.endswith('\n') else '') + (f'# {why}\n' if why else '') + line + '\n')


class GitView(NamedTuple):
    """The repository facts a read-only view needs for every change request, read once: the main checkout, the local
    branch tips and the worktrees. A command that writes git state keeps the live reads."""
    main: Path
    heads: dict[str, str]
    worktrees: list[dict]


def read_git_view(board: Board) -> None:
    """Fills `board.git_view` (one `git worktree list`, one `git for-each-ref`); none outside a repository."""
    try:
        main = main_root()
        rows = git_text(main, 'for-each-ref', '--format=%(objectname) %(refname)', 'refs/heads').splitlines()
        board.git_view = GitView(main, {ref: sha for sha, _, ref in (row.partition(' ') for row in rows)}, worktrees_listing(main))
    except BoardError:
        return  # the live reads follow, and fail per change request as they always did


def main_of(board: Board) -> Path:
    return board.git_view.main if board.git_view else main_root()


def view_rev(board: Board, root: Path, ref: str) -> str | None:
    """`rev` of a local branch, from the view when the command read one."""
    if board.git_view and ref.startswith('refs/heads/') and root == board.git_view.main:
        return board.git_view.heads.get(ref)
    return rev(root, ref)


def rev(root: Path, ref: str) -> str | None:
    found = git(root, 'rev-parse', '--verify', '-q', f'{ref}^{{commit}}', check=False)
    return found.stdout.decode().strip() or None


def is_ancestor(root: Path, ancestor: str, descendant: str) -> bool:
    return git(root, 'merge-base', '--is-ancestor', ancestor, descendant, check=False).returncode == 0


def target_branch(board: Board, main: Path) -> str:
    name = board_setting(board, 'target')
    if name not in board._ref_format:  # a property of the name alone
        board._ref_format[name] = git(main, 'check-ref-format', '--branch', name, check=False).returncode == 0
    if not board._ref_format[name] or view_rev(board, main, f'refs/heads/{name}') is None:
        raise BoardError(f"{SETTINGS['target']} {name!r} is not a local branch: agents board setup --target <branch>")
    return name


def live_parent(board: Board, cr: dict) -> str | None:
    """The change request this one is stacked on while that one is unlanded, else None."""
    base = meta(cr).get('base')
    return base if base and base != cr['id'] and board.is_cr(base) and board.is_open(base) else None


def cr_base(board: Board, cr: dict, main: Path) -> tuple[str, str]:
    """(base as stored, its ref): a change request id while that one is live, else the target branch."""
    base = live_parent(board, cr)
    if base:
        return base, f'refs/heads/{cr_branch(base)}'
    name = target_branch(board, main)
    return name, f'refs/heads/{name}'


IN_PROGRESS = (('rebase-merge', 'rebase'), ('rebase-apply', 'rebase'), ('MERGE_HEAD', 'merge'), ('CHERRY_PICK_HEAD', 'cherry-pick'),
               ('REVERT_HEAD', 'revert'), ('BISECT_START', 'bisect'))  # git's in-progress marker files in a worktree's git dir, and the state each shows


def tree_problem(wt: Path) -> str | None:
    """Why the worktree cannot be rebased or checked: a rebase, merge, cherry-pick, revert or bisect in progress, or uncommitted changes."""
    state = in_progress_state(wt)
    if state:
        return (f'a {state} is in progress in {wt}: end it, then rerun (a rebase a board command stopped on a conflict: resolve its files, '
                'git add them, rerun that command; any other: its owner finishes or aborts it)')
    changes = [row for row in git_text(wt, 'status', '--porcelain', '--untracked-files=normal').splitlines() if row.strip()]
    if changes:
        shown = ', '.join(row[3:] for row in changes[:5]) + (f' and {len(changes) - 5} more' if len(changes) > 5 else '')
        return f'uncommitted changes in {wt} ({shown}): commit them (one commit per pass) first'
    return None


def worktree_git_dir(wt: Path) -> Path | None:
    """The worktree's own git dir, from its `.git` file (a linked worktree) or directory: file reads only, no git process."""
    dot = wt / '.git'
    if dot.is_dir():
        return dot
    try:
        text = dot.read_text(encoding='utf-8').strip()
    except (OSError, UnicodeDecodeError):
        return None
    if not text.startswith('gitdir:'):
        return None
    where = Path(text.removeprefix('gitdir:').strip())
    return where if where.is_absolute() else wt / where


def rebase_target(wt: Path) -> str | None:
    """The commit the worktree's rebase in progress rebases onto (`rebase-merge/onto`, else `rebase-apply/onto`); None without one."""
    git_dir = worktree_git_dir(wt)
    for name in ('rebase-merge', 'rebase-apply') if git_dir else ():
        try:
            return (git_dir / name / 'onto').read_text(encoding='utf-8').strip() or None
        except (OSError, UnicodeDecodeError):
            continue
    return None


def own_rebase(wt: Path, cr: dict) -> bool:
    """The worktree is mid a rebase the board started: its target is the commit the board recorded as the CR's `rebase_onto`."""
    target = rebase_target(wt)
    return bool(target) and target == meta(cr).get('rebase_onto')


def in_progress_state(wt: Path, cr: dict | None = None) -> str | None:
    """The rebase, merge, cherry-pick, revert or bisect in progress in the worktree, by marker file existence (no git process); None
    when clean. With `cr`, the board's own rebase of it does not count: what is left is the state the board did not start. Uncommitted
    changes are not one: they are work left for the next claimer."""
    git_dir = worktree_git_dir(wt)
    if git_dir is None:
        return None
    for name, state in IN_PROGRESS:
        if (git_dir / name).exists() and not (cr is not None and state == 'rebase' and own_rebase(wt, cr)):
            return state
    return None


def cr_worktree_state(board: Board, cr: dict) -> str | None:
    """`in_progress_state` of the CR's worktree, once per snapshot (the queue asks per CR; no git process after the first)."""
    cache = board.__dict__.setdefault('_wt_state', {})
    if '_main' not in board.__dict__:
        try:
            board._main = main_of(board)
        except BoardError:
            board._main = None
    if cr['id'] not in cache:
        wt = cr_worktree(board._main, cr['id']) if board._main else None
        cache[cr['id']] = in_progress_state(wt, cr) if wt and wt.is_dir() else None
    return cache[cr['id']]


def run_shell_full(cwd: Path, command: str) -> tuple[int, str]:
    result = subprocess.run(['/bin/sh', '-c', command], cwd=cwd, capture_output=True, text=True)
    return result.returncode, result.stdout + result.stderr


def run_shell(cwd: Path, command: str) -> tuple[int, str]:
    code, out = run_shell_full(cwd, command)
    return code, tail(out)


def run_check(cwd: Path, command: str) -> tuple[int, str, str]:
    """The project check's exit status, its stdout (where the failure lines go, q241) and stdout plus stderr for display."""
    result = subprocess.run(['/bin/sh', '-c', command], cwd=cwd, capture_output=True, text=True)
    return result.returncode, result.stdout, result.stdout + result.stderr


def failure_counts(stdout: str) -> dict[tuple[str, str], int]:
    """One `file code` line per failure on the check's stdout (q241); its other lines and all of stderr are not failures."""
    found: dict[tuple[str, str], int] = {}
    for row in stdout.splitlines():
        parts = row.split()
        if len(parts) == 2:
            found[(parts[0], parts[1])] = found.get((parts[0], parts[1]), 0) + 1
    return found


def base_failures(board: Board, cr: dict, main: Path, base_tip: str) -> dict[tuple[str, str], int]:
    """The failures at the base commit, cached per project in the repository's common git dir, keyed by the base commit and the
    setup and check settings (q241); a green project has none. A lock makes concurrent hand-overs onto one base run it once: the
    second waits, then reads the first's result. Setup and checks run in a detached worktree of the base."""
    setup, checks = board_setting(board, 'setup'), board_setting(board, 'checks')
    folder = Path(git_text(main, 'rev-parse', '--path-format=absolute', '--git-common-dir').strip()) / 'board-base-checks'
    folder.mkdir(parents=True, exist_ok=True)
    key = hashlib.sha256('\0'.join((base_tip, setup, checks)).encode()).hexdigest()[:40]
    result = folder / key
    with (folder / f'{key}.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if result.is_file():
            try:
                return {(f, c): int(n) for f, c, n in (row.split() for row in result.read_text(encoding='utf-8').splitlines() if row.strip())}
            except ValueError:  # an unreadable result is a miss: recompute it
                result.unlink(missing_ok=True)
        path = main / WORKTREES / f'.base-{key[:12]}'
        exclude_worktrees(main)
        path.parent.mkdir(parents=True, exist_ok=True)
        # A run killed before its cleanup left this board-owned path. A symlink there is not ours: drop the link only, since
        # `worktree remove --force` would follow it. `add --force` takes over a registration whose folder is gone, so no
        # repo-wide prune touches other worktrees' records.
        if path.is_symlink():
            path.unlink()
        elif path.exists():
            git(main, 'worktree', 'remove', '--force', str(path), check=False)
            shutil.rmtree(path, ignore_errors=True)
        git(main, 'worktree', 'add', '--force', '--detach', str(path), base_tip)
        try:
            code, out = run_shell(path, setup)
            if code:
                raise BoardError(f'{cr["id"]}: setup failed at the base commit {base_tip[:12]}, so its failures are unknown:\n{out}')
            base_code, stdout, full = run_check(path, checks)
            if base_code not in (0, 1) or (base_code == 1 and not failure_counts(stdout)):
                raise BoardError(f'{cr["id"]}: the check is broken at the base commit {base_tip[:12]} (exit {base_code}), so its failures are unknown:\n{tail(full)}')
        finally:
            git(main, 'worktree', 'remove', '--force', str(path), check=False)
        found = failure_counts(stdout)
        scratch = folder / f'{key}.{os.getpid()}.tmp'
        scratch.write_text(''.join(f'{f} {c} {n}\n' for (f, c), n in sorted(found.items())), encoding='utf-8')
        os.replace(scratch, result)  # atomic: a reader never sees half a result
        return found


def check_verdict(board: Board, cr: dict, main: Path, wt: Path, base_tip: str) -> tuple[bool, str, dict | None]:
    """Runs the project check at the tip; passes when no (file, code) failure count rises from the base to the tip (q241)."""
    code, stdout, full = run_check(wt, board_setting(board, 'checks'))
    at_tip = failure_counts(stdout)
    # Exit status contract: 0 = ran, the `file code` lines on stdout are the failures; 1 = ran with failures, at least one such
    # line; anything else, or 1 with no line, is a broken check and fails closed.
    if code not in (0, 1) or (code == 1 and not at_tip):
        return False, f'check broken (exit {code}' + (', no failure line on stdout' if code == 1 else '') + f'):\n{tail(full)}', None
    if not at_tip:
        return True, '', None  # no comparison ran
    base = base_failures(board, cr, main, base_tip)
    rises = [(f, c) for (f, c), n in sorted(at_tip.items()) if n > base.get((f, c), 0)]
    text = '\n'.join(f'{f} {c}: {base.get((f, c), 0)} -> {at_tip[(f, c)]}' for f, c in rises)
    return not rises, ('new failures:\n' + text) if rises else '', \
        {'new': [f'{f} {c}' for f, c in rises], 'base': sum(base.values()), 'tip': sum(at_tip.values())}


def check_pair(cr: dict) -> dict | None:
    m = meta(cr)
    if not m.get('check_tip'):
        return None
    return {'tip': m.get('check_tip'), 'baseTip': m.get('check_base_tip'), 'result': m.get('check_result'),
            'at': m.get('check_at'), 'output': m.get('check_output') or '', 'kind': m.get('check_kind') or 'full',
            'command': m.get('check_command') or None, 'reason': m.get('check_reason') or None}


def check_label(cr: dict, state: str) -> str:
    """The check state as shown: a targeted or no-gate result says what it was, never a full pass (r15-q78)."""
    pair = check_pair(cr)
    if pair is None or pair['kind'] == 'full' or state in ('unchecked', 'failed'):
        return state
    detail = f"targeted: {pair['command']}" if pair['kind'] == 'targeted' else f"no check: {pair['reason']}"
    return f'{state} ({detail})'


def check_state(main: Path, cr: dict, tip: str | None, base_tip: str | None) -> str:
    """The stored check against the refs now (q209): current, stale (the branch or its base moved), conflict (the base moved
    and a dry-run merge conflicts), failed, unchecked."""
    pair = check_pair(cr)
    if pair is None or tip is None or base_tip is None:
        return 'unchecked'
    if pair['result'] == 'fail':
        return 'failed'
    if pair['tip'] == tip and pair['baseTip'] == base_tip:
        return 'current'
    if pair['baseTip'] != base_tip and git(main, 'merge-tree', '--write-tree', base_tip, tip, check=False).returncode == 1:
        return 'conflict'
    return 'stale'


def worktrees_listing(main: Path) -> list[dict]:
    entries, entry = [], {}
    for row in git_text(main, 'worktree', 'list', '--porcelain').splitlines() + ['']:
        if not row:
            if entry:
                entries.append(entry)
            entry = {}
            continue
        key, _, value = row.partition(' ')
        entry[key] = value
    return entries


def dirty_paths(wt: Path) -> set[str]:
    fields = git(wt, 'status', '--porcelain=v1', '-z', '--untracked-files=all', check=False).stdout.decode('utf-8', 'surrogateescape').split('\0')
    paths, at = set(), 0
    while at < len(fields) and len(fields[at]) > 3:
        paths.add(fields[at][3:])
        at += 2 if fields[at][0] in 'RC' else 1
    return paths


def checked_out_at(main: Path, ref: str, listing: list[dict] | None = None) -> tuple[Path | None, str | None]:
    """(the worktree with this branch checked out, why a landing must wait): a worktree that is rebasing or bisecting the
    branch has it detached, and moving the ref under it would be undone by its abort (F7)."""
    for entry in worktrees_listing(main) if listing is None else listing:
        path = Path(entry['worktree'])
        if 'prunable' in entry:  # its directory is gone: nothing there rebases or holds a branch
            continue
        if entry.get('branch') == ref:
            return path, None
        gitdir = Path(git_text(path, 'rev-parse', '--absolute-git-dir').strip())
        for name in ('rebase-merge', 'rebase-apply'):
            head = gitdir / name / 'head-name'
            if head.is_file() and head.read_text(encoding='utf-8').strip() == ref:
                return None, f'{path} is rebasing {ref.removeprefix("refs/heads/")}: finish or abort that first'
        start = gitdir / 'BISECT_START'
        if start.is_file() and start.read_text(encoding='utf-8').strip() == ref.removeprefix('refs/heads/'):
            return None, f'{path} is bisecting {ref.removeprefix("refs/heads/")}: finish that first'
    return None, None


def land_blocked(main: Path, name: str, tip: str, board: Board | None = None) -> list[str]:
    """Paths the landing changes that hold uncommitted edits in the worktree with the target checked out."""
    ref = f'refs/heads/{name}'
    view = board.git_view if board else None
    where, _ = checked_out_at(main, ref, view.worktrees if view else None)
    old = view_rev(board, main, ref) if board else rev(main, ref)
    if where is None or old is None:
        return []
    changed = set(git_text(main, 'diff', '--name-only', '--no-renames', old, tip).splitlines())
    return sorted(dirty_paths(where) & changed)


def cr_info(board: Board, cr: dict) -> dict:
    """Git facts of a change request, read once per command: branch, worktree, tips, check state, blocked landing."""
    if cr['id'] not in board._cr:
        info = {'main': None, 'branch': cr_branch(cr['id']), 'worktree': None, 'tip': None, 'baseTip': None, 'state': 'unchecked', 'blocked': []}
        try:
            main = main_of(board)
            info.update(main=main, worktree=str(cr_worktree(main, cr['id'])), tip=view_rev(board, main, f"refs/heads/{info['branch']}"))
            info['baseTip'] = view_rev(board, main, cr_base(board, cr, main)[1])
            info['state'] = check_state(main, cr, info['tip'], info['baseTip'])
            if cr['status'] == PASSED and info['tip'] and not live_parent(board, cr):
                info['blocked'] = land_blocked(main, target_branch(board, main), info['tip'], board)
        except BoardError:
            pass
        board._cr[cr['id']] = info
    return board._cr[cr['id']]


def live_crs(board: Board) -> list[dict]:
    return [i for i in board.issues if i.get('issue_type') == CR_TYPE and i['status'] != 'closed']


def stacked_order(board: Board, issues: list[dict], since, *, rank_unlocks: bool = False) -> list[dict]:
    """Change requests in list order (r5-q21): a stack's base before the requests on it, then the claim order's tiers without
    kind (P0, milestone work, effective priority; `work_rank`), optionally unlocks, then `since(issue)` and id."""
    ids = {i['id'] for i in issues}
    ordered: list[dict] = []
    seen: set[str] = set()

    def emit(issue: dict) -> None:
        if issue['id'] in seen:
            return
        seen.add(issue['id'])
        base = meta(issue).get('base')
        if base in ids:
            emit(board.by_id[base])
        ordered.append(issue)

    def key(issue: dict):
        milestone, priority = work_rank(board, issue)
        impact = board.unlocks.key(issue['id']) if rank_unlocks else ()
        return (priority != 0, not milestone, priority, *impact, since(issue), issue['id'])

    for issue in sorted(issues, key=key):
        emit(issue)
    return ordered


def accept_queue(board: Board) -> list[dict]:
    """Change requests waiting for the user, in `stacked_order` by the time they began waiting. Kept per snapshot, since every
    unheld accept request's claimability asks for the head; the key notices the status and base writes a command makes."""
    live = live_crs(board)
    key = tuple((i['id'], i['status'], meta(i).get('since'), i.get('updated_at'), meta(i).get('base')) for i in live)
    if board._accept_queue is None or board._accept_queue[0] != key:
        board._accept_queue = (key, stacked_order(board, [i for i in live if board.kind(i) == 'accept'],
                                                  lambda i: meta(i).get('since') or i.get('updated_at') or '', rank_unlocks=True))
    return list(board._accept_queue[1])


def is_in_work_unit(issue: dict) -> bool:
    """A unit of work somebody has in hand or in review: an item or request held, or a request in review or passed."""
    return issue['status'] in ('in_review', PASSED) or (issue['status'] == 'open' and bool(issue.get('assignee')))


def is_in_work_cr(board: Board, cr: dict) -> bool:
    """Built or reviewed now: in agent review, held while open, or passed and waiting for its parent's landing."""
    return cr['status'] == 'in_review' or (cr['status'] == 'open' and bool(cr.get('assignee'))) or (cr['status'] == PASSED and board.kind(cr) is None)


def in_work_crs(board: Board) -> list[dict]:
    """Change requests being built or reviewed, in `stacked_order` by creation."""
    return stacked_order(board, [i for i in live_crs(board) if is_in_work_cr(board, i)], lambda i: i.get('created_at') or '')


def queue_head(board: Board, queue: list[dict] | None = None) -> dict | None:
    """The first queued CR that is not itself waiting: the only one that can be refresh work (q196, q201)."""
    return next((i for i in (accept_queue(board) if queue is None else queue) if not board.cr_waits(i)[0]), None)


def needs_refresh(board: Board, cr: dict) -> bool:
    return cr_info(board, cr)['state'] != 'current'


PLAN_FIRST = 'plan_first'  # metadata of a change request that needs planning before work: the reason (a rejected base, migrated loose work); the plan claim clears it
FOUND_IN = 'found_in'  # metadata of the found item: the item it was found in (a field, so bd's one link per pair stays free)
OPENED = 'opened_tip'  # metadata of an item open for the user's review: the tip it was opened at (accept.md User review)
BOARD_METADATA = {  # every metadata key the board writes, the one list (a test compares it with the writes); board check flags any other
    NO_COMMIT, FOUND_IN, *CR_SETTINGS, HOLD, DEEP_REVIEW, FORCED_BY, FORCED_REASON, SENT_AT, REVISES_RULE, OPENED, DEFERRED_BY, REVISIT, 'outcome',
    'base', 'base_sha', 'setup_sha', 'since', 'landing', PLAN_FIRST, 'rebase_from', 'rebase_onto', 'review_tip', 'review_base_tip',
    'reviewing_tip', 'review_edits', AUTHOR, RESUME_NOTE, 'user_seen_tip', 'user_seen_base_tip', 'no_agent_review_reason',
    'check_at', 'check_base_count', 'check_base_tip', 'check_command', 'check_kind', 'check_new', 'check_output', 'check_reason',
    'check_result', 'check_tip', 'check_tip_count'}
BOARD_REMOTE = 'board'  # the remote the board makes so VS Code shows the request as Outgoing Changes; its push address is disabled
NO_PUSH = 'no-push://the-board-lands-requests'  # no git-remote-no-push helper exists, so any push through the remote fails


def opened_tip(item: dict) -> str | None:
    """The tip the item was opened for the user's review at; None while it is not open (metadata only: no git process)."""
    return meta(item).get(OPENED) or None


def end_review(board: Board, item: dict) -> None:
    """Ends the user's review: the item is no longer held for it (nothing else on the item or its branch changes)."""
    put_meta(item, **{OPENED: None})
    board._cr.pop(item['id'], None)


def edits_line(cid: str, opened: str) -> str:
    """The command that records the user's edits of an open review (accept.md User review)."""
    return f'agents board cr edits {cid} --tip {opened[:12]} --commit -m "<msg>"'


def review_range(board: Board, item: dict) -> tuple[str, str | None] | None:
    """(tip, base tip) of the CR's current branch; None for any other item."""
    if board.is_cr(item['id']):
        info = cr_info(board, item)
        return (info['tip'], info['baseTip']) if info['tip'] else None
    return None


def linked_worktree(wt: Path) -> bool:
    """`wt` is a worktree of its own: a `.git` file there and git's top level the folder itself. A plain folder under the main checkout
    is no worktree: git would resolve every command in it to the main checkout."""
    if not (wt / '.git').is_file():
        return False
    top = git(wt, 'rev-parse', '--show-toplevel', check=False)
    return top.returncode == 0 and Path(top.stdout.decode().strip()).resolve() == wt.resolve()


def review_worktree(board: Board, item: dict) -> Path | None:
    """The item's own worktree, or None when `.worktrees/<id>` is not one: the cheap file test every read of the snapshot makes; the
    commands that write into it check `linked_worktree` as well."""
    try:
        wt = cr_worktree(main_of(board), item['id'])
    except BoardError:
        return None
    return wt if (wt / '.git').is_file() else None


def cr_worktree_main(wt: Path) -> Path:
    """The main checkout of a worktree under `<main>/.worktrees/`."""
    return wt.parent.parent


def review_recovery(wt: Path, opened: str) -> str:
    """The way back to a readable review: the branch at the tip it was opened at. Everything the user committed after it goes too."""
    return f'git -C {wt} reset --hard {opened} (it also drops your commits after it: re-apply them, e.g. git cherry-pick from git reflog)'


def taken_in(board: Board, main: Path, branch: str, opened: str, tip: str) -> bool:
    """The range opened..tip holds a merge commit or a commit of the branch's base (a Pull brought them in): never the user's edits."""
    if git_text(main, 'rev-list', '--merges', '-n1', f'{opened}..{tip}').strip():
        return True
    base = git(main, 'config', '--get', f'branch.{branch}.merge', check=False).stdout.decode().strip().removeprefix('refs/heads/')
    base_tip = rev(main, f'refs/heads/{base}') if base else None
    if not base_tip:
        return False
    ours = set(git_text(main, 'rev-list', f'{opened}..{tip}').split())
    if ours & set(git_text(main, 'rev-list', base_tip, f'^{opened}').split()):
        return True
    return False


def review_read(board: Board, item: dict) -> dict | None:
    """What the item's review holds, read live; None while it is not open. The user's edits are their commits after the opened tip plus
    the uncommitted changes (tracked and new, not ignored): {opened, edited, files, commits, dirty, tip, why}. `edited` None:
    not readable, `why` says why (worktree gone or off its branch, opened tip no longer in the branch: amended or reset); `files`: every
    path that differs from the opened tip; `commits`: those after it, oldest first; `dirty`: uncommitted changes."""
    opened = opened_tip(item)
    if not opened:
        return None
    wt = review_worktree(board, item)
    found = {'opened': opened, 'edited': None, 'files': [], 'commits': [], 'dirty': False, 'tip': None, 'editsTree': None, 'why': None}
    if wt is None:
        found['why'] = f"its worktree {cr_worktree(main_of(board), item['id'])} is gone: agents board review open {item['id']} makes it again"
        return found
    main, branch = cr_worktree_main(wt), cr_branch(item['id'])
    ref = f'refs/heads/{branch}'
    attached = git(wt, 'symbolic-ref', '--quiet', 'HEAD', check=False).stdout.decode().strip()
    head, tip = rev(wt, 'HEAD'), rev(main, ref)
    found['tip'] = tip
    if tip is None or attached != ref or head != tip:
        found['why'] = f'{wt} is not on {branch}: check it out, then try again'
    elif not is_ancestor(main, opened, tip):
        found['why'] = (f'the tip it was opened at ({opened[:12]}) is no longer in {branch} (an amend, reset or rebase rewrote reviewed work, which never passes '
                        f'as your edit): {review_recovery(wt, opened)}')
    elif taken_in(board, main, branch, opened, tip):
        found['why'] = (f'{branch} took in a merge or commits of its base after it was opened (a Pull; they are never your edits): {review_recovery(wt, opened)}')
    else:
        try:
            tree = review_edits_tree(main, wt, tip)
            found['editsTree'] = tree
            found['files'] = git_text(main, 'diff', '--name-only', '--no-renames', f'{opened}^{{tree}}', tree).splitlines()
            found['commits'] = git_text(main, 'rev-list', '--reverse', f'{opened}..{tip}').split()
            found['dirty'] = tree != git_text(main, 'rev-parse', f'{tip}^{{tree}}').strip()
            found['edited'] = bool(found['commits']) or bool(found['files'])
        except BoardError as error:
            found['why'] = f'its files are not readable: {error}'
    return found


def review_of(board: Board, item: dict) -> dict | None:
    """What the pane shows of the item's review, once per snapshot: {opened, edited, files}; None while it is not open. `board show`
    and the console read this."""
    if not board.is_cr(item['id']):
        return None
    found = review_snapshot(board, item)
    return {key: found[key] for key in ('opened', 'edited', 'files')} if found else None


def review_snapshot(board: Board, item: dict) -> dict | None:
    """The live read behind a review view, including private data used to compute board-owned marks."""
    cache = board.__dict__.setdefault('_review_read', {})
    if item['id'] not in cache:
        cache[item['id']] = review_read(board, item)
    return cache[item['id']]


def refuse_unrecorded(cid: str, review: dict, then: str) -> None:
    """The one refusal of a verdict that would pass the user's edits unrecorded (or an unreadable review): `then` is the step that
    records them."""
    if review['edited'] is None:
        raise BoardError(f"{cid}: your review cannot be read: {review['why']}")
    if review['edited']:
        shown = ', '.join(review['files'][:5]) + (' and more' if len(review['files']) > 5 else '')
        raise BoardError(f"{cid}: your review holds edits ({shown or 'commits'}): {then}")


def open_refusal(cid: str, cr: dict, step: str) -> str | None:
    """Agent steps never take an item open for the user's review: nothing moves its branch from Open until their Accept or Return."""
    opened = opened_tip(cr)
    return (f'{cid}: open for your review since {opened[:12]}: {step} refuses it until the user\'s Accept or Return ends it '
            f'({edits_line(cid, opened)} records their edits)') if opened else None


def refuse_open(cid: str, cr: dict, step: str) -> None:
    if refusal := open_refusal(cid, cr, step):
        raise BoardError(refusal)


def stopped_on_user_edit(board: Board, cr: dict) -> bool:
    """The CR's worktree is mid a rebase the board started, stopped on one of the user's recorded edit commits: a deciding session merges
    it with the user, never a refresher (change-requests.md Rebase). A conflict on any other commit stays refresh work."""
    wt = review_worktree(board, cr)
    return bool(wt) and stopped_edit_commit(cr, wt) is not None


def stopped_edit_commit(cr: dict, wt: Path) -> str | None:
    """The user's recorded edit commit the board's own rebase in `wt` stopped on, else None."""
    stopped = rev(wt, 'REBASE_HEAD') if own_rebase(wt, cr) else None
    return stopped if stopped and user_edit_entry(cr_worktree_main(wt), cr, stopped) is not None else None


def user_edit_entry(main: Path, cr: dict, commit: str) -> dict | None:
    """The recorded edit entry `commit` is, or a rebase's or merge's rewrite of (same author, time): the user's edit commit it came from."""
    return next((one for one in edit_entries(cr) if one['commit'] == commit
                 or (rev(main, one['commit']) and author_stamp(main, one['commit']) == author_stamp(main, commit))), None)


def accept_waits(board: Board, cr: dict) -> list[str]:
    """What a change request waiting for its Accept waits on before it can land and no session clears at the Accept: its
    unlanded parent, in any state, and the waits `cr_waits` lifts. Return and Reject wait on none of them."""
    parent = live_parent(board, cr)
    return list(dict.fromkeys([*([parent] if parent else []), *board.cr_waits(cr)[0]]))


def cr_claimable(board: Board, cr: dict, kind: str) -> str | None:
    if board.cr_waits(cr)[0] or board.cr_stuck(cr):
        return None  # includes a review whose base was returned (q206); a named Accept claim takes one anyway (`claim`); no item of it is ready
    if kind == 'accept' and autopilot_barred(board):
        return None  # finished CRs wait for the user's Accept
    if kind == 'accept' and accept_waits(board, cr):
        return None  # nothing of it can land yet: the next claim passes it
    if kind != 'plan' and cr_worktree_state(board, cr):
        return None  # a git state the board did not start: claim refuses it, so the queue does not offer it (board check names it)
    if kind not in ('plan', 'accept') and opened_tip(cr):
        return None  # claim refuses an item open for the user's review (only a deciding session's accept claim takes it)
    if kind == 'accept' and refresh_target(board) == cr['id']:
        return 'refresh'  # the head of the queue gets the refresh before its Accept
    return kind


def cr_stage(cr: dict) -> str | None:
    """The place of a change request as the views show it: review, accept (waiting for the user)."""
    if cr['status'] == PASSED:
        return 'accept'
    if cr['status'] == 'in_review':
        return 'review'
    return None


def edit_entries(cr: dict) -> list[dict]:
    """The commits `board cr edits --commit` made from the user's review edits, recorded in the CR's metadata `review_edits` (JSON list
    of {commit}): the user's own edits, which keep the review (`edit_commits`)."""
    try:
        found = json.loads(meta(cr).get('review_edits') or '[]')
    except ValueError:
        return []
    return [one for one in found if isinstance(one, dict) and one.get('commit')] if isinstance(found, list) else []


def is_replay(root: Path, recorded: str, commit: str) -> bool:
    """`commit` is the recorded commit or a clean replay of it: replaying the recorded change onto `commit`'s parent (a 3-way merge
    from the recorded parent, as git's rebase does) gives exactly `commit`'s tree. Exact in content and place, unlike a patch-id
    (r16 N5); unlike one, it also holds when only the context around the change moved, and fails on a resolved conflict."""
    if commit == recorded:
        return True
    parents = git_text(root, 'rev-list', '--parents', '-n', '1', commit).split() if rev(root, commit) else []
    if len(parents) != 2 or rev(root, recorded) is None:
        return False
    merged = git(root, 'merge-tree', '--write-tree', f'--merge-base={recorded}^', parents[1], recorded, check=False)
    return merged.returncode == 0 and merged.stdout.decode().split()[:1] == [git_text(root, 'rev-parse', f'{commit}^{{tree}}').strip()]


def edit_commits(root: Path, cr: dict, base: str, tip: str) -> list[bool]:
    """For each commit in base..tip, oldest first: whether it is one of the recorded edit commits (or its replay), each recorded
    commit matched at most once."""
    left = [one['commit'] for one in edit_entries(cr)]
    out = []
    for commit in git_text(root, 'rev-list', '--reverse', f'{base}..{tip}').split():
        match = next((one for one in left if is_replay(root, one, commit)), None)
        if match is not None:
            left.remove(match)
        out.append(match is not None)
    return out


def edits_only(main: Path | None, cr: dict, reviewed: str, tip: str) -> bool:
    """Every commit after the reviewed tip, up to `tip`, is one of the recorded edit commits or its replay after a rebase: the user's
    own edits need no agent review. A copied message, or the same change at another place, does not count."""
    if main is None or not is_ancestor(main, reviewed, tip):
        return False
    found = edit_commits(main, cr, reviewed, tip)
    return bool(found) and all(found)


def review_current(cr: dict, info: dict) -> bool:
    """The review verdict holds for the (tip, base tip) pair now (q236), also past the reviewed tip while every later commit is
    one of the user's recorded review edits (r15-q77); `info['main']` lets it read them."""
    m = meta(cr)
    reviewed = m.get('review_tip')
    if not reviewed or m.get('review_base_tip') != info['baseTip']:
        return False
    return reviewed == info['tip'] or edits_only(info.get('main'), cr, reviewed, info['tip'])


def accept_covered(cr: dict, info: dict) -> bool:
    """A direct user review covers the displayed change. Agent review also covers clean replays."""
    if meta(cr).get('no_agent_review_reason') or review_current(cr, info):
        return True
    m = meta(cr)
    main, tip, base = info.get('main'), info.get('tip'), info.get('baseTip')
    covered_tip, covered_base = m.get('review_tip'), m.get('review_base_tip')
    return bool(main and tip and base and covered_tip and covered_base
                and replays(main, cr, covered_base, covered_tip, base, tip))


def incoming_cr_commits(main: Path, cr: dict, from_base: str | None, to_base: str | None,
                        branch_tip: str | None) -> list[dict] | None:
    """Report CR drift when the current base continues the covered base."""
    if from_base and from_base == to_base:
        return []
    if not from_base or not to_base or not is_ancestor(main, from_base, to_base):
        return None
    fork = meta(cr).get('base_sha')
    if not branch_tip or not fork or not is_ancestor(main, fork, branch_tip):
        return None
    return incoming_main_commits(main, from_base, to_base, fork, branch_tip)


def incoming_main_commits(main: Path, start: str, end: str, change_base: str, change_tip: str) -> list[dict] | None:
    """List incoming commits with their paths and overlaps with the given change, or None if either range is unavailable."""
    commits = git(main, 'log', '--reverse', '--no-renames', '--name-only', '--diff-merges=separate',
                  '-z', '--format=%x00%H%x00%s', f'{start}..{end}', check=False)
    changed = git(main, 'diff', '--name-only', '--no-renames', '-z', change_base, change_tip, check=False)
    if commits.returncode or changed.returncode:
        return None
    change_files = set(changed.stdout.decode('utf-8', 'replace').split('\x00'))
    by_tip: dict[str, tuple[str, set[str]]] = {}
    records = iter(commits.stdout.decode('utf-8', 'replace').split('\x00'))
    first_path = False
    for record in records:
        if not record:
            tip = next(records, '')
            if not tip:
                break
            subject = next(records)
            files = by_tip.setdefault(tip, (subject, set()))[1]
            first_path = True
        else:
            files.add(record.removeprefix('\n') if first_path else record)
            first_path = False
    return [{'tip': tip, 'subject': subject, 'files': sorted(files), 'crFiles': sorted(change_files & files)}
            for tip, (subject, files) in by_tip.items()]


def incoming_main_text(commits: list[dict] | None, from_base: str | None, to_base: str | None) -> str:
    title = f"incoming main commits and files ({(from_base or '?')[:12]}..{(to_base or '?')[:12]}):"
    if commits is None:
        return title + '\n  unavailable: the covered base or current base is not reachable'
    if not commits:
        return title + '\n  none'
    rows = [title]
    for one in commits:
        overlap = f" [touches CR files: {', '.join(one['crFiles'])}]" if one['crFiles'] else ''
        rows.append(f"  commit {one['tip']} {one['subject']}{overlap}")
        rows.append('    files: ' + (', '.join(one['files']) or 'none'))
    return '\n'.join(rows)


def range_delta(main: Path, cr: dict, base_tip: str | None, tip: str | None, *, user_seen: bool = False) -> str | None:
    """The range-diff since the last review or look, empty when every commit is equal."""
    m = meta(cr)
    base_tip = m.get('base_sha') or base_tip  # the branch's own series starts at its fork, even when the target has since moved
    old_tip = m.get('user_seen_tip' if user_seen else 'review_tip')
    old_base = m.get('user_seen_base_tip' if user_seen else 'review_base_tip')
    if not old_tip or not old_base or not base_tip or not tip:
        return None
    if (old_tip, old_base) == (tip, base_tip):
        return ''
    diff = git(main, 'range-diff', '--no-color', f'{old_base}..{old_tip}', f'{base_tip}..{tip}', check=False)
    if diff.returncode:
        return None
    shown = diff.stdout.decode('utf-8', 'replace').rstrip()
    return '' if all(line.split()[2:3] == ['='] for line in shown.splitlines()) else shown


def after_base(board: Board, cr: dict) -> str | None:
    """The unlanded parent a passed look-after CR (or one with nothing to merge) waits for: it lands when that parent has (A1). A
    passed request with no such parent waits for its landing or the user's Accept."""
    base = live_parent(board, cr) if cr['status'] == PASSED else None
    if not base:
        return None
    info = cr_info(board, cr)
    try:  # a CR with nothing to merge waits for its base in either look (r10-q50)
        return base if cr_look(board, cr) == 'after' or (info['main'] and no_own_commits(info['main'], cr, info['tip'])) else None
    except BoardError:
        return None


UNBLOCKED_TYPES = (WORK_TYPE, 'decision', CR_TYPE)  # what a request's count holds: work, not containers (milestone, gate)


def cr_milestone(board: Board, cr_id: str) -> str | None:
    """Title of the open milestone the request is work of (`milestones_of`); several: the lowest milestone id."""
    found = milestones_of(board, board.by_id[cr_id])
    return board.by_id[found[0]].get('title', '') if found else None


def cr_problems(board: Board, cr: dict, info: dict, refresh_id: str | None) -> list[dict]:
    """What holds the request up, each with the step that clears it (`next`: action, and the command or paths where one applies), so
    the console and the text views name the same step. A stale check is refresh work only at the queue head and never
    while open for the user's review (`refresh_id`); a stop on the user's edit commit is merged with the user (change-requests.md Rebase)."""
    cid, m = cr['id'], meta(cr)
    stale_next = {'action': 'refresh', 'command': f'agents board cr refresh {cid}'} if cid == refresh_id \
        else {'action': 'merge'} if stopped_on_user_edit(board, cr) else {'action': 'wait'}
    out = []
    if in_work(cr) and m.get('base_sha') and m.get('setup_sha') != m.get('base_sha'):
        out.append({'kind': 'setup-failed', 'text': 'setup failed', 'next': {'action': 'claim', 'command': f'agents board claim {cid}'}})
    state = cr_worktree_state(board, cr)
    if state:
        out.append({'kind': 'git-state', 'text': f"mid {state} (not the board's)", 'next': {'action': 'owner', 'paths': [info['worktree']]}})
    accepting = board.kind(cr) == 'accept'
    parent = live_parent(board, cr) if accepting else None
    waits = accept_waits(board, cr) if accepting else [] if cr['status'] == PASSED else board.waits_of(cr)  # nor do waits its Accept
    for wait in waits:
        status = board.by_id.get(wait, {}).get('status', 'unknown')
        # a parent left the Accept only by a return (open, then rework) or a re-review: it never stacks in another state
        said = {'open': 'returned or in rework', 'in_review': 'in review'}.get(status, status) if wait == parent else status
        text = f'lands after {wait} (accept it first)' if status == PASSED else f'waits on {wait} ({said})'
        out.append({'kind': 'waits', 'text': text, 'next': {'action': 'wait'}})
    if board.cr_stuck(cr):  # no item is ready: name what each waits on, and a cycle among them
        for item in board.cr_items(cid):
            for blocker in board.item_waits(item, cid):
                out.append({'kind': 'waits', 'text': wait_sentence(item['id'], blocker, None), 'next': {'action': 'wait'}})
                if chain := wait_cycle(board, [(item['id'], blocker)]):
                    out.append({'kind': 'waits', 'text': f"wait cycle: {' waits on '.join(chain)}", 'next': {'action': 'wait'}})
    if accepting:
        if info['state'] != 'current':  # every state needs_refresh counts
            out.append({'kind': 'check', 'text': f"check {info['state']}", 'next': stale_next})
    if info['blocked']:
        out.append({'kind': 'land-blocked', 'text': f"land blocked: {', '.join(info['blocked'])}", 'next': {'action': 'ask-user', 'paths': info['blocked']}})
    return out


def problem_line(problem: dict) -> str:
    """A problem as the text views print it: what holds it up, then its step."""
    return f"{problem['text']}: {step_text(problem['next'])}"


def cr_json(board: Board, cr: dict, children: dict[str, list[str]], refresh_id: str | None) -> dict:
    m, info = meta(cr), cr_info(board, cr)
    pair = check_pair(cr) or {}
    base = m.get('base')
    parent = live_parent(board, cr)
    impact = board.unlocks.impact.get(cr['id'], UnlockImpact())
    priority, raised_by, by_item = effective_priority(board, cr)
    acceptance = None
    if cr['status'] == PASSED:
        delta = range_delta(info['main'], cr, info['baseTip'], info['tip'], user_seen=True) if info['main'] else None
        full_change = not m.get('user_seen_tip')
        fork = m.get('base_sha') or info['baseTip']
        if full_change and info['main'] and fork and info['tip']:
            delta = git(info['main'], 'diff', '--stat', f"{fork}..{info['tip']}", check=False).stdout.decode('utf-8', 'replace').rstrip()
        incoming_base = incoming_base_of(cr) or fork
        incoming = incoming_cr_commits(info['main'], cr, incoming_base, info['baseTip'], info['tip']) if info['main'] else None
        acceptance = {'seenTip': m.get('user_seen_tip'), 'seenBaseTip': m.get('user_seen_base_tip'),
                      'delta': delta, 'fullChange': full_change,
                      'noAgentReviewReason': m.get('no_agent_review_reason'), 'incomingBaseTip': incoming_base,
                      'incomingCommits': incoming}
    return {'id': cr['id'], 'title': cr.get('title', ''), 'status': cr['status'], 'stage': cr_stage(cr),
            'holder': cr.get('assignee') or None, 'look': m.get('look') or board.settings.get('look') or None,
            'view': m.get('view') or board.settings.get('view') or None,
            'base': base or board.settings.get('target') or None, 'branch': info['branch'],
            'worktree': info['worktree'], 'tip': info['tip'], 'baseTip': info['baseTip'],
            'check': {'state': info['state'], 'tip': pair.get('tip'), 'baseTip': pair.get('baseTip'), 'at': pair.get('at'),
                      'result': pair.get('result'), 'kind': pair.get('kind', 'full'), 'command': pair.get('command'), 'reason': pair.get('reason'),
                      'newFailures': ([] if m.get('check_new') == '-' else m['check_new'].splitlines()) if m.get('check_new') else None,
                      'baseCount': int(m['check_base_count']) if m.get('check_base_count') is not None else None,
                      'tipCount': int(m['check_tip_count']) if m.get('check_tip_count') is not None else None},
            'parent': parent,
            'children': children.get(cr['id'], []), 'baseSha': m.get('base_sha') or None,
            'problems': cr_problems(board, cr, info, refresh_id),  # the console's marks and its Update button (next.action refresh)
            'review': review_of(board, cr),  # open for the user's review: {opened, edited, files}, else null
            'acceptance': acceptance,
            'after': after_base(board, cr),
            'unblocks': impact.solo, 'unblocksDirect': impact.breadth, 'shares': impact.shared,
            'milestone': cr_milestone(board, cr['id']),
            'priority': priority, 'ownPriority': cr.get('priority', 9),  # the rank counts it at `priority`; raisedBy names what sets it
            'raisedBy': {'id': raised_by, 'isItem': by_item} if raised_by else None}


def waits_on_answers(board: Board, cr: dict) -> bool:
    """The request or one of its open items waits on a question still owed an answer or its release (r5-q26), the user's step. A wait on a question is met only when it closes, so an in-force ruling still holds the waiter until planning closes it: that is the planner's step, not counted here."""
    unit = work_unit(board, cr)
    return any(board.by_id.get(b, {}).get('issue_type') == 'decision' and board.by_id[b]['status'] in LIVE_DECISIONS
               for member in unit for b in board.blockers.get(member, []) if b not in unit)


def console_crs(board: Board, queue: list[dict]) -> tuple[list[dict], int, int]:
    """(the requests the console lists, those waiting on your answers, those queued): the accept queue, then those in work. The
    rest wait for an agent to pick them up and are only counted."""
    in_work = in_work_crs(board)
    rest = [i for i in live_crs(board) if i['status'] != 'deferred' and not is_in_work_cr(board, i) and board.kind(i) != 'accept']
    answering = sum(1 for i in rest if waits_on_answers(board, i))
    return [*queue, *in_work], answering, len(rest) - answering


def crs_json(board: Board, listed: list[dict], queue: list[dict]) -> list[dict]:
    for name in ('look', 'view', 'target'):  # the defaults a CR without its own value shows
        try:
            board_setting(board, name)
        except BoardError:
            pass
    children: dict[str, list[str]] = {}
    for issue in listed:
        base = live_parent(board, issue)
        if base:
            children.setdefault(base, []).append(issue['id'])
    return [cr_json(board, issue, children, refresh_target(board, queue)) for issue in listed]


def refresh_target(board: Board, queue: list[dict] | None = None) -> str | None:
    """The one request that is refresh work: the queue head, when stale and neither open for review nor stopped on the user's edit (r27-q252)."""
    head = queue_head(board, queue)
    return head['id'] if head and needs_refresh(board, head) and not opened_tip(head) and not stopped_on_user_edit(board, head) else None


def cr_deviations(board: Board, root: str | None) -> list[tuple[str, str, str]]:
    """Change requests that cannot work as set: invalid settings, a live worktree or branch missing."""
    scope = {i['id'] for i in board.scoped(root)}
    found = [(cid, 'cr-landing', problem) for cid, problem in board.__dict__.get('settle_problems', {}).items() if cid in scope]
    live = [i for i in live_crs(board) if i['id'] in scope]
    if live:
        found += [(live[0]['id'], 'cr-settings', problem) for problem in settings_problems(board)]
    for cr in live:
        legacy = [f"metadata checkpoint={meta(cr)['checkpoint']}"] if 'checkpoint' in meta(cr) else []
        if legacy:
            found.append((cr['id'], 'cr-checkpoint', f"{', '.join(legacy)}: the design checkpoint is retired and no longer read; follow /board-migrate"))
        state = cr_worktree_state(board, cr)  # any live CR with a worktree, a returned (open) one included: it left the claim queue
        if state:
            found.append((cr['id'], 'cr-git-state', f"{cr_worktree(board._main, cr['id'])} is mid {state} the board did not start: out of the claim queue until "
                                                    f'its owner finishes or aborts it (board-core.md Actors and holds)'))
        if not (in_work(cr) or cr['status'] in ('in_review', PASSED)):
            continue
        info = cr_info(board, cr)
        if info['main'] is None:
            continue
        if info['tip'] is None:
            found.append((cr['id'], 'cr-branch', f"{cr['status']} without its branch {info['branch']}: restore it, or agents board return/unclaim the change request"))
        elif not Path(info['worktree']).is_dir():
            found.append((cr['id'], 'cr-worktree', f"{cr['status']} without its worktree {info['worktree']}: git worktree add {info['worktree']} {info['branch']}"))
    return found


def open_worktree(board: Board, cr: dict, main: Path, start: str | None = None) -> tuple[bool, str | None]:
    """Makes sure the CR's worktree exists, creating it from its branch (a returned or moved CR) or from its base tip
    (a new one, recording the fork point, A3). `start`: a new branch forks there, on the target (a follow-up to a landed range
    forks at that range's tip; the next refresh rebases it). (worktree created here, the tip a branch created here started at)."""
    cid = cr['id']
    path, branch = cr_worktree(main, cid), cr_branch(cid)
    exclude_worktrees(main)
    if path.exists():
        head = git(path, 'rev-parse', '--abbrev-ref', 'HEAD', check=False).stdout.decode().strip()
        stuck = in_progress_state(path, cr)
        if stuck:
            raise BoardError(f'{cid}: {path} is mid {stuck} the board did not start: its owner finishes or aborts it, then claim again')
        if head != branch and not own_rebase(path, cr):  # detached mid the board's own rebase is the CR's (`sync_branch` resumes it)
            raise BoardError(f'{cid}: {path} exists but is on {head or "no branch"}, not {branch}: remove or fix it, then claim again')
        adopt_stack_base(board, cr)
        return False, None
    if rev(main, f'refs/heads/{branch}'):
        git(main, 'worktree', 'add', str(path), branch)
        adopt_stack_base(board, cr)
        return True, None
    base = None if start else next(iter(board.cr_waits(cr)[1]), None)
    if base:
        base_value, ref = base, f'refs/heads/{cr_branch(base)}'
    else:
        base_value = target_branch(board, main)
        ref = f'refs/heads/{base_value}'
    tip = start or rev(main, ref)
    if tip is None:
        raise BoardError(f'{cid}: base {base_value} has no branch')
    git(main, 'worktree', 'add', '-b', branch, str(path), tip)
    put_meta(cr, base=base_value, base_sha=tip)
    return True, tip


def adopt_stack_base(board: Board, cr: dict) -> None:
    """An existing branch takes the one stackable base that became eligible since it forked: only `base` changes, `base_sha` stays its true
    fork, so the next refresh replays the CR's own commits onto the base. Several candidate bases (a wait) or the board's own rebase in
    progress leave it as it is, and so does a CR past planning (in review or at Accept: its reviewed range stays)."""
    if cr['status'] != 'open':
        return
    base = next(iter(board.cr_waits(cr)[1]), None)
    if base and meta(cr).get('base') != base and not meta(cr).get('rebase_onto'):
        put_meta(cr, base=base)


def drop_worktree(main: Path, cr_id: str, branch_tip: str | None) -> None:
    """Undoes what a failed claim made: a worktree this call added (never forced) when nobody holds the CR now, and the branch
    only when this call created it and it still points where it was created. A branch that existed before is never touched (F3)."""
    held = bd_show([cr_id], comments=False)
    if held and held[0].get('assignee'):
        return
    if git(main, 'worktree', 'remove', str(cr_worktree(main, cr_id)), check=False).returncode == 0 and branch_tip:
        git(main, 'update-ref', '-d', f'refs/heads/{cr_branch(cr_id)}', branch_tip, check=False)


def ensure_setup(board: Board, cr: dict, wt: Path) -> str | None:
    """Runs the project setup when the base commit differs from the one it last ran at (q210, A5); its output tail on failure."""
    sha = meta(cr).get('base_sha')
    if sha and meta(cr).get('setup_sha') == sha:
        return None
    code, out = run_shell(wt, board_setting(board, 'setup'))
    if code:
        return out or f'setup exited {code}'
    if sha:
        put_meta(cr, setup_sha=sha)
    return None


def conflict_files(wt: Path) -> str:
    """The unmerged paths of a stopped rebase, as a lead-in for the refusal ('' when none)."""
    paths = git_text(wt, 'diff', '--name-only', '--diff-filter=U').split()
    return f"files {', '.join(paths[:5])}{' and more' if len(paths) > 5 else ''}: " if paths else ''


def user_edit_conflict(cr: dict, wt: Path) -> str:
    """The lead-in a stopped rebase's message gets when it stopped on one of the user's recorded edit commits ('' otherwise): who
    resolves it and the step that follows (change-requests.md Rebase)."""
    stopped = stopped_edit_commit(cr, wt)
    return (f"the conflict is in the user's edit commit {stopped[:12]}: a deciding session merges it with the user, and once they confirm it "
            f"agents board cr edits {cr['id']} --merged <the merge commit> records it as theirs; ") if stopped else ''


def resume_rebase(cr: dict, wt: Path) -> dict | None:
    """The board finishes its own stopped rebase for whoever holds the CR: mid a rebase whose target is the CR's recorded `rebase_onto`
    (a foreign one is `tree_problem`'s refusal), with every conflict resolved and added, `git rebase --continue` runs with the editor
    suppressed. Unmerged paths left: refuse, the holder resolves and reruns. {from, fork} of the finished rebase, else None."""
    if not own_rebase(wt, cr):
        return None
    cid = cr['id']
    if git_text(wt, 'diff', '--name-only', '--diff-filter=U').split():
        raise BoardError(f'{cid}: the rebase the board started is still stopped on a conflict in {wt}: {user_edit_conflict(cr, wt)}{conflict_files(wt)}resolve it, '
                         'git add the files, then rerun this command (it continues the rebase)')
    started, fork = meta(cr).get('rebase_from'), meta(cr).get('base_sha')
    stopped, onto = rev(wt, 'REBASE_HEAD'), rebase_target(wt)  # what the rebase stopped on, before it continues
    done = git(wt, 'rebase', '--continue', env={'GIT_EDITOR': 'true'}, check=False)
    if done.returncode != 0:
        detail = (done.stderr or done.stdout).decode('utf-8', 'replace').strip()
        raise BoardError(f'{cid}: git rebase --continue stopped in {wt}: {conflict_files(wt)}{detail}; resolve it, git add the files, '
                         'then rerun this command')
    main = cr_worktree_main(wt)
    if stopped and onto and user_edit_entry(main, cr, stopped):  # the merge of a conflict on the user's edit: theirs only once they confirm it
        stamp_of = author_stamp(main, stopped)
        merged = next((c for c in git_text(wt, 'rev-list', '--reverse', f'{onto}..HEAD').split() if author_stamp(main, c) == stamp_of), None)
        if merged:
            print(f"{cid}: the rebase continued past your edit commit {stopped[:12]} (now {merged[:12]}); once you confirm the merge, "
                  f'record it as yours: agents board cr edits {cid} --merged {merged[:12]}')
    return {'from': started or rev(wt, 'HEAD'), 'fork': fork or rev(wt, 'HEAD')}


def sync_branch(board: Board, cr: dict, main: Path, wt: Path, check: bool = True, reuse: bool = False) -> dict:
    """Rebase onto the base tip (`--onto <base tip> <fork point>`, A3), set up when the base moved, run the checks (`reuse`: unless a full pass is stored for this tip and base), store the
    (tip, base tip) pair (q209) from a clean tree (A5). The checks' failure is a result, not an error."""
    cid = cr['id']
    resumed = resume_rebase(cr, wt)
    problem = tree_problem(wt)
    if problem:
        raise BoardError(f'{cid}: {problem}')
    base_value, ref = cr_base(board, cr, main)
    base_tip = rev(main, ref)
    if base_tip is None:
        raise BoardError(f'{cid}: base {base_value} has no branch')
    fork = meta(cr).get('base_sha') or git_text(wt, 'merge-base', base_tip, 'HEAD').strip()
    old_tip, moved = rev(wt, 'HEAD'), None
    if resumed:  # the rebase this call finished: report the range it moved, not the finished branch
        old_tip, moved = resumed['from'], resumed['fork']
    # Every rebase is `--onto <base tip> <fork point>`; the marker remembers a rebase that stopped on a conflict, so a rerun
    # after the base moved again does not replay the base's own commits (F4, F5).
    marker, started_at = meta(cr).get('rebase_onto'), meta(cr).get('rebase_from')
    if marker and is_ancestor(wt, marker, 'HEAD') and not (started_at and is_ancestor(wt, started_at, 'HEAD')):
        fork = marker  # that rebase was completed by hand: HEAD has its target and no longer the commits it started from
        put_meta(cr, base_sha=fork, rebase_onto=None, rebase_from=None)
    if fork != base_tip:
        if is_ancestor(wt, base_tip, 'HEAD') and is_ancestor(wt, fork, base_tip):
            pass  # the branch already contains the base tip, and only the fork point was behind
        else:
            moved = fork
            put_meta(cr, rebase_onto=base_tip, rebase_from=old_tip)
            if git(wt, 'rebase', '--onto', base_tip, fork, check=False).returncode != 0:
                raise BoardError(f'{cid}: the rebase onto {base_tip[:12]} stopped on a conflict in {wt}: {user_edit_conflict(cr, wt)}{conflict_files(wt)}resolve it, '
                                 'git add the files, then rerun this command (it continues the rebase)')
    put_meta(cr, base=base_value, base_sha=base_tip, rebase_onto=None, rebase_from=None)
    fetch_board(main)  # the branch moved: a review folder's Incoming and Outgoing follow
    head = rev(wt, 'HEAD')
    failure = ensure_setup(board, cr, wt)
    if failure is not None:
        raise BoardError(f'{cid}: setup failed (the claim stays; hand-over waits until it passes):\n{failure}')
    if not check:  # the caller stores its own targeted check for this tip
        board._cr.pop(cid, None)
        return {'oldTip': old_tip, 'oldBase': resumed['fork'] if resumed else fork, 'moved': moved is not None, 'baseTip': base_tip, 'tip': rev(wt, 'HEAD'), 'code': 0, 'output': ''}
    stored = check_pair(cr)
    if reuse and stored and stored['kind'] == 'full' and stored['result'] == 'pass' and (stored['tip'], stored['baseTip']) == (head, base_tip):  # a pass on this tree and base is never rerun
        board._cr.pop(cid, None)
        return {'oldTip': old_tip, 'oldBase': resumed['fork'] if resumed else fork, 'moved': moved is not None, 'baseTip': base_tip, 'tip': head, 'code': 0, 'output': ''}
    passed, out, detail = check_verdict(board, cr, main, wt, base_tip)
    code = 0 if passed else 1
    tip = rev(wt, 'HEAD')
    if tip != head or tree_problem(wt):  # the pair must name the tree that was checked (F8)
        raise BoardError(f'{cid}: setup or the checks changed the worktree (a commit, or uncommitted files); nothing was recorded: '
                         f'{tree_problem(wt) or "HEAD moved from " + head[:12] + " to " + tip[:12]}')
    put_meta(cr, check_tip=tip, check_base_tip=base_tip, check_result='pass' if passed else 'fail', check_at=stamp(), check_output=out or None,
             check_new=('\n'.join(detail['new']) or '-') if detail else None, check_base_count=detail['base'] if detail else None,
             check_tip_count=detail['tip'] if detail else None, check_kind=None, check_command=None, check_reason=None)
    board._cr.pop(cid, None)
    return {'oldTip': old_tip, 'oldBase': resumed['fork'] if resumed else fork, 'moved': moved is not None, 'baseTip': base_tip, 'tip': tip, 'code': code, 'output': out}


def claim_cr(board: Board, cr: dict, actor: str, kind: str, agreed: bool = False) -> tuple[bool, str]:
    """Claims a change request for the pull that found it. Work: the worktree first, then the hold (a worktree failure leaves
    it unclaimed), then setup (a failure keeps the claim, A5). Planning: the hold. Review, accept, refresh: the hold, status kept."""
    cid = cr['id']
    if kind == 'plan':
        return claim_one(board, cr, actor, {HOLD: 'plan', **({PLAN_FIRST: None} if meta(cr).get(PLAN_FIRST) else {})})
    if kind == 'review' and (refusal := self_review_refusal(cr, actor, agreed)):
        return False, refusal
    main = main_root()
    if kind != 'accept':  # only a deciding session's accept claim takes an item open for the user's review
        refuse_open(cid, cr, f'a {kind} claim')
    created, made_tip = open_worktree(board, cr, main)
    ok, message = (True, '') if holds_cr(cr, actor) else claim_one(board, cr, actor, {HOLD: 'work'} if kind == 'implement' else None, agreed)  # a planner's hold carries on
    if ok and kind == 'implement' and meta(cr).get(HOLD) != 'work':
        put_meta(cr, **{HOLD: 'work'})
    if not ok:
        if created and kind == 'implement':
            drop_worktree(main, cid, made_tip)
        return False, message
    if kind == 'implement':
        print(f'  worktree {cr_worktree(main, cid)} on {cr_branch(cid)}; base {meta(cr).get("base") or target_branch(board, main)}')
        failure = ensure_setup(board, cr, cr_worktree(main, cid))
        if failure is not None:
            print(f'  setup failed; the claim stays and hand-over waits until it passes:\n{failure}', file=sys.stderr)
    else:
        print(f'  worktree {cr_worktree(main, cid)}')
        if kind == 'review':
            tip = rev(main, f'refs/heads/{cr_branch(cid)}')
            put_meta(cr, reviewing_tip=tip)  # the tip this reviewer is shown
            info = cr_info(board, cr)
            if meta(cr).get('review_tip') and tip and not review_current(cr, info):
                delta = range_delta(main, cr, info['baseTip'], tip)
                print('  prior range unavailable; read the full change' if delta is None else
                      '  range-diff since the last covered series:\n' + (delta or '(no changes since prior coverage)'))
    return True, ''


def open_item_refusal(board: Board, cr: dict) -> str | None:
    items = board.cr_items(cr['id'])
    return f"{cr['id']}: items still open: {', '.join(i['id'] for i in items)}; close them (agents board close {' '.join(i['id'] for i in items)} --reason \"<sha>: …\"), or the planner moves one out (agents board move <item> --to <change request>)" if items else None


class LandedError(BoardError):
    """The target already holds the tip: only the work after the fast-forward failed."""


def no_own_commits(main: Path, cr: dict, tip: str) -> bool:
    """The CR's branch holds no commit of its own: nothing between its fork point and its tip (r10-q50). An unknown fork point
    counts as commits, so a CR the board cannot judge goes the normal way."""
    fork = meta(cr).get('base_sha')
    if not fork or not tip:
        return False
    counted = git(main, 'rev-list', '--count', f'{fork}..{tip}', check=False)
    return counted.returncode == 0 and counted.stdout.decode().strip() == '0'


def finish_landing(board: Board, cr: dict, tip: str, name: str, main: Path) -> list[str]:
    """What follows the target holding the CR's tip, idempotent (ff and close are two writes, A6): the close (forced: the git fact is authoritative), the CRs stacked on it re-based to the target, the worktree
    and branch gone (the branch only if it still is at the landed tip)."""
    cid, notes = cr['id'], []
    look = cr_look(board, cr)
    if cr['status'] != 'closed':
        move(cr, 'landing', board=board, reason=f'landed {tip[:12]} on {name} from {cr_branch(cid)}', force=True)
    board.__dict__.pop('unlocks', None)
    for other in live_crs(board):
        if meta(other).get('base') == cid:
            put_meta(other, base=name)
            if opened_tip(other):  # open for review on a branch whose upstream was this one's
                set_upstream(main, cr_branch(other['id']), name)
    wt = cr_worktree(main, cid)
    if wt.exists() and git(main, 'worktree', 'remove', str(wt), check=False).returncode != 0:
        notes.append(f'worktree {wt} kept (it holds uncommitted files)')
    elif git(main, 'update-ref', '-d', f'refs/heads/{cr_branch(cid)}', tip, check=False).returncode == 0:
        drop_upstream(main, cr_branch(cid))
        notes.append(f'removed {wt} and {cr_branch(cid)}')
    else:
        notes.append(f'{cr_branch(cid)} kept (it moved past {tip[:12]})')
    fetch_board(main)  # the target moved: a review folder's Incoming follows
    return notes


def settle_landed(board: Board) -> bool:
    """A change request whose tip the target holds is landed (A6): the next board command finishes what a failed second write
    left. Only a tip the board vouched for counts: the one `land` wrote as `landing` before advancing the target, or the checked
    tip with commits past its fork point; a branch that merely fast-forwarded to the target is not landed (F6). A failure is
    kept per change request for `board check`, never stopping the command."""
    changed = False
    live = [i for i in live_crs(board) if in_work(i) or i['status'] in ('in_review', PASSED)]
    if not live:
        return False
    try:
        main = main_of(board)
        name = target_branch(board, main)
    except BoardError:
        return False
    if view_rev(board, main, f'refs/heads/{name}') is None:
        return False
    # One read for every request: the CR branches the target holds, with their tips.
    held = {ref: sha for sha, _, ref in (row.partition(' ') for row in git_text(
        main, 'for-each-ref', '--merged', f'refs/heads/{name}', '--format=%(objectname) %(refname)', f"refs/heads/{cr_branch('')}").splitlines())}
    problems = board.__dict__.setdefault('settle_problems', {})
    for cr in live:
        tip = held.get(f"refs/heads/{cr_branch(cr['id'])}")
        fork, m = meta(cr).get('base_sha'), meta(cr)
        if tip and (m.get('landing') == tip or (m.get('check_tip') == tip and bool(fork) and tip != fork)):
            board.git_view = None  # finishing a landing (even a failed one) moves branches and worktrees: live reads from here on
            try:
                for note in finish_landing(board, cr, tip, name, main):
                    print(f"{cr['id']}: landed on {name} (the target holds {tip[:12]}); {note}", file=sys.stderr)
                changed = True
            except BoardError as error:
                problems[cr['id']] = f'the target holds {tip[:12]} but finishing the landing failed: {error}'
    return changed


def pair_moved_refusal(cid: str, part: str, seen: str | None, tip: str, base: str) -> PairMoved:
    """`part` moved since the pair the user saw (`seen`; None: while the check ran). Land re-syncs and checks a moved pair
    itself, so the step is the user's Accept of the current pair, not a refresh."""
    now = tip if part == 'branch' else base
    since = f'since the pair you saw ({seen[:12]}); now {now[:12]}' if seen else 'while the check ran'
    look = 'the current change' if part == 'branch' else 'the incoming commits (listed above)'
    return PairMoved(f'{cid}: the {part} moved {since}.',
                     [{'action': 'ask-user', 'text': f'ask the user to Accept {look}, then agents board cr land {cid} --tip {tip} --base {base}'}], part)


def land_core(board: Board, cr: dict, main: Path, tip: str, base_tip: str) -> list[str]:
    """Fast-forwards the target to the CR's tip and finishes the landing. Refuses unless the base is the target, the items
    are closed and the check and review pairs are the current (branch tip, target tip) with a pass (q183, q209, q236, A1, A6)."""
    cid = cr['id']
    base, _ = cr_base(board, cr, main)
    if board.is_cr(base):
        raise BoardError(f'{cid}: stacked on {base}, which has not landed: agents board cr land {base} first')
    refusal = open_item_refusal(board, cr)
    if refusal:
        raise BoardError(refusal)
    name = target_branch(board, main)
    ref = f'refs/heads/{name}'
    branch_tip, old = rev(main, f'refs/heads/{cr_branch(cid)}'), rev(main, ref)
    if branch_tip is None:
        raise BoardError(f'{cid}: no branch {cr_branch(cid)}')
    if rev(main, tip) != branch_tip:
        raise pair_moved_refusal(cid, 'branch', tip, branch_tip, old)
    if old != base_tip:
        raise pair_moved_refusal(cid, 'base', base_tip, branch_tip, old)
    review = review_read(board, cr)
    if review:  # the user's Accept: an unedited review ends with it; one with edits is recorded first (it rebases and checks them)
        refuse_unrecorded(cid, review, f'{edits_line(cid, review["opened"])} records them, then land')
    refresh_step = f'{edits_line(cid, review["opened"])} ends your review, then agents board cr refresh {cid}' if review else f'agents board cr refresh {cid}'
    pair = check_pair(cr)
    if pair is None or pair['result'] != 'pass' or pair['tip'] != branch_tip or pair['baseTip'] != old:
        state = check_state(main, cr, branch_tip, old)
        raise BoardError(f'{cid}: not landed, its check is {state} (it must pass for tip {branch_tip[:12]} on {name} {old[:12]}): {refresh_step}',
                         next=[{'action': 'refresh', 'command': refresh_step}])
    if not accept_covered(cr, {'tip': branch_tip, 'baseTip': old, 'main': main}):
        if cr['status'] == PASSED:
            send_to_review(board, cr)
            raise BoardError(f'{cid}: the series changed since its last review; sent to agent review', next=[{'action': 'wait'}])
        raise BoardError(f'{cid}: the series changed since its last review; review the current change',
                         next=[{'action': 'review', 'text': f'review the current change, then pass it again (agents board handover {cid} "<evidence>")'}])
    where, rebasing = checked_out_at(main, ref)
    if rebasing:
        raise BoardError(f'{cid}: not landed, {rebasing}')
    blocked = land_blocked(main, name, branch_tip)
    if blocked:
        raise BoardError(f"{cid}: land blocked: uncommitted edits in the worktree with {name} checked out overlap: {', '.join(blocked)}; they are the user's: ask the user to commit or move them, and do not restore or stash them yourself")
    landing_fields = {'landing': branch_tip, **({OPENED: None} if review else {})}
    put_meta(cr, **landing_fields)  # vouches for this tip: if the close fails after the fast-forward, the next read finishes it
    done = git(where, 'merge', '--ff-only', branch_tip, check=False) if where else git(main, 'update-ref', ref, branch_tip, old, check=False)
    if done.returncode != 0:
        put_meta(cr, landing=None)
        raise BoardError(f"{cid}: the fast-forward of {name} failed: {done.stderr.decode('utf-8', 'replace').strip() or 'exit ' + str(done.returncode)}")
    after = [other for other in live_crs(board) if after_base(board, other) == cid]  # before their base is reset to the target
    try:
        notes = finish_landing(board, cr, branch_tip, name, main)
    except BoardError as error:
        raise LandedError(f'{cid}: {name} now holds {branch_tip[:12]}, but finishing the landing failed ({error}); the next board read finishes it') from None
    board._cr.clear()
    for other in after:
        try:
            child_info = cr_info(board, other)
            if child_info['state'] == 'current' and review_current(other, child_info):
                notes.append(f"{other['id']} (after {cid}): " + '; '.join(land_core(board, other, main, child_info['tip'], child_info['baseTip'])))
            else:
                notes.append(f"{other['id']} (after {cid}): left as refresh work (its check or review no longer matches)")
        except LandedError as error:
            notes.append(f"{other['id']} (after {cid}): landed on {name}, but: {error}")
        except BoardError as error:
            notes.append(f"{other['id']} (after {cid}): not landed: {error}")
    return notes


def cr_arg(board: Board, item_id: str, verb: str) -> dict:
    """The change request the verb names; an item inside one is told to use its CR."""
    issue = require_open(board, [item_id])[0]
    if not board.is_cr(item_id):
        cr_id = board.cr_of(item_id)
        raise BoardError(f"{item_id}: board {verb} works on change requests" + (f"; its change request is {cr_id}" if cr_id else ''))
    return issue


def holds_cr(issue: dict, actor: str) -> bool:
    holder = issue.get('assignee')
    return bool(holder) and session_actor(holder) == session_actor(actor)


def pass_to_user(board: Board, cr: dict, command: str, **fields) -> None:
    """Moves a change request to passed, unassigned, remembering since when: it waits for the user's Accept (look before) or for
    its landing."""
    move(cr, command, to='passed', fields={'since': stamp(), **fields}, board=board)


def handover(board: Board, args) -> None:
    actor = caller()
    cr = cr_arg(board, args.id, 'handover')
    holder = cr.get('assignee')
    if not holds_cr(cr, actor):
        raise BoardError(f"{args.id}: {cr['status']}, held by {holder or 'nobody'}; claim it first",
                         next=[{'action': 'wait'} if holder else {'action': 'claim', 'command': f'agents board claim {args.id}'}])
    m, status = meta(cr), cr['status']
    author = status == 'open'
    if author and not in_work(cr):
        raise BoardError(f'{args.id}: held for planning, not in work; claim it for work first: agents board claim {args.id}',
                         next=[{'action': 'claim', 'command': f'agents board claim {args.id}'}])
    if not author and status != 'in_review':
        raise BoardError(f'{args.id}: {status}; only work in hand is handed over or an agent review is passed (use agents board cr request-review at Accept)',
                         next=[{'action': 'review', 'command': f'agents board cr request-review {args.id} "<reason>"'} if status == PASSED else {'action': 'wait'}])
    no_agent_reason = args.no_agent_review
    if no_agent_reason is not None:
        if not author:
            raise BoardError('--no-agent-review is only available on an author handover, not a reviewer pass')
        if cr_look(board, cr) != 'before':
            raise BoardError('--no-agent-review is refused in a look-after project')
        refuse_long_comment(f'no agent review: {no_agent_reason}')
    refuse_long_comment(HANDOVER + args.evidence)
    refusal = open_item_refusal(board, cr)
    if refusal:
        raise BoardError(refusal)
    main = main_root()
    wt = cr_worktree(main, args.id)
    if not wt.is_dir():
        raise BoardError(f'{args.id}: no worktree {wt}: git worktree add {wt} {cr_branch(args.id)}',
                         next=[{'action': 'worktree', 'command': f'git worktree add {wt} {cr_branch(args.id)}'}])
    refuse_open(args.id, cr, 'handover')
    result = checked_sync(board, cr, main, wt, args, reuse=True)
    if result['code']:
        raise BoardError(f"{args.id}: checks failed, not handed over:\n{result['output']}",
                         next=[{'action': 'fix', 'text': 'fix the failing checks (output above), then hand over again'}])
    look = cr_look(board, cr)
    seen = meta(cr).get('reviewing_tip')
    if status == 'in_review' and result['tip'] != seen:  # the pass records only a tip the reviewer saw; none seen counts as moved (F2)
        put_meta(cr, reviewing_tip=result['tip'])
        if seen:
            shown = git(wt, 'range-diff', f"{result['oldBase']}..{seen}", f"{result['baseTip']}..{result['tip']}", check=False).stdout.decode('utf-8', 'replace')
            said = f"the tip moved from {seen[:12]} to {result['tip'][:12]} (a rebase onto the new base, or new commits) since you looked"
        else:
            shown = git(wt, 'log', '--stat', '--format=%h %s', f"{result['baseTip']}..{result['tip']}", check=False).stdout.decode('utf-8', 'replace')
            said = f"no tip is recorded as seen by you (the CR was taken over); the tip is {result['tip'][:12]}"
        raise BoardError(f"{args.id}: {said}; nothing was recorded. Review the change, then pass again:\n{shown.rstrip() or '(nothing to show)'}")
    if author:
        if no_agent_reason is not None:
            pass_to_user(board, cr, 'handover --no-agent-review', no_agent_review_reason=no_agent_reason, reviewing_tip=None, hold=None, author=actor)
            comment(args.id, HANDOVER + args.evidence)
            comment(args.id, f'no agent review: {no_agent_reason}')
            print(f'handed over {args.id} to your Accept without agent review: {no_agent_reason}')
            print("next: waits on the user's Accept")
            return
        move(cr, 'handover', board=board, fields={'no_agent_review_reason': None, 'reviewing_tip': None, HOLD: None, AUTHOR: actor})
        comment(args.id, HANDOVER + args.evidence)
        print(f'handed over {args.id} for review ({check_said(args)} on {result["tip"][:12]})')
        base = cr_base(board, cr, main)[0]
        if board.is_cr(base):
            after = f'then it waits for its base {base} to land'
        elif look == 'after' or no_own_commits(main, cr, result['tip']):
            after = 'it lands on its pass'
        else:
            after = "then the user's Accept"
        print(f'next: waits on agent review by a fresh worker, not you (agents board claim {args.id}); {after}')
        return
    comment(args.id, f'board pass: {args.evidence}')
    put_meta(cr, review_tip=result['tip'], review_base_tip=result['baseTip'], no_agent_review_reason=None)
    base = cr_base(board, cr, main)[0]
    empty = no_own_commits(main, cr, result['tip'])  # nothing to merge: lands on its passed review, in either look, unseen (r10-q50)
    if (look == 'after' or empty) and not board.is_cr(base):
        try:
            notes = land_core(board, cr, main, result['tip'], result['baseTip'])
        except LandedError as error:
            print(f'passed and landed {args.id}, but: {error}')
            return
        except BoardError as error:  # the pass stands; the Accept queue holds it until the landing can run
            pass_to_user(board, cr, 'handover (reviewer passes)')
            print(f'passed {args.id}, not landed: {error}\n  it waits in the Accept queue')
            return
        print('\n'.join(notes))
        print(f'passed and landed {args.id}')
        return
    if (look == 'after' or empty) and board.is_cr(base):  # lands with its parent when the check and this review still match (q219)
        pass_to_user(board, cr, 'handover (reviewer passes)')
        print(f'passed {args.id}: marked after {base}; it lands with {base} when its check and review still match')
        return
    pass_to_user(board, cr, 'handover (reviewer passes)')
    print(f'passed {args.id}: waiting for your Accept')


def send_to_review(board: Board, cr: dict) -> None:
    keys = ('since', 'reviewing_tip', 'no_agent_review_reason', OPENED)
    move(cr, 'send to review', board=board, fields={key: None for key in keys if key in meta(cr)})
    board._cr.pop(cr['id'], None)


def route_uncovered(board: Board, cr: dict, info: dict) -> bool:
    if cr['status'] != PASSED or accept_covered(cr, info):
        return False
    send_to_review(board, cr)
    return True


def request_review(board: Board, args) -> int:
    actor = derived_actor() or 'user'
    cr = cr_arg(board, args.id, 'request-review')
    if cr['status'] != PASSED:
        raise BoardError(f"{args.id}: {cr['status']}; request-review works only at the user's Accept", next=[{'action': 'wait'}])
    if cr.get('assignee') and not holds_cr(cr, actor):
        raise BoardError(f"{args.id}: held by {cr['assignee']}; request review once that session releases it", next=[{'action': 'wait'}])
    review = review_read(board, cr)
    if review:
        refuse_unrecorded(args.id, review, f'{edits_line(args.id, review["opened"])} records them, then request review')
    main = main_root()
    info = cr_info(board, cr)
    if not info['tip'] or not info['baseTip']:
        raise BoardError(f'{args.id}: its branch or base is gone; cannot request review')
    if why := table_refusal(board, cr, 'send to review'):
        raise BoardError(why)
    shown = range_delta(main, cr, info['baseTip'], info['tip'])
    send_to_review(board, cr)
    detail = ''
    if meta(cr).get('review_tip'):
        detail = ('\nprior range unavailable; read the full change' if shown is None else
                  f'\nrange-diff since the last covered series:\n{shown or "(no changes since prior coverage)"}')
    comment(args.id, f'board cr request-review: {args.reason}' if args.reason else 'board cr request-review')
    print(f'requested agent review of {args.id}{detail}')
    return 0


def reserve_planner_return(board: Board, cr: dict, ruling_id: str, actor: str) -> None:
    """Reserve an unclaimed review before returning it for a ruling."""
    if cr['status'] != 'in_review' or cr.get('assignee'):
        raise BoardError(f"{cr['id']}: --ruling requires an unclaimed change request in review")
    entry = own_entry(board, actor)
    if not entry or 'plan' not in session_kinds(entry):
        raise BoardError('--ruling requires a registered session pulling plan')
    ruling = board.by_id.get(ruling_id) or {}
    if ruling.get('issue_type') != 'decision' or ruling.get('status') != 'in_force' or ruling.get('assignee') != actor:
        raise BoardError(f'{ruling_id}: --ruling requires an in-force ruling you hold')
    if refusal := foreign_claim(board, cr['id']):
        raise BoardError(refusal)
    if not any(ruling_id in board.blockers.get(item['id'], ()) for item in board.cr_items(cr['id'])):
        raise BoardError(f'{ruling_id}: it does not hold any open item of {cr["id"]}; make the affected items wait on it first (agents board wait <item> --on {ruling_id})')
    move(cr, 'claim', board=board, actor=actor)


def finding_title(text: str) -> str:
    """An item's title from a finding: its first line, cut at a word within 80 characters."""
    line = text.strip().splitlines()[0]
    return line if len(line) <= 80 else line[:80].rsplit(' ', 1)[0].rstrip(',;:') + ' ...'


def return_item(board: Board, args) -> None:
    actor = derived_actor() or 'user'
    cr = cr_arg(board, args.id, 'return')
    findings = [f'{args.ruling}: {text}' if args.ruling else text for text in args.findings]
    for text in findings:
        refuse_long_comment(f'board return: {text}')
    if args.ruling:
        reserve_planner_return(board, cr, args.ruling, caller())
    elif cr['status'] not in ('in_review', PASSED):
        raise BoardError(f"{args.id}: {cr['status']}; only a change request in review or waiting for its Accept is returned (unclaim frees work in hand)")
    elif cr['status'] == PASSED:
        if why := table_refusal(board, cr, 'return'):
            raise BoardError(f'{why}; the lead returns it with the findings you gave')
        if cr.get('assignee') and not holds_cr(cr, actor):
            raise BoardError(f"{args.id}: held by {cr['assignee']} (a refresh); return it once that is released", next=[{'action': 'wait'}])
    elif not holds_cr(cr, actor):
        raise BoardError(f"{args.id}: {cr['status']}, held by {cr.get('assignee') or 'nobody'}; claim it first",
                         next=[{'action': 'wait'} if cr.get('assignee') else {'action': 'claim', 'command': f'agents board claim {args.id}'}])
    try:
        review = review_read(board, cr)
        if review:  # a review with edits must record them before Return
            refuse_unrecorded(args.id, review, f'{edits_line(args.id, review["opened"])} --no-gate "returned" records them, then return')
        clear = [key for key in ('since', 'reviewing_tip', 'no_agent_review_reason', *([OPENED] if review else []))
                 if key in meta(cr)]  # the covered review pair stays (change-requests.md Review coverage)
        # Before the move: a stop leaves open items on a CR still in review, never a returned CR without them; the retry of a stopped
        # Return finds the items it made (the whole finding in the description) instead of filing them twice: an item that only
        # shares a title is another finding.
        filed = {item.get('description'): item['id'] for item in board.cr_items(args.id)}
        made = []
        for text in findings:
            description = f'Finding on {args.id} (returned by {actor}): {text}'
            if description not in filed:
                filed[description] = create_item(board, finding_title(text), 'task', parent=args.id, description=description)
            made.append(filed[description])
        move(cr, 'return --ruling' if args.ruling else 'return', board=board, fields=dict.fromkeys(clear))
    except BoardError as error:
        if args.ruling:
            released = move(cr, 'unclaim', board=board, check=False) if cr['status'] == 'in_review' else None
            if released is not None and released.returncode not in (0, 13):
                raise BoardError(f'{error}; releasing the temporary return hold failed: {bd_message(released)}') from error
        raise
    comment(args.id, f"board return: findings as items: {', '.join(made)}")
    print(f"returned {args.id} to the queue (worktree and branch kept); open items: {', '.join(made)}")


def land(board: Board, args) -> int:
    caller_actor = derived_actor() or 'user'
    cr = cr_arg(board, args.id, 'land')
    if not may_attend(board):
        raise BoardError('only a lead or solo session, or a person, lands a change request (the Accept)')
    m = meta(cr)
    if cr['status'] != PASSED:
        raise BoardError(f"{args.id}: {cr['status']}; only a change request waiting for its Accept lands")
    if cr.get('assignee') and not holds_cr(cr, derived_actor() or ''):
        raise BoardError(f"{args.id}: held by {cr['assignee']}: land it once that session releases it", next=[{'action': 'wait'}])
    main = main_root()
    stacked, _ = cr_base(board, cr, main)
    if board.is_cr(stacked):
        raise BoardError(f'{args.id}: stacked on {stacked}, which has not landed: agents board cr land {stacked} first',
                         next=[{'action': 'land', 'text': f'land {stacked} first (its own Accept), then {args.id}'}])
    if not args.tip or not args.base:
        now = cr_info(board, cr)
        raise BoardError(f'{args.id}: --tip <sha> and --base <sha> are required: pass the pair shown at Accept',
                         next=[{'action': 'ask-user', 'text': f"ask the user to Accept the current pair, then agents board cr land {args.id} "
                                                               f"--tip {now.get('tip') or '<tip>'} --base {now.get('baseTip') or '<base>'}"}])
    incoming_base = incoming_base_of(cr)
    try:
        branch_tip, branch_base = prepare_land(board, cr, main, args.tip, args.base)
        notes = land_core(board, cr, main, branch_tip, branch_base)
    except LandedError:
        raise
    except BoardError as error:
        board._cr.pop(args.id, None)
        if isinstance(error, PairMoved) and error.part == 'base':  # the commits the user Accepts next
            print(incoming_main_section(main, cr, cr_info(board, cr), incoming_base)[1])
        raise
    if reason := m.get('no_agent_review_reason'):
        comment(args.id, f'board user review: {caller_actor} accepted {branch_tip[:12]} ({reason})')
    else:
        comment(args.id, f'board user accept: {caller_actor} accepted tip {branch_tip[:12]}')
    for note in notes:
        print(note)
    print(f"landed {args.id} on {board_setting(board, 'target')}")
    return 0


def prepare_land(board: Board, cr: dict, main: Path, tip: str, base: str) -> tuple[str, str]:
    cid = cr['id']
    info = cr_info(board, cr)
    branch_tip, branch_base = info['tip'], info['baseTip']
    seen_tip, seen_base = rev(main, tip), rev(main, base)
    if branch_tip is None or branch_base is None:
        raise BoardError(f'{cid}: no branch or base is available')
    if seen_tip is None or seen_base is None:
        raise BoardError(f'{cid}: --tip and --base must name reachable commits')
    if seen_tip != branch_tip:
        raise pair_moved_refusal(cid, 'branch', seen_tip, branch_tip, branch_base)
    if seen_base != branch_base:
        raise pair_moved_refusal(cid, 'base', seen_base, branch_tip, branch_base)
    put_meta(cr, user_seen_tip=seen_tip, user_seen_base_tip=seen_base)
    review = review_read(board, cr)
    if review:
        refuse_unrecorded(cid, review, f'{edits_line(cid, review["opened"])} records them, then land')
    if refusal := open_item_refusal(board, cr):
        raise BoardError(refusal)
    if review:
        end_review(board, cr)
    result = None
    if info['state'] != 'current':
        wt = cr_worktree(main, cid)
        if not wt.is_dir():
            raise BoardError(f'{cid}: no worktree {wt}: git worktree add {wt} {cr_branch(cid)}',
                             next=[{'action': 'worktree', 'command': f'git worktree add {wt} {cr_branch(cid)}'}])
        result = sync_branch(board, cr, main, wt)
        info = cr_info(board, cr)
        branch_tip, branch_base = info['tip'], info['baseTip']
        if result['oldTip'] != seen_tip or result['tip'] != branch_tip:
            raise pair_moved_refusal(cid, 'branch', None, branch_tip, branch_base)
        if branch_base != seen_base or result['baseTip'] != seen_base:
            raise pair_moved_refusal(cid, 'base', None, branch_tip, branch_base)
        # The no-agent route covers the series the user saw, not a conflict resolution made after it.
        if meta(cr).get('no_agent_review_reason') and branch_tip != seen_tip and not replays(
                main, cr, result['oldBase'], seen_tip, branch_base, branch_tip):
            raise BoardError(f'{cid}: the change differs from the series you saw. Review its delta and Accept the current pair.',
                             next=[{'action': 'ask-user', 'text': f'ask the user to review the delta and Accept the current change, '
                                                                   f'then agents board cr land {cid} --tip {branch_tip} --base {branch_base}'}])
    if result and result['code']:
        sent = route_uncovered(board, cr, info)
        if sent:
            print(f'{cid}: the series changed since its last review; sent to agent review')
        # land ran it on this pair, so a rerun cannot pass: the author fixes it (sent: its reviewer finds it and returns it)
        raise BoardError(f"{cid}: not landed, its check failed after rebase:\n{result['output']}",
                         next=[{'action': 'wait'} if sent else {'action': 'return', 'command': f'agents board return {cid} "<the failing check>"'}])
    return branch_tip, branch_base


def reject(board: Board, args) -> int:
    actor = derived_actor() or 'user'
    cr = cr_arg(board, args.id, 'reject')
    if why := table_refusal(board, cr, 'cr reject'):
        raise BoardError(why)
    refuse_long_comment(f'board cr reject: {args.reason}')
    if open_items := board.cr_items(args.id):
        ids = ' '.join(item['id'] for item in open_items)
        raise BoardError(f'{args.id}: items still open: {ids}; no open item stays under a closed change request: '
                         f'agents board close {ids} --outcome dropped --reason "<why>", or agents board move {ids} --to <change request>')
    move(cr, 'cr reject', board=board, reason=f"rejected: {args.reason}"[:300].ljust(20, '.'), force=True)
    comment(args.id, f'board cr reject: {actor}: {args.reason}')
    target = board_setting(board, 'target')
    back = []
    for other in live_crs(board):
        if meta(other).get('base') == args.id:
            put_meta(other, base=target, **{PLAN_FIRST: args.reason[:200]}, since=None)
            move(other, 'base rejected', board=board)
            comment(other['id'], f"board cr reject: {args.id}, which this stacked on, was rejected ({args.reason}); back to planning with the base reset to the target.")
            back.append(other['id'])
    print(f"rejected {args.id}" + (f"; back to planning: {', '.join(back)}" if back else '')
          + f"; branch {cr_branch(args.id)} and its worktree stay until you confirm deleting them")
    return 0


def replays(wt: Path, cr: dict, old_base: str, old_tip: str, base: str, tip: str) -> bool:
    """Each commit of old_base..old_tip has a clean replay in base..tip in order. Review coverage can also allow recorded user edits."""
    old_result = git(wt, 'rev-list', '--reverse', f'{old_base}..{old_tip}', check=False)
    current_result = git(wt, 'rev-list', '--reverse', f'{base}..{tip}', check=False)
    if old_result.returncode != 0 or current_result.returncode != 0:
        return False
    old = old_result.stdout.decode('utf-8', 'replace').split()
    current = current_result.stdout.decode('utf-8', 'replace').split()
    edits = edit_commits(wt, cr, base, tip)
    at = 0
    for commit, is_edit in zip(current, edits):
        if at < len(old) and is_replay(wt, old[at], commit):
            at += 1
        elif not is_edit:
            return False
    return at == len(old)


def show_rebase_evidence(wt: Path, cr: dict, from_base: str, to_base: str, to_tip: str) -> None:
    """Show the CR range and incoming commits with files."""
    if rev(wt, to_base) and rev(wt, to_tip):
        request_files = git_text(wt, 'diff', '--name-status', '--no-renames', to_base, to_tip).splitlines()
        print(f'CR files ({to_base[:12]}..{to_tip[:12]}):' + ('\n  ' + '\n  '.join(request_files) if request_files else ' none'))
    else:
        print('CR files: unavailable because the current pair cannot be resolved')
    incoming = incoming_cr_commits(wt, cr, from_base, to_base, to_tip)
    print(incoming_main_text(incoming, from_base, to_base))


def refresh(board: Board, args) -> int:
    actor = caller()
    cr = cr_arg(board, args.id, 'refresh')
    if cr.get('assignee') and not holds_cr(cr, actor):
        raise BoardError(f"{args.id}: held by {cr['assignee']}; refresh waits until that session releases it", next=[{'action': 'wait'}])
    if not (in_work(cr) or cr['status'] in ('in_review', PASSED)):
        raise BoardError(f"{args.id}: {cr['status']}, no worktree in use to refresh")
    main = main_root()
    wt = cr_worktree(main, args.id)
    if not wt.is_dir():
        raise BoardError(f'{args.id}: no worktree {wt}: git worktree add {wt} {cr_branch(args.id)}',
                         next=[{'action': 'worktree', 'command': f'git worktree add {wt} {cr_branch(args.id)}'}])
    refuse_open(args.id, cr, 'a refresh')
    merging_user_edit = stopped_edit_commit(cr, wt) is not None
    result = checked_sync(board, cr, main, wt, args)
    print(f"refreshed {args.id}: tip {result['tip'][:12]} on base {result['baseTip'][:12]}; {check_said(args, not result['code'])}" + (f" (exit {result['code']})" if result['code'] else ''))
    if result['code']:
        print(result['output'])
    old_tip, old_base = result['oldTip'], result['oldBase']
    m = meta(cr)
    from_tip, from_base = m.get('review_tip') or old_tip, m.get('review_base_tip') or old_base
    changed = result['tip'] != from_tip or result['baseTip'] != from_base
    if changed:
        ranges = git(wt, 'range-diff', f'{from_base}..{from_tip}', f"{result['baseTip']}..{result['tip']}", check=False)
        if not ranges.returncode:
            print(f"range-diff covered..current:\n{ranges.stdout.decode('utf-8', 'replace').rstrip() or '(no changes)'}")
        show_rebase_evidence(wt, cr, from_base, result['baseTip'], result['tip'])
    if not merging_user_edit and route_uncovered(board, cr, cr_info(board, cr)):
        print(f'{args.id}: the series changed since its last review; sent to agent review')
    elif not result['code']:
        try:
            landed = land_look_after(board, cr, main)
        except LandedError as error:
            print(f'{args.id}: refreshed and landed, but: {error}')
        except BoardError as error:  # the refresh stands; the Accept queue holds the CR until the landing can run
            print(f'{args.id}: refreshed, not landed: {error}; it stays in the Accept queue')
        else:
            if landed:
                print(f'{args.id}: look after, its check is current and its review covers it: ' + '; '.join(landed))
    return 0


def land_look_after(board: Board, cr: dict, main: Path) -> list[str] | None:
    """The landing a refresh finishes: a passed `look` `after` CR that waits for no base, whose check is current and review covers its
    tip, lands without the user (the model's Refresh rule). None when it is not that CR."""
    info = cr_info(board, cr)
    if cr['status'] != PASSED or cr_look(board, cr) != 'after' or after_base(board, cr) or info['state'] != 'current' or not review_current(cr, info):
        return None
    return land_core(board, cr, main, info['tip'], info['baseTip'])


def review_edits_tree(main: Path, wt: Path, tip: str) -> str:
    """The tree object holding the worktree's files: tracked and new (not ignored) as they are on disk, staged or not. Built in a
    throwaway index, so the worktree's own index and files are never touched."""
    if not linked_worktree(wt):
        raise BoardError(f'{wt} is not a git worktree')
    common = lambda root: Path(git_text(root, 'rev-parse', '--path-format=absolute', '--git-common-dir').strip()).resolve()
    if common(wt) != common(main):
        raise BoardError(f'{wt} is a worktree of another repository')
    with tempfile.TemporaryDirectory() as scratch:
        env = {'GIT_INDEX_FILE': str(Path(scratch) / 'index')}
        git(wt, 'read-tree', tip, env=env)
        git(wt, 'add', '-A', env=env)
        return git_text(wt, 'write-tree', env=env).strip()


def workspace_or_folder(wt: Path) -> Path:
    """What to open for a worktree: its single root `*.code-workspace` file, else the folder."""
    found = sorted(wt.glob('*.code-workspace'))
    return found[0] if len(found) == 1 else wt


def holder_decides(board: Board, holder: str) -> bool:
    """The holder is a deciding session (lead or solo), which takes a request for its Accept and walks the user through it."""
    try:
        entry = board.registry().get(session_actor(holder))
    except BoardError:
        return False
    return bool(entry and entry.get('role') in ATTENDED_ROLES)


def board_remote(main: Path, make: bool = False) -> bool:
    """The repository has the board's remote. With `make`, the board creates it (or repairs what it owns): url the main checkout,
    push address disabled, fetch every local branch into `refs/remotes/board/*`. A remote of that name that is not the board's is
    refused, never overwritten."""
    url = git(main, 'config', '--get', f'remote.{BOARD_REMOTE}.url', check=False).stdout.decode().strip()
    pushurl = git(main, 'config', '--get', f'remote.{BOARD_REMOTE}.pushurl', check=False).stdout.decode().strip()
    ours = bool(url) and (pushurl == NO_PUSH or Path(url).resolve() == main.resolve())  # the disabled push address is the board's mark: a moved checkout keeps it
    if url and not ours:
        if make:
            raise BoardError(f'the remote {BOARD_REMOTE} exists already and is not the board\'s ({url}): rename it (git remote rename {BOARD_REMOTE} <name>), then open again')
        return False
    if not make:
        return ours
    if not url:
        git(main, 'remote', 'add', BOARD_REMOTE, str(main))
    elif Path(url).resolve() != main.resolve():
        git(main, 'config', f'remote.{BOARD_REMOTE}.url', str(main))
    git(main, 'config', f'remote.{BOARD_REMOTE}.pushurl', NO_PUSH)
    git(main, 'config', '--replace-all', f'remote.{BOARD_REMOTE}.fetch', f'+refs/heads/*:refs/remotes/{BOARD_REMOTE}/*')
    git(main, 'config', f'remote.{BOARD_REMOTE}.tagopt', '--no-tags')
    return True


def fetch_board(main: Path) -> str | None:
    """Fetches the board's remote (VS Code does not on its own) so a review folder shows the base's moves as Incoming; pruned, so landed
    branches go. Where the board made none, nothing. The reason when the fetch failed: the view is then stale, nothing else is."""
    if not board_remote(main):
        return None
    done = git(main, 'fetch', '--quiet', '--prune', BOARD_REMOTE, check=False)
    return None if done.returncode == 0 else (done.stderr.decode('utf-8', 'replace').strip() or f'exit {done.returncode}')


def set_upstream(main: Path, branch: str, base: str) -> None:
    """Points `branch` at `board/<base>`: VS Code then shows its commits as Outgoing Changes and offers no push (the remote's push address
    is disabled). Config, not `branch --set-upstream-to`: it needs no fetch first."""
    git(main, 'config', f'branch.{branch}.remote', BOARD_REMOTE)
    git(main, 'config', f'branch.{branch}.merge', f'refs/heads/{base}')
    # A plain `git pull` (VS Code's Pull) must not rewrite reviewed commits, whatever the user's global pull.rebase says: it fast-forwards or fails.
    git(main, 'config', f'branch.{branch}.rebase', 'false')
    git(main, 'config', f'branch.{branch}.mergeOptions', '--ff-only')


def drop_upstream(main: Path, branch: str) -> None:
    """Removes the config section of a branch the board deleted (a deleted ref leaves it behind)."""
    git(main, 'config', '--remove-section', f'branch.{branch}', check=False)


def review_open(board: Board, args) -> int:
    """`board review open <item>`: the user reviews the item in its own worktree, on its own branch (accept.md User review).
    Records the tip it opens at, points the branch at the board's remote and prints the folder to open. Opening an item that is already
    open changes nothing it holds: its opened tip, edits and commits stay the user's."""
    if not may_attend(board):
        raise BoardError('only a lead or solo session, or a person, opens the review')
    item = require_open(board, [args.id])[0]
    if not board.is_cr(item['id']):
        raise BoardError(f"{args.id}: agents board review open works on a change request")
    main = main_root()
    wt, branch, already = cr_worktree(main, args.id), cr_branch(args.id), opened_tip(item)
    found = review_range(board, item)
    if found is None:
        raise BoardError(f'{args.id}: no range to show (a change request without its branch)')
    tip = already or found[0]
    if item['status'] != PASSED:
        raise BoardError(f"{args.id}: {item['status']}: its worktree is the agent's (in work, review or returned); the review shows a change request waiting for its Accept")
    if item.get('assignee') and not holder_decides(board, item['assignee']):
        raise BoardError(f"{args.id}: held by {item['assignee']}, an agent session at work in its worktree (a refresh): open it once that session releases it")
    if found[1] is None or rev(main, f'refs/heads/{branch}') is None:
        raise BoardError(f'{args.id}: its branch or base is gone')
    base = cr_base(board, item, main)[0]
    upstream = cr_branch(base) if board.is_cr(base) else base
    if not wt.exists() and not already:
        raise BoardError(f'{args.id}: no worktree {wt}: git worktree add {wt} {branch}')
    if wt.exists() and not linked_worktree(wt):
        raise BoardError(f'{args.id}: {wt} exists but is no git worktree of its own (a plain folder would make git act on the main checkout): remove it or git worktree add it, then open again')
    if wt.exists():
        state = in_progress_state(wt)
        if state:
            raise BoardError(f'{args.id}: a {state} is in progress in {wt}: its owner finishes or aborts it first')
        if git_text(wt, 'rev-parse', '--abbrev-ref', 'HEAD').strip() != branch:
            raise BoardError(f'{args.id}: {wt} is not on {branch}: check it out (or fix it), then open again')
        problem = None if already else tree_problem(wt)  # an open review's uncommitted changes are the user's edits
        if problem:
            raise BoardError(f'{args.id}: {problem}')
    board_remote(main, make=True)
    if not wt.exists():  # a worktree that went missing from an open review
        exclude_worktrees(main)
        if rev(main, f'refs/heads/{branch}'):
            git(main, 'worktree', 'add', str(wt), branch)
        else:
            git(main, 'worktree', 'add', '-b', branch, str(wt), tip)
    set_upstream(main, branch, upstream)
    if not already:
        put_meta(item, **{OPENED: tip, 'user_seen_tip': tip, 'user_seen_base_tip': meta(item).get('base_sha') or found[1]})
    stale = fetch_board(main)
    print(workspace_or_folder(wt))
    print(f'{args.id}: open for your review in {wt} on {branch} (upstream {BOARD_REMOTE}/{upstream}); your edits are commits after {tip[:12]} or uncommitted changes'
          + (f'; the fetch of {BOARD_REMOTE} failed ({stale}): its Incoming is stale' if stale else ''), file=sys.stderr)
    return 0


def user_identity(main: Path) -> dict[str, str]:
    """Author environment of the user's commit: git's user.name and user.email of the repository."""
    who = {key: git(main, 'config', key, check=False).stdout.decode().strip() for key in ('user.name', 'user.email')}
    if not all(who.values()):
        raise BoardError('git user.name and user.email are not set: the review edits are committed as yours')
    return {'GIT_AUTHOR_NAME': who['user.name'], 'GIT_AUTHOR_EMAIL': who['user.email']}


def edits_commit(main: Path, tip: str, edits: str, message: str) -> str:
    """The commit of the edits' exact tree on `tip`: author the user, committer the session, no trailer; the board records it."""
    actor = derived_actor()
    author = user_identity(main)
    committer = {'GIT_COMMITTER_NAME': actor, 'GIT_COMMITTER_EMAIL': f'{actor}@board.invalid'} if actor else \
        {'GIT_COMMITTER_NAME': author['GIT_AUTHOR_NAME'], 'GIT_COMMITTER_EMAIL': author['GIT_AUTHOR_EMAIL']}
    return git_text(main, 'commit-tree', edits, '-p', tip, '-m', message.rstrip() + '\n', env={**author, **committer}).strip()


def edits_target(board: Board, args) -> dict:
    """The change request waiting for its Accept whose review edits are taken."""
    issue = require_open(board, [args.id])[0]
    if not board.is_cr(args.id) or issue['status'] != PASSED:
        raise BoardError(f"{args.id}: {issue['status']}; agents board cr edits works on a change request waiting for its Accept")
    return issue


def record_edits(cr: dict, commits: list[str]) -> None:
    """Appends the commits to the CR's `review_edits` (those not recorded yet), so they keep the review (`edits_only`)."""
    known = edit_entries(cr)
    put_meta(cr, review_edits=json.dumps([*known, *({'commit': c} for c in commits if c not in {one['commit'] for one in known})]))


def store_gate(cr: dict, tip: str, base_tip: str, gate: str | None, reason: str | None, passed: bool, output: str) -> None:
    """The check of an edit commit, stored as what it was: a targeted run (command, output) or no check (the reason). Never a full pass."""
    put_meta(cr, check_tip=tip, check_base_tip=base_tip, check_result='pass' if passed else 'fail', check_at=stamp(),
             check_output=tail(output) or None, check_kind='targeted' if gate else 'none', check_command=gate, check_reason=reason,
             check_new=None, check_base_count=None, check_tip_count=None)


def gate_options(sub, nonempty, when: str = '') -> None:
    """The one gate option of every verb that records a check (r11-q38): handover, cr refresh, cr edits."""
    group = sub.add_mutually_exclusive_group()
    group.add_argument('--checks', action='store_true', help=f"{when}the project's setup and checks (no new failures against the base), stored as a full check; the default")
    group.add_argument('--gate', metavar='CMD', type=nonempty, help=f'{when}run this command in the worktree on the rebased tip, stored as a targeted check for that tip only')
    group.add_argument('--no-gate', metavar='REASON', type=nonempty, help=f'{when}store "no check" with this reason for the rebased tip (a Markdown edit)')


def checked_sync(board: Board, cr: dict, main: Path, wt: Path, args, reuse: bool = False) -> dict:
    """`sync_branch` under the verb's gate option: the full checks, or the targeted command or no check stored for the rebased tip
    (never a full pass, r15-q78). `code` and `output` are the gate's."""
    gated = bool(args.gate or args.no_gate)
    result = sync_branch(board, cr, main, wt, check=not gated, reuse=reuse)
    if not gated:
        return result
    passed, output = True, ''
    if args.gate:
        code, output = run_shell_full(wt, args.gate)
        passed = code == 0
    if rev(wt, 'HEAD') != result['tip'] or tree_problem(wt):
        raise BoardError(f"{cr['id']}: the gate changed the worktree ({tree_problem(wt) or 'HEAD moved'}); nothing was recorded")
    store_gate(cr, result['tip'], result['baseTip'], args.gate, args.no_gate, passed, output)
    board._cr.pop(cr['id'], None)
    return {**result, 'code': 0 if passed else code, 'output': '' if passed else f'{args.gate}:\n{tail(output)}'}


def check_said(args, passed: bool = True) -> str:
    """The stored check as printed: a targeted or no-gate check never reads as a pass (r15-q78)."""
    if args.no_gate:
        return f'no check: {args.no_gate}'
    if args.gate:
        return f"targeted check {'passed' if passed else 'failed'}: {args.gate}"
    return f"check {'pass' if passed else 'fail'}"


def cr_edits(board: Board, args) -> int:
    """`board cr edits`: prints or commits the edits of the item's review (a change request's): the user's commits after
    the opened tip, and with --commit also their uncommitted changes as one more commit, all recorded as theirs and the review ended; with
    no edits --commit only ends the review (the Accept or Return of an unedited one). `--tip` is the opened tip. `--merged` records a
    merge the user confirmed."""
    if (args.gate or args.no_gate or args.checks) and not args.commit:
        raise BoardError('--gate, --no-gate and --checks go with --commit')
    main = main_root()
    if args.merged:
        return record_merged(board, args, main)
    if not args.tip:
        raise BoardError('--tip <sha> is required: the tip the review was opened at')
    issue = edits_target(board, args)
    wt, expect = cr_worktree(main, args.id), rev(main, args.tip)
    if expect is None:
        raise BoardError(f'{args.tip} is not a commit here')
    review = review_read(board, issue)
    if review is None:
        raise BoardError(f'{args.id}: is not open for your review: agents board review open {args.id} first')
    opened = review['opened']
    if opened != expect:
        raise BoardError(f'{args.id}: your review was opened at {opened[:12]}, not {expect[:12]}')
    if review['edited'] is None:
        raise BoardError(f"{args.id}: your review cannot be read: {review['why']}")
    branch = cr_branch(args.id)
    if not args.commit:
        if not review['edited']:
            print(f'no edits in {wt} against {opened[:12]}')
            return 0
        tree = review_edits_tree(main, wt, review['tip'])
        shown = git_text(main, 'diff', '--binary', '--no-color', opened, tree)
        names = git_text(main, 'diff', '--name-status', opened, tree).splitlines()
        print(f'edits in {wt} against {opened[:12]} ({len(review["commits"])} commits, {len(names)} files):' + ''.join(f'\n  {row}' for row in names) + f'\n\n{shown}', end='')
        return 0
    if not may_attend(board):
        raise BoardError('only a lead or solo session, or a person, commits the review edits')
    if issue.get('assignee') and not holds_cr(issue, derived_actor() or ''):
        raise BoardError(f"{args.id}: held by {issue['assignee']}: commit the edits once that session releases it")
    if not review['edited']:
        end_review(board, issue)
        print(f'ended your review of {args.id}: no edits; {branch} stays at {opened[:12]}' + ('; no check stored for it' if args.gate or args.no_gate or args.checks else ''))
        return 0
    if review['dirty'] and not args.message:
        raise BoardError('--commit needs -m <message> when the review holds uncommitted changes')
    commit = edits_commit(main, review['tip'], review_edits_tree(main, wt, review['tip']), args.message) if review['dirty'] else None
    cr, new_tip = issue, commit or review['tip']
    before = edit_entries(cr)
    recorded = [*review['commits'], *([commit] if commit else [])]
    record_edits(cr, recorded)  # first: a commit on the branch is the user's only while recorded, so no crash leaves it unrecorded
    if commit and git(main, 'update-ref', f'refs/heads/{branch}', commit, review['tip'], check=False).returncode != 0:
        put_meta(cr, review_edits=json.dumps(before) if before else None)
        raise BoardError(f'{args.id}: {branch} moved meanwhile; nothing committed')
    try:
        if commit:
            git(wt, 'reset', '-q', commit)  # the branch already is there: the index follows, the files are its tree
        end_review(board, cr)  # before anything that can stop (a conflicting rebase): refresh must be allowed once the edits are the user's
    except BoardError as error:
        raise BoardError(f'{args.id}: the edits are recorded ({len(recorded)} commits, tip {new_tip[:12]} on {branch}), but {error}; run this command again') from None
    print(f'recorded your {len(recorded)} commits on {branch} as yours' + (f', the last one made from your uncommitted changes (author {git(main, "log", "-1", "--format=%an", commit).stdout.decode().strip()})' if commit else '')
          + '; your review ended')
    comment(args.id, f'board cr edits: the review edits of {wt}@{opened[:12]} recorded as yours ({", ".join(c[:12] for c in recorded)}).')
    result = checked_sync(board, cr, main, wt, args)  # rebased onto the base, then the chosen gate (r11-q38)
    board._cr.pop(args.id, None)
    routed = route_uncovered(board, cr, cr_info(board, cr))
    if routed:
        print(f'{args.id}: the series changed since its last review; sent to agent review')
    if result['code']:
        print(f"{check_said(args, False)} (exit {result['code']}):\n{result['output']}")
        if not routed:
            rebased = f"; the branch was rebased to {result['tip'][:12]}: agents board review open {args.id} shows it again" if result['tip'] != new_tip else ''
            print(f"nothing lands; the edit commits stay on {branch} and {args.id} waits for the user: fix it{rebased}, or agents board return {args.id} \"<findings>\" sends it to a worker")
        return 1
    if routed:
        return 0
    stored = 'full check passed' if not (args.gate or args.no_gate) else f'{check_said(args)} (this tip only, never a full check)'
    print(f"stored: {stored} for {result['tip'][:12]}; land with agents board cr land {args.id} --tip {result['tip']} --base {result['baseTip']}")
    return 0


def author_stamp(main: Path, commit: str) -> str:
    """Author name, email and time of a commit: what a rebase or a merge keeps of a commit it replays."""
    return git(main, 'log', '-1', '--format=%an|%ae|%at', commit, check=False).stdout.decode().strip()


def record_merged(board: Board, args, main: Path) -> int:
    """`board cr edits <cr> --merged <commit>`: the user confirmed the deciding session's merge of a conflict on their edit commit
    (change-requests.md Rebase), so the merged commit counts as their edit (`review_edits`) like the commit it came from; without
    this it is an agent change. The commit must be on the CR's branch past its fork point and carry the author and time of a recorded
    edit commit, which a rebase and a conflict merge keep."""
    if args.tip or args.commit or args.gate or args.no_gate or args.checks or args.message:
        raise BoardError('--merged goes alone: agents board cr edits <cr> --merged <commit>')
    if not may_attend(board):
        raise BoardError('only a lead or solo session, or a person, records the user\'s confirmed merge')
    cr = cr_arg(board, args.id, 'cr edits')
    if cr['status'] != PASSED:
        raise BoardError(f"{args.id}: {cr['status']}; --merged works on a change request waiting for its Accept")
    if cr.get('assignee') and not holds_cr(cr, derived_actor() or ''):
        raise BoardError(f"{args.id}: held by {cr['assignee']}: record the merge once that session releases it")
    commit, tip, fork = rev(main, args.merged), rev(main, f'refs/heads/{cr_branch(args.id)}'), meta(cr).get('base_sha')
    if commit is None or tip is None or not fork or commit not in git_text(main, 'rev-list', f'{fork}..{tip}').split():
        raise BoardError(f'{args.id}: {args.merged} is not a commit of {cr_branch(args.id)} past its fork point (a stopped rebase: resolve it and agents board cr refresh {args.id} first)')
    entries = [one['commit'] for one in edit_entries(cr)]
    if commit in entries or any(is_replay(main, one, commit) for one in entries):
        print(f'{args.id}: {commit[:12]} already counts as the user\'s edit; nothing to record')
        return 0
    stamp_of = author_stamp(main, commit)
    at = next((n for n, one in enumerate(entries) if rev(main, one) and author_stamp(main, one) == stamp_of), None)
    if at is None:
        raise BoardError(f'{args.id}: {commit[:12]} is not the merge of a recorded edit commit (none has its author and time): only a conflict on the user\'s edit commit is recorded this way')
    put_meta(cr, review_edits=json.dumps([{'commit': commit if n == at else one} for n, one in enumerate(entries)]))  # in place of the pre-rebase commit, which no branch holds now
    comment(args.id, f'board cr edits: the merge {commit[:12]} of a conflict on the user\'s edit {entries[at][:12]}, confirmed by the user, recorded as their edit in its place.')
    board._cr.pop(args.id, None)
    print(f'recorded {commit[:12]} as the user\'s edit on {args.id}; Accept the current row pair with agents board cr land {args.id} --tip <tip> --base <base> once its check is current')
    return 0


def type_refusal(types: list[str]) -> str | None:
    """A creation with a type outside ITEM_TYPES (r9-q42): `board create` and the nodes of `create --graph`."""
    if 'gate' in types:
        return 'a gate is a step only a person takes: agents board gate create --blocks <id> --reason "<why>" makes the human gate that holds an item up'
    bad = sorted({kind for kind in types if kind not in ITEM_TYPES})
    return (f"type {', '.join(bad)} is not a board type ({', '.join(ITEM_TYPES)}; board-core.md Kinds); "
            'a bug, feature, design or cleanup is a task labelled kind:<kind>, a question is --type decision') if bad else None


def default_look_refusal(given: list[tuple[str, str]]) -> str | None:
    """A change request's own `look` or `view` equal to the project default (r10-q52): metadata overrides the default, so a copy
    would hide a later switch. Checks the metadata of the plan's nodes; the default is read only when one is given, and an unreadable
    default lets bd answer."""
    for key, value in [pair for pair in given if pair[0] in ('look', 'view')]:
        try:
            default = current_setting(SETTINGS[key])
        except BoardError:
            return None
        if value == default:
            return (f'{key} {value} is the project default: set a change request\'s {key} only to override it '
                    f'(agents board setup --{key} changes the default; plan.md and change-requests.md)')
    return None


def path_only_edit(old: str, new: str) -> bool:
    """True when new is old with paths replaced: the same tokens and whitespace, each changed token a path (a `/` in both)."""
    before, after = re.findall(r'\s+|\S+', old), re.findall(r'\s+|\S+', new)
    return len(before) == len(after) and all(a == b or ('/' in a and '/' in b and not a.isspace()) for a, b in zip(before, after))


def size_refusal(issue: dict, texts: dict[str, str], update: bool = True) -> str | None:
    """Why a write of long fields is refused: a work item's description, design, acceptance_criteria or notes stays within FIELD_LIMIT
    characters, so items hold current state and not history. An edit that shrinks an over-limit field or only replaces paths in it
    (a move of the files it names) passes. Decisions and other types are not work items: records are long by design.
    `issue` is the item (or {'id', 'issue_type'} of a new one); `texts` the new text per field."""
    if issue.get('issue_type') != WORK_TYPE:
        return None
    for field, text in texts.items():
        old = issue.get(field) or ''
        if len(text) > FIELD_LIMIT and len(text) >= len(old) and not path_only_edit(old, text):
            return (f"{issue['id']}: {field} is {len(text)} characters, over the {FIELD_LIMIT} limit. Rewrite it shorter as the current state: "
                    f"dated history leaves{' (the board keeps the old text)' if update else ''}; every rule, gate and criterion still in force stays. "
                    'Long material may go in a doc the item links, where that fits.')
    return None


def comment_refusal(size: int) -> str | None:
    """Why a comment a session writes is refused: a comment is a one-line event, so it stays within FIELD_LIMIT characters."""
    if size <= FIELD_LIMIT:
        return None
    return (f'comment is {size} characters, over the {FIELD_LIMIT} limit. '
            'Long material belongs in a doc the item links.')


def comment_command(args) -> int:
    """`board comment <id>... (-m <text> | -f <file>)`: the same comment on each item, within FIELD_LIMIT (the one-line event rule);
    `-f -` reads stdin. Items are independent: the exit code is non-zero when any was refused."""
    ids, text = list(dict.fromkeys(args.ids)), args.message
    if args.file is not None:
        text = read_text_arg(args.file)
    if not text.strip():
        raise BoardError('the comment is empty')
    refusal = None if args.packet else comment_refusal(len(text))
    if refusal:
        raise BoardError(refusal)
    failed = False
    for item_id in ids:
        result = bd('comments', 'add', item_id, '-f', '-', stdin=text)
        if result.returncode != 0:
            print(f'board: {item_id}: {bd_message(result)}', file=sys.stderr)
            failed = True
        else:
            print(f'{item_id}: commented')
    return 1 if failed else 0


def cr_close_refusal(ids: list[str]) -> str | None:
    """Why a close is refused: a change request closes by landing or rejecting (closed means landed)."""
    crs = [issue['id'] for issue in bd_show(ids, comments=False) if issue.get('issue_type') == CR_TYPE] if ids else []
    if crs:
        return (f"{', '.join(crs)} is a change request: agents board cr land <cr> closes it landed, "
                'agents board cr reject <cr> "<reason>" closes it unlanded')
    return None


def close_command(args) -> int:
    """`board close <id>... --reason "<why>" [--force]`: closes items; a change request closes by board cr land or reject. `--force` is
    bd's: it closes an item that is blocked or has open children."""
    ids = [board_id(item_id) for item_id in dict.fromkeys(args.ids)]
    reason = args.reason.strip()
    if len(reason) < CLOSE_REASON_MIN:
        raise BoardError(f'--reason is {len(reason)} characters: bd wants at least {CLOSE_REASON_MIN}; say why it closes')
    refusal = cr_close_refusal(ids)
    if refusal:
        raise BoardError(refusal)
    found = {issue['id']: issue for issue in bd_show(ids, comments=False)}
    if missing := [item_id for item_id in ids if item_id not in found]:
        raise BoardError(f"unknown {', '.join(missing)}")
    board = Board.load()  # an item closes by its change request's holder (item_write_refusal)
    together = frozenset(ids)
    # All or none: every id's whole close is checked before the first write, so no refusal leaves an earlier id closed (a dropped target under its waiter).
    refusals = []
    for item_id in ids:
        try:
            move(found[item_id], 'close', reason=reason, force=args.force, outcome=args.outcome, board=board, together=together, write=False)
        except BoardError as error:
            refusals.append(str(error))
    if refusals:
        raise BoardError('\n'.join(refusals) + ('\nnothing closed' if len(ids) > 1 else ''))
    for item_id in ids:
        move(found[item_id], 'close', reason=reason, force=args.force, outcome=args.outcome, board=board, together=together)
        print(f'{item_id}: closed')
    return 0


GLOBAL_VALUES = ('-C', '--directory', '--db', '--database', '--actor', '--dolt-auto-commit', '--mem-profile')
PASS_LINKS = (REVISES, 'relates-to', 'parent-child', 'supersedes')  # the stored link types that hold nothing up: the only ones the board writes besides a wait
BOARD_LABEL_PREFIXES = (QUEUE_PREFIX, FOR_PREFIX)  # labels the board routes on: they change through send, route and create --for
LABEL_PREFIXES = ('topic:', 'export:', 'provides:', KIND_LABEL, *BOARD_LABEL_PREFIXES)  # every label's form (board-core.md Statuses and labels)
RAW_RULE = 'raw bd writes only when no board command does it, or the user authorized it: agents board bd --raw --yes <args>'
READ_GUARD = 'items are read through agents board show <ids> [--section …] [--field …] [--comments] [--full] [--json]: one read path, whole items'
# The one map from a bd write word to the board command that does it; None: no board command does it (raw only). The refusal warning,
# pointer_for and every printed fix text use it (board_form, raw_form).
BOARD_FOR = {
    'create': 'agents board create', 'new': 'agents board create', 'q': 'agents board create', 'todo': 'agents board create (add), agents board close (done)', 'close': 'agents board close',
    'done': 'agents board close', 'comment': 'agents board comment', 'comments': 'agents board comment', 'note': 'agents board field (notes), agents board comment', 'claim': 'agents board claim',
    'unclaim': 'agents board unclaim', 'assign': 'agents board claim, agents board send, agents board route', 'priority': 'agents board update --priority', 'tag': 'agents board update --label',
    'label': 'agents board update --label / --unlabel', 'link': 'agents board link / agents board wait', 'reopen': 'agents board reopen', 'defer': 'agents board defer',
    'undefer': 'agents board undefer', 'gate': 'agents board gate create / resolve', 'dep': 'agents board wait / link / unlink',
    'block': 'agents board wait <item> --on <target> --for "<input>"', 'unblock': 'agents board unlink <item> <target>',
    'update': 'agents board update (title, priority, labels), agents board move (parent), agents board field (long fields), agents board claim',
    'sync': None, 'import': None, 'rename': None, 'remember': None, 'forget': None, 'supersede': None, 'duplicate': None, 'delete': None,
    'ship': None, 'batch': None,
}


def raw_form(args: str) -> str:
    """The command for a bd write no board command does, as a printed fix."""
    return f'agents board bd --raw --yes {args}'


def readonly_warning(command: str, rest: list[str]) -> str:
    """What follows bd's own refusal of a write: the board command that does it, where there is one, and the raw rule."""
    verb = BOARD_FOR.get(command)
    return (f'board: bd runs read-only here. {"Use " + verb + " for this. " if verb else "No board command does this. "}'
            + RAW_RULE[0].upper() + RAW_RULE[1:] + '.')


def passthrough(argv: list[str]) -> int:
    """`board bd <args>`: bd with `--readonly` (bd refuses what writes; it does not catch everything, e.g. import, rename, config set and
    dolt remote add pass on a server board). `--raw --yes` runs bd without it; `--raw` alone prints the rule and runs nothing."""
    raw = yes = False
    while argv[:1] in (['--raw'], ['--yes']):
        raw, yes = raw or argv[0] == '--raw', yes or argv[0] == '--yes'
        argv = argv[1:]
    if yes and not raw:
        print('board: --yes goes with --raw: agents board bd --raw --yes <args>', file=sys.stderr)
        return 2
    if raw and not yes:
        print(f'board: agents board bd --raw writes with no check of the board. {RAW_RULE[0].upper() + RAW_RULE[1:]}. '
              'Nothing ran; add --yes to run it.', file=sys.stderr)
        return 2
    if argv[:1] == ['dolt'] and argv[1:2] in (['start'], ['restart']):
        raise BoardError('board starts the server before every bd call; rerun the failing command with elevated sandbox permissions')
    at = 0
    while at < len(argv) and argv[at].startswith('-'):
        at += 2 if argv[at] in GLOBAL_VALUES else 1
    command, rest = (argv[at], argv[at + 1:]) if at < len(argv) else ('', [])
    flags = {arg.split('=', 1)[0] for arg in rest}
    if command == 'edit':
        print('board: bd edit opens an editor and blocks; edit a long field with agents board field export <id>, the file, agents board field apply <id>; '
              'a title with agents board update <id> --title', file=sys.stderr)
        return 2
    help_asked = bool({'-h', '--help'} & flags)
    if not help_asked and (command in ('show', 'view') or (command == 'comments' and rest[:1] != ['add'])):
        print(f'board: {READ_GUARD}', file=sys.stderr)
        return 2
    directory = next((argv[i + 1] for i, arg in enumerate(argv[:-1]) if arg in ('-C', '--directory')),
                     next((arg.split('=', 1)[1] for arg in argv if arg.startswith('--directory=')), None))
    if command not in BD_NO_DATABASE:
        ensure_server(Path(directory) if directory else None)
    argv = [*argv[:at], *([command] if command else []), *rest]
    return run_bd(argv if raw else ['--readonly', *argv], flags, command, rest, readonly=not raw)


def run_bd(argv: list[str], flags: set[str], command: str, rest: list[str], readonly: bool) -> int:
    """A child, not an exec: board still has to retry a write, start the wait and add its warning to a read-only refusal. A person's terminal
    and --watch keep the terminal, without the retry: bd may prompt, and capturing would hide it."""
    if sys.stdin.isatty() or flags & {'--watch', '-w'}:
        return subprocess.run(['bd', *argv], env=bd_env()).returncode
    reads_stdin = argv[:1] == ['batch'] or any(arg in ('-', '--stdin') or arg.endswith('=-') for arg in argv)
    result = bd(*argv, stdin=sys.stdin.read() if reads_stdin else None, server=command not in BD_NO_DATABASE)
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    if readonly and result.returncode != 0 and 'read-only' in result.stdout + result.stderr:
        print(readonly_warning(command, rest), file=sys.stderr)
    # A manual sync says as much about the remote as the wait's own.
    if shared is not None and (argv[:1] == ['sync'] or argv[:2] in (['dolt', 'pull'], ['dolt', 'push'])):
        if result.returncode == 0:
            shared.succeeded()
            shared.path('pulled').touch()
            shared.check_moved()
        elif result.returncode == 2:
            shared.failed('', 'conflict')
    return result.returncode


def queue_labels(labels: list[str]) -> list[str]:
    return [label for label in labels if label.startswith(QUEUE_PREFIX)]


def kind_refusal(labels: list[str]) -> str | None:
    """A `kind:` label outside KIND_LABELS: the one place the board reads the label, to keep its spelling."""
    bad = [label for label in labels if label.startswith(KIND_LABEL) and label[len(KIND_LABEL):] not in KIND_LABELS]
    return f"{', '.join(bad)}: a kind is one of {', '.join(KIND_LABEL + kind for kind in KIND_LABELS)}" if bad else None


def label_refusal(labels: list[str]) -> str | None:
    bad = [label for label in labels if label.startswith(BOARD_LABEL_PREFIXES)]
    return (f"{', '.join(bad)}: the board routes on {' and '.join(BOARD_LABEL_PREFIXES)} labels; a queue changes by agents board send <person> <id> or "
            'agents board route <person> <id> (lead), a find for another person is filed with agents board create --for <person>') if bad else None


def label_shape(label: str) -> str | None:
    """The one owner of a label's shape: the `check` class it falls in, None when it is well formed."""
    if label in LIFECYCLE_LABELS:
        return 'label-status'
    return None if label.startswith(LABEL_PREFIXES) else 'label-form'


def label_shape_refusal(labels: list[str]) -> str | None:
    """Labels `check` would report, refused where they are added (create --label and plan files, update --label); removing one stays open."""
    bad = [label for label in labels if label_shape(label)]
    return (f"{', '.join(bad)}: a label starts with {', '.join(LABEL_PREFIXES)}, and a status is never a label ({', '.join(LIFECYCLE_LABELS)}); "
            'a loose word is topic:<word>') if bad else None


def parent_move_refusal(board: Board, ids: list[str], target: str | None, *,
                        planned_crs: dict[str, str] | None = None, new: dict[str, str] | None = None) -> str | None:
    """Why this reparenting is refused. A change request keeps its place; a work item of one (it is that request's membership, and its
    hold, worktree and pass commit belong to the request) leaves it only while open and unheld; on a shared board the parent decides the
    queue of an item with none of its own, so only lead and solo sessions move it."""
    for item_id in ids:
        issue = board.by_id.get(item_id)
        if issue is None:
            continue
        if issue.get('issue_type') == CR_TYPE:
            if target is not None and board.by_id.get(target, {}).get('issue_type') == 'milestone':
                continue  # a change request is part of a milestone
            return f'{item_id} is a change request: it keeps its parent (a stacked request waits on its base: agents board cr refresh) and moves only into a milestone'
        for parent in board.parents.get(item_id, []):
            if parent != target and board.by_id.get(parent, {}).get('issue_type') == CR_TYPE and (issue['status'] != 'open' or issue.get('assignee')):
                return (f"{item_id} is {issue['status']}{' and held' if issue.get('assignee') else ''} in change request {parent}: its hold, worktree and "
                        'pass commit belong to it; finish or hand it back before moving it out')
    if shared is not None and derived_actor() and not may_attend():
        for item_id in ids:
            if item_id in board.by_id and not queue_labels(board.routing(item_id)[0]) and board.queues(item_id) != (board.queues(target) if target else []):
                return ("only lead and solo sessions move an item's parent, which moves it to the parent's queue; file a find for another person with "
                        'agents board create --for <person>, and ask your lead to route the rest (agents board route)')
    return None


def plan_queue_refusal(plan: dict) -> str | None:
    """A plan that puts an item in someone else's queue is a move: only lead and solo sessions make it."""
    mine = QUEUE_PREFIX + (person() or '')
    named = queue_labels([label for node in plan['nodes'] for label in node.get('labels') or []])
    if any(label != mine for label in named) and not may_attend():
        return ("only lead and solo sessions change an item into someone else's queue; file a find for another person with agents board create --for "
                '<person>, and ask your lead to route the rest (agents board route)')
    return None


NO_HOLDS = 'none'
HOLDS_USAGE = '--holds <id>[,<id>…] names the items the question holds up (they wait on it); --holds none: it holds nothing up'


def parse_holds(value: str | None) -> list[str]:
    """The ids a new question or ruling holds up; [] for `none`. A decision is never created without saying (board-core.md Questions
    and rulings): the block edge rule lived in text alone and sessions skipped it."""
    if value is None:
        raise BoardError(f'a question or ruling names what it holds up when it is created: {HOLDS_USAGE}')
    parts = [part.strip() for part in value.split(',') if part.strip()]
    if not parts:
        raise BoardError(f'--holds is empty: {HOLDS_USAGE}')
    if NO_HOLDS in parts:
        if parts != [NO_HOLDS]:
            raise BoardError(f'--holds none stands alone, not beside ids ({value})')
        return []
    return parts


DECISION_HOLD_REASON = '{new} holds it up until answered or its ruling is planned.'


def record_holds(board: Board, new_id: str, holds: list[str], reason: str | None = DECISION_HOLD_REASON) -> list[str]:
    """The held items wait on the new question, like `board wait <item> --on <new>`; the ids that could not wait."""
    if not holds:
        return []
    with contextlib.redirect_stdout(sys.stderr):  # stdout stays what the create printed: the protocol engine reads its id or JSON
        return wait_items(board, holds, new_id, reason.format(new=new_id) if reason else None, derived_actor() or '')


# Edges (waits, links, parents, ruling links): one writer, write_edges, and one rule owner, edge_rules (nixes-sjkpn). edge_rules judges every edge
# added or removed: which kinds belong to which verb, the wait target rules, cycles, the hold rule on a CR item's waits, the parent rules (only move
# changes an existing record's parent, nixes-j65oa) and the one-link-per-pair refusal. write_edges is the only bd write of an edge; the two
# creations that write edges with their new record (create_plan, create_gate) run edge_rules themselves. bd's own supersede (in move, a status
# write) writes its supersedes edge. bin/test-agent-configs.py pins the writers.
WAIT_LINK = 'blocks'  # bd's one blocking dependency type: how a wait is stored (written on the waiter), never a word the board takes in
OLD_LINK_WORDS = {  # input words the board refuses -> the form that replaces them
    'blocks': 'agents board wait <item> --on <target> --for "<input>" (a plan node: waits_on [{on, for}])',
    'blocked-by': 'agents board wait <item> --on <target> --for "<input>" (a plan node: waits_on [{on, for}])',
    'depends-on': 'agents board wait <item> --on <target> --for "<input>" (a plan node: waits_on [{on, for}])',
    'waits-for': 'agents board wait <item> --on <target> --for "<input>" (a plan node: waits_on [{on, for}])',
    'conditional-blocks': 'agents board wait <item> --on <target> --for "<input>" (a plan node: waits_on [{on, for}])',
    'related': 'the link type relates-to',
    'discovered-from': 'the found-in field: agents board create --found-in <id> (a plan node: found_in)',
}
PAIR_VERBS = ('link', 'record')  # writers that add to a pair as it is (record: an in-force record's); wait replaces the pair's relates-to link itself, supersede clears it (record --replaces writes a decided record's through the ruling verb)
RULING_LINKS = ('supersedes', REVISES)  # the edges rulings carry: board ruling supersede, revise, release and record --replaces own them, no other verb writes them
LINK_VERB_TYPES = tuple(kind for kind in PASS_LINKS if kind not in (*RULING_LINKS, 'parent-child'))  # what `board link` writes; rulings and move write the rest
Edge = tuple[str, str, str]  # (waiting or child end, other end, kind)
Waits = dict[str, tuple[list[str], list[str]]]  # new item key -> (existing items, keys of new items) that wait on it


def blocking(kind: str) -> bool:
    """Whether a stored link type is a wait (bd: blocks is the default): the one test for every link."""
    return (kind or WAIT_LINK) == WAIT_LINK


def refuse_old_link(kind: str | None, where: str = 'a link') -> None:
    """Refuses an input word of the earlier relations, naming the form that replaces it."""
    if kind in OLD_LINK_WORDS:
        raise BoardError(f'{where}: {kind} is not a link word; use {OLD_LINK_WORDS[kind]}')


def wait_sentence(waiter: str, target: str, why: str | None) -> str:
    """The one way every write and dry run says a wait."""
    return f'{waiter} waits on {target}' + (f' for {why}' if why else '')


def plan_links(plan: dict) -> tuple[list[tuple[str, str, str]], dict[str, str]]:
    """A validated plan's links as (waiting or starting end, other end, kind) and the new items {key: type}: its edges (`from` waits on `to`) and
    node deps (the node waits on its target, a plan key or an existing id; `plan_waits` has made a node's waits_on into those). An edge with both ends existing is refused: a plan creates links for its new items only."""
    new = {node['key']: node.get('type') or 'task' for node in plan['nodes']}
    links = []
    for edge in plan.get('edges') or []:
        kind = edge.get('type') or WAIT_LINK
        ends = [edge.get('from_key') or edge.get('from_id'), edge.get('to_key') or edge.get('to_id')]
        if edge.get('from_id') in new or edge.get('to_id') in new:
            raise BoardError(f"{edge.get('from_id') if edge.get('from_id') in new else edge.get('to_id')} is a plan key and an existing id: name it from_key/to_key")
        if not any(end in new for end in ends):
            raise BoardError(f'{ends[0]} -> {ends[1]} ({kind}): a plan edge needs a new item at one end; link existing items with agents board link or agents board wait')
        links.append((ends[0], ends[1], kind))
    for node in plan['nodes']:
        for dep in node.get('deps') or []:
            links.append((node['key'], dep['target'], dep.get('type') or WAIT_LINK))
    return links, new


def plan_waits(plan: dict) -> list[tuple[str, str, str]]:
    """Takes each node's `waits_on` [{on, for}] out of a validated plan into the node deps bd writes (bd drops a key it does not know), and returns the
    waits as (waiter key, target, for) for the sentences and the comment that keeps the for."""
    found = []
    for node in plan['nodes']:
        for wait in node.pop('waits_on', None) or []:
            node.setdefault('deps', []).append({'target': wait['on'], 'type': WAIT_LINK})
            found.append((node['key'], wait['on'], wait.get('for', '')))
    return found


def plan_parents(plan: dict, links: list[tuple[str, str, str]]) -> dict[str, list[str]]:
    parents: dict[str, list[str]] = {}
    for node in plan['nodes']:
        if parent := node.get('parent_key') or node.get('parent_id') or node.get('parent'):
            parents[node['key']] = [parent]
    for child, parent, kind in links:
        if kind == 'parent-child':
            parents.setdefault(child, []).append(parent)
    return parents


def wait_cycle(board: Board | None, edges: list[tuple[str, str]], cr_of=None) -> list[str] | None:
    """The chain an added wait would close into a cycle, [waiter, target, ..., waiter], else None. `edges` are the new (waiter, target) waits; the
    existing ones are the open items' open blockers. A wait on a closed item is met and never part of a cycle. Waits between items of different
    change requests are also followed as waits between those requests (each needs the other to land), so two items waiting on each other's
    request through different items are a cycle too; `cr_of` places a plan's new items."""
    place = cr_of or (lambda item: board.cr_of(item) if board and item in board.by_id else None)
    graph: dict[str, list[str]] = {}
    for waiter, target in edges:
        graph.setdefault(waiter, []).append(target)

    def items(item: str) -> list[str]:
        return [*(board.open_blockers(item) if board and board.is_open(item) else []), *graph.get(item, [])]

    def requests(unit: str) -> list[str]:  # the lifted graph: a request stands for itself and its open items
        members = [unit, *(i['id'] for i in board.cr_items(unit))] if board and board.is_cr(unit) else [unit]
        lifted = [place(b) or b for m in members for b in items(m)]
        return [b for b in dict.fromkeys(lifted) if b != unit]

    def find(start: str, goal: str, succ) -> list[str] | None:
        path, seen = [[start]], {start}  # breadth first: does it reach the goal?
        while path:
            chain = path.pop(0)
            if chain[-1] == goal:
                return chain
            for step in succ(chain[-1]):
                if step not in seen:
                    seen.add(step)
                    path.append([*chain, step])
        return None

    for waiter, target in edges:
        if chain := find(target, waiter, items):
            return [waiter, *chain]
        lifted_waiter, lifted_target = place(waiter) or waiter, place(target) or target
        if lifted_waiter != lifted_target and (chain := find(lifted_target, lifted_waiter, requests)):
            return [lifted_waiter, *chain]
    return None


def parent_refusal(item_id: str) -> str:
    return f'{item_id}: a parent changes only through agents board move {item_id} --to <change request> (a change request: --to <milestone>), which applies the parent rules'


def edge_rules(board: Board | None, links: list[Edge], verb: str, new: dict[str, str] | None = None,
               holds: list[str] = (), parents: dict[str, list[str]] | None = None, removes: list[Edge] = (),
               actor: str | None = None) -> tuple[list[Edge], Waits]:
    """The rules every edge meets, added (`links`) or removed (`removes`, edges as they stand). `new` marks a plan's new items {key: type} (None:
    every end exists). `verb` is who writes it: 'create', 'link', 'unlink', 'wait', 'move', 'ruling' or 'record'; `actor` the caller (default: derived).
    - A ruling link (supersedes, tracks) is written and removed by the ruling verbs only; `link` writes no wait (that is board wait).
    - A parent of an existing record changes through move only, with move's rules: parent_move_refusal, the hold rule, an open change request
      (a milestone for a change request) as the new parent; a plan or link that would give an existing record a parent, or an unlink of a parent edge, is refused.
    - A wait meets wait_target_refusal and the cycle rule; a wait written or removed on a CR's item meets the hold rule (item_write_refusal).
    - An existing item made to wait on a new one gets board wait's effects once it exists: allowed where wait needs no for (a decision or
      gate as the target), else refused, naming the board wait that does it. `holds` also wait on every new
      decision. Returns (the edges to write, those already there skipped; Waits: the existing and new items waiting on each new item, for
      apply_waits)."""
    new = new or {}
    parents = parents or {}
    who = (actor if actor is not None else derived_actor()) or None

    def kind_of(item: str):
        return new.get(item) or (board.by_id.get(item, {}).get('issue_type') if board else None)

    # bd writes the graph together, so both ends of a wait may acquire a CR in the same plan.
    planned_crs = {item: cr for item, candidates in parents.items()
                   if (cr := next((parent for parent in candidates if kind_of(parent) == CR_TYPE), None))}

    def cr_of(item: str):
        if kind_of(item) == CR_TYPE:
            return item
        return planned_crs.get(item) or (board.cr_of(item) if board and item not in new and item in board.by_id else None)

    for source, target, kind in removes:
        if kind in RULING_LINKS and verb not in ('ruling', 'record'):
            raise BoardError(f'{source} -> {target} is a {kind} link of rulings: agents board ruling supersede|revise own it')
        if kind == 'parent-child':
            raise BoardError(parent_refusal(source))
        if blocking(kind) and board and source in board.by_id and (refusal := item_write_refusal(board, board.by_id[source], 'unlink', who)):
            raise BoardError(refusal)
    waits: Waits = {key: ([], []) for key in new}
    ops = []
    if chain := wait_cycle(board, [(waiting, other) for waiting, other, kind in links if blocking(kind)], cr_of):
        raise BoardError(f"these waits would form a cycle, nothing would ever start: {' waits on '.join(chain)}")
    for waiting, other, kind in links + [(one, key, 'blocks') for one in holds for key, type_ in new.items() if type_ == 'decision']:
        if kind in RULING_LINKS and verb not in ('ruling', 'record'):
            raise BoardError(f'{kind} links belong to rulings: agents board ruling supersede <old> --with <new>, agents board ruling revise <old> ...')
        if not blocking(kind) and kind not in PASS_LINKS:
            raise BoardError(f"{waiting} -> {other}: {kind} is not a link the board writes (agents board link writes {', '.join(LINK_VERB_TYPES)}; "
                             'rulings write supersedes and tracks; a wait is agents board wait; a parent is agents board move)')
        if blocking(kind) and verb == 'link':
            raise BoardError(f'a wait is agents board wait {waiting} --on {other} --for "<the input it uses>"')
        if blocking(kind) and board and other in board.by_id and (
                refusal := wait_target_refusal(board.by_id.get(waiting) if waiting not in new else None, other, board.by_id[other], board)):
            raise BoardError(refusal)
        if blocking(kind) and waiting not in new and board and waiting in board.by_id and (
                refusal := item_write_refusal(board, board.by_id[waiting], 'wait', who)):
            raise BoardError(refusal)
        if kind == 'parent-child' and (verb == 'link' or (waiting not in new and verb != 'move')):
            raise BoardError(parent_refusal(waiting))
        if kind == 'parent-child' and verb == 'move':
            known_items(board, [waiting, other])
            if refusal := parent_move_refusal(board, [waiting], other) or item_write_refusal(board, board.by_id[waiting], 'move', who):
                raise BoardError(refusal)
            part_of = 'milestone' if board.is_cr(waiting) else CR_TYPE  # an item is part of an open change request, a change request part of an open milestone
            if board.by_id[other].get('issue_type') != part_of or not board.is_open(other):
                raise BoardError(f"{other} is not an open {part_of.replace('-', ' ')}: {waiting} is part of one; work that commits nothing is a task, not an item")
        elif not blocking(kind):
            pass
        elif other in new:
            if waiting in new:
                if new[other] == 'decision':  # between new work items bd writes the edge itself
                    waits[other][1].append(waiting)
            elif board is None or not board.is_open(waiting):
                raise BoardError(f'unknown or closed: {waiting}')
            elif new[other] == 'decision' or reason_optional(board.by_id[waiting], {'issue_type': new[other]}):
                waits[other][0].append(waiting)
            else:
                raise BoardError(f'{waiting} would wait on the new {new[other]} {other}, and a wait on a work item needs a reason: create the item without the '
                                 f'link, then agents board wait {waiting} --on <new id> --for "<the input it uses>"')
        if new:
            continue  # bd writes a plan's links with the items
        if verb == 'wait' and board and (clash := [edge for a, _, edge in board.between(waiting, other) if edge != 'relates-to' and not (blocking(edge) and a == waiting)]):
            raise BoardError(f"{waiting}: already linked to {other} by {', '.join(clash)}; bd keeps one edge per pair")  # a relates-to link gives way to the wait
        if verb in PAIR_VERBS and board and (clash := [edge for _, _, edge in board.between(waiting, other) if edge != kind and edge != 'parent-child']):
            raise BoardError(f"{waiting} and {other} are linked already ({', '.join(clash)}); bd keeps one link per pair: agents board unlink first")
        if board is None or not any(source == waiting and target == other and (edge == kind or blocking(edge) and blocking(kind))
                                    for source, target, edge in board.between(waiting, other)):
            ops.append((waiting, other, kind))
    return ops, {key: (list(dict.fromkeys(ids)), list(dict.fromkeys(keys))) for key, (ids, keys) in waits.items()}


def write_edges(board: Board, verb: str, message: str, links: list[Edge] = (), removes: list[Edge] = (), actor: str | None = None) -> list[Edge]:
    """The one bd write of edges: edge_rules on every edge, then the removals and additions in one bd batch (`message` is its commit message). A parent
    (verb move) is bd's own parent write, which replaces the old one; it clears no_commit in the same write (a task in a change request is work that
    commits, nixes-x62oy). Returns the edges added."""
    adds, _ = edge_rules(board, list(links), verb, removes=list(removes), actor=actor)
    lines = [f'dep remove {source} {target}' for source, target, _ in removes] + [f'dep add {a} {b} {kind}' for a, b, kind in adds if kind != 'parent-child']
    if lines:
        bd_checked('batch', '-m', message, '--json', stdin='\n'.join(lines) + '\n')
    for target in dict.fromkeys(b for _, b, kind in adds if kind == 'parent-child'):
        moving = [a for a, b, kind in adds if kind == 'parent-child' and b == target]
        cleared = [a for a in moving if is_no_commit(board.by_id[a]) and not board.is_cr(a)]
        if rest := [a for a in moving if a not in cleared]:
            bd_checked('update', *rest, '--parent', target, '--json')
        if cleared:
            bd_checked('update', *cleared, '--parent', target, '--unset-metadata', NO_COMMIT, '--json')
    return adds


def require_holds_declared(waits: Waits, new: dict[str, str], value: str | None) -> None:
    """A decision is never created without saying what it holds up (board-core.md Questions and rulings): a blocking link to it, or `--holds <ids>`
    (a shorthand for such links), or `--holds none`, which stands alone."""
    for key, kind in new.items():
        ids, keys = waits[key]
        if kind != 'decision':
            continue
        if value is None and not (ids or keys):
            raise BoardError(f'the decision {key} names what it holds up: --holds <id>[,<id>], or a node of the plan that waits on it (waits_on), '
                             f'or --holds none ({HOLDS_USAGE})')
        if value is not None and not parse_holds(value) and (ids or keys):
            raise BoardError(f'--holds none stands alone, not beside the links that make {(ids + keys)[0]} wait on decision {key}')


def apply_waits(made: dict[str | None, str], waits: Waits, types: dict[str, str]) -> int:
    """board wait's effects for the links that made existing and new items wait on the items just created ({plan key: new id}), on a board read
    after the create: a decision says why in its own words, a gate or a milestone's member needs none. 1 when a wait could not be written or an
    id is missing."""
    todo = {key: (ids, keys) for key, (ids, keys) in waits.items() if ids or keys}
    if not todo:
        return 0
    if not all(made.get(key) for key in todo) or not made:
        every = sorted({one for ids, _ in todo.values() for one in ids})
        print(f'board: created, but no id was printed: write the waits yourself (agents board wait {" ".join(every)} --on <new> --for "<input>")', file=sys.stderr)
        return 1
    after = Board.load('all')
    problems = []
    for key, (ids, keys) in todo.items():
        new_id = made[key]
        failed = record_holds(after, new_id, [*ids, *(made[k] for k in keys if k in made)],
                              DECISION_HOLD_REASON if types[key] == 'decision' else None)
        if failed:
            problems.append(f"{new_id} created, but {', '.join(failed)} do not wait on it: agents board wait {' '.join(failed)} --on {new_id}")
    for problem in problems:
        print(f'board: {problem}', file=sys.stderr)
    return 1 if problems else 0


PLAN_NODE_KEYS = {'key', 'title', 'type', 'description', 'design', 'acceptance_criteria', 'notes', 'priority', 'labels', 'assignee', 'metadata',
                  'parent', 'parent_id', 'parent_key', 'deps', 'spec_id', 'external_ref', 'estimate'}  # the node fields bd's graph reads; it drops others silently
PLAN_EDGE_KEYS = {'from_key', 'from_id', 'to_key', 'to_id', 'type'}
ITEM_SETTING_KEYS = (NO_COMMIT, *CR_SETTINGS)  # typed node fields a plan gives; the board stores them as metadata
GIVEN_NODE_KEYS = PLAN_NODE_KEYS - {'metadata', 'assignee'} | set(ITEM_SETTING_KEYS) | {'waits_on', FOUND_IN}  # a plan's own nodes: metadata and the holder stay the board's


def validate_plan(plan: object, name: str = 'the plan', fields: set[str] = PLAN_NODE_KEYS) -> dict:
    """The board's validation of a `create --graph` plan: an object with a non-empty list of nodes (title, key, only the fields bd reads, labels a list of strings,
    deps and edges objects). bd ignores what it does not know, so a typo would lose a field silently."""
    nodes = plan.get('nodes') if isinstance(plan, dict) else None
    if not isinstance(nodes, list) or not nodes:
        raise BoardError(f'{name}: a plan is a JSON object with a non-empty "nodes" list (and optional "edges")')
    if set(plan) - {'nodes', 'edges'}:
        raise BoardError(f"{name}: unknown plan key {', '.join(sorted(set(plan) - {'nodes', 'edges'}))}; a plan has nodes and edges")
    keys = []
    for node in nodes:
        if not isinstance(node, dict) or not isinstance(node.get('key'), str) or not node['key'] or not isinstance(node.get('title'), str) or not node['title'].strip():
            raise BoardError(f'{name}: every node is an object with a key and a title')
        if unknown := sorted(set(node) - fields):
            raise BoardError(f"{name}: node {node['key']} has unknown field {', '.join(unknown)}; fields: {', '.join(sorted(fields))}")
        if not isinstance(node.get('description'), str) or not node['description'].strip():  # bd's create.require-description does not apply to --graph
            raise BoardError(f"{name}: node {node['key']} needs a description (what and why; --description-file, or the node's \"description\")")
        labels = node.get('labels', [])
        if not isinstance(labels, list) or not all(isinstance(label, str) for label in labels):
            raise BoardError(f"{name}: node {node['key']}: labels is a list of strings")
        if not isinstance(node.get('metadata', {}), dict):
            raise BoardError(f"{name}: node {node['key']}: metadata is an object")
        deps = node.get('deps', [])
        if not isinstance(deps, list) or not all(isinstance(dep, dict) and dep.get('target') for dep in deps):
            raise BoardError(f"{name}: node {node['key']}: deps is a list of objects with a target (and a type)")
        for dep in deps:
            refuse_old_link(dep.get('type') or WAIT_LINK, f"{name}: node {node['key']}")
        waits_on = node.get('waits_on', [])
        if not isinstance(waits_on, list) or not all(isinstance(wait, dict) and set(wait) in ({'on', 'for'}, {'on'}) and all(isinstance(wait[k], str) and wait[k].strip() for k in wait)
                                                      for wait in waits_on):
            raise BoardError(f"{name}: node {node['key']}: waits_on is a list of {{\"on\": <key or id>, \"for\": \"<the input it uses>\"}}")
        keys.append(node['key'])
    if len(set(keys)) != len(keys):
        raise BoardError(f'{name}: node keys repeat: {", ".join(sorted({key for key in keys if keys.count(key) > 1}))}')
    edges = plan.get('edges', [])
    if not isinstance(edges, list) or not all(isinstance(edge, dict) for edge in edges):
        raise BoardError(f'{name}: edges is a list of objects (from_key or from_id, to_key or to_id, type)')
    for edge in edges:
        if set(edge) - PLAN_EDGE_KEYS or not (edge.get('from_key') or edge.get('from_id')) or not (edge.get('to_key') or edge.get('to_id')):
            raise BoardError(f"{name}: an edge has {', '.join(sorted(PLAN_EDGE_KEYS))} only, from one side and to the other: {edge}")
        refuse_old_link(edge.get('type') or WAIT_LINK, f'{name}: an edge')
    return plan


def plan_with_queue(plan: dict) -> None:
    """On a shared board the plan's parentless nodes carry the creator's queue (a child takes its parent's); in place, graph ids are plain."""
    if shared is None or not person():
        return
    children = {edge.get('from_key') for edge in plan.get('edges') or [] if edge.get('type') == 'parent-child'}
    for node in plan['nodes']:
        if not (node.get('parent') or node.get('parent_key') or node.get('parent_id')) and node['key'] not in children \
                and not queue_labels(node.get('labels') or []):
            node['labels'] = [*(node.get('labels') or []), QUEUE_PREFIX + person()]


def create_plan(plan: dict, board: Board | None, verb: str = 'create', holds: list[str] = (), dry_run: bool = False) -> tuple[dict[str, str], Waits]:
    """`bd create --graph` of a validated plan, the one creation of items with their links: edge_rules on the plan's links, parents and `holds`
    (`board` holds the existing ends; `verb` writes them) before anything is written; atomic (bd rolls the whole plan back). Returns ({key: id},
    the waits apply_waits writes); `dry_run`: the checks only, no ids."""
    links, types = plan_links(plan)
    parents = plan_parents(plan, links)
    for node in plan['nodes']:  # a work task files in an open change request, or commits nothing and stands outside every one (model.md Types)
        if (node.get('type') or WORK_TYPE) != WORK_TYPE:
            continue
        if (node.get('metadata') or {}).get(NO_COMMIT) is True:
            if node['key'] in parents:
                raise BoardError(f"{node['key']}: work that commits nothing stands outside any change request: drop --parent, or drop --no-commit to file it in one")
            continue
        found = [types.get(parent) and {'id': parent, 'issue_type': types[parent], 'status': 'open'}
                 or (board.by_id.get(parent) if board else None) or next(iter(bd_show([parent], comments=False)), None) for parent in parents.get(node['key'], [])]
        requests = [record for record in found if record and record.get('issue_type') == CR_TYPE]
        if not requests:
            raise BoardError(loose_work_refusal(node['key']))
        if closed := [record['id'] for record in requests if record.get('status') == 'closed']:
            raise BoardError(f"{node['key']}: change request {', '.join(closed)} is closed (landed or dropped): an item under it would be reached by no queue; "
                             'file the work in an open change request')
    _, waits = edge_rules(board, links, verb, types, holds, parents)
    if dry_run:
        return {}, waits
    with tempfile.NamedTemporaryFile('w', suffix='.json', encoding='utf-8', delete=False) as handle:
        json.dump(plan, handle)
    atexit.register(os.unlink, handle.name)
    result = bd('create', '--graph', handle.name, '--json')
    if result.returncode != 0:
        raise BoardError(f'`bd create` failed: {bd_message(result)}')
    try:
        made = dict(json.loads(result.stdout).get('ids') or {})
    except (ValueError, AttributeError):
        made = {}
    if not made:
        raise BoardError(f'created, but bd printed no ids: {result.stdout.strip()[:200]}')
    return made, waits


def create_item(board: Board, title: str, kind: str, parent: str | None = None, deps: list[tuple[str, str]] = (), holds: list[str] = (),
                labels: list[str] = (), verb: str = 'create', dry_run: bool = False, **fields) -> str:
    """The board's own single-item creates (a follow-up, a revision), using `board create`'s field and link checks through one plan node.
    A parent is a plain hash id plus a link (a dotted child id stops sync when two clones create under one parent); bd copies none of the
    parent's labels, so they are copied here, the queue label excepted (the child inherits its queue). `deps` are (type, id) links the new item
    holds; `holds` are items that wait on it (their effects are the caller's: record_holds). `verb` is who writes the links (edge_rules).
    `board` spares a read when it holds the parent."""
    node: dict = {'key': 'item', 'title': title, 'type': kind, **{key: value for key, value in fields.items() if value is not None}}
    labels = list(labels)
    if parent:
        record = board.by_id.get(parent) if board else None
        records = [record] if record else bd_show([parent], comments=False)
        if not records:
            raise BoardError(f'unknown parent {parent}')
        node['parent_id'] = records[0]['id']
        labels += [label for label in records[0].get('labels') or [] if not label.startswith(QUEUE_PREFIX) and label not in labels]
    if labels:
        node['labels'] = labels
    if deps:
        node['deps'] = [{'target': target, 'type': link} for link, target in deps]
    plan = validate_plan({'nodes': [node]})
    if holds:
        plan['edges'] = [{'from_id': one, 'to_key': 'item', 'type': 'blocks'} for one in holds]
    plan_with_queue(plan)
    made, _ = create_plan(plan, board, verb, dry_run=dry_run)
    return made.get('item', '')  # dry_run: the checks, no write


def missing_sections(text: str, sections=RECORD_SECTIONS) -> list[str]:
    headings = [normalized(match.group(1)) for match in re.finditer(r'^##\s+(.+?)\s*$', text, re.MULTILINE)]
    return [name for name in sections if not any(heading.startswith(normalized(name)) for heading in headings)]


def create_ruling_revision(board: Board, old: str, title: str, description: str, holds: list[str] = (),
                           parent: str | None = None, labels: list[str] | None = None,
                           priority: int | None = None, external_ref: str | None = None,
                           partial: str | None = None, dry_run: bool = False) -> str:
    issue = board.by_id[old]
    parent = parent or board.parent.get(old)
    labels = labels if labels is not None else [label for label in issue.get('labels') or [] if label.startswith('topic:')]
    new = create_item(board, title, 'decision', parent=parent, labels=labels, holds=holds, verb='ruling',
                      priority=priority if priority is not None else issue.get('priority', 2),
                      description=description, external_ref=external_ref or None,
                      metadata={REVISES_RULE: partial} if partial is not None else None, deps=[(REVISES, old)],
                      dry_run=dry_run)
    if dry_run:
        return new
    failed = record_holds(Board.load('all'), new, holds) if holds else []
    if failed:
        raise BoardError(f"{new} created, but {', '.join(failed)} do not wait on it: agents board wait {' '.join(failed)} --on {new}")
    return new


def confirmation_text(issue: dict, reversal: str) -> tuple[str, str]:
    """The title and description of the Confirm-or-revise question of an in-force ruling taken without the user's judgment; board-migrate reads it too."""
    return (f"Confirm or revise: {issue.get('title', '')}?",
            f"## Question\nConfirm ruling {issue['id']} or revise it?\n\n{reversal.strip()}\n")


def unratified_confirmation(board: Board, issue: dict, reversal: str) -> str:
    """The ordinary question for an in-force ruling taken without the user's judgment."""
    item_id = issue['id']
    title, description = confirmation_text(issue, reversal)
    related = board.related.get(item_id, set())
    questions = [board.by_id[other] for other in related
                 if other in board.by_id and board.by_id[other].get('issue_type') == 'decision'
                 and board.by_id[other].get('description') == description]
    if len(questions) > 1:
        raise BoardError(f'{item_id}: more than one related Confirm-or-revise question; resolve the duplicate before rerunning')
    if questions:
        return questions[0]['id']
    parent = board.parent.get(item_id)
    labels = [label for label in issue.get('labels') or [] if label.startswith('topic:')]
    return create_item(board, title, 'decision', parent=parent, labels=labels, verb='ruling',
                       priority=issue.get('priority', 2), description=description,
                       deps=[('relates-to', item_id)])


def record(board: Board, args) -> int:
    actor = caller()
    issue = held(board, args.id, actor)
    if issue.get('issue_type') != 'decision':
        raise BoardError(f'{args.id}: {issue.get("issue_type")}, not a decision')
    allowed_statuses = ('open', 'decided')
    if issue['status'] not in allowed_statuses and not (args.unratified and issue['status'] == 'in_force'):
        raise BoardError(f"{args.id}: {issue['status']}; an in-force record changes through agents board ruling revise")
    try:
        text = Path(args.file).read_text(encoding='utf-8')
    except (OSError, UnicodeDecodeError) as error:
        raise BoardError(f'cannot read {args.file}: {error}') from None
    # An unratified ruling carries how to reverse it (unattended protocol).
    required = RECORD_SECTIONS + (('Reversal',) if args.unratified else ())
    missing = missing_sections(text, required)
    if missing:
        raise BoardError(f"{args.file} lacks the record section(s) {', '.join('## ' + name for name in missing)}")
    replaces = list(dict.fromkeys(args.replaces))
    status = 'in_force' if args.unratified else 'decided'
    closing, taking, operations = replaced_checks(board, args.id, replaces, actor, args.unratified)  # every refusal before the first write
    confirmation = None
    if args.unratified:
        reversal = section_text({'description': text}, 'description', 'Reversal')
        confirmation = unratified_confirmation(board, issue, reversal)
    write_fields(board, [args.id], ['--body-file', args.file], 'ruling record')
    # Revision links before the supersedes: `ruling release` refuses an old a live record revises, so a stop before the end leaves a visible state the rerun finishes.
    move(issue, 'ruling record --unratified' if args.unratified else 'ruling record', board=board)  # the status by compare-and-set, then the links
    write_edges(board, 'ruling', f'board ruling record {args.id}', *operations)
    lint = json.loads(bd_checked('lint', args.id, '--json') or '{}')
    unlinted = [', '.join(result.get('missing') or []) for result in lint.get('results') or [] if result.get('missing')]
    if unlinted:
        raise BoardError(f"{args.id}: recorded ({status.replace('_', ' ')}), but bd lint reports missing {'; '.join(unlinted)}")
    failed = []
    for old in closing:
        if old in taking:
            take(board, argparse.Namespace(ids=[old], force=None, agreed=None))
        board = Board.load('all')  # the links just written and the earlier olds' supersedes are in the snapshot
        failed += supersede_pair(board, old, args.id, None, actor, carry=True, closing=frozenset(closing))
    if args.unratified:  # unclaim last, so any earlier stop leaves the record held and rerunnable
        move(issue, 'unclaim', board=board)
    print(f"recorded {args.id} ({status.replace('_', ' ')}): {issue.get('title', '')}")
    if confirmation:
        print(f'confirmation question: {confirmation}')
    if failed:
        print(f"{', '.join(failed)}: replaced, but items waiting on it do not wait on {args.id}: agents board wait <item> --on {args.id}", file=sys.stderr)
    return 1 if failed else 0


def hold_refusal(board: Board, issue: dict, actor: str) -> str | None:
    """Whether a record about to be superseded is held by another session: None (free or this session's), 'gone' (a gone
    session's hold, taken first), else the refusal."""
    held = holder(issue)
    if not held or session_actor(held) == session_actor(actor):
        return None
    if not holder_gone(board, board.registry(), held):
        return f'held by {held}, another live session; ask it to hand it off (agents board unclaim), then run this again'
    return foreign_claim(board, issue['id']) or 'gone'


def replaced_checks(board: Board, new: str, replaces: list[str], actor: str, in_force: bool) -> tuple[list[str], list[str], list[str]]:
    """Judges every record `new` replaces before anything is written, from the board alone (a rerun finds what is done). Each
    decided or released one gets a pending revision link; it is superseded when `new` comes into force (r9-q33): now for an away
    record (`in_force`), else at `new`'s release. Closed and superseded by `new`: done; anything else is refused. A hold of a live
    other session refuses a record that closes now, a gone session's is taken first. A link of another kind on a replaced record's
    pair gives way to the revision link (the supersede would drop it anyway), so it is no clash. Returns (the records to close now, those whose hold is taken first,
    the revision links and the edges they replace, for write_edges)."""
    problems, closing, taking, later = [], [], [], []
    links: list[Edge] = []
    removes: list[Edge] = []  # later: superseded at the release, carrying their revisions then
    for old in replaces:
        issue = board.by_id.get(old)
        if issue is None:
            problems.append(f'--replaces {old}: unknown')
        elif old == new or issue.get('issue_type') != 'decision':
            problems.append(f'--replaces {old}: not another decision ruling')
        elif issue['status'] == 'closed':
            if new in superseding(board, old):
                continue
            if superseding(board, old):
                problems.append(f'--replaces {old}: closed and already superseded')
            elif missing_sections(str(issue.get('description') or '')):
                problems.append(f'--replaces {old}: closed question, not a planned ruling')
            else:
                removes += [(a, b, kind) for a, b, kind in board.between(new, old) if kind != 'parent-child' and (a, b, kind) != (new, old, REVISES)]
                links.append((new, old, REVISES))
                if in_force:
                    closing.append(old)
                else:
                    later.append(old)
        elif issue['status'] not in ('decided', 'in_force'):
            problems.append(f"--replaces {old}: {issue['status']}, not decided or released")
        else:
            # The supersede replaces any other link on the pair (bd keeps one edge per pair), so the revision link replaces it now.
            removes += [(a, b, kind) for a, b, kind in board.between(new, old) if kind != 'parent-child' and (a, b, kind) != (new, old, REVISES)]
            links.append((new, old, REVISES))  # the verb that skips the pair rule
            if not in_force:
                later.append(old)
                continue
            if (refusal := hold_refusal(board, issue, actor)) == 'gone':
                taking.append(old)
            elif refusal:
                problems.append(f'--replaces {old}: {refusal}')
            closing.append(old)
    carried = {(target, rule_of(board.by_id[old])) for old in [*closing, *later] for target in board.revises(old) if target != new and target not in replaces}
    carried |= {(target, rule_of(board.by_id[new])) for target in board.revises(new) if target not in replaces}  # a rerun's own links are no other revision
    if len(carried) > 1:  # the supersedes carry the closing records' pending revisions onto `new`, which keeps one revision (target and rule)
        problems.append(f"{new} would revise more than one record or rule ({', '.join(sorted(target + (f' ({rule})' if rule else '') for target, rule in carried))}); "
                        'bd keeps one revision rule per record: finish the revisions one record at a time')
    if problems:
        raise BoardError('record refused:\n  ' + '\n  '.join(problems))
    edge_rules(board, links, 'ruling', removes=removes)  # write_edges checks again at the write
    return closing, taking, (links, removes)


def check_replaces(board: Board, args) -> None:
    """Validate and classify the records a staged question proposes to replace. Record repeats the mutable checks with its new id."""
    hits = list(dict.fromkeys(args.ids))
    rows = {item_id: board.by_id.get(item_id) for item_id in hits}
    problems = []
    for item_id, issue in rows.items():
        if issue is None or issue.get('issue_type') != 'decision' or issue.get('status') in (None, 'open'):
            status = issue.get('status') if issue else None
            kind = issue.get('issue_type') if issue else None
            problems.append(f'{item_id} is {status} {kind}, not a ruling')
            continue
        if issue['status'] == 'closed':
            if superseding(board, item_id):
                problems.append(f'{item_id} is closed and already superseded')
            missing = missing_sections(str(issue.get('description') or ''))
            if missing:
                problems.append(f"{item_id} is a closed question, not a planned ruling (missing {', '.join(missing)})")
        elif issue['status'] not in ('decided', 'in_force'):
            problems.append(f'{item_id} is {issue["status"]} decision, not a decided or in-force ruling')
    if problems:
        raise BoardError('supersedes needs a recorded ruling: ' + '; '.join(problems))

    replaces = [item_id for item_id, issue in rows.items() if issue['status'] == 'decided']
    revises = [item_id for item_id in hits if item_id not in replaces]
    if len(revises) > 1:
        raise BoardError(f'a question revises at most one in-force record ({", ".join(revises)}); split the question')

    actor = caller()
    held = [(item_id, rows[item_id].get('assignee'), hold_refusal(board, rows[item_id], actor)) for item_id in replaces]
    refused = [(item_id, holder, reason) for item_id, holder, reason in held if reason and reason != 'gone']
    if refused:
        item_id, holder, _ = refused[0]
        raise BoardError(f'{item_id} (held by {holder}) would close at Record; ask that session to hand it off (agents board unclaim), or choose another outcome')

    carried = {(dep['depends_on_id'], rule_of(rows[item_id]))
               for item_id in replaces for dep in rows[item_id].get('dependencies') or []
               if dep.get('issue_id') == item_id and dep.get('type') == REVISES}
    carried.update((item_id, None) for item_id in revises)
    if len(carried) > 1:
        detail = ', '.join(sorted(target + (f' ({rule})' if rule else '') for target, rule in carried))
        raise BoardError(f'the new record would revise more than one record or rule ({detail}); a record keeps one revision: split the question')

    print(json.dumps({'replaces': replaces, 'revises': revises[0] if revises else None,
                      'titles': {item_id: rows[item_id].get('title') or '' for item_id in hits}}))


def wait_comment(target: str, why: str) -> str:
    """The wait's comment: it keeps the for, and names the target for board check."""
    return f'Waits on {target} for {why}'


def reason_optional(issue: dict, record: dict) -> bool:
    """A wait needs no reason line when the blocker says why (a decision or a gate)."""
    return record.get('issue_type') in ('decision', 'gate')


def wait_target_refusal(waiter: dict | None, target: str, record: dict, board: 'Board | None' = None) -> str | None:
    """The rules about what a wait may name, one owner for every writer (wait, create and plan links, ruling revise and supersede, the protocol
    engine's links): nothing waits on a deferred record (set aside, it would never end) or on one closed dropped (a question excepted: it
    releases its waiters), and an in-force ruling waits only for its planning, a live decision or a human gate. `waiter` is None for a new item."""
    who = waiter['id'] if waiter else 'a new item'
    if waiter and waiter.get('issue_type') == 'milestone':
        return f'{who} is a milestone: it waits on nothing, a change request is part of it (agents board move <change request> --to {who})'
    unit = (board.cr_of(target) or target) if board and target in board.by_id else target  # an item of a deferred change request is set aside with it
    if record.get('status') == 'deferred' or (board and board.by_id.get(unit, {}).get('status') == 'deferred'):
        return (f'{who} cannot wait on {target}: {"it" if unit == target else unit} is deferred, set aside by nothing that would bring it back; undefer it first '
                f'(agents board undefer {unit}), or wait on the record that would')
    if board and target in board.by_id and any(is_dropped_work(board.by_id.get(each)) for each in (target, unit)):
        return (f'{who} cannot wait on {target}: {"it" if unit == target else unit} was closed dropped and never delivers; '
                f'wait on the record that keeps the work')
    if waiter and waiter.get('issue_type') == 'decision' and waiter['status'] == 'in_force' and not planning_wait(record):
        return (f'{who}: an in-force ruling waits for planning only (a live decision or a human gate), '
                f"not on {target} ({record.get('issue_type')} {record.get('status')}); plan the work the ruling changes and wait that work on {target}")
    return None


def wait_one(board: Board, item_id: str, blocker: str, reason: str | None, actor: str) -> str:
    """Makes one whole item wait on the target; its for is commented on it (none when the target or the item makes the for optional and none
    is given). Returns the sentence. The holder's own wait hands the item back (r21-q144): the hold is freed; a change request
    keeps its worktree."""
    issue = board.by_id[item_id]
    record = board.by_id.get(blocker, {})
    if not reason and not reason_optional(issue, record):
        raise BoardError(f'{item_id}: a work item waits for an input: agents board wait {item_id} --on {blocker} --for "<the input it uses>" '
                         '(optional only when the target is a decision or a gate)')
    edges = board.between(item_id, blocker)
    own = in_hand(issue, actor) and board.is_open(blocker) and group_of(board, issue) != ITEM_GROUP  # an item has no hold to hand back
    # bd allows one edge per pair: a relates-to link between the two gives way to the wait. The target, cycle and hold rules: edge_rules.
    write_edges(board, 'wait', f'board wait {item_id} --on {blocker}', [(item_id, blocker, WAIT_LINK)],
                [(a, b, kind) for a, b, kind in edges if kind == 'relates-to'], actor=actor)
    # The for goes in a comment: an append to a field would rewrite it and lose a concurrent edit.
    if reason and wait_comment(blocker, reason) not in [c.get('text') for c in issue.get('comments') or []]:  # a repeat adds no second line
        comment(item_id, wait_comment(blocker, reason))
    result = wait_sentence(item_id, blocker, reason)
    if own:
        move(issue, 'unclaim', board=board, actor=actor)
        result += '; handed back to the queue'
    return result


def wait_items(board: Board, ids: list[str], blocker: str, reason: str | None, actor: str) -> list[str]:
    """Makes each item wait, one sentence each; the ids that could not wait."""
    failed = []
    for item_id in ids:
        try:
            if item_id == blocker:
                raise BoardError(f'{item_id}: cannot wait on itself')
            require_open(board, [item_id])
            print(wait_one(board, item_id, blocker, reason, actor))
        except BoardError as error:
            failed.append(item_id)
            print(f'{item_id}: does not wait: {error}', file=sys.stderr)
    return failed


def wait_command(board: Board, args) -> int:
    """`board wait <item>... --on <target> [--for "<input>"]`: the one waiting relation, written on the waiter; prints "X waits on Y for …"."""
    actor = caller()
    if args.target not in board.by_id:
        raise BoardError(f'unknown target {args.target}')
    if args.for_:
        refuse_long_comment(wait_comment(args.target, args.for_))
    return 1 if wait_items(board, args.ids, args.target, args.for_, actor) else 0


def known_items(board: Board, ids: list[str]) -> None:
    unknown = [item_id for item_id in ids if item_id not in board.by_id]
    if unknown:
        raise BoardError(f"unknown {', '.join(unknown)}")


def move_command(board: Board, args) -> int:
    """`board move <id>... --to <parent>`: re-parents items where the board's invariants allow it (parent_move_refusal), the planner's call
    on a partial commit; an item then belongs to its new change request."""
    known_items(board, [*args.ids, args.to])
    write_edges(board, 'move', f'board move --to {args.to}', [(item_id, args.to, 'parent-child') for item_id in dict.fromkeys(args.ids)])
    for item_id in args.ids:
        print(f'{item_id}: moved to {args.to}')
    return 0


def update_command(board: Board, args) -> int:
    """`board update <id>... [--title] [--priority] [--label L]... [--unlabel L]... [--no-commit]
    [--look|--view V|""]`: the short fields bd
    leaves to bd, with the board's value rules: labels the board routes on (queue:, for:) change through send, route and create --for; a parent
    a parent moves through `move`; a step for a person is a human gate (gate create)."""
    known_items(board, args.ids)
    for item_id in args.ids:  # refused before the value rules; write_fields checks again at the write
        if refusal := item_write_refusal(board, board.by_id[item_id], 'update', derived_actor()):
            raise BoardError(refusal)
    changes = []
    if args.title is not None:
        changes += ['--title', args.title]
    if args.priority is not None:
        changes += ['--priority', str(args.priority)]
    labels, unlabels = args.label, args.unlabel
    if refusal := label_refusal([*labels, *unlabels]) or kind_refusal(labels) or label_shape_refusal(labels):
        raise BoardError(refusal)
    changes += [flag for label in labels for flag in ('--add-label', label)] + [flag for label in unlabels for flag in ('--remove-label', label)]
    changes += setting_changes(board, args)
    if not changes:
        raise BoardError('nothing to change: give --title, --priority, --label, --unlabel, --no-commit, --look or --view '
                         '(long fields: agents board field; claim: agents board claim)')
    write_fields(board, args.ids, changes)
    for item_id in args.ids:
        print(f'{item_id}: updated')
    return 0


def setting_changes(board: Board, args) -> list[str]:
    """The metadata writes of update's item settings, every item checked first: planning's call (a lead, solo or person, as a parent move),
    on an item no session holds and before its work starts: a work item open or deferred in no change request, a change request open."""
    cr_given = {name: getattr(args, name) for name in CR_SETTINGS if getattr(args, name) is not None}
    if not args.no_commit and not cr_given:
        return []
    if not may_attend(board):
        raise BoardError('only a lead or solo session or a person changes item settings (planning)')
    for item_id in args.ids:
        issue = board.by_id[item_id]
        kind, holder = issue.get('issue_type'), issue.get('assignee')
        if holder:
            raise BoardError(f'{item_id}: held by {holder}; agents board unclaim or agents board take it first')
        if args.no_commit and (issue['status'] not in ('open', 'deferred') or board.cr_of(item_id)):
            raise BoardError(f"{item_id}: {issue['status']}{' in ' + board.cr_of(item_id) if board.cr_of(item_id) else ''}; "
                             'its route changes while it is open or deferred outside any change request')
        if cr_given and issue['status'] != 'open':
            raise BoardError(f"{item_id}: {issue['status']}; a change request's settings change while it is open")
        if cr_given and kind != CR_TYPE:
            raise BoardError(f'{item_id}: look and view are change request settings')
        given = {**({NO_COMMIT: True} if args.no_commit else {}), **{name: value for name, value in cr_given.items() if value}}
        if refusal := setting_refusal(item_id, kind, given):
            raise BoardError(refusal)
    changes = []
    if args.no_commit:
        changes += ['--set-metadata', f'{NO_COMMIT}=true']
    for name, value in cr_given.items():
        changes += ['--set-metadata', f'{name}={value}'] if value else ['--unset-metadata', name]
    return changes


def link_command(board: Board, args) -> int:
    """`board link <a> <b> --type T`: a link that holds nothing up (LINK_VERB_TYPES); a wait is `board wait`."""
    refuse_old_link(args.type)
    known_items(board, [args.a, args.b])
    if not write_edges(board, 'link', f'board link {args.a} {args.b}', [(args.a, args.b, args.type)]):
        print(f'{args.a} -> {args.b}: {args.type} already')
        return 0
    print(f'{args.a} -> {args.b}: {args.type}')
    return 0


def unlink_command(board: Board, args) -> int:
    """`board unlink <a> <b>`: removes the link between a pair, a wait included (its for comment stays as history)."""
    known_items(board, [args.a, args.b])
    edges = board.between(args.a, args.b)
    if not edges:
        raise BoardError(f'{args.a} and {args.b} are not linked')
    write_edges(board, 'unlink', f'board unlink {args.a} {args.b}', removes=edges)  # a parent edge changes by move; an item's wait under the hold rule
    for source, target, kind in edges:
        print(f'{source} no longer waits on {target}' if blocking(kind) else f'{source} -> {target}: unlinked ({kind})')
    return 0


def reopen_command(board: Board, args) -> int:
    """`board reopen <id>...`: not a change request (closed means landed or rejected)."""
    known_items(board, args.ids)
    crs = [item_id for item_id in args.ids if board.by_id[item_id].get('issue_type') == CR_TYPE]
    if crs:
        raise BoardError(f"{', '.join(crs)} is a change request: closed means landed or rejected; a change that still has to land is a new change request (agents board create)")
    gone = [(item_id, cr) for item_id in args.ids if (cr := board.cr_of(item_id)) and cr != item_id and board.by_id.get(cr, {}).get('status') == 'closed']
    if gone:
        raise BoardError(f"{gone[0][0]} is an item of {gone[0][1]}, which is closed (landed or dropped): an open item under it would be reached by no queue; "
                         'file the work again in an open change request (agents board create --parent <change request>). move re-parents only open items')
    superseded = [item_id for item_id in args.ids if superseding(board, item_id)]
    if superseded:
        raise BoardError(f"{', '.join(superseded)} is a superseded ruling: record a revision to put it back in force (agents board ruling revise {superseded[0]})")
    for item_id in args.ids:
        move(board.by_id[item_id], 'reopen', board=board)
        print(f'{item_id}: reopened')
    return 0


def waiter_live(board: Board, w: str, set_aside: set[str] | frozenset[str], deferred: bool = False) -> bool:
    """A record that still waits: open, not deferred (`deferred`: a deferred one too), and not set aside with the call (an item goes with its change request)."""
    unit = board.cr_of(w) or w
    return w not in set_aside and unit not in set_aside and board.is_open(w) and (deferred or (board.by_id[w]['status'] != 'deferred' and board.by_id[unit]['status'] != 'deferred'))


def live_waits(board: Board, item_id: str, setting_aside: set[str] | frozenset[str] = frozenset(), deferred: bool = False) -> list[tuple[str, str]]:
    """(waiter, target) of the live records waiting on a task, item or change request or, for a change request, on one of its items
    (closed ones too: a wait on an item of a CR is met when the CR lands). Records in `setting_aside` (set aside or closed in the
    same call), a milestone (it detaches) and a CR's own items do not count. `deferred`: the deferred waiters count too (a drop's waiter set)."""
    members = [item_id, *(t for t in board.dependents if t != item_id and board.cr_of(t) == item_id)] if board.is_cr(item_id) else [item_id]
    return list(dict.fromkeys((w, member) for member in members for w in board.dependents.get(member, [])
                              if waiter_live(board, w, setting_aside, deferred) and board.cr_of(w) != item_id and board.by_id[w].get('issue_type') != 'milestone'))


def dropped_waits_refusal(board: Board, item_id: str, together: frozenset[str]) -> str | None:
    """Why a close as dropped is refused: a wait is met only by a delivering close (model.md Waits), so no open or deferred record may be left waiting on it."""
    waits = live_waits(board, item_id, together, deferred=True)
    if not waits:
        return None
    return (f"{', '.join(f'{waiter} waits on {target}' for waiter, target in waits)}, and a dropped close never delivers what they wait for; "
            f"unlink them ({'; '.join(dep_fix(waiter, target) for waiter, target in waits)}), wait on the record that keeps the work, or close them in the same call")


def deferred_waiters(board: Board, item_id: str, deferring: set[str] = frozenset()) -> list[str]:
    """What deferring it would hang (board-coordination.md#deferrals-and-environment-facts). Deferred work holds up no live item:
    the live items waiting on it (a milestone's member detaches instead). A deferred question is a parked decision its held items
    still need (decide.md Pre-pass), unless work in progress, in review or at Accept waits on it through open items: that work."""
    if board.by_id.get(item_id, {}).get('issue_type') != 'decision':
        return list(dict.fromkeys(waiter for waiter, _ in live_waits(board, item_id, deferring)))
    in_work, seen, todo = [], set(), list(board.dependents.get(item_id, []))
    while todo:
        w = todo.pop()
        if w in seen or not waiter_live(board, w, deferring):
            continue
        seen.add(w)
        unit = board.cr_of(w) or w  # an item waits with its change request (cr_waits)
        if board.by_id[unit].get('issue_type') != 'decision' and is_in_work_unit(board.by_id[unit]) \
                and unit not in in_work:  # a question in a round is no work: a round defers the questions waiting on it one by one
            in_work.append(unit)
        todo += board.dependents.get(w, []) + ([unit] if unit != w else [])
    return in_work


def deferred_fix(board: Board, item_id: str, waiting: list[str]) -> str:
    if board.by_id.get(item_id, {}).get('issue_type') == 'decision':
        return f"answer {item_id}, or return {', '.join(waiting)} (agents board return <id> \"<why>\") until it is answered"
    return f"defer {' '.join(waiting)} too, or keep {item_id} undeferred and write the wait as a gate (agents board gate create) or a blocks edge"


def defer_command(args) -> int:
    """`board defer <id>... --reason "<why>" [--until <date>]`: set aside, blocked by nothing. No date: someday, only `undefer`
    reopens it; a date only surfaces it as due. A deferral records no condition (a condition on an item or event is a wait)."""
    if args.until and not re.fullmatch(r'\d{4}-\d{2}-\d{2}', args.until):
        raise BoardError(f'--until takes a day, YYYY-MM-DD: {args.until}')
    board = Board.load('status')
    known_items(board, args.ids)
    by = 'user' if may_attend(board) else session_actor(caller())  # a lead or solo session defers for the user; autopilot's deferral is its own
    for item_id in args.ids:
        waiting = deferred_waiters(board, item_id, set(args.ids))
        if waiting:
            raise BoardError(f"{item_id}: {', '.join(waiting)} would hang on it deferred: {deferred_fix(board, item_id, waiting)}")
    for item_id in args.ids:
        move(board.by_id[item_id], 'defer', board=board, fields={DEFERRED_BY: by, REVISIT: args.until})  # --until: a date that only surfaces it
        comment(item_id, f'board defer: {args.reason}')
        print(f'{item_id}: deferred')
    return 0


def undefer_command(args) -> int:
    board = Board.load('status')
    known_items(board, args.ids)
    for item_id in args.ids:
        move(board.by_id[item_id], 'undefer', board=board, fields={DEFERRED_BY: None, REVISIT: None})
        print(f'{item_id}: undeferred')
    return 0


def create_gate(board: Board, blocks: str, reason: str, title: str | None) -> str:
    """bd's gate create, which writes the gate and the wait on `blocks` together: that wait meets edge_rules first (the hold rule on a CR's item);
    bd's output."""
    known_items(board, [blocks])
    edge_rules(board, [(blocks, 'gate', WAIT_LINK)], 'wait', {'gate': 'gate'})
    return bd_checked('gate', 'create', '--type=human', '--blocks', blocks, '--reason', reason, *(['--title', title] if title else []))


def gate_create(args) -> int:
    """`board gate create --blocks <id> --reason "<why>" [--title T] [--for <person>]`: a human gate (bd's await_type human) that holds the
    item up (bd makes the gate and its link); on a shared board `--for` labels it `for:<person>`, whose step it is."""
    if args.for_:
        require_person_on_shared_board(args.for_, 'gate create --for')
    out = create_gate(Board.load(), args.blocks, args.reason, args.title)
    print(re.sub(r'\bbd gate resolve\b', 'agents board gate resolve', out.strip()))  # bd's own "Resolve with:" line names the raw form
    if args.for_:
        created = re.search(r'Created gate (\S+)', out)
        label = FOR_PREFIX + args.for_
        try:
            routed = bool(created) and write_fields(Board.load('ids', [created[1]]), [created[1]], ['--add-label', label]) is None
        except BoardError:
            routed = False
        if not routed:
            raise BoardError(f'the gate stands but is not routed to {args.for_}: agents board bd --raw --yes update <gate id> --add-label {label}')
    return 0


def gate_resolve(args) -> int:
    found = bd_show([args.gate], comments=False)
    if not found or not is_human_gate(found[0]):
        raise BoardError(f'{args.gate}: not a human gate (a gate is a step only a person takes: agents board gate create)')
    move(found[0], 'close', reason=(args.reason or 'gate resolved').ljust(20, '.'), force=True)  # a gate closes forced: its wait is what it ends
    print(f'{args.gate}: resolved')
    return 0


def revise(board: Board, args) -> int:
    caller()
    stub = {'nodes': [{'key': 'item', 'title': 'revision', 'type': 'decision'}]}
    value = ','.join(args.holds) if args.holds else None
    links, types = plan_links(stub)
    _, waits = edge_rules(board, links, 'ruling', types, parse_holds(value) if value is not None else ())
    require_holds_declared(waits, types, value)
    holds = waits['item'][0]
    old = board.by_id.get(args.old)
    if old is None or old.get('issue_type') != 'decision':
        raise BoardError(f'{args.old}: unknown or not a decision')
    if old['status'] == 'open':
        raise BoardError(f"{args.old}: {old['status']}, not yet a ruling; amend the question instead")
    if old['status'] == 'closed':
        if superseding(board, args.old):
            raise BoardError(f"{args.old}: closed and already superseded, not a planned ruling")
        if missing_sections(str(old.get('description') or '')):
            raise BoardError(f"{args.old}: closed question, not a planned ruling")
    parent = args.parent or board.parent.get(args.old)
    labels = args.label if args.label \
        else [label for label in old.get('labels') or [] if label.startswith('topic:')]
    new = create_ruling_revision(board, args.old, args.title, read_text_arg(args.body_file), holds=holds,
                                 parent=parent, labels=labels, priority=args.priority,
                                 external_ref=args.external_ref, partial=args.partial, dry_run=args.dry_run)
    if args.dry_run:
        print('valid')
        return 0
    print(new)
    return 0


def release(board: Board, args) -> int:
    """Releases the decided rulings, supersedes the records they revise (a decided one among the ids is not released first), then
    closes the questions they answer.
    Resumable: a ruling already released and a question already closed are done; a failed revise supersede of an
    already in-force ruling is retried (its revise link stays until it succeeds)."""
    actor = caller()
    rulings = require_open(board, args.ids)
    # A decided record another ruling of this release revises is a replaced draft: it never comes into force, its reviser's
    # release supersedes it (r9-q33).
    drafts = {old for issue in rulings for old in board.revises(issue['id']) if old in args.ids and board.by_id.get(old, {}).get('status') == 'decided'}
    problems, taking = [], []  # taking: a gone session's hold on a record about to be superseded, taken first
    for issue in rulings:
        if issue['id'] in drafts:
            continue
        if issue.get('issue_type') != 'decision':
            problems.append(f"{issue['id']}: not a decision")
        elif issue['status'] not in ('decided', 'in_force'):
            problems.append(f"{issue['id']}: {issue['status']}, not decided")
        blocking = [b for b in board.release_holds(issue['id']) if b not in args.ids]
        if blocking and issue['status'] == 'decided':
            revisers = set(board.revised_by(issue['id']))
            named = ', '.join(f"{b} ({'revises it: release them together, or close the revision' if b in revisers else board.by_id.get(b, {}).get('status', 'not found')})"
                              for b in blocking)
            problems.append(f"{issue['id']}: waits on {named}")
        if issue['status'] in ('decided', 'in_force'):  # every record it revises is superseded below: a live session's hold refuses first
            for old in board.revises(issue['id']):
                if (refusal := hold_refusal(board, board.by_id.get(old, {}), actor)) == 'gone':
                    taking.append(old)
                elif refusal:
                    problems.append(f'{old}: {refusal}')
    closes = []
    for question, records in args.closes:
        issue = board.by_id.get(question)
        if issue is None:
            problems.append(f'{question}: unknown')
        elif issue['status'] == 'closed':
            print(f'{question}: already closed')
            continue
        elif issue.get('issue_type') != 'decision' or issue['status'] != 'open':
            problems.append(f"{question}: {issue['status']} {issue.get('issue_type')}, not an open question")
        elif issue.get('assignee') and session_actor(issue['assignee']) != session_actor(actor):
            problems.append(f"{question}: held by {issue['assignee']}; hand it off before closing it")
        unknown = [record for record in records if record not in args.ids]
        if unknown:
            problems.append(f"{question}: answered by {', '.join(unknown)}, which this call does not release")
        closes.append((question, records))
    if problems:
        raise BoardError('release refused:\n  ' + '\n  '.join(problems))

    pending = [issue for issue in rulings if issue['status'] == 'decided' and issue['id'] not in drafts]
    if pending:
        lint = json.loads(bd_checked('lint', *(issue['id'] for issue in pending), '--json') or '{}')
        unlinted = [f"{result['id']}: missing {', '.join(result.get('missing') or [])}"
                    for result in lint.get('results') or [] if result.get('missing')]
        if unlinted:
            raise BoardError('release refused, record text fails bd lint (write the record first):\n  ' + '\n  '.join(unlinted))
        # The items an in-force ruling changes wait on it; planning closes it and they are ready.
        for issue in pending:  # one compare-and-set each; a stop leaves the rest decided, and a rerun releases them. The snapshot takes the new status: the waits below read it
            move(issue, 'ruling release', board=board)
    for old in taking:
        take(board, argparse.Namespace(ids=[old], force=None, agreed=None))
    failed = []
    for issue in rulings:
        if issue['id'] in drafts:
            continue  # superseded below by the ruling that revises it
        print(f"{'released' if issue in pending else 'already released'} {issue['id']}: {issue.get('title', '')}")
        metadata = issue.get('metadata') if isinstance(issue.get('metadata'), dict) else {}
        for old in board.revises(issue['id']):
            failed += supersede_chain(board, old, issue['id'], metadata.get(REVISES_RULE), actor, {issue['id']})
    left = close_answered(board, closes, set(args.ids))
    return 1 if failed or left else 0


def close_answered(board: Board, closes: list[tuple[str, list[str]]], released: set[str]) -> list[str]:
    """Closes each answered question once every unsettled blocker is a ruling of this release or a question closed
    before it here (dependency order); forces only past those and in-force rulings. Returns the questions left open."""
    closed: set[str] = set()
    pending = list(closes)
    while pending:
        progress = False
        for question, records in list(pending):
            blockers = board.open_blockers(question)
            if any(b not in released and b not in closed for b in board.unsettled_blockers(question)):
                continue
            pending.remove((question, records))
            result = move(board.by_id[question], 'close', board=board, reason=f"Answered by released {', '.join(records)}", force=bool(blockers), check=False,
                          outcome='superseded')
            if result.returncode != 0:
                print(f'{question}: not closed: {(result.stderr or result.stdout).strip()}', file=sys.stderr)
                continue
            closed.add(question)
            progress = True
            print(f"closed {question}: answered by released {', '.join(records)}")
        if not progress:
            break
    for question, _ in pending:
        others = [b for b in board.unsettled_blockers(question) if b not in released and b not in closed]
        print(f"{question}: left open, blocked by {', '.join(others) or 'a question not closed'}", file=sys.stderr)
    return [question for question, _ in closes if question not in closed]


def rule_of(issue: dict) -> str | None:
    metadata = issue.get('metadata') if isinstance(issue.get('metadata'), dict) else {}
    return metadata.get(REVISES_RULE)


def supersede_chain(board: Board, old: str, new: str, rule: str | None, actor: str, seen: set[str]) -> list[str]:
    """supersede_pair, then follows the chain: a record replaced whole that itself revises another leaves that one to
    `new` too, with the replaced record's own rule, through unreleased records to the first in-force one.
    Returns the records that could not be superseded."""
    if old in seen:
        return []
    seen.add(old)
    try:
        failed = supersede_pair(board, old, new, rule, actor)
    except BoardError as error:
        print(f"{old}: not superseded by {new}: {error}; finish with agents board ruling supersede {old} --with {new}"
              + (f' --partial {shlex.quote(rule)}' if rule is not None else ''), file=sys.stderr)
        return [old]
    if rule is not None:
        return failed
    for earlier in board.revises(old):
        failed += supersede_chain(board, earlier, new, rule_of(board.by_id[old]), actor, seen)
    return failed


def carry_revisions(board: Board, old: str, new: str, closing: frozenset[str] = frozenset()) -> tuple[list[Edge], list[Edge]]:
    """The edges that move the revisions `old` still has pending to `new` (which replaces it whole), and the
    rule's metadata write first: a rerun after a partial failure repeats the same write. `closing`: the other records closing
    with `new` (their revision links to it are no revision of its own). Returns (links, removes) for write_edges."""
    targets = [t for t in board.revises(old) if t != new]
    if not targets:
        return [], []
    own = [t for t in board.revises(new) if t != old and t not in closing]
    rule, new_rule = rule_of(board.by_id[old]), rule_of(board.by_id[new])
    if own and (set(own) != set(targets) or rule != new_rule):
        raise BoardError(f"{new} already revises {', '.join(own)} and {old} revises {', '.join(targets)}; bd keeps one "
                         'revision rule per record: finish the revisions one record at a time')
    if rule is not None and rule != new_rule:
        put_meta(board.by_id[new], **{REVISES_RULE: rule})
    links, removes = [], []
    for target in targets:
        removes.append((old, target, REVISES))
        if target not in own:
            removes += [(a, b, kind) for a, b, kind in board.between(new, target) if kind != 'parent-child']
            links.append((new, target, REVISES))
    return links, removes


def supersede_pair(board: Board, old: str, new: str, rule: str | None, actor: str, carry: bool = False,
                   closing: frozenset[str] = frozenset()) -> list[str]:
    """Supersedes old by new, wholly or (rule not None) one rule; the items that could not wait on the new record. `carry`: a
    whole replacement takes over the revisions the old record still has pending (`closing`: see carry_revisions)."""
    # bd allows one edge per pair: drop an existing link between the two records (a revise link included) first.
    partial = [(old, new, 'supersedes')] if rule is not None else []
    removes = [(a, b, kind) for a, b, kind in board.between(old, new) if kind != 'parent-child' and (a, b, kind) not in partial]
    carried, uncarried = carry_revisions(board, old, new, closing) if carry and rule is None else ([], [])
    write_edges(board, 'ruling', f'board ruling supersede {old} --with {new}', [*partial, *carried], [*removes, *uncarried])
    if rule is not None:
        if rule:
            comment(old, f'board ruling supersede: rule "{rule}" superseded by {new}.')
        print(f"{old}: one rule{f' ({rule})' if rule else ''} superseded by {new}")
        return []
    # The new record restates the whole rule: the old record's open items wait for its planning.
    items = sorted(i for i in board.related.get(old, set()) | set(board.dependents.get(old, []))
                   if i != new and board.is_open(i) and not (board.by_id[i].get('issue_type') == 'decision' and board.by_id[i]['status'] == 'in_force')  # an in-force ruling waits only for its planning
                   and all(kind == 'relates-to' for _, _, kind in board.between(i, new)))
    failed = wait_items(board, items, new, f'supersedes {old}; replan against it', actor)
    move(board.by_id[old], 'supersede', board=board, via='supersede', reason=new)
    print(f"superseded {old} by {new}; blocked {', '.join(i for i in items if i not in failed) or 'none'}"
          + (f"; revision of {', '.join(board.revises(old))} now pending on {new}" if carried else ''))
    return failed


def supersede(board: Board, args) -> int:
    actor = caller()
    if args.old not in board.by_id:
        raise BoardError(f'unknown {args.old}')
    if args.partial is None:
        require_open(board, [args.new])  # a full replacement blocks items on the new record until it is planned
    elif args.new not in board.by_id:
        raise BoardError(f'unknown {args.new}')  # a closed record still supersedes one rule: the edge is the record
    return 1 if supersede_pair(board, args.old, args.new, args.partial, actor, carry=True) else 0


def superseding(board: Board, item_id: str) -> list[str]:
    """The records `item_id` is superseded by: its outgoing `supersedes` links (bd supersede and a partial supersede make them)."""
    return [other for other, kind, outgoing in board.edges.get(item_id, []) if outgoing and kind == 'supersedes']


def normalized_remote(url: str) -> str:
    """The `git+ssh://` form bd's git remotes need; scp and https forms of one repository become one url. `git+...` and
    Dolt's own schemes stay as written, a local path becomes `git+file://`."""
    url = url.strip()
    if url.startswith('/'):
        return f'git+file://{url}'
    if url.startswith('file://'):
        return f'git+{url}'
    if url.startswith('ssh://'):
        return f'git+{url}'
    https = re.fullmatch(r'https?://(?:[^@/]+@)?([^/]+)/(.+?)(?:\.git)?/?', url)
    if https:
        return f'git+ssh://git@{https.group(1)}/{https.group(2)}.git'
    scp = re.fullmatch(r'(?:([^@/:]+)@)?([^/:]+):(?!//)(.+)', url)
    if scp:
        return f"git+ssh://{scp.group(1) or 'git'}@{scp.group(2)}/{scp.group(3)}"
    return url


def project_remote() -> str:
    result = subprocess.run(['git', 'remote', 'get-url', 'origin'], capture_output=True, text=True)
    if result.returncode != 0 or not result.stdout.strip():
        raise BoardError("this project's repository has no origin remote: name the url")
    return result.stdout.strip()


def ask_person() -> str:
    """The person, asked for when unset at a terminal. Their one choice of level is the git command itself."""
    who = person()
    if who:
        return who
    if not sys.stdin.isatty():
        raise BoardError(PERSON_HELP)
    who = input('Your name for queue labels (queue:<name>), set in global git config: ').strip()
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', who):
        raise BoardError(f'{who!r} does not fit a label; {PERSON_HELP}')
    subprocess.run(['git', 'config', '--global', 'agents.person', who], check=True)
    return who


def set_config(pairs) -> None:
    for key, value in pairs:
        bd_checked('config', 'set', key, value)


def send_first(remote: str, url: str, known: bool) -> None:
    """Sync, or the first push a sync can't do (it pulls first, and the remote has nothing yet)."""
    result = bd('sync', '--remote', remote)
    if result.returncode == 0:
        return
    if known:
        raise BoardError(f'sync failed: {last_line(result.stderr + result.stdout)}')
    pushed = bd('dolt', 'push', '--remote', remote)
    output = pushed.stderr + pushed.stdout
    if 'has no branches' in output:
        raise BoardError(f"{url} is a completely empty repository and can't take a first push: commit something to it first, then rerun")
    if pushed.returncode != 0:
        raise BoardError(f'first push failed: {last_line(output)}')


def readable_remote(url: str) -> list[str] | None:
    """The repository's refs before anything is sent to it; refuses one that can't be read or can't take a first push."""
    refs, error = remote_refs(url)
    if refs is None and url.startswith('git+'):
        raise BoardError(f'cannot read {url}: {error}')
    if refs == []:
        raise BoardError(f"{url} is a completely empty repository and can't take a first push: commit something to it first, then rerun")
    return refs


def default_prefix(root: Path) -> str:
    """The project's name: its origin repository's, else its folder's (a worktree folder is often named after a branch)."""
    origin = subprocess.run(['git', 'remote', 'get-url', 'origin'], capture_output=True, text=True).stdout.strip()
    name = re.sub(r'\.git$', '', origin.rstrip('/').rsplit('/', 1)[-1].rsplit(':', 1)[-1]) if origin else root.name
    return re.sub(r'[^a-z0-9]+', '-', name.lower()).strip('-') or 'board'


def project_settings() -> dict[str, str]:
    """The board's project settings (SETTINGS) by name, '' when unset, in one bd read."""
    found = json.loads(bd_checked('config', 'list', '--json') or '{}')
    return {name: str(found.get(key) or '') if isinstance(found, dict) else '' for name, key in SETTINGS.items()}


def current_setting(key: str) -> str:
    """bd's value for a setting, '' when unset; a config.yaml key reads as bd's default when the file leaves it out."""
    found = json.loads(bd_checked('config', 'get', '--json', key) or '{}')
    return str(found.get('value') or '') if isinstance(found, dict) else ''


def hiding_excludes() -> list[str]:
    """The .git/info/exclude lines matching tracked project files: init's patterns (1.3 adds `*.db`) would hide new ones."""
    exclude = git_exclude()
    if not exclude.is_file():
        return []
    found = []
    for pattern in exclude.read_text(encoding='utf-8').splitlines():
        if not pattern.strip() or pattern.startswith(('#', '!')):
            continue
        tracked = subprocess.run(['git', 'ls-files', '-c', '-i', '-x', pattern], capture_output=True, text=True).stdout.split('\n')
        tracked = [path for path in tracked if path]
        if tracked:
            more = f' and {len(tracked) - 5} more' if len(tracked) > 5 else ''
            found.append(f"{exclude}: `{pattern}` matches tracked project files ({', '.join(tracked[:5])}{more}); "
                         'remove the line unless new files like them should stay hidden')
    return found


KEPT_EMBEDDED = '.beads.before-server-'  # an embedded board's folder, kept beside the server board made from it


def exported() -> list[dict]:
    """Every row of `bd export` (issues, then the other record kinds)."""
    return [json.loads(row) for row in bd_checked('export').splitlines() if row.strip()]


def to_server(beads: Path) -> None:
    """`board setup --server` on an embedded board: bd's backup into a new server board, restored whole (Dolt history
    included), the old folder kept beside it. A failure removes what it made and puts the old folder back."""
    root, exclude = beads.parent, git_exclude()
    database = json.loads((beads / 'metadata.json').read_text(encoding='utf-8')).get('dolt_database') or default_prefix(root)
    before = {row['id'] for row in exported()}
    saved = exclude.read_bytes() if exclude.exists() else None
    kept = root / f"{KEPT_EMBEDDED}{utcnow().strftime('%Y%m%d-%H%M%S')}"
    with tempfile.TemporaryDirectory(prefix='board-to-server-') as store:
        bd_checked('backup', 'init', store)
        try:
            bd_checked('backup', 'sync')
        except BaseException:
            bd('backup', 'remove')  # the embedded board keeps no registration of a backup that never came to be
            raise
        beads.rename(kept)
        try:
            bd_checked('init', '--server', '--stealth', '--prefix', database, '--skip-hooks', '--skip-agents', stdin='')
            bd_checked('backup', 'restore', '--force', store)
            bd_checked('backup', 'remove')  # the restore registers the temporary backup for future syncs
            lost = before - {row['id'] for row in exported()}
            if lost:
                raise BoardError(f"the server board lacks {', '.join(sorted(lost))}; nothing converted")
        except BaseException:
            stop_server(root)
            shutil.rmtree(beads, ignore_errors=True)
            kept.rename(beads)
            if saved is not None:
                exclude.write_bytes(saved)
            bd('backup', 'remove')
            raise
    exclude_line(exclude, f'/{KEPT_EMBEDDED}*/', "board setup --server: an embedded board's old folder")
    print(f'converted the board to server mode, {len(before)} items; the embedded board is kept in {kept}')


def project_pairs(args) -> list[tuple[str, str]]:
    """Validate the project settings board setup was given before anything changes (q223, q238)."""
    pairs = []
    for name in SETTINGS:
        value = getattr(args, name, None)
        if value is None:
            continue
        value = value.strip()
        if not value:
            raise BoardError(f'--{name} is empty')
        if name == 'target' and (git(Path.cwd(), 'check-ref-format', '--branch', value, check=False).returncode != 0
                                 or git(Path.cwd(), 'rev-parse', '--verify', '-q', f'refs/heads/{value}', check=False).returncode != 0):
            raise BoardError(f'--target {value!r} is not a local branch of this repository')
        if name in ('look', 'view') and value not in {'look': LOOKS, 'view': VIEWS}[name]:
            raise BoardError(f"--{name} {value!r} is not one of {', '.join({'look': LOOKS, 'view': VIEWS}[name])}")
        if name in ('setup', 'checks'):
            first = shlex.split(value)[0] if value else ''
            resolved = subprocess.run(['/bin/sh', '-c', 'command -v "$1"', 'board', first], capture_output=True, text=True)
            if resolved.returncode != 0:
                if '/' not in first and (Path.cwd() / first).is_file():
                    raise BoardError(f'--{name}: {first} cannot be resolved by /bin/sh; use ./{first}')
                raise BoardError(f'--{name}: {first} cannot be resolved by /bin/sh')
        pairs.append((SETTINGS[name], value))
    return pairs


def own_value_lines(name: str, default: str) -> list[str]:
    """After a switch of the project's `look` or `view` (r10-q52): the open change requests that keep their own value, each with
    the line of its text that gives the reason (the first one naming the setting), for the person to clear the ones they
    disagree with. Best effort: the setting is set either way."""
    try:
        crs = [i for i in Board.load('status').issues if i.get('issue_type') == CR_TYPE and meta(i).get(name)]
    except (BoardError, ValueError, subprocess.SubprocessError):
        return [f'(the change requests keeping their own {name} could not be listed: agents board bd list --json)']
    if not crs:
        return []
    word = re.compile(rf'\b{name}\b', re.IGNORECASE)

    def reason(issue: dict) -> str:
        text = '\n'.join(str(issue.get(field) or '') for field in ('description', 'design', 'notes'))
        found = next((line.strip() for line in re.split(r'(?<=[.!?])\s+|\n', text) if word.search(line)), None)
        return found[:160] if found else 'no reason in its text'

    return [f'  {len(crs)} open change request(s) keep their own {name}; clear one you disagree with: {raw_form("update <id> --unset-metadata " + name)}',
            *(f"    {i['id']}  {meta(i)[name]}{' (equals the new default)' if meta(i)[name] == default else ''}: {reason(i)}" for i in sorted(crs, key=lambda i: i['id']))]


def setup(args) -> int:
    """Safe to repeat (r38-q218, server default): no board → `bd init --server --stealth` (--embedded opts out), then the
    settings. An existing board is never re-created: `--server` converts an embedded one in place (`to_server`), a missing
    setting is set and a differing one reset, each printed with its old and new value. A shared board also gets the shared
    settings, and its travelling ones reach the others by sync."""
    toplevel = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True, text=True)
    if toplevel.returncode != 0:
        raise BoardError('run agents board setup inside the project repository')
    os.chdir(toplevel.stdout.strip())
    wanted = project_pairs(args)
    beads = beads_dir()
    created = beads is None
    if beads is None:
        prefix = args.prefix or default_prefix(Path.cwd())
        if not re.fullmatch(r'[a-z0-9][a-z0-9-]*', prefix):
            raise BoardError(f'{prefix!r} does not fit an id prefix: lowercase letters, digits and dashes')
        bd_checked('init', *([] if args.embedded else ['--server']), '--stealth', '--prefix', prefix, '--skip-hooks', '--skip-agents', stdin='')
        beads = Path.cwd() / '.beads'
        print(f"created the board {prefix} ({'embedded' if args.embedded else 'server'} mode) in {beads}")
    else:
        mode = json.loads((beads / 'metadata.json').read_text(encoding='utf-8')).get('dolt_mode') or 'embedded'
        if args.embedded and mode != 'embedded':
            raise BoardError(f'this board is {mode}; --embedded applies to a new board only')
        if args.prefix:
            raise BoardError('this project already has a board: drop --prefix')
        os.chdir(beads.parent)
        if args.server and mode == 'embedded':
            to_server(beads)
        else:
            print(f'this project already has a board ({mode} mode); applying the current settings')
    server = json.loads((beads / 'metadata.json').read_text(encoding='utf-8')).get('dolt_mode') == 'server'
    changed = []
    for key, value in (*LOCAL_CONFIG, *TRAVELLING_CONFIG, *(SERVER_CONFIG if server else ()), *(SHARED_CONFIG if read_mark(beads) else ()),
                       *(((MODEL_KEY, MODEL),) if created else ()), *wanted):  # an existing board gets its marker from board-migrate, never from a rerun
        old = current_setting(key)
        if old != value:
            bd_checked('config', 'set', key, value)
            changed.append(key)
            print(f"{key}: {old or '(unset)'} -> {value}", flush=True)  # printed as applied: a later failure leaves it said
            if key in (SETTINGS['look'], SETTINGS['view']):
                for line in own_value_lines(key.rsplit('.', 1)[1], value):
                    print(line, flush=True)
    if changed:
        committed = bd('dolt', 'commit', '-m', 'board setup')  # in server mode an uncommitted status.custom stops the first sync
        output = committed.stdout + committed.stderr
        if committed.returncode != 0 and 'nothing to commit' not in output.lower():
            raise BoardError(f'the settings are set but not committed: {last_line(output)}; rerun agents board setup')
    else:
        print('settings up to date')
    for warning in hiding_excludes():
        print(warning)
    return 0


def share(args) -> int:
    """Safe to repeat. Only the first push asks: without --yes it says what goes out and changes nothing. The sharer's
    labelling runs once per board, marked in the database: a second person's share must not take the items other people
    left unrouted."""
    beads = beads_dir()
    if beads is None:
        raise BoardError('no board here: agents board setup creates one to share, or agents board join joins one')
    if json.loads((beads / 'metadata.json').read_text(encoding='utf-8')).get('dolt_mode') != 'server':
        raise BoardError('a shared board needs server mode, and this board is embedded: agents board setup --server converts it in place '
                         '(pause the sessions writing to it first)')
    os.chdir(beads.parent)
    remotes = bd_remotes()
    if remotes:
        remote = 'origin' if 'origin' in remotes else sorted(remotes)[0]
        url = remotes[remote]
        if args.url and normalized_remote(args.url) != url:
            raise BoardError(f'this board already syncs with {url} ({remote}); moving it: agents board relocate <url> (beads-setup.md#history)')
    else:
        remote, url = 'origin', normalized_remote(args.url or project_remote())
    known = remote in remotes and remote_branches(remote) > 0  # the remote already holds this board
    if not known:
        readable_remote(url)
        if not args.yes:
            print(f'agents board share sends the whole board to {url}: every item, comment and history entry, git emails included. '
                  f"Nothing has changed yet. To share, rerun: agents board share {args.url + ' ' if args.url else ''}--yes")
            return 1
    who = ask_person()
    if remote not in remotes:
        bd_checked('dolt', 'remote', 'add', remote, url, '--allow-git-origin')
    try:
        send_first(remote, url, known)
    except BoardError:
        if remote not in remotes:  # an unshared board keeps no remote it never pushed to
            bd('dolt', 'remote', 'remove', remote)
        raise
    write_mark(beads, remote)
    set_config((*LOCAL_CONFIG, *SERVER_CONFIG, *SHARED_CONFIG, *TRAVELLING_CONFIG))
    labelled = 0
    if not config_value(SHARED_BY):
        # Closed items too: an open child takes its queue from a closed parent.
        issues = exported()
        top = [issue['id'] for issue in issues if issue.get('_type', 'issue') == 'issue' and not queue_labels(issue.get('labels') or [])
               and not any(dep.get('type') == 'parent-child' for dep in issue.get('dependencies') or [])]
        for start in range(0, len(top), 200):
            bd_checked('label', 'add', *top[start:start + 200], QUEUE_PREFIX + who)
        labelled = len(top)
        bd_checked('config', 'set', SHARED_BY, who)
    bd('dolt', 'commit', '-m', f'board shared by {who}')  # nothing to commit on a repeat
    send_first(remote, url, True)
    print(f'shared with {url}; {labelled} top-level items labelled {QUEUE_PREFIX}{who}. Others join with: agents board join {url}')
    return 0


def git_exclude(root: Path | None = None) -> Path:
    path = subprocess.run(['git', 'rev-parse', '--path-format=absolute', '--git-path', 'info/exclude'], capture_output=True, text=True, cwd=root)
    return Path(path.stdout.strip())


def stop_server(root: Path) -> None:
    if (root / '.beads' / 'dolt-server.pid').exists():
        subprocess.run(['bd', 'dolt', 'stop'], cwd=root, capture_output=True, env=bd_env(), stdin=subprocess.DEVNULL)


def fresh_join(url: str) -> None:
    """Clones the board at url into this folder's new .beads. A failure removes only what it made (the new .beads, the
    gate lock, init's exclude lines) and stops the server it started, so a rerun works."""
    root, exclude = Path.cwd(), git_exclude()
    before = {path.name for path in root.iterdir() if path.name.startswith('.beads')}
    saved = exclude.read_bytes() if exclude.exists() else None
    try:
        # The prefix only names the local database: items keep the board's own, which comes with the clone.
        database = re.sub(r'[^a-z0-9]+', '_', Path(url.rstrip('/')).stem.lower()).strip('_') or 'board'
        bd_checked('init', '--server', '--stealth', '--remote', url, '--prefix', database, '--skip-hooks', '--skip-agents', stdin='')
        if not remote_branches('origin'):  # bd starts an empty board when the repository holds none
            raise BoardError(f"no board data at {url}: name the board's address: agents board join <url>")
        moved = config_value(MOVED)
        if moved:
            raise BoardError(f'the board at {url} moved to {moved}: agents board join {moved}')
        set_config((*LOCAL_CONFIG, *SERVER_CONFIG, *SHARED_CONFIG))
        bd_checked('dolt', 'commit', '-m', 'board config')
        write_mark(root / '.beads', 'origin')
    except BaseException:
        stop_server(root)
        for path in root.iterdir():
            if path.name.startswith('.beads') and path.name not in before:
                shutil.rmtree(path) if path.is_dir() and not path.is_symlink() else path.unlink()
        if saved is None:
            exclude.unlink(missing_ok=True)
        else:
            exclude.write_bytes(saved)
        raise


def join(args) -> int:
    """Safe to repeat: an existing board stays as it is, unless it carries a moved note: then it rejoins."""
    toplevel = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True, text=True)
    if toplevel.returncode != 0:
        raise BoardError('run agents board join inside the project repository')
    os.chdir(toplevel.stdout.strip())
    beads = beads_dir()
    if beads is not None:
        mark = read_mark(beads)
        sharing = Shared(beads, mark['remote']) if mark else None
        if sharing:
            sharing.check_moved()
        if sharing is None or not sharing.moved():
            print(f"this project already has a board ({'shared' if mark else 'not shared: agents board share shares it'}); nothing to do")
        else:
            rejoin(sharing, normalized_remote(args.url) if args.url else sharing.moved())
    else:
        ask_person()
        url = normalized_remote(args.url or project_remote())
        fresh_join(url)
        print(f'joined {url}. Items go to {QUEUE_PREFIX}{person()}; a lead routes work to you (agents board route).')
    role = subprocess.run(['git', 'config', '--get', 'beads.role'], capture_output=True, text=True)
    if not role.stdout.strip():
        subprocess.run(['git', 'config', 'beads.role', 'maintainer'], check=True)
    return 0


KEPT = '.beads.before-move-'  # a rejoined board's old folder, kept beside the new one


def rejoin(sharing: Shared, url: str) -> None:
    """A moved board: keep the old folder as a copy, join the new board, list what the new one lacks. A failed join puts
    the old folder back."""
    root, beads = sharing.root, sharing.beads
    with sharing.hold_wait():
        old = exported()
        stop_server(root)
        kept = root / f"{KEPT}{utcnow().strftime('%Y%m%d-%H%M%S')}"
        beads.rename(kept)
        try:
            fresh_join(url)
        except BaseException:
            kept.rename(beads)
            raise
    exclude_line(git_exclude(), f'/{KEPT}*/', "board join: a moved board's old folder")
    (kept / 'board-export.jsonl').write_text(''.join(json.dumps(row) + '\n' for row in old), encoding='utf-8')
    present = {row['id'] for row in exported()}
    missing = [row for row in old if row.get('_type', 'issue') == 'issue' and row['id'] not in present]
    print(f'joined {url}; the board before the move is kept in {kept}.')
    if missing:
        path = kept / 'missing.jsonl'
        path.write_text(''.join(json.dumps(row) + '\n' for row in missing), encoding='utf-8')
        print(f'{len(missing)} items the new board lacks (written after the move): ' + ', '.join(row['id'] for row in missing))
        print(f'Bring them over: {raw_form("import " + str(path))}')
    else:
        print('the new board holds every item of the old one')


def move_board(args) -> int:
    """board relocate <url>: the note on the old board, then flatten, switch the remote and push (beads-setup.md#history). The
    note goes out before the flatten and is removed from the local copy first: it travels with the data and would say the
    new board moved too."""
    if shared is None:
        raise BoardError('agents board relocate moves a shared board; this one is not shared')
    if not may_attend():
        raise BoardError("only lead and solo sessions, or a person's terminal, move a board")
    if shared.moved():
        raise BoardError(moved_refusal(shared.moved()))
    url = normalized_remote(args.url)
    os.chdir(shared.root)
    old = bd_remotes().get(shared.remote)
    if old == url:
        raise BoardError(f'this board already syncs with {url}')
    refs = readable_remote(url)
    if refs and 'refs/dolt/data' in refs:
        raise BoardError(f'{url} already holds board data: name a fresh repository')
    with shared.hold_wait():
        bd('dolt', 'commit', '-m', 'before the move')  # nothing to commit when the wait just sent
        sent = bd('sync', '--remote', shared.remote)
        if sent.returncode != 0:
            raise BoardError(f'the sync before the move failed, nothing moved: {last_line(sent.stderr + sent.stdout)}')
        bd_checked('config', 'set', MOVED, url)
        bd_checked('dolt', 'commit', '-m', f'board moved to {url}')
        sent = bd('sync', '--remote', shared.remote)
        if sent.returncode != 0:
            bd('config', 'unset', MOVED)
            bd('dolt', 'commit', '-m', 'board relocate abandoned')
            raise BoardError(f'sending the moved note failed, nothing moved: {last_line(sent.stderr + sent.stdout)}')
        bd_checked('config', 'unset', MOVED)
        bd_checked('dolt', 'commit', '-m', 'board moved: the note stays on the old board')
        bd_checked('flatten', '--force')
        bd_checked('dolt', 'remote', 'remove', shared.remote)
        bd_checked('dolt', 'remote', 'add', shared.remote, url, '--allow-git-origin')
        pushed = bd('dolt', 'push', '--remote', shared.remote)
        if pushed.returncode != 0:
            raise BoardError(f'the old board says it moved to {url}, but the push there failed: {last_line(pushed.stderr + pushed.stdout)}. '
                             f'Fix the access, then: {raw_form("dolt push --remote " + shared.remote)}')
        for name in ('pulled', 'unsent'):
            (shared.dir / name).unlink(missing_ok=True)
        shared.update_state(moved=None, kind=None, failures=0, detail=None, last_failure=None)
    print(f'moved to {url}. The old repository keeps its data and tells the others to run agents board join {url}. '
          f'Once everyone rejoined, delete it: git push {git_url(old or "<old url>")} --delete refs/dolt/data refs/heads/__dolt_remote_info__')
    return 0


PERSON_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]*')


def attended_issues(board: Board | None, args, command: str) -> list[dict]:
    """The checks route and send share: a shared board, an attended session, a person, known ids (`board` holds the named items; None
    checks the rest before the read)."""
    if shared is None:
        raise BoardError(f'board {command}: this board is not shared, so no queues')
    if not may_attend():
        raise BoardError(f"only lead and solo sessions, or a person's terminal, {command} items; ask your lead")
    if not PERSON_NAME.fullmatch(args.person):
        raise BoardError(f'{args.person!r} does not fit a label')
    if board is None:
        return []
    found = {issue['id']: issue for issue in board.issues}
    missing = [item_id for item_id in args.ids if item_id not in found]
    if missing:
        raise BoardError(f"unknown: {', '.join(missing)}")
    return [found[item_id] for item_id in args.ids]


def route(board: Board, args) -> int:
    """Into a person's queue, replacing the queue label; an item filed for someone also leaves the inbox: its `for:` goes."""
    target = QUEUE_PREFIX + args.person
    for issue in attended_issues(board, args, 'route'):
        labels = issue.get('labels') or []
        filed = [label for label in labels if label.startswith(FOR_PREFIX)]
        flags = [flag for label in queue_labels(labels) + filed if label != target for flag in ('--remove-label', label)]
        flags += ['--add-label', target] if target not in labels else []
        if flags:
            write_fields(board, [issue['id']], flags, 'route')
        print(f"routed {issue['id']} to {args.person}'s queue" + (' (out of the inbox)' if filed else ''))
    return 0


def send(board: Board, args) -> int:
    """Into a person's inbox: `for:<person>` and no queue label, so the item is unrouted until their lead
    routes it. Only a top-level item: one with a parent would still take the parent's queue."""
    target = FOR_PREFIX + args.person
    issues = attended_issues(board, args, 'send')
    for issue in issues:
        inherited = sorted({queue for parent in board.parents.get(issue['id'], []) for queue in board.queues(parent)})
        if inherited:
            raise BoardError(f"{issue['id']} takes its queue from its parent ({', '.join(inherited)}), so it can't sit in an inbox: "
                             f"agents board route {args.person} {issue['id']}, or remove the parent link first")
    for issue in issues:
        labels = issue.get('labels') or []
        flags = [flag for label in labels if (label.startswith(QUEUE_PREFIX) or label.startswith(FOR_PREFIX)) and label != target
                 for flag in ('--remove-label', label)]
        flags += ['--add-label', target] if target not in labels else []
        # Every send stamps the time, a pass-on and a repeat included: the inbox shows how long an item waited there (r38-q217).
        write_fields(board, [issue['id']], [*flags, '--set-metadata', f"{SENT_AT}={stamp()}"], 'send')
        print(f"sent {issue['id']} to {args.person}'s inbox")
    return 0


def read_text_arg(path: str) -> str:
    """The text of a `--…-file` argument; `-` reads stdin."""
    try:
        return sys.stdin.read() if path == '-' else Path(path).read_text(encoding='utf-8')
    except (OSError, UnicodeDecodeError) as error:
        raise BoardError(f'cannot read {path}: {error}') from None


def flag_node(args) -> tuple[dict, list[dict]]:
    """The one plan node `board create`'s flags describe, and the plan edges its `--holds` make. bd's graph node fields
    were verified against a board: acceptance_criteria, labels, metadata, priority, parent_id (an existing parent: bd copies
    none of its labels, so they are copied here as `create --parent` did), deps ({target, type}: this item depends on target)."""
    title = args.title or args.positional_title
    if not title or (args.title and args.positional_title):
        raise BoardError('name the item once: agents board create "<title>" or --title <title>')
    node: dict = {'key': 'item', 'title': title, 'type': args.type or 'task'}
    if args.priority is not None:
        node['priority'] = args.priority
    for flag, key in (('description_file', 'description'), ('design_file', 'design'), ('acceptance_file', 'acceptance_criteria')):
        if getattr(args, flag) is not None:
            node[key] = read_text_arg(getattr(args, flag))
    labels = args.label
    if args.parent:
        parents = bd_show([args.parent], comments=False)
        if not parents:
            raise BoardError(f'unknown parent {args.parent}')
        node['parent_id'] = parents[0]['id']
        labels += [label for label in parents[0].get('labels') or [] if not label.startswith(QUEUE_PREFIX) and label not in labels]
    if labels:
        node['labels'] = labels
    if args.no_commit:
        node[NO_COMMIT] = True
    node.update({name: getattr(args, name) for name in CR_SETTINGS if getattr(args, name)})
    edges, deps, waits_on = [], [], []
    for dep in args.deps:
        kind, sep, target = dep.partition(':')
        kind, target = (kind, target) if sep else ('waits-on', dep)
        if not target:
            raise BoardError(f'--deps takes type:ID, got {dep}')
        if kind == 'parent-child':
            raise BoardError('a parent is --parent <id>')
        if kind == 'waits-on':
            waits_on.append({'on': target})
        else:
            refuse_old_link(kind, '--deps')
            deps.append({'target': target, 'type': kind})
    if deps:
        node['deps'] = deps
    if waits_on:
        node['waits_on'] = waits_on
    if args.found_in:
        node[FOUND_IN] = args.found_in
    return node, edges


def load_plan(path: str) -> dict:
    try:
        plan = json.loads(Path(path).read_text(encoding='utf-8'))
    except (OSError, UnicodeDecodeError, ValueError) as error:
        raise BoardError(f'cannot read the plan {path}: {error}') from None
    plan = validate_plan(plan, path, GIVEN_NODE_KEYS)
    for node in plan['nodes']:
        if missing := [wait['on'] for wait in node.get('waits_on', []) if 'for' not in wait]:
            raise BoardError(f"{path}: node {node['key']} waits on {', '.join(missing)} without saying for what: waits_on is [{{\"on\", \"for\"}}]")
    return plan


def require_person_on_shared_board(target: str, verb: str) -> None:
    if shared is None:
        raise BoardError(f'agents board {verb} names another person on a shared board; this board is not shared')
    if not PERSON_NAME.fullmatch(target):
        raise BoardError(f'name one person: agents board {verb} <person>')


def for_person(plan: dict, target: str) -> None:
    """`--for`: a find for another person, top-level, in the creator's queue, labelled `for:<person>`, and not claimable until the lead sends or routes it;
    the lead checks it with them before `board send`. Child nodes of the plan take their parent's queue."""
    require_person_on_shared_board(target, 'create --for')
    me = person()
    if not me:
        raise BoardError(PERSON_HELP)
    children = {edge.get('from_key') for edge in plan.get('edges') or [] if isinstance(edge, dict) and edge.get('type') == 'parent-child'}
    for node in plan['nodes']:
        if node.get('parent') or node.get('parent_key') or node.get('parent_id') or node.get('key') in children:
            continue
        if any(label.startswith((QUEUE_PREFIX, FOR_PREFIX)) for label in node.get('labels') or []):
            raise BoardError(f"{node.get('key')}: --for sets the queue and for: itself: drop those labels")
        node['labels'] = [*(node.get('labels') or []), f'{FOR_PREFIX}{target}', f'{QUEUE_PREFIX}{me}']


def loose_work_refusal(name: str) -> str:
    """Work that commits here belongs to a change request (model.md Types); only a no-commit task stands outside one."""
    return (f'{name}: create would leave work outside a change request: file it in one (--parent <change request>, a graph node\'s parent; a milestone or task '
            f'is no change request; agents board move <id> --to <change request> for an existing task), or --no-commit for work that commits nothing to this repository')


def create_command(args) -> int:
    """`board create`: the board-owned flags describe one node of a graph plan, or `--graph <plan.json>` is the whole plan; either way
    the plan passes the board's checks (types, the project-default look, decisions naming what they hold up, queue labels, `--for`,
    the size limit of a work item's long fields) and goes to `bd create --graph`. Prints the ids created."""
    flags_used = any(value not in (None, [], False) for value in (args.type, args.title, args.positional_title, args.parent, args.label,
                                                                    args.priority, args.description_file, args.design_file,
                                                                    args.acceptance_file, args.deps, args.found_in, args.no_commit, args.look, args.view))
    if args.for_ and args.parent:
        raise BoardError('agents board create --for files a top-level item: drop --parent (a child takes its parent\'s queue)')
    if args.graph and flags_used:
        raise BoardError('--graph takes the whole plan: put the node fields in it (only --for and --holds go beside it)')
    if args.graph:
        plan = load_plan(args.graph)
    else:
        node, edges = flag_node(args)
        plan = validate_plan({'nodes': [node], **({'edges': edges} if edges else {})}, 'board create', GIVEN_NODE_KEYS)
    nodes = plan['nodes']
    if refusal := type_refusal([str(node['type']) for node in nodes if node.get('type')]):
        raise BoardError(refusal)
    given = [label for node in nodes for label in node.get('labels') or []]
    if refusal := kind_refusal(given) or label_shape_refusal(given):
        raise BoardError(refusal)
    for node in nodes:  # the limit a plain create had: a work item's long fields, not a decision's record
        refusal = size_refusal({'id': node['key'], 'issue_type': node.get('type') or 'task'},
                               {field: str(node[field]) for field in ('description', 'design', 'acceptance_criteria', 'notes') if node.get(field)}, update=False)
        if refusal:
            raise BoardError(refusal)
    for node in nodes:
        if found := node.pop(FOUND_IN, None):
            if not bd_show([found], comments=False):
                raise BoardError(f'{node["key"]}: found in {found}, which is unknown')
            node['metadata'] = {FOUND_IN: found}
        settings = {name: node.pop(name) for name in ITEM_SETTING_KEYS if name in node}
        if refusal := setting_refusal(node['key'], node.get('type') or 'task', settings):
            raise BoardError(refusal)
        if settings:
            node['metadata'] = {**node.get('metadata', {}), **settings}
    given = args.holds
    holds_value = ','.join(given) if args.holds else None
    decides = any(node.get('type') == 'decision' for node in nodes)
    if holds_value is not None and not decides:
        raise BoardError('--holds goes with --type decision: only a question or ruling holds items up')
    plan_given = plan_waits(plan)
    links, types = plan_links(plan)
    for waiter, target, _ in plan_given:
        if target not in types and not target.startswith('external:') and not bd_show([target], comments=False):
            raise BoardError(f'{waiter} waits on {target}, which is unknown')
    named = parse_holds(holds_value) if holds_value is not None else []
    parents = plan_parents(plan, links)
    existing = named or any(waiting not in types or (blocking(kind) and (waiting in parents or other not in types)) for waiting, other, kind in links)
    deck = Board.load('all') if existing else None
    _, waits = create_plan(plan, deck, 'create', named, dry_run=True)  # before anything is created
    if decides:
        require_holds_declared(waits, types, holds_value)
    if shared is not None and derived_actor() and (refusal := plan_queue_refusal(plan)):
        raise BoardError(refusal)
    if args.for_:
        for_person(plan, args.for_)
    plan_with_queue(plan)
    if args.dry_run:
        print('valid')
        for waiter, target, why in plan_given:
            print(wait_sentence(waiter, target, why or None))
        return 0
    made, _ = create_plan(plan, deck, 'create', named)
    for key, item_id in made.items():
        print(item_id if not args.graph else f'{key} {item_id}')
    for waiter, target, why in plan_given:  # the for is kept on the waiter, as board wait keeps it
        waiter_id, target_id = made.get(waiter, waiter), made.get(target, target)
        print(wait_sentence(waiter_id, target_id, why or None))
        if why:
            comment(waiter_id, wait_comment(target_id, why))
    return apply_waits(made, waits, types)


