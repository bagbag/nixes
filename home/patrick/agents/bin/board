# Commands that say nothing about the board, or that fix or run sync themselves: no pull first.
NO_PULL = {'help', '-h', '--help', 'share', 'join', 'relocate'}
# bd verbs that never open the database: no server needed, so they also run inside a sandbox that cannot reach it.
BD_NO_DATABASE = {'where', 'version', 'help'}
BD_NO_PULL = {'dolt', 'sync', 'init', 'conflicts', 'sql', 'rename', 'flatten', 'vc', 'version', 'where', 'help', 'bootstrap'}
# Commands that write nothing: a wrong entry costs a late sync, a missing one a cheap check.
READS = {'health', 'position', 'holders', 'check', 'related', 'queue', 'watch', 'mine', 'console', 'show', 'help', '-h', '--help'}
# Writes that sync themselves, so no sync window opens after them; they need the model marker like any write.
SYNCS_ITSELF = {'share', 'relocate'}
BD_READS = {'list', 'ready', 'show', 'view', 'query', 'search', 'where', 'version', 'help', 'export', 'stats', 'blocked', 'lint',
            'history', 'count', 'events'}


def bd_word(argv: list[str]) -> str:
    """The bd command a `board bd` call runs, past bd's global flags."""
    at = 1
    while at < len(argv) and argv[at].startswith('-'):
        at += 1 if argv[at] in ('--raw', '--yes') else 2 if argv[at] in GLOBAL_VALUES else 1
    return argv[at] if at < len(argv) else ''


def writes(argv: list[str]) -> bool:
    """Whether a command writes and opens the sync window after it (and a moved board refuses it): not a read, and not SYNCS_ITSELF, whose commands write but sync
    themselves. `field export` and `discard` touch only scratch."""
    if '--dry-run' in argv and (argv[:1] == ['create'] or argv[:2] == ['ruling', 'revise']):
        return False
    if argv[:2] in (['field', 'export'], ['field', 'discard'], ['ruling', 'check-replaces']):
        return False
    if argv[:1] == ['bd']:
        if '--raw' not in argv[1:3]:
            return False  # board bd runs bd read-only
        return not (bd_word(argv) in BD_READS or argv[1:3] in (['dolt', 'stop'], ['dolt', 'start'], ['dolt', 'status']))
    return (argv[0] if argv else '') not in READS | SYNCS_ITSELF


def main(argv: list[str] | None = None) -> int:
    global shared
    argv = (sys.argv[1:] if argv is None else argv) or ['help']  # a bare call prints the help (r15-q88)
    if argv[:1] == ['_sync-wait']:
        shared = find_shared()
        return shared.wait() if shared else 0
    directory = next((argv[i + 1] for i, arg in enumerate(argv[:-1]) if arg in ('-C', '--directory')), None) if argv[:1] == ['bd'] else None
    shared = find_shared(Path(directory) if directory else None)
    if shared is None or argv[:1] in (['share'], ['join']):
        return run_command(argv)

    def quietly(step, *values) -> None:
        """Sync never stops the command: a sandbox, a stopped server or a read-only folder only delay it."""
        try:
            step(*values)
        except (OSError, ValueError, BoardError, subprocess.SubprocessError) as error:
            print(f'board: sync step skipped: {error}', file=sys.stderr)

    word = bd_word(argv) if argv[:1] == ['bd'] else (argv[0] if argv else '')
    dry_run = '--dry-run' in argv and (argv[:1] == ['create'] or argv[:2] == ['ruling', 'revise'])
    bare = bool({'-h', '--help'} & set(argv)) or argv in (['cr'], ['ruling'], ['review'])  # a bare group only lists its verbs
    if not bare and not dry_run and word not in (BD_NO_PULL if argv[:1] == ['bd'] else NO_PULL):
        quietly(shared.before)
    if not bare and shared.moved() and (writes(argv) or argv[0] in SYNCS_ITSELF):
        print(f'board: {moved_refusal(shared.moved())}', file=sys.stderr)
        return 1
    try:
        return run_command(argv)
    finally:
        if not bare and (writes(argv) or settled):  # a read that finished a landing wrote
            if not dry_run:
                quietly(shared.after)
        if not dry_run:
            quietly(shared.report)


def pointer_for(word: str, rest: list[str], groups: dict) -> str | None:
    """The command to run instead of an unknown top-level verb (r15-q88, q90): the group verb of that name, else the board command of a bd write
    word (BOARD_FOR), else `board bd` when the installed bd knows the word (`bd <word> --help` exits 0; bd's command set changes with its
    version, so board keeps no list of reads). Nothing runs. None: argparse's own error."""
    tail = ''.join(f' {shlex.quote(arg)}' for arg in rest)
    for group, verbs in groups.items():
        if word in verbs.choices:
            return f'run: board {group} {word}{tail}'
    if BOARD_FOR.get(word):
        return f'use {BOARD_FOR[word]}'  # a bd write: its board command, not an echo of the arguments
    if word in BOARD_FOR:
        return f'run: {raw_form(word)}{tail}'
    try:
        known = bd(word, '--help').returncode == 0
    except OSError:  # no bd installed
        known = False
    return f'run: agents board bd {word}{tail}' if known else None


GIT_READERS = {'console', 'queue', 'health', 'position', 'check', 'mine'}  # change no git state: they read it through one GitView
CR_AWARE = {'claim', 'handover', 'return', 'unclaim', 'take', 'cr land', 'cr reject', 'cr refresh', 'cr request-review', 'cr edits', 'review open', 'queue', 'health', 'position', 'console', 'check', 'mine', 'wait'}


def set_view(board: Board, chosen: str | None) -> None:
    """A shared board's views show one queue: `--queue`, else the caller's (`all`: every queue)."""
    board.view = None if shared is None or chosen == 'all' else chosen or person()


# The verbs whose refusal exits 2 (the rest exit 1): the verbs that write an item from the flags and arguments they are given.
REFUSAL_EXIT_2 = (create_command, comment_command, close_command, field_discard, field_export, field_apply, update_command, move_command, link_command, unlink_command,
                  reopen_command, defer_command, undefer_command, gate_create, gate_resolve)


def run_command(argv: list[str]) -> int:
    if argv[:1] == ['bd']:
        try:
            return passthrough(argv[1:])
        except BoardError as error:
            report_error(error)
            return 1
    parser = argparse.ArgumentParser(prog='agents board', description=__doc__.split('\n\n')[0], allow_abbrev=False)
    scope = argparse.ArgumentParser(add_help=False, allow_abbrev=False)
    scope.add_argument('--root', metavar='ITEM', type=board_id, help="limit to items below this change request, or to a milestone's work "
                       '(default: whole board)')
    def count(value: str) -> int:
        if not value.isdigit():
            raise argparse.ArgumentTypeError(f'invalid count {value!r}: 0 or more')
        return int(value)

    listing = argparse.ArgumentParser(add_help=False, allow_abbrev=False)
    listing.add_argument('--offset', type=int, default=0, metavar='N', help='skip the first N rows (paging a cut output)')
    listing.add_argument('--limit', type=count, default=ROWS, help=f'rows per section (default {ROWS}, 0: all); the output '
                       f'stays within {READ_BUDGET} characters')
    commands = parser.add_subparsers(dest='command', required=True)

    class Values(argparse.Action):
        """A repeatable option whose values may also be comma lists: `--docs a,b --docs c` is [a, b, c]; a list, or with `set` a set."""

        def __call__(self, parser, namespace, value, option_string=None):
            parts = [part.strip() for part in value.split(',') if part.strip()]
            if self.const and any(part not in self.const for part in parts) or not parts:
                parser.error(f"argument {option_string}: choose from {', '.join(self.const)}" if self.const else f'argument {option_string}: no value')
            current = getattr(namespace, self.dest)
            setattr(namespace, self.dest, current | set(parts) if isinstance(current, set) else [*current, *parts])

    def add(name: str, text: str, run, parents=(), group: str | None = None):
        """A top-level command, or with `group` a verb of that kind group (`board cr land`)."""
        sub = (groups[group] if group else commands).add_parser(
            name, help=text, description=text, parents=list(parents), allow_abbrev=False,
            epilog=(verb_rules(f'{group} {name}' if group else name) if run else '') + f'example: {EXAMPLES[f"{group} {name}" if group else name]}',
            formatter_class=argparse.RawDescriptionHelpFormatter)
        sub.set_defaults(run=run)
        return sub

    # Kind groups (r15-q80): verbs that act on one kind of item; a bare group prints its verbs.
    groups = {}
    for group, text in (('cr', 'change request verbs: land, refresh, request-review, edits, reject'), ('ruling', 'ruling verbs: record, revise, release, supersede'),
                        ('review', "the user's review of a change request: open"),
                        ('field', "an item's long fields (description, design, acceptance, notes): export, apply, discard"),
                        ('gate', 'human gates: create, resolve')):
        sub = add(group, text, None)
        groups[group] = sub.add_subparsers(dest='verb', metavar='VERB')

    def priority(value: str) -> int:
        if re.fullmatch(r'[Pp]?[0-4]', value):
            return int(value[-1])
        raise argparse.ArgumentTypeError(f'invalid priority {value!r}: 0-4 or P0-P4 (0 highest)')

    def nonempty(value: str) -> str:
        if not value.strip():
            raise argparse.ArgumentTypeError('must not be empty')
        return value

    queues = argparse.ArgumentParser(add_help=False, allow_abbrev=False)
    queues.add_argument('--queue', metavar='PERSON|all', help="on a shared board: another person's queue, or every item (default: yours)")
    sub = add('health', 'counts', health, [scope, listing, queues])
    sub.add_argument('--items', action=Values, default=set(), const=HEALTH_VIEWS, metavar='VIEW[,VIEW...]',
                     help=f"list the items behind these counts: {', '.join(HEALTH_VIEWS)} (repeatable)")
    sub.add_argument('--json', action='store_true', help='counts, claimable by kind, --items rows, milestones; every row')
    sub = add('position', 'ready work vs sessions, held items with gone and idle marks, questions holding work, '
              'ready milestones', position, [scope, listing, queues])
    sub.add_argument('--json', action='store_true', help='ready by kind, sessions with state, held items; every row')
    add('holders', 'items by open downstream work', holders, [scope, listing, queues])
    sub = add('check', 'deviations from the board conventions', check, [scope, listing])
    sub.add_argument('--json', action='store_true', help='deviations and flags as rows')
    sub = add('related', 'items and doc lines mentioning terms', related, [scope, listing])
    sub.add_argument('terms', nargs='*')

    def draft(value: str) -> str:
        try:
            return read_text_arg(value)
        except BoardError as error:
            raise argparse.ArgumentTypeError(str(error)) from None

    sub.add_argument('--like', type=draft, metavar='FILE|-', help=f'terms from a draft: its {LIKE_TERMS} rarest board words')
    sub.add_argument('--docs', action=Values, default=[], metavar='PATH[,PATH...]',
                     help='canonical docs (files or directories of .md); repeatable, commas separate paths')
    sub.add_argument('--json', action='store_true', help='{terms, like, items, docs}; --limit per list')
    add('queue', 'claimable work by pull', queue, [scope, listing, queues])
    sub = add('watch', 'block until `agents board claim` would find work for this session; run it in the background, it claims nothing',
              watch_command, [scope, queues])
    sub.add_argument('--timeout', type=float, metavar='SECONDS', help='give up with exit 3 after this long (default: never)')
    sub.add_argument('--interval', type=float, metavar='SECONDS', help=f'gap between reads (default {WATCH_SECONDS})')
    add('mine', 'items held by this session and its workers', mine, [scope, listing])
    sub = add('console', 'JSON for the console pane from one snapshot: {noBoard, prefix, counts, forYou, items (mine), crs, waitingOnYou, queued, sessions, held (position)}, and sync, queueLine on a shared board',
              console, [scope])
    sub.set_defaults(items=set(), limit=0)
    sub = add('show', 'items with links, fields and newest comments, within the read budget', show)
    sub.add_argument('ids', nargs='+', type=board_id)
    sub.add_argument('--section', dest='sections', action=Values, default=[], metavar='NAME[,NAME...]',
                     help='a field or a ##/### heading (case-insensitive prefix; repeatable, commas separate)')
    sub.add_argument('--field', dest='fields', action=Values, default=[], metavar='FIELD[,FIELD...]',
                     help='a named field, comments included (repeatable, commas separate)')
    sub.add_argument('--comments', action='store_true', help='select the comments, every one, newest first (not the rest of the item)')
    sub.add_argument('--full', action='store_true', help=f'no {READ_BUDGET}-character budget')
    sub.add_argument('--json', action='store_true', help='{id: item} with comments, or with --field {id: {field: value}}; unbudgeted')
    fields = argparse.ArgumentParser(add_help=False, allow_abbrev=False)
    fields.add_argument('ids', nargs='+', type=board_id)
    fields.add_argument('--field', dest='fields', action=Values, default=[], metavar='FIELD[,FIELD...]',
                        help='description, design, acceptance (acceptance_criteria) or notes; repeatable (default: every field)')
    add('export', "write each field's text to <scratch>/fields/<id>/<field>.md and print the paths; an export edited and not applied is never overwritten",
        field_export, [fields], group='field')
    add('apply', 'write the edited exports back: one bd update per item; an item is refused whole (files kept) when a field changed on the board '
        'since its export or an edited file is empty', field_apply, [fields], group='field')
    add('discard', 'remove the exports, edited or not', field_discard, [fields], group='field')
    sub = add('comment', 'comment on items: one-line events within the size limit; -m <text> or -f <file> (- reads stdin)', comment_command)
    sub.add_argument('ids', nargs='+', type=board_id)
    source = sub.add_mutually_exclusive_group(required=True)
    source.add_argument('-m', '--message', metavar='TEXT', help='the comment')
    source.add_argument('-f', '--file', metavar='FILE', help='read the comment from a file (- reads stdin)')
    sub.add_argument('--board-packet', dest='packet', action='store_true', help="the board's own packet (the protocol engine's autopilot park): exempt from the size limit")
    sub = add('close', 'close items with a reason (at least 20 characters); a change request closes by agents board cr land or reject', close_command)
    sub.add_argument('ids', nargs='+', type=board_id)
    sub.add_argument('--reason', required=True, metavar='TEXT')
    sub.add_argument('--force', action='store_true', help='close an item that is blocked or has open children (bd close --force)')
    sub.add_argument('--outcome', choices=('done', 'dropped'), help='how an item or task ends: done (default), or dropped when a ruling or a duplicate makes it moot')
    sub = add('claim', 'claim the next item routed to your role, or the given ids; a work item past your worker cap needs --force', claim, [scope])
    sub.add_argument('ids', nargs='*', type=board_id)
    sub.add_argument('--force', metavar='REASON', type=nonempty,
                     help="hold a work item past your worker cap, flagged with this reason in position and check")
    sub.add_argument('--agreed', metavar='TEXT', type=nonempty,
                     help="the user's word that you review your own hand-over, or one your worker made: what they said (commented on the item)")
    sub = add('record', 'write the decision record you hold from a file and set it decided, or release it with --unratified', record, group='ruling')
    sub.add_argument('id', type=board_id)
    sub.add_argument('file')
    record_mode = sub.add_mutually_exclusive_group()
    record_mode.add_argument('--unratified', action='store_true',
                             help='release a ruling taken without the user (autopilot, or a standing two-way default), require ## Reversal, and create a related confirmation question')
    sub.add_argument('--replaces', action=Values, default=[], metavar='ID[,ID...]',
                     help='the rulings this record replaces, rerunnable after a stop: each decided or released one gets a pending revision link and is superseded when '
                          'this record comes into force (its release; with --unratified at once); one already superseded by it is done; anything else refuses before any write (repeatable)')
    sub = add('check-replaces', 'validate and classify rulings a staged question proposes to replace', check_replaces, group='ruling')
    sub.add_argument('ids', nargs='+', type=board_id)
    sub = add('update', 'change items: title, priority, labels (not queue: or for:), parent, item settings', update_command)
    sub.add_argument('ids', nargs='+', type=board_id)
    sub.add_argument('--title', type=nonempty)
    sub.add_argument('-p', '--priority', type=priority, help='0-4 or P0-P4 (0 highest)')
    sub.add_argument('--label', action=Values, default=[], metavar='LABEL[,LABEL...]', help='add; repeatable, commas separate')
    sub.add_argument('--unlabel', action=Values, default=[], metavar='LABEL[,LABEL...]', help='remove; repeatable, commas separate')
    sub.add_argument('--no-commit', dest='no_commit', action='store_true',
                     help='the work commits nothing to this repository: it needs no change request')
    for name, values in CR_SETTINGS.items():
        sub.add_argument(f'--{name}', choices=(*values, ''), help=f'a change request\'s {name} ("" drops it, back to the project default)')
    sub = add('link', 'link two items with a type that holds nothing up (a wait is agents board wait)', link_command)
    sub.add_argument('a', type=board_id)
    sub.add_argument('b', type=board_id)
    sub.add_argument('--type', required=True, metavar='TYPE', help=f"one of {', '.join(LINK_VERB_TYPES)}")
    sub = add('unlink', 'remove the link between two items, a wait included', unlink_command)
    sub.add_argument('a', type=board_id)
    sub.add_argument('b', type=board_id)
    sub = add('reopen', 'reopen closed items (not change requests)', reopen_command)
    sub.add_argument('ids', nargs='+', type=board_id)
    sub = add('defer', 'set items aside, blocked by nothing: someday, with an optional --until day it shows as due (a condition on an item or event is a wait)', defer_command)
    sub.add_argument('ids', nargs='+', type=board_id)
    sub.add_argument('--reason', required=True, type=nonempty, metavar='TEXT', help='why it is set aside (a condition on another item or event is a wait, not a reason)')
    sub.add_argument('--until', metavar='DATE', help='the day it shows as due for its deferrer (no date: someday); it stays deferred until undefer')
    sub = add('undefer', 'return deferred items to open', undefer_command)
    sub.add_argument('ids', nargs='+', type=board_id)
    sub = add('create', 'create a human gate that holds an item up', gate_create, group='gate')
    sub.add_argument('--blocks', required=True, type=board_id, metavar='ID')
    sub.add_argument('--reason', required=True, type=nonempty, metavar='TEXT')
    sub.add_argument('--title', metavar='TEXT')
    sub.add_argument('--for', dest='for_', metavar='PERSON', help='on a shared board: whose step it is (label for:<person>)')
    sub = add('resolve', 'resolve a gate: the items it held up proceed', gate_resolve, group='gate')
    sub.add_argument('gate', type=board_id)
    sub.add_argument('--reason', metavar='TEXT')
    sub = add('wait', 'make items wait on a target for an input (the one waiting relation, written on the waiter)', wait_command)
    sub.add_argument('ids', nargs='+', metavar='item', type=board_id)
    sub.add_argument('--on', dest='target', required=True, type=board_id)
    sub.add_argument('--for', dest='for_', type=nonempty, metavar='INPUT',
                     help='the input it uses, kept as a comment; required for a work item, optional on a decision or gate target or a milestone')
    sub = add('land', "Accept the tip/base pair shown at Accept", land, group='cr')
    sub.add_argument('id', type=board_id)
    sub.add_argument('--tip', metavar='SHA', help='the tip shown at Accept; required for a change request')
    sub.add_argument('--base', metavar='SHA', help='the base tip shown at Accept; required for a change request')
    sub = add('refresh', "rebase, set up, check, and show the CR files and incoming commits with their files", refresh, group='cr')
    sub.add_argument('id', type=board_id)
    gate_options(sub, nonempty)
    sub = add('request-review', "send the change since its last review to agent review", request_review, group='cr')
    sub.add_argument('id', type=board_id)
    sub.add_argument('reason', nargs='?', type=nonempty, help='why the delta needs agent review (shown to the reviewer)')
    sub = add('edits', "show the user's edits in the item's review (commits after the opened tip and uncommitted changes), or with --commit record them as the user's and end the review; --merged records a merge the user confirmed", cr_edits, group='cr')
    sub.add_argument('id', type=board_id)
    sub.add_argument('--tip', metavar='SHA', help='the tip the review was opened at (required without --merged): `agents board show` names it')
    sub.add_argument('--commit', action='store_true', help="record the user's commits after the opened tip as theirs and commit their uncommitted changes as one more (author the user, committer this session); the review ends; without edits it only ends the review")
    sub.add_argument('--merged', metavar='COMMIT', help="the user confirmed this commit, the deciding session's merge of a conflict on their edit commit: record it as their edit in place of the pre-rebase one (alone; the commit is on the branch and carries a recorded edit's author and time)")
    sub.add_argument('-m', '--message', type=nonempty, help='with --commit: the commit message (needed when the review holds uncommitted changes)')
    gate_options(sub, nonempty, 'with --commit: ')
    sub = add('open', "open the item for the user's review in its own worktree, on its own branch (upstream: the board's remote, push disabled), and print the folder "
              "to open; refused while the worktree is in work, mid a rebase or has uncommitted changes; an open item is held from refresh and agent steps until Accept or Return", review_open, group='review')
    sub.add_argument('id', type=board_id)
    sub = add('reject', 'close a change request unlanded (no item may be open: close or move them first); change requests stacked on it go back to planning', reject, group='cr')
    sub.add_argument('id', type=board_id)
    sub.add_argument('reason', type=nonempty)
    sub = add('revise', 'open a revision question linked to the record it revises; prints its id', revise, group='ruling')
    sub.add_argument('old', type=board_id)
    sub.add_argument('--title', required=True, type=nonempty)
    sub.add_argument('--body-file', required=True)
    sub.add_argument('--partial', metavar='RULE', help='revise one named rule; the rest stays in force')
    sub.add_argument('-p', '--priority', type=int, choices=range(5), help="default: the old record's")
    sub.add_argument('--parent', type=board_id, help="default: the old record's parent")
    sub.add_argument('-l', '--label', action=Values, default=[], help="default: the old record's topic: labels; repeatable, commas separate")
    sub.add_argument('--external-ref', metavar='REF', help='tag the new question with an external reference')
    sub.add_argument('--holds', action=Values, default=[], metavar='ID[,ID...]|none', help='the items this revision holds up (they wait on it); none: it holds nothing up; repeatable; required')
    sub.add_argument('--dry-run', action='store_true', help='validate the revision and its holds without writing')
    sub = add('release', 'release decided rulings in one bd batch; supersedes the records they revise, then closes '
              'the questions they answer', release, group='ruling')
    sub.add_argument('ids', nargs='+', type=board_id)

    def answered(value: str) -> tuple[str, list[str]]:
        question, _, records = value.partition('=')
        named = [record for record in records.split(',') if record]
        if not question or not named:
            raise argparse.ArgumentTypeError('QUESTION=RECORD[,RECORD]')
        return board_id(question), [board_id(record) for record in named]

    sub.add_argument('--closes', action='append', type=answered, default=[], metavar='QUESTION=RECORD[,RECORD]',
                     help='close each question as answered by the named in-force rulings, in dependency order; '
                          'forces only past blockers released or closed in this call')
    sub = add('supersede', "supersede a ruling; a full replacement blocks the old record's open items", supersede, group='ruling')
    sub.add_argument('old', type=board_id)
    sub.add_argument('--with', dest='new', required=True, type=board_id)
    sub.add_argument('--partial', metavar='RULE', nargs='?', const='', help='one rule of the old record: add the edge only')
    add('bd', 'run any bd command with your actor (agents board bd <args>)', None)
    sub = add('handover', 'comment the evidence and hand your item over for review', handover)
    sub.add_argument('id', type=board_id)
    sub.add_argument('evidence', type=nonempty)
    sub.add_argument('--no-agent-review', metavar='REASON', type=nonempty, help="route an authored change to the user's Accept without agent review; see skills/shared/acceptance.md Review policy")
    gate_options(sub, nonempty)
    sub = add('return', 'return a change request to the work queue; each finding becomes an open item of it', return_item)
    sub.add_argument('id', type=board_id)
    sub.add_argument('findings', nargs='+', type=nonempty, metavar='FINDING')
    sub.add_argument('--ruling', type=board_id, help='return an unclaimed review whose items wait on this in-force ruling you hold')
    for name, run, text in (('take', take, 'reassign held items to yourself (with a comment)'),
                            ('unclaim', unclaim, "free a hold, yours or another's (with a comment)")):
        sub = add(name, text, run)
        sub.add_argument('ids', nargs='+', type=board_id)
        sub.add_argument('--agreed', metavar='TEXT', type=nonempty, help="the user agrees the holder is gone (a hold held elsewhere on a shared board always needs it): what they said; a deciding session may then free a live-looking hold")
        if name == 'unclaim':
            sub.add_argument('--resume', metavar='TEXT', type=nonempty,
                             help='hand back your own work in progress unfinished, with its next action (work that waits on something: agents board wait)')
        if name == 'take':
            sub.add_argument('--force', metavar='REASON', type=nonempty,
                             help="take a work item past your worker cap, flagged with this reason in position and check")
    sub = add('route', "move items into a person's queue (lead, solo or a person's terminal); an inbox item leaves the inbox", route)
    sub.add_argument('person')
    sub.add_argument('ids', nargs='+', type=board_id)
    sub = add('send', "move top-level items into a person's inbox, unrouted until their lead routes them (lead, solo or a person's terminal)", send)
    sub.add_argument('person')
    sub.add_argument('ids', nargs='+', type=board_id)
    sub = add('create', 'create items: the flags describe one item, or --graph <plan.json> a whole plan (nodes, edges); prints the ids', create_command)
    sub.add_argument('positional_title', nargs='?', metavar='TITLE', help='the title (or --title)')
    sub.add_argument('--graph', metavar='PLAN', help="a bd graph plan: {nodes: [{key, title, type, description, design, acceptance_criteria, priority, labels, "
                      "no_commit, look, view, parent_key|parent_id, deps: [{target, type}], …}], edges: [{from_key|from_id, to_key, type}]}; prints 'key id' lines")
    sub.add_argument('--title')
    sub.add_argument('-t', '--type', help=f"one of {', '.join(kind for kind in ITEM_TYPES if kind != 'gate')} (default task; a gate is agents board gate create)")
    sub.add_argument('--parent', type=board_id, help='an existing parent; its labels (not its queue) are copied')
    sub.add_argument('-l', '--label', action=Values, default=[], metavar='LABEL[,LABEL...]', help='repeatable')
    sub.add_argument('-p', '--priority', type=priority, help='0-4 or P0-P4 (0 highest)')
    sub.add_argument('--description-file', metavar='FILE', help='the description (- reads stdin)')
    sub.add_argument('--design-file', metavar='FILE')
    sub.add_argument('--acceptance-file', metavar='FILE')
    sub.add_argument('--deps', action=Values, default=[], metavar='TYPE:ID[,TYPE:ID...]',
                     help='links; waits-on:ID (or a bare ID) makes the new item wait on ID, other types '
                          '(relates-to …) as bd; repeatable. The reverse (ID waits on the new item): agents board wait ID --on <new id> --for "<input>"')
    sub.add_argument('--found-in', type=board_id, metavar='ID', help='the item this one was found in (a field on the new item)')
    sub.add_argument('--holds', action=Values, default=[], metavar='ID[,ID...]|none',
                     help='a question or ruling names the items it holds up (they wait on it), or none; repeatable')
    sub.add_argument('--no-commit', action='store_true', help='a task that by design commits nothing to this repository: it needs no change request')
    sub.add_argument('--look', choices=CR_SETTINGS['look'], help="a change request's look, overriding the project default")
    sub.add_argument('--view', choices=CR_SETTINGS['view'], help="a change request's view, overriding the project default")
    sub.add_argument('--for', dest='for_', metavar='PERSON',
                     help='a find for another person on a shared board: top-level, in your queue, labelled for:<person>, not claimable until sent or routed')
    sub.add_argument('--dry-run', action='store_true', help='validate the plan and its links without writing')
    sub = add('setup', 'create this project\'s board, or bring an existing one to the current settings (safe to rerun)', setup)
    modes = sub.add_mutually_exclusive_group()
    modes.add_argument('--server', action='store_true', help='convert an existing embedded board to server mode (a new board is one already)')
    modes.add_argument('--embedded', action='store_true', help='a new board in embedded mode: one writer at a time, never shared')
    sub.add_argument('--prefix', help="a new board's id prefix (default: the origin repository's name, else the folder's)")
    for name, text in (('target', 'the branch change requests land on'), ('setup', 'the command that sets a worktree up (project script)'),
                       ('checks', 'the check command: one `file code` line per failure on stdout; no (file, code) count may rise from base to tip'),
                       ('look', 'before: you look before it lands; after: it lands after agent review'), ('view', 'code: the diff, in the review; result: the result')):
        sub.add_argument(f'--{name}', metavar=name.upper(), help=f'project setting {SETTINGS[name]}: {text}')
    sub = add('share', "share this board: without --yes, say what goes out and stop; with it: remote (default: the project's "
              "repository), first push, config, and your queue on existing items", share)
    sub.add_argument('url', nargs='?')
    sub.add_argument('--yes', action='store_true', help='share: the first push sends the whole board, git emails included')
    sub = add('join', "join a shared board (default: the project's repository's); an existing board stays as it is, a moved "
              "one rejoins", join)
    sub.add_argument('url', nargs='?')
    sub = add('relocate', 'move this shared board to a fresh repository: a moved note on the old one, flatten, push', move_board)
    sub.add_argument('url')
    sub = add('move', 'move items into another change request, or a change request into a milestone (re-parent)', move_command)
    sub.add_argument('ids', nargs='+', type=board_id)
    sub.add_argument('--to', required=True, type=board_id, metavar='ID', help='the new parent')
    sub = add('help', 'every command with an example; with a verb (agents board help cr land): that verb\'s help and example', None)
    sub.add_argument('words', nargs='*', metavar='VERB')

    word = argv[0] if argv else ''
    if word and not word.startswith('-') and word not in commands.choices:
        pointer = pointer_for(word, argv[1:], groups)
        if pointer:
            print(f'board: no verb {word!r}; {pointer}', file=sys.stderr)
            return 2

    args, extra = parser.parse_known_args(argv)
    name = f'{args.command} {args.verb}' if args.command in groups and getattr(args, 'verb', None) else args.command
    if args.command == 'related' and not args.terms and args.like is None:
        commands.choices['related'].error('give terms, --like <draft>, or both')
    if extra:
        hint = next((word for word in extra if word in HEALTH_VIEWS), None)
        (groups[args.command].choices[args.verb] if name != args.command else commands.choices[args.command]).error(f"unrecognized arguments: {' '.join(extra)}"
                                             + (f'; for that list run agents board health --items {hint}' if hint else ''))
    if args.command == 'help' and args.words:
        target = commands.choices.get(args.words[0])
        if target is not None and args.words[0] in groups and len(args.words) > 1:
            target = groups[args.words[0]].choices.get(args.words[1])
        if target is None or len(args.words) > (2 if args.words[0] in groups else 1):
            commands.choices['help'].error(f"no verb {' '.join(args.words)!r}; agents board help lists the verbs")
        print(target.format_help().rstrip())
        return 0
    if args.run is None:
        shown = groups[args.command].choices if args.command in groups else commands.choices
        print((commands.choices[args.command] if args.command in groups else parser).format_usage().strip() + '\n')
        for key, sub in shown.items():
            example = EXAMPLES[f'{args.command} {key}' if args.command in groups else key]
            print(sub.format_usage().strip() + f'\n  {sub.description or ""}'.rstrip() + f'\n  example: {example}')
        if args.command == 'help':
            print('\nstatuses and outcomes by type (a verb\'s --help lists the rows it performs):\n' + states_table())
        return 0
    args.root = getattr(args, 'root', None)
    refused = 2 if args.run in REFUSAL_EXIT_2 else 1  # a refusal exits 2 for the write-by-flags verbs, as board bd does
    if (writes(argv) or argv[0] in SYNCS_ITSELF) and argv[0] not in MODEL_EXEMPT:
        try:
            require_model()
        except BoardError as error:
            report_error(error)
            return refused
    if args.run in (setup, share, join, move_board, create_command, comment_command, close_command, field_discard, defer_command, undefer_command, gate_create, gate_resolve):
        try:
            return args.run(args)
        except BoardError as error:
            report_error(error)
            return refused
    JSON_VIEWS = {health: health_json, position: position_json, related: related_json, check: check_json}
    try:
        # Status views read non-closed items. These read closed items too (check: closed decisions named in text;
        # wait, revise, release, supersede: a closed blocker or old record) or comments (related, check).
        scope = 'ids' if args.run in (show, route, send, field_export, field_apply) else 'all' if args.run in (related, check, check_replaces, wait_command, revise, record, release, supersede, update_command, link_command, unlink_command, reopen_command) \
            else 'status'
        if args.run in (route, send):
            attended_issues(None, args, args.command)  # refuse before reading
        if args.run is console and not has_board():
            print(json.dumps(no_board_json(), indent=2, ensure_ascii=False))
            return 0
        board = Board.load(scope, args.ids if scope == 'ids' else None)
        if name in GIT_READERS:  # one read of the repository serves every change request, settle_landed's included
            read_git_view(board)
        if scope != 'ids' and name in CR_AWARE and settle_landed(board):
            global settled
            settled = True
        chosen = getattr(args, 'queue', None)
        if chosen and shared is None:
            raise BoardError('--queue: this board is not shared, so no queues (agents board share shares it)')
        set_view(board, chosen)
        if getattr(args, 'json', False) and args.run in JSON_VIEWS:
            # Unbudgeted, every row (related keeps --limit per list); no capacity line after it.
            print(json.dumps(JSON_VIEWS[args.run](board, args), indent=2, ensure_ascii=False))
            return 0
        if args.run in (health, position, holders, check, related, queue, mine):
            code = budgeted(args.run, board, args, argv)
        else:
            code = args.run(board, args) or 0
        if args.run in (claim, handover, return_item, wait_command, mine, queue):
            capacity(board, args)
        return code
    except BoardError as error:
        report_error(error)
        return refused


if __name__ == '__main__':
    raise SystemExit(main())
