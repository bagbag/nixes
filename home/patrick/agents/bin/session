#!/usr/bin/env bash
# Session role registry shared by Codex and Claude Code: one JSON file per
# session id under a persistent state dir, so a resumed session keeps its role.
# activate and actor take the session from the environment; Codex's variables
# win, so a Codex session started from Claude is itself (a Claude session
# started from Codex is not: it inherits CODEX_SESSION_ID). The
# session-register hook keeps workers from registering.
# activate and alive record the Claude Code process (pid, pid_started) so
# board position can tell a gone session, and the project (the resolved folder
# of the board: `board bd where`) so it lists only the sessions of its own. The session-activity hook records
# activity as file mtimes: session-active touches <session>.active for the
# session's own tool calls; worker-started and worker-active create or touch
# one marker file per running worker in <session>.workers/ and worker-ended
# deletes it, so a stopped worker has none (one file per worker: workers
# stopping together would overwrite each other's marks in one shared file). Codex records no process: the nearest `codex`
# ancestor can be an app-server daemon shared by many sessions or a
# per-command `codex sandbox` helper, so Codex holds keep the idle hint.
# After its write, activate prunes registrations idle prune_days (last activity, else registration) whose process
# ended or that record none (Codex), skipping when the lock is busy; their actors go to `ended`, which board reads
# so their holds still show gone. Registration writes and the prune hold one lockf(1) lock on $state/.lock (freed
# when its holder dies); `list` and activity writes take none. `list` prints one JSON line per registration,
# {"unreadable": <file>} for one it cannot parse.
set -euo pipefail

state_dir=${AGENT_SESSION_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/agent-sessions}
pull_order=(plan design implement review)
prune_days=7
lock_file=$state_dir/.lock
lock_wait=10  # seconds a registration write waits for the lock

help_text() {
  cat <<'EOF'
usage: session <verb> [args]
  session activate lead --pulls plan,implement --workers 3   register this session's role (lead|agent|solo|autopilot)
  session set-workers <id> --workers 2                       change a session's worker cap
  session actor                                              this session's actor name
  session get <id>                                           a session's role
  session show <id>                                          a session's registration as JSON
  session list                                               every registration, one JSON line each
  session ended                                              actors of pruned registrations
  session state-dir                                          the registry folder
  session alive                                              record this Claude Code process (hook)
  session session-active                                     touch the session's activity mark (hook)
  session worker-started <agent-id>                          mark a worker running (hook)
  session worker-active <agent-id>                           touch a worker's mark (hook)
  session worker-ended <agent-id>                            remove a worker's mark (hook)
  session help                                               this list; a call with no arguments prints it too
`--pulls` adds pulls to any role's preset; agent has no preset and needs at least one.
`--workers` sets the session's worker cap; without it, activate keeps the one set.
EOF
}

usage() {
  help_text >&2
  exit 2
}

fail() {
  echo "session: $1" >&2
  exit 2
}

[[ $# -gt 0 && $1 != help ]] || { help_text; exit 0; }
original=("$@")
command=$1
shift
role='' pulls='' workers='' session='' tool='' thread=''
while (($#)); do
  case $1 in
    --pulls) (($# >= 2)) || usage; pulls=$2; shift 2 ;;
    --pulls=*) pulls=${1#*=}; shift ;;
    --workers) (($# >= 2)) || usage; workers=$2; shift 2 ;;
    --workers=*) workers=${1#*=}; shift ;;
    -*) usage ;;
    *)
      [[ -z "$role" ]] || usage
      role=$1
      shift
      ;;
  esac
done
[[ -z "$workers" || "$command" == activate || "$command" == set-workers ]] || usage

valid_session_id() {
  [[ "$1" =~ ^[A-Za-z0-9._-]{8,}$ ]] || fail "invalid session id '$1'"
}

# The agent session running this command (board-core.md#actors-and-holds).
environment_session() {
  if [[ -n ${CODEX_SESSION_ID-} ]]; then
    session=$CODEX_SESSION_ID tool=codex thread=${CODEX_THREAD_ID-}
  elif [[ -n ${CLAUDE_CODE_SESSION_ID-} ]]; then
    session=$CLAUDE_CODE_SESSION_ID tool=claude
  else
    return 1
  fi
}

from_environment() {
  environment_session || fail "no agent session: run inside Claude Code or Codex"
  valid_session_id "$session"
}

# Hook-run commands (alive, session-active, worker-*) end silently without a registered
# session: a failing SubagentStop hook would keep the worker running.
registered_session() {
  environment_session && [[ "$session" =~ ^[A-Za-z0-9._-]{8,}$ ]] || exit 0
  target="$state_dir/$session.json"
  [[ -f "$target" ]] || exit 0
}

# The legacy <session>.ended/ folder marked stopped workers, which a missing
# marker now expresses; readers and writers drop it.
drop_legacy_markers() {
  rm -rf -- "${1%.json}.ended" 2>/dev/null || true
}

# A file's mtime as UTC ISO time, or failure when it is missing (date -r
# reads a file's mtime on BSD and GNU).
modified_at() {
  date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null
}

# A registry entry as show and list print it. active_at: the session's last
# own tool call; workers: running workers (agent ids' last 8 characters) and
# their last tool call. board judges what counts as recent.
entry_json() {
  local times=() marker modified active_at=''
  drop_legacy_markers "$1"
  if modified=$(modified_at "${1%.json}.active"); then
    active_at=$modified
  fi
  for marker in "${1%.json}.workers"/*; do
    modified=$(modified_at "$marker") || continue  # none, or removed meanwhile
    times+=("${marker##*/}" "$modified")
  done
  jq -c --arg active_at "$active_at" --args \
    '{role, pulls, actor, tool, session, registered_at, pid, pid_started, project, worker_cap,
      active_at: (if $active_at == "" then null else $active_at end),
      workers: ([range(0; $ARGS.positional | length; 2) as $i | {($ARGS.positional[$i]): $ARGS.positional[$i + 1]}] | add // {})}' \
    ${times[@]+"${times[@]}"} <"$1"  # bash 3.2: an empty array is unbound under set -u
}

ps_command=$(command -v ps || echo /bin/ps)

# "<pid>\n<UTC start time>" of the Claude Code process running this command, or
# nothing (Codex, no agent ancestor, ps unavailable).
process_identity() {
  local pid=$$ name started
  while [[ "$pid" =~ ^[0-9]+$ ]] && ((pid > 1)); do
    name=$(LC_ALL=C "$ps_command" -o comm= -p "$pid" 2>/dev/null) || return 0
    case ${name##*/} in
      claude)
        # UTC, as board compares it: a time-zone change must not read as a new process.
        started=$(LC_ALL=C TZ=UTC0 "$ps_command" -o lstart= -p "$pid" 2>/dev/null) || return 0
        [[ -n "$started" ]] || return 0
        read -r -a started <<<"$started"
        printf '%s\n%s\n' "$pid" "${started[*]}"
        return 0
        ;;
      codex) return 0 ;;
    esac
    pid=$(LC_ALL=C "$ps_command" -o ppid= -p "$pid" 2>/dev/null) || return 0
    pid=${pid//[[:space:]]/}
  done
}

# Sets pid and pid_started from process_identity; both empty without one.
# jq callers bind them and merge `identity` (pid fields, or none).
identity_filter='def identity: if $pid == "" then {} else {pid: ($pid | tonumber), pid_started: $pid_started} end;'
read_identity() {
  local identity=''
  [[ "$tool" != claude ]] || identity=$(process_identity)
  pid='' pid_started=''
  [[ -z "$identity" ]] || pid=${identity%%$'\n'*} pid_started=${identity#*$'\n'}
}

# Sets project to the resolved folder holding the board (first line of `board bd where`: its .beads
# path; it works from a git worktree), empty outside a board or when the lookup fails. Fails open.
read_project() {
  local dir=${BASH_SOURCE[0]%/*} board where
  [[ "$dir" != "${BASH_SOURCE[0]}" ]] || dir=.
  board=$dir/board
  project=''
  [[ -x "$board" ]] || return 0
  where=$("$board" bd where 2>/dev/null </dev/null | head -n 1) || true
  [[ "$where" == /* ]] || return 0
  project=$(cd -P -- "${where%/*}" 2>/dev/null && pwd -P) || project=''
}
project_filter='def located: if $project == "" then {} else {project: $project} end;'

# Runs this script again with the same arguments as $2... under the registry lock, waiting $1 seconds for it (0: not at
# all). lockf's own failures come back as its status: 73 the lock file cannot be opened, 75 the wait ran out.
run_locked() {
  local wait=$1
  shift
  mkdir -p "$state_dir" 2>/dev/null || return 73
  SLM_LOCKED=1 /usr/bin/lockf -k -t "$wait" "$lock_file" bash "$0" "$@"
}

# Whether the registered process is gone: ps finds no such pid, or the pid now names a process started at another time.
# Unknown (no ps, ps failing for another reason) is not ended.
process_ended() {
  local current status=0
  current=$(LC_ALL=C TZ=UTC0 "$ps_command" -o lstart= -p "$1" 2>/dev/null) || status=$?
  if ((status == 0)) && [[ -n "$current" ]]; then
    read -r -a current <<<"$current"
    [[ "${current[*]}" != "$2" ]]
  else
    ((status == 1)) && [[ -z "$current" ]]
  fi
}

# Entry lines on stdin -> "session<TAB>pid<TAB>pid_started<TAB>actor" of each one idle over prune_days; pid and
# pid_started are "-" without a recorded process.
stale_registrations() {
  jq -r --argjson days "$prune_days" '
    select(.unreadable == null)
    | ([.registered_at, .active_at, (.workers // {} | .[])] | map(select(. != null)) | max) as $last
    | select($last != null and $last < (now - $days * 86400 | strftime("%Y-%m-%dT%H:%M:%SZ")))
    | ((.pid | type) == "number" and (.pid_started | type) == "string") as $process
    | [.session, (if $process then (.pid | tostring) else "-" end), (if $process then .pid_started else "-" end), .actor] | @tsv' 2>/dev/null
}

# Prints how many registrations it removed: those idle over prune_days whose process ended (or that record none). Runs
# under the registry lock and reads the registrations itself, so a session that registered meanwhile keeps its
# registration. The actor reaches `ended` first, so an interrupted prune leaves a registration, never a lost actor.
prune_ended() {
  local row session pid started actor temporary removed=0
  while IFS= read -r row; do
    [[ -n "$row" ]] || continue
    IFS=$'\t' read -r session pid started actor <<<"$row"
    [[ "$session" =~ ^[A-Za-z0-9._-]{8,}$ && -n "$actor" ]] || continue
    if [[ "$pid" == - ]] || process_ended "$pid" "$started"; then
      umask 077
      temporary=$(mktemp "$state_dir/.ended.XXXXXX")
      { cat -- "$state_dir/ended" 2>/dev/null || true; printf '%s\n' "$actor"; } | awk 'NF && !seen[$0]++' >"$temporary"
      mv -f "$temporary" "$state_dir/ended"
      rm -rf -- "$state_dir/$session.json" "$state_dir/$session.active" "$state_dir/$session.workers" "$state_dir/$session.ended"
      removed=$((removed + 1))
    fi
  done < <(list_entries | stale_registrations)
  echo "$removed"
}

# Every readable registration as one JSON line (what list prints), and an unreadable one as {"unreadable": <file>}.
list_entries() {
  shopt -s nullglob
  files=("$state_dir"/*.json)
  ((${#files[@]})) || return 0
  # One jq over every registration (a jq per file made the list the console's slowest read): bash globs the
  # activity files, one stat reads their times, and entry_json's output shape is rebuilt from both. A file
  # that does not parse as an object is skipped alone; an empty one lists nothing.
  timed=()
  for registration in "${files[@]}"; do
    drop_legacy_markers "$registration"
    timed+=("$registration")
    [[ ! -e "${registration%.json}.active" ]] || timed+=("${registration%.json}.active")
    for marker in "${registration%.json}.workers"/*; do
      [[ ! -e "$marker" ]] || timed+=("$marker")
    done
  done
  # GNU stat takes -c, BSD stat -f.
  if stat -c %Y / >/dev/null 2>&1; then stat_format=(-c '%Y %n'); else stat_format=(-f '%m %N'); fi
  # --rawfile per registration, not -R over all of them: jq joins a file's unterminated last line to the next file.
  contents=() readable=()
  for registration in "${files[@]}"; do
    if [[ -r "$registration" ]]; then
      contents+=(--rawfile "f${#readable[@]}" "$registration")
      readable+=("$registration")
    else
      jq -n -c --arg file "$registration" '{unreadable: $file}'
    fi
  done
  ((${#readable[@]})) || return 0
  jq -n -c "${contents[@]}" --rawfile stats <(((${#timed[@]})) && stat "${stat_format[@]}" "${timed[@]}" 2>/dev/null; true) '
    def stamp: strftime("%Y-%m-%dT%H:%M:%SZ");
    ([$stats | split("\n")[] | capture("^(?<t>[0-9]+) (?<n>.*)$")? | {n, t: (.t | tonumber | stamp)}]) as $times
    | $ARGS.positional | to_entries[] | .value as $file | ($file | rtrimstr(".json")) as $stem
    | $ARGS.named["f\(.key)"] as $text
    | (try ($text | fromjson) catch null) as $entry
    | if ($entry | type) != "object" then
        (if ($text | test("^\\s*$")) then empty else {unreadable: $file} end)
      else
        $entry | {role, pulls, actor, tool, session, registered_at, pid, pid_started, project, worker_cap,
          active_at: (first($times[] | select(.n == ($stem + ".active")) | .t) // null),
          workers: ([$times[] | select(.n | startswith($stem + ".workers/")) | {(.n | ltrimstr($stem + ".workers/")): .t}] | add // {})}
      end' --args "${readable[@]}"
}

# Registration writes run again under the registry lock (the child sees SLM_LOCKED); activate then prunes, best effort.
if [[ -z ${SLM_LOCKED-} ]]; then
  case "$command" in
    activate | set-workers | alive)
      [[ "$command" != alive ]] || { [[ -z "$role$pulls" ]] || usage; registered_session; }  # no lock for the hook's no-op
      locked=0
      run_locked "$lock_wait" "${original[@]}" || locked=$?
      case $locked in
        73 | 75) fail "the registry is locked or not writable ($lock_file)" ;;
      esac
      if [[ "$command" == activate && $locked -eq 0 ]]; then run_locked 0 prune >/dev/null 2>&1 || true; fi
      exit "$locked"
      ;;
  esac
fi

case "$command" in
  activate)
    case "$role" in
      lead | agent | solo | autopilot) ;;
      *) usage ;;
    esac
    from_environment

    selected=()
    if [[ "$role" == agent && -z "$pulls" ]]; then
      fail "agent needs --pulls with at least one of: ${pull_order[*]}"
    fi
    if [[ -n "$pulls" ]]; then
      IFS=',' read -r -a requested <<<"$pulls"
      for pull in "${requested[@]}"; do
        [[ " ${pull_order[*]} " == *" $pull "* ]] || fail "unknown pull '$pull'; choose from: ${pull_order[*]}"
      done
      for pull in "${pull_order[@]}"; do
        [[ ",$pulls," == *",$pull,"* ]] && selected+=("$pull")
      done
    fi
    [[ -z "$workers" || "$workers" =~ ^(0|[1-9][0-9]*)$ ]] || fail "--workers takes a whole number, not '$workers'"

    umask 077
    mkdir -p "$state_dir"
    target="$state_dir/$session.json"
    read_identity
    read_project
    temporary=$(mktemp "$state_dir/.$session.XXXXXX")
    jq -n \
      --arg session "$session" \
      --arg role "$role" \
      --arg actor "${session: -8}" \
      --arg tool "$tool" \
      --arg registered_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      --arg pid "$pid" \
      --arg pid_started "$pid_started" \
      --arg project "$project" \
      --argjson worker_cap "${workers:-$(jq -c '.worker_cap // null' "$target" 2>/dev/null || echo null)}" \
      --args \
      "$identity_filter$project_filter"'{session: $session, role: $role, pulls: $ARGS.positional, actor: $actor,
        tool: $tool, registered_at: $registered_at} + identity + located
        + (if $worker_cap == null then {} else {worker_cap: $worker_cap} end)' \
      "${selected[@]}" >"$temporary"
    mv -f "$temporary" "$target"
    ;;
  set-workers)
    [[ -z "$pulls" && -n "$role" && "$workers" =~ ^(0|[1-9][0-9]*)$ ]] || usage
    session=$role
    valid_session_id "$session"
    target="$state_dir/$session.json"
    umask 077
    [[ -f "$target" ]] || fail "session $session has no role"
    temporary=$(mktemp "$state_dir/.$session.XXXXXX")
    jq --argjson worker_cap "$workers" '.worker_cap = $worker_cap' "$target" >"$temporary"
    mv -f "$temporary" "$target"
    ;;
  alive)
    [[ -z "$role$pulls" ]] || usage
    registered_session
    read_identity
    read_project
    umask 077
    [[ -f "$target" ]] || exit 0  # pruned meanwhile: it registers again
    temporary=$(mktemp "$state_dir/.$session.XXXXXX")
    jq --arg pid "$pid" --arg pid_started "$pid_started" --arg project "$project" \
      "$identity_filter$project_filter"'del(.pid, .pid_started, .project, .ended_workers) + identity + located' "$target" >"$temporary"
    mv -f "$temporary" "$target"
    ;;
  prune)
    [[ -n ${SLM_LOCKED-} ]] || usage
    prune_ended
    ;;
  session-active)
    [[ -z "$role$pulls" ]] || usage
    registered_session
    umask 077
    touch "$state_dir/$session.active"
    ;;
  worker-started | worker-active | worker-ended)
    [[ -z "$pulls" && "$role" =~ ^[A-Za-z0-9._-]{8,}$ ]] || usage
    registered_session
    drop_legacy_markers "$target"
    marker="$state_dir/$session.workers/${role: -8}"
    if [[ "$command" == worker-ended ]]; then
      rm -f "$marker"
    else
      # A stopped worker makes no tool calls, so a heartbeat may create the
      # marker: it covers a worker whose SubagentStart was missed.
      umask 077
      mkdir -p "${marker%/*}"
      touch "$marker"
    fi
    ;;
  actor)
    [[ -z "$role$pulls" ]] || usage
    from_environment
    actor=${session: -8}
    [[ -z "$thread" || "$thread" == "$session" ]] || actor+="/${thread: -8}"
    printf '%s\n' "$actor"
    ;;
  get | show)
    [[ -z "$role" || -z "$session" ]] || usage
    session=${session:-$role}
    [[ -n "$session" ]] || fail "$command needs a session id"
    valid_session_id "$session"

    registration="$state_dir/$session.json"
    if [[ -f "$registration" ]]; then
      if [[ "$command" == get ]]; then
        jq -r '.role' "$registration"
      else
        entry_json "$registration"
      fi
      exit 0
    fi
    [[ "$command" == get ]] ||
      jq -nc --arg actor "${session: -8}" --arg session "$session" \
        '{role: null, pulls: [], actor: $actor, tool: null, session: $session, registered_at: null,
          pid: null, pid_started: null, project: null, active_at: null, workers: {}}'
    ;;
  state-dir)
    # The one owner of the location: the protocol engine and the console mod ask here.
    [[ -z "$role$pulls" ]] || usage
    printf '%s\n' "$state_dir"
    ;;
  list)
    [[ -z "$role$session$pulls$tool" ]] || usage
    [[ -d "$state_dir" ]] || exit 0
    list_entries
    ;;
  ended)
    [[ -z "$role$session$pulls$tool" ]] || usage
    cat -- "$state_dir/ended" 2>/dev/null || true
    ;;
  *) usage ;;
esac
